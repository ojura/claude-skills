# ---------------------------------------------------------------------------
# remote-shell-over-chisel configuration
#
# Copy this file to `config.sh` and fill in your values:
#     cp config.sh.example config.sh
# `config.sh` is gitignored. The scripts source it as plain shell, so you can
# use $HOME and other expansions. See README.md for the full setup.
# ---------------------------------------------------------------------------

# HTTPS URL where your chisel SERVER is reachable. The sandbox egress only
# passes valid HTTPS, so this MUST be an https:// URL fronted by a reverse proxy
# (e.g. nginx) that forwards to a `chisel server` instance. The path
# ("/chisel" here) is whatever your proxy maps to chisel.
CHISEL_SERVER="https://your-host.example.com/chisel"

# SSH user on the remote machine.
REMOTE_USER="youruser"

# Chisel credentials in `user:secret` form, matching the server's `--auth` or
# an entry in its `--authfile`. Prefer pointing at a file outside the repo:
CHISEL_TOKEN_FILE="$HOME/.config/chisel-remote/token"
# ...or set it inline instead (less safe; ends up in this file):
# CHISEL_TOKEN="user:secret"

# Friendly name used in log lines, e.g. "[bigbox] tunnel up".
REMOTE_NAME="remote"

# Where state lives: the chisel binary, the staged key copy, the env file, and
# the control sockets of the shared SSH connections. Put it on a persistent
# disk so it survives across sessions.
STATE_DIR="$HOME/.chisel-remote"

# The chisel client to run. Unless an executable is already there, the scripts
# download CHISEL_VERSION from GitHub releases to this path and check it
# against the release's checksums.
CHISEL_BIN="$STATE_DIR/chisel"
CHISEL_VERSION="1.12.0"

# How long a shared SSH connection stays open without any session using it.
# Any value ssh's ControlPersist accepts.
MASTER_IDLE="10m"

SSH_REMOTE_PORT=22        # the remote's sshd

# --- Sandbox mode (connect.sh) ----------------------------------------------

# Path to the SSH PRIVATE KEY authorized on the remote machine. KEEP THIS
# OUTSIDE THE REPO. Generate a dedicated key for this (see README), don't reuse
# a personal one.
SSH_KEY="$HOME/.ssh/id_remote_shell"

# Port forwards (defaults are fine for most setups).
SSH_LOCAL_PORT=2222       # local port that maps to the remote's sshd
CDP_LOCAL_PORT=7799       # pairs with the cdp-daemon skill; set empty ("") to disable CDP forwarding
CDP_REMOTE_PORT=7799

# --- Workstation mode (ssh-through-remote.sh) -------------------------------

# The name you use for the remote in ssh (`ssh bigbox`). The lines from
# ssh-config.sh define it as a Host in ~/.ssh/config. Defaults to REMOTE_NAME.
SSH_ALIAS="bigbox"

# The remote's address for `ssh $SSH_ALIAS` while ssh-through-remote.sh is not
# on. Leave it empty if the alias is only used through the tunnel.
SSH_HOSTNAME=""
