#!/usr/bin/env python3
"""Break one thing in agent-resume, and say which checks noticed.

A probe is only worth running if its result can be trusted, and reading a
suite's output for a check's name is not trustworthy: a search matches
comments and near-identical names, a crash prints nothing and reads as
silence, and the run you are looking at may be the restore rather than the
probe. This runs one clean suite and each independent mutant, compares their
failure sets, and reports the differences, so no reading is involved.

    ./probe --expect check-id 'old text' 'new text'
    ./probe --expect check-a old-a new-a --expect check-b old-b new-b
    ./probe --live --expect check-id 'old text' 'new text'
    ./probe --selftest

Each --expect names one independent mutation and the check it should make
fail (--selftest --list prints every id alongside its prose). The id must
match exactly: no substring, no prose search. Some check failing is not the
same as the right one failing: a mutation can break structural checks that
have nothing to do with what it was testing, and "bit" reads as success
either way. A batch runs the clean suite once, runs each mutant in its own
copy, and compares every mutant with that shared clean result. Without
--expect, one old/new pair is only reported, which is worth having while
exploring but proves nothing.

One thing it cannot measure: itself. It reads the suite's failure list, so
a mutation to how that list is produced changes what the probe sees rather
than what the suite found, and every check appears to bite. Verify changes
to check_report by calling it directly with sample results.

Exit 0 when every expected check bit (or, with no expectation, when anything
did), 1 when any expected check did not bite, and 2 when an expectation names
no defined check, a mutation cannot be applied, or a run produces no verdict.
Nothing is written to the tree: each mutation is applied to a separate copy in
a temporary directory. The clean suite and independent mutants run with at
most four suites active at once, including --live.
"""

import concurrent.futures
import re
import shutil
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

TOOL = Path(__file__).resolve().parent / "agent-resume"
COMP = TOOL.parent / f"_{TOOL.name}"
MAX_PARALLEL_SUITES = 4


def parse_verdicts(stdout, valid):
    """Parse one failed-only report without treating detail lines as check IDs."""
    lines = [line.strip() for line in stdout.splitlines() if line.strip()]
    summaries = [line for line in lines if line.startswith("checks: ")]
    if not summaries:
        return None, "the suite produced no summary"
    summary = summaries[-1]
    match = re.fullmatch(r"checks: (\d+) ok, (\d+) failed", summary)
    if not match:
        return None, f"the suite produced an unreadable summary: {summary}"
    failed_ids = {check_id for line in lines if line != summary
                  for check_id, description in valid.items()
                  if line.startswith(f"{check_id}  {description}")}
    expected = int(match.group(2))
    if len(failed_ids) != expected:
        return None, (f"the suite reported {expected} failures but "
                      f"{len(failed_ids)} known check IDs were readable")
    return failed_ids, summary


ENDED_CHECKS = {"every-unit-reported", "every-live-unit-reported"}


def interpret_run(run, valid):
    """Read one suite process without hiding an early exit or its stderr."""
    parsed, said = parse_verdicts(run.stdout, valid)
    stderr = run.stderr.strip()
    if parsed is None:
        if "no summary" in said:
            output = stderr or run.stdout.strip() or "no output"
            return None, f"the suite did not finish:\n{output}"
        return None, f"{said}\n{stderr}" if stderr else said
    ended = parsed & ENDED_CHECKS
    if ended:
        output = "\n".join(part for part in (stderr, run.stdout.strip()) if part)
        return None, ("the suite ended before every unit reported"
                      + (f":\n{output}" if output else ""))
    return parsed, f"{said}\nstderr:\n{stderr}" if stderr else said


def verdicts(path, live, valid):
    """({failed check ids}, summary) for one run, or (None, reason)."""
    argv = [sys.executable, str(path), "--selftest", "--failed"]
    if live:
        argv.append("--live")
    run = subprocess.run(argv, capture_output=True, text=True)
    return interpret_run(run, valid)


def verdict_batch(clean_path, mutant_paths, live, valid, run=verdicts):
    """Run the clean suite once and each independent mutant, with a fixed limit."""
    paths = [clean_path, *mutant_paths]
    with concurrent.futures.ThreadPoolExecutor(
            max_workers=min(MAX_PARALLEL_SUITES, len(paths))) as pool:
        futures = [pool.submit(run, path, live, valid) for path in paths]
        clean = futures[0].result()
        mutants = [future.result() for future in futures[1:]]
    return clean, mutants


def known_checks(path, live):
    """{check id: description} from --selftest --list."""
    argv = [sys.executable, str(path), "--selftest", "--list"]
    if live:
        argv.append("--live")
    run = subprocess.run(argv, capture_output=True, text=True)
    rows = (line.strip().partition("  ") for line in run.stdout.splitlines()
            if line.strip())
    return {check_id: description.lstrip()
            for check_id, separator, description in rows if separator}


def mutation_target(old, paths=(TOOL, COMP)):
    """Return the sole file containing one match, or a precise refusal."""
    counts = {path: path.read_text().count(old) if path.exists() else 0
              for path in paths}
    total = sum(counts.values())
    said = ", ".join(f"{path.name}: {count}" for path, count in counts.items())
    if total == 0:
        return None, f"the text to replace was not found ({said})"
    if total != 1:
        return None, (f"the text to replace appears {total} times ({said}); "
                      "a probe replaces exactly one thing, so narrow it")
    return next(path for path, count in counts.items() if count == 1), None


def parse_request(argv):
    """Return (live, [(expected, old, new)]), or a precise usage error."""
    argv = list(argv)
    live = bool(argv and argv[0] == "--live")
    if live:
        argv.pop(0)
    if "--expect" not in argv:
        if len(argv) != 2:
            return None, "one exploratory mutation takes OLD NEW"
        return (live, [(None, argv[0], argv[1])]), None

    cases = []
    while argv:
        if argv[0] != "--expect":
            return None, "each batched mutation must start with --expect"
        if len(argv) < 4:
            return None, "--expect takes CHECK OLD NEW"
        cases.append((argv[1], argv[2], argv[3]))
        argv = argv[4:]
    return (live, cases), None


def selftest():
    """Exercise target selection, parsing, verdict reading, and concurrency."""
    checks = []
    with tempfile.TemporaryDirectory() as td:
        left, right = Path(td) / "agent-resume", Path(td) / "_agent-resume"

        def run(name, left_text, right_text, target, phrase, absent=""):
            left.write_text(left_text)
            right.write_text(right_text)
            got, objection = mutation_target("needle", (left, right))
            said = objection or ""
            ok = (got == target and phrase in said
                  and (not absent or absent not in said))
            checks.append((name, ok, objection or str(got)))

        run("zero", "plain", "plain", None, "was not found", "narrow it")
        run("one-main", "needle", "plain", left, "")
        run("one-completion", "plain", "needle", right, "")
        run("many-one-file", "needle needle", "plain", None,
            "appears 2 times", "was not found")
        run("many-across-files", "needle", "needle", None,
            "agent-resume: 1, _agent-resume: 1", "was not found")

    parsed, summary = parse_verdicts(
        "target-check  description  (first detail line\n"
        "second detail line)\nchecks: 4 ok, 1 failed\n",
        {"target-check": "description", "other-check": "other description"})
    checks.append(("multiline-detail", parsed == {"target-check"}, summary))
    parsed, reason = parse_verdicts(
        "not-a-check  continuation\nchecks: 4 ok, 1 failed\n",
        {"target-check": "description"})
    checks.append(("unknown-failure-line", parsed is None
                   and "0 known check IDs" in reason, reason))

    ended_description = "no unit ended the read-only run before it reported"
    parsed, reason = interpret_run(
        subprocess.CompletedProcess(
            [], 1,
            stdout=(f"every-unit-reported  {ended_description}  "
                    "(fixture crashed)\nchecks: 4 ok, 1 failed\n"),
            stderr="Traceback (most recent call last):\nFixtureError: broken",
        ),
        {"every-unit-reported": ended_description},
    )
    checks.append(("crash-trace-kept", parsed is None
                   and "Traceback (most recent call last)" in reason
                   and "FixtureError: broken" in reason, reason))
    parsed, reason = interpret_run(
        subprocess.CompletedProcess(
            [], 1,
            stdout=(f"every-unit-reported  {ended_description}  "
                    "(SystemExit: 2)\nchecks: 4 ok, 1 failed\n"),
            stderr="",
        ),
        {"every-unit-reported": ended_description},
    )
    checks.append(("early-exit-is-not-a-bite", parsed is None
                   and "SystemExit: 2" in reason, reason))

    request, error = parse_request([
        "--live", "--expect", "check-a", "old-a", "new-a",
        "--expect", "check-b", "old-b", "new-b",
    ])
    checks.append(("multiple-cases-parse",
                   not error and request == (
                       True, [("check-a", "old-a", "new-a"),
                              ("check-b", "old-b", "new-b")]),
                   error or repr(request)))
    request, error = parse_request(["old", "new"])
    checks.append(("exploratory-case-parses",
                   not error and request == (False, [(None, "old", "new")]),
                   error or repr(request)))
    request, error = parse_request([
        "--expect", "check-a", "--live", "new-a",
    ])
    checks.append(("mutation-text-can-look-like-a-flag",
                   not error and request == (
                       False, [("check-a", "--live", "new-a")]),
                   error or repr(request)))
    request, error = parse_request([
        "--expect", "check-a", "old-a", "new-a", "unmarked",
    ])
    checks.append(("unmarked-batch-case-refused",
                   request is None and "must start with --expect" in error,
                   error or repr(request)))

    def overlap(live, mutant_count):
        expected = min(MAX_PARALLEL_SUITES, mutant_count + 1)
        state = {"active": 0, "maximum": 0, "calls": []}
        lock = threading.Lock()
        release = threading.Event()

        def fake(path, _live, _valid):
            with lock:
                state["active"] += 1
                state["maximum"] = max(state["maximum"], state["active"])
                state["calls"].append(path)
                if state["maximum"] == expected:
                    release.set()
            release.wait(2)
            with lock:
                state["active"] -= 1
            return {path}, str(path)

        paths = [f"mutant-{at}" for at in range(mutant_count)]
        clean, mutants = verdict_batch("clean", paths, live, {}, run=fake)
        return state, clean, mutants, paths

    read_state, clean, mutants, paths = overlap(False, 2)
    live_state, _live_clean, _live_mutants, _live_paths = overlap(True, 2)
    capped_state, _cap_clean, _cap_mutants, _cap_paths = overlap(
        False, MAX_PARALLEL_SUITES * 2)
    checks.append(("batch-reuses-one-clean-run",
                   read_state["calls"].count("clean") == 1
                   and sorted(read_state["calls"]) == sorted(["clean", *paths])
                   and clean == ({"clean"}, "clean")
                   and mutants == [({path}, path) for path in paths],
                   repr((read_state, clean, mutants))))
    checks.append(("read-only-batch-concurrent",
                   read_state["maximum"] == 3,
                   f"maximum active={read_state['maximum']}"))
    checks.append(("live-batch-concurrent",
                   live_state["maximum"] == 3,
                   f"maximum active={live_state['maximum']}"))
    checks.append(("batch-concurrency-capped",
                   capped_state["maximum"] == MAX_PARALLEL_SUITES,
                   f"maximum active={capped_state['maximum']}"))
    failed = [(name, detail) for name, ok, detail in checks if not ok]
    for name, detail in failed:
        print(f"FAIL {name}: {detail}")
    print(f"probe checks: {len(checks) - len(failed)} ok, {len(failed)} failed")
    return 1 if failed else 0


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    request, objection = parse_request(argv)
    if objection:
        print(__doc__.strip().splitlines()[0])
        print(f"usage error: {objection}")
        print("usage: probe [--live] --expect CHECK OLD NEW "
              "[--expect CHECK OLD NEW ...]")
        print("       probe [--live] OLD NEW")
        return 2
    live, cases = request

    valid = known_checks(TOOL, live)
    unknown = [(at, expected) for at, (expected, _old, _new) in enumerate(cases, 1)
               if expected is not None and expected not in valid]
    if unknown:
        examples = ", ".join(sorted(valid)[:5])
        for at, expected in unknown:
            print(f"case {at}: {expected!r} names no check this suite defines")
        print(f"--selftest --list prints them all. Some real ids: {examples}")
        return 2

    # Either file beside the other is fair game: the suite drives the zsh
    # completion through a real shell, so a probe aimed at it must be able to
    # break it. Each old string must occur exactly once across the pair; every
    # case then receives its own copy of both files.
    prepared, invalid = [], []
    for at, (expected, old, new) in enumerate(cases, 1):
        target, reason = mutation_target(old)
        if reason:
            invalid.append((at, reason))
        else:
            prepared.append((expected, old, new, target))
    if invalid:
        for at, reason in invalid:
            print(f"case {at}: {reason}")
        return 2

    with tempfile.TemporaryDirectory() as scratch:
        copies = []
        for at, (_expected, old, new, target) in enumerate(prepared, 1):
            room = Path(scratch) / f"case-{at}"
            room.mkdir()
            copy = room / TOOL.name
            # The suite reads its own source for structural checks and the
            # completion beside it for TAB checks, so both files belong to each
            # isolated mutant. Nothing here touches the working tree.
            shutil.copy2(TOOL, copy)
            shutil.copy2(COMP, room / COMP.name)
            mutated = room / target.name
            mutated.write_text(target.read_text().replace(old, new, 1))
            # Behavioural checks read test/corpus/ beside the tool. Keep a copy
            # per mutant so a future writing fixture cannot couple two cases.
            shutil.copytree(TOOL.parent / "test", room / "test")
            copies.append(copy)

        (before, before_said), after_runs = verdict_batch(
            TOOL, copies, live, valid)

    if before is None:
        print(f"before the probe, {before_said}")
        return 2

    print(f"clean: {before_said}")
    multiple = len(prepared) > 1
    status = 0
    for at, ((expected, _old, _new, target), (after, after_said)) in enumerate(
            zip(prepared, after_runs), 1):
        indent = "  " if multiple else ""
        if multiple:
            print(f"\ncase {at}: expected {expected} ({target.name})")
        if after is None:
            print(f"{indent}with the mutation applied, {after_said}")
            print(f"{indent}a crash is not a bite: the check must fail without "
                  "stopping the suite from answering")
            status = 2
            continue

        bit = sorted(after - before)
        healed = sorted(before - after)
        print(f"{indent}probed: {after_said}")
        if healed:
            print(f"{indent}stopped failing:")
            for cid in healed:
                print(f"{indent}  {cid}")
        if not bit:
            print(f"{indent}nothing bit; every check passed with this mutation")
            status = max(status, 1)
            continue
        print(f"{indent}bit:")
        for cid in bit:
            print(f"{indent}  {cid}")
        if expected is None:
            continue
        others = [cid for cid in bit if cid != expected]
        if expected not in bit:
            print(f"{indent}{expected!r} did not bite; the failures above are "
                  "unrelated to this mutation")
            status = max(status, 1)
        elif others:
            print(f"{indent}{expected!r} bit, and {len(others)} additional "
                  "check(s) also failed")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
