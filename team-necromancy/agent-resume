@unit(('lock-refused-leaves-the-roster-alone', 'a roster is left byte for byte when its lock cannot be taken'),
      ('lock-without-an-owner-is-never-taken', 'a lock carrying no owner record is waited for, never taken'),
      ('lock-left-by-a-dead-run-is-taken', 'a lock is taken when its recorded owner is gone, and the run says so'),
      ('lock-of-a-live-owner-is-kept', 'a lock is left alone while its recorded owner is still running'),
      ('stale-lock-that-will-not-come-away-refuses', 'a stale lock this run cannot remove ends at the deadline, not in a spin'),
      ('lock-replaced-mid-verdict-is-not-taken', "a dead owner's lock replaced by a live one before the removal is left alone"),
      ('release-leaves-a-replacement-lock-alone', 'a lock that replaced ours while we held it is not removed on the way out'))
def _check_team_lock_fails_closed(s):
    import threading

    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # Long enough that a loaded machine finishing a hundredth-of-a-second wait
    # never trips it, short enough that a wait which never ends is reported
    # rather than sat through.
    WRITE_DEADLINE = 5.0
    lock_base = Path(tempfile.mkdtemp())
    real_teams_dir, real_projects_dir, real_needs = (
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs)
    real_lock = globals()["team_lock"]
    try:
        RESOLVER._teams_dir, RESOLVER._projects_dir = lock_base, lock_base / "projects"
        RESOLVER._needs = Needs(maybe=set(NEED))
        lteam = "session-lockcheck"
        (lock_base / lteam / "inboxes").mkdir(parents=True)
        lcfg = RESOLVER._roster_path(lteam)
        lcfg.write_text(json.dumps({
            "name": lteam, "leadAgentId": f"team-lead@{lteam}", "leadSessionId": "x",
            "members": [{"agentId": f"team-lead@{lteam}", "name": "team-lead"}]}))
        untouched = lcfg.read_bytes()
        lock = lcfg.with_name("config.json.lock")
        late_id = f"late@{lteam}"
        project = RESOLVER._projects_dir / "project"
        project.mkdir(parents=True)
        (project / "late.jsonl").write_text(fixture_line({
            "parentUuid": None, "type": "user", "uuid": "late-root",
            "sessionId": "late", "agentName": "late", "teamName": lteam,
            "timestamp": "2026-01-01T00:00:00Z"}) + "\n")
        with capturing("err"):
            launch = RESOLVER.launch_plan(agent_id=late_id, table=())

        stragglers = []

        def write_against(shape, aged=False, exists=False, meanwhile=None):
            """One roster write against a lock of this shape.

            Returns what it refused with or None, and everything it said. A
            tenth of a second stands in for the ten a real run waits: which
            locks it will take is the question here, not how long it waits
            before saying it could not take one. `exists` is for a lock the
            caller has already put in place, because the directory it sits in
            is no longer writable by the time this runs.

            The write runs in a thread with a deadline of its own, because one
            of the cases below exists to catch a wait that never reaches its
            own deadline. Left in this thread, that regression hangs the whole
            suite: nothing is reported, the probe reads no verdict at all
            rather than a failure, and somebody has to kill the run by hand. A
            write that outlives the deadline answers "did not finish", which
            fails whichever check it belongs to. Daemon, so a thread still
            spinning cannot hold the interpreter open, and the capture stays in
            this thread so a stuck writer cannot leave stdout swapped for the
            rest of the suite.

            `meanwhile` runs after the engine has answered what is at the lock
            and before anything acts on that answer, which is where another run
            can take a dead owner's lock away and put its own there.
            """
            if exists:
                pass
            elif shape is None:
                lock.mkdir()   # the shape the harness's own lock helper makes
            else:
                lock.write_bytes(shape)
            if aged:
                old = time.time() - 3600
                os.utime(lock, (old, old))
            globals()["team_lock"] = (
                lambda plan, write, timeout=0.1: real_lock(plan, write, timeout))
            real_holder = RESOLVER._lock_holder
            if meanwhile:
                def racing(path):
                    answer = real_holder(path)
                    meanwhile()
                    return answer
                RESOLVER._lock_holder = racing
            got = []

            def attempt():
                try:
                    plan = RESOLVER.membership_plan(
                        launch, "record", pane="%1", alive=True)
                    apply_membership(plan)
                    got.append(None)
                except Refusal as refusal:
                    got.append(refusal.said)

            writer = threading.Thread(target=attempt, daemon=True)
            try:
                with capturing("out") as out, capturing("err") as err:
                    writer.start()
                    writer.join(WRITE_DEADLINE)
            finally:
                RESOLVER._lock_holder = real_holder
            said = out.getvalue() + err.getvalue()
            if not got:
                stragglers.append(writer)
                return f"did not finish in {WRITE_DEADLINE:g}s", said
            return got[0], said

        def clear_lock():
            if lock.is_dir():
                lock.rmdir()
            elif lock.exists():
                lock.unlink()

        # Our own pid and start time: a live owner, and the record a run really
        # writes. Only the start time differs in the dead case, so what answers
        # there is the recycled-pid guard rather than the pid being absent.
        live_owner = json.dumps({"tool": TOOL, "pid": os.getpid(),
                                 "procStart": RESOLVER._proc_start(os.getpid())}).encode()
        dead_owner = json.dumps({"tool": TOOL, "pid": os.getpid(),
                                 "procStart": "1"}).encode()

        live_said, live_out = write_against(live_owner)
        live_roster, live_there = lcfg.read_bytes() == untouched, lock.is_file()
        clear_lock()

        empty_said, empty_out = write_against(b"", aged=True)
        empty_kept = lock.is_file() and "taking it over" not in empty_out
        clear_lock()

        dir_said, dir_out = write_against(None, aged=True)
        dir_kept = lock.is_dir() and "taking it over" not in dir_out
        clear_lock()

        # A lock this run judges stale and then cannot remove: the parent
        # directory is read-only, so the create still answers EEXIST and the
        # unlink answers EACCES. An earlier draft looped on that pair without
        # ever reaching its deadline. It runs last of all, at the bottom of this
        # block: the regression it catches is a write that never returns, and
        # the thread carrying it is still spinning on this same lockfile when
        # the deadline hands the run back. Anything staged after it would be
        # answering against a fixture that thread is still writing to.

        # A second run takes a dead owner's lock over in the gap between this
        # run reading that record and acting on it. What sits at the name by
        # then is a live lock with its owner inside, and an unlink by name would
        # take it away. A real takeover leaves a different inode carrying a live
        # record, which is what this puts there.
        lock.write_bytes(dead_owner)
        swapped = []

        def swap_in_a_live_lock():
            if swapped:
                return   # once: the wait below reads the replacement each pass
            swapped.append(True)
            lock.unlink()
            lock.write_bytes(live_owner)

        raced_said, raced_out = write_against(dead_owner, exists=True,
                                              meanwhile=swap_in_a_live_lock)
        raced_kept = lock.is_file() and lock.read_bytes() == live_owner
        clear_lock()

        # Somebody else takes the name while we are inside the lock. What sits
        # there at the end is theirs, and a release that removed it would hand
        # the lock out while two writers were in it. A regular file rather than
        # a directory on purpose: unlink really would take this one away, so
        # what keeps it is the guard and not a removal that happens to fail.
        stranger = b'{"tool": "somebody else"}'
        with real_lock({}, {"lock": lock, "lock_owner": {
                "tool": TOOL, "pid": os.getpid(),
                "procStart": RESOLVER._proc_start(os.getpid()),
        }}, 0.1):
            lock.unlink()
            lock.write_bytes(stranger)
        replacement_kept = lock.is_file() and lock.read_bytes() == stranger
        clear_lock()

        taken_said, taken_out = write_against(dead_owner)
        taken_listed = [m.get("name") for m in
                        json.loads(lcfg.read_text()).get("members", [])]
        taken_gone = not lock.exists()
        lcfg.write_bytes(untouched)
        clear_lock()

        # A lock this run judges stale and then cannot remove: the parent
        # directory is read-only, so the create still answers EEXIST and the
        # unlink answers EACCES. Root ignores those bits, so on a run as root
        # the removal succeeds and this case reports a failure rather than a
        # hang, which is the safe way round.
        lock.write_bytes(dead_owner)
        os.chmod(lock.parent, 0o500)
        try:
            stuck_said, stuck_out = write_against(dead_owner, exists=True)
        finally:
            os.chmod(lock.parent, 0o700)
        stuck_kept = lock.is_file() and lcfg.read_bytes() == untouched

        # A write that missed its deadline is still going. Whatever it says when
        # it does land would otherwise arrive on the real stdout in the middle
        # of the suite's own report, where a reader, and the probe reading this
        # suite's failures, take it for a verdict. Give it the fixture's last
        # moments with the capture still up; one that never finishes at all is a
        # daemon thread and ends with the interpreter.
        with capturing("out"), capturing("err"):
            for straggler in stragglers:
                straggler.join(WRITE_DEADLINE)
    finally:
        os.chmod(lock_base / lteam, 0o700)
        globals()["team_lock"] = real_lock
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs = (
            real_teams_dir, real_projects_dir, real_needs)
        shutil.rmtree(lock_base, ignore_errors=True)

    check("lock-refused-leaves-the-roster-alone",
          "a roster is left byte for byte when its lock cannot be taken",
          bool(live_said) and live_roster,
          f"refused with {live_said!r}, roster unchanged {live_roster}")
    check("lock-without-an-owner-is-never-taken",
          "a lock carrying no owner record is waited for, never taken",
          empty_kept and dir_kept,
          f"empty: kept {empty_kept}, said {empty_said!r}; "
          f"directory: kept {dir_kept}, said {dir_said!r}")
    check("lock-left-by-a-dead-run-is-taken",
          "a lock is taken when its recorded owner is gone, and the run says so",
          taken_said is None and "late" in taken_listed and taken_gone
          and f"exited pid {os.getpid()}" in taken_out
          and "removing the stale lock" in taken_out,
          f"refused {taken_said!r}, roster lists {taken_listed}, "
          f"said {taken_out.strip()!r}")
    check("lock-of-a-live-owner-is-kept",
          "a lock is left alone while its recorded owner is still running",
          live_there and "removing the stale lock" not in live_out,
          f"lock still there {live_there}, said {live_out.strip()!r}")
    check("stale-lock-that-will-not-come-away-refuses",
          "a stale lock this run cannot remove ends at the deadline, not in a spin",
          bool(stuck_said) and stuck_kept and "removal failed" in (stuck_said or "")
          and "removing the stale lock" not in stuck_out,
          f"refused {stuck_said!r}, lock and roster untouched {stuck_kept}")
    check("lock-replaced-mid-verdict-is-not-taken",
          "a dead owner's lock replaced by a live one before the removal is left alone",
          raced_kept and bool(raced_said) and "removing the stale lock" not in raced_out,
          f"replacement still there {raced_kept}, refused {raced_said!r}, "
          f"said {raced_out.strip()!r}")
    check("release-leaves-a-replacement-lock-alone",
          "a lock that replaced ours while we held it is not removed on the way out",
          replacement_kept, f"replacement still there {replacement_kept}")
    return checked


@unit(('refused-release-says-what-stays-claimed', 'a selected claim release refuses without changing its roster'),
      ('refused-rollback-keeps-the-exec-error', 'a failed exec is still the reason a run ends, even when the roster refuses too'),
      ('become-the-agent-one-place', 'one function turns a run into the agent, and a launch that dies there unwinds what it wrote'))
def _check_refused_teardown_reports(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs

    give_base = Path(tempfile.mkdtemp())
    real_teams_dir, real_projects_dir, real_needs = (
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs)
    real_lock = globals()["team_lock"]
    try:
        RESOLVER._teams_dir, RESOLVER._projects_dir = give_base, give_base / "projects"
        RESOLVER._needs = Needs(maybe=set(NEED))
        gteam = "session-givebackcheck"
        agent_id = agent_id_of("claimant", gteam)
        (give_base / gteam / "inboxes").mkdir(parents=True)
        gcfg = RESOLVER._roster_path(gteam)
        gcfg.write_text(json.dumps({
            "name": gteam, "leadAgentId": f"team-lead@{gteam}", "leadSessionId": "x",
            "members": [{"agentId": f"team-lead@{gteam}", "name": "team-lead"}]}))
        project = RESOLVER._projects_dir / "giveback"
        project.mkdir(parents=True)
        (project / "claimant.jsonl").write_text(fixture_line({
            "parentUuid": None, "type": "user", "uuid": "claimant-root",
            "sessionId": "claimant", "agentName": "claimant", "teamName": gteam,
            "timestamp": "2026-01-01T00:00:00Z"}) + "\n")
        # A claimant the roster does not list yet is the case under test, and
        # planning for one correctly says no config carries that id.
        with capturing("err"):
            launch = RESOLVER.launch_plan(agent_id=agent_id, table=())
        reserve = RESOLVER.membership_plan(launch, "reserve")
        with capturing("out"), capturing("err"):
            claim = apply_membership(reserve)
        release = RESOLVER.membership_plan(launch, "release", claim=claim)
        # An empty lock is one this tool will never take, so the selected release
        # refuses. A tenth of a second stands in for the ten a real run waits.
        glock = gcfg.with_name("config.json.lock")
        glock.write_bytes(b"")
        gbefore = gcfg.read_bytes()
        globals()["team_lock"] = (
            lambda plan, write, timeout=0.1: real_lock(plan, write, timeout))
        with capturing("out"), capturing("err"):
            try:
                apply_membership(release)
                gave_up = None
            except Refusal as refusal:
                gave_up = refusal.said
        gkept = gcfg.read_bytes() == gbefore and glock.is_file()
        release_selected = (
            release["record"] is launch["roster"]["record"]
            and release["claim"] is claim)
    finally:
        globals()["team_lock"] = real_lock
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs = (
            real_teams_dir, real_projects_dir, real_needs)
        shutil.rmtree(give_base, ignore_errors=True)

    check("refused-release-says-what-stays-claimed",
          "a selected claim release refuses without changing its roster",
          gave_up is not None and str(gcfg) in gave_up and gkept and release_selected,
          f"refused {gave_up!r}, roster and lock untouched {gkept}, "
          f"release retained selected facts {release_selected}")

    # The other teardown, read out of the tree rather than driven: an exec that
    # does not fail replaces this process, so there is no run left to observe.
    # Read rather than grepped, because a substring matches a comment as well as
    # code. It is still a statement about what the file says and not about what
    # runs: code no branch reaches has the same syntax as code every branch
    # does, so this proves the rollback is written where a failure lands, and
    # the two behavioural checks below prove what the rollback then does.
    def says(call, text):
        for arg in call.args:
            parts = arg.values if isinstance(arg, ast.JoinedStr) else [arg]
            if any(isinstance(part, ast.Constant) and isinstance(part.value, str)
                   and text in part.value for part in parts):
                return True
        return False

    def calling(node, name):
        return [sub for sub in ast.walk(node) if isinstance(sub, ast.Call)
                and getattr(sub.func, "id", None) == name]

    # One place puts the roster back, and this is its shape: the rollback sits
    # inside a try, a roster that refuses it is said out loud and not re-raised
    # over the reason the launch failed, and the exec error is what ends the run
    # afterwards.
    wrong = []
    putter = funcs.get("unwind_launch")
    ender = funcs.get("exec_failed")
    if putter is None:
        wrong.append("unwind_launch is gone, so nothing says how the roster goes back")
    else:
        guards = [sub for sub in ast.walk(putter)
                  if isinstance(sub, ast.Try) and calling(sub, "restore_member")]
        if not guards:
            wrong.append("the rollback is not guarded against a roster that refuses it")
        else:
            caught = [arm for arm in guards[0].handlers
                      if isinstance(arm.type, ast.Name) and arm.type.id == "Refusal"]
            if not caught:
                wrong.append("a refusal from the rollback is not caught")
            elif not all(calling(arm, "warn") for arm in caught):
                wrong.append("a caught refusal is swallowed without a word")
            elif any(isinstance(sub, ast.Raise) for arm in caught for sub in ast.walk(arm)):
                wrong.append("a caught refusal is re-raised over the reason the run ends")
    puts_back = s.callers_of("restore_member") - s.suite_fns
    if puts_back != {"unwind_launch"}:
        wrong.append(f"the roster is put back from {sorted(puts_back)}, not from one place")
    if ender is None:
        wrong.append("exec_failed is gone, so nothing says what a failed exec does")
    else:
        dies = [call for call in calling(ender, "die") if says(call, "cannot exec")]
        unwinds = calling(ender, "unwind_launch")
        if not dies:
            wrong.append("nothing in it ends the run in the exec error")
        if not unwinds:
            wrong.append("a failed exec does not put the roster back")
        if dies and unwinds and max(c.lineno for c in dies) <= min(c.lineno for c in unwinds):
            wrong.append("the exec error is not the last thing that happens")
    check("refused-rollback-keeps-the-exec-error",
          "a failed exec is still the reason a run ends, even when the roster refuses too",
          not wrong, "; ".join(wrong))

    # And the way a run becomes the agent has one owner. become_agent holds the
    # environment, the cwd move and the exec; the three routes through run_one
    # ask it rather than keeping copies, because the copies had drifted twice
    # over - a rollback aimed at a roster the run had not written, and two of
    # three execs booting bare, inheriting whatever the shell exported, which
    # silently sheds the identity anywhere the teams var is not exported. The
    # execs allowed outside it boot something other than the resolved agent:
    # maybe_attach execs tmux, and run_promote execs this tool, and that run
    # prepares its own launch.
    told = []
    becomer = funcs.get("become_agent")
    if becomer is None:
        told.append("become_agent is gone, so becoming the agent has no owner")
    else:
        homes = {}
        for fn in funcs.values():
            for sub in ast.walk(fn):
                if (isinstance(sub, ast.Call)
                        and getattr(sub.func, "attr", "") in ("execvp", "execvpe")):
                    homes.setdefault(fn.name, []).append(sub.func.attr)
        booting = {name: kinds for name, kinds in homes.items()
                   if name not in s.suite_fns}
        if booting != {"become_agent": ["execvpe"], "maybe_attach": ["execvp"],
                       "run_promote": ["execvp"]}:
            told.append(f"execs live at {booting}")

        def guarded(inner, rollback, kind):
            """Handler linenos that reach the rollback / that do not, for tries
            holding a call of inner inside become_agent."""
            held, bare = [], []
            for node in ast.walk(becomer):
                if not isinstance(node, ast.Try):
                    continue
                if not any(isinstance(sub, ast.Call)
                           and getattr(sub.func, kind, "") in inner
                           for stmt in node.body for sub in ast.walk(stmt)):
                    continue
                for arm in node.handlers:
                    reached = {getattr(sub.func, "id", None)
                               for sub in ast.walk(arm) if isinstance(sub, ast.Call)}
                    (held if rollback in reached else bare).append(arm.lineno)
            return held, bare

        unwound, straight = guarded({"execvpe"}, "exec_failed", "attr")
        if not unwound or straight:
            told.append("the exec is not guarded by exec_failed alone")
        cwd_unwound, cwd_straight = guarded({"enter_agent_cwd"}, "unwind_launch", "id")
        refusals = [node for node in ast.walk(becomer)
                    if isinstance(node, ast.ExceptHandler)
                    and getattr(node.type, "id", None) == "Refusal"]
        if not cwd_unwound or cwd_straight:
            told.append("the cwd move does not unwind the roster write")
        elif not any(isinstance(sub, ast.Raise) and sub.exc is None
                     for arm in refusals for sub in ast.walk(arm)):
            told.append("a refused cwd move is not re-raised as it stands")
        names = {getattr(sub, "id", None) for sub in ast.walk(becomer)}
        if "TEAM_ENV" not in names:
            told.append("the exec environment does not carry TEAM_ENV")
        if "poison_said" not in {getattr(sub.func, "id", None)
                                 for sub in ast.walk(becomer)
                                 if isinstance(sub, ast.Call)}:
            told.append("the poison is not asked about where the strip is loud")

        callers = [sub for sub in ast.walk(funcs["run_one"])
                   if isinstance(sub, ast.Call)
                   and getattr(sub.func, "id", "") == "become_agent"]
        carrying = [c for c in callers
                    if any(kw.arg == "undo" for kw in c.keywords)]
        if len(callers) != 3 or len(carrying) != 2:
            told.append(f"run_one reaches it {len(callers)} time(s), "
                        f"{len(carrying)} with a roster write to take back; "
                        "the routes are two members with an undo and a lead without")
        outside = s.callers_of("enter_agent_cwd") - s.suite_fns
        if outside != {"become_agent"}:
            told.append(f"the cwd move is made from {sorted(outside)}, not one place")
    # A handler that writes a roster instead of taking one back is the bug this
    # whole unit came from, in the one place it would be invisible.
    still_writing = [node.lineno
                     for fn in (funcs["run_one"],) + ((becomer,) if becomer else ())
                     for node in ast.walk(fn)
                     if isinstance(node, ast.ExceptHandler)
                     for sub in ast.walk(node)
                     if isinstance(sub, ast.Call) and getattr(sub.func, "id", "") in
                     {"retire_member", "register_member", "update_team_config",
                      "record_membership"}]
    if still_writing:
        told.append(f"wrote a roster from a handler at {still_writing}")
    check("become-the-agent-one-place",
          "one function turns a run into the agent, and a launch that dies there unwinds what it wrote",
          not told, "; ".join(told))
    return checked


@unit(('failed-exec-takes-back-the-entry-it-wrote',
       'a launch that never happened removes the selected new roster entry'),
      ('failed-exec-restores-an-entry-it-found',
       'an entry that predates the launch returns to its exact previous value'),
      ('membership-rollback-restores-selected-written-state',
       'rollback accepts only the exact entry the selected record plan wrote'))
def _check_failed_exec_puts_the_roster_back(s):
    """Exercise selected membership rollback plans without legacy launch shims.

    Member routing has its own operation-specific answer. This unit asks the
    persistence boundary only: a launch answer selects a roster record, a record
    plan writes it, and the rollback plan restores its selected prior state.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    back_base = Path(s.tempfile.mkdtemp())
    real_teams_dir, real_projects_dir, real_needs = (
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs)
    try:
        RESOLVER._teams_dir, RESOLVER._projects_dir = back_base, back_base / "projects"
        RESOLVER._needs = Needs(maybe=set(NEED))

        def stage(label, existing=None):
            team = f"session-rollback-{label}"
            agent_id = agent_id_of("mover", team)
            team_dir = RESOLVER._teams_dir / team
            team_dir.joinpath("inboxes").mkdir(parents=True)
            cfg = RESOLVER._roster_path(team)
            members = [{"agentId": agent_id_of("team-lead", team), "name": "team-lead"}]
            if existing is not None:
                members.append(copy.deepcopy(existing))
            cfg.write_text(json.dumps({
                "name": team, "leadAgentId": agent_id_of("team-lead", team),
                "leadSessionId": "lead", "members": members}, indent=2))
            project = RESOLVER._projects_dir / label
            project.mkdir(parents=True)
            (project / f"{label}.jsonl").write_text(fixture_line({
                "parentUuid": None, "type": "user", "uuid": f"{label}-root",
                "sessionId": label, "agentName": "mover", "teamName": team,
                "timestamp": "2026-01-01T00:00:00Z"}) + "\n")
            # Staged without an existing entry, the mover is a member no
            # config lists yet, and planning for one says so. The staged-with
            # arm passes `existing`, is listed, and warns about nothing, which
            # is the difference this fixture is built to hold.
            with capturing("err"):
                launch = RESOLVER.launch_plan(agent_id=agent_id, table=())
            return team, agent_id, cfg, launch

        def entry_for(cfg, agent_id):
            return next((member for member in json.loads(cfg.read_text())["members"]
                         if member.get("agentId") == agent_id), None)

        new_team, new_id, new_cfg, new_launch = stage("new")
        new_record = RESOLVER.membership_plan(
            new_launch, "record", pane="%7", alive=True, now_ms=100)
        with capturing("out"), capturing("err"):
            new_undo = apply_membership(new_record)
        wrote_new = entry_for(new_cfg, new_id)
        new_restore = RESOLVER.membership_plan(
            new_launch, "restore", undo=new_undo)
        with capturing("out"), capturing("err"):
            apply_membership(new_restore)
        removed_new = entry_for(new_cfg, new_id)

        old_team = "session-rollback-existing"
        old_id = agent_id_of("mover", old_team)
        was = {"agentId": old_id, "name": "mover", "joinedAt": 17,
               "subscriptions": [], "agentType": "general-purpose",
               "tmuxPaneId": "%9", "backendType": "tmux", "isActive": False,
               "color": "red", "model": "claude-sonnet-4"}
        _team, _agent_id, old_cfg, old_launch = stage("existing", was)
        old_record = RESOLVER.membership_plan(
            old_launch, "record", pane="%7", alive=True, now_ms=101)
        with capturing("out"), capturing("err"):
            old_undo = apply_membership(old_record)
        changed_old = entry_for(old_cfg, old_id)
        old_restore = RESOLVER.membership_plan(
            old_launch, "restore", undo=old_undo)
        selected_rollback = (
            old_record["record"] is old_launch["roster"]["record"]
            and old_undo["launch"] is old_launch
            and old_undo["written"] != old_undo["record"]
            and old_restore["action"] == "write"
            and len(old_restore["writes"]) == 1)
        with capturing("out"), capturing("err"):
            apply_membership(old_restore)
        restored_old = entry_for(old_cfg, old_id)
    finally:
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs = (
            real_teams_dir, real_projects_dir, real_needs)
        shutil.rmtree(back_base, ignore_errors=True)

    check("failed-exec-takes-back-the-entry-it-wrote",
          "a launch that never happened removes the selected new roster entry",
          bool(wrote_new) and wrote_new.get("isActive") is True and removed_new is None,
          f"written as {wrote_new}, left as {removed_new}")
    check("failed-exec-restores-an-entry-it-found",
          "an entry that predates the launch returns to its exact previous value",
          changed_old != was and restored_old == was,
          f"written as {changed_old}, restored as {restored_old}, was {was}")
    check("membership-rollback-restores-selected-written-state",
          "rollback accepts only the exact entry the selected record plan wrote",
          selected_rollback and restored_old == was,
          f"selected rollback facts {selected_rollback}, restored as {restored_old}")
    return checked


@unit(('exec-environment-is-prepared-not-inherited',
       'the process an exec becomes finds the team vars set and the poison gone'))
def _check_exec_environment(s):
    """become_agent driven with the exec replaced, asserting on the environment
    it hands over rather than on the code that builds it.

    The claim under test is the boot condition: the binary binds the identity
    flags only when teams are enabled in the environment it wakes in, so an
    exec that inherits its environment silently sheds the identity anywhere
    the var is not exported (see TEAM_ENV). The poison is the other direction,
    a var that must not survive, and its strip must be said. The parent's own
    environment is asserted unchanged, because a launch that cleans its shell
    rather than its child would look identical from inside the child.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    seen = {}

    def taken(_prog, _argv, env):
        seen["env"] = env
        raise OSError(8, "Exec format error")

    real_exec = os.execvpe
    had = os.environ.get("ANTHROPIC_BASE_URL")
    # The suite itself runs where these vars are exported (a Claude Code tool
    # shell carries all three), so leaving them in the parent would let an
    # exec that merely inherits pass this check - the exact failure it
    # exists to catch. Absent from the parent, present at the exec, is the
    # only arrangement that proves preparation.
    worn = {name: os.environ.pop(name, None)
            for name in (pair.split("=", 1)[0] for pair in TEAM_ENV)}
    os.execvpe = taken
    os.environ["ANTHROPIC_BASE_URL"] = POISON_URL
    said = io.StringIO()
    outcome, parent_after = "", None
    try:
        with capturing("out", into=said), capturing("err", into=said):
            try:
                become_agent(
                    fixture_target("exec-env", cwd=None),
                    [f"{TOOL}-selftest-absent", "--resume", "u"], "")
            except Refusal as refused:
                outcome = str(refused)
        parent_after = os.environ.get("ANTHROPIC_BASE_URL")
    finally:
        os.execvpe = real_exec
        if had is None:
            os.environ.pop("ANTHROPIC_BASE_URL", None)
        else:
            os.environ["ANTHROPIC_BASE_URL"] = had
        for name, value in worn.items():
            if value is not None:
                os.environ[name] = value

    env = seen.get("env") or {}
    wanted = dict(pair.split("=", 1) for pair in TEAM_ENV)
    arrived = {name: env.get(name) for name in wanted}
    stated = []
    if not seen:
        stated.append("the exec was never reached")
    if arrived != wanted:
        stated.append(f"the team vars arrived as {arrived}")
    if "ANTHROPIC_BASE_URL" in env:
        stated.append("the poison survived into the exec environment")
    if "poison" not in said.getvalue():
        stated.append("the strip was silent")
    if parent_after != POISON_URL:
        stated.append("the parent environment was mutated")
    if "cannot exec" not in outcome:
        stated.append(f"the run ended in {outcome!r}, not the exec error")
    check("exec-environment-is-prepared-not-inherited",
          "the process an exec becomes finds the team vars set and the poison gone",
          not stated, "; ".join(stated))
    return checked


@unit(('claim-precedes-spawn-and-is-given-back',
       'the claim is taken before the spawn and released when the spawn fails'))
def _check_claim_precedes_spawn_and_is_given_back(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # Both halves of this claim are about what happens when the tool runs, so
    # they are answered by running it. `watch` fires between the claim and the
    # spawn, which is the one moment that separates them, and a fixture that
    # refuses to open a pane produces the failure the release is for.
    claimed = []
    resume_run("willow@session-corpus-alpha", listed=False, watch=claimed.append)
    at_spawn = claimed[0] if claimed else None

    refusing = _FakeTmux(sockets=["claude-swarm-test"])
    refusing.fail = {"new-session", "split-window", "new-window"}
    failed, after_failure, _server, _said = resume_run(
        "echo@session-corpus-alpha", listed=False, server=refusing)

    facts = {
        "the claim is in the roster before the spawn runs": at_spawn is not None,
        "it is claimed under its own name":
            (at_spawn or {}).get("name") == "willow",
        # Taken but not yet occupied: a claim carrying a pane would mean the
        # spawn had already happened and the order proves nothing.
        "it holds no pane yet at that moment":
            at_spawn is not None and not at_spawn.get("tmuxPaneId"),
        # A server that will not open a pane ends the run in a refusal, not a
        # reported launch and not a silent success. Pinned to the exact
        # outcome, so a change from refusing to quietly carrying on is a
        # failure here rather than something this check shrugs at.
        "a spawn that cannot open a pane comes back refused":
            failed == "refused",
        "the claim is given back when it does": after_failure is None,
    }
    wrong = sorted(name for name, ok in facts.items() if not ok)
    check("claim-precedes-spawn-and-is-given-back",
          "the claim is taken before the spawn and released when the spawn fails",
          not wrong,
          "; ".join(wrong + [f"at spawn {at_spawn}, failed {failed!r}, "
                             f"after {after_failure}"]) if wrong else "")
    return checked


def _invented_pid(pid):
    """Whether pid is one the selftest invented: numbered at or above PID_CEILING."""
    try:
        return int(pid) >= PID_CEILING
    except (TypeError, ValueError):
        return False


class _FakeTmux:
    """A tmux server kept in a dict, answering the command surface the tool
    uses. It also owns the process table and session registry associated
    with those panes. Faking those inputs here rather than at each caller is
    what makes this an integration fixture: runtime resolution,
    launch placement, seat_note, socket_state, pane_occupants, tint_pane and
    launch all run unmodified against it. Commands with output nobody
    parses answer success and say nothing, which is what the real server does.
    """

    def __init__(self, session_exists=True, panes=(), processes=(), registry=(),
                 sockets=(), started=None):
        self.sessions = {TMUX_SESSION} if session_exists else set()
        self.panes = [dict(p) for p in panes]
        self.processes = list(processes)
        self.registry = [dict(row) for row in registry]
        # Process start times in epoch ms, by pid. A process this world holds
        # and that is not listed here started when the world was attached:
        # after everything the fixture wrote, before anything the run does.
        self.started = dict(started or {})
        self.attached_at = None
        self.env, self.ran, self.fail = {}, [], set()
        self.next_pane = 1 + max([int(p["pane"][1:]) for p in self.panes] or [-1])
        self.next_pid = 1 + max([int(p["pid"]) for p in self.panes] or [PID_CEILING + 4241])
        # Named sockets this fixture claims exist and answer. A directory that
        # is never read: the fixture answers both the listing and the liveness
        # probe, so nothing stats or connects to this path.
        self.sockets = list(sockets)
        self.socket_dir = Path(f"/nonexistent/{TOOL}-selftest/sockets")

    def process_rows(self, refresh=False):
        return list(self.processes)

    @staticmethod
    def _world_reader(answer, real):
        """answer bound to the engine's own reader, marked as this world's."""
        def reader(pid):
            return answer(pid, real=real)
        reader.world_reader = True
        return reader

    def proc_stat(self, pid, real=None):
        """A pid this world invented runs nowhere, so it has no state or start.

        Invented pids are numbered from PID_CEILING up. A lower pid is a real
        process, the suite's own or one it started, and is read for real,
        through the engine's own reader and its fence.
        """
        if _invented_pid(pid):
            return None, None, None
        return real(pid)

    def cmdline(self, pid, real=None):
        """An invented pid has no command line; a real one is read for real."""
        if _invented_pid(pid):
            return ()
        return real(pid)

    def process_env(self, pid, names):
        """This world's processes carry no environment.

        A fixture's pid can be a number some real process on the machine holds,
        and the engine's own reader would then read that process's environment.
        """
        return {}

    def process_started(self, record):
        """When one of this world's processes started, in epoch ms, or None."""
        pid = (record or {}).get("pid")
        if pid in self.started:
            return self.started[pid]
        if any(row[0] == pid for row in self.processes):
            return self.attached_at
        return None

    def session_rows(self):
        return [dict(row) for row in self.registry]

    def socket_paths(self):
        """The swarm sockets this fixture claims, newest first as the real one."""
        return [self.socket_dir / name for name in self.sockets]

    def socket_is_alive(self, socket):
        """Whether one of this fixture's sockets has a server behind it."""
        name = socket.name if isinstance(socket, Path) else socket
        return name in self.sockets

    # The engine's inputs that read processes: the process table, the session
    # registry and the readers that answer for one process.
    PROCESS_INPUTS = ("_process_table", "_session_registry", "_process_start_ms",
                      "_proc_env", "_proc_stat", "_cmdline")

    # What attach replaces on the engine, named once so the restore below
    # cannot fall behind it: adding an input here and forgetting to put it
    # back is exactly the leak this pair exists to prevent.
    ENGINE_INPUTS = PROCESS_INPUTS + ("_swarm_sockets", "_socket_alive")

    def attach(self, engine):
        """Give a Resolver this fixture's process, session and socket inputs.

        Every input, always, including an empty socket set. A fixture that
        answered only when it had something to say would let the rest fall
        through to the machine's own socket directory, so a unit's result would
        depend on what happened to be running on the box. An empty set is an
        answer: this world has no sockets.
        """
        # The engine's own table counts reading it as computing PROCS, and a
        # verb's evidence audit holds it to what it declared; the world's table
        # is read in its place, so it counts the same.
        def process_table(refresh=False):
            engine._exercise(NEED.PROCS)
            return self.process_rows(refresh)
        process_table.world = self
        engine._process_table = process_table
        engine._session_registry = self.session_rows
        engine._process_start_ms = self.process_started
        engine._proc_env = self.process_env
        # A unit that put its own reader on the engine keeps it; otherwise the
        # world answers, reading through the engine's class for a real pid. A
        # restore by installed() leaves the class's own reader on the instance,
        # and an earlier attach leaves a world's; neither is a unit's.
        for name, answer in (("_proc_stat", self.proc_stat), ("_cmdline", self.cmdline)):
            current = vars(engine).get(name)
            own = getattr(type(engine), name)
            if (current is None or getattr(current, "__func__", None) is own
                    or getattr(current, "world_reader", False)):
                setattr(engine, name, self._world_reader(answer, own.__get__(engine)))
        engine._swarm_sockets = self.socket_paths
        engine._socket_alive = self.socket_is_alive
        if self.attached_at is None:
            self.attached_at = int(time.time() * 1000)
        return engine

    @contextlib.contextmanager
    def installed(self, engine, through=None):
        """Install this fixture as the world, and put the world back after.

        `through` is the callable installed as tmux, defaulting to this
        fixture. A unit that watches or intercepts commands passes its wrapper
        here rather than assigning the global itself, so wrapping costs it
        nothing and it still gets the restore.

        The one way a unit gets synthetic tmux. It holds the module globals a
        unit would otherwise swap by hand and the engine inputs attach
        replaces, and restores both in a finally, so a unit that raises leaves
        the process as it found it. Restoring only on the way out of a run
        that succeeded is the case that matters least: a unit that fails
        half-way is precisely the one that leaves something for the next unit,
        and in a sharded tier that next unit is somebody else's verdict.
        """
        was_global = {name: globals()[name] for name in ("tmux", "RESOLVER")}
        was_engine = {name: getattr(engine, name) for name in self.ENGINE_INPUTS}
        try:
            self.attach(engine)
            globals()["tmux"], globals()["RESOLVER"] = (through or self), engine
            yield self
        finally:
            globals().update(was_global)
            for name, before in was_engine.items():
                setattr(engine, name, before)

    def __call__(self, socket, *args):
        self.ran.append(tuple(args))
        argv, done = list(args), lambda out="", code=0: subprocess.CompletedProcess(
            ["tmux"], code, out, "" if code == 0 else "refused")
        cmd = argv[0] if argv else ""
        if cmd in self.fail:
            return done(code=1)
        if cmd == "has-session":
            return done(code=0 if TMUX_SESSION in self.sessions else 1)
        if cmd == "list-panes":
            return done("".join(f"{p['session']}\t{p['window']}\t{p['pane']}\t{p['pid']}\n"
                                for p in self.panes))
        if cmd == "show-environment":
            key = argv[-1]
            return done(f"{key}={self.env[key]}") if key in self.env else done(code=1)
        if cmd == "set-environment":
            # Two forms: `-g NAME VALUE` sets, `-gu NAME` removes. The unset
            # form is a word shorter, so reading the flags rather than the
            # positions is what keeps `-gu ANTHROPIC_BASE_URL` from being
            # stored as a variable named -gu while the real one stayed put.
            if any("u" in flag[1:] for flag in argv[1:] if flag.startswith("-")):
                self.env.pop(argv[-1], None)
            else:
                self.env[argv[-2]] = argv[-1]
            return done()
        if cmd in ("new-session", "split-window", "new-window"):
            pane = f"%{self.next_pane}"
            self.next_pane += 1
            pid = self.next_pid
            self.next_pid += 1
            if cmd == "new-session":
                name = socket.name if isinstance(socket, Path) else socket
                if name not in self.sockets:
                    self.sockets.append(name)
            self.sessions.add(TMUX_SESSION)
            self.panes.append({"session": TMUX_SESSION, "window": "@0",
                               "pane": pane, "pid": pid})
            return done(pane)
        return done()


# Hoisted out of the unit that used to own it: a helper reachable only
# after some other unit had run was a dependency on registration order,
# and a unit that ran first died on an attribute that did not exist yet.
class _Run:
    def __init__(self, **kw):
        self.__dict__.update({"resume": None, "agent_id": None, "to_team": None,
                              "for_team": None, "no_tint": True})
        self.__dict__.update(kw)

    def __getattr__(self, _name):
        return False  # every other flag is off; explicit ones above win


def resume_run(agent_id, *, listed=True, server=None, table=(), registry=(),
               watch=None, prepare=None, inspect=None, observe_launch_action=None,
               observe_outcome=None, **flags):
    """Run the real resume path against a writable copy of the corpus.

    Only the world outside the process is faked: one tmux server and the
    process table. Everything the tool decides for itself, which is the
    resolution, the guards, the placement, the roster writes and the
    report, executes. `watch` is called between the claim and the spawn,
    the one moment that shows whether a write landed before the process
    started or after it. `prepare` is handed the copy before anything reads
    it, for a case the shared corpus should not carry for everyone.
    `inspect` is handed the same copy once the run is over and before it is
    deleted, for the results that live in the tree rather than in the
    return value: another team's roster, an inbox, a restamped transcript.
    `observe_outcome` is handed the Outcome run_one returned, for what the run
    recorded about its launch rather than how the launch went.

    Returns (outcome, roster entry afterwards, the fake server, printed
    output), or ("refused", ...) when the run died on a refusal.
    """
    base = Path(tempfile.mkdtemp())
    shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", base / "corpus")
    if prepare:
        try:
            prepare(base / "corpus")
        except (Refusal, Exception):
            shutil.rmtree(base)
            raise
    eng = Resolver(needs=Needs(maybe=set(NEED)))
    eng._projects_dir, eng._teams_dir = base / "corpus" / "projects", base / "corpus" / "teams"
    # The fixture's process table is not static: a spawn that works makes a
    # process appear. Keeping the outside world in one object lets
    # launch_survived read the result instead of being told the answer.
    fake = server if server is not None else _FakeTmux(sockets=["claude-swarm-test"])
    fake.processes = list(table)
    fake.registry = [dict(row) for row in registry]
    who, team = agent_id.partition("@")[0], agent_id.partition("@")[2]
    cfg = eng._roster_path(team)
    roster = json.loads(cfg.read_text())
    if not listed:
        roster["members"] = [m for m in roster["members"] if m.get("name") != who]
    cfg.write_text(json.dumps(roster))

    def entry():
        members = json.loads(cfg.read_text()).get("members", [])
        return next((m for m in members if m.get("name") == who), None)

    # The socket this run happens on is the fixture's, listed and called
    # live by the fixture. There is no socket node anywhere: binding one
    # made socket_alive answer by connecting, which was honest about the
    # probe and dishonest about everything around it, since the rest of
    # the world was already synthetic and a bound node is one more thing
    # a failed run can leave on the machine.
    sockdir = base / "tmux"
    sockdir.mkdir()

    real_env = {k: os.environ.get(k) for k in ("TMUX_TMPDIR", "TMUX", "TMUX_PANE")}
    os.environ["TMUX_TMPDIR"] = str(sockdir)
    os.environ.pop("TMUX", None)
    os.environ.pop("TMUX_PANE", None)

    spawning = ("split-window", "new-window", "new-session", "respawn-pane")

    def watched(socket, *args):
        if not (args and args[0] in spawning):
            return fake(socket, *args)
        if watch:
            watch(entry())
        res = fake(socket, *args)
        if res.returncode == 0:
            # What a spawn that worked produces: a process wearing the id,
            # in the pane, and a transcript that has just been written to.
            # Deliberately not a path ending in /claude. This row is
            # indistinguishable from a real agent if it ever escapes the
            # fixture, so it takes the matcher's other branch, a versioned
            # path, and names itself a selftest. It still exercises the real
            # is_claude rather than dodging it.
            pane = res.stdout.strip()
            if not pane and args[0] == "respawn-pane":
                pane = args[args.index("-t") + 1]
            pid = next(row["pid"] for row in fake.panes
                       if row["pane"] == pane)
            fake.processes.append(
                (pid, 1, (FAKE_AGENT_BIN, "--resume", "x",
                          "--agent-id", agent_id)))
            for jsonl in eng._projects_dir.rglob("*.jsonl"):
                jsonl.touch()
        return res

    real_launch = globals()["launch"]

    def observed(plan, *rest, **kw):
        """Show the observer the action run_one selected, then hand on that
        same object.

        Watching here rather than selecting a plan in the caller is the whole
        point: this is the one the tool actually launches. The observer sees it
        and cannot stand in for it, because its return is discarded and `plan`
        is forwarded unchanged, so a check can assert identity against the
        object launch received rather than an equal copy of one it built.
        """
        if observe_launch_action:
            observe_launch_action(plan)
        return real_launch(plan, *rest, **kw)

    globals()["launch"] = observed
    world = contextlib.ExitStack()
    world.enter_context(fake.installed(eng, through=watched))
    said = io.StringIO()
    try:
        with capturing("out", into=said), capturing("err", into=said):
            try:
                out = run_one(_Run(agent_id=agent_id, socket="claude-swarm-test",
                                   **flags), [], fake.process_rows())
                status = out.status
                if observe_outcome:
                    observe_outcome(out)
            except Refusal:
                status = "refused"
        if inspect:
            inspect(base / "corpus")
        return status, entry(), fake, said.getvalue()
    finally:
        globals()["launch"] = real_launch
        world.close()
        # Back to exactly what was there, which under the suite runner is the
        # run's own private socket directory rather than the machine's. A key
        # that was unset goes back to unset.
        for key, value in real_env.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value
        shutil.rmtree(base, ignore_errors=True)


