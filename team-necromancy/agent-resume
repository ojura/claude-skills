    expected_process = chosen_snapshot["by_pid"][chosen_pid]
    facts = {
        "the default table was not read": not process_reads,
        "the selected pid came from the supplied table": answer["pid"] == chosen_pid,
        "the selected process is the canonical record":
            records == (expected_process,) and records[0] is expected_process,
        "the canonical record retains its exact argv tuple":
            records[0]["argv"] == (FAKE_AGENT_BIN, "--resume", chosen_session),
        "operative-team resolution received that snapshot":
