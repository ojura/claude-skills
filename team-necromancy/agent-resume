    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    real = "https://gateway.example"

    def carrier(server_url, shell_url):
        """One real resume with the base url on the server, the shell, or neither.

        The action is the one run_one selected, not one assembled here, so what
        is asserted is what the tool decided rather than what the check
        arranged. A fixture with no socket is a machine with no server, which
        is how the two "would pass down" cases are reached.
        """
        had = os.environ.get("ANTHROPIC_BASE_URL")
        fake = _FakeTmux(sockets=["claude-swarm-test"] if server_url else [])
        if server_url:
            fake.env["ANTHROPIC_BASE_URL"] = server_url
        seen = []
        try:
            os.environ.pop("ANTHROPIC_BASE_URL", None)
            if shell_url:
                os.environ["ANTHROPIC_BASE_URL"] = shell_url
            resume_run("willow@session-corpus-alpha", server=fake,
                       observe_launch_action=seen.append)
        finally:
            os.environ.pop("ANTHROPIC_BASE_URL", None)
            if had is not None:
                os.environ["ANTHROPIC_BASE_URL"] = had
        ran = " ".join(" ".join(str(part) for part in one) for one in fake.ran)
        return seen[0] if seen else None, "-u ANTHROPIC_BASE_URL" in ran

    on_server, scrubbed_real_server = carrier(real, None)
    poisoned_shell, scrubbed_real_from_poison = carrier(real, POISON_URL)
    poisoned_server, scrubbed_poison_server = carrier(POISON_URL, None)
    no_server_poison, scrubbed_inherited = carrier(None, POISON_URL)
    no_server_real, scrubbed_inherited_real = carrier(None, real)

    def server_of(action):
        return (action or {}).get("server") or {}

    carriers = {
        "a real url on the server is kept": not scrubbed_real_server,
        "a live server's real url survives a poisoned shell": not scrubbed_real_from_poison,
        "a poisoned server is scrubbed": scrubbed_poison_server,
        "a poison we would pass down is scrubbed": scrubbed_inherited,
        "a real url we would pass down is kept": not scrubbed_inherited_real,
        # The selected action carried the facts the decision was made from, so
        # the five outcomes above are readings of one answer rather than five
        # unrelated observations of printed text.
        "the action says the server was live and holding the url":
            server_of(on_server).get("alive") is True
            and server_of(on_server).get("base_url") == real,
        "the action says a poisoned server held the poison":
            server_of(poisoned_server).get("base_url") == POISON_URL,
        "the action says there was no server to carry one":
            server_of(no_server_poison).get("alive") is False
            and server_of(no_server_poison).get("base_url") == ""
            and server_of(no_server_real).get("alive") is False,
        "every case selected exactly one action": all(
            action is not None for action in
            (on_server, poisoned_shell, poisoned_server, no_server_poison, no_server_real)),
    }
    wrong = sorted(name for name, good in carriers.items() if not good)
    check("launch-baseurl-carriers", "a launch consults both carriers of a base url",
          not wrong, ", ".join(wrong))
    return checked


@unit(('team-launch-actions-use-distinct-seats-and-commands',
       'placing a whole team gives every member its own seat and the command its plan named'))
def _check_team_launch_actions_use_distinct_seats_and_commands(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # Seven is a stress fixture, not a capacity claim: nothing here says seven
    # is the most a window holds. What a regression would mean is ours, that
    # placing a whole team gives each member a seat of its own and launches the
    # command its own plan named.
    socket, team, wanted = "claude-swarm-test", "session-corpus-alpha", 7
    crew = [f"crew{at}" for at in range(wanted)]
    sessions = {name: f"{at + 1}c1e1c1e-c1e1-4c1e-8c1e-c1ec1ec1ec1e"
                for at, name in enumerate(crew)}

    def prepare(corpus):
        """Seven members of one team, each with a conversation to come back to."""
        path = corpus / "teams" / team / "config.json"
        roster = json.loads(path.read_text())
        listed = {member["agentId"] for member in roster["members"]}
        for name in crew:
            if f"{name}@{team}" not in listed:
                roster["members"].append({"agentId": f"{name}@{team}", "name": name})
        path.write_text(json.dumps(roster))
        for name, session in sessions.items():
            (corpus / "projects" / "corpus" / f"{session}.jsonl").write_text(
                fixture_line({"parentUuid": None, "type": "user", "uuid": session,
                              "sessionId": session, "agentName": name,
                              "teamName": team,
                              "timestamp": "2026-01-01T00:00:00Z"}) + "\n"
                + fixture_line({"type": "last-prompt", "leafUuid": session,
                                "sessionId": session}) + "\n")

    # One server across all seven, so panes accumulate the way they would in a
    # window rather than each member getting a fresh world.
    server = _FakeTmux(sockets=[socket])
    outcomes, seats, seen = [], [], {}
    for name in crew:
        plans = []
        status, entry, _srv, _said = resume_run(
            f"{name}@{team}", server=server, prepare=prepare,
            observe_launch_action=plans.append)
        outcomes.append(status)
        seen[name] = plans
        if entry and entry.get("tmuxPaneId"):
            seats.append(Seat(socket, entry["tmuxPaneId"]))

    spawning = [ran[0] for ran in server.ran
                if ran and ran[0] in ("new-session", "split-window", "new-window")]
    only_one = {name: len(plans) for name, plans in seen.items() if len(plans) != 1}
    plans = {name: found[0] for name, found in seen.items() if found}
    facts = {
        "every member was placed": outcomes == ["launched"] * wanted,
        "each launch selected exactly one plan": not only_one,
        "each got a seat of its own": len(set(seats)) == wanted,
        # The object launch is handed is the selected action, not the identity
        # answer it came from: its keys are action, destination, generation,
        # server, target_pane and wanted_present. So the member correlation
        # lives in the command the fixture recorded, asserted below, and what
        # is asserted here is that each launch got its own action object rather
        # than one shared or rebuilt between members.
        "each launch got a plan object of its own":
            len({id(plan) for plan in plans.values()}) == wanted,
        "each plan says which pane it was told to grow from": all(
            "target_pane" in plan and "generation" in plan
            for plan in plans.values()),
        "each plan names the destination it was launched on": all(
            isinstance(plan["destination"], LaunchDestination)
            and plan["destination"].socket == socket for plan in plans.values()),
        "each plan carries the server facts launch reads": all(
            {"session_live", "alive", "base_url"} <= set(plan["server"])
            for plan in plans.values()),
        "each plan carries the action it was launched by": all(
            plan["action"] for plan in plans.values()),
        "the fixture ran a spawn naming each member": all(
            any(f"{name}@{team}" in " ".join(ran) for ran in server.ran)
            for name in crew),
    }
    wrong = sorted(name for name, ok in facts.items() if not ok)
    check("team-launch-actions-use-distinct-seats-and-commands",
          "placing a whole team gives every member its own seat and the command "
          "its plan named",
          not wrong,
          "; ".join(wrong + [f"outcomes {outcomes}, seats {len(set(seats))}, "
                             f"plans {only_one or len(plans)}, ran {spawning}"])
          if wrong else "")
    return checked


@unit(('team-rebuild-preview-reaches-member-launches',
       'a missing or invalid roster can be rebuilt and used by a read-only team run'),
      ('team-rebuild-lead-session-follows-corroboration',
       'a rebuilt roster names the lead session only when evidence corroborates it, '
       'and warns otherwise'))
def _check_team_rebuild_preview(s):
    team = "session-preview-rebuild"
    sessions = {
        "team-lead": "33333333-3333-4333-8333-333333333333",
        "alpha": "44444444-4444-4444-8444-444444444444",
        "beta": "55555555-5555-4555-8555-555555555555",
    }
    # A stopped lead leaves its spawn records as the only claim on the team,
    # and nothing corroborates a sole claimant. A lead resumed without
    # --agent-id is found through the spawn records in the transcript it
    # holds. That process outranks the claim, but those spawn records are
    # still all that ties its transcript to the team, so nothing corroborates
    # it either. A lead resumed with --agent-id states in its own argv that it
    # runs as the team's lead, which corroborates the transcript it holds.
    lead_pid = PID_CEILING + 1000000
    lead_id = agent_id_of("team-lead", team)
    lead_argv = (FAKE_AGENT_BIN, "--resume", sessions["team-lead"])
    leads = {
        "stopped": ((), "", f"sole payload claimant for {team}, uncorroborated"),
        "running plain": (
            ((lead_pid, 1, lead_argv),), "",
            f"pid {lead_pid} runs the conversation that spawned teammates into team {team}, "
            "uncorroborated"),
        "running flag-bound": (
            ((lead_pid, 1, lead_argv + ("--agent-id", lead_id)),),
            sessions["team-lead"],
            f"live pid {lead_pid} launched as {lead_id}, corroborated by "
            f"live process launched as {lead_id}"),
    }
    faults, claims = [], []
    arms = [(state, raw, lead)
            for state, raw in (("absent", None), ("invalid", b'{"name":'))
            for lead in leads]
    for state, raw, lead in arms:
        arm = f"{state}, lead {lead}"
        processes, wanted, evidence = leads[lead]
        with tempfile.TemporaryDirectory() as td:
            root = Path(td)
            eng = Resolver(needs=Needs(maybe=set(NEED)))
            eng._projects_dir, eng._teams_dir = root / "projects", root / "teams"
            project = eng._projects_dir / "fixture"
            project.mkdir(parents=True)
            cfg = eng._roster_path(team)
            if raw is not None:
                cfg.parent.mkdir(parents=True)
                cfg.write_bytes(raw)
            for name, session in sessions.items():
                rows = [{
                    "type": "user", "uuid": f"{name}-root", "parentUuid": None,
                    "sessionId": session, "agentName": name, "teamName": team,
                    "timestamp": "2026-01-01T00:00:00Z",
                    "message": {"role": "user", "content": "fixture"},
                }]
                if name == "team-lead":
                    rows.extend({
                        "type": "user", "uuid": f"spawn-{member}",
                        "parentUuid": "team-lead-root", "sessionId": session,
                        "isSidechain": False,
                        "timestamp": "2026-01-01T00:00:01Z",
                        "message": {"role": "user", "content": []},
                        "toolUseResult": {
                            "status": "teammate_spawned", "name": member,
                            "team_name": team, "agent_id": agent_id_of(member, team),
                        },
                    } for member in ("alpha", "beta"))
                (project / f"{session}.jsonl").write_text(
                    "\n".join(fixture_line(row) for row in rows) + "\n")
            before = _fixture_tree_contents(root)
            plans = []
            real_plan = eng.team_run_plan

            def observed(*args, **kwargs):
                plan = real_plan(*args, **kwargs)
                plans.append(plan)
                return plan

            eng.team_run_plan = observed
            fake = _FakeTmux(session_exists=False, sockets=[],
                             processes=list(processes))
            code, error = None, None
            said = io.StringIO()
            try:
                with fake.installed(eng), capturing("out", into=said), capturing("err", into=said):
                    args = build_parser().parse_args([
                        "--team", team, "--no-lead", "--all", "--dry-run", "--no-attach"])
                    code = run_team(args, [])
            except BaseException as exc:
                error = f"{type(exc).__name__}: {exc}"
            after = _fixture_tree_contents(root)
            preview = plans[-1]["roster_snapshot"] if len(plans) == 2 else {}
            passed = (
                code == 0 and not error and before == after and not fake.panes
                and len(plans) == 2
                and plans[0]["roster_snapshot"].state == state
                and type(preview) is type(plans[0]["roster_snapshot"])
                and preview.state == "valid" and preview.problem is None
                and preview.raw is None and preview.mode is None
                and preview.generation[0] == "preview"
                and all(agent_id_of(member, team) in said.getvalue()
                        for member in ("alpha", "beta")))
            if not passed:
                faults.append(f"{arm}: code={code}, error={error}, "
                              f"plans={len(plans)}, files unchanged={before == after}, "
                              f"output={said.getvalue()}")
                claims.append(f"{arm}: the run did not finish, so its lead claim "
                              "was not checked")
                continue
            told = " ".join(without_wrap_arrows(said.getvalue()).split())
            written = preview.data.get("leadSessionId")
            reported = f"rebuilding from {sessions['team-lead'][:8]} ({evidence})" in told
            warned = "nothing corroborates" in told
            if written != wanted or not reported or warned == bool(wanted):
                claims.append(f"{arm}: leadSessionId={written!r}, wanted {wanted!r}; "
                              f"reported {evidence!r}: {reported}; warned: {warned}; "
                              f"output={said.getvalue()}")
    return [("team-rebuild-preview-reaches-member-launches",
             "a missing or invalid roster can be rebuilt and used by a read-only team run",
             not faults, "\n".join(faults)),
            ("team-rebuild-lead-session-follows-corroboration",
             "a rebuilt roster names the lead session only when evidence corroborates it, "
             "and warns otherwise",
             not claims, "\n".join(claims))]


def _spawning_lead(f, team, lead, members, stamped=False):
    """Write a lead transcript that spawned `members` into team, and theirs.

    `members` maps each name to its session, and each member transcript
    carries its agent and team stamps. The lead carries none unless `stamped`
    asks for them: a lead started without --agent-id writes no stamps.
    """
    stamps = {"agentName": "team-lead", "teamName": team} if stamped else {}
    f.transcript(lead, stamps.get("agentName"), stamps.get("teamName"), tuple({
        "type": "user", "uuid": f"spawn-{name}", "parentUuid": f"{lead}-root",
        "isSidechain": False, "sessionId": lead, **stamps,
        "timestamp": "2026-01-01T00:00:01Z",
        "message": {"role": "user", "content": []},
        "toolUseResult": {"status": "teammate_spawned", "name": name,
                          "team_name": team, "agent_id": agent_id_of(name, team)},
    } for name in members))
    for name, session in members.items():
        f.transcript(session, name, team)


