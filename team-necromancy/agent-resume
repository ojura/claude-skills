     'a selected nonempty inbox stays byte-for-byte unchanged'),
    ('membership-replaces-selected-empty-inbox',
     'a selected zero-byte inbox is initialized exactly once'),
    ('membership-creates-selected-absent-inbox',
     'a selected absent inbox is created with the initial bytes'),
    ('membership-refuses-inbox-generation-drift',
     'a changed selected inbox refuses membership before any write'),
    ('team-run-consumes-selected-plan',
     'the team runner consumes its selected plan and revalidation only'),
    ('attach-flow-consumes-one-decision',
     'the launch runner takes one selected attach decision and the applier only consumes it'),
)
def _check_membership_inbox_and_operation_ownership(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    root = Path(s.tempfile.mkdtemp())
    real_teams_dir, real_projects_dir, real_needs = (
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs)
    try:
        RESOLVER._teams_dir, RESOLVER._projects_dir = root / "teams", root / "projects"
        RESOLVER._needs = Needs(maybe=set(NEED))

        def selected_plan(label, initial):
            team, name = f"session-inbox-{label}", "member"
            agent_id = agent_id_of(name, team)
            team_dir = RESOLVER._teams_dir / team
            inbox_dir = team_dir / "inboxes"
            inbox_dir.mkdir(parents=True)
            RESOLVER._roster_path(team).write_text(json.dumps({
                "name": team, "leadAgentId": agent_id_of("team-lead", team),
                "leadSessionId": "lead", "members": [{
                    "agentId": agent_id_of("team-lead", team), "name": "team-lead",
                }]}))
            inbox = inbox_dir / f"{name}.json"
            if initial is not None:
                inbox.write_bytes(initial)
            project = RESOLVER._projects_dir / label
            project.mkdir(parents=True)
            (project / f"{name}.jsonl").write_text(fixture_line({
                "parentUuid": None, "type": "user", "uuid": f"{label}-root",
                "sessionId": label, "agentName": name, "teamName": team,
                "timestamp": "2026-01-01T00:00:00Z"}) + "\n")
            # The roster lists only the lead, which is the case under test: a
            # member joining a team that does not carry them yet. Planning for
            # an id no config lists says so, correctly, so the warning is
            # caught at the call that makes it rather than reaching an
            # operator who is not there. The apply below is already captured.
            with capturing("err"):
                launch = RESOLVER.launch_plan(agent_id=agent_id, table=())
                plan = RESOLVER.membership_plan(launch, "record", pane="%1", alive=True)
            return plan, inbox

        kept_bytes = b'[{"preserve":true}]'
        keep_plan, keep_inbox = selected_plan("keep", kept_bytes)
        with capturing("out"), capturing("err"):
            apply_membership(keep_plan)
        keep_fact, keep_result = keep_plan["inboxes"][0], keep_inbox.read_bytes()

        empty_plan, empty_inbox = selected_plan("empty", b"")
        with capturing("out"), capturing("err"):
            apply_membership(empty_plan)
        empty_fact, empty_result = empty_plan["inboxes"][0], empty_inbox.read_bytes()

        absent_plan, absent_inbox = selected_plan("absent", None)
        with capturing("out"), capturing("err"):
            apply_membership(absent_plan)
        absent_fact, absent_result = absent_plan["inboxes"][0], absent_inbox.read_bytes()

        drift_plan, drift_inbox = selected_plan("drift", b"")
        drift_inbox.write_bytes(b'[{"late":true}]')
        try:
            with capturing("out"), capturing("err"):
                apply_membership(drift_plan)
        except Refusal as refusal:
            drift_refusal = refusal.said
        else:
            drift_refusal = "membership applied"
        drift_result = drift_inbox.read_bytes()
        drift_members = json.loads(
            RESOLVER._roster_path("session-inbox-drift").read_text())["members"]
    finally:
        RESOLVER._teams_dir, RESOLVER._projects_dir, RESOLVER._needs = (
            real_teams_dir, real_projects_dir, real_needs)
        shutil.rmtree(root, ignore_errors=True)

    check("membership-keeps-nonempty-inbox",
          "a selected nonempty inbox stays byte-for-byte unchanged",
          keep_fact["action"] == "keep" and keep_result == kept_bytes,
          f"action={keep_fact['action']}, bytes={keep_result!r}")
    check("membership-replaces-selected-empty-inbox",
          "a selected zero-byte inbox is initialized exactly once",
          empty_fact["action"] == "replace-empty" and empty_result == b"[]",
          f"action={empty_fact['action']}, bytes={empty_result!r}")
    check("membership-creates-selected-absent-inbox",
          "a selected absent inbox is created with the initial bytes",
          absent_fact["action"] == "create" and absent_result == b"[]",
          f"action={absent_fact['action']}, bytes={absent_result!r}")
    check("membership-refuses-inbox-generation-drift",
          "a changed selected inbox refuses membership before any write",
          "inbox member" in drift_refusal and drift_result == b'[{"late":true}]'
          and not any(member.get("name") == "member" for member in drift_members),
          f"refusal={drift_refusal!r}, members={drift_members}")

    team_questions = sorted(
        question for question, callers in s.resolver_calls.items()
        if "run_team" in callers)
    team_attributes = sorted(
        attribute for attribute, callers in s.resolver_attributes.items()
        if "run_team" in callers)
    check("team-run-consumes-selected-plan",
          "the team runner consumes its selected plan and revalidation only",
          team_questions == ["revalidate_team_run", "team_run_plan"] and not team_attributes,
          f"Resolver questions={team_questions}, attributes={team_attributes}")

    attach_questions = sorted(
        question for question, callers in s.resolver_calls.items()
        if "run_agents" in callers)
    attach_attributes = sorted(
        attribute for attribute, callers in s.resolver_attributes.items()
        if "run_agents" in callers)
    applier_questions = sorted(
        question for question, callers in s.resolver_calls.items()
        if "maybe_attach" in callers)
    applier_attributes = sorted(
        attribute for attribute, callers in s.resolver_attributes.items()
        if "maybe_attach" in callers)
    runner = s.funcs["run_agents"]
    decision_calls = [node for node in s.ast.walk(runner)
                      if isinstance(node, s.ast.Call)
                      and isinstance(node.func, s.ast.Attribute)
                      and getattr(node.func.value, "id", None) == "RESOLVER"
                      and node.func.attr == "attach_decision"]
    selected_decision = immutable({
        "socket": "fixture-socket", "alive": True, "action": "skip",
        "reason": "disabled", "command": (),
    })
    decisions, applied = [], []
    real_resolver = globals()["RESOLVER"]
    real_run_one, real_maybe_attach = globals()["run_one"], globals()["maybe_attach"]
    try:
        globals()["RESOLVER"] = types.SimpleNamespace(
            attach_decision=lambda *_args, **_kwargs: (
                decisions.append(selected_decision) or selected_decision))
        globals()["run_one"] = (
            lambda *_args, **_kwargs: Outcome("noop", "fixture-socket", False, None))
        globals()["maybe_attach"] = lambda decision: applied.append(decision)
        args = types.SimpleNamespace(dry_run=False, no_attach=False, attach=False)
        with capturing("out"), capturing("err"):
            attach_result = run_agents(
                args, (), (), [("member", types.SimpleNamespace(
                    agent_id="member@fixture"))], socket="fixture-socket")
    except BaseException as exc:
        attach_result, attach_fault = None, f"raised {type(exc).__name__}: {exc}"
    else:
        attach_fault = ""
    finally:
        globals()["RESOLVER"] = real_resolver
        globals()["run_one"], globals()["maybe_attach"] = real_run_one, real_maybe_attach
    check("attach-flow-consumes-one-decision",
          "the launch runner takes one selected attach decision and the applier only consumes it",
          attach_questions == ["attach_decision"] and not attach_attributes
          and not applier_questions and not applier_attributes
          and len(decision_calls) == len(decisions) == len(applied) == 1
          and applied[0] is selected_decision and attach_result == 0,
          f"runner={attach_questions}/{attach_attributes}, "
          f"applier={applier_questions}/{applier_attributes}, "
          f"calls={len(decision_calls)}/{len(decisions)}/{len(applied)}, "
          f"same object={bool(applied) and applied[0] is selected_decision}, {attach_fault}")
    return checked


@unit(
    ('member-redirect-retains-selected-semantic-branch',
     'a typed member redirect retains its selected route and exact public callers'),
    ('member-redirect-explicit-revalidates-destination-parent',
     'an explicit redirect refuses a changed destination roster or a replaced lead '
     'transcript, and accepts a lead transcript that only grew'),
    ('member-redirect-auto-consumes-one-selected-route',
     'automatic redirect applies the one route the Resolver selected'),
    ('member-redirect-auto-does-not-reselect-after-rebind',
     'automatic redirect never asks the Resolver for a replacement route'),
    ('member-redirect-auto-keeps-unknown-lead-team',
     'a known live lead without a known team leaves automatic resume on its source team'),
    ('member-redirect-live-requires-known-team',
     'an explicit live redirect requires a known team even when the lead process is known'),
    ('member-redirect-revalidates-retained-generations',
     'a member redirect revalidation compares the route facts it retained'),
    ('member-redirect-verifies-durable-rebind-result',
     'member completion rejects a durable action other than the selected action'),
    ('member-migration-completion-reuses-route-selection',
     'member completion returns the selected identity and launch placement'),
    ('member-restamp-retains-selected-bytes-and-launch',
     'an applied selected member restamp retains bytes and launch facts'),
    ('member-migration-completion-revalidates-pre-and-post-write',
     'member migration validates before and after selected holder removal'),
    ('member-redirect-reuses-and-revalidates-launch-placement',
     'member redirect retains and revalidates its selected launch placement'),
)
def _check_member_redirect_operation(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    def fixture(root, label, automatic=False, force=False, archive_mail=False,
                lead_holds=True, plain_lead=False):
        root = root / label
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir, eng._teams_dir = root / "projects", root / "teams"
        source, destination = (f"session-member-{label}-source",
                               f"session-member-{label}-destination")
        mover = agent_id_of("mover", source)
        source_lead = agent_id_of("team-lead", source)
        destination_lead = agent_id_of("team-lead", destination)

        def transcript(project, session, name, team, window=False):
            path = eng._projects_dir / project
            path.mkdir(parents=True, exist_ok=True)
            (path / f"{session}.jsonl").write_text(fixture_line({
                "parentUuid": None, "type": "user", "uuid": f"{session}-root",
                "sessionId": session, "agentName": name, "teamName": team,
                "timestamp": "2026-01-01T00:00:00Z"}) + "\n" + (
                    fixture_line({"type": "last-prompt",
                                  "leafUuid": f"{session}-root",
                                  "sessionId": session}) + "\n" if window else ""))

        def roster(team, lead_session, members):
            directory = eng._teams_dir / team
            directory.joinpath("inboxes").mkdir(parents=True)
            cfg = directory / "config.json"
            cfg.write_text(json.dumps({
                "name": team, "leadAgentId": agent_id_of("team-lead", team),
                "leadSessionId": lead_session, "members": members}))
            return cfg

        mover_session = f"{label}-mover"
        source_lead_session = f"{label}-source-lead"
        destination_lead_session = f"{label}-destination-lead"
        transcript("source", mover_session, "mover", source, window=force)
        transcript("source", source_lead_session, "team-lead",
                   None if plain_lead else source)
        destination_parent = eng._projects_dir / "destination" / f"{destination_lead_session}.jsonl"
        transcript("destination", destination_lead_session, "team-lead", destination)
        source_cfg = roster(source, source_lead_session, [
            {"agentId": source_lead, "name": "team-lead"},
            {"agentId": mover, "name": "mover", "tmuxPaneId": "%1",
             "backendType": "tmux", "isActive": True},
        ])
        destination_cfg = roster(destination, destination_lead_session, [
            {"agentId": destination_lead, "name": "team-lead"},
        ])
        versions = {}

        def server(socket):
            return immutable({
                "socket": socket, "path": Path("/tmp") / socket,
                "socket_generation": versions.get(socket, ("fixture", socket)),
                "alive": False, "server": None, "session_live": False,
                "panes": (), "base_url": "", "clients": 0, "state": "no server",
            })

        eng._pid_alive = lambda _pid, procstart=None: True
        eng._proc_start = lambda _pid: 1
        eng._proc_stat = lambda _pid: ("S", 1, "fixture-start")
        eng._own_lineage = lambda _table: set()
        eng._seat_index = lambda _table: {}
        eng._session_registry = lambda: []
        eng._tmux_server_fact = server
        lead_argv = (FAKE_AGENT_BIN,)
        if lead_holds:
            lead_argv += ("--resume", source_lead_session)
        if not plain_lead:
            lead_argv += ("--agent-id", source_lead)
        table = ((PID_CEILING + 424242, 1, lead_argv),)
        eng._process_table = lambda refresh=False: table
        launch = eng.launch_plan(
            agent_id=mover, table=table, terminal=TerminalContext())
        request = MemberRedirectRequest(
            kind="automatic" if automatic else "explicit",
            destination=None if automatic else destination,
            force=force, archive_mail=archive_mail)
        if automatic and not plain_lead:
            lead = immutable({
                **launch["process"]["lead"], "runs_as": destination,
                "runs_as_exact": True, "how": "fixture live lead",
            })
            launch = types.MappingProxyType({
                **launch,
                "process": types.MappingProxyType({**launch["process"], "lead": lead}),
            })
        plan = eng.member_redirect_plan(launch, request)
        return types.SimpleNamespace(
            eng=eng, plan=plan, launch=launch, request=request,
            source=source, destination=destination, source_cfg=source_cfg,
            destination_cfg=destination_cfg, destination_parent=destination_parent,
            versions=versions, root=root)

    try:
        with s.tempfile.TemporaryDirectory() as td:
            root = Path(td)
            explicit = fixture(root, "explicit")
            plan = explicit.plan
            destination_snapshot = next(
                record for record in plan["launch"]["roster"]["census"]
                if record.team == explicit.destination)
            expected_callers = {
                "member_redirect_plan": ("auto_redirect", "run_one"),
                "revalidate_member_redirect": ("apply_member_migration",),
                "complete_member_migration": ("apply_member_migration",),
            }
            observed_callers = {
                question: tuple(sorted(s.resolver_calls.get(question, ())))
                for question in expected_callers}
            registered_callers = {
                question: PUBLIC_RESOLVER_QUESTIONS.get(question)
                for question in expected_callers}
            semantic_branch = (
                plan["request"] is explicit.request
                and plan["launch"] is explicit.launch
                and plan["kind"] == "explicit"
                and plan["action"] == "redirect"
                and not plan["objections"]
                and plan["source"] == explicit.source
                and plan["destination"] == explicit.destination
                and plan["destination_roster"] is destination_snapshot
                and plan["parent_fact"] is explicit.eng._transcript_fact(plan["parent"])
                and observed_callers == expected_callers
                and registered_callers == expected_callers)

            roster_race = fixture(root, "destination-roster")
            roster_race.destination_cfg.write_bytes(
                roster_race.destination_cfg.read_bytes() + b"\n")
            roster_review = roster_race.eng.revalidate_member_redirect(roster_race.plan)
            # A working lead appends to its transcript all the time, which
            # changes nothing the plan selected; a replaced transcript does.
            # A label short enough that the teams it names give socket names
            # within SOCKET_NAME_ROOM, as every fixture team has to.
            parent_append = fixture(root, "parent-append")
            parent_append.destination_parent.write_bytes(
                parent_append.destination_parent.read_bytes() + b"\n")
            append_review = parent_append.eng.revalidate_member_redirect(parent_append.plan)
            parent_race = fixture(root, "destination-parent")
            replacement = parent_race.destination_parent.with_suffix(".replacement")
            replacement.write_bytes(parent_race.destination_parent.read_bytes())
            os.replace(replacement, parent_race.destination_parent)
            parent_review = parent_race.eng.revalidate_member_redirect(parent_race.plan)
            explicit_revalidation = (
                not roster_review["matches"]
                and f"destination roster {roster_race.destination}" in roster_review["changed"]
                and append_review["matches"]
                and not parent_review["matches"]
                and f"lead transcript {parent_race.plan['parent']}" in parent_review["changed"])

            automatic = fixture(root, "automatic", automatic=True)
            automatic_selected = automatic.plan
            planner_calls, applied_routes = [], []
            real_resolver = globals()["RESOLVER"]
            real_confirm, real_apply = globals()["confirm_redirect"], globals()["apply_member_migration"]
            try:
                globals()["RESOLVER"] = types.SimpleNamespace(
                    member_redirect_plan=lambda launch, request: (
                        planner_calls.append((launch, request)) or automatic_selected))
                globals()["confirm_redirect"] = lambda _plan, _prefix="": True
                globals()["apply_member_migration"] = (
                    lambda route, _args, prefix="", confirmation=True: (
                        applied_routes.append((route, confirmation)) or "selected-launch"))
                args = types.SimpleNamespace(force=False, with_mail=False, keep_team=False)
                with capturing("out"), capturing("err"):
                    automatic_result = auto_redirect(automatic.launch, args)
            finally:
                globals()["RESOLVER"] = real_resolver
                globals()["confirm_redirect"], globals()["apply_member_migration"] = (
                    real_confirm, real_apply)
            automatic_consumes = (
                automatic.plan["request"].kind == "automatic"
                and automatic.plan["destination"] == automatic.destination
                and automatic_result == "selected-launch"
                and applied_routes == [(automatic_selected, True)])
            automatic_no_reselection = (
                len(planner_calls) == 1
                and planner_calls[0][0] is automatic.launch
                and planner_calls[0][1].kind == "automatic")

            unknown = fixture(root, "unknown-team", automatic=True, plain_lead=True)
            unknown_lead = unknown.launch["process"]["lead"]
            known_process = (unknown_lead["pid"] == PID_CEILING + 424242
                             and unknown_lead["alive"] and unknown_lead["exact"]
                             and unknown_lead["runs_as"] is None)
            unknown_result, unknown_error = None, None
            before = {cfg: cfg.read_bytes()
                      for cfg in (unknown.source_cfg, unknown.destination_cfg)}
            real_resolver = globals()["RESOLVER"]
            try:
                globals()["RESOLVER"] = unknown.eng
                with capturing("out") as unknown_said, capturing("err"):
                    unknown_result = auto_redirect(unknown.launch, _Run())
            except BaseException as exc:
                unknown_error = f"{type(exc).__name__}: {exc}"
            finally:
                globals()["RESOLVER"] = real_resolver
            unknown_stays = (
                known_process and not unknown_error
                and unknown.plan["action"] == "stay"
                and unknown.plan["destination"] == unknown.source
                and unknown.plan["proposed_destination"] is None
                and unknown.plan["redirected_launch"] is unknown.launch
                and unknown_result is unknown.launch
                and not unknown_said.getvalue()
                and all(cfg.read_bytes() == raw for cfg, raw in before.items()))
            live_unknown = unknown.eng.member_redirect_plan(
                unknown.launch, MemberRedirectRequest(kind="live"))
            explicit_unknown = unknown.eng.member_redirect_plan(
                unknown.launch, MemberRedirectRequest(
                    kind="explicit", destination=unknown.destination))
            live_requires_team = (
                known_process and live_unknown["action"] == "blocked"
                and any("cannot tell which team pid" in reason
                        for reason in live_unknown["objections"])
                and explicit_unknown["action"] == "redirect"
                and explicit_unknown["destination"] == unknown.destination
                and not explicit_unknown["objections"])

            retained = fixture(root, "retained")
            retained_review = retained.eng.revalidate_member_redirect(retained.plan)
            retained_generations = (
                retained_review["matches"]
                and retained_review["launch"] is retained.plan["redirected_launch"]
                and retained.plan["parent_identity"]
                == retained.eng._file_identity(retained.plan["parent_fact"]["path"])
                and retained.plan["lead_generation"]
                == retained.eng._runtime_generation(
                    retained.plan["launch"]["process"]["snapshot"],
                    agent_ids=(agent_id_of("team-lead", retained.destination),),
                    sessions=(retained.plan["parent"],), teams=(retained.destination,)))

            durable = fixture(root, "durable")
            synthetic_rebind = immutable({
                "action": "reap", "source": durable.source,
                "reap": immutable({"path": durable.root / "already-removed"}),
            })
            durable_plan = immutable({**durable.plan, "rebind": synthetic_rebind})
            durable_result = durable.eng.complete_member_migration(Applied(
                operation="member-redirect", plan=durable_plan, confirmation=True,
                durable_action="restamp"))
            durable_checked = (
                not durable_result["matches"]
                and "durable member redirect action" in durable_result["changed"])

            restamped = fixture(root, "restamp", force=True, archive_mail=True,
                                lead_holds=False)
            (restamped.root / "teams" / restamped.source / "inboxes" / "mover.json").write_text('[{"text":"mail"}]')
            restamp_plan = restamped.eng.member_redirect_plan(
                restamped.launch, restamped.request)
            restamp = restamp_plan["rebind"]
            restamp_ok = bool(restamp and restamp["action"] == "restamp"
                               and restamp["restamp"]["proved"])
            real_resolver = globals()["RESOLVER"]
            try:
                globals()["RESOLVER"] = restamped.eng
                # What the restamp prints is the applier's report, not this
                # unit's, so it is kept out of the suite's output.
                with capturing("out"), capturing("err"):
                    launch_after_restamp = apply_member_migration(
                        restamp_plan, types.SimpleNamespace(dry_run=False),
                        confirmation=True)
            finally:
                globals()["RESOLVER"] = real_resolver
            expected_bytes = _jsonl_text(
                restamp["restamp"]["lines"], restamp["restamp"]["newline"]).encode()
            restamp_path = restamp_plan["redirected_launch"]["transcript"]["path"]
            restamp_ok = restamp_ok and restamp_path.read_bytes() == expected_bytes \
                and launch_after_restamp["identity"] is restamp_plan["completion_intent"]["identity"] \
                and launch_after_restamp.get("destination") is restamp_plan["completion_intent"]["destination"] \
                and launch_after_restamp["roster"]["record"] is restamp_plan["redirected_launch"]["roster"]["record"]

            completed = fixture(root, "completion")
            completion_result = completed.eng.complete_member_migration(Applied(
                operation="member-redirect", plan=completed.plan, confirmation=True))
            completion_reused = (
                completion_result["matches"]
                and completion_result["launch"]["identity"]
                is completed.plan["completion_intent"]["identity"]
                and completion_result["launch"]["roster"]["record"]
                is completed.plan["redirected_launch"]["roster"]["record"]
                and completion_result["launch"].get("destination")
                is completed.plan["completion_intent"]["destination"]
                and completion_result["launch"].get("launch_action")
                is completed.plan["completion_intent"]["launch_action"])

            applier = s.funcs["apply_member_migration"]
            revalidations = [node for node in s.ast.walk(applier)
                             if isinstance(node, s.ast.Call)
                             and isinstance(node.func, s.ast.Attribute)
                             and getattr(node.func.value, "id", None) == "RESOLVER"
                             and node.func.attr == "revalidate_member_redirect"]
            before_after = (
                len(revalidations) == 2
                and any(not any(keyword.arg == "after_clear" for keyword in node.keywords)
                        for node in revalidations)
                and any(any(keyword.arg == "after_clear"
                            and isinstance(keyword.value, s.ast.Constant)
                            and keyword.value.value is True
                            for keyword in node.keywords)
                        for node in revalidations)
                and sum(1 for node in s.ast.walk(applier)
                        if isinstance(node, s.ast.Call)
                        and isinstance(node.func, s.ast.Attribute)
                        and getattr(node.func.value, "id", None) == "RESOLVER"
                        and node.func.attr == "complete_member_migration") == 1)

            placement = fixture(root, "placement")
            selected_action = placement.plan["redirected_launch"]["launch_action"]
            initial_placement = placement.eng.revalidate_member_redirect(placement.plan)
            socket = placement.plan["redirected_launch"]["destination"].socket
            placement.versions[socket] = ("changed", socket)
            placement_review = placement.eng.revalidate_member_redirect(placement.plan)
            placement_checked = (
                placement.plan["placement_generation"] == selected_action["generation"]
                and initial_placement["matches"]
                and not placement_review["matches"]
                and "tmux destination generation" in placement_review["changed"])
            details = {
                "semantic": f"callers={observed_callers}, registered={registered_callers}",
                "explicit": f"roster={roster_review['changed']}, parent={parent_review['changed']}, "
                        f"append={append_review['changed']}",
                "automatic": f"planned={len(planner_calls)}, applied={len(applied_routes)}",
                "unknown": f"known process={known_process}, action={unknown.plan['action']}, "
                           f"destination={unknown.plan['destination']!r}, error={unknown_error}",
                "live": f"live={live_unknown['action']}, explicit={explicit_unknown['action']}",
                "retained": f"review={retained_review['changed']}",
                "durable": f"completion={durable_result['changed']}",
                "completion": f"completion={completion_result['changed']}",
                "placement": f"placement={placement_review['changed']}",
                "restamp": f"action={getattr(restamp, 'get', lambda _k: None)('action')}",
            }
    except BaseException as exc:
        semantic_branch = explicit_revalidation = automatic_consumes = False
        automatic_no_reselection = retained_generations = durable_checked = False
        unknown_stays = live_requires_team = False
        completion_reused = before_after = placement_checked = restamp_ok = False
        details = {"error": f"raised {type(exc).__name__}: {exc}"}

    check("member-redirect-retains-selected-semantic-branch",
          "a typed member redirect retains its selected route and exact public callers",
          semantic_branch, details.get("semantic", details.get("error", "")))
    check("member-redirect-explicit-revalidates-destination-parent",
          "an explicit redirect refuses a changed destination roster or a replaced lead "
          "transcript, and accepts a lead transcript that only grew",
          explicit_revalidation, details.get("explicit", details.get("error", "")))
    check("member-redirect-auto-consumes-one-selected-route",
          "automatic redirect applies the one route the Resolver selected",
          automatic_consumes, details.get("automatic", details.get("error", "")))
    check("member-redirect-auto-does-not-reselect-after-rebind",
          "automatic redirect never asks the Resolver for a replacement route",
          automatic_no_reselection, details.get("automatic", details.get("error", "")))
    check("member-redirect-auto-keeps-unknown-lead-team",
          "a known live lead without a known team leaves automatic resume on its source team",
          unknown_stays, details.get("unknown", details.get("error", "")))
    check("member-redirect-live-requires-known-team",
          "an explicit live redirect requires a known team even when the lead process is known",
          live_requires_team, details.get("live", details.get("error", "")))
    check("member-redirect-revalidates-retained-generations",
          "a member redirect revalidation compares the route facts it retained",
          retained_generations, details.get("retained", details.get("error", "")))
    check("member-redirect-verifies-durable-rebind-result",
          "member completion rejects a durable action other than the selected action",
          durable_checked, details.get("durable", details.get("error", "")))
    check("member-migration-completion-reuses-route-selection",
          "member completion returns the selected identity and launch placement",
          completion_reused, details.get("completion", details.get("error", "")))
    check("member-restamp-retains-selected-bytes-and-launch",
          "an applied selected member restamp retains bytes and launch facts",
          restamp_ok, details.get("restamp", details.get("error", "")))
    check("member-migration-completion-revalidates-pre-and-post-write",
          "member migration validates before and after selected holder removal",
          before_after, details.get("error", ""))
    check("member-redirect-reuses-and-revalidates-launch-placement",
          "member redirect retains and revalidates its selected launch placement",
          placement_checked, details.get("placement", details.get("error", "")))
    return checked


@unit(
    ('lead-migration-plan-reuses-selected-route-facts',
     'lead migration retains one selected route and only its approved callers'),
    ('lead-migration-revalidates-before-stop-and-after-clear',
     'lead migration checks retained facts before stopping and after clearing holders'),
    ('lead-migration-unstamped-refuses-before-any-stop',
