def immutable(value):
    """Recursively normalize operation answers into immutable containers.

    Existing mapping proxies are canonical records already built by this module;
    preserving them also preserves object identity across indexes and reports.
    Fresh mappings, sequences, and sets are copied before they become immutable.
    """
    if isinstance(value, types.MappingProxyType):
        return value
    if isinstance(value, dict):
        return types.MappingProxyType({key: immutable(item)
                                       for key, item in value.items()})
    if isinstance(value, (list, tuple)):
        return tuple(immutable(item) for item in value)
    if isinstance(value, (set, frozenset)):
        return frozenset(immutable(item) for item in value)
    return value


def json_value(value, strict=False):
    """Copy JSON containers, optionally rejecting unsupported keys, leaves and cycles.

    Strict copies establish ownership even when an input proxy has mutable backing
    storage. The active recursion set permits shared children but rejects cycles.
    Non-finite floats retain the JSON parser and encoder's existing behavior.
    """
    active = set()

    def visit(item):
        if strict and dataclasses.is_dataclass(item):
            raise TypeError("config values must not be dataclasses")
        mapping = isinstance(item, Mapping)
        sequence = isinstance(item, (list, tuple, set, frozenset))
        if strict and sequence and type(item) not in (list, tuple):
            raise TypeError("config arrays must be lists or tuples")
        if mapping or sequence:
            if id(item) in active:
                raise ValueError("config values must not contain cycles")
            active.add(id(item))
            try:
                if mapping:
                    if strict and any(type(key) is not str for key in item):
                        raise TypeError("config object keys must be strings")
                    return {key: visit(child) for key, child in item.items()}
                return [visit(child) for child in item]
            finally:
                active.remove(id(item))
        if strict and type(item) not in (str, bool, int, float, type(None)):
            raise TypeError(f"unsupported config value {type(item).__name__}")
        return item

    return visit(value)


@dataclasses.dataclass(frozen=True)
class FileObservation:
    """Retain one descriptor's bytes and permissions with its selected file path."""

    path: Path
    generation: tuple
    mode: object

    def __post_init__(self):
        if type(self.path) is not type(Path()):
            raise TypeError("file observation path must be an immutable Path")
        generation = self.generation
        if type(generation) is not tuple:
            raise TypeError("file generation must be a tuple")
        if len(generation) == 1 and type(generation[0]) is str and generation[0] == "absent":
            if self.mode is not None:
                raise ValueError("absent files have no observed mode")
            return
        if type(self.mode) is not int or not 0 <= self.mode <= 0o777:
            raise ValueError("observed mode must be integer permission bits")
        if self.physical:
            return
        if (len(generation) == 4 and type(generation[0]) is str
                and generation[0] == "changed-during-read"
                and all(type(sig) is tuple and len(sig) == 4
                        and all(type(value) is int for value in sig)
                        for sig in generation[1:3])
                and type(generation[3]) is bytes):
            return
        raise ValueError("unsupported file generation")

    @property
    def physical(self):
        generation = self.generation
        return (len(generation) == 5
                and all(type(value) is int for value in generation[:4])
                and type(generation[4]) is bytes)

    @property
    def raw(self):
        return self.generation[4] if self.physical else None

    @property
    def mtime(self):
        # Nanoseconds stay integers so a value just below a millisecond boundary
        # cannot round up through floating-point seconds.
        return self.generation[3] // 1_000_000 if self.physical else 0


