                                                and meta.stat().st_mode & 0o777 == plan["receipt"]["side_meta_mode"])
                            else:
                                correct_meta = json.loads(meta.read_text())["isFork"] is False and meta.stat().st_mode & 0o777 == 0o600
                            if not (correct_meta and caught is None and not source.exists()):
