@unit(('no-launch-onto-live-conversation', "a lead is not exec'd, nor a member spawned, onto a live conversation"))
def _check_no_launch_onto_live_conversation(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    asks_own = []
    # And the guarantee itself, not merely its address: the same live
    # conversation stops both acts, --force releases both, and only a
    # member's rebind is exempt (its own kill path owns that).
    real_runtime, real_agent_runtime = RESOLVER.runtime, RESOLVER.agent_runtime

    def role_ctx(session, role, agent_id):
        name, team = name_and_team(agent_id)
        return {"target": fixture_target(
            session, identity={"agentId": agent_id, "agentName": name,
                               "teamName": team, "role": role})}

    live_member = role_ctx("live-uuid", "member", "a@t")
    live_lead = role_ctx("live-uuid", "lead", "team-lead@t")
    member = role_ctx("u", "member", "a@t")
    lead = role_ctx("u", "lead", "team-lead@t")

    class _NoForce:
        force = False

    class _Forced:
        force = True

    try:
        RESOLVER.runtime = lambda table=None: {"best_by_session": {
            "live-uuid": {"pid": 4242, "updated": "x", "alive": True,
                          "session": "live-uuid"}}}
        RESOLVER.agent_runtime = lambda aid, tbl=None: {
            "others": [], "processes": []}

        def why_of(ctx_, args_, **kw):
            answer = already_running(ctx_, args_, **kw)
            return answer[0] if answer else ""

        stops = {
            "a live conversation stops an exec":
                bool(already_running(live_lead, _NoForce)),
            "a live conversation stops a spawn":
                bool(already_running(live_member, _NoForce)),
            "and both name the session and the pid":
                all("live-uuid" in why_of(ctx, _NoForce)
                    and "4242" in why_of(ctx, _NoForce)
                    for ctx in (live_lead, live_member)),
            "--force releases the exec":
                already_running(live_lead, _Forced) is None,
            "--force releases the spawn":
                already_running(live_member, _Forced) is None,
            "a member's rebind is exempt":
                already_running({**live_member, "to_team": "t"}, _NoForce) is None,
            # A lead move is exempted by its kill gate having ended the holder,
            # not by this step forgiving one: what reaches here with something
            # still live is a move whose kill did not work, and it stops.
            "a lead's rebind is not exempt here":
                bool(already_running({**live_lead, "to_team": "t"}, _NoForce)),
            # The member-only extension: the seat questions live in the same
            # step, and the pane one is said in the report's grammar.
            "a member already in the pane stops the spawn":
                already_running(member, _NoForce, here=[77], pane="%3")
                == ("a@t is already running in pane %3 (pid 77)", True),
            "an explicit rebind may take that pane":
                already_running({**member, "to_team": "t"}, _NoForce,
                                here=[77], pane="%3") is None,
            "a redirect chosen by the tool may not":
                already_running({**member, "to_team": "t", "auto_redirect": True},
                                _NoForce, here=[77], pane="%3") is not None,
            # A lead has no seat, so the pane never enters its answer: with
            # the owner live it stops for that reason and no other.
            "a lead asks no seat question":
                "pane" not in why_of(live_lead, _NoForce, here=[77], pane="%3"),
        }
        empty_agent_runtime = RESOLVER.agent_runtime
        RESOLVER.agent_runtime = lambda aid, tbl=None: {
            "others": [(99, None)], "processes": [(99, None)]}
        RESOLVER.runtime = lambda table=None: {"best_by_session": {}}
        try:
            # With no owner, the elsewhere question is the one left to answer.
            stops["the same id running elsewhere stops the spawn"] = (
                "outside pane %3" in why_of(member, _NoForce, pane="%3"))
            stops["and a lead never asks it"] = already_running(
                lead, _NoForce, pane="%3") is None
            # Guarded: a missing answer must fail this line, not crash it.
            stops["its own pane is not elsewhere"] = (already_running(
                member, _NoForce, here=[99], pane="%3") or (None, None))[1] is True
        finally:
            RESOLVER.agent_runtime = empty_agent_runtime
        RESOLVER.runtime = lambda table=None: {"best_by_session": {
            "live-uuid": {"pid": 4242, "updated": "x", "alive": False,
                          "session": "live-uuid"}}}
        stops["a dead owner stops nothing"] = all(
            already_running(ctx, _NoForce) is None for ctx in (live_lead, live_member))
        RESOLVER.runtime = lambda table=None: {"best_by_session": {}}
        stops["and neither does no owner at all"] = all(
            already_running(ctx, _NoForce) is None for ctx in (live_lead, live_member))
    finally:
        RESOLVER.runtime, RESOLVER.agent_runtime = real_runtime, real_agent_runtime
    asks_own += sorted(k for k, good in stops.items() if not good)
    check("no-launch-onto-live-conversation", "a lead is not exec'd, nor a member spawned, onto a live conversation",
          not asks_own, ", ".join(asks_own))
    return checked


