@unit(('tree-reached-via-engine', 'the tree is reached only through the engine'))
def _check_tree_reached_via_engine(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ambient = s.ambient
    ast = s.ast
    engine_lines = s.engine_lines
    selftest_lines = s.selftest_lines
    tree = s.tree

    def outside(node):
        """A read of this node, from neither the engine nor the suite."""
        return (isinstance(node.ctx, ast.Load)  # a Store is the declaration; only a use is a reach
                and node.lineno not in engine_lines
                and node.lineno not in selftest_lines)

    trespass = sorted({
        f"{node.id} at line {node.lineno}"
        for node in ast.walk(tree)
        if isinstance(node, ast.Name) and node.id in ambient and outside(node)
    } | {
        # Whatever Cache registered, however the caller spells the object it
        # hangs off: RESOLVER._procs, an engine bound to another name, one
        # returned by a call. no-module-reaches-engine reads the source text for
        # the literal RESOLVER._x, so an alias walks past it; this does not.
        f"{node.attr} at line {node.lineno}"
        for node in ast.walk(tree)
        if isinstance(node, ast.Attribute) and node.attr in Cache.names and outside(node)})
    check("tree-reached-via-engine", "the tree is reached only through the engine", not trespass, "; ".join(trespass))
    return checked


