            def roster(team, session):
                directory = eng._teams_dir / team
                directory.joinpath("inboxes").mkdir(parents=True)
                cfg = directory / "config.json"
                cfg.write_text(json.dumps({
                    "name": team, "leadAgentId": agent_id_of("team-lead", team),
                    "leadSessionId": session,
                    "members": [{"agentId": agent_id_of("team-lead", team),
                                 "name": "team-lead"}],
                }))
