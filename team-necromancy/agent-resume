def forge_team(ctx, dry):
    """Recreate a team dir the graceful lead exit rm -rf'd, from merged fields.

    The roster is scaffolding; the transcript is the identity. Everything the
    config needs is already in the merge, so a missing team is not fatal."""
    merged = ctx["merged"]
    team = merged.pick("teamName")[0]
    name = merged.pick("agentName")[0]
    if not team or not name:
        return
    cfg = RESOLVER.roster_path(team)
    if cfg.exists():
        return
    now = int(time.time() * 1000)
    lead_sid = merged.pick("parentSessionId")[0] or ""
    if name == "team-lead":
        # Forging for the lead itself. Recording the resumed transcript as
        # leadSessionId is what lets rung 1 find this lead again next time.
        #
        # The members come back too, from the lead's own spawn payloads. Writing
        # a lead-only roster would unregister every teammate it ever created:
        # their transcripts survive, but nothing lists them, so reviving one by
        # name reports that no team config lists a member sitting right there.
        # The payloads carry the colour, type and model the roster held, which is
        # the same evidence RESOLVER.led_teams() uses to identify this lead at all.
        members = [{
            "agentId": f"team-lead@{team}",
            "name": "team-lead",
            "agentType": "team-lead",
            "joinedAt": now,
            "tmuxPaneId": "leader",
            **({"cwd": cwd} if (cwd := agent_cwd(ctx)) else {}),
            "subscriptions": [],
            "backendType": "in-process",
        }]
        for payload in RESOLVER.members_spawned_into(ctx["session_uuid"], team):
            entry = {
                "agentId": payload.get("agent_id") or f"{payload['name']}@{team}",
                "name": payload["name"],
                "joinedAt": now,
                "tmuxPaneId": payload.get("tmux_pane_id") or "",
                "subscriptions": [],
                "agentType": payload.get("agent_type") or DEFAULT_AGENT_TYPE,
                "planModeRequired": bool(payload.get("plan_mode_required")),
                "backendType": "tmux",
                "isActive": False,
            }
            for key in ("color", "model"):
                if payload.get(key):
                    entry[key] = payload[key]
            members.append(entry)
        config = {
            "name": team,
            "createdAt": now,
            "leadAgentId": f"team-lead@{team}",
            "leadSessionId": ctx["session_uuid"],
            "members": members,
        }
        rebuilt = ", ".join(m["name"] for m in members[1:]) or "no members recovered"
        if dry:
            step(True, f"would forge {cfg} (lead + {rebuilt}) and seed every inbox", "")
            return
        (cfg.parent / "inboxes").mkdir(parents=True, exist_ok=True)
        edit_team_config(cfg, lambda _: config, f"forged for the lead being resumed ({rebuilt})",
                         create=config)
        for member in members:
            ensure_inbox(team, member["name"], dry)
        ctx["lead_agent_id"] = f"team-lead@{team}"
        return
    member = {
        "agentId": merged.pick("agentId")[0] or f"{name}@{team}",
        "name": name,
        "joinedAt": now,
        "tmuxPaneId": "",
        "subscriptions": [],
        "agentType": merged.pick("agentType")[0] or DEFAULT_AGENT_TYPE,
        "planModeRequired": merged.pick("permissionMode")[0] == "plan",
        **({"cwd": cwd} if (cwd := agent_cwd(ctx)) else {}),
        "backendType": "tmux",
        "isActive": False,
    }
    color = merged.pick("color")[0]
    if color:
        member["color"] = color
    model = merged.pick("model", prefer_specific=True)[0]
    if model:
        member["model"] = model
    config = {
        "name": team,
        "createdAt": now,
        "leadAgentId": f"team-lead@{team}",
        "leadSessionId": lead_sid,
        "members": [
            {
                "agentId": f"team-lead@{team}",
                "name": "team-lead",
                "agentType": "team-lead",
                "joinedAt": now,
                "tmuxPaneId": "leader",
                **({"cwd": cwd} if (cwd := agent_cwd(ctx)) else {}),
                "subscriptions": [],
                "backendType": "in-process",
            },
            member,
        ],
    }
    if dry:
        step(True, f"would forge {cfg} (lead + {name}) and seed both inboxes", "")
        return
    (cfg.parent / "inboxes").mkdir(parents=True, exist_ok=True)
    edit_team_config(cfg, lambda _: config, "forged (a graceful lead exit had deleted)", create=config)
    for inbox in ("team-lead", name):
        ensure_inbox(team, inbox, dry)
    # re-resolve so the roster patch after launch has an entry to patch
    matches = [e for e in RESOLVER.scan_teams() if e["member"].get("agentId") == member["agentId"]]
    if matches:
        ctx["team_entry"] = matches[0]
        ctx["lead_agent_id"] = matches[0].get("leadAgentId")


@contextlib.contextmanager
def team_lock(cfg, timeout=5.0):
    """Hold the roster's config.json.lock, the same lockfile the harness's own
    locked write helper uses (architecture.md). Without it, patching the roster
    of a live lead races that lead's own spawn and shutdown writes, and one of
    the two updates is simply lost."""
    lock = cfg.with_name("config.json.lock")
    deadline = time.time() + timeout
    handle = None
    while handle is None:
        try:
            handle = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            if time.time() > deadline:
                warn(f"{lock.name} held by someone else for {timeout}s; writing anyway")
                break
            time.sleep(0.05)
        except OSError:
            break  # unwritable dir: the write below will report the real error
    try:
        yield
    finally:
        if handle is not None:
            os.close(handle)
            try:
                lock.unlink()
            except OSError:
                pass


_BACKED_UP = set()


def edit_team_config(cfg, mutate, note, create=None):
    """Read-modify-write a roster under the harness's lockfile.

    The read happens inside the lock as well, so a harness write landing
    between read and write cannot be overwritten. `mutate(data)` returns the
    new data, or None to make the write a no-op.
    """
    cfg.parent.mkdir(parents=True, exist_ok=True)
    with team_lock(cfg):
        if cfg.exists():
            try:
                data = json.loads(cfg.read_text())
            except ValueError as exc:
                warn(f"{cfg} is not valid JSON ({exc}); leaving it alone")
                return False
        elif create is None:
            warn(f"no roster at {cfg}")
            return False
        else:
            data = create

        data = mutate(data)
        if data is None:
            return False

        suffix = ""
        if cfg.exists():
            # One backup per run: the pre-run state, not a mid-run write.
            backup = cfg.with_suffix(f".json.bak-{TOOL}")
            if str(cfg) not in _BACKED_UP:
                backup.write_text(cfg.read_text())
                _BACKED_UP.add(str(cfg))
            suffix = f" (backup: {backup.name})"
        tmp = cfg.with_suffix(f".json.tmp-{TOOL}")
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        os.replace(tmp, cfg)
    print(f"  {note} {cfg}{suffix}")
    return True


def ensure_inbox(team, name, dry):
    """A zero-byte inbox is a parse error that wedges both reader and writer."""
    if not team or not name:
        return
    path = RESOLVER.inbox_path(team, name)
    try:
        if path.exists() and path.stat().st_size > 0:
            return
    except OSError:
        pass
    if dry:
        step(True, f"would seed {path} with []", "")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("[]")
    step(False, "", f"seeded {path} with []")


def synced_fields(ctx):
    """The member fields both roster writers keep in step with the launch."""
    merged = ctx["merged"]
    out = {}
    for field in ("color", "model", "agentType"):
        value = merged.pick(field, prefer_specific=(field == "model"))[0]
        if value:
            out[field] = value
    return out


def register_member(team, ctx, pane, dry, alive=True):
    """Hand-register the rebound member in the destination roster (Recipe 1b).

    SendMessage's roster fallback reads this file at send time, so the entry is
    what makes the member addressable from the live lead."""
    merged = ctx["merged"]
    cfg = RESOLVER.roster_path(team)
    name = merged.pick("agentName")[0]
    agent_id = f"{name}@{team}"

    def mutate(data):
        if agent_id == data.get("leadAgentId"):
            warn(f"refusing to register the lead {agent_id} as a pane-backed member")
            return None
        member = next((m for m in data.get("members", []) if m.get("agentId") == agent_id), None)
        if member is None:
            member = {
                "agentId": agent_id,
                "name": name,
                "joinedAt": int(time.time() * 1000),
                "subscriptions": [],
                "agentType": merged.pick("agentType")[0] or DEFAULT_AGENT_TYPE,
                "planModeRequired": merged.pick("permissionMode")[0] == "plan",
                **({"cwd": member_cwd} if (member_cwd := agent_cwd(ctx)) else {}),
            }
            color = merged.pick("color")[0]
            if color:
                member["color"] = color
            model = merged.pick("model", prefer_specific=True)[0]
            if model:
                member["model"] = model
            data.setdefault("members", []).append(member)
        member.update(synced_fields(ctx))
        member.update({"tmuxPaneId": pane or "", "backendType": "tmux", "isActive": alive})
        return data

    if dry:
        step(True, f"would register {agent_id} in {cfg}", "")
        return
    if edit_team_config(cfg, mutate, f"registered {agent_id} in"):
        ensure_inbox(team, name, dry)


def retire_member(ctx, dry):
    """Mark the source-team entry inactive after a rebind, so the abandoned
    roster stops claiming a live member."""
    entry = ctx.get("team_entry")
    if not entry:
        return
    cfg = entry["cfg"]
    agent_id = entry["member"].get("agentId")

    def mutate(data):
        changed = False
        for member in data.get("members", []):
            if member.get("agentId") == agent_id and member.get("isActive"):
                member["isActive"] = False
                changed = True
        return data if changed else None

    if dry:
        step(True, f"would retire {agent_id} in {cfg}", "")
        return
    edit_team_config(cfg, mutate, f"retired {agent_id} in")


def update_team_config(ctx, pane, dry, alive=True):
    entry = ctx["team_entry"]
    if not entry:
        return
    cfg = entry["cfg"]
    agent_id = entry["member"].get("agentId")

    def mutate(data):
        if agent_id and agent_id == data.get("leadAgentId"):
            # A lead is never pane-backed. Writing tmux/%N onto its entry points
            # the harness's exit reaper (which kills members with a pane-type
            # backend) at a pane id that belongs to somebody else.
            warn(f"refusing to write pane-backed fields onto the lead entry {agent_id}")
            return None
        changed = False
        for member in data.get("members", []):
            if member.get("agentId") != agent_id:
                continue
            # Sync the roster to the launch we just performed, rather than only
            # filling blanks: a roster saying claude-opus-5 while the process
            # runs claude-opus-5[1m] describes something that does not exist.
            updates = [("tmuxPaneId", pane), ("backendType", "tmux"), ("isActive", alive)]
            updates += list(synced_fields(ctx).items())
            for key, value in updates:
                if value is not None and member.get(key) != value:
                    member[key] = value
                    changed = True
        return data if changed else None

    if dry:
        step(True, f"would update {cfg}", "")
        return
    edit_team_config(cfg, mutate, "updated")


def claude_binary(args):
    """Always the `claude` on PATH, never the pinned version the transcript was
    written by, and never CLAUDE_CODE_EXECPATH, both of which can be stale."""
    if args.claude_bin:
        return args.claude_bin
    from shutil import which

    return which("claude") or "claude"


def build_command(ctx, args, passthrough):
    merged = ctx["merged"]
    user_flags = {a.split("=", 1)[0] for a in passthrough if a.startswith("-")}
    cmd = [claude_binary(args), "--resume", ctx["session_uuid"]]

    dest = ctx.get("to_team")
    for flag, field in DERIVED_FLAGS.items():
        if flag in user_flags:
            continue
        value = merged.pick(field, prefer_specific=(field == "model"))[0]
        if dest:  # rebinding onto a live lead's implicit team
            if field == "teamName":
                value = dest
            elif field == "agentId":
                value = f"{merged.pick('agentName')[0]}@{dest}"
            elif field == "parentSessionId":
                value = ctx.get("to_lead") or value
        if not value:
            continue
        # The lead masquerade wears the teammate flags but not these two: there
        # is no "team-lead" agent type to resolve, and a lead is its own parent.
        if flag == "--agent-type" and value == "team-lead":
            continue
        if flag == "--parent-session-id" and value == ctx["session_uuid"]:
            continue
        cmd += [flag, str(value)]

    mode = merged.pick("permissionMode")[0]
    if mode and not user_flags & {"--permission-mode", "--dangerously-skip-permissions"}:
        if mode == "bypassPermissions":
            cmd.append("--dangerously-skip-permissions")
        elif mode not in ("default", "normal"):
            cmd += ["--permission-mode", mode]

    return cmd + passthrough


def explain(ctx):
    merged = ctx["merged"]
    print("resolved fields (most recent source wins):")
    width = max((len(f) for f in merged.cands), default=8)
    for field in sorted(merged.cands):
        value, ts, source = merged.pick(field, prefer_specific=(field == "model"))
        conflict = merged.conflicts(field)
        mark = "  <- conflict: " + ", ".join(sorted(str(c) for c in conflict)) if len(conflict) > 1 else ""
        print(f"  {field:<{width}}  {value}   [{source} @ {ms_str(ts)}]{mark}")
    for path, _, last_ts in ctx["other_transcripts"]:
        print(f"  (older transcript ignored: {path.name} @ {ms_str(last_ts)})")


def check_substrate():
    """SKILL.md says substrate choice is not ours to make, and this tool only
    implements the tmux one. Say so rather than silently imposing panes."""
    try:
        mode = json.loads((CLAUDE_DIR / "settings.json").read_text()).get("teammateMode")
    except (OSError, ValueError):
        return
    if mode and mode not in ("tmux", "auto"):
        warn(f"teammateMode is {mode!r}, but this tool only revives into tmux panes")


def build_command_agent_id(ctx):
    """The agent id the launch wears, which a rebind changes."""
    merged = ctx["merged"]
    dest = ctx.get("to_team")
    return f"{merged.pick('agentName')[0]}@{dest}" if dest else merged.pick("agentId")[0]


def auto_redirect(ctx, args, table, prefix=""):
    """Give a launch the identity of the team the lead actually runs as.

    Two different operations hide behind "rebind". REDIRECT chooses the flags
    for a launch that is happening anyway, and writes roster entries; it kills
    nothing. MIGRATE changes a LIVE member's team, which is necessarily kill
    and restart, because identity is frozen in argv at exec and two processes
    must never append to one transcript.

    The default may redirect. Only an explicit --to-team may migrate, so that
    every killed process traces back to something the user actually asked for.
    Redirect also requires exact evidence: the mint-window join is a heuristic,
    and acting on a heuristic unasked is how "pick the newest" comes back.
    """
    merged = ctx["merged"]
    agent_id, source = merged.pick("agentId")[0], merged.pick("teamName")[0]
    if args.keep_team or not (agent_id and source):
        return

    pid, alive, _, exact_lead = RESOLVER.lead_pid(merged.pick("parentSessionId")[0], source)
    if not (pid and alive and exact_lead):
        return
    dest, exact_team = RESOLVER.team_minted_by(pid)
    if not (dest and exact_team) or dest == source:
        return

    # Setting to_team below suppresses the guards further down (they are for the
    # explicit path), so this must ask every liveness question they would have.
    # argv is not enough: a session resumed from the in-app picker runs as bare
    # `claude` and is visible only to the registry.
    owner = RESOLVER.lead_pid_for(ctx["session_uuid"])
    holders = RESOLVER.procs_on_transcript(ctx["session_uuid"], table) + RESOLVER.live_agent_procs(agent_id, table)
    if holders or (owner and owner[2]):
        # Alive: leave it to the liveness guards. Say what the move would cost
        # rather than making it, since restarting throws away its current turn.
        who = f"pid {holders[0][0]}" if holders else f"pid {owner[0]} (registry)"
        warn(f"{agent_id} is running under stale team {source} as {who}; the lead now runs as {dest}. "
             f"--to-team live migrates it (restarts the process, losing its in-flight turn)")
        ctx["stale_team_warned"] = True
        return

    print(f"{prefix}redirect the lead now runs as {dest}, not {source}; "
          f"launching with that identity (--keep-team to stay)")
    ctx["to_team"], ctx["auto_redirect"] = dest, True
    ctx["to_lead"] = RESOLVER.team_lead_session(dest)


def run_one(args, passthrough, table, prefix=""):
    """Resume one agent. Returns (status, socket), status being
    'noop' | 'launched' | 'manual' | 'failed'.

    The socket is whichever server this agent ended up on, or None when it never
    reached one. Only this function knows which, and an agent that noops still
    has a pane worth attaching to, so the caller is told rather than left to
    read it off a field set partway through.
    """
    try:
        ctx = build(args)
    except SystemExit:
        return "failed", None
    merged = ctx["merged"]
    agent_id = merged.pick("agentId")[0]

    if args.explain:
        explain(ctx)

    # A lead belongs in your terminal, not a swarm pane: the masquerade is an
    # interactive session you drive, and a pane-backed lead would be reaped by
    # the next lead's exit anyway. No socket, no pane, no roster patch.
    if agent_id and agent_id == ctx.get("lead_agent_id"):
        command = build_command(ctx, args, passthrough)
        print(f"{prefix}lead     {agent_id}")
        print(f"{prefix}session  {ctx['session_uuid']}  ({ctx['transcript'][0]})")
        print(f"{prefix}via      {ctx['via']}")
        title = session_title(ctx["transcript"][0], limit=100)
        if title:
            print(f"{prefix}title    {title}")
        print(f"{prefix}cwd      {merged.pick('cwd')[0] or '(inherit)'}")
        owner = RESOLVER.lead_pid_for(ctx["session_uuid"])
        if owner and owner[2] and not args.force:
            warn(f"already live as pid {owner[0]}{state_note(owner[0])}; pass --force to run a second copy")
            return "noop", None
        # Only now: the masquerade reads the roster on boot, so the team dir has to
        # exist before the exec, and a lead whose team was reaped is the ordinary
        # case here rather than an edge one. Forging above this guard meant a run
        # that then declined to launch had already written a team dir.
        forge_team(ctx, args.dry_run)
        # The lead runs last, after every member is already in its pane, so there is
        # nothing left for this process to stay alive for. A lead is an interactive
        # session you drive rather than a pane you watch, so the run ends by becoming
        # it. Starting it from the wrong directory would leave it unable to find its
        # own conversation, since --resume looks the transcript up under the project
        # dir of wherever it starts.
        if sys.stdout.isatty() and not args.dry_run:
            where = agent_cwd(ctx)
            if where and os.path.realpath(where) != os.path.realpath(os.getcwd()):
                print(f"{prefix}cd       {where}")
                try:
                    os.chdir(where)
                except OSError as exc:
                    die(f"cannot enter {where}: {exc}")
            print(f"{prefix}exec     taking over this terminal")
            os.execvp(command[0], command)
        print(f"{prefix}run this in your terminal (leads are not spawned into tmux):")
        print(f"{prefix}  {' '.join(shlex.quote(c) for c in command)}")
        return "manual", None

    if args.to_team:
        dest = resolve_to_team(args, ctx)
        ctx["to_team"] = dest
        ctx["to_lead"] = RESOLVER.team_lead_session(dest)
    else:
        forge_team(ctx, args.dry_run)
        auto_redirect(ctx, args, table, prefix)

    socket, how = resolve_socket(ctx, args, table)
    if not socket:
        warn("could not determine a tmux socket; pass --socket claude-swarm-<lead-pid>")
        return "failed", None

    cwd = agent_cwd(ctx)
    want_pane = merged.pick("tmuxPaneId")[0]
    if want_pane and not re.fullmatch(r"%\d+", str(want_pane)):
        want_pane = None  # e.g. the lead's "leader" placeholder

    command = build_command(ctx, args, passthrough)
    adopted = inherit_credentials(ctx)

    print(f"{prefix}agent    {agent_id or '(unknown)'}")
    print(f"{prefix}session  {ctx['session_uuid']}  ({ctx['transcript'][0]})")
    print(f"{prefix}via      {ctx['via']}")
    title = session_title(ctx["transcript"][0], limit=100)
    if title:
        print(f"{prefix}title    {title}")
    print(f"{prefix}socket   {socket}  [{how}] ({socket_state(socket)})")
    print(f"{prefix}pane     {want_pane or '(none recorded)'}")
    print(f"{prefix}cwd      {cwd or '(inherit)'}")
    if adopted:
        print(f"{prefix}creds    inherited {', '.join(adopted)} from the lead")
    print(f"{prefix}command  {' '.join(shlex.quote(c) for c in command)}")

    # Same agent already in that pane -> nothing to do. Anything else in it -> new pane.
    _, occupants = pane_occupants(socket, want_pane, table) if want_pane else (False, [])
    here = [pid for pid, cmd in occupants if agent_id and f"--agent-id {agent_id}" in _argv_pairs(cmd)]
    others = [pid for pid, _ in occupants if pid not in here]

    held_by_us = RESOLVER.self_holds_transcript(ctx["session_uuid"], table)
    if held_by_us and not args.force:
        die(f"you are running this transcript yourself (pid {held_by_us[0]}); "
            "nothing can replace a process from inside it. Exit first, or have "
            "the lead run this")

    replace_pane = None
    if ctx.get("to_team") and not ctx.get("auto_redirect"):
        # Explicit --to-team only: this is the migrate half, and it kills.
        # A redirected launch never reaches here, so the default cannot kill.
        # Never guess a pane here: pane ids are per-server, so a recorded id
        # from another socket names an unrelated pane on this one, and killing
        # it would take out a stranger while the old holder kept writing.
        for index, (pid, _) in enumerate(RESOLVER.procs_on_transcript(ctx["session_uuid"], table)):
            holder_pane = pane_of_pid(socket, pid, table)
            if index == 0 and holder_pane:
                replace_pane = holder_pane
                print(f"{prefix}rebind   replacing pid {pid} in pane {holder_pane}")
                continue
            where = f"in pane {holder_pane}" if holder_pane else f"outside {socket}"
            step(args.dry_run, f"would kill pid {pid}, which also holds this transcript {where}",
                 f"killing pid {pid}, which also holds this transcript {where}")
            if not args.dry_run:
                killed = subprocess.run(["kill", str(pid)], capture_output=True)
                # Two processes appending to one transcript is the state this
                # prevents, so a kill that did not work has to be said out loud
                # rather than reported as a clean rebind.
                if killed.returncode != 0 or pid_alive(pid):
                    warn(f"pid {pid} did not die ({(killed.stderr or b'').decode().strip() or 'still running'}); "
                         "it is still appending to this transcript")
    elif here and not args.force:
        print(f"{prefix}noop     {agent_id} is already running in pane {want_pane} (pid {here[0]}{state_note(here[0])})")
        if not args.no_color:
            tint_pane(socket, want_pane, merged.pick("color")[0], merged.pick("agentName")[0], args.dry_run)
        if not args.no_update_config:
            update_team_config(ctx, want_pane, args.dry_run)
        return "noop", socket
    if others and not replace_pane:
        warn(f"pane {want_pane} runs a different claude (pid {', '.join(map(str, others))}); using a new pane")

    # An in-process lead runs as bare `claude` with no --agent-id to match, so
    # ask the session registry who currently owns this transcript.
    owner = RESOLVER.lead_pid_for(ctx["session_uuid"])
    if owner and owner[2] and not args.force and not ctx.get("to_team"):
        warn(
            f"session {ctx['session_uuid']} is live as pid {owner[0]}{state_note(owner[0])}; "
            "pass --force to resume a second copy"
        )
        return "noop", socket

    live = RESOLVER.live_agent_procs(agent_id, table) if agent_id else []
    elsewhere = [pid for pid, _ in live if pid not in here]
    if elsewhere and not args.force and not ctx.get("to_team"):
        warn(
            f"{agent_id} is already running outside pane {want_pane or '?'} "
            f"(pid {', '.join(map(str, elsewhere))}); pass --force to start another instance"
        )
        return "noop", socket

    # Already standing in the right place: run the agent in this pane instead of
    # splitting a new one and leaving the shell we were invoked from idle beside
    # it. Bookkeeping has to happen first, since exec never returns.
    in_socket, in_pane = current_tmux()
    # Never when a tool is driving (its shell would be swallowed), never inside
    # --team (the loop would end), and never when a live holder has to be killed
    # first: exec cannot respawn the pane, so that case belongs to launch().
    if (in_socket == socket and in_pane and not replace_pane
            and not getattr(args, "in_team", False) and not os.environ.get("CLAUDECODE")):
        pane_exists = any(p["pane"] == want_pane for p in list_panes(socket)) if want_pane else False
        if in_pane == want_pane or not pane_exists:
            print(f"{prefix}exec     you are in {in_pane} on {socket}; running here rather than splitting")
            if ctx.get("to_team"):
                register_member(ctx["to_team"], ctx, in_pane, args.dry_run)
                if ctx["to_team"] != merged.pick("teamName")[0]:
                    retire_member(ctx, args.dry_run)
            else:
                ensure_inbox(merged.pick("teamName")[0], merged.pick("agentName")[0], args.dry_run)
                if not args.no_update_config:
                    update_team_config(ctx, in_pane, args.dry_run)
            rendered = f"exec in {cwd or os.getcwd()}: {' '.join(shlex.quote(c) for c in command)}"
            step(args.dry_run, f"would {rendered}", rendered, indent=prefix)
            if args.dry_run:
                return "launched", socket
            # The same environment and cwd launch() would have given it: the
            # team vars a flag-bound boot needs, no inherited API poison, and
            # the project dir --resume looks the transcript up under.
            environ = dict(os.environ)
            environ.pop("ANTHROPIC_BASE_URL", None)
            environ.update(dict(pair.split("=", 1) for pair in TEAM_ENV))
            if not args.no_color:
                tint_pane(socket, in_pane, merged.pick("color")[0], merged.pick("agentName")[0], False)
            if cwd:
                try:
                    os.chdir(cwd)
                except OSError as exc:
                    die(f"cannot enter {cwd}: {exc}")
            try:
                os.execvpe(command[0], command, environ)
            except OSError as exc:
                # exec replaces this process or it does not happen at all, so
                # reaching here means the member the roster was just told about
                # does not exist. Take the claim back before failing.
                if ctx.get("to_team"):
                    retire_member(ctx, False)
                die(f"cannot exec {command[0]}: {exc}")

    try:
        launched_at = ctx["transcript"][0].stat().st_mtime
    except OSError:
        launched_at = 0.0
    pane, action = launch(socket, want_pane, cwd, command, args.dry_run, replace_pane)
    print(f"{prefix}{'would run' if args.dry_run else 'running'} in pane {pane or '<new>'} ({action})")
    if not args.no_color:
        tint_pane(socket, pane, merged.pick("color")[0], merged.pick("agentName")[0], args.dry_run)

    alive = True
    if not args.dry_run:
        alive, why = launch_survived(socket, pane, build_command_agent_id(ctx),
                                     ctx["transcript"][0], launched_at)
        if alive:
            print(f"{prefix}alive    {why}")
        else:
            warn(f"the launch in pane {pane} is not running: {why}; recording it as inactive")

    if ctx.get("to_team"):
        register_member(ctx["to_team"], ctx, pane, args.dry_run, alive)
        if ctx["to_team"] != merged.pick("teamName")[0]:
            retire_member(ctx, args.dry_run)
    else:
        ensure_inbox(merged.pick("teamName")[0], merged.pick("agentName")[0], args.dry_run)
        if not args.no_update_config:
            update_team_config(ctx, pane, args.dry_run, alive)

    return ("launched" if alive else "failed"), socket


def run_complete(topic):
    """Emit completion candidates. `selector` prefixes each line with its group
    so one process serves all three, instead of paying interpreter startup thrice."""
    if topic == "selector":
        # A uuid is a valid selector, so the selector position offers them too;
        # they were previously reachable only behind --resume.
        for group in ("names", "teams", "leads"):
            buffer = io.StringIO()
            with contextlib.redirect_stdout(buffer):
                run_complete(group)
            for line in buffer.getvalue().splitlines():
                print(f"{group}\t{line}")
        return 0

    if topic == "sockets":
        for path in swarm_sockets():
            state = "live" if socket_alive(path) else "dead"
            print(f"{path.name}:{state}, {ms_str(int(path.stat().st_mtime * 1000))}")
        return 0

    if topic == "sessions":
        files = sorted(
            RESOLVER.transcripts_by_mtime()
        )
        for path in files:
            when = ms_str(int(path.stat().st_mtime * 1000))
            title = session_title(path, limit=COMPLETION_TITLE)
            desc = f"{title}  [{path.parent.name}, {when}]" if title else f"{path.parent.name}, {when}"
            print(f"{path.stem}:{desc}")
        return 0

    entries = RESOLVER.scan_teams()
    entries.sort(key=lambda e: e["ts"], reverse=True)

    if topic == "agent-ids":
        for entry in entries:
            agent_id = entry["member"].get("agentId")
            if agent_id:
                ansi = COLOR_ANSI.get(entry["member"].get("color") or "", "")
                print(f"{agent_id}\tjoined {ms_str(entry['ts'])}\t{ansi}")
        return 0

    if topic == "teams":
        seen = set()
        for entry in entries:
            team = entry["team"]
            if team in seen:
                continue
            seen.add(team)
            count = sum(1 for e in entries if e["team"] == team)
            plural = "member" if count == 1 else "members"
            title = lead_title(entries, team, limit=COMPLETION_TITLE)
            when = ms_str(entry["ts"])
            if title:
                desc = f"{title}  [{count} {plural}, {when}]"
            elif not team_souls(team):
                # Nothing in it resolves any more, which is also what the reaper
                # checks before removing the directory.
                desc = f"nothing left to resurrect, {count} {plural}, {when}"
            else:
                desc = f"{count} {plural}, {when}"
            print(f"{team}:{desc}")
        return 0

    if topic == "leads":
        seen = set()
        for entry in entries:
            agent_id = entry["member"].get("agentId")
            if not agent_id or agent_id in seen or agent_id != entry.get("leadAgentId"):
                continue
            seen.add(agent_id)
            # a bare "team-lead" names every team, so only full ids, titled
            title = lead_title(entries, entry["team"], limit=COMPLETION_TITLE)
            if not title and not RESOLVER.resolve_transcript(lead_session=entry.get("leadSessionId"),
                                                    team=entry.get("team"), is_lead=True, quick=True):
                title = "transcript gone, cannot be resumed"
            joined = f"joined {ms_str(entry['ts'])}"
            print(f"{agent_id}\t{title + ', ' + joined if title else joined}\t")
        return 0

    if topic == "names":
        # A roster is where an agent's colour and join time live, but not where
        # its existence is decided: the harness deletes a team dir when its lead
        # exits, leaving members that are still perfectly resurrectable. So the
        # candidates are every stamped transcript, enriched from the roster when
        # one survives.
        candidates = {}
        for path, (name, team) in RESOLVER.stamp_index().items():
            if not name or not team or name == "team-lead":
                continue
            agent_id = f"{name}@{team}"
            try:
                when = int(path.stat().st_mtime * 1000)
            except OSError:
                continue
            if agent_id not in candidates or when > candidates[agent_id][0]:
                candidates[agent_id] = (when, path, None)
        for entry in entries:
            member = entry["member"]
            agent_id, name = member.get("agentId"), member.get("name")
            if not agent_id or not name or agent_id == entry.get("leadAgentId"):
                continue
            known = candidates.get(agent_id)
            res = RESOLVER.resolve_transcript(team=entry["team"], name=name, quick=True)
            candidates[agent_id] = (
                max(entry["ts"], known[0] if known else 0),
                res.path if res else (known[1] if known else None),
                member,
            )
        # One row per agent. The same name is registered in several teams after
        # a rebind, and only one of those registrations is worth offering:
        # a live one, else one that resolves to a transcript, else the newest.
        # An entry that is neither live nor resolvable is a leftover claim.
        live_agents = {e["agent"] for e in RESOLVER.live_sessions() if e["alive"] and e["agent"]}
        best = {}
        for agent_id, (when, path, member) in candidates.items():
            name = agent_id.split("@", 1)[0]
            rank = (agent_id in live_agents, path is not None, when)
            if name not in best or rank > best[name][0]:
                best[name] = (rank, agent_id)
        candidates = {agent_id: candidates[agent_id] for _, agent_id in best.values()}

        # Grouped by the session they belong to, newest session first and newest
        # member first inside it. An agent whose roster is gone still names its
        # team in its transcript, so orphans sit with their own siblings rather
        # than scattered through one long list.
        by_team = collections.defaultdict(list)
        for agent_id, (when, path, member) in candidates.items():
            by_team[agent_id.split("@", 1)[-1]].append((when, agent_id, path, member))
        rosters = {e["team"] for e in RESOLVER.scan_teams()}
        for team in sorted(by_team, key=lambda t: max(w for w, *_ in by_team[t]), reverse=True):
            members = sorted(by_team[team], reverse=True)
            label = f"{team}  {ms_str(members[0][0])}"
            if team not in rosters:
                label += ", no roster"
            for when, agent_id, path, member in members:
                title = session_title(path, limit=COMPLETION_TITLE) if path else None
                stamp = f"joined {ms_str(when)}" if member else f"last active {ms_str(when)}"
                desc = f"{title}, {stamp}" if title else stamp
                colour = (member or {}).get("color") or RESOLVER.spawn_payload(agent_id).get("color")
                ansi = "" if NO_COLOR else COLOR_ANSI.get(colour or "", "")
                print(f"{label}\t{agent_id}\t{desc}\t{ansi}")
        return 0

    die(f"unknown completion topic {topic!r}")


SOCKET_GRACE_S = 60  # never reap a socket younger than this; a server may be mid-bind


def cleanup_sockets(dry=False):
    """Remove swarm socket files whose tmux server is gone.

    Probes with a connect() rather than spawning tmux per socket: this runs
    from a SessionStart hook, so it has to be measured in milliseconds.
    """
    removed = []
    now = time.time()
    for path in swarm_sockets():
        try:
            if now - path.stat().st_mtime < SOCKET_GRACE_S:
                continue
        except OSError:
            continue
        if socket_alive(path):
            continue
        if dry:
            removed.append(path.name)
            continue
        try:
            path.unlink()
            removed.append(path.name)
        except OSError as exc:
            warn(f"cannot remove {path}: {exc}")
    if removed:
        print(f"{'would remove' if dry else 'removed'} {len(removed)} dead socket(s): {', '.join(removed)}")
    return 0


# A team dir is created before the things that prove its session is alive: the
# registry entry, the first spawn payload, the masquerade's argv. This covers
# that gap only. Age is not evidence of emptiness, so it stays small.
TEAM_GRACE_S = 300

# Descriptions in completion have a whole terminal row to themselves.
COMPLETION_TITLE = 400
NO_COLOR = False  # zsh truncates to the real terminal width


def cruft_reason(team_dir):
    """Why this directory is NOT pure scaffolding, or None if it is.

    Every entry must be something this tool or the harness is known to create,
    and known to be contentless. Anything unrecognised, anything nested, any
    symlink, and any inbox holding mail means the directory is spared.
    """
    known = {
        "config.json",
        "inboxes",
        f"config.json.bak-{TOOL}",
        f"config.json.tmp-{TOOL}",
        "config.json.lock",
    }
    try:
        entries = list(team_dir.iterdir())
    except OSError as exc:
        return f"unreadable ({exc})"

    for item in entries:
        if item.is_symlink():
            return f"{item.name} is a symlink"
        if item.name not in known:
            return f"unexpected entry {item.name!r}"
        if item.name != "inboxes":
            if not item.is_file():
                return f"{item.name} is not a regular file"
            continue

        if not item.is_dir():
            return "inboxes is not a directory"
        for inbox in item.iterdir():
            if inbox.is_symlink():
                return f"inboxes/{inbox.name} is a symlink"
            if not inbox.is_file():
                return f"inboxes/{inbox.name} is not a regular file"
            if inbox.suffix != ".json":
                return f"inboxes/{inbox.name} is not a .json file"
            try:
                mail = json.loads(inbox.read_text() or "[]")
            except (OSError, ValueError) as exc:
                return f"inboxes/{inbox.name} is unreadable or not JSON ({exc})"
            if not isinstance(mail, list):
                return f"inboxes/{inbox.name} is not a message array"
            if mail:
                return f"inboxes/{inbox.name} holds {len(mail)} undelivered message(s)"

    config = team_dir / "config.json"
    if not config.is_file():
        return "no config.json"
    try:
        data = json.loads(config.read_text())
    except (OSError, ValueError) as exc:
        return f"config.json unreadable ({exc})"
    if not isinstance(data, dict) or not isinstance(data.get("members", []), list):
        return "config.json is not a roster"
    return None


def remove_if_cruft(path, dry, kind):
    """Delete a directory only after re-proving it holds nothing.

    Re-checked immediately before unlinking, and the loop refuses anything that
    appeared since, so a file landing mid-sweep stops the deletion instead of
    being swept up with it.
    """
    if not path.is_dir():
        return True
    if RESOLVER.roster_path(path.name).parent.parent not in path.parents \
            and (CLAUDE_DIR / "tasks") not in path.parents:
        warn(f"refusing to remove {path}: outside the directories this tool owns")
        return False
    if kind == "team":
        reason = cruft_reason(path)
        if reason:
            warn(f"not removing {path.name}: {reason}")
            return False
    else:  # a task dir must be completely empty
        leftovers = list(path.iterdir())
        if leftovers:
            warn(f"not removing {path}: holds {', '.join(p.name for p in leftovers[:3])}")
            return False
    if dry:
        return True

    # Checking names is not enough: an inbox filename is in the verified set, so
    # mail arriving after the check would be deleted along with the directory.
    # Take the directory out of reach with an atomic rename, THEN re-prove it,
    # so a writer racing us either lands before the rename (and is seen) or
    # finds the path gone. Anything unexpected is put straight back.
    staged = path.with_name(f"{path.name}.reaping-{os.getpid()}")
    try:
        os.rename(path, staged)
    except OSError as exc:
        warn(f"cannot stage {path} for removal: {exc}")
        return False

    reason = cruft_reason(staged) if kind == "team" else (
        f"holds {', '.join(p.name for p in list(staged.iterdir())[:3])}" if any(staged.iterdir()) else None
    )
    if reason:
        try:
            os.rename(staged, path)
            warn(f"not removing {path.name}: {reason} (appeared while removing; put back)")
        except OSError as exc:
            warn(f"{path.name}: {reason}, and restoring it failed: {exc}; it is at {staged}")
        return False

    try:
        # config.json last, so an interrupted deletion leaves something the
        # keep-checks still recognise as a team rather than a headless dir.
        for sub in sorted(staged.iterdir(), key=lambda p: p.name == "config.json"):
            if sub.is_dir():
                for inbox in sorted(sub.iterdir()):
                    inbox.unlink()
                sub.rmdir()
            else:
                sub.unlink()
        staged.rmdir()
    except OSError as exc:
        warn(f"cannot remove {staged}: {exc}")
        return False
    return True


def team_keep_reason(cfg, table):
    """Why this team must be kept, or None if nothing in it is resurrectable.

    Empty means provably unresurrectable: no live process running as it, no
    lead transcript, and not one member with a transcript. Teams in that state
    are the residue of a Claude launch that registered a team at startup and
    exited before the first prompt, so nothing was ever written. Anything less
    certain is left alone; the cost of a stale directory is nothing, and the
    cost of deleting a resurrectable team is somebody's memory.
    """
    entries = [e for e in RESOLVER.scan_teams() if e["cfg"] == cfg]
    if not entries:
        return "unreadable or memberless roster"
    team, lead_session = entries[0]["team"], entries[0]["leadSessionId"]

    if time.time() - cfg.parent.stat().st_mtime < TEAM_GRACE_S:
        return "created moments ago"
    pid, alive, _, _exact = RESOLVER.lead_pid(lead_session, team)
    if pid and alive:
        return f"pid {pid} is live for this team"
    # Both transcript questions go through the resolver, so "does a soul exist
    # here" is answered by the same engine that would resurrect it. Asking any
    # other way risks deleting something the tool could have brought back.
    souls = team_souls(team, entries)
    if souls:
        return f"still resurrectable: {', '.join(sorted(souls))}"
    return cruft_reason(cfg.parent)


def cleanup_teams(dry=False):
    """Remove team dirs that hold nothing resurrectable, and their task dirs."""
    removed = []
    table = RESOLVER.ps_table()
    for cfg in sorted(RESOLVER.roster_path(d.name) for d in RESOLVER.team_dirs()):
        keep = team_keep_reason(cfg, table)
        if keep:
            if dry:  # auditable, but not noise in the hook
                print(f"  keeping {cfg.parent.name}: {keep}")
            continue
        if not remove_if_cruft(cfg.parent, dry, "team"):
            continue
        remove_if_cruft(CLAUDE_DIR / "tasks" / cfg.parent.name, dry, "tasks")
        removed.append(cfg.parent.name)
    if removed:
        print(f"{'would remove' if dry else 'removed'} {len(removed)} empty team(s): {', '.join(removed)}")
    return removed


def run_cleanup(dry=False):
    """Everything the SessionStart hook reaps."""
    cleanup_sockets(dry)
    cleanup_teams(dry)
    return 0


HOOK_MARKER = "--cleanup"


def write_settings(settings, data):
    if settings.exists():
        settings.with_suffix(f".json.bak-{TOOL}").write_text(settings.read_text())
    tmp = settings.with_suffix(f".json.tmp-{TOOL}")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, settings)


def install_hook(command):
    """Add the SessionStart janitor hook, preserving everything else."""
    settings = CLAUDE_DIR / "settings.json"
    try:
        data = json.loads(settings.read_text()) if settings.exists() else {}
    except ValueError as exc:
        warn(f"{settings} is not valid JSON ({exc}); leaving hooks alone")
        return False
    if not isinstance(data, dict):
        warn(f"{settings} is not a JSON object; leaving hooks alone")
        return False

    entries = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    for entry in entries:
        for hook in entry.get("hooks", []):
            existing = hook.get("command") or ""
            if existing == command:
                print(f"ok        SessionStart cleanup hook already in {settings}")
                return True
            if TOOL in existing or "resume-agent --cleanup" in existing:
                # An older command for this same tool: update in place rather
                # than leave two hooks reaping the same things.
                hook["command"] = command
                write_settings(settings, data)
                print(f"rehooked  SessionStart in {settings} (was: {existing})")
                return True
    entries.append(
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command,
                    "async": True,  # a janitor must never delay session start
                    "timeout": 10,
                }
            ]
        }
    )
    write_settings(settings, data)
    print(f"hooked    SessionStart in {settings} (backup: settings.json.bak-{TOOL})")
    return True


def drop_stale_compdumps():
    """Delete completion caches that predate this install.

    zsh does not rescan fpath when a cached dump exists, and oh-my-zsh only
    refreshes it about daily, so a freshly linked completion silently does
    nothing in new shells. The dump is a cache and regenerates on next start,
    so removing it is cheap; leaving it means the install did not take.
    """
    stale = []
    for dump in sorted(Path.home().glob(".zcompdump*")):
        try:
            if dump.suffix == ".zwc" or TOOL not in dump.read_text(errors="replace"):
                dump.unlink()
                stale.append(dump.name)
        except OSError:
            continue
    if stale:
        print(f"  cleared stale completion cache: {', '.join(stale)}")


def run_install():
    """Symlink the script into ~/.local/bin and its zsh completion onto fpath."""
    src = Path(__file__).resolve()
    comp_src = src.parent / f"_{TOOL}"
    failed = False

    def link(target, dest):
        nonlocal failed
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.resolve() == target:
            print(f"ok        {dest} -> {target} (already)")
            return
        if dest.exists() or dest.is_symlink():
            warn(f"skipping {dest}: exists and points elsewhere ({dest.resolve()})")
            failed = True
            return
        rel = os.path.relpath(target, dest.parent)
        dest.symlink_to(rel)
        print(f"linked    {dest} -> {rel}")

    link(src, Path.home() / ".local/bin" / TOOL)

    bin_path = Path.home() / ".local/bin" / TOOL
    if not install_hook(f"{bin_path} {HOOK_MARKER} >/dev/null 2>&1"):
        failed = True

    if not comp_src.exists():
        warn(f"no completion file at {comp_src}; script link done, completion skipped")
        return 1

    # Prefer a dir already on fpath; oh-my-zsh puts custom/completions there.
    omz = Path(os.environ.get("ZSH") or Path.home() / ".oh-my-zsh")
    if omz.is_dir():
        link(comp_src, omz / "custom/completions" / f"_{TOOL}")
        drop_stale_compdumps()
        print("completion active in new shells; reload this one with: exec zsh")
    else:
        comp_dir = Path.home() / ".zsh/completions"
        link(comp_src, comp_dir / f"_{TOOL}")
        print(f"add to ~/.zshrc before compinit: fpath=({comp_dir} $fpath)")
    return 1 if failed else 0


def newest_live_socket():
    for path in swarm_sockets():
        if socket_alive(path):
            return path.name
    return None


def run_poison(args):
    """Recipe 1 steps 0 and 2: (un)set ANTHROPIC_BASE_URL on the swarm server.

    While poisoned, every NEW pane's claude dies at TCP connect: $0 billed, no
    5-hour window anchored. Processes already running keep the env they were
    born with, in both directions; env is fixed at exec.
    """
    sock = args.socket or newest_live_socket()
    if not sock:
        die("no live swarm socket; pass --socket claude-swarm-<pid>")
    if not socket_alive(sock):
        die(f"socket {sock} has no live tmux server; poison lives in server env, nothing to set")

    if args.poison:
        res = tmux(sock, "set-environment", "-g", "ANTHROPIC_BASE_URL", POISON_URL)
        if res.returncode != 0:
            die(f"set-environment failed on {sock}: {res.stderr.strip()}")
        print(f"poisoned {sock}: new panes get ANTHROPIC_BASE_URL={POISON_URL}")
        print(f"placeholders will sit in an API error; unpoison with: {TOOL} --unpoison --socket {sock}")
    else:
        res = tmux(sock, "set-environment", "-gu", "ANTHROPIC_BASE_URL")
        if res.returncode != 0:
            die(f"set-environment -gu failed on {sock}: {res.stderr.strip()}")
        print(f"unpoisoned {sock}: new panes get a working API again")
        print("live placeholders keep their poisoned env; the swap's env scrub handles the pane")

    cur = tmux(sock, "show-environment", "-g", "ANTHROPIC_BASE_URL")
    state = cur.stdout.strip() if cur.returncode == 0 else "-ANTHROPIC_BASE_URL (unset)"
    print(f"server env now: {state}")
    return 0


def team_socket(data, args, table):
    """(socket, why) for the whole team, so every member lands on the same server.

    Evidence strongest first, the same order resolve_socket uses per member:
    --socket, the server already hosting a live member, the live lead's pid, and
    a server named after the team.

    A live member outranks the lead's pid because it is where a process
    demonstrably is, while the pid only says where a server would be if the lead
    had made one. A lead never does: it runs in your terminal rather than a pane,
    so a socket named after its pid holds nothing unless a member happened to be
    launched while that lead was up. Members resurrected without a live lead land
    on the team's own server and never move, so the moment a lead appears the two
    names disagree and the pid names an empty server. Asking the members first is
    what keeps one team on one socket across those transitions.
    """
    if args.socket:
        return args.socket, "--socket"
    team = data.get("name")
    lead_id = data.get("leadAgentId")
    # The lead is skipped because it never runs in a pane, so it can never be
    # the process that answers where the team's server is.
    sock, why = RESOLVER.socket_hosting(
        [m.get("agentId") for m in data.get("members", []) if m.get("agentId") != lead_id],
        table,
    )
    if sock:
        return sock, why
    pid, alive, _, _exact = RESOLVER.lead_pid(data.get("leadSessionId"), team)
    if pid and alive:
        return f"{SOCKET_PREFIX}{pid}", f"lead pid {pid}"
    if pid:
        warn(f"the lead of {team} last ran as pid {pid}, which is gone; using the team's own server")
    # Same answer resolve_socket reaches per member, said once: with the lead
    # gone the team gets a server of its own, named after it.
    if team:
        warn(f"no live lead for {team}; standing up that team's own server, as if its lead were up")
        return f"{SOCKET_PREFIX}{team}", f"resurrected server for {team}"
    return None, "unresolved"


def run_agents(args, passthrough, table, jobs, socket=None, prefix=""):
    """Run each prepared invocation, then finish the run once.

    A single agent is a team of one, and both entry points come through here so
    that stays true. Attaching is decided in one place: it depends on this run
    having left something in a pane, not on which entry point asked. A noop
    counts, since an agent already sitting in its pane is worth showing.

    `jobs` is (label, args) pairs; a None args is a member that was skipped.
    `socket` pins the whole run to one server when the caller already knows it,
    as a team does; otherwise the first agent to reach one decides.
    """
    results = []
    for label, sub_args in jobs:
        if label is not None:
            print(f"\n[{label}]")
        if sub_args is None:
            print(f"{prefix}skipped")
            results.append((label, "skipped"))
            continue
        status, used = run_one(sub_args, passthrough, table, prefix=prefix)
        results.append((label, status))
        socket = socket or used
    if len(jobs) > 1:
        print("\nsummary")
        for label, status in results:
            print(f"  {label:<24} {status}")
    if any(status == "manual" for _, status in results):
        # The lead is the foreground of this run: either we became it, or we could
        # not and printed its command. Either way the thing to look at is the lead,
        # not the swarm, so attaching would put the wrong window in front of you.
        return 1 if any(s == "failed" for _, s in results) else 0
    if not args.dry_run and socket and any(s in ("launched", "noop") for _, s in results):
        print()
        maybe_attach(args, socket)
    return 1 if any(s == "failed" for _, s in results) else 0


def run_team(args, passthrough, table):
    cfg = RESOLVER.roster_path(args.team)
    if not cfg.exists():
        die(f"no team config at {cfg}; a graceful lead exit rm -rf's the team dir, so forge it first")
    try:
        data = json.loads(cfg.read_text())
    except ValueError as exc:
        die(f"{cfg} is not valid JSON: {exc}")

    members = data.get("members", [])
    if not members:
        die(f"team {args.team} has no members")
    lead_id = data.get("leadAgentId")
    socket, socket_why = team_socket(data, args, table)

    # Members first, lead last: the lead is not spawned into a pane, so its turn
    # only prints the command for you to run, and that reads better at the end.
    # Members boot fine without it: the mailbox is a directory, not a process.
    ordered = sorted(members, key=lambda m: 1 if m.get("agentId") == lead_id else 0)
    where = (f"socket {socket} ({socket_why}, {socket_state(socket)})" if socket
             else "socket resolved per member")
    print(f"team     {args.team}  ({len(ordered)} members, {where})")

    jobs = []
    for member in ordered:
        agent_id = member.get("agentId")
        name = member.get("name") or "?"
        ensure_inbox(args.team, name, args.dry_run)  # every member, not just the launched ones
        if args.no_lead and agent_id == lead_id:
            jobs.append((name, None))
            continue
        one = copy.copy(args)
        one.agent_id, one.resume, one.team, one.socket = agent_id, None, None, socket
        one.socket_reason = "team socket" if not args.socket else "--socket"
        one.in_team = True  # never exec the lead mid-loop; the members need us alive
        jobs.append((name, one))
    return run_agents(args, passthrough, table, jobs, socket=socket, prefix="  ")


def set_tmux_target(session, window):
    global TMUX_SESSION, TMUX_WINDOW
    TMUX_SESSION = session or TMUX_SESSION
    TMUX_WINDOW = window or TMUX_WINDOW


RUNNING_SELFTEST_LINES = (3417, 3724)


def run_selftest():
    """Assert the invariants this tool keeps rediscovering. Read-only.

    Two kinds: structural ones read from this file's own syntax tree, because
    an invariant like "only the engine picks a transcript" is a property of the
    code rather than of a run; and behavioural ones exercised against whatever
    real data is on this machine, skipped rather than faked when absent.
    """
    import ast
    import tempfile

    results = []

    def check(name, ok, detail=""):
        results.append((name, ok, detail))

    source = Path(__file__).resolve().read_text()
    tree = ast.parse(source)
    def is_delegate(node):
        """A transitional forwarder: one return of RESOLVER.<same name>(*a, **k).

        Recognised by shape rather than by a name list, so the step-5 deletion
        cannot leave a stale exemption behind, and so a hand-written function
        cannot quietly acquire one.
        """
        if len(node.body) != 1 or not isinstance(node.body[0], ast.Return):
            return False
        call = node.body[0].value
        return (isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute)
                and getattr(call.func.value, "id", None) == "RESOLVER"
                and call.func.attr == node.name)

    delegates = {n.name for n in ast.walk(tree)
                 if isinstance(n, ast.FunctionDef) and is_delegate(n)}
    funcs = {n.name: n for n in ast.walk(tree)
             if isinstance(n, ast.FunctionDef) and not is_delegate(n)}

    def callers_of(target):
        """Callers by either spelling: a module function calls `target(...)`, an
        engine method calls `self.target(...)`. Matching only the first would
        make every invariant below pass by vacuity once the engine became a
        class, which is the opposite of what they are for."""
        out = set()
        for name, node in funcs.items():
            for sub in ast.walk(node):
                if not isinstance(sub, ast.Call):
                    continue
                if getattr(sub.func, "id", None) == target or (
                        isinstance(sub.func, ast.Attribute) and sub.func.attr == target):
                    out.add(name)
        return out

    # -- structural
    dupes = [n for n in ("resolve_transcript", "edit_team_config", "socket_alive", "lead_pid",
                         "stamp_index", "ps_table", "session_registry")
             if sum(1 for f in ast.walk(tree) if isinstance(f, ast.FunctionDef)
                    and f.name == n and not is_delegate(f)) != 1]
    check("engine primitives defined exactly once", not dupes, ", ".join(dupes))

    # the checker itself is not a caller of the thing it checks
    # The engine is a class, so membership of it is the exemption, not a list of
    # names. Enumerating names is what let a caller add a picker without tripping
    # this: a new engine method had to be remembered, and one was not.
    engine_node = next(node for node in ast.walk(tree)
                       if isinstance(node, ast.ClassDef) and node.name == "Resolver")
    engine = {m.name for m in engine_node.body if isinstance(m, ast.FunctionDef)}
    pickers = callers_of("transcript_path") - engine - {"team_keep_reason", "run_selftest"}
    check("only the engine picks a transcript", not pickers, ", ".join(sorted(pickers)))

    # The boundary. Naming the functions allowed to reach the tree was the form
    # that failed: a picker only had to avoid the named entry point, and one did,
    # by globbing directly. Membership of the class is checkable and cannot be
    # sidestepped by choosing a different spelling.
    ambient = {"PROJECTS_DIR", "SESSIONS_DIR", "TEAMS_DIR",
               "_ps", "_stamps", "_spawns", "_spawn_log", "_by_agent", "_by_team"}
    engine_lines = set(range(engine_node.lineno, engine_node.end_lineno + 1))
    trespass = sorted({
        f"{node.id} at line {node.lineno}"
        for node in ast.walk(tree)
        if isinstance(node, ast.Name) and node.id in ambient
        and isinstance(node.ctx, ast.Load)   # the declaration is a Store; only a use is a reach
        and node.lineno not in engine_lines
        and not (RUNNING_SELFTEST_LINES[0] <= node.lineno <= RUNNING_SELFTEST_LINES[1])})
    check("the tree is reached only through the engine", not trespass, "; ".join(trespass))

    writers = {n for n, node in funcs.items()
               if "os.replace" in ast.get_source_segment(source, node)}
    check("one roster writer", writers <= {"edit_team_config", "write_settings", "run_selftest"},
          ", ".join(sorted(writers - {"run_selftest"})))

    run_one_src = ast.get_source_segment(source, funcs["run_one"])
    # team_minted_by and pid_running_team read payloads for team membership,
    # a different question; this guards the per-agent lookup only.
    payload_readers = (callers_of("_spawn_by_agent") | callers_of("_spawn_records")) - {
        "spawn_payload", "_spawn_by_agent", "team_minted_by", "_pid_running_team",
        "members_spawned_into", "run_selftest"}
    check("one lookup for an agent's spawn payload", not payload_readers, ", ".join(sorted(payload_readers)))

    # A preview must be printed through step(), which carries both tenses, or
    # inline as "would X if dry else did X". A bare print of a "would" line has
    # no real counterpart and silently makes a real run quieter than its preview.
    unpaired = [line.strip()[:60] for line in source.splitlines()
                if "print(" in line and "would " in line and " else " not in line]
    check("every preview line has a real counterpart", not unpaired, "; ".join(unpaired))

    check("a self-migrate is refused",
          bool(RESOLVER.self_holds_transcript("selftest-uuid",
               [(os.getpid(), os.getppid(), "/usr/bin/claude --resume selftest-uuid --agent-id a@b")])))

    check("default path cannot kill",
          'if ctx.get("to_team") and not ctx.get("auto_redirect"):' in run_one_src)

    body = source.split('"""', 2)[-1]
    check("tool name not hardcoded", TOOL not in body, f"{body.count(TOOL)} literal(s)")

    # -- behavioural, against real data where it exists
    index = RESOLVER.stamp_index()
    stamped = next(((p, n, t) for p, (n, t) in index.items() if n and t and n != "team-lead"), None)
    if stamped:
        path, name, team = stamped
        check("rung: session uuid", bool(RESOLVER.resolve_transcript(session_uuid=path.stem, quick=True)))
        res = RESOLVER.resolve_transcript(team=team, name=name)
        check("rung: agentName+teamName stamps", bool(res) and res.via.startswith("agentName+teamName"))
        try:
            with contextlib.redirect_stderr(io.StringIO()):  # the refusal is the point, not its noise
                verify_identity(res, "definitely-not-" + name, team, False, False)
            check("identity gate refuses a mismatch", False, "it allowed one")
        except SystemExit:
            check("identity gate refuses a mismatch", True)
    else:
        check("rung: stamps (no stamped transcript on this machine)", True, "skipped")

    lead = next((e for e in RESOLVER.scan_teams()
                 if e["leadSessionId"] and RESOLVER.transcript_path(e["leadSessionId"])), None)
    if lead:
        res = RESOLVER.resolve_transcript(lead_session=lead["leadSessionId"], team=lead.get("team"),
                                 is_lead=True, quick=True)
        check("rung: roster leadSessionId", bool(res) and res.via == "roster leadSessionId")
    else:
        check("rung: leadSessionId (no lead transcript on this machine)", True, "skipped")

    ambiguous = [n for n in {e["member"].get("name") for e in RESOLVER.scan_teams()}
                 if n and len(RESOLVER.name_rosters(n)) > 1]
    if ambiguous:
        check("ambiguous name is refused", not RESOLVER.resolve_transcript(name=ambiguous[0]))
    else:
        check("ambiguous name (none on this machine)", True, "skipped")

    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        cases = {
            "pure": ({"team-lead.json": "[]"}, None, None),
            "mail": ({"team-lead.json": '[{"from":"x"}]'}, None, "undelivered"),
            "stray": ({"team-lead.json": "[]"}, "notes.txt", "unexpected"),
            "notjson": ({"team-lead.txt": "x"}, None, ".json"),
        }
        # a message landing in a name-verified file after the check
        race = base / "race"
        (race / "inboxes").mkdir(parents=True)
        (race / "config.json").write_text(json.dumps({"name": "race", "members": []}))
        (race / "inboxes" / "team-lead.json").write_text("[]")
        real_reason, fired = cruft_reason, []

        def racing(target):
            reason = real_reason(target)
            if not fired:
                fired.append(True)
                (race / "inboxes" / "team-lead.json").write_text('[{"from":"x"}]')
            return reason

        real_teams = RESOLVER.teams_dir
        globals()["cruft_reason"], RESOLVER.teams_dir = racing, base
        with contextlib.redirect_stderr(io.StringIO()):  # the refusal is the point
            removed = remove_if_cruft(race, False, "team")
        globals()["cruft_reason"], RESOLVER.teams_dir = real_reason, real_teams
        check("mail arriving mid-removal is not deleted",
              not removed and race.exists() and (race / "inboxes" / "team-lead.json").read_text() != "[]")

        # one row per agent, even when several rosters claim the name
        buffer = io.StringIO()
        with contextlib.redirect_stdout(buffer):
            run_complete("names")
        names = [line.split("\t")[1].split("@", 1)[0] for line in buffer.getvalue().splitlines() if line]
        check("completion offers each agent once", len(names) == len(set(names)),
              ", ".join(sorted({n for n in names if names.count(n) > 1})))

        for label, (inboxes, stray, expect) in cases.items():
            team = base / label
            (team / "inboxes").mkdir(parents=True)
            (team / "config.json").write_text(json.dumps({"name": label, "members": []}))
            for fname, content in inboxes.items():
                (team / "inboxes" / fname).write_text(content)
            if stray:
                (team / stray).write_text("x")
            reason = cruft_reason(team)
            ok = (reason is None) if expect is None else (reason is not None and expect in reason)
            check(f"cruft check: {label}", ok, reason or "considered empty")

    for topic in ("names", "teams", "leads", "sockets", "sessions"):
        buffer = io.StringIO()
        with contextlib.redirect_stdout(buffer):
            run_complete(topic)
        lines = [line for line in buffer.getvalue().splitlines() if line]
        malformed = [line for line in lines if "\t" not in line and ":" not in line]
        check(f"completion emits parseable {topic}", not malformed, f"{len(lines)} candidates")

    width = max(len(name) for name, _, _ in results)
    for name, ok, detail in results:
        note = f"  ({detail})" if detail else ""
        print(f"  {'PASS' if ok else 'FAIL'}  {name:<{width}}{note}")
    failed = sum(1 for _, ok, _ in results if not ok)
    print(f"\n{len(results) - failed}/{len(results)} checks passed")
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(
        prog=TOOL, allow_abbrev=False, add_help=False,
        description="Resume a Claude Code teammate in its swarm tmux session.",
    )
    parser.add_argument("--agent-id")
    parser.add_argument("--resume", metavar="SESSION_UUID")
    parser.add_argument("--team", metavar="TEAM", help="resume every member of this team")
    parser.add_argument("--no-lead", action="store_true", help="with --team, skip the lead")
    parser.add_argument("--keep-team", action="store_true",
                        help="do not adopt the team the lead now runs as; stay on the recorded roster")
    parser.add_argument("--to-team", metavar="TEAM|live",
                        help="rebind the member onto another team (live = the live lead's implicit team)")
    parser.add_argument("--install", action="store_true",
                        help="symlink into ~/.local/bin, set up completion and the cleanup hook")
    parser.add_argument("--no-color", "--no-colour", dest="no_color", action="store_true",
                        help="do not tint the pane, and emit completion candidates uncoloured")
    parser.add_argument("--selftest", action="store_true",
                        help="check the tool's invariants against this machine; changes nothing")
    parser.add_argument("--cleanup", "--cleanup-sockets", dest="cleanup", action="store_true",
                        help="reap dead swarm sockets and team dirs with nothing resurrectable")
    parser.add_argument("--complete", metavar="TOPIC", help=argparse.SUPPRESS)
    parser.add_argument("--poison", action="store_true",
                        help="point the swarm server's ANTHROPIC_BASE_URL at a dead port (Recipe 1 step 0)")
    parser.add_argument("--unpoison", action="store_true",
                        help="remove the poison from the swarm server (Recipe 1 step 2)")
    parser.add_argument("--socket")
    parser.add_argument("--tmux-session", metavar="NAME",
                        help=f"tmux session to launch into (default {TMUX_SESSION})")
    parser.add_argument("--tmux-window", metavar="NAME",
                        help=f"window to create when the session is missing (default {TMUX_WINDOW})")
    parser.add_argument("--claude-bin")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--explain", action="store_true")
    parser.add_argument("--no-update-config", action="store_true")
    parser.add_argument("--attach", action="store_true",
                        help="attach even if the swarm already has a watcher")
    parser.add_argument("--no-attach", action="store_true",
                        help="never attach; just print the command")
    parser.add_argument("-h", "--help", action="store_true")
    # Only a *leading* bare word is the selector; later bare words belong to
    # forwarded flags (argparse can't know that --model takes a value).
    argv = sys.argv[1:]
    selector = argv.pop(0) if argv and not argv[0].startswith("-") else None
    args, passthrough = parser.parse_known_args(argv)

    if args.selftest:
        return run_selftest()

    if args.cleanup:
        return run_cleanup(args.dry_run)

    if args.dry_run and (args.install or args.poison or args.unpoison):
        die("--dry-run does not cover --install/--poison/--unpoison; they mutate on purpose")

    if args.install:
        return run_install()

    if args.complete:
        global NO_COLOR
        NO_COLOR = args.no_color
        return run_complete(args.complete)

    if args.poison and args.unpoison:
        die("--poison and --unpoison are mutually exclusive")
    if args.poison or args.unpoison:
        if selector or args.agent_id or args.resume or args.team:
            die("--poison/--unpoison stand alone; they act on the server, not an agent")
        return run_poison(args)

    if args.help or not (selector or args.agent_id or args.resume or args.team):
        parser.print_help()
        print(__doc__)
        return 0 if args.help else 2

    if args.tmux_session or args.tmux_window:
        # One constant, set once: everything downstream reads these.
        set_tmux_target(args.tmux_session, args.tmux_window)

    check_substrate()
    table = RESOLVER.ps_table()
    if selector:
        apply_selector(selector, args, table)

    if args.team:
        return run_team(args, passthrough, table)

    return run_agents(args, passthrough, table, [(None, args)])


if __name__ == "__main__":
    sys.exit(main())
