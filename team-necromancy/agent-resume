def team_move_run(start, held_here=False, extra=(), reply="y", terminal=True):
    """Run `--team OLDCREW --into-team NEWCREW` for real against a synthetic world.

    runner is running in a process a move must end, and sitter and keeper are
    stopped, unless `held_here` puts keeper's conversation in this very
    process, which no move can end. `reply` answers every question and
    `terminal` says whether there is one to ask at. Returns what happened:
    the exit, the questions, the plans made, the pids ended, the output, what
    each conversation comes back as, OLDCREW's roster state and the names
    NEWCREW's roster lists.
    """
    old, new = "OLDCREW", "NEWCREW"
    lead_conv = "1ead5555-0000-4000-8000-000000000005"
    runner_pid = 4309401
    with _roster_test_fixture() as f:
        eng = f.engine
        f.config(old, {"name": old, "createdAt": start - 7_200_000,
                       "leadAgentId": agent_id_of("team-lead", old),
                       "members": [{"name": name, "agentId": agent_id_of(name, old)}
                                   for name in ("team-lead", "runner", "sitter", "keeper")]})
        f.config(new, {"name": new, "createdAt": start - 7_200_000,
                       "leadAgentId": agent_id_of("team-lead", new), "leadSessionId": lead_conv,
                       "members": [{"name": "team-lead",
                                    "agentId": agent_id_of("team-lead", new)}]})
        operating_conversation(f, start, lead_conv)
        paths = {name: operating_conversation(f, start, f"{name}-conv", name, old)
                 for name in ("runner", "sitter", "keeper")}
        f.fake.processes[:] = [
            (runner_pid, 1, (FAKE_AGENT_BIN, "--resume", "runner-conv",
                             "--agent-id", agent_id_of("runner", old)))]
        if held_here:
            f.fake.processes.append(
                (os.getpid(), os.getppid(), (FAKE_AGENT_BIN, "--resume", "keeper-conv",
                                             "--agent-id", agent_id_of("keeper", old))))
        f.fake.started[runner_pid] = start
        f.fake.next_pid = 4309500
        ended, prompts, plans, out = [], [], [], io.StringIO()

        def end_it(target):
            """Stop a process of the synthetic world; nothing real is signalled."""
            pid = target["process"]["pid"]
            ended.append(pid)
            f.fake.processes[:] = [row for row in f.fake.processes if row[0] != pid]
            return True, ""

        def watched(socket, *args):
            """A spawn that works starts its agent and writes its transcript."""
            res = f.fake(socket, *args)
            if (args and args[0] in ("split-window", "new-window", "new-session")
                    and res.returncode == 0):
                pane = res.stdout.strip()
                pid = next(row["pid"] for row in f.fake.panes if row["pane"] == pane)
                worn = re.search(r"--agent-id (\S+)", " ".join(args))
                f.fake.processes.append((pid, 1, (FAKE_AGENT_BIN, "--resume", "x",
                                                  "--agent-id", worn.group(1).strip("'"))))
                for jsonl in eng._projects_dir.rglob("*.jsonl"):
                    jsonl.touch()
            return res

        real_stopped, real_stdin = globals()["stopped"], sys.stdin
        real_input, real_plan = globals().get("input"), eng.team_run_plan

        def observed(*args, **kwargs):
            plans.append(real_plan(*args, **kwargs))
            return plans[-1]

        try:
            globals()["stopped"] = end_it
            sys.stdin = types.SimpleNamespace(isatty=lambda: terminal)
            globals()["input"] = lambda prompt="": (prompts.append(prompt), reply)[1]
            eng.team_run_plan = observed
            with f.fake.installed(eng, through=watched):
                try:
                    with capturing("out", into=out), capturing("err", into=out):
                        code = run_team(build_parser().parse_args(
                            ["--team", old, "--into-team", new, "--no-lead", "--all",
                             "--no-attach", *extra]), [])
                except Refusal:
                    code = "refused"
            eng.refresh_transcript_evidence()
            census = eng._roster_census()
            restored = {name: fact["team"] if fact["state"] == "restored" else None
                        for name, path in paths.items()
                        for fact in (eng._restore_fact(path, census),)}
            old_state = eng._roster_snapshot(old, census).state
            new_roster = eng._roster_snapshot(new, census).data
        finally:
            globals()["stopped"], sys.stdin = real_stopped, real_stdin
            eng.team_run_plan = real_plan
            if real_input is not None:
                globals()["input"] = real_input
            else:
                globals().pop("input", None)
    return types.SimpleNamespace(
        code=code, prompts=prompts, plans=len(plans), ended=ended, runner=runner_pid,
        told=" ".join(without_wrap_arrows(out.getvalue()).split()),
        restored=restored, old_state=old_state,
        new_names={member.get("name") for member in new_roster.get("members", ())})


def explicit_move(start):
    """`--team OLDCREW --into-team NEWCREW` decides once and moves every member.

    With runner running and sitter and keeper stopped, the run asks one
    question, runner's kill, and moves all three to NEWCREW without rebuilding
    OLDCREW. With keeper's conversation held by this process, which no move
    can end, the decision refuses the whole move before anything changes,
    with --force or without. Returns (ok, detail) for the check.
    """
    old = "OLDCREW"
    faults = []
    moved = team_move_run(start)
    if not (moved.code == 0 and moved.plans == 1 and len(moved.prompts) == 1
            and f"kill pid {moved.runner}" in moved.prompts[0] and moved.ended == [moved.runner]
            and all(f"{name} launched" in moved.told for name in ("runner", "sitter", "keeper"))
            and "rebuil" not in moved.told and moved.old_state == "absent"
            and moved.restored == {"runner": None, "sitter": None, "keeper": None}
            and {"runner", "sitter", "keeper"} <= moved.new_names):
        faults.append(f"moving: code {moved.code}, plans {moved.plans}, prompts {moved.prompts}, "
                      f"ended {moved.ended}, OLDCREW {moved.old_state}, come back as "
                      f"{moved.restored}, NEWCREW lists {sorted(moved.new_names)}, "
                      f"said {moved.told[-700:]}")
    for label, extra in (("held here", ()), ("held here with --force", ("--force",))):
        held = team_move_run(start, held_here=True, extra=extra)
        if not (held.code == "refused" and held.plans == 1 and not held.prompts
                and not held.ended and "launched" not in held.told
                and f"you are running {agent_id_of('keeper', old)}'s conversation yourself"
                in held.told
                and held.old_state == "valid" and held.new_names == {"team-lead"}
                and set(held.restored.values()) == {old}):
            faults.append(f"{label}: code {held.code}, plans {held.plans}, prompts "
                          f"{held.prompts}, ended {held.ended}, OLDCREW {held.old_state}, "
                          f"NEWCREW lists {sorted(held.new_names)}, said {held.told[-500:]}")
    return not faults, "; ".join(faults)


def stops_settled_first(start):
    """A team move ends its running members first and retires its team last.

    runner's process is ended before OLDCREW is retired. Answering N to its
    kill question, or running with nothing to ask at and no --yes, refuses the
    whole move with nothing ended, retired or started. Returns (ok, detail).
    """
    old = "OLDCREW"
    faults = []
    moved = team_move_run(start)
    killed, reaped = moved.told.find("killing pid"), moved.told.find(f"reaped {old} ")
    if not (moved.code == 0 and moved.ended == [moved.runner] and -1 < killed < reaped):
        faults.append(f"agreed: code {moved.code}, ended {moved.ended}, killing at {killed}, "
                      f"reaped at {reaped}, said {moved.told[-500:]}")
    for label, run, said in (
            ("declined", team_move_run(start, reply="n"), "left alone"),
            ("no terminal", team_move_run(start, terminal=False), "nothing here can ask")):
        if not (run.code == "refused" and not run.ended and said in run.told
                and "nothing was stopped, retired or started" in run.told
                and "--yes" in run.told and "launched" not in run.told
                and run.old_state == "valid" and run.new_names == {"team-lead"}):
            faults.append(f"{label}: code {run.code}, prompts {run.prompts}, ended {run.ended}, "
                          f"OLDCREW {run.old_state}, NEWCREW lists {sorted(run.new_names)}, "
                          f"said {run.told[-500:]}")
    return not faults, "; ".join(faults)


