def mutable_nodes(value, path="answer", seen=None):
    """Find mutable containers and dataclass contents without looping over cycles."""
    seen = set() if seen is None else seen
    if id(value) in seen:
        return []
    seen.add(id(value))
    faults = []
    if dataclasses.is_dataclass(value) and not isinstance(value, type):
        if not value.__dataclass_params__.frozen:
            faults.append(path)
        for field in dataclasses.fields(value):
            faults.extend(mutable_nodes(getattr(value, field.name), f"{path}.{field.name}", seen))
    elif isinstance(value, Mapping):
        if not isinstance(value, types.MappingProxyType):
            faults.append(path)
        for key, child in value.items():
            faults.extend(mutable_nodes(key, f"{path}.key", seen))
            faults.extend(mutable_nodes(child, f"{path}[{key!r}]", seen))
    elif isinstance(value, (list, set, bytearray)):
        faults.append(path)
    elif isinstance(value, (tuple, frozenset)):
        for index, child in enumerate(value):
            faults.extend(mutable_nodes(child, f"{path}[{index}]", seen))
    return faults


