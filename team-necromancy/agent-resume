    with capturing("err"):
        return f.engine.rebuild_plan(team=team, table=(), census=f.engine._roster_census(), now_ms=5000)


@unit(
    ('rebuild-completion-checks-each-effect', 'completion rejects each corrupted applied fact with all other facts valid'),
    ('rebuild-completion-never-rereads', 'completion accepts retained effects with filesystem reads and serialization blocked'),
    ('rebuild-consumes-selected-bytes', 'rebuild installs the selected whitespace and returns the selected census record'),
    ('writers-report-descriptor-mode', 'exclusive and replacement writers report actual descriptor permissions'),
    ('rebuild-rejects-observed-mode-mismatch', 'an observed mode mismatch reaches effects and refuses completion'),
    ('roster-mode-zero-is-preserved', 'mode zero survives selection, writing, retained replacement and completion'),
)
def _check_selected_rebuild_effects(s):
    from unittest import mock
    checked, faults, mode_faults = [], [], []

    def check(cid, ok, detail=""):
        for at, (previous_id, name, previous_ok, previous_detail) in enumerate(checked):
            if previous_id == cid:
                checked[at] = _check_verdict(cid, previous_ok and bool(ok), previous_detail + "; " + detail)
                return
        checked.append(_check_verdict(cid, bool(ok), detail))

    def forbidden(*_args, **_kwargs):
        raise AssertionError("completion reread or serialized selected evidence")

    def complete_without_reads(eng, launch, applied):
        with contextlib.ExitStack() as patches:
            for owner, names in ((Path, ("open", "stat", "read_bytes", "read_text", "iterdir")),
                                 (os, ("open", "stat", "fstat")),
                                 (eng, ("_file_observation", "_roster_snapshot", "_runtime")),
                                 (json, ("dumps",))):
                for name in names:
                    patches.enter_context(mock.patch.object(owner, name, forbidden))
            return eng.rebuild_plan(launch, applied=applied)

    for invalid in (False, True):
        with _roster_test_fixture() as f:
            eng = f.engine
            plan = _rebuild_test_plan(f, invalid)
            # This is valid JSON but intentionally not the selector's default layout.
            alternate = (" \n" + fixture_line(json_value(plan["config"])) + "\n ").encode()
            write = immutable({**plan["write"], "bytes": alternate})
            plan = immutable({**plan, "write": write})
            seen = {}
            real_complete = eng.rebuild_plan

            def capture(launch, applied=None, **kwargs):
                seen["applied"] = applied
                return real_complete(launch, applied=applied, **kwargs)

            try:
                with mock.patch.object(eng, "rebuild_plan", capture), mock.patch.object(json, "dumps", forbidden):
                    with capturing("out"), capturing("err"):
                        result, config = apply_rebuild_plan(plan, False, assume_yes=True)
            except (AssertionError, Refusal, OSError) as exc:
                check('rebuild-consumes-selected-bytes', False, f"invalid={invalid}: {exc}")
                continue
            applied = seen["applied"]
            completed = complete_without_reads(eng, plan["launch"], applied)
            effects, observed = applied.effects, applied.effects["written"]["observation"]
            selected_result = result["roster"]["destination"]
            okay = (not completed["objections"] and selected_result.data is config
                    and plan["cfg"].read_bytes() == alternate
                    and observed == eng._file_observation(plan["cfg"])
                    and selected_result.observation == observed
                    and any(item is selected_result for item in result["roster"]["census"])
                    and all(item is not selected_result for item in plan["launch"]["roster"]["census"])
                    and {item["action"] for item in effects["inboxes"]} == {"keep", "create", "replace-empty"})
            check('rebuild-consumes-selected-bytes', okay, f"invalid={invalid}")
            check('rebuild-completion-never-rereads', not completed["objections"], f"invalid={invalid}")

            def changed_effect(key, value):
                return dataclasses.replace(applied, effects=immutable({**effects, key: value}))

            def changed_written(**changes):
                return changed_effect("written", immutable({**effects["written"], **changes}))

            def changed_observation(**changes):
                return changed_written(observation=dataclasses.replace(observed, **changes))

            def changed_inbox_selection(at, selection, **effect_changes):
                selection = immutable(selection)
                selected = list(plan['inboxes'])
                selected[at] = selection
                reported = list(effects['inboxes'])
                reported[at] = immutable({**reported[at], 'selection': selection, **effect_changes})
                return dataclasses.replace(applied, plan=immutable({**plan, 'inboxes': tuple(selected)}),
                                           effects=immutable({**effects, 'inboxes': tuple(reported)}))

            other_original = dataclasses.replace(plan['original'])
            corruptions = {
                "operation": dataclasses.replace(applied, operation="member-redirect"),
                "confirmation": dataclasses.replace(applied, confirmation=False),
                "dry": dataclasses.replace(applied, dry_run=True),
                "durable action": dataclasses.replace(applied, durable_action="none"),
                "launch association": dataclasses.replace(applied, plan=immutable({**plan, "launch": {}})),
                "original association": dataclasses.replace(applied,
                    plan=immutable({**plan, 'original': other_original}),
                    effects=immutable({**effects, 'original': other_original})),
                "missing selection": dataclasses.replace(applied, plan=immutable({**plan, "write": None})),
                "missing effects": dataclasses.replace(applied, effects=None),
                "written selection": changed_written(selection=immutable({**write})),
                "written config": changed_written(data={}),
                "selected config": dataclasses.replace(applied, plan=immutable({**plan, "config": {}})),
                "written path": changed_observation(path=observed.path.with_name("wrong.json")),
                "written bytes": changed_observation(generation=(*observed.generation[:4], b'{}')),
                "written mode": changed_observation(mode=observed.mode ^ 0o040),
                "written absence": changed_written(observation=FileObservation(observed.path, ("absent",), None)),
                "written diagnostic": changed_written(observation=FileObservation(
                    observed.path, ("changed-during-read", (1, 2, 3, 4), (1, 2, 3, 5), alternate), 0o600)),
                "written tuple": changed_written(observation=observed.generation),
                "original effect": changed_effect("original", dataclasses.replace(plan["original"])),
                "missing inbox": changed_effect("inboxes", effects["inboxes"][:-1]),
                "duplicate inbox": changed_effect("inboxes", (effects["inboxes"][0],) * len(effects["inboxes"])),
                "malformed inbox collection": dataclasses.replace(applied, plan=immutable({**plan, "inboxes": None})),
            }
            for label, selection in (("non-mapping inbox", None), ("empty inbox selection", {})):
                corruptions[label] = changed_inbox_selection(0, selection)
            bad_action = immutable({'unexpected': True})
            corruptions['unhashable action'] = dataclasses.replace(
                applied, plan=immutable({**plan, 'action': bad_action}), durable_action=bad_action)
            for label, data in (('missing data', None), ('unsupported config leaf', {'members': [b'not JSON']})):
                bad_write = immutable({**write, 'data': data}) if data is not None else immutable({
                    key: value for key, value in write.items() if key != 'data'})
                corruptions[label] = dataclasses.replace(applied,
                    plan=immutable({**plan, 'write': bad_write, 'config': bad_write.get('data')}),
                    effects=immutable({**effects, 'written': {
                        **effects['written'], 'selection': bad_write, 'data': bad_write.get('data')}}))
            cyclic_mapping = {}
            cyclic_mapping['self'] = cyclic_mapping
            cyclic_list = []
            cyclic_list.append(cyclic_list)
            for label, data in (('cyclic config mapping', cyclic_mapping),
                                ('cyclic config list', {'members': cyclic_list})):
                # Keep the malformed input raw so completion, not fixture setup, rejects it.
                bad_write = {**write, 'data': data}
                corruptions[label] = dataclasses.replace(applied,
                    plan={**plan, 'write': bad_write, 'config': data},
                    effects={**effects, 'written': {
                        **effects['written'], 'selection': bad_write, 'data': data}})
            for field in ('path', 'bytes', 'mode'):
                reduced = immutable({key: value for key, value in write.items() if key != field})
                corruptions[f'selected write missing {field}'] = dataclasses.replace(applied,
                    plan=immutable({**plan, 'write': reduced}),
                    effects=immutable({**effects, 'written': {**effects['written'], 'selection': reduced}}))
                if invalid:
                    reduced_backup = immutable({key: value for key, value in plan['backup_write'].items() if key != field})
                    corruptions[f'selected backup missing {field}'] = dataclasses.replace(applied,
                        plan=immutable({**plan, 'backup_write': reduced_backup}),
                        effects=immutable({**effects, 'backup': {**effects['backup'], 'selection': reduced_backup}}))
            positive = [('derived original generation', dataclasses.replace(applied, plan=immutable({
                key: value for key, value in plan.items() if key != 'generation'})))]
            for at, selected in enumerate(plan['inboxes']):
                if 'path' in selected or 'generation' in selected:
                    faults.append(f"{invalid}: inbox {at} duplicates its observation")
                required = ('action', 'observation') + (() if selected['action'] == 'keep' else ('bytes', 'mode'))
                for field in required:
                    reduced = {key: value for key, value in selected.items() if key != field}
                    corruptions[f'inbox {at} missing {field}'] = changed_inbox_selection(at, reduced)
                reduced = {key: value for key, value in selected.items() if key != 'name'}
                if selected['action'] == 'keep':
                    positive.append((f'inbox {at} equal observations', changed_inbox_selection(
                        at, reduced, before=dataclasses.replace(selected['observation']),
                        after=dataclasses.replace(selected['observation']))))
                else:
                    positive.append((f'inbox {at} no diagnostic name', changed_inbox_selection(at, reduced)))
                for action in ('unexpected', 'keep' if selected['action'] != 'keep' else 'create'):
                    corruptions[f'inbox {at} action {action}'] = changed_inbox_selection(
                        at, {**selected, 'action': action}, action=action)
            for label, evidence in positive:
                try:
                    answer = complete_without_reads(eng, plan['launch'], evidence)
                    if (answer['objections'] or answer['written_roster'] is None
                            or answer['original_generation'] != plan['original'].generation):
                        faults.append(f'{invalid}: refused {label}: {answer["objections"]}')
                except (Refusal, AssertionError, AttributeError, KeyError, TypeError, ValueError) as exc:
                    faults.append(f'{invalid}: {label} raised {type(exc).__name__}: {exc}')
            if invalid:
                for field, value in (("path", observed.path), ("mode", 0o600),
                                     ("generation", (*effects["backup"]["observation"].generation[:4], b'wrong'))):
                    corruptions[f"backup {field}"] = changed_effect("backup", immutable({
                        **effects["backup"], "observation": dataclasses.replace(effects["backup"]["observation"], **{field: value})}))
                corruptions["backup association"] = changed_effect("backup", immutable({**effects["backup"], "selection": write}))
                corruptions["missing backup"] = changed_effect("backup", None)
