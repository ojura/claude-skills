        while time.time() < deadline:
            table = eng.process_table(refresh=True)
            if any(f"--agent-id {agent_id}" in args for _pid, _ppid, args in table):
                break
            time.sleep(0.05)
        agent = eng.agent_runtime(agent_id, table)
        holders = eng.runtime(table)["transcripts"].get(session, {"others": [], "ours": []})
        holder = holders["others"][0] if holders["others"] else None
        live_facts = {
