                   and spawn_lookups == [requested])

        refused = False
        with capturing("err"):
            try:
                build_command(ctx, emit, ["--agent-name", "other"])
            except Refusal:
                refused = True
    finally:
        globals()["RESOLVER"] = real_resolver
        scratch.cleanup()

    check("forced-identity-is-one-value",
          "--force uses the requested identity in validation, command, roster, report, and role",
          not wrong, ", ".join(wrong))
    check("identity-passthrough-cannot-diverge",
          "a passthrough flag cannot replace identity after resolution", refused)
    check("assigned-identity-excludes-other-roster-facts",
          "an assigned identity does not inherit another roster member's launch fields",
          coupled, f"fields={foreign_launch_facts!r}, spawn lookups={spawn_lookups!r}")

