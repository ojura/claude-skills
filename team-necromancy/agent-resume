                                      for name in ("team-lead", "m1", "m2")]})
        f.config(dest, {"name": dest, "createdAt": start + 100, "leadSessionId": lead_conv,
                        "members": [{"name": "team-lead", "agentId": f"team-lead@{dest}"}]})
        operating_conversation(f, start, lead_conv, spawns=((source, -3_600_000),))
        for name in ("m1", "m2"):
            operating_conversation(f, start, f"{name}-conv", name, source)
        f.fake.processes[:] = [(4309301, 1, (FAKE_AGENT_BIN, "--resume", lead_conv))]
        f.fake.started[4309301] = start
        f.fake.registry = [{"pid": 4309301, "sessionId": lead_conv, "startedAt": start + 400,
                            "updatedAt": start + 400, "procStart": "1"}]
        f.engine._pid_alive = lambda _pid, procstart=None: True
        code, told, prompts, plans, events = team_run(f, source)
        decision = plans[0]["redirect"] if plans else None
    asked_once = (
        code == 0 and len(plans) == 1 and decision["action"] == "redirect"
        and decision["confirmation"] == "pending"
        and len(prompts) == 1 and "[Y/n]" in prompts[0]
        and told.count(f"would reap {source}") == 1
        and told.count("launched") >= 2 and "refused" not in told
        and decided_first(events) and events.count("retire") == 1)
    detail = (f"code {code}, plans {len(plans)}, prompts {prompts}, in order {events}, "
              f"said {told[-700:]}")

    # A running member still wears the crew's team, so it cannot be retired:
    # the run asks once whether to start the stopped one where its lead does
    # not read its mail, and reaps nothing.
    lead_conv, dest, source = ("1ead4444-0000-4000-8000-000000000004",
                               "DESTTWO", "BLOCKTEAM")
    with _roster_test_fixture() as f:
        f.config(source, {"name": source, "createdAt": start - 7_200_000,
                          "leadSessionId": lead_conv,
                          "members": [{"name": name, "agentId": f"{name}@{source}"}
                                      for name in ("team-lead", "m5", "m6")]})
        f.config(dest, {"name": dest, "createdAt": start - 7_200_000,
                        "leadSessionId": lead_conv,
                        "members": [{"name": "team-lead", "agentId": f"team-lead@{dest}"}]})
        operating_conversation(f, start, lead_conv,
                               spawns=((source, -3_600_000), (dest, 5_000)))
        for name in ("m5", "m6"):
