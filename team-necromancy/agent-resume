@unit(('every-flag-declares-a-menu-row', 'every offered flag says what the menu row is'))
def _check_every_flag_declares_a_menu_row(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    src_of = s.src_of

    comp_path = Path(__file__).resolve().parent / f"_{TOOL}"
    comp_text = comp_path.read_text() if comp_path.exists() else ""
    # Read out of the tree rather than by regex over the source text. The flags
    # are declared on argument groups, so the receiver differs from call to
    # call, and a regex that matched add_argument( wherever it appeared would
    # still find them but could not say which group each went to. One walk
    # answers both questions, so the grouping check below is not a second
    # scrape that can drift away from this one.
    # main is where the ladder lives and where the engine is constructed, which
    # a check further down reads; the flags moved out to build_parser.
    main_src = src_of(funcs["main"]) or ""
    declared = []          # (option strings of one call, the object it was called on)
    hidden = set()         # the first long spelling of each help=SUPPRESS flag
    for node in ast.walk(funcs["build_parser"]):
        if not (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                and node.func.attr == "add_argument"):
            continue
        opts = [a.value for a in node.args
                if isinstance(a, ast.Constant) and str(a.value).startswith("-")]
        if opts:
            declared.append((opts, getattr(node.func.value, "id", "?")))
            # A suppressed flag is one the parser takes and the menu does not
            # offer, so the parity check below has to know which ones those are
            # or every one of them reads as a flag the emitter forgot. Read
            # here, off the same call the option strings come from, rather than
            # kept as a list of names that a later flag would have to be added
            # to by hand.
            if any(kw.arg == "help" and isinstance(kw.value, ast.Attribute)
                   and kw.value.attr == "SUPPRESS" for kw in node.keywords):
                hidden.add(next((o for o in opts if o.startswith("--")), opts[0]))

    # Every flag says which line the menu gives it, even when that is the help
    # page's own sentence, which AS_HELP is how an author says. Defaulting to
    # the help would mean a flag added later put whatever its help page says
    # into the menu because nobody chose, and nobody would find out from a
    # listing that had quietly grown a paragraph in it.
    rowless = sorted(
        opt for action in build_parser()._actions
        for opt in [next((o for o in action.option_strings if o.startswith("--")), None)]
        if opt and action.help is not argparse.SUPPRESS
        and getattr(action, "menu_row", None) is None)
    check("every-flag-declares-a-menu-row", "every offered flag says what the menu row is",
          not rowless, ", ".join(rowless) or f"{len(declared)} declaration(s) carry one")

    s.comp_path = comp_path
    s.comp_text = comp_text
    s.declared = declared
    s.hidden = hidden
    s.main_src = main_src
    return checked


@unit(('completion-flags-are-parseable', 'the flags topic emits four fields a shell can split, one per flag the parser takes'))
def _check_completion_flags_are_parseable(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    declared = s.declared
    hidden = s.hidden

    emitted = io.StringIO()
    with capturing("out", into=emitted):
        run_complete("flags")
    flag_lines = [line for line in emitted.getvalue().splitlines() if line]
    malformed = [line.split("\t")[0] for line in flag_lines
                 if len(line.split("\t")) != 4 or not line.startswith("--")
                 or not line.split("\t")[1].strip()]
    offered = {line.split("\t")[0] for line in flag_lines}
    # The parser's own answer to "which flags would you take", computed the way
    # the emitter is supposed to: first long spelling, nothing suppressed.
    takes = {opt for opts, _on in declared
             for opt in [next((o for o in opts if o.startswith("--")), None)]
             if opt} - hidden
    wrong = sorted(offered ^ takes)
    check("completion-flags-are-parseable",
          "the flags topic emits four fields a shell can split, one per flag the parser takes",
          bool(flag_lines) and not malformed and not wrong,
          f"malformed: {malformed[:3]}; offered but not taken or the other way: {wrong[:5]}"
          if (malformed or wrong) else f"{len(flag_lines)} flags")

    s.offered = offered
    return checked


