@unit(('side-selector-names-the-task-id', 'a file name typed at a side transcript is told the task id to use'), ('promote-says-which-half-is-missing', 'a promote missing the team half says so, and keeps the name it has'))
def _check_side_selector_names_the_task_id(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    _Args = s._Args
    _dies = s._dies

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "proj" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        (sub / "agent-t9.jsonl").write_text(json.dumps(
            {"type": "user", "parentUuid": None, "isSidechain": True,
             "uuid": "t9-root"}) + "\n")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir = Path(td)
        stem_hit, stem_why = eng._side_transcript("agent-t9")
        file_hit, file_why = eng._side_transcript("agent-t9.jsonl")
        gone_hit, gone_why = eng._side_transcript("agent-nothing")
        # The bare id, not the one inside 'agent-t9': a refusal that only echoes
        # what was typed has named nothing, and quoting the selector back would
        # satisfy a plain substring test.

        def bare(why):
            return bool(re.search(r"(?<![\w.-])t9(?![\w.-])", why))
        spelled = {
            "the file's stem is refused": stem_hit is None,
            "and the stem's refusal names the task id": bare(stem_why),
            "the whole file name is refused": file_hit is None,
            "and that refusal names the task id too": bare(file_why),
            "the task id itself still resolves": (eng._side_transcript("t9")[0] or {})
                .get("task_id") == "t9",
            "a real miss keeps the plain refusal": gone_hit is None
                and gone_why == "no side transcript matches 'agent-nothing'",
        }
        wrong = sorted(k for k, ok in spelled.items() if not ok)
        check("side-selector-names-the-task-id",
              "a file name typed at a side transcript is told the task id to use",
              not wrong, ", ".join(wrong))

        # --as-agent settles the name before the team is looked at, so the team
        # is the only half that can be missing here. Printing "name@team" whole would read as
        # both halves missing, and a caller who typed a name would retype it.
        def flat(text):
            return " ".join(text.split())
        real_resolver = globals()["RESOLVER"]
        globals()["RESOLVER"] = eng
        try:
            typed_died, typed_msg = _dies(
                run_promote, _Args(promote="t9", as_="revived", force=False))
            bare_died, bare_msg = _dies(
                run_promote, _Args(promote="t9", as_=None, force=False))
        finally:
            globals()["RESOLVER"] = real_resolver
        halves = {
            "a name with no team is refused": typed_died,
            "and the refusal says the team is the missing half":
                "gives a name and no team" in flat(typed_msg),
            "and hands the typed name back": "--as-agent revived@<team>" in flat(typed_msg),
            "no --as-agent at all is refused": bare_died,
            "and that refusal names the name it would have taken":
                "--as-agent t9@<team>" in flat(bare_msg),
        }
        wrong = sorted(k for k, ok in halves.items() if not ok)
        check("promote-says-which-half-is-missing",
              "a promote missing the team half says so, and keeps the name it has",
              not wrong, ", ".join(wrong))

    s.eng = eng
    s.flat = flat
    return checked


