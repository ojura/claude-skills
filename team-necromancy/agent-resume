    ('completion-topics-declare-specific-needs',
     'every completion topic declares only its own corpus work'),
    ('completion-topic-has-one-parser',
     'completion emission and NEED declarations share one topic parser'),
)
def _check_completion_conversion_census_boundary(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    callers_of = s.callers_of
    real_resolver = globals()["RESOLVER"]
    try:
        with tempfile.TemporaryDirectory() as td:
            projects = Path(td) / "projects"
            main_dir = projects / "project"
            main_dir.mkdir(parents=True)
            for index in range(12):
                (main_dir / f"plain-{index}.jsonl").write_text("{}\n")
            carrier = main_dir / "carrier.jsonl"
            receipt = fixture_receipt(
                name="member", team="TEAM", parent="PARENT",
                dest_stem="carrier", task_id="task", root="root")
            carrier.write_text(TranscriptRewriter._receipt_line(receipt) + "\n")
            side = main_dir / "PARENT" / "subagents" / "agent-side.jsonl"
            side.parent.mkdir(parents=True)
            side.write_text(TranscriptRewriter._receipt_line(receipt) + "\n")

            denied = Resolver(needs=Needs())
            denied.projects_dir = projects
            try:
                denied.carried_receipts()
                refusal = ""
            except RuntimeError as err:
                refusal = str(err)
            targeted = TranscriptRewriter.receipt_in_file(carrier)
            boundary_ok = ("NEED.CONVERSION_CENSUS" in refusal
                           and (targeted or {}).get("name") == "member")
            check('conversion-census-requires-need',
                  'the full conversion receipt census refuses unless its NEED is declared',
                  boundary_ok, refusal or repr(targeted))

            narrowed = Resolver(needs=Needs(hard={NEED.CONVERSION_CENSUS}))
            narrowed.projects_dir = projects
            parsed = []
            original = narrowed.rewriter.receipt_in_file
            narrowed.rewriter.receipt_in_file = lambda path: parsed.append(Path(path)) or original(path)
            found = narrowed.carried_receipts()
            narrowed_ok = set(parsed) == {carrier} and set(found) == {carrier}

            fallback = Resolver(needs=Needs(hard={NEED.CONVERSION_CENSUS}))
            fallback.projects_dir = projects
            fallback._grep_files = lambda *args: None
            fallback_parsed = []
            fallback_original = fallback.rewriter.receipt_in_file
            fallback.rewriter.receipt_in_file = lambda path: (
                fallback_parsed.append(Path(path)) or fallback_original(path))
            fallback_found = fallback.carried_receipts()
            main_files = set(main_dir.glob("*.jsonl"))
            fallback_ok = (set(fallback_parsed) == main_files
                           and set(fallback_found) == {carrier} and side not in fallback_parsed)
            check('conversion-census-narrows-before-parsing',
                  'the conversion census parses only literal-search candidates, with a full-scan failure fallback',
                  narrowed_ok and fallback_ok,
                  f"narrow parsed={len(parsed)}, fallback parsed={len(fallback_parsed)}")

            canonical = Resolver(needs=Needs(hard={NEED.CONVERSION_CENSUS}))
            canonical.projects_dir = projects
            canonical_parsed = []
            canonical_original = canonical.rewriter.receipt_in_file
            canonical.rewriter.receipt_in_file = lambda path: (
                canonical_parsed.append(Path(path)) or canonical_original(path))
            direct = canonical.receipt_carried_by(carrier)
            census_receipt = canonical.carried_receipts().get(carrier)
            canonical.receipt_carried_by(carrier)
            check('conversion-receipt-is-one-canonical-object',
                  'a path lookup and the conversion census share one parsed receipt object',
                  direct is census_receipt and canonical_parsed == [carrier],
                  f"same={direct is census_receipt}, parsed={canonical_parsed!r}")

        selector = completion_needs("selector")
        topics = ("flags", "sockets", "sessions", "sides", "agent-ids", "names",
                  "teams", "leads", "selector", "as-agent-name:x", "as-agent:x",
                  "into-session:x")
        specific = (all(isinstance(completion_needs(topic), Needs) for topic in topics)
                    and completion_needs("into-session:x")[NEED.CONVERSION_CENSUS]
                        is DECLARED.MAYBE)

        eng = s.corpus_engine()
        eng.needs = selector
        eng.exercised = set()
        receipt_reads = []
        eng.rewriter.receipt_in_file = lambda path: receipt_reads.append(Path(path)) or None
        globals()["RESOLVER"] = eng
        with capturing("out"), capturing("err"):
            run_complete("selector")
        eng.audit_needs()
        check('selector-completion-declares-action-ownership',
              'selector completion declares receipt evidence needed to exclude copied parent actions',
              selector[NEED.CONVERSION_CENSUS] is DECLARED.MAYBE and bool(receipt_reads),
              f"receipt reads={len(receipt_reads)}, exercised={sorted(n.name for n in eng.exercised)}")
        check('completion-topics-declare-specific-needs',
              'every completion topic declares only its own corpus work',
              specific, repr(selector))

        duplicate_parsers = []
        for fn in s.ast.walk(s.tree):
            if not isinstance(fn, s.ast.FunctionDef) or fn.lineno in s.selftest_lines:
                continue
            for node in s.ast.walk(fn):
                if (isinstance(node, s.ast.Call)
                        and isinstance(node.func, s.ast.Attribute)
                        and node.func.attr == "partition"
                        and isinstance(node.func.value, s.ast.Name)
                        and node.func.value.id == "topic"
                        and len(node.args) == 1
                        and isinstance(node.args[0], s.ast.Constant)
                        and node.args[0].value == ":"
                        and fn.name != "completion_request"):
                    duplicate_parsers.append(f"{fn.name}:{node.lineno}")
        parser_users = callers_of("completion_request") - s.suite_fns
        check('completion-topic-has-one-parser',
              'completion emission and NEED declarations share one topic parser',
              parser_users == {"_complete", "completion_needs"}
              and not duplicate_parsers,
              f"users={sorted(parser_users)}, duplicates={duplicate_parsers}")
    finally:
        globals()["RESOLVER"] = real_resolver
    return checked


