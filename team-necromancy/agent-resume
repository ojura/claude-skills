            """(what a --doctor printed, its exit code)."""
            done = subprocess.run(
                [sys.executable, str(Path(__file__).resolve()), "--doctor", *argv],
                capture_output=True, text=True, timeout=180, stdin=subprocess.DEVNULL,
                env={**os.environ, "CLAUDE_CONFIG_DIR": str(doc_home), "COLUMNS": "100"})
            return done.stdout + done.stderr, done.returncode

        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir, eng.teams_dir = doc_home / "projects", doc_home / "teams"
        expected = eng.name_rosters("team-lead")

        swept, _swept_code = doctor_says()
        named, named_code = doctor_says("session-corpus-alpha")
        ambiguous, ambiguous_code = doctor_says("team-lead")
        typo, typo_code = doctor_says("nosuchteam")
        stranger, stranger_code = doctor_says("00000000-0000-4000-8000-000000000000")

        for label, said, code in (("a typo", typo, typo_code),
                                  ("a uuid nothing holds", stranger, stranger_code)):
            flat = " ".join(said.split())
            if "Traceback" in said:
                faults[label] = f"crashed: {flat[-90:]}"
            elif code == 0:
                faults[label] = f"was answered rather than refused: {flat[:90]}"
            elif any(verdict in said for verdict in
                     ("DEGRADED", "SEVERED", "CONNECTED", "UNKNOWABLE")):
                faults[label] = f"widened into a diagnosis: {flat[:90]}"
        if "nosuchteam" not in typo:
            faults["a typo"] = f"does not name what was typed: {' '.join(typo.split())[:90]}"

        expected_ids = {agent_id_of("team-lead", team) for team in expected}
        if (ambiguous_code == 0
                or any(verdict in ambiguous for verdict, _meaning in DOCTOR_LEGEND)
                or not expected_ids <= set(re.findall(r"team-lead@[^\s]+", ambiguous))):
            faults["an ambiguous name"] = (
                f"code {ambiguous_code}, expected {sorted(expected_ids)}, "
                f"said {' '.join(ambiguous.split())[:120]}")
        if named_code != 0 or "session-corpus-alpha" not in named:
            faults["a real team"] = f"did not answer: {' '.join(named.split())[:90]}"
        if not any(v in swept for v in
                   ("CONNECTED", "DEGRADED", "SEVERED", "UNKNOWABLE")):
            faults["an empty hand"] = f"examined nothing: {' '.join(swept.split())[:90]}"
    finally:
        shutil.rmtree(doc_home, ignore_errors=True)
    check("doctor-ambiguous-name-uses-selector-refusal",
          "the doctor refuses an ambiguous bare name with the main selector candidates",
          not faults, "; ".join(f"{k}: {v}" for k, v in sorted(faults.items())))
    classify_callers = s.callers_of("classify")
    doctor_branch = s.main_src.split("if args.doctor:", 1)[1].split(
        "if args.census:", 1)[0]
    check("doctor-uses-main-selector",
          "the doctor consumes fields resolved by the main selector interpreter",
          "apply_selector(selector, args, table)" in doctor_branch
          and not ({"doctor_subject", "run_doctor"} & classify_callers),
          f"classify callers={sorted(classify_callers)}")
    return checked


