       "a worker still running at its bound is ended with its process group, what it started "
       "there included"),
      ("terminated-run-ends-what-it-started",
       "a run sent SIGTERM ends what it started, a driver and its terminal child included, "
       "before it exits"),
      ("run-ends-only-what-it-started",
       "a run ends only processes under it that started after it, and never pid 1, itself, "
       "an ancestor of it or a systemd process"),
      ("own-session-processes-end-with-their-run",
       "a copy run and its child, a wrapper and its agent, and a stray outside the run's "
       "lineage, each started in a session of its own as the suite starts them, are gone once "
       "their run is sent SIGTERM, the stray ended by the pid and life line the run kept; "
       "the run exits 143 and names on its diagnostic stream what it ended; and it adopts "
       "again after making the stray and after a raise inside the block that stops it "
       "adopting"),
      live=True, rooms=True)
def _check_shares_cleanup_owner(s):
    """run_shares, owned_group and collected ending what they own, on processes started here.

    Each driver stand-in and worker is this check's own process, and each is
    confirmed running, by pid and start time, before the failure it is put
    through: a process that had already ended would pass for one that was
    ended. Whatever is still running at the end is ended here, by identity.

    Identities are read as the cleanup under test reads them, through
    _ProcessFence's readers, which read only processes under this run. Most
    of these processes are started by fixture runs rather than by this
    process. One that has gone usually stays a zombie under this run, which
    is a subreaper and reaps none it adopts, so it is found there and read as
    gone. One that another process reaped reads as gone without being read,
    and one that left this run's tree and still runs is refused and written
    down, which fails the tier's refusal row, instead of passing for gone.
    """
    import signal
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # Each room is made the way _live_in_parallel makes its own, so its
    # workers' socket paths have the same room; base holds what the workers
    # report and what no run owns.
    base = Path(tempfile.mkdtemp(prefix=own("rc")))
    rooms = [Path(tempfile.mkdtemp(prefix="w")) for _room in range(3)]
    owned = []

    def identity(pid):
        born = _ProcessFence.start_time(pid)
        owned.append((pid, born))
        return pid, born

    def alive(ids):
        return [_ProcessFence.running(pid, born) for pid, born in ids]

    def waited(ready, seconds=60):
        deadline = time.monotonic() + seconds
        while not ready() and time.monotonic() < deadline:
            time.sleep(0.02)
        return ready()

    try:
        # A start that fails after one start succeeded: the first worker has
        # made its own directory before the second start raises.
        room = rooms[0]
        (room / "unrelated").write_text("not the run's")
        (base / "beside").write_text("not the run's")
        firsts = []

        def start_once(argv, **kwargs):
            if firsts:
                waited(lambda: any((room / "0").iterdir()))
                raise OSError("the second worker could not start")
            process = subprocess.Popen(
                [sys.executable, "-c", "import tempfile, time; tempfile.mkdtemp(prefix='s'); "
                 "time.sleep(300)"], **kwargs)
            firsts.append((process, identity(process.pid)))
            return process

        try:
            run_shares([["first"], ["second"]], room, start=start_once)
            raised = None
        except OSError as failure:
            raised = str(failure)
        first, first_id = firsts[0] if firsts else (None, (0, ""))
        partial = {
            "the failed start is raised": raised == "the second worker could not start",
            "the worker started before it is reaped":
                first is not None and first.returncode is not None,
            "it is no longer running": alive([first_id]) == [False],
            "both workers' directories are removed":
                not (room / "0").exists() and not (room / "1").exists(),
            "what the run does not own is left":
                (room / "unrelated").read_text() == "not the run's"
                and (base / "beside").read_text() == "not the run's",
        }
        wrong = sorted(claim for claim, ok in partial.items() if not ok)
        check("worker-start-failure-is-cleaned-up",
              "when the second worker of a split run fails to start, the run ends and reaps the "
              "first, removes both directories and leaves what it does not own",
              not wrong, ", ".join(wrong))

        # Two workers, split by a run of its own: one dies without its cleanup
        # after starting a driver, the other cleans up after itself once the
        # first has made its files. The dead worker's driver is adopted by the
        # run, which ends it as it finishes. -B, because the run and the
        # worker load the tool as a module.
        room = rooms[1]
        told = base / "dying-worker-run"
        tool = str(Path(__file__).resolve())
        dying_run = subprocess.Popen([sys.executable, "-B", "-c", DYING_WORKER_RUN_FIXTURE, tool,
                                      PTY_DRIVER_FIXTURE, str(room), str(told)],
                                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.PIPE, text=True)
        identity(dying_run.pid)
        try:
            _out, dying_err = dying_run.communicate(timeout=120)
        except subprocess.TimeoutExpired:
            dying_run.kill()
            _out, dying_err = dying_run.communicate()
        try:
            seen = json.loads(told.read_text())
        except (OSError, ValueError):
            seen = {}
        seen_ids = [tuple(pair) for pair in seen.get("ids", [])]
        owned.extend(seen_ids)
        codes = seen.get("codes", [])
        made = Path(seen["made"]) if seen.get("made") else None
        killed = {
            "the worker exited without its cleanup": codes[:1] == [3],
            "the other worker finished": codes[1:] == [0],
            "its directory was there when the workers had ended": seen.get("made then") is True,
            "the other worker's own cleanup left it alone and removed only its own":
                seen.get("other's own then") == [],
            "the parent removed it": made is not None and not made.exists(),
            "the room holds nothing after": sorted(entry.name for entry in room.iterdir()) == [],
        }
        wrong = sorted(claim for claim, ok in killed.items() if not ok)
        check("worker-killed-mid-run-is-cleaned-up",
              "a worker that exits without its own cleanup leaves its directory to the parent, "
              "which removes it while the other worker's own cleanup left it alone",
              not wrong, ", ".join(wrong) + (f"; run exit {dying_run.returncode}, saw {seen}, "
                                             f"stderr {dying_err.strip()[-300:]!r}"
                                             if wrong else ""))

        # The driver stand-in under each way its owner can leave the block. A
        # dead worker's driver is ended by the run it was adopted by.
        dead_ended = sorted(pid for pid, _born in seen_ids if pid
                            and pid in seen.get("finished", {}).get("ended", []))
        ended = {"a worker's death": (seen.get("running then") == [True, True],
                                      len(seen_ids) == 2 and len(dead_ended) == 2
                                      and alive(seen_ids) == [False, False])}

        def driver(name):
            process = subprocess.Popen([sys.executable, "-c", PTY_DRIVER_FIXTURE,
                                        str(base / f"child-{name}")],
                                       start_new_session=True, stdin=subprocess.DEVNULL,
                                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            return process

        def running(process, name):
            child_file = base / f"child-{name}"
            waited(child_file.exists)
            child = int(child_file.read_text()) if child_file.exists() else 0
            ids = [identity(process.pid), identity(child)]
            return ids, alive(ids) == [True, True]

        process = driver("normal")
        with owned_group(process):
            ids, was = running(process, "normal")
        ended["a normal return"] = (was, alive(ids) == [False, False])
        process.wait()

        process = driver("timeout")
        with owned_group(process) as stop:
            ids, was = running(process, "timeout")
            stopped = collected(process, 0.2, stop)
            # Ended by the wait's own stop, before the block's exit could.
            ended["a timeout"] = (was and stopped.returncode is None,
                                  alive(ids) == [False, False])

        class Interrupting:
            """The driver, waited on by a caller interrupted while it waits."""

            def __init__(self, process):
                self.process, self.args = process, process.args

            def communicate(self, timeout=None):
                raise KeyboardInterrupt

            def kill(self):
                self.process.kill()

            def wait(self):
                return self.process.wait()

        process = driver("interrupt")
        with owned_group(process) as stop:
            ids, was = running(process, "interrupt")
            try:
                collected(Interrupting(process), 300, stop)
                interrupted = False
            except KeyboardInterrupt:
                interrupted = True
            ended["an interruption"] = (was and interrupted, alive(ids) == [False, False])

        process = driver("failure")
        try:
            with owned_group(process):
                ids, was = running(process, "failure")
                raise RuntimeError("a failure around the drive")
        except RuntimeError:
            pass
        ended["a failure around them"] = (was, alive(ids) == [False, False])
        process.wait()

        wrong = sorted(f"{name}: " + ("was not running first" if not was_running
                                      else "left them running")
                       for name, (was_running, gone) in ended.items()
                       if not (was_running and gone))
        # The stand-ins stand for the drive the suite runs, so that drive has
        # to be the one owned_group ends and collected waits on.
        import ast
        import inspect
        drive_tree = ast.parse(textwrap.dedent(inspect.getsource(completion_tab_checks)))
        drive_started = any(
            isinstance(node, ast.Assign)
            and [getattr(target, "id", None) for target in node.targets] == ["drive"]
            and isinstance(node.value, ast.Call)
            and getattr(node.value.func, "attr", None) == "Popen"
            for node in ast.walk(drive_tree))
        drive_owned = any(
            isinstance(node, ast.With)
            and any(isinstance(item.context_expr, ast.Call)
                    and getattr(item.context_expr.func, "id", None) == "owned_group"
                    and [getattr(arg, "id", None) for arg in item.context_expr.args] == ["drive"]
                    for item in node.items)
            and any(isinstance(sub, ast.Call) and getattr(sub.func, "id", None) == "collected"
                    and sub.args and getattr(sub.args[0], "id", None) == "drive"
                    for statement in node.body for sub in ast.walk(statement))
            for node in ast.walk(drive_tree))
        if not (drive_started and drive_owned):
            wrong.append("the suite's completion drive is not started and waited for inside "
                         "owned_group")
        check("completion-driver-ends-with-its-owner",
              "a driver and its terminal child end with their owner after a normal return, a "
              "timeout, an interruption and a failure around them, and with the run when the "
              "worker that started them dies",
              not wrong, ", ".join(wrong))

        # A worker that outlives its bound, with a child in its own process
        # group: ending the worker alone would leave the child running. The
        # child's identity is read while it runs, before the bound starts.
        room = rooms[2]
        told_child = base / "bound-child"
        bound_ids = []

        def start_and_watch(argv, **kwargs):
            worker = subprocess.Popen(argv, **kwargs)
            waited(told_child.exists)
            said = told_child.read_text().strip() if told_child.exists() else ""
            bound_ids.append(identity(int(said)) if said.isdigit() else (0, ""))
            return worker

        finished = run_shares([[sys.executable, "-c", BOUND_WORKER_FIXTURE, str(told_child)]],
                              room, start=start_and_watch, bound=3)
        child_id = bound_ids[0] if bound_ids else (0, "")
        bounded = {
            "the worker was stopped at its bound": [run.returncode for run in finished] == [None],
            "the child it started in its group was running": bool(child_id[1]),
            "the child is no longer running": alive([child_id]) == [False],
            "the room holds nothing after": sorted(entry.name for entry in room.iterdir()) == [],
        }
        wrong = sorted(claim for claim, ok in bounded.items() if not ok)
        check("worker-past-its-bound-is-ended-with-its-group",
              "a worker still running at its bound is ended with its process group, what it "
              "started there included",
              not wrong, ", ".join(wrong))

        # SIGTERM to a run that started a driver: the run turns it into
        # Terminated, as run_selftest does, so owned_group ends the driver and
        # its terminal child on the way out. -B, because the run loads the
        # tool as a module.
        told = base / "terminated"
        outer = subprocess.Popen([sys.executable, "-B", "-c", TERMINATED_OWNER_FIXTURE, tool,
                                  PTY_DRIVER_FIXTURE, str(told)],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.PIPE, text=True)
        identity(outer.pid)
        said = told.read_text().splitlines() if waited(told.exists) else []
        driver_id = identity(int(said[0])) if said and said[0].isdigit() else (0, "")
        child_id = identity(int(said[1])) if len(said) > 1 and said[1].isdigit() else (0, "")
        stubborn_id = identity(int(said[2])) if len(said) > 2 and said[2].isdigit() else (0, "")
        was_running = alive([driver_id, child_id, stubborn_id]) == [True, True, True]
        outer.terminate()
        try:
            _out, outer_err = outer.communicate(timeout=30)
        except subprocess.TimeoutExpired:
            outer.kill()
            _out, outer_err = outer.communicate()
        import ast
        import inspect
        selftest_tree = ast.parse(textwrap.dedent(inspect.getsource(run_selftest)))
        unit_tree = ast.parse(textwrap.dedent(inspect.getsource(ran_unit)))
        handlers = [node for node in ast.walk(selftest_tree) if isinstance(node, ast.ExceptHandler)]
        passed_on = [node for node in ast.walk(unit_tree) if isinstance(node, ast.ExceptHandler)
                     and "Terminated" in ast.dump(node.type)
                     and isinstance(node.body[0], ast.Raise) and node.body[0].exc is None]
        late_file = Path(str(told) + ".late")
        late_said = late_file.read_text().split() if late_file.exists() else []
        late_id = ((int(late_said[0]), late_said[1])
                   if len(late_said) == 2 and late_said[0].isdigit() else (0, ""))
        owned.append(late_id)
        terminated = {
            "the driver, its terminal child and the stubborn process were running": was_running,
            "the run took the signal through its cleanup and exited 143": outer.returncode == 143,
            "none of them is running after":
                alive([driver_id, child_id, stubborn_id]) == [False, False, False],
            "the sleeper the stubborn process started while asked to stop was ended too":
                bool(late_id[1]) and alive([late_id]) == [False],
            "run_selftest makes SIGTERM raise while its units run":
                any(isinstance(node, ast.Call) and getattr(node.func, "id", None)
                    == "raise_on_sigterm" for node in ast.walk(selftest_tree)),
            "run_selftest ends the run on Terminated":
                any(getattr(node.type, "id", None) == "Terminated" for node in handlers),
            "a unit cannot absorb it": bool(passed_on),
        }
        wrong = sorted(claim for claim, ok in terminated.items() if not ok)
        check("terminated-run-ends-what-it-started",
              "a run sent SIGTERM ends what it started, a driver and its terminal child "
              "included, before it exits",
              not wrong, ", ".join(wrong) + (f"; exit {outer.returncode}, stderr "
                                             f"{outer_err.strip()[-300:]!r}" if wrong else ""))

        # What a run's finish ends: only what is under it. A sleeper of this
        # check's own started before the run, and one started while the run
        # waits, both outside it, survive its finish. The guards are asked
        # about pid 1, this run and its parent without signalling them, and
        # about a sleeper of this check's own started under the name systemd.
        named_systemd = base / "systemd"
        named_systemd.symlink_to(shutil.which("sleep"))
        older = subprocess.Popen(["sleep", "60"], start_new_session=True)
        older_id = identity(older.pid)
        time.sleep(0.1)                 # the run below starts some ticks later
        go, under_told = base / "finish-go", base / "finish-under"
        finisher = subprocess.Popen([sys.executable, "-B", "-c", RUN_FINISH_FIXTURE, tool,
                                     str(go), str(named_systemd), str(under_told)],
                                    stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        identity(finisher.pid)
        under_id = (identity(int(under_told.read_text()))
                    if waited(under_told.exists) and under_told.read_text().isdigit()
                    else (0, ""))
        time.sleep(0.1)                 # and this one some ticks after it
        younger = subprocess.Popen(["sleep", "60"], start_new_session=True)
        younger_id = identity(younger.pid)
        go.write_text("")
        try:
            finished_said, finisher_err = finisher.communicate(timeout=60)
        except subprocess.TimeoutExpired:
            finisher.kill()
            finished_said, finisher_err = finisher.communicate()
        outside_survived = alive([older_id, younger_id]) == [True, True]
        under_survived = bool(under_id[1]) and alive([under_id]) == [True]
        imitation = subprocess.Popen([str(named_systemd), "30"], start_new_session=True)
        imitation_id = identity(imitation.pid)
        sleeper = subprocess.Popen(["sleep", "30"], start_new_session=True)
        sleeper_id = identity(sleeper.pid)
        waited(lambda: (_ProcessFence.identity(imitation.pid) or ("",) * 4)[3] == "systemd")
        bound = _ProcessFence.start_time(os.getpid())
        refusals = {
            "pid 1": owned_group_refusal(1, "0", bound),
            "this run": owned_group_refusal(os.getpid(), bound, bound),
            "its parent": owned_group_refusal(os.getppid(), "0", bound),
            "a process named systemd": owned_group_refusal(imitation.pid, imitation_id[1], bound),
            "a process this run started": owned_group_refusal(sleeper.pid, sleeper_id[1], bound),
            "one started before this run": owned_group_refusal(sleeper.pid, str(int(bound) - 1),
                                                               bound),
        }
        # The walk up past the parent, asked about a lineage put in place of
        # what the stat files say: the parent's parent is a pid no process can
        # hold, so only a walk that reads the parent's stat file reaches it.
        parent, above = os.getppid(), PID_CEILING + 31
        kept_stat = vars(_ProcessFence)["_stat"]

        def lineage(pid):
            if pid == parent:
                return (above, above, "1", "stand-in")
            if pid == above:
                return (1, 1, "1", "stand-in")
            return kept_stat.__func__(pid)

        _ProcessFence._stat = staticmethod(lineage)
        try:
            refusals["its parent's parent"] = owned_group_refusal(above, "0", bound)
        finally:
            _ProcessFence._stat = kept_stat
        right_fd = _pidfd_for(sleeper.pid, sleeper_id[1])
        wrong_fd = _pidfd_for(sleeper.pid, str(int(sleeper_id[1] or 1) - 1))
        for fd in (right_fd, wrong_fd):
            if fd is not None:
                os.close(fd)
        for started_here in (older, younger, imitation, sleeper):
            started_here.kill()
            started_here.wait()
        bounded = {
            "processes outside a run, older or younger than it, survive its finish":
                outside_survived and finisher.returncode == 0,
            "a process under the run that the rules refuse is left running and said to be left":
                under_survived and finished_said.strip()
                == f"([], [{under_id[0]}], ['pid {under_id[0]} is a systemd process'])",
            "the run names on its diagnostic stream what it could not end":
                f"pid {under_id[0]} is a systemd process" in finisher_err
                and f"pid {under_id[0]} is still running" in finisher_err,
            "a pidfd is kept only while the pid is the process that started then":
                right_fd is not None and wrong_fd is None,
            "pid 1 is never signalled": refusals["pid 1"] == "pid 1",
            "the run never signals itself": refusals["this run"] == "this run itself",
            "the run never signals an ancestor, its parent or one above it":
                refusals["its parent"] == refusals["its parent's parent"]
                == "an ancestor of this run",
            "no systemd process is signalled":
                refusals["a process named systemd"] == "a systemd process",
            "a process this run started may be": refusals["a process this run started"] is None,
            "one that started before this run is not":
                refusals["one started before this run"] == "it did not start after this run",
        }
        wrong = sorted(claim for claim, ok in bounded.items() if not ok)
        check("run-ends-only-what-it-started",
              "a run ends only processes under it that started after it, and never pid 1, "
              "itself, an ancestor of it or a systemd process",
              not wrong, ", ".join(wrong) + (f"; {refusals}, finish said {finished_said!r} "
                                             f"{finisher_err.strip()[-200:]!r}" if wrong else ""))

        # SIGTERM to a run with one process of each kind the suite starts in a
        # session of its own, each started through its fixture's function: all
        # are gone after. The stray is outside the run by design, and ended by
        # the pid and life line the run kept; the others are under it.
        told = base / "own-session-run"
        own_run = subprocess.Popen([sys.executable, "-B", "-c", OWN_SESSION_RUN_FIXTURE, tool,
                                    str(told)], stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        identity(own_run.pid)
        said = told.read_text().splitlines() if waited(told.exists) else []
        kinds, adopting_again, adopting_after_raise = {}, None, None
        for line in said:
            kind, pid = (line.split() + ["", ""])[:2]
            if kind == "adopting":
                adopting_again = pid
            elif kind == "adopting-after-raise":
                adopting_after_raise = pid
            elif pid.isdigit() and int(pid):
                kinds[kind] = identity(int(pid))
        under_run = _ProcessFence.subtree(own_run.pid, _ProcessFence.run_processes())
        before = {kind: alive([ids])[0] for kind, ids in kinds.items()}
        placed = {kind: ids[0] in under_run for kind, ids in kinds.items()}
        own_run.terminate()
        try:
            _out, own_err = own_run.communicate(timeout=60)
        except subprocess.TimeoutExpired:
            own_run.kill()
            _out, own_err = own_run.communicate()
        after = {kind: alive([ids])[0] for kind, ids in kinds.items()}
        expected_kinds = ["agent", "copy", "copy-child", "stray", "wrapper"]
        own_session = {
            "each kind was started and running": sorted(kinds) == expected_kinds
            and all(before.values()),
            "the stray was outside the run and the rest under it":
                placed == {kind: kind != "stray" for kind in expected_kinds},
            "the run took the signal through its cleanup and exited 143":
                own_run.returncode == 143,
            "none is running after": not any(after.values()),
            "the run adopted again once the stray was made": adopting_again == "True",
            "and again after a raise inside the block that stops it adopting":
                adopting_after_raise == "True",
            "the run named what it ended on its diagnostic stream":
                "the run ended processes it had started and left running: " in own_err
                and all(str(kinds[kind][0]) in own_err
                        for kind in ("copy", "copy-child", "wrapper", "agent") if kind in kinds),
        }
        wrong = sorted(claim for claim, ok in own_session.items() if not ok)
        check("own-session-processes-end-with-their-run",
              "a copy run and its child, a wrapper and its agent, and a stray outside the run's "
              "lineage, each started in a session of its own as the suite starts them, are gone "
              "once their run is sent SIGTERM, the stray ended by the pid and life line the run "
              "kept; the run exits 143 and names on its diagnostic stream what it ended; and it "
              "adopts again after making the stray and after a raise inside the block that "
              "stops it adopting",
              not wrong, ", ".join(wrong) + (f"; kinds {kinds}, before {before}, under the run "
                                             f"{placed}, after {after}, exit {own_run.returncode},"
                                             f" stderr {own_err.strip()[-300:]!r}"
                                             if wrong else ""))
    finally:
        for pid, born in owned:
            fd = _pidfd_for(pid, born) if pid and born else None
            if fd is not None:
                with contextlib.suppress(OSError):
                    signal.pidfd_send_signal(fd, signal.SIGKILL)
                os.close(fd)
        for directory in (base, *rooms):
            shutil.rmtree(directory, ignore_errors=True)
    return checked


@unit(("cleanup-reads-only-its-run",
       "the selftest's own process readers read stat files only for processes under its "
       "run, and for its ancestors in the guard; for any other pid they read no stat file "
       "and report no running process; they record as refused a pid that some process "
       "holds and a value that is not a whole number, and record with its error a pid that "
       "pidfd_open cannot judge; and end_stray ends the stray it asked about and says so"),
      live=True)
def _check_cleanup_reads_only_its_run(s):
    """_ProcessFence's own readers, asked about pids inside and outside this run.

    A sleeper this check starts is under the run and is read. pid 1, this
    run's parent and a stray start_stray puts outside the run's lineage are
    running and are not read: each reads as no running process and is written
    down as refused. A pid no process can hold reads the same and is not
    written down, since nothing holds it. A pid pidfd_open cannot judge, as a
    stand-in for it makes one here, is written down with the error and read
    neither as held nor as gone. A value that is no pid, such as a path, True
    or 3.7, reads as nothing and is written down as a refusal, as admit writes
    one. The parent is still found by the guard's walk up from this run. Every
    pid with a stat file read while the questions are put is recorded, through
    a stand-in for _ProcessFence._stat put in its place as the lineage
    stand-in in _check_shares_cleanup_owner is, and each one must be this
    run, a process under it or an ancestor. The refusals go to a fence of
    this check's own, entered as an undeclared unit, so they are read here
    instead of reaching the tier's refusal row.
    """
    import errno
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    room = Path(tempfile.mkdtemp(prefix=own("cr")))
    sleeper = subprocess.Popen(["sleep", "30"], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    stray, life = start_stray(room / "pid")
    stray_running = bool(stray) and not ready_to_read(life)
    runner, fence = PROCESS_FENCE, _ProcessFence()
    held = {"pid 1": 1, "this run's parent": os.getppid(), "a stray outside this run": stray}
    kept_stat, stat_read = vars(_ProcessFence)["_stat"], []

    def recording(pid):
        stat_read.append(int(pid))
        return kept_stat.__func__(pid)

    real_open = os.pidfd_open

    def unjudging(_pid, *_flags):
        raise OSError(errno.EMFILE, os.strerror(errno.EMFILE))

    globals()["PROCESS_FENCE"] = fence
    _ProcessFence._stat = staticmethod(recording)
    try:
        fence.enter("undeclared", False)
        answers = {name: _ProcessFence.identity(pid) for name, pid in held.items()}
        answers["a pid no process holds"] = _ProcessFence.identity(PID_CEILING + 9)
        os.pidfd_open = unjudging
        try:
            unjudged = _ProcessFence.identity(1)
        finally:
            os.pidfd_open = real_open
        read = {
            "a process this run started is read": _ProcessFence.identity(sleeper.pid) is not None,
            "and so is this run": _ProcessFence.identity(os.getpid()) is not None,
            "and the sleeper is among the processes found under this run":
                sleeper.pid in _ProcessFence.run_processes(),
            "the guard's walk still finds this run's parent":
                os.getppid() == 1 or os.getppid() in _ProcessFence.ancestors(),
        }
        refused = sorted(pid for _unit, reader, pid in fence.refused if reader == "cleanup stat")
        named = [(reader, pid) for _unit, reader, pid in fence.refused
                 if reader != "cleanup stat"]
        before = len(fence.refused)
        no_pids = ("1/task/1", True, 3.7)
        no_pid_answers = [_ProcessFence.identity(value) for value in no_pids]
        no_pid_refused = [(reader, pid) for _unit, reader, pid in fence.refused[before:]]
        fence.leave()
        # Taken while the sleeper still runs, so it counts as under the run.
        readable = {os.getpid(), *_ProcessFence._walk_down(os.getpid()),
                    *_ProcessFence.ancestors()}
    finally:
        _ProcessFence._stat = kept_stat
        globals()["PROCESS_FENCE"] = runner
        ended = end_stray(stray, life)
        sleeper.kill()
        sleeper.wait()
        shutil.rmtree(room, ignore_errors=True)
    claims = {
        **read,
        "the stray was running when it was asked about, by its life line": stray_running,
        "every other pid reads as no running process":
            all(answer is None for answer in answers.values()),
        "each one a process holds is written down as refused, and only those":
            refused == sorted(held.values()),
        "one pidfd_open cannot judge reads as no running process":
            unjudged is None,
        "and is written down with the error, apart from the refusals":
            named == [("cleanup stat, of a pid pidfd_open could not judge (EMFILE)", 1)],
        "a value that is not a whole number reads as nothing and is written down as such":
            no_pid_answers == [None] * len(no_pids)
            and no_pid_refused == [("cleanup stat", repr(value)) for value in no_pids],
        "no stat file is read but this run's, those under it and its ancestors'":
            bool(stat_read) and set(stat_read) <= readable,
        "end_stray ends the stray and says so": ended is True,
    }
    wrong = sorted(claim for claim, ok in claims.items() if not ok)
    check("cleanup-reads-only-its-run",
          "the selftest's own process readers read stat files only for processes under its "
          "run, and for its ancestors in the guard; for any other pid they read no stat file "
          "and report no running process; they record as refused a pid that some process "
          "holds and a value that is not a whole number, and record with its error a pid that "
          "pidfd_open cannot judge; and end_stray ends the stray it asked about and says so",
          not wrong, ", ".join(wrong) + (f"; asked {held}, refused {refused}, named {named}, "
                                         f"read {sorted(set(stat_read) - readable)}"
                                         if wrong else ""))
    return checked


def live_checks(share=None, child=None, diagnostics=None):
    """Run the live units, or one share of them, against the live context.

    A share is (which, out_of): the units with a place in the registry that
    falls in it, and none of the read-only verdicts, which the run that asked
    for shares inherits once for all of them.

    The read-only tier's verdicts come from the child the context ran, so a
    live invocation answers those questions once.

    Returns the rows and the register that filled them: run_selftest adds the
    rows about what this tier printed and ran, and they go in through that same
    register. A share records a repeated id here, in the worker, the way a
    whole tier does, and states its own declaration and ended rows, which the
    run that merged the shares folds into one each.
    """
    s = _live_context(child, diagnostics)
    out, register = check_rows()
    if not share:
        for row in s.inherited:
            register(*row)
    live_units = [entry for entry in UNITS if entry[3]]
    tier_rows([live_units[at] for at in in_share(len(live_units), share)], s, register, True,
              diagnostics)
    return out, register

# What one TAB does, pinned by structure rather than by a clock because a timing
# assertion on someone else's machine is a coin toss. zsh reruns completion once
# per matcher-list specification until one produces matches, and oh-my-zsh sets
# three. Nothing was kept between those runs, so a word matching nothing read the
# corpus three times. The first check keeps one emitter call per topic.
#
# The second check keeps the answer complete. LISTMAX is set to zero in this
# isolated terminal so zsh renders the entire synthetic corpus without asking
# for confirmation; that setting belongs to the test, not to the installed
# completion. The assertion is about which candidates the completion offers,
# not about how a particular shell chooses to page or confirm a long listing.


HOSTILE_ROW = "a [bracket] pair, a colon: an apostrophe's, a \"quote\""


COMPLETION_DRIVER = r"""
emulate -L zsh
zmodload zsh/zpty
zmodload zsh/datetime
local bindir=$1 fpdir=$2 fakehome=$3 calls=$4 tool=$5 nonce=$6 cachehome=$7 withhold=${8:-0}
local chunk buf late ending
local -F deadline
local -i tabseq=0
drain() { while zpty -r -t z chunk 0.1 2>/dev/null; do :; done }
await() {  # marker seconds: waits with a fresh buffer
  deadline=$(( EPOCHREALTIME + $2 ))
  buf=''
  while (( EPOCHREALTIME < deadline )); do
    zpty -r -t z chunk 0.1 2>/dev/null && buf+=$chunk
    [[ $buf == *$1* ]] && return 0
  done
  return 1
}
await_more() {  # marker seconds: adds to what await collected, so nothing read is lost
  deadline=$(( EPOCHREALTIME + $2 ))
  while (( EPOCHREALTIME < deadline )); do
    [[ $buf == *$1* ]] && return 0
    zpty -r -t z chunk 0.1 2>/dev/null && buf+=$chunk
  done
  [[ $buf == *$1* ]]
}
tabbed() {  # site seconds: one completion, waited for rather than timed
  # The completion says when it is done, from inside zle, because nothing
  # outside can. Keys sent ahead of it do not work: zsh treats input waiting to
  # be read as a reason not to list at all, so queuing a marker behind the TAB
  # cancelled the listing the check is about. Waiting for a quiet stretch
  # instead measured the end of the listing by guess, and a machine that paused
  # mid-listing for longer than the guess took a part of it for the whole.
  #
  # Every marker carries this drive's nonce and this TAB's number, so neither
  # an earlier TAB nor another drive can answer a wait. TAB-DONE says the
  # widget finished; its end marker, read into the same buffer, says this
  # driver read everything the widget wrote. Waiting for the end is not fatal:
  # a missing end makes the verdicts that read this TAB say so, where a fatal
  # return would end the drive and say nothing about the other five. What
  # arrives after that wait is kept, so an end that came late is told from one
  # that never came.
  local site=$1
  (( ++tabseq ))
  zpty -w -n z $'\024'      # ^T, bound at setup to complete and then say so
  if ! await "TAB-DONE:$nonce:$tabseq" $2; then
    # The widget never said it finished. The TAB is written down as undone and
    # the drive goes on, so a later TAB is judged on its own evidence; a shell
    # still inside this completion answers no later TAB either, and each of
    # them then says so for itself.
    print -r -- "$tabseq $site undone" >> $calls.sites
    print -r -- "$buf" > $calls.site-$tabseq
    zpty -w -n z $'\025'
    drain
    return 0
  fi
  if await_more "TAB-END:$nonce:$tabseq" 5; then
    ending=reached
  else
    late=''
    while zpty -r -t z chunk 0.5 2>/dev/null; do late+=$chunk; done
    if [[ $late == *"TAB-END:$nonce:$tabseq"* ]]; then ending=late; else ending=missing; fi
    buf+=$late
  fi
  print -r -- "$tabseq $site $ending" >> $calls.sites
  print -r -- "$buf" > $calls.site-$tabseq
  zpty -w -n z $'\025'      # discard the completed line
  drain
}
# XDG_CACHE_HOME is set for the shell rather than left to what this driver
# inherited, so the cache the completion writes is the one snapshotted below.
zpty -b z "HOME=$fakehome XDG_CACHE_HOME=$cachehome CLAUDE_CONFIG_DIR= PATH=$bindir:\$PATH zsh -f -i" \
  || { print DRIVE_FAIL no-pty; return 1 }
# The shell is asked to say it is up rather than waited at in the hope it
# says so on its own: -f skipped every rc file, so nothing here prints a
# greeting, and waiting for one cost the full timeout on every run.
# A pty echoes what is typed, so a marker typed whole would be matched from
# the echo before the shell had read it; split, only the shell's own output
# spells it.
zpty -w z 'print REA${:-}DY'
await READY 10 || { print DRIVE_FAIL no-shell; zpty -d z; return 1 }
drain
# -f skipped every rc file, so the setup is sent instead: a terminal tall and
# wide enough for the synthetic corpus, the three matcher specs oh-my-zsh sets,
# and LISTMAX=0 so the test can inspect every offered candidate without an
# interactive confirmation interrupting its own driver. The widget numbers its
# own TABs and leaves out the end marker of the TAB numbered withhold, which no
# drive but a check's control asks for.
zpty -w z "stty rows 400 cols 200; fpath=($fpdir \$fpath); autoload -Uz compinit; compinit -u -D; zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|=*' 'l:|=* r:|=*'; LISTMAX=0; typeset -i TABSEQ=0; tabmark() { zle expand-or-complete; zle -R; (( ++TABSEQ )); print -r -- TAB-BUFFER:\${BUFFER} >/dev/tty; print -r -- TAB-DONE:$nonce:\$TABSEQ >/dev/tty; (( TABSEQ == $withhold )) || print -r -- TAB-END:$nonce:\$TABSEQ >/dev/tty; }; zle -N tabmark; bindkey '^T' tabmark; print SETUP\${:-}-DONE"
await SETUP-DONE 30 || { print DRIVE_FAIL no-setup; zpty -d z; return 1 }
drain
# The drive ends early only where no TAB could be judged: without a pty, a
# shell or its setup nothing has been asked, and without the style the last
# TAB is about that TAB asks nothing. A TAB that never finishes is written
# down and the drive goes on.
zpty -w -n z "$tool zzqqxxnothing"
tabbed one 40
cp -- $calls $calls.after-one-tab
zpty -w -n z "$tool "
tabbed bare 40
print -r -- "$buf" > $calls.bare
zpty -w -n z "$tool --"
tabbed flags 40
print -r -- "$buf" > $calls.flags
zpty -w -n z "$tool --promote side --as-agent "
tabbed as-name 40
print -r -- "$buf" > $calls.as-name
zpty -w -n z "$tool --promote side --as-agent side-name@"
tabbed as-team 40
print -r -- "$buf" > $calls.as-team
cp -- $calls $calls.before-nocache
mkdir -p $calls.cache-before $calls.cache-after
cp -a $cachehome/$tool/*(N.) $calls.cache-before/ 2>/dev/null
zpty -w z "zstyle ':completion:*:*:$tool:*' use-cache false; print NOCACHE\${:-}-SET"
await NOCACHE-SET 10 || { print DRIVE_FAIL no-nocache-style; zpty -d z; return 1 }
drain
zpty -w -n z "$tool zzqqxxnothing"
tabbed nocache 40
cp -- $calls $calls.after-nocache
cp -a $cachehome/$tool/*(N.) $calls.cache-after/ 2>/dev/null
zpty -d z
print DRIVE_OK
"""


# The states tab_ending gives a TAB when its end marker was read, so everything
# before the marker was read with it.
TAB_READ_TO_END = ("complete", "delayed")


def tab_ending(seq, ending, text, nonce):
    """How one TAB of a completion drive ended, as (state, sentence).

    ending is what the driver wrote down for the TAB: reached, late or
    missing, each judged by this drive's marker for this TAB, or undone when
    the widget never said it finished, which is an absent end. A late end is
    delayed: the driver's wait for it ran out, and the reading after it found
    it. A missing end is truncated when the TAB's text stops partway through
    its marker and absent otherwise; either way the TAB may still have shown
    everything, and only the marker could have said so. The marker says the
    TAB was read to its end and nothing more: a completion still ends when its
    command failed, and whether its rows are all there is the question of
    the verdict that reads it.
    """
    marker = f"TAB-END:{nonce}:{seq}"
    if ending == "undone":
        return "absent", (f"TAB {seq}'s completion never said it finished within the wait, so "
                          "its end marker never came and what it showed is whatever arrived "
                          "before the drive went on")
    if ending == "reached":
        return "complete", ""
    if ending == "late":
        return "delayed", f"TAB {seq}'s end marker came only after the wait for it"
    tail = text.rstrip()
    cut = next((marker[:size] for size in range(len(marker) - 1, 3, -1)
                if tail.endswith(marker[:size])), "")
    if cut:
        return "truncated", f"TAB {seq}'s output stops partway through its end marker, at {cut!r}"
    return "absent", (f"TAB {seq}'s end marker never came, so whether everything it "
                      "showed was read is not known")


def corpus_tab_verdict(state, why, offered, expected, asked):
    """The bare TAB's verdict, as (ok, detail), from how it ended and what it showed.

    A short count says rows are missing only when the TAB was read to its end
    marker. Every row arriving without that end is a different finding:
    nothing is known to be missing, and nothing is known to be complete.
    """
    if state not in TAB_READ_TO_END and offered == expected:
        return False, (f"every row arrived, {offered} of {expected}, but {why}; completeness "
                       "is unverified")
    return (state in TAB_READ_TO_END and offered == expected and not asked,
            f"{offered} of {expected} rows offered, zsh asked first: {asked}"
            + (f"; {why}" if why else ""))


@unit(("completion-endings-told-apart",
       "a TAB's ending is told apart as complete, delayed, truncated or absent from its own "
       "end marker, a failed command that reached its end fails on its rows, and rows count "
       "as missing only when its end was read"))
def _check_completion_endings_told_apart(s):
    """tab_ending and corpus_tab_verdict on the text each kind of ending leaves.

    A live drive reaches most of these endings only when something goes wrong,
    so each is written here as the text the driver would have kept, differing
    from a complete TAB's in one respect at a time.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    nonce = "0a1b2c3d"
    rows = "willow  -- names\r\nash  -- names\r\n"
    done, end = f"TAB-DONE:{nonce}:2\r\n", f"TAB-END:{nonce}:2\r\n"
    endings = {
        "complete": tab_ending(2, "reached", rows + done + end, nonce),
        "delayed": tab_ending(2, "late", rows + done + end, nonce),
        "truncated": tab_ending(2, "missing", rows + done + end[:12], nonce),
        "absent": tab_ending(2, "missing", rows + done, nonce),
        # Another TAB's whole end marker is not a partial one of this TAB's.
        "absent, behind the first TAB's end": tab_ending(
            2, "missing", rows + done + f"TAB-END:{nonce}:1\r\n", nonce),
        # A widget that never said it finished never wrote its end either.
        "absent, its widget never finishing": tab_ending(2, "undone", rows, nonce),
    }
    misread = sorted(f"{name} read as {state}" for name, (state, _why) in endings.items()
                     if state != name.split(",")[0])
    absent_why = endings["absent"][1]
    verdicts = {
        "a complete TAB with every row passes":
            corpus_tab_verdict(*endings["complete"], 320, 320, False)
            == (True, "320 of 320 rows offered, zsh asked first: False"),
        "a complete TAB short of rows names the rows missing":
            corpus_tab_verdict(*endings["complete"], 300, 320, False)
            == (False, "300 of 320 rows offered, zsh asked first: False"),
        "a failed command that reached its end fails on its rows, not its marker":
            corpus_tab_verdict(*endings["complete"], 0, 320, False)
            == (False, "0 of 320 rows offered, zsh asked first: False"),
        "every row without an end is unverified, not missing":
            corpus_tab_verdict(*endings["absent"], 320, 320, False)
            == (False, f"every row arrived, 320 of 320, but {absent_why}; completeness is "
                "unverified"),
        "partial output without an end keeps its count and says why":
            corpus_tab_verdict(*endings["absent"], 300, 320, False)
            == (False, f"300 of 320 rows offered, zsh asked first: False; {absent_why}"),
        "every row before a truncated end is unverified":
            corpus_tab_verdict(*endings["truncated"], 320, 320, False)[1].endswith(
                "completeness is unverified"),
        "a delayed end passes and says it came late":
            corpus_tab_verdict(*endings["delayed"], 320, 320, False)
            == (True, f"320 of 320 rows offered, zsh asked first: False; "
                f"{endings['delayed'][1]}"),
    }
    wrong = misread + sorted(claim for claim, ok in verdicts.items() if not ok)
    check("completion-endings-told-apart",
          "a TAB's ending is told apart as complete, delayed, truncated or absent from its own "
          "end marker, a failed command that reached its end fails on its rows, and rows count "
          "as missing only when its end was read",
          not wrong, "; ".join(wrong))
    return checked


def completion_tab_checks(withhold=0, earlier=()):
    """Every TAB check off one drive of a real interactive zsh, and how each TAB ended.

    The corpus is a stub emitter printing 320 candidates: 200 member rows in
    the six self-contained fields the real emitter prints (names, team key,
    group description, agent id, member description, colour), then 60 team
    and 60 lead rows. The fields are listed here so that a change to the real
    rows shows up as a difference against this list, rather than as a
    completion that seems to have lost its member rows.

    HOME and XDG_CACHE_HOME are temporary directories, so this reads and writes
    nothing of the machine's own: what is being tested is the completion file,
    not this machine's teams. The drive inherits an XDG_CACHE_HOME of a second
    temporary directory and gives the shell its own, so a completion that
    stopped seeing the shell's setting would write its cache to the inherited
    one, and the snapshots of the private one would come up empty and say so.

    withhold names a TAB, by its number, for the widget to leave out its end
    marker, for the check that a TAB read whole but never seen to end is not
    reported as rows missing. earlier holds the nonces of the drives the
    caller made before this one: a drive with the markers of one of theirs
    would not have markers of its own. The drive is a process group of its
    own with a pty under it, written down while it runs so a surviving parent
    can end it, and ended here however the wait ends.

    Returns (rows, endings, nonce): the verdict rows, each TAB's (state,
    sentence) from tab_ending, by site, and this drive's nonce. Its caller has
    found zsh.
    """
    out = []
    zsh = shutil.which("zsh")

    stage = Path(tempfile.mkdtemp(prefix=f"{TOOL}-tab-"))
    try:
        binned, fpdir, home = stage / "bin", stage / "fp", stage / "home"
        cachehome, inherited = stage / "cache", stage / "inherited-cache"
        for path in (binned, fpdir, home / ".claude" / "teams", home / ".claude" / "projects",
                     cachehome, inherited):
            path.mkdir(parents=True)
        # Five session clusters of forty, then teams and leads, in the order
        # the real emitter prints them and at about the size it prints here. A
        # member row is six fields (names, team key, group description, agent
        # id, member description, colour), and every row carries its own team
        # key and group rather than leaving them to the row above, which is
        # what the parser requires and what the real emitter prints. The team
        # key matches the team in each agent id, so these rows pass the same
        # agent-id check every other row does.
        lines = [f"names\tsession-{g:08x}\tsession-{g:08x}  2026-08-0{g + 1} 10:00:00\t"
                 f"agent{g}-{m:02d}@session-{g:08x}\ttask {g}.{m}\t"
                 for g in range(5) for m in range(40)]
        lines += [f"teams\tsession-{i:08x}:2 members, 2026-08-01 10:00:00" for i in range(60)]
        lines += [f"leads\tteam-lead@session-{i:08x}\tled something, joined 2026-08-01 10:00:00\t"
                  for i in range(60)]
        (stage / "lines").write_text("\n".join(lines) + "\n")
        calls = stage / "calls"
        calls.touch()
        stub = binned / TOOL
        # One flag with a menu row that carries every character that means
        # something to _arguments or to the shell: a bracket pair, a colon, an
        # apostrophe and a double quote. Proving the escaping against these is
        # the point; proving it against the flags that happen to exist today
        # would only say that today's prose is tame.
        hostile = HOSTILE_ROW
        (stage / "flags").write_text(
            "--plain\ta plain row\t\t\n"
            f"--hostile\t{hostile}\t\t\n"
            "--valued\ttakes something\t\tthing\n"
            "--promote\tconvert a side\tsides\tside\n"
            "--as-agent\toverride identity\t_agent_resume_as_agent\tname@team\n")
        stub.write_text(f'#!/bin/sh\necho "$2" >> {calls}\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "selector" ] '
                        f'&& exec cat {stage / "lines"}\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "flags" ] '
                        f'&& exec cat {stage / "flags"}\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "as-agent-name:side" ] '
                        f'&& printf "side-name\\n" && exit 0\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "as-agent:side" ] '
                        f'&& printf "side-name@current:current parent\\nside-name@other:another team\\n" && exit 0\n'
                        f'exit 0\n')
        stub.chmod(0o755)
        shutil.copy2(Path(__file__).resolve().parent / f"_{TOOL}", fpdir / f"_{TOOL}")
        (stage / "drive.zsh").write_text(COMPLETION_DRIVER)

        # Its own session and its own stdin: the drive holds an interactive
        # shell open on a pty it allocates, and nothing in it may reach the
        # terminal this suite was started from. The nonce makes this drive's
        # markers its own.
        nonce = os.urandom(4).hex()
        drive = subprocess.Popen([zsh, str(stage / "drive.zsh"), str(binned), str(fpdir),
                                  str(home), str(calls), TOOL, nonce, str(cachehome),
                                  str(withhold)],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE, text=True, start_new_session=True,
                                 env=dict(os.environ, XDG_CACHE_HOME=str(inherited)))
        with owned_group(drive) as stop:
            run = collected(drive, 300, stop)
        drove = "DRIVE_OK" in run.stdout
        sites = {}
        record = calls.with_suffix(".sites")
        for line in (record.read_text().splitlines() if record.exists() else []):
            seq, _, rest = line.partition(" ")
            site, _, ending = rest.partition(" ")
            text_file = calls.with_suffix(f".site-{seq}")
            sites[site] = (int(seq) if seq.isdigit() else 0, ending,
                           text_file.read_text(errors="replace") if text_file.exists() else "")

        def ended(site):
            seq, ending, said = sites.get(site, (0, "missing", ""))
            return tab_ending(seq, ending, said, nonce)

        first = calls.with_suffix(".after-one-tab")
        topics = first.read_text().split() if first.exists() else []
        # One read per topic is the floor: a TAB asks for flags always and for
        # the selector when the word is in the selector's place. Twice for the
        # same topic is the fault, because that is zsh running the whole
        # completion again under the next matcher spec with nothing kept.
        twice = sorted({t for t in topics if topics.count(t) > 1})
        listing = calls.with_suffix(".bare")
        shown = listing.read_text(errors="replace") if listing.exists() else ""
        # The pty carries the escapes the terminal would have acted on; strip
        # them, and \r as well, so one displayed row reads as one line here.
        plain = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", shown).replace("\r", "\n")
        rows = [row for row in plain.split("\n") if " -- " in row]
        asked = "possibilities" in plain

        said = run.stdout.strip().splitlines()[-1:] or [(run.stderr or "no output").strip()[:80]]
        stalled = f"the drive did not finish: {said[0]}"
        state, why = ended("one")
        out.append(("completion-reads-corpus-once",
                    "one TAB reads each topic once, however often zsh reruns it",
                    drove and state in TAB_READ_TO_END and bool(topics) and not twice,
                    (f"read twice: {twice}" if twice else f"{len(topics)} read(s): {topics}")
                    + (f"; {why}" if why else "") if drove else stalled))
        flagfile = calls.with_suffix(".flags")
        flagged = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "",
                         flagfile.read_text(errors="replace") if flagfile.exists() else ""
                         ).replace("\r", "\n")
        # zsh wraps a listing at the terminal width, so the row is compared
        # with its own line breaks taken back out.
        unwrapped = flagged.replace("\n", "")
        intact = HOSTILE_ROW.replace("\n", "") in unwrapped
        offered_hostile = "--hostile" in flagged
        state, why = ended("flags")
        out.append(("completion-flag-row-survives-escaping",
                    "a menu row keeps its brackets, colon and quotes on the way into zsh",
                    drove and state in TAB_READ_TO_END and offered_hostile and intact,
                    (f"offered: {offered_hostile}, row intact: {intact}"
                     + (f"; {why}" if why else "")) if drove else stalled))
        whole, said_whole = corpus_tab_verdict(*ended("bare"), len(rows), len(lines), asked)
        out.append(("completion-bare-tab-offers-whole-corpus",
                    "a bare TAB offers every teammate, team and lead",
                    drove and whole, said_whole if drove else stalled))
        name_file, team_file = calls.with_suffix(".as-name"), calls.with_suffix(".as-team")
        name_text = (name_file.read_text(errors="replace") if name_file.exists() else "")
        team_text = (team_file.read_text(errors="replace") if team_file.exists() else "")
        name_plain = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", name_text).replace("\r", "\n")
        team_plain = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", team_text).replace("\r", "\n")
        buffers = re.findall(r"TAB-BUFFER:([^\n]*)", name_plain)
        staged = bool(buffers and buffers[-1].endswith("--as-agent side-name@"))
        current_at, other_at = team_plain.find("side-name@current"), team_plain.find("side-name@other")
        ordered = current_at >= 0 and other_at > current_at
        unfinished = [why for state, why in (ended("as-name"), ended("as-team"))
                      if state not in TAB_READ_TO_END]
        out.append(("completion-as-agent-is-staged",
                    "--as-agent first inserts name@, then offers the current parent team first",
                    drove and not unfinished and staged and ordered,
                    ((f"buffer={buffers[-1]!r}, current index={current_at}, other index={other_at}"
                      if buffers else "no TAB-BUFFER marker")
                     + "".join(f"; {why}" for why in unfinished)) if drove else stalled))
        before_calls = calls.with_suffix(".before-nocache")
        after_calls = calls.with_suffix(".after-nocache")
        before_topics = before_calls.read_text().split() if before_calls.exists() else []
        after_topics = after_calls.read_text().split() if after_calls.exists() else []

        def cache_snapshot(directory):
            return {path.relative_to(directory).as_posix():
                    (path.read_bytes(), path.stat().st_mtime_ns)
                    for path in directory.rglob("*") if path.is_file()}

        cache_before = cache_snapshot(calls.with_suffix(".cache-before"))
        cache_after = cache_snapshot(calls.with_suffix(".cache-after"))
        # The snapshots are evidence only when they hold the cache the
        # completion wrote: an empty pair compares equal and proves nothing,
        # and files in the inherited directory mean the writes went there.
        strays = sorted(path.relative_to(inherited).as_posix()
                        for path in inherited.rglob("*") if path.is_file())
        reran = (after_topics.count("flags") > before_topics.count("flags")
                 and after_topics.count("selector") > before_topics.count("selector"))
        state, why = ended("nocache")
        out.append(("completion-use-cache-false-bypasses-cache",
                    "use-cache false reruns emitters without changing the cache files the "
                    "completion wrote to its own cache, and nothing is written to the cache "
                    "directory it inherited",
                    drove and state in TAB_READ_TO_END and reran and bool(cache_before)
                    and cache_before == cache_after and not strays,
                    (f"calls {len(before_topics)} -> {len(after_topics)}, "
                     f"cache files {len(cache_before)}, unchanged {cache_before == cache_after}, "
                     f"written to the inherited XDG_CACHE_HOME: {strays or 'nothing'}"
                     + (f"; {why}" if why else "")) if drove else stalled))
        # Six TABs, each read to the end marker that names this drive and its
        # own number, and no other TAB's end in any TAB's text: a marker one
        # TAB could take from another is what that numbering rules out.
        expected_sites = ["one", "bare", "flags", "as-name", "as-team", "nocache"]
        order = sorted(sites, key=lambda site: sites[site][0])
        foreign = sorted(f"{site} carries the end of TAB {other}"
                         for site, (seq, _ending, said) in sites.items()
                         for other in range(1, 7) if other != seq
                         and f"TAB-END:{nonce}:{other}" in said)
        unread = [why for site in expected_sites for state, why in [ended(site)]
                  if state not in TAB_READ_TO_END]
        # The driver's word that it read an end is checked against the text it
        # kept: a TAB read to its end holds this drive's marker for that TAB.
        unread += [f"{site} was read to an end its text does not hold"
                   for site in expected_sites if site in sites
                   and sites[site][1] in ("reached", "late")
                   and f"TAB-END:{nonce}:{sites[site][0]}" not in sites[site][2]]
        out.append(("completion-every-tab-reads-to-its-end",
                    "each of the six TABs is read to an end marker unique to that TAB and that drive",
                    drove and order == expected_sites
                    and [sites[site][0] for site in order] == list(range(1, 7))
                    and not foreign and not unread and nonce not in earlier,
                    "; ".join([f"TABs read: {', '.join(f'{site} {sites[site][0]} {sites[site][1]}' for site in order)}",
                               *foreign, *unread,
                               *(["this drive's markers are an earlier drive's"]
                                 if nonce in earlier else [])]) if drove else stalled))
        endings = {site: ended(site) for site in expected_sites}
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    return out, endings, nonce


def check_line(cid, name, detail="", verdict=None, idwidth=0, namewidth=0):
    """One check as a line, wherever it is printed.

    The failure list, the full table and the listing show the same check with
    different amounts of it: a verdict where there is one to report, columns
    where there are rows to line up, a detail where the check left one. Asked
    here so the three cannot drift, which is how a listing once lost the
    description while the other two kept it.
    """
    said = "" if verdict is None else f"  {'PASS' if verdict else 'FAIL'}  "
    return (f"{said}{cid:<{idwidth}}  {name:<{namewidth}}"
            + (f"  ({detail})" if detail else ""))


def check_report(results, failed_only=False):
    """The suite's verdicts as lines.

    The failure list names one check per line and ends with a summary, so a
    reader can diff two runs instead of searching one, and a run that died
    has no summary to be mistaken for a clean one.
    """
    failed = sum(1 for _, _, ok, _ in results if not ok)
    if failed_only:
        lines = [check_line(cid, name, detail)
                 for cid, name, ok, detail in results if not ok]
        return lines + [f"checks: {len(results) - failed} ok, {failed} failed"]
    idwidth = max((len(cid) for cid, _, _, _ in results), default=0)
    width = max((len(name) for _, name, _, _ in results), default=0)
    lines = [check_line(cid, name, detail, verdict=ok,
                        idwidth=idwidth, namewidth=width)
             for cid, name, ok, detail in results]
    return lines + ["", f"{len(results) - failed}/{len(results)} checks passed"]


def _selftest_report(results, failed_only):
    """Print one tier's verdicts, however the run assembled them."""
    for line in check_report(results, failed_only):
        print(line)
    return 1 if any(not ok for _, _, ok, _ in results) else 0


def _suite_context():
    """Everything the units share, computed once.

    A dependency between units is written down here rather than
    inherited from scope, so a unit run on its own says what it wants
    instead of reading whatever a neighbour left behind.
    """
    s = types.SimpleNamespace()
    s.suite_fns = _suite_functions()
    """Assert the invariants this tool keeps rediscovering. Read-only.

    Two kinds: structural ones read from this file's own syntax tree, because
    an invariant like "only the engine picks a transcript" is a property of the
    code rather than of a run; and behavioural ones exercised against the
    portable fixture corpus under test/, so the answer never depends on what
    happens to be on the machine running the suite (see corpus_engine()).
    """
    import ast
    import tempfile

    def corpus_engine():
        """A Resolver pointed at test/corpus/ instead of this machine.

        A fresh instance every call, never the shared RESOLVER: sharing one
        would let one check's cached stamps or spawn index leak into the
        next. The fixture is checked-in data, composed once, so every
        machine that runs this suite - a laptop with years of real teams or
        a bare CI checkout with none - exercises the same behaviour.
        """
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        corpus = Path(__file__).resolve().parent / "test" / "corpus"
        eng._projects_dir = corpus / "projects"
        eng._teams_dir = corpus / "teams"
        # The corpus holds conversations and rosters and nothing that runs: no
        # process, session registry or socket. An empty synthetic world is that
        # answer, so the engine reads none of the machine's. A unit that wants
        # processes installs its own world over this one.
        return _FakeTmux().attach(eng)

    source = Path(__file__).resolve().read_text()
    tree = ast.parse(source)
    _source_lines = source.splitlines()
    _segments = {}

    def src_of(node):
        """The source text of one node, sliced from lines split once.

        Identical to ast.get_source_segment, which re-splits the whole file on
        every call. Structural checks ask for a function's text a few hundred
        times per run, and over this file that was most of the read-only tier's
        runtime: measured 2.28s for one pass over the 446 function and class
        nodes against 0.0008s for this. Verified equal to get_source_segment on
        every one of them, nested ones included.
        """
        key = (node.lineno, node.col_offset, node.end_lineno, node.end_col_offset)
        text = _segments.get(key)
        if text is None:
            first, last = node.lineno - 1, node.end_lineno - 1
            if first == last:
                text = _source_lines[first][node.col_offset:node.end_col_offset]
            else:
                text = "\n".join([_source_lines[first][node.col_offset:]]
                                  + _source_lines[first + 1:last]
                                  + [_source_lines[last][:node.end_col_offset]])
            _segments[key] = text
        return text

    def is_delegate(node):
        """A transitional forwarder: one return of RESOLVER.<same name>(*a, **k).

        Recognised by shape rather than by a name list, so the step-5 deletion
        cannot leave a stale exemption behind, and so a hand-written function
        cannot quietly acquire one.
        """
        if len(node.body) != 1 or not isinstance(node.body[0], ast.Return):
            return False
        call = node.body[0].value
        return (isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute)
                and getattr(call.func.value, "id", None) == "RESOLVER"
                and call.func.attr == node.name)

    function_nodes = defaultdict(list)
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and not is_delegate(node):
            function_nodes[node.name].append(node)
    funcs = {name: nodes[-1] for name, nodes in function_nodes.items()}

    def indexed_function_key(node):
        """A literal key requested through the embedded function index."""
        if not (isinstance(node, ast.Subscript)
                and isinstance(node.slice, ast.Constant)
                and isinstance(node.slice.value, str)):
            return None
        value = node.value
        if isinstance(value, ast.Name) and value.id == "funcs":
            return node.slice.value
        if (isinstance(value, ast.Attribute) and value.attr == "funcs"
                and isinstance(value.value, ast.Name) and value.value.id == "s"):
            return node.slice.value
        return None

    indexed_function_keys = {
        key for node in ast.walk(tree)
        if (key := indexed_function_key(node)) is not None
    }
    indexed_function_faults = sorted(
        name for name in indexed_function_keys
        if len(function_nodes.get(name, ())) != 1)

    # What each function calls, by either spelling, indexed in one pass. The
    # question below is asked a few dozen times and each answer is a lookup:
    # one walk over the tree serves them all.
    _calls_in = {}
    for _name, _node in funcs.items():
        _called = set()
        for _sub in ast.walk(_node):
            if isinstance(_sub, ast.Call):
                _spelled = getattr(_sub.func, "id", None)
                if _spelled is None and isinstance(_sub.func, ast.Attribute):
                    _spelled = _sub.func.attr
                if _spelled is not None:
                    _called.add(_spelled)
        _calls_in[_name] = _called

    def callers_of(target):
        """Callers by either spelling: a module function calls `target(...)`, an
        engine method calls `self.target(...)`. Matching only the first lets
        every invariant below pass by vacuity for an engine that is a class,
        which is the opposite of what they are for."""
        return {name for name, called in _calls_in.items() if target in called}

    # Exact production edges to Resolver. Most normal CLI functions precede the
    # fixture boundary; audited is placed after the embedded checks but is still
    # normal command execution rather than a test helper.
    resolver_node = next(node for node in tree.body
                         if isinstance(node, ast.ClassDef) and node.name == "Resolver")
    rewriter_node = next(node for node in tree.body
                         if isinstance(node, ast.ClassDef) and node.name == "TranscriptRewriter")
    fixture_boundary = next(node.lineno for node in tree.body
                            if isinstance(node, ast.FunctionDef)
                            and node.name == "fixture_line")
    production_tail = {"audited"}
    production_functions = {
        node.name: node for node in tree.body
        if isinstance(node, ast.FunctionDef)
        and (node.lineno < fixture_boundary or node.name in production_tail)
    }

    def scoped_nodes(root):
        """Yield one production function's syntax without nested scopes."""
        pending = list(reversed(root.body))
        while pending:
            node = pending.pop()
            yield node
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef,
                                 ast.ClassDef, ast.Lambda)):
                continue
            pending.extend(reversed(list(ast.iter_child_nodes(node))))

    def resolver_chain(node):
        """The attributes after a literal RESOLVER root, or an empty tuple."""
        attrs = []
        while isinstance(node, ast.Attribute):
            attrs.append(node.attr)
            node = node.value
        if isinstance(node, ast.Name) and node.id == "RESOLVER":
            return tuple(reversed(attrs))
        return ()

    def target_names(node):
        if isinstance(node, ast.Name):
            return {node.id}
        if isinstance(node, (ast.Tuple, ast.List)):
            return set().union(*(target_names(item) for item in node.elts))
        return set()

    def assignment_parts(node):
        if isinstance(node, ast.Assign):
            return node.targets, node.value
        if isinstance(node, ast.AnnAssign) and node.value is not None:
            return (node.target,), node.value
        if isinstance(node, ast.NamedExpr):
            return (node.target,), node.value
        return (), None

    resolver_calls = defaultdict(set)
    resolver_attributes = defaultdict(set)
    resolver_aliases = []
    resolver_chains = []
    for owner, function in production_functions.items():
        nodes = tuple(scoped_nodes(function))
        aliases = {"RESOLVER"}
        changed = True
        while changed:
            changed = False
            for node in nodes:
                targets, value = assignment_parts(node)
                if value is None:
                    continue
                alias_source = (value.id if isinstance(value, ast.Name)
                                and value.id in aliases else None)
                chain = resolver_chain(value)
                if not alias_source and not chain:
                    continue
                for target in set().union(*(target_names(item) for item in targets)):
                    if target not in aliases:
                        aliases.add(target)
                        changed = True
                        spelling = alias_source or "RESOLVER." + ".".join(chain)
                        resolver_aliases.append(
                            f"{owner}:{target}={spelling} at line {node.lineno}")

        direct_call_targets = {
            id(node.func) for node in nodes
            if isinstance(node, ast.Call) and resolver_chain(node.func)
        }
        for node in nodes:
            if isinstance(node, ast.Call):
                chain = resolver_chain(node.func)
                if len(chain) == 1:
                    resolver_calls[chain[0]].add(owner)
                elif isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name) \
                        and node.func.value.id in aliases - {"RESOLVER"}:
                    resolver_aliases.append(
                        f"{owner}:{node.func.value.id}.{node.func.attr}() at line {node.lineno}")
                elif isinstance(node.func, ast.Name) and node.func.id in aliases - {"RESOLVER"}:
                    resolver_aliases.append(
                        f"{owner}:{node.func.id}() at line {node.lineno}")
            if not isinstance(node, ast.Attribute):
                continue
            chain = resolver_chain(node)
            if len(chain) > 1:
                resolver_chains.append(
                    f"{owner}:RESOLVER.{'.'.join(chain)} at line {node.lineno}")
            elif len(chain) == 1 and id(node) not in direct_call_targets:
                resolver_attributes[chain[0]].add(owner)

    def literal_map_shape(name):
        """Whether one named top-level map is a string-to-string-tuples literal."""
        values = []
        for node in tree.body:
            targets, value = assignment_parts(node)
            if name in set().union(*(target_names(target) for target in targets)):
                values.append(value)
        if len(values) != 1 or not isinstance(values[0], ast.Dict):
            return False
        return all(isinstance(key, ast.Constant) and isinstance(key.value, str)
                   and isinstance(value, ast.Tuple)
                   and all(isinstance(item, ast.Constant) and isinstance(item.value, str)
                           for item in value.elts)
                   for key, value in zip(values[0].keys, values[0].values))

    resolver_methods = {
        node.name: node for node in resolver_node.body
        if isinstance(node, ast.FunctionDef)
    }
    rewriter_methods = {
        node.name: node for node in rewriter_node.body
        if isinstance(node, ast.FunctionDef)
    }
    resolver_public_methods = {
        name for name in resolver_methods if not name.startswith("_")
    }

    # -- structural
    dupes = [n for n in ("_resolve_transcript", "_socket_alive", "_runtime",
                         "_agent_runtime", "_team_runtime", "_lead_process",
                         "_stamp_index", "_process_table", "_session_registry")
             if sum(1 for f in ast.walk(tree) if isinstance(f, ast.FunctionDef)
                    and f.name == n and not is_delegate(f)) != 1]

    # What the units read. The rest of what this function binds is read here,
    # through the closures that need it: callers_of holds _calls_in, src_of
    # holds _segments and _source_lines, and is_delegate is called by funcs and
    # by dupes above.
    s.ast = ast
    s.callers_of = callers_of
    s.corpus_engine = corpus_engine
    s.literal_map_shape = literal_map_shape
    s.resolver_aliases = resolver_aliases
    s.resolver_attributes = resolver_attributes
    s.resolver_calls = resolver_calls
    s.resolver_chains = resolver_chains
    s.resolver_methods = resolver_methods
    s.rewriter_methods = rewriter_methods
    s.resolver_public_methods = resolver_public_methods
    s.dupes = dupes
    s.indexed_function_faults = indexed_function_faults
    s.funcs = funcs
    s.source = source
    s.src_of = src_of
    s.tempfile = tempfile
    s.tree = tree
    return s


@unit(
    ('suite-classification-recognizes-fixtures', 'both contexts recognize registered units and designated helpers'),
    ('suite-classification-keeps-production-checked', 'fixture exemptions do not excuse a production private-reader call'),
    ('suite-classification-scans-fixture-names', 'recognized fixtures are checked for shared machine-global names'),
)
def _check_suite_function_classification(s):
    from unittest import mock

    recognized = 'suite-classification-recognizes-fixtures'
    production = 'suite-classification-keeps-production-checked'
    scanning = 'suite-classification-scans-fixture-names'
    faults = {cid: [] for cid in (recognized, production, scanning)}

    def contexts(source):
        # Exercise both constructors without running a child suite or a live fixture.
        child = types.SimpleNamespace(stdout='0/0 checks passed\n', stderr='', returncode=0)
        with mock.patch.object(Path, 'read_text', return_value=source), \
                mock.patch('subprocess.run', side_effect=AssertionError('classification started a process')):
            read_only = _suite_context()
            live = _live_context(child)
        # The live context does not parse source. Give its classification the same
        # synthetic AST and call index, keeping the classifier's result unchanged.
        for key in ('ast', 'tree', 'funcs', 'src_of', 'callers_of'):
            setattr(live, key, getattr(read_only, key))
        return (('read-only', read_only), ('live', live))

    def exercise(cid, label, name, body, run, expected):
        source = ('class Resolver:\n    pass\nclass TranscriptRewriter:\n    pass\n'
                  'def fixture_line():\n    pass\ndef run_one():\n    pass\n'
                  + f'def {name}():\n' + '\n'.join('    ' + line for line in body.splitlines()) + '\n')
        try:
            selected = contexts(source)
        except (Refusal, Exception) as exc:
            faults[cid].append(f'{label}: context raised {type(exc).__name__}: {exc}')
            return
        for context_name, context in selected:
            try:
                rows = run(context)
                if (len(rows) != 1 or rows[0][2] is not expected
                        or (not expected and name not in rows[0][3])):
                    faults[cid].append(f'{context_name}, {label}: expected {expected}, got {rows!r}')
            except (Refusal, Exception) as exc:
                faults[cid].append(f'{context_name}, {label}: raised {type(exc).__name__}: {exc}')

    def registered_fixture(_s):
        return []

    reader = 'return engine._spawn_records()'
    shared_name = 'agent_id = "fixture@" "selftest-classification"\nreturn agent_id'
    owned_name = 'agent_id = own("fixture@" "selftest-classification")\nreturn agent_id'
    # Replace the registry only for these controls; the running tier retains its
    # original list and must never execute the synthetic registration itself.
    with mock.patch.dict(globals(), UNITS=list(UNITS)):
        exercise(recognized, 'before registration', 'registered_fixture', reader,
                 _check_spawn_payload_one_lookup, False)
        unit(('synthetic-classification-only', 'a temporary classification input'))(registered_fixture)
        exercise(recognized, 'after registration', 'registered_fixture', reader,
                 _check_spawn_payload_one_lookup, True)
        exercise(recognized, 'designated helper', '_roster_test_fixture', reader,
                 _check_spawn_payload_one_lookup, True)
        exercise(production, 'forbidden private reader', 'ordinary_production_reader', reader,
                 _check_spawn_payload_one_lookup, False)
        exercise(production, 'ordinary production function', 'ordinary_production_reader', 'return ()',
                 _check_spawn_payload_one_lookup, True)
        for name in ('registered_fixture', '_roster_test_fixture'):
            exercise(scanning, name + ' with a shared name', name, shared_name,
                     _check_live_fixtures_are_own, False)
            exercise(scanning, name + ' with an owned name', name, owned_name,
                     _check_live_fixtures_are_own, True)
        exercise(scanning, 'production is not a fixture', 'ordinary_production_reader', shared_name,
                 _check_live_fixtures_are_own, True)
        UNITS[:] = [entry for entry in UNITS if entry[2] is not registered_fixture]
