@unit(('refusal-ends-the-run', 'a refused run ends in its refusal, not in the audit'))
def _check_refusal_ends_the_run(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    class _RefusalJob:
        dry_run, no_attach, attach, agent_id, socket = True, False, False, None, None

        def __init__(self, label):
            self.label = label

    took_part, real_one_fn = [], globals()["run_one"]
    # Built out here rather than inside the stub: a noop outcome has one
    # construction site in this file and a check that says so, and a stub is
    # not a second one.
    went_quietly = Outcome("noop", None, False, None)

    def _one_or_refuse(a, p, t, prefix="", pending=(), terminal=None):
        took_part.append(a.label)
        if a.label.startswith("miss"):
            die(f"no transcript found for {a.label}")
        return went_quietly

    def batch(*labels):
        """(code, did it end in a refusal, who was run) for one run_agents."""
        took_part.clear()
        jobs = [(label, _RefusalJob(label)) for label in labels]
        with capturing("out"), capturing("err"):
            try:
                return run_agents(jobs[0][1], [], {}, jobs), False, list(took_part)
            except Refusal as exc:
                return exc.code, True, list(took_part)

    try:
        globals()["run_one"] = _one_or_refuse
        alone = batch("miss")
        whole = batch("found-1")
        partly = batch("miss", "found-2")
    finally:
        globals()["run_one"] = real_one_fn

    # And the seam the refusal has to pass through on its way out. A fat
    # declaration on a run that returned must still die here, as loudly as it
    # does today; a run that raised must reach the raise instead.
    real_engine = globals()["RESOLVER"]
    try:
        globals()["RESOLVER"] = Resolver(needs=Needs(hard={NEED.SPAWNS}))
        try:
            audited(lambda: 0)
            judged = "nothing was refused"
        except RuntimeError as err:
            judged = str(err)
        try:
            with capturing("err"):
                audited(lambda: die("nothing to resume"))
            refused_as = "returned a code"
        except Refusal as exc:
            refused_as = f"exit {exc.code}"
        except RuntimeError:
            refused_as = "the audit"
    finally:
        globals()["RESOLVER"] = real_engine

    ending = {
        "a lone job's refusal ends the run in that refusal": alone == (1, True, ["miss"]),
        "a batch that refused nothing still returns a code": whole == (0, False, ["found-1"]),
        "one member's refusal does not take the rest of the team down":
            partly[2] == ["miss", "found-2"],
        "and the run still ends in it": partly[0] == 1 and partly[1],
        "a verb that did its work is still audited": "SPAWNS" in judged,
        "a verb that refused ends in its refusal, not in the audit": refused_as == "exit 1",
    }
    wrong = sorted(k for k, ok in ending.items() if not ok)
    check("refusal-ends-the-run", "a refused run ends in its refusal, not in the audit",
          not wrong, ", ".join(wrong))
    return checked


@unit(('title-skips-the-harness', 'a title says what the work was, not what command wrapped it'),
      ('title-one-transcript-fact',
       'title parsing has one owner and every resolved title belongs to a transcript fact'))
def _check_title_skips_the_harness(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # A conversation opened with a slash command carries the caveat the harness
    # wraps around it, and the harness titles the file from that, so the title
    # named the tool rather than the work. Both paths to a title are driven
    # here: the title record, which is the one that usually wins, and the first
    # user message, which is what a file with no usable record falls back to.
    caveat = ("<local-command-caveat>Caveat: The messages below were generated "
              "by the user while running local commands.</local-command-caveat>")
    said = "Can you teleport a session into here?"

    def transcript(into, name, records):
        path = into / f"{name}.jsonl"
        path.write_text("\n".join(fixture_line(r)
                                  for r in records) + "\n")
        return path

    def titled(text, uuid):
        return {"type": "custom-title", "customTitle": text,
                "timestamp": "2026-01-01T00:00:01Z", "uuid": uuid}

    def spoken(text, uuid):
        return {"type": "user", "uuid": uuid,
                "message": {"role": "user", "content": text}}

    with tempfile.TemporaryDirectory() as td:
        into = Path(td) / "project"
        into.mkdir()
        # The specimen: the harness titled the file from its own caveat, and
        # the person's first sentence is further down.
        wrapped = transcript(into, "wrapped", [spoken(caveat, "wrapped-caveat"),
                                               spoken(said, "wrapped-user"),
                                               titled(caveat, "wrapped-title")])
        # A title a person typed still wins, or this check would pass just as
        # well against a version that threw every title away.
        chosen = transcript(into, "chosen", [spoken(caveat, "chosen-caveat"),
                                              titled("Rewrite the parser", "chosen-title")])
        # Nothing but machinery: the honest answer is no title, not the caveat.
        only_machinery = transcript(into, "only", [spoken(caveat, "only-caveat"),
                                                    titled(caveat, "only-title")])
        nested = transcript(into, "nested", [
            {"type": "assistant", "message": {"role": "assistant", "content": [{
                "type": "tool_use", "name": "fixture",
                "input": {"type": "custom-title", "customTitle": "Nested spoof"},
            }]}},
            {"type": "ai-title", "aiTitle": 'Real "quoted" \\ title'},
        ])

        eng = Resolver(needs=Needs(hard={NEED.TITLES, NEED.CONVERSION_CENSUS}))
        eng._projects_dir = Path(td)

        def title(path):
            return (eng._transcript_fact(path=path) or {}).get("title")

        runtime = eng._runtime([(
            PID_CEILING + 4242, 1,
            (FAKE_AGENT_BIN, "--resume", chosen.stem, "--agent-id", "title@fixture"),
        )])
        resolution = eng._resolve_transcript(session_uuid=chosen.stem)
        runtime_fact = runtime["by_pid"][PID_CEILING + 4242]["transcript"]
        wrapped_title = title(wrapped)
        chosen_title = title(chosen)
        nested_title = title(nested)
        got = {
            "the caveat does not become the title": title_value(wrapped_title) == said,
            "a title a person typed still wins": title_value(chosen_title) == "Rewrite the parser",
            "machinery alone yields no title": title(only_machinery) is None,
            "nested title objects are not records":
                title_value(nested_title) == 'Real "quoted" \\ title',
            "every selected title is a TitleFact": all(
                isinstance(fact, TitleFact) for fact in
                (wrapped_title, chosen_title, nested_title)),
            "the custom title retains its exact event": (
                chosen_title.kind == "custom-title"
                and chosen_title.source == chosen
                and chosen_title.timestamp is not None
                and chosen_title.record_uuid == "chosen-title"),
        }
    wrong = sorted(k for k, ok in got.items() if not ok)
    check("title-skips-the-harness",
          "a title says what the work was, not what command wrapped it",
          not wrong, ", ".join(wrong))
    title_owners = s.callers_of("_session_title")
    title_event_owners = s.callers_of("_title_event")
    title_window_owners = s.callers_of("_title_events_in")
    fact_immutable = False
    try:
        runtime_fact["title"] = "changed"
    except TypeError:
        fact_immutable = True
    check("title-one-transcript-fact",
          "title parsing has one owner and every resolved title belongs to a transcript fact",
          title_owners == {"_transcript_fact"}
          and title_event_owners == {"_title_events_in"}
          and title_window_owners == {"_session_title"}
          and "TITLE" + "_RE" not in s.source
          and "transcript_title" not in s.funcs and "session_title" not in s.funcs
          and bool(resolution) and runtime_fact is resolution.transcript
          and fact_immutable,
          ", ".join(sorted(title_owners)))
    return checked


