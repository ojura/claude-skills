@unit(('cleanup-clears-a-lock-we-left',
       'the sweep removes a roster lock whose recorded owner is gone, and says so'),
      ('cleanup-keeps-a-lock-that-is-not-ours-to-clear',
       'the sweep leaves every other lock exactly where it is'))
def _check_cleanup_clears_our_own_dead_lock(s):
    """The sweep's half of the leftover a killed run leaves.

    Our lock is a regular file; the harness's is a directory, and it clears one
    it calls stale with rmdir, which answers ENOTDIR on a file. So a lock this
    tool leaves behind is one the harness can never clear, and until this ran the
    only thing that cleared it was another run of this tool wanting the same
    team's lock. Four shapes in four kept teams, in one sweep, because what is
    worth proving is that the sweep tells them apart.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    tempfile = s.tempfile

    lock_sweep = Path(tempfile.mkdtemp())
    real_teams_dir, real_sockets = RESOLVER.teams_dir, RESOLVER.dead_sockets
    try:
        RESOLVER.teams_dir = lock_sweep
        RESOLVER.dead_sockets = lambda: []   # this fixture is about lockfiles

        def with_a_lock(name, shape):
            """A team young enough that the sweep keeps it, holding this lock."""
            (lock_sweep / name / "inboxes").mkdir(parents=True)
            RESOLVER.roster_path(name).write_text(json.dumps(
                {"name": name, "leadAgentId": agent_id_of("team-lead", name),
                 "leadSessionId": "no-such-session-uuid",
                 "members": [{"agentId": agent_id_of("team-lead", name), "name": "team-lead"}]}))
            lock = RESOLVER.lock_for(RESOLVER.roster_path(name))
            if shape is None:
                lock.mkdir()   # the shape the harness's own lock helper makes
            else:
                lock.write_bytes(shape)
            # Old enough that anything deciding by age would take it. Nothing
            # here decides by age, and this is what says so.
            old = time.time() - 86400
            os.utime(lock, (old, old))
            return lock

        ours = {"tool": TOOL, "pid": os.getpid()}
        dead = with_a_lock("session-lock-dead", json.dumps({**ours, "procStart": "1"}).encode())
        live = with_a_lock("session-lock-live", json.dumps(
            {**ours, "procStart": RESOLVER.proc_start(os.getpid())}).encode())
        empty = with_a_lock("session-lock-empty", b"")
        theirs = with_a_lock("session-lock-dir", None)

        with capturing("err"):
            with capturing("out") as previewed:
                run_cleanup(dry=True)
            previewed_still_there = dead.is_file()
            with capturing("out") as swept:
                run_cleanup(dry=False)
            with capturing("out") as again:
                run_cleanup(dry=False)
        preview, acted, quiet = previewed.getvalue(), swept.getvalue(), again.getvalue()
        # Read before the tree goes, or every one of these answers "not there"
        # because the fixture was removed rather than because the sweep took it.
        dead_gone, live_there = not dead.exists(), live.is_file()
        empty_there, theirs_there = empty.is_file(), theirs.is_dir()
    finally:
        RESOLVER.teams_dir, RESOLVER.dead_sockets = real_teams_dir, real_sockets
        shutil.rmtree(lock_sweep, ignore_errors=True)

    cleared = {
        "the preview names the team and the pid that left it":
            "session-lock-dead" in preview and f"pid {os.getpid()}" in preview,
        "the preview removes nothing": previewed_still_there,
        "the sweep removes it": dead_gone,
        "the sweep says which team it was": "session-lock-dead" in acted,
        "a sweep with nothing to do stays silent": quiet == "",
    }
    kept = {
        "a live owner's lock stays": live_there,
        "a lock with no owner record stays": empty_there,
        "a directory lock stays": theirs_there,
        "none of them is named as removed":
            not any(name in acted for name in ("session-lock-live", "session-lock-empty",
                                               "session-lock-dir")),
    }
    check("cleanup-clears-a-lock-we-left",
          "the sweep removes a roster lock whose recorded owner is gone, and says so",
          all(cleared.values()), ", ".join(sorted(k for k, ok in cleared.items() if not ok)))
    check("cleanup-keeps-a-lock-that-is-not-ours-to-clear",
          "the sweep leaves every other lock exactly where it is",
          all(kept.values()), ", ".join(sorted(k for k, ok in kept.items() if not ok)))
    return checked


@unit(('sweep-spares-a-held-lock',
       "a team whose roster lock a writer may be inside is not swept"))
def _check_sweep_spares_a_held_lock(s):
    """The other half of the lock question: not whether the lock may go, whether
    the directory around it may.

    A team can be past resurrecting and still have a run of this tool writing its
    roster, and until the lock became an objection the sweep removed the whole
    directory, config.json.lock included, without asking who was inside it. Four
    lock shapes in four teams the sweep would otherwise take, in one sweep,
    because what is worth proving is which three it now keeps and that it still
    takes the fourth.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    tempfile = s.tempfile

    held_sweep = Path(tempfile.mkdtemp())
    real_teams_dir, real_sockets = RESOLVER.teams_dir, RESOLVER.dead_sockets
    aged = time.time() - 86400
    try:
        RESOLVER.teams_dir = held_sweep
        RESOLVER.dead_sockets = lambda: []   # this fixture is about team dirs

        def unresurrectable(name, shape):
            """A team nothing can bring back, holding a lock of this shape.

            Nothing live runs as it, neither its lead nor its member resolves to
            a transcript, and every mtime is a day old, so the only thing left
            between it and the sweep is what its lock says.
            """
            team_dir = held_sweep / name
            (team_dir / "inboxes").mkdir(parents=True)
            (team_dir / "inboxes" / "team-lead.json").write_text("[]")
            RESOLVER.roster_path(name).write_text(json.dumps(
                {"name": name, "leadAgentId": agent_id_of("team-lead", name),
                 "leadSessionId": "no-such-session-uuid",
                 "members": [{"agentId": agent_id_of("team-lead", name), "name": "team-lead"},
                             {"agentId": agent_id_of("nobody-here-at-all", name),
                              "name": "nobody-here-at-all"}]}))
            lock = RESOLVER.lock_for(RESOLVER.roster_path(name))
            if shape is None:
                lock.mkdir()      # the shape the harness's own lock helper makes
            else:
                lock.write_bytes(shape)
            # The directory last: writing into it is what set its mtime, and its
            # mtime is what the sweep's grace period reads.
            for path in (lock, RESOLVER.roster_path(name),
                         team_dir / "inboxes" / "team-lead.json",
                         team_dir / "inboxes", team_dir):
                os.utime(path, (aged, aged))
            return team_dir

        ours = {"tool": TOOL, "pid": os.getpid()}
        planted = [unresurrectable("session-held-live", json.dumps(
                       {**ours, "procStart": RESOLVER.proc_start(os.getpid())}).encode()),
                   unresurrectable("session-held-empty", b""),
                   unresurrectable("session-held-dir", None),
                   unresurrectable("session-held-dead",
                                   json.dumps({**ours, "procStart": "1"}).encode())]

        with capturing("err"):
            with capturing("out") as previewed:
                run_cleanup(dry=True)
            with capturing("out") as swept:
                run_cleanup(dry=False)
        # Wrapped for a terminal on the way out, so the words are read back as
        # one run of them rather than at whatever width this ran under.
        preview = " ".join(previewed.getvalue().split())
        acted = " ".join(swept.getvalue().split())
        # Read before the fixture goes, or every answer below says "not there"
        # because the tree was removed rather than because the sweep took it.
        standing = {team.name: team.is_dir() for team in planted}
    finally:
        RESOLVER.teams_dir, RESOLVER.dead_sockets = real_teams_dir, real_sockets
        shutil.rmtree(held_sweep, ignore_errors=True)

    spared = {
        "a lock a live run holds keeps its team": standing["session-held-live"],
        "and the preview says who holds it":
            f"keeping session-held-live: config.json.lock is held by pid {os.getpid()}, "
            "which is running" in preview,
        "a lock with no owner record keeps its team": standing["session-held-empty"],
        "and the preview says why":
            "keeping session-held-empty: config.json.lock carries no owner record, so a "
            "run of this tool is either inside it or was killed inside it" in preview,
        "the harness's own lock keeps its team": standing["session-held-dir"],
        "and the preview names the harness":
            "keeping session-held-dir: config.json.lock is a directory, which is the "
            "harness's own lock on this roster" in preview,
        "none of the three is named as removed":
            not any(name in acted for name in ("session-held-live", "session-held-empty",
                                               "session-held-dir")),
        "a lock whose owner is gone keeps nothing": not standing["session-held-dead"],
        "and the sweep says which team it took": "session-held-dead" in acted,
        "the outcome still comes before the reasons":
            preview.startswith("would remove 1 empty team(s): session-held-dead"),
    }
    check("sweep-spares-a-held-lock",
          "a team whose roster lock a writer may be inside is not swept",
          all(spared.values()), ", ".join(sorted(k for k, ok in spared.items() if not ok)))
    return checked


