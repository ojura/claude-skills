    check("resume-target-has-no-parallel-projections",
          "launch consumers cannot combine fields from removed context projections",
          not parallel and not stale_reads,
          ", ".join(parallel + stale_reads))

    duplicate_fixtures = []
    for name in s.suite_fns:
        node = s.funcs.get(name)
        if not node:
            continue
        for part in s.ast.walk(node):
            if not isinstance(part, s.ast.Dict):
                continue
            for key, value in zip(part.keys, part.values):
                if not (isinstance(key, s.ast.Constant) and key.value == "target"):
                    continue
                if not (isinstance(value, s.ast.Call)
                        and isinstance(value.func, s.ast.Name)
