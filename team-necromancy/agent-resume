    ('regular-receipt-refuses-fork-fields',
     'a regular receipt cannot carry a second grammar representation'),
    ('receipt-previous-record-is-paired',
     'a prior receipt record and its position are present together'),
    ('receipt-side-metadata-is-paired',
     'saved side metadata bytes and mode are present together'),
    ('receipt-required-fields-exact',
     'the current receipt schema has one exact required field set'),
    ('receipt-malformed-values-refused',
     'malformed JSON values are refused instead of raising or passing'),
    ('receipt-optional-fields-have-one-representation',
     'optional receipt fields do not have null or empty no-op representations'),
)
def _check_receipt_conditional_schema(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    member = fixture_receipt(name="member", team="TEAM")
    member.pop("root_stamps")
    member_said = TranscriptRewriter.receipt_objection(member) or ""

    lead = fixture_receipt(name="team-lead", team="TEAM", root_stamps={
        "agentName": [False, None], "teamName": [False, None]})
    lead_said = TranscriptRewriter.receipt_objection(lead) or ""

    forked = fixture_receipt(grammar=SIDE_GRAMMAR_FORK_REFERENCE)
    forked.pop("graft")
    fork_said = TranscriptRewriter.receipt_objection(forked) or ""

    regular = fixture_receipt(graft="g", ref="r", prefix_uuids=["g"])
    regular_said = TranscriptRewriter.receipt_objection(regular) or ""

    previous = fixture_receipt(previous_record="raw")
    previous_said = TranscriptRewriter.receipt_objection(previous) or ""

    side_meta = fixture_receipt(side_meta_b64="")
    side_meta_said = TranscriptRewriter.receipt_objection(side_meta) or ""

    malformed = []

    def malformed_case(label, alter):
        receipt = fixture_receipt()
        alter(receipt)
        try:
            said = TranscriptRewriter.receipt_objection(receipt)
        except Exception as err:
            malformed.append(f"{label} raised {type(err).__name__}: {err}")
        else:
            if not said:
                malformed.append(f"{label} was accepted")

    malformed_case("boolean schema version",
                   lambda receipt: receipt.update(schema_version=True))
    malformed_case("list grammar",
                   lambda receipt: receipt.update(grammar=[]))
    malformed_case("unhashable wrapper version",
                   lambda receipt: receipt["visible_human_wrapper_edits"].update(
                       original_payloads=[[[], "text"]]))
    malformed_case("unhashable newline style",
                   lambda receipt: receipt["source_newline"].update(line=[]))
    malformed_case("boolean payload reference",
                   lambda receipt: receipt.update(
                       unwrapped=True,
                       visible_human_wrapper_edits={
                           "original_payloads": [["current", "text"]],
                           "intervals": [["first", "last", [True]]],
                       }))
    malformed_case("unwrapped interval without payload references",
                   lambda receipt: receipt.update(
                       unwrapped=True,
                       visible_human_wrapper_edits={
                           "original_payloads": [],
                           "intervals": [["first", "last", []]],
                       }))
    malformed_case("boolean previous position",
                   lambda receipt: receipt.update(
                       previous_record="raw", previous_position=True))
    malformed_case("negative stripped position",
                   lambda receipt: receipt.update(stripped=[[-1, "raw"]]))
    malformed_case("empty stripped record",
                   lambda receipt: receipt.update(stripped=[[0, ""]]))
    malformed_case("invalid side metadata encoding",
                   lambda receipt: receipt.update(
                       side_meta_b64="%%%", side_meta_mode=0o600))
    malformed_case("boolean side metadata mode",
                   lambda receipt: receipt.update(
                       side_meta_b64="", side_meta_mode=True))
    malformed_case("duplicate copied uuid",
                   lambda receipt: receipt.update(
                       grammar=SIDE_GRAMMAR_FORK_REFERENCE, graft="graft", ref="raw",
                       prefix_uuids=["same", "same"]))
    malformed_case("absent root stamp carrying a value",
                   lambda receipt: receipt.update(
                       name="member", team="TEAM",
                       root_stamps={"agentName": [False, "unused"],
                                    "teamName": [False, None]}))
    optional_forms = {
        "null side metadata": TranscriptRewriter.receipt_objection(
            fixture_receipt(side_meta_b64=None)) or "",
        "empty inserted UUIDs": TranscriptRewriter.receipt_objection(
            fixture_receipt(inserted_sidechain=[])) or "",
        "empty stripped records": TranscriptRewriter.receipt_objection(
            fixture_receipt(stripped=[])) or "",
        "empty demotion root": TranscriptRewriter.receipt_objection(
            fixture_receipt(direction="demote", root="")) or "",
        "empty previous record": TranscriptRewriter.receipt_objection(
            fixture_receipt(previous_record="", previous_position=0)) or "",
    }

    check("member-receipt-requires-root-stamps",
          "a member receipt carries the data needed to reverse root stamping",
          "must carry root_stamps" in member_said, member_said)
    check("lead-receipt-refuses-root-stamps",
          "a lead receipt cannot carry member-only root restoration data",
          "must not carry root_stamps" in lead_said, lead_said)
    check("fork-receipt-requires-prefix-fields",
          "a fork-reference receipt carries its copied-prefix identity",
          "missing its copied-prefix fields" in fork_said, fork_said)
    check("regular-receipt-refuses-fork-fields",
          "a regular receipt cannot carry a second grammar representation",
          "carries fork-reference fields" in regular_said, regular_said)
    check("receipt-previous-record-is-paired",
          "a prior receipt record and its position are present together",
          "must pair previous_record" in previous_said, previous_said)
    check("receipt-side-metadata-is-paired",
          "saved side metadata bytes and mode are present together",
          "must pair side_meta_b64 and side_meta_mode" in side_meta_said,
          side_meta_said)
    expected_required = {
        "dest_stem", "direction", "grammar", "parent", "root", "schema_version",
        "source_newline", "task_id", "unwrapped", "visible_human_wrapper_edits",
    }
    check("receipt-required-fields-exact",
          "the current receipt schema has one exact required field set",
          RECEIPT_REQUIRED == expected_required,
          repr(sorted(RECEIPT_REQUIRED ^ expected_required)))
    check("receipt-malformed-values-refused",
          "malformed JSON values are refused instead of raising or passing",
          not malformed, "; ".join(malformed))
    optional_ok = ("omit empty optional fields side_meta_b64"
                   in optional_forms["null side metadata"]
                   and "invalid inserted_sidechain"
                   in optional_forms["empty inserted UUIDs"]
                   and "invalid stripped" in optional_forms["empty stripped records"]
                   and "invalid root" in optional_forms["empty demotion root"]
                   and "invalid previous_record"
                   in optional_forms["empty previous record"])
    check("receipt-optional-fields-have-one-representation",
          "optional receipt fields do not have null or empty no-op representations",
          optional_ok, repr(optional_forms))
    return checked


