@unit(('attach-prompt-keys', 'the attach prompt does what each key says'))
def _check_attach_prompt_keys(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    real_key, real_abort, real_stdin = read_one_key, abort_agents, sys.stdin
    real_resolver = globals()["RESOLVER"]
    selected_stop = immutable({"objection": None, "targets": ("selected",)})
    aborted, stop_requests = [], []
    globals()["RESOLVER"] = types.SimpleNamespace(
        stop_plan=lambda **kwargs: stop_requests.append(kwargs) or selected_stop)
    globals()["abort_agents"] = (
        lambda plan, assume_yes=False: aborted.append((plan, assume_yes)) or 0)
    started = (Seat("sock", "%3"),)
    keys = {}
    try:
        # confirm_attach asks whether anyone can answer before it asks anything,
        # so a check for what the keys do has to look like a terminal.
        sys.stdin = types.SimpleNamespace(isatty=lambda: True)
        for name, key, want_attach, want_abort in (
                ("a plain key attaches", "\r", True, False),
                ("Ctrl-C skips", "\x03", False, False),
                ("Ctrl-X stops what the run started", "\x18", False, True)):
            globals()["read_one_key"] = (lambda k: (lambda: k))(key)
            aborted.clear()
            stop_requests.clear()
            with capturing("out") as out:
                got = confirm_attach(started, "sock")
            keys[name] = (
                got == want_attach and bool(aborted) == want_abort
                and "Ctrl-X to stop the 1 agent(s) this run started" in out.getvalue()
                and (not want_abort or (
                    stop_requests == [{"seats": started}]
                    and aborted == [(selected_stop, True)])))
        # A run that only found its agents already running started nothing, so
        # the prompt offers no Ctrl-X and the key stops nothing.
        globals()["read_one_key"] = lambda: "\x18"
        aborted.clear()
        stop_requests.clear()
        with capturing("out") as out:
            got = confirm_attach((), "sock")
        keys["Ctrl-X stops nothing when the run started nothing"] = (
            got is False and not aborted and not stop_requests
            and "Ctrl-X" not in out.getvalue().splitlines()[0])
        sys.stdin = types.SimpleNamespace(isatty=lambda: False)
        with capturing("out") as out:
            keys["no terminal does not prompt"] = (
                confirm_attach(started, "sock") and not out.getvalue())
    finally:
        globals()["read_one_key"], globals()["abort_agents"] = real_key, real_abort
        globals()["RESOLVER"] = real_resolver
        sys.stdin = real_stdin
    wrong = sorted(k for k, good in keys.items() if not good)
    check("attach-prompt-keys", "the attach prompt does what each key says", not wrong, ", ".join(wrong))

    s.name = name
    return checked


