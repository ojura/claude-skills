def rebuild_team(ctx, dry, evidence=None):
    """Reconstruct a missing team directory from resolved transcript evidence."""
    record = RESOLVER.roster_record(ctx)
    team, name = record["team"], record["name"]
    if not team or not (name or ctx.get("leads_team")):
        return
    if RESOLVER.has_roster(team):
        return
    cfg = RESOLVER.roster_path(team)
    now = int(time.time() * 1000)
    lead_sid = record["parentSession"]
    if name == "team-lead" or ctx.get("leads_team"):
        # Lead reconstruction records the resumed transcript in leadSessionId and
        # recreates member entries from the lead's spawn records. Those records
        # preserve each member's color, type, and model after roster cleanup.
        members = [{
            "agentId": agent_id_of("team-lead", team),
            "name": "team-lead",
            "agentType": "team-lead",
            "joinedAt": now,
            "tmuxPaneId": "leader",
            **({"cwd": record["cwd"]} if record.get("cwd") else {}),
            "subscriptions": [],
            "backendType": "in-process",
        }]
        for payload in RESOLVER.members_spawned_into(ctx["target"]["session"], team):
            entry = {
                "agentId": payload.get("agent_id") or agent_id_of(payload["name"], team),
                "name": payload["name"],
                "joinedAt": now,
                "tmuxPaneId": payload.get("tmux_pane_id") or "",
                "subscriptions": [],
                "agentType": payload.get("agent_type") or DEFAULT_AGENT_TYPE,
                "planModeRequired": bool(payload.get("plan_mode_required")),
                "backendType": "tmux",
                "isActive": False,
            }
            for key in ("color", "model"):
                if payload.get(key):
                    entry[key] = payload[key]
            members.append(entry)
        config = {
            "name": team,
            "createdAt": now,
            "leadAgentId": agent_id_of("team-lead", team),
            # Resolver treats leadSessionId as exact evidence. Write it only for a
            # corroborated lead; an empty value keeps later resolution on the
            # corroboration path. `evidence` carries that structured verdict, while
            # The target's selection reason describes the explicit UUID used here.
            "leadSessionId": "" if evidence and not evidence["corroborated"]
                             else ctx["target"]["session"],
            "members": members,
        }
        rebuilt = ", ".join(m["name"] for m in members[1:]) or "no members recovered"
        ctx["lead_agent_id"] = agent_id_of("team-lead", team)
        if dry:
            step(True, f"would rebuild {cfg} (lead + {rebuilt}) and seed every inbox", "")
            # Returned in both modes so a dry run previews the same roster a real
            # run would proceed on. Enumerating it separately for the preview
            # would be a second implementation, free to drift from this one.
            return config
        RESOLVER.inboxes_in(cfg.parent).mkdir(parents=True, exist_ok=True)
        edit_team_config(cfg, lambda _: config, f"rebuilt for the lead being resumed ({rebuilt})",
                         create=config)
        for member in members:
            ensure_inbox(team, member["name"], dry)
        return config
    member = {
        "agentId": record["agentId"],
        "name": name,
        "joinedAt": now,
        "tmuxPaneId": "",
        "subscriptions": [],
        "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
        "planModeRequired": bool(record.get("planModeRequired")),
        **({"cwd": record["cwd"]} if record.get("cwd") else {}),
        "backendType": "tmux",
        "isActive": False,
    }
    member.update({k: record[k] for k in SYNCED_FIELDS if record.get(k)})
    config = {
        "name": team,
        "createdAt": now,
        "leadAgentId": agent_id_of("team-lead", team),
        "leadSessionId": lead_sid,
        "members": [
            {
                "agentId": agent_id_of("team-lead", team),
                "name": "team-lead",
                "agentType": "team-lead",
                "joinedAt": now,
                "tmuxPaneId": "leader",
                **({"cwd": record["cwd"]} if record.get("cwd") else {}),
                "subscriptions": [],
                "backendType": "in-process",
            },
            member,
        ],
    }
    if dry:
        step(True, f"would rebuild {cfg} (lead + {name}) and seed both inboxes", "")
        return
    RESOLVER.inboxes_in(cfg.parent).mkdir(parents=True, exist_ok=True)
    edit_team_config(cfg, lambda _: config, "rebuilt from transcript evidence", create=config)
    for inbox in ("team-lead", name):
        ensure_inbox(team, inbox, dry)
    # re-resolve so the roster patch after launch has an entry to patch
    matches = [e for e in RESOLVER.scan_teams() if e["member"].get("agentId") == member["agentId"]]
    if matches:
        ctx["team_entry"] = matches[0]
        ctx["lead_agent_id"] = matches[0].get("leadAgentId")


# Roster writes wait for proper-lockfile's 10-second stale interval. Claude Code
# performs synchronous read-modify-write operations under this lock and retries
# for about 0.65 seconds. The longer wait lets an active writer finish before this
# tool reports contention.
LOCK_WAIT_S = 10.0


def drop_lock(lock, seen):
    """Remove a lock only while its bytes still match the inspected record.

    A different process can replace the file between inspection and removal. The
    byte comparison detects that replacement and preserves the new lock. Device
    and inode identity are insufficient because immediate inode reuse occurs on
    this filesystem. The remaining read-to-unlink interval would require every
    remover to hold `flock` on the descriptor across both operations.

    A missing or replaced file returns a benign false result so the caller can
    inspect the current path again.
    """
    try:
        if lock.read_bytes() != seen:
            return False, ""
    except OSError:
        return False, ""
    try:
        lock.unlink()
    except FileNotFoundError:
        return False, ""
    except OSError as exc:
        return False, str(exc)
    return True, ""


@contextlib.contextmanager
def team_lock(cfg, timeout=LOCK_WAIT_S):
    """Hold `config.json.lock` across the complete roster read-modify-write.

    Claude Code and this tool share the lock path. This tool uses a regular file
    containing PID and process start time; Claude Code's proper-lockfile helper
    uses a directory with `mkdir`, `stat`, `utimes`, and `rmdir`. The two forms
    exclude each other through `EEXIST`.

    A regular-file leftover makes Claude Code's `rmdir` return `ENOTDIR`, so later
    tool runs and `--cleanup` remove records whose owners have exited. Contention
    timeout preserves the roster instead of applying an unlocked update.
    """
    lock = RESOLVER.lock_for(cfg)
    # Monotonic, because this is a duration and nothing else. A clock
    # correction landing mid-wait would otherwise lengthen or cut short how
    # long a roster write is prepared to wait for another writer.
    started = time.monotonic()
    handle, said_waiting = None, False
    while handle is None:
        try:
            handle = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            owner, gone, seen = RESOLVER.lock_holder(lock)
            stuck = ""
            # This is the harness's lockfile as much as ours, and whether a lock
            # here may be taken away is the engine's answer, asked here and by
            # the sweep that clears one a killed run left. Anything it does not
            # call gone is waited for, whatever its age.
            if gone:
                took, stuck = drop_lock(lock, seen)
                if took:
                    warn(f"{lock.name} belongs to exited pid {owner['pid']}; removing the stale lock")
                    continue
                if not stuck:
                    # The path disappeared or another run replaced it. Retry the
                    # exclusive create against current filesystem state.
                    continue
                # Stale and still here, and this run may not remove it. Wait it
                # out at the ordinary deadline rather than spinning on a removal
                # that keeps failing, and say what is true instead of calling a
                # process that is gone the holder.
            if stuck:
                situation = (f"belongs to exited pid {owner['pid']}, and removal failed "
                             f"({stuck})")
                remedy = "Remove that file by hand once nothing is writing this roster"
            elif owner:
                situation = f"is held by pid {owner['pid']}"
                remedy = "Run this again once that writer is done"
            elif seen is None:
                situation = ("is a directory, the proper-lockfile representation used "
                             "by Claude Code, so Claude Code owns its lifecycle")
                remedy = "Run this again once that writer is done"
            else:
                # A regular file with an unreadable owner record belongs to this
                # tool's create-to-publish interval or to a process that exited in
                # that interval. Preserve it because a live writer can still own it.
                situation = ("is a file this tool wrote and carries no owner record "
                             "it can read, so it is either a run that has not yet "
                             "published its record or one killed before it could")
                remedy = ("Run this again; if it is still there when no run of this "
                          "tool is going, remove that file by hand")
            if time.monotonic() - started > timeout:
                die(f"{lock} {situation}; it remained held for {timeout:g}s. "
                    f"{cfg.name} remains unchanged and preserves concurrent writer state. "
                    f"{remedy}")
            if not said_waiting and time.monotonic() - started > 1.0:
                # A wait this long is worth explaining while it happens rather
                # than accounting for afterwards.
                warn(f"waiting for {lock.name}, which {situation}")
                said_waiting = True
            time.sleep(0.05)
        except OSError as exc:
            die(f"lock acquisition failed for {lock} ({exc}); {cfg.name} remains unchanged")
    try:
        os.write(handle, json.dumps({"tool": TOOL, "pid": os.getpid(),
                                     "procStart": RESOLVER.proc_start(os.getpid())}).encode())
        yield
    finally:
        # Removed only while the file this descriptor holds is still the file at
        # that name. If our lock is taken away mid-write and another writer
        # creates its own there, what sits at the path is theirs, and unlinking
        # it would hand the lock to a third writer while two are inside it.
        # Device and inode settle that exactly, where a record inside the file
        # could not: the replacement may be a directory, which holds no bytes
        # to read. They are the right test here and the wrong one in drop_lock
        # for a reason worth stating, since the two sit in one file and read as
        # a contradiction otherwise: this descriptor is still open, which keeps
        # the inode allocated and its number out of the pool, so a replacement
        # cannot land on it. A remover holding no descriptor has no such
        # footing, and compares the record's bytes instead.
        try:
            mine, there = os.fstat(handle), os.stat(lock)
            still_ours = (mine.st_dev, mine.st_ino) == (there.st_dev, there.st_ino)
        except OSError:
            still_ours = False
        os.close(handle)
        if still_ours:
            try:
                lock.unlink()
            except OSError as exc:
                # Said rather than swallowed. The file left there names this
                # process, which is alive, so every later roster write from this
                # same run reads a live owner, waits the whole deadline and then
                # refuses. Nothing here can undo that, so the file is named and
                # the reader can remove it.
                warn(f"cannot remove {lock} ({exc}); it names this run, which is "
                     f"still alive, so any further write to {cfg.name} from here "
                     "will wait for it and then refuse. Remove that file by hand")


_BACKED_UP = set()


def edit_team_config(cfg, mutate, note, create=None):
    """Read-modify-write a roster under the harness's lockfile.

    The read happens inside the lock as well, so a harness write landing
    between read and write cannot be overwritten. `mutate(data)` returns the
    new data, or None to make the write a no-op.
    """
    cfg.parent.mkdir(parents=True, exist_ok=True)
    with team_lock(cfg):
        if cfg.exists():
            try:
                data = json.loads(cfg.read_text())
            except ValueError as exc:
                warn(f"{cfg} is not valid JSON ({exc}); leaving it alone")
                return False
        elif create is None:
            warn(f"no roster at {cfg}")
            return False
        else:
            data = create

        data = mutate(data)
        if data is None:
            return False

        suffix = ""
        if cfg.exists():
            # One backup per run: the pre-run state, not a mid-run write.
            backup = cfg.with_suffix(f".json.bak-{TOOL}")
            if str(cfg) not in _BACKED_UP:
                backup.write_text(cfg.read_text())
                _BACKED_UP.add(str(cfg))
            suffix = f" (backup: {backup.name})"
        tmp = cfg.with_suffix(f".json.tmp-{TOOL}")
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        os.replace(tmp, cfg)
    print(f"  {note} {cfg}{suffix}")
    return True


def ensure_inbox(team, name, dry):
    """A zero-byte inbox is a parse error that wedges both reader and writer."""
    if not team or not name:
        return
    if RESOLVER.inbox_seeded(team, name):
        return
    path = RESOLVER.inbox_path(team, name)
    if dry:
        step(True, f"would seed {path} with []", "")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("[]")
    step(False, "", f"seeded {path} with []")


def register_member(record, pane, dry, alive=True):
    """Write this member into the roster, inserting it if absent (Recipe 1b).

    SendMessage's roster fallback reads this file at send time, so the entry is
    what makes the member addressable from the live lead.

    The record says both what to write and where: on a rebind the engine has
    already reprojected the id onto the destination team.

    Returns what this write found where it wrote, so a run that fails after it
    can put that back, or None when it wrote nothing. Both outcomes matter and
    they are not the same undo: an entry this call inserted has to go, and one
    it only updated has to go back to the values it had.
    """
    team = record.get("team")
    name = record.get("name")
    agent_id = record["agentId"]
    cfg = RESOLVER.roster_path(team)
    found = []

    def mutate(data):
        if agent_id == data.get("leadAgentId"):
            warn(f"refusing to register the lead {agent_id} as a pane-backed member")
            return None
        member = next((m for m in data.get("members", []) if m.get("agentId") == agent_id), None)
        found.append(copy.deepcopy(member))
        if member is None:
            member = {
                "agentId": agent_id,
                "name": name,
                "joinedAt": int(time.time() * 1000),
                "subscriptions": [],
                "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
                "planModeRequired": bool(record.get("planModeRequired")),
                **({"cwd": record["cwd"]} if record.get("cwd") else {}),
            }
            data.setdefault("members", []).append(member)
        member.update({k: record[k] for k in SYNCED_FIELDS if record.get(k)})
        member.update({"tmuxPaneId": pane or "", "backendType": "tmux", "isActive": alive})
        return data

    if dry:
        step(True, f"would register {agent_id} in {cfg}", "")
        return None
    if not edit_team_config(cfg, mutate, f"registered {agent_id} in"):
        return None
    ensure_inbox(team, name, dry)
    return {"cfg": cfg, "agentId": agent_id, "found": found[0]}


def reserve_member(record, dry):
    """Claim this member's roster entry before its process starts.

    The harness spawns this way too, verified in the 2.1.220 bundle: a bare
    entry pushed under the roster lock, then a second locked write patching in
    the pane and backend once the seat exists. Its reason is atomic identity
    allocation, so two concurrent spawns cannot claim one name, with the
    reservation rolled back if the spawn dies. The reason here is different and
    also real: the harness looks a member up by name in the roster as it boots,
    and a boot that does not find itself listed initialises no idle hook, so
    the member runs and answers mail but never reports itself idle. Writing the
    entry only after the spawn leaves that lookup racing the launch.

    Bare means without the two facts that do not exist yet, the pane and the
    backend. Everything already known travels now.

    Returns True only when this run actually inserted the entry. That is what
    makes the rollback safe: an entry that was already there is not ours to
    remove.
    """
    agent_id = record["agentId"]
    cfg = RESOLVER.roster_path(record.get("team"))
    inserted = []

    def mutate(data):
        if agent_id == data.get("leadAgentId"):
            return None  # a lead is not a pane-backed member; the commit phase says so
        if any(m.get("agentId") == agent_id for m in data.get("members", [])):
            return None  # already listed: nothing to claim, and nothing to roll back
        data.setdefault("members", []).append({
            "agentId": agent_id,
            "name": record.get("name"),
            "joinedAt": int(time.time() * 1000),
            "subscriptions": [],
            "planModeRequired": bool(record.get("planModeRequired")),
            **({"cwd": record["cwd"]} if record.get("cwd") else {}),
            **{k: record[k] for k in SYNCED_FIELDS if record.get(k)},
            "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
        })
        inserted.append(agent_id)
        return data

    if dry:
        # Stated even though most runs re-resume an already listed member and
        # write nothing here, because a preview that hides a write is worse
        # than one that mentions a write that turns out to be unnecessary.
        step(True, f"would claim {agent_id} in {cfg} before the launch, "
                   f"if it is not listed yet", "")
        return False
    edit_team_config(cfg, mutate, f"claimed {agent_id} in")
    return bool(inserted)


def release_member(record, dry):
    """Take back a reservation whose launch never happened.

    Only ever called for an entry this run inserted, so it removes rather than
    marking inactive: the member did not fail, it never existed. A launch that
    fails after the process is up keeps its entry instead and records what it
    found, which is the harness's rule too.
    """
    agent_id = record["agentId"]
    cfg = RESOLVER.roster_path(record.get("team"))

    def mutate(data):
        members = data.get("members", [])
        kept = [m for m in members if m.get("agentId") != agent_id]
        if len(kept) == len(members):
            return None
        data["members"] = kept
        return data

    if dry:
        step(True, f"would release the claim on {agent_id} in {cfg}", "")
        return
    edit_team_config(cfg, mutate, f"released the claim on {agent_id} in")


def retire_member(ctx, dry):
    """Mark the source-team entry inactive after a rebind, so the abandoned
    roster stops claiming a live member."""
    entry = ctx.get("source_team_entry") or ctx.get("team_entry")
    if not entry:
        return
    cfg = entry["cfg"]
    agent_id = entry["member"].get("agentId")

    def mutate(data):
        changed = False
        for member in data.get("members", []):
            if member.get("agentId") == agent_id and member.get("isActive"):
                member["isActive"] = False
                changed = True
        return data if changed else None

    if dry:
        step(True, f"would retire {agent_id} in {cfg}", "")
        return
    edit_team_config(cfg, mutate, f"retired {agent_id} in")


def update_team_config(ctx, record, pane, dry, alive=True):
    """Sync an existing roster entry and return its rollback snapshot."""
    entry = ctx["team_entry"]
    if not entry:
        return None
    cfg = entry["cfg"]
    agent_id = entry["member"].get("agentId")
    found = []

    def mutate(data):
        if agent_id and agent_id == data.get("leadAgentId"):
            # A lead is never pane-backed. Writing tmux/%N onto its entry points
            # the harness's exit reaper (which kills members with a pane-type
            # backend) at a pane id that belongs to somebody else.
            warn(f"refusing to write pane-backed fields onto the lead entry {agent_id}")
            return None
        changed = False
        for member in data.get("members", []):
            if member.get("agentId") != agent_id:
                continue
            was = copy.deepcopy(member)
            # Sync every launch-owned field so the roster describes the running
            # process, including bracketed model variants such as `[1m]`.
            updates = [("tmuxPaneId", pane), ("backendType", "tmux"), ("isActive", alive)]
            updates += [(k, record[k]) for k in SYNCED_FIELDS if record.get(k)]
            for key, value in updates:
                if value is not None and member.get(key) != value:
                    member[key] = value
                    changed = True
            if changed and not found:
                found.append(was)
        return data if changed else None

    if dry:
        step(True, f"would update {cfg}", "")
        return None
    if not edit_team_config(cfg, mutate, "updated") or not found:
        return None
    return {"cfg": cfg, "agentId": agent_id, "found": found[0]}


def restore_member(undo):
    """Restore the roster snapshot after a failed launch.

    Inserted entries are removed; updated entries regain their saved values.
    Dry-run returns before this path. Seeded mailboxes remain because they can
    contain messages by the time rollback runs.
    """
    if not undo:
        return
    cfg, agent_id, found = undo["cfg"], undo["agentId"], undo["found"]

    def mutate(data):
        members = data.get("members", [])
        at = [i for i, m in enumerate(members) if m.get("agentId") == agent_id]
        if not at:
            # A concurrent writer already removed the entry, so rollback is complete.
            return None
        if found is None:
            data["members"] = [m for i, m in enumerate(members) if i not in set(at)]
            return data
        if all(m == found for m in (members[i] for i in at)):
            return None
        for i in at:
            members[i] = copy.deepcopy(found)
        return data

    edit_team_config(cfg, mutate,
                     f"took back the entry it wrote for {agent_id} in" if found is None
                     else f"put {agent_id} back as this run found it in")


def unwind_launch(undo, agent_id):
    """Roll back roster changes after cwd entry or exec failure.

    A rollback lock failure leaves the entry listed and emits a warning; the
    original launch failure remains the terminating error.
    """
    try:
        restore_member(undo)
    except Refusal:
        warn(f"{undo['cfg']} still lists {agent_id} as active, "
             "for a process that never started")


def exec_failed(undo, agent_id, command, exc):
    """Restore roster state and terminate with the exec error."""
    unwind_launch(undo, agent_id)
    die(f"cannot exec {command[0]}: {exc}")


def become_agent(ctx, command, prefix, undo=None):
    """Prepare environment and cwd, then replace this process with the agent.

    In-pane members, `--here` members, and foreground leads share this path.
    `TEAM_ENV` activates flag-bound identity independently of the invoking shell.
    Member routes pass a roster rollback snapshot; cwd or exec failure restores
    it before reporting the original error. Lead reconstruction remains available
    for retry.
    """
    agent_id = ctx["target"]["identity"]["agentId"]
    environ = dict(os.environ)
    if poison_said(environ.get("ANTHROPIC_BASE_URL"), "this shell"):
        environ.pop("ANTHROPIC_BASE_URL", None)
    environ.update(pair.split("=", 1) for pair in TEAM_ENV)
    try:
        enter_agent_cwd(ctx, prefix)
    except Refusal:
        unwind_launch(undo, agent_id)
        raise
    try:
        os.execvpe(command[0], command, environ)
    except OSError as exc:
        exec_failed(undo, agent_id, command, exc)


def env_prefixed(command):
    """Return a pasteable command with the environment used by `become_agent`.

    The prefix includes TEAM_ENV and conditionally removes the Recipe 1 poison.
    The printed `-u` records that removal directly.
    """
    scrub = (["-u", "ANTHROPIC_BASE_URL"]
             if base_url_is_poison(os.environ.get("ANTHROPIC_BASE_URL")) else [])
    return ["env", *scrub, *TEAM_ENV, *command]


def claude_binary(args):
    """Return `--claude-bin` or the current `claude` executable on PATH.

    Current PATH selection avoids stale transcript-version and
    CLAUDE_CODE_EXECPATH values.
    """
    if args.claude_bin:
        return args.claude_bin
    from shutil import which

    return which("claude") or "claude"


def build_command(ctx, args, passthrough):
    user_flags = {a.split("=", 1)[0] for a in passthrough if a.startswith("-")}
    cmd = [claude_binary(args), "--resume", ctx["target"]["session"]]

    # --bare emits the executable, --resume, and explicit passthrough flags. It
    # excludes derived identity, model, effort, and permission settings.
    if getattr(args, "bare", False):
        return cmd + passthrough

    identity_flags = {
        flag for flag, field in DERIVED_FLAGS.items()
        if field in IDENTITY_FIELDS
    }
    conflicting = sorted(user_flags & identity_flags)
    if conflicting:
        die("identity passthrough flags would bypass the resolved identity: "
            + ", ".join(conflicting)
            + "; use --agent-id or --into-team")

    for flag, field in DERIVED_FLAGS.items():
        if flag in user_flags:
            continue
        value = RESOLVER.field(ctx, field)
        if not value:
            continue
        # A lead launched through teammate identity omits agent type and parent:
        # `team-lead` is the roster role, and the lead is its own session parent.
        if flag == "--agent-type" and value == "team-lead":
            continue
        if flag == "--parent-session-id" and value == ctx["target"]["session"]:
            continue
        cmd += [flag, str(value)]

    mode = RESOLVER.field(ctx, "permissionMode")
    if mode and not user_flags & {"--permission-mode", "--dangerously-skip-permissions"}:
        if mode == "bypassPermissions":
            cmd.append("--dangerously-skip-permissions")
        elif mode not in ("default", "normal"):
            cmd += ["--permission-mode", mode]

    return cmd + passthrough


# How wide the value column may grow before a long value is allowed to push
# the tag and time out of line on its own row. A cwd or a system prompt is
# longer than every other value put together, and padding to it would leave
# the table mostly blanks.
EXPLAIN_VALUE = 46


def explain(ctx):
    """Every assembled field, where it came from, and what disagreed.

    Sources are tagged rather than repeated. A few sources answer most fields, so a column
    carrying each source's full text is that text written down the page; the
    legend carries it once and the rows carry a letter.

    The legend prints whatever the merge called each source. What that is
    follows one rule, stated where the sources are added: the object, in the
    spelling the rest of this report uses for it.
    """
    merged = ctx["merged"]
    print("resolved fields (most recent source wins):")
    tags, rows = {}, []

    def tag(source):
        source = str(source)
        if source not in tags:
            # Letters while there are letters. More than 26 distinct sources
            # has never happened; a numbered tag is what it would get.
            tags[source] = chr(ord("A") + len(tags)) if len(tags) < 26 else f"S{len(tags)}"
        return source

    # Effective identity may intentionally override every identity row. Its
    # evidence still belongs in the explanation, so the legend names every
    # candidate source even when no row selects it.
    fields = set(merged.cands)
    if ctx.get("target"):
        fields |= set(IDENTITY_FIELDS) | {"cwd"}
    for field in sorted(merged.cands):
        for _value, _ts, source in merged.cands[field]:
            tag(source)
    for field in sorted(fields):
        _value, _ts, source = RESOLVER.provenance(ctx, field)
        tag(source)
    for field in sorted(fields):
        value, ts, source = RESOLVER.provenance(ctx, field)
        source = tag(source)
        conflict = merged.conflicts(field)
        mark = "  <- conflict: " + ", ".join(sorted(str(c) for c in conflict)) if len(conflict) > 1 else ""
        rows.append((field, "-" if value is None else str(value), tags[source], ts, mark))
    label = max((len(tag) for tag in tags.values()), default=1)
    for at, (source, tag) in enumerate(tags.items()):
        print(f"  {'sources' if not at else '':<7}  {tag:<{label}}  {source}")
    width = max((len(field) for field, *_ in rows), default=8)
    value_width = min(max((len(value) for _f, value, *_ in rows), default=8), EXPLAIN_VALUE)
    for field, value, tag, ts, mark in rows:
        print(f"  {field:<{width}}  {value:<{value_width}}  {tag:<{label}}  {ms_str(ts)}{mark}")
    for path, _, last_ts in ctx["other_transcripts"]:
        # Named the way a source is named, since it is a transcript that could
        # have been one: the session id, not the file it sits in.
        print(f"  (older transcript ignored: {path.stem} @ {ms_str(last_ts)})")


def check_teammate_mode():
    """Warn when settings select an execution mode outside tmux automation."""
    mode = RESOLVER.configured_teammate_mode()
    if mode and mode not in ("tmux", "auto"):
        warn(f"teammateMode is {mode!r}; this command launches tmux panes")


def confirm_redirect(agent_id, pid, dest, source, prefix=""):
    """Offer a redirect the evidence corroborates. True to take it.

    Corroborated means three facts agreeing: this team could only have been
    minted by a resumed life (from disk - a fresh boot's team names its own
    transcript), it is the only such team paired with this process's boot,
    and that process is the only one paired with it. That is why the offer
    defaults to yes; what it still cannot see is a team minted late, outside
    any window centred on boot, which is a gap in coverage rather than a
    choice between candidates. No terminal means no answer, and a launch
    that cannot ask stays on the team it names.
    """
    if RESOLVER.sole_mint_pairing(pid, RESOLVER.runtime()) != dest:
        return False
    if not sys.stdin.isatty():
        warn(f"pid {pid} is this agent's lead and only {dest} matches its boot; "
             f"nothing here can ask, so it stays on {source}")
        return False
    print(f"{prefix}pid {pid} is this agent's lead and runs as {dest}")
    try:
        answer = input(f"redirect {agent_id} onto {dest}? [Y/n] ").strip().lower()
    except EOFError:
        answer = ""
    if answer.startswith("n"):
        print(f"{prefix}staying on {source}")
        return False
    return True


def decline_unreachable(ctx, args, source, dest, prefix=""):
    """The one decision left when a member cannot follow its lead.

    Its mail on the team it can start with is read by nobody, and being
    reachable is what a member's resume is for, so the safe answer is not to
    start it. --keep-team asks for the unreachable launch without the
    question; nothing to ask at means stopping, since silence is not consent.
    """
    agent_id = ctx["target"]["identity"]["agentId"]
    ctx["stale_team_warned"] = True
    if getattr(args, "keep_team", False):
        return
    if not sys.stdin.isatty():
        die(f"so {agent_id} can only start on {source}, whose mail its lead "
            f"(running as {dest}) does not read, and nothing here can ask. "
            "Clear the blockers above, or pass --keep-team")
    try:
        answer = input(f"start {agent_id} on {source} anyway, where its lead "
                       "will not read its mail? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if not answer.startswith("y"):
        die("stopped; clear the blockers above, or pass --keep-team")


def kill_holder(pid, where, args, indent="  "):
    """End the process holding the conversation this run is about to take over.
    True when it is gone.

    One spelling for both paths. A member migrating to another team and a lead
    moving to one do the same thing to the same obstacle: identity is frozen in
    argv at exec, so a move is kill and restart, and two processes must never
    append to one transcript. Written twice, the two would drift, and the one
    that drifted would be the one nobody was watching.

    Ending a conversation cannot be undone, so it is asked for the way --stop
    asks: y/N, --yes skips the question, and nothing to ask at stops the run
    rather than killing something nobody was told about. A dry run prints the
    line and asks nothing, because nothing happens.
    """
    said = f"pid {pid}, which holds this transcript{where}"
    # Asked before the line that says it is happening, so the tense on screen is
    # never ahead of the act.
    if not (args.dry_run or getattr(args, "yes", False)):
        if not sys.stdin.isatty():
            die(f"this move has to end {said}, and nothing here can ask; "
                "pass --yes, or stop it yourself first")
        try:
            answer = input(f"kill {said}? [y/N] ").strip().lower()
        except EOFError:
            answer = ""
        if not answer.startswith("y"):
            die(f"left alone; stop pid {pid} yourself, or pass --yes")
    step(args.dry_run, f"would kill {said}", f"killing {said}", indent=indent)
    if args.dry_run:
        # Every answer below this point comes from a table this run did not
        # change, so the preview says whose liveness it is still counting.
        print(fill(f"{indent}a dry run ends nothing, so what follows is measured "
                   f"with pid {pid} still running"))
        return False
    gone, why = stopped(pid)
    if not gone:
        # Two processes appending to one transcript is the state this prevents,
        # so a kill that did not work has to be said out loud rather than
        # reported as a clean move.
        warn(f"pid {pid} did not die ({why}); "
             "it is still appending to this transcript")
        return False
    # Nothing may answer a liveness question from a table taken before this.
    RESOLVER.refresh_procs()
    return True


def auto_redirect(ctx, args, table, prefix=""):
    """Give a launch the identity of the team the lead actually runs as.

    Two different operations hide behind "rebind". REDIRECT chooses the flags
    for a launch that is happening anyway, and writes roster entries; it kills
    nothing. MIGRATE changes a LIVE member's team, which is necessarily kill
    and restart, because identity is frozen in argv at exec and two processes
    must never append to one transcript.

    The default may redirect. Only an explicit --into-team may migrate, so that
    every killed process traces back to something the user actually asked for.
    Redirect also requires exact evidence: the mint-window join is a heuristic,
    and acting on a heuristic unasked is how "pick the newest" comes back.
    """
    agent_id, source = RESOLVER.field(ctx, "agentId"), RESOLVER.field(ctx, "teamName")
    if args.keep_team or not (agent_id and source):
        return

    lead = RESOLVER.agent_runtime(
        agent_id_of("team-lead", source), table,
        parent_session=RESOLVER.field(ctx, "parentSessionId"))
    pid, dest, exact_team = lead["pid"], lead["runs_as"], lead["runs_as_exact"]
    if not (pid and lead["alive"] and lead["exact"]):
        return
    if not dest or dest == source:
        return

    # Setting to_team below suppresses the guards further down (they are for the
    # explicit path), so this must ask every liveness question they would have.
    # argv is not enough: a session resumed from the in-app picker runs as bare
    # `claude` and is visible only to the registry.
    owner = RESOLVER.runtime(table)["best_by_session"].get(ctx["target"]["session"])
    transcript_holders = ctx["holders"]
    strangers = [(row["pid"], row["session"])
                 for row in transcript_holders["others"]]
    # The strangers half of both questions, for one reason: this decides whether
    # to move, the move restarts the member, and a run cannot restart the process
    # it is running inside. run_one refuses that case by name.
    agent = RESOLVER.agent_runtime(agent_id, table)
    holders = strangers + agent["others"]
    if holders or (owner and owner["alive"]):
        # Alive: leave it to the liveness guards. Say what the move would cost
        # rather than making it, since restarting throws away its current turn.
        who = f"pid {holders[0][0]}" if holders else f"pid {owner['pid']} (registry)"
        diagnosis = RESOLVER.agent_diagnosis(agent_id, RESOLVER.field(ctx, "parentSessionId"))
        fix = "".join(f"\n- {what}  ({cost})" for what, cost in diagnosis["remedies"])
        warn(f"{agent_id} is running as {who}: {diagnosis['reachable'][1]}{fix}")
        ctx["stale_team_warned"] = True
        return

    # A conversation that restores as its own team ignores these flags, so the
    # redirect has to make the move durable or not claim it. Both halves are
    # rebind_reap's: retiring a team nothing is using is cheap, and anything
    # that objects is reported with its own way out.
    path = ctx["target"]["transcript"]["path"]
    stamped, state = RESOLVER.restored_identity(path) if path else (None, None)
    needs_durable = state == "restored" and stamped != dest
    # Read-only, and asked before anyone else is: a move that cannot happen
    # turns the whole exchange into one decision instead of a redirect
    # question, a wall of blockers, and a second question.
    blocked = reap_blockers(stamped, args, table) if needs_durable else []
    if blocked:
        warn(f"{agent_id} cannot follow its lead onto {dest}:\n"
             + "\n".join(blocked))
        return decline_unreachable(ctx, args, source, dest, prefix)

    # Asked last, so a run that was going to decline anyway never puts a question
    # in front of anyone.
    if not exact_team and not confirm_redirect(agent_id, pid, dest, source, prefix):
        return

    if needs_durable and not rebind_reap(stamped, dest, args, prefix,
                                         path=path, fatal=False):
        # rebind_reap has named each blocker with its remedy. What is left is
        # the consequence: this member's lead runs as another team, so its
        # mail on the team it would launch with is read by nobody. Being
        # reachable is what a resume is for, so the run stops rather than
        # starting an agent whose reports go nowhere. --keep-team is the way
        # to ask for that state on purpose.
        return decline_unreachable(ctx, args, source, dest, prefix)

    print(f"{prefix}redirect the lead now runs as {dest}, not {source}; "
          f"launching with that identity (--keep-team to stay)")
    ctx["to_team"], ctx["auto_redirect"] = dest, True
    ctx["to_lead"] = RESOLVER.team_lead_session(dest)
    RESOLVER.set_effective_identity(
        ctx, team=dest, parent=ctx["to_lead"], source="automatic lead redirect")


def record_membership(ctx, args, pane, alive=True):
    """Put this agent in its team's roster, whether or not this run launched it.

    Being listed is what makes a member addressable: a lead delivers mail from
    the members it knows about, so an unlisted one can write to the lead's inbox
    and never be read from it. That is true of an agent already running just as
    much as of one this run started, and a run that noops has still established
    that the agent is there.

    Returns what a rollback would need if the launch this describes never
    happens: the entry written and what stood there before it, or None when no
    roster was written. Only the entry this run wrote is in it. On a rebind the
    source is retired here as well, and that retirement is not part of the undo:
    it says the member is not running in the team it left, which stays true when
    the launch fails, and putting `isActive` back would leave that roster
    claiming a live member for a process that does not exist.
    """
    # A bare resume joins no team, so writing it into a roster would record a
    # membership the launch does not carry. Its inbox is left alone for the
    # same reason: nothing is going to read it under that name.
    if getattr(args, "bare", False):
        return None
    if ctx.get("to_team"):
        undo = register_member(RESOLVER.roster_record(ctx), pane, args.dry_run, alive)
        source = ctx.get("source_team_entry") or ctx.get("team_entry") or {}
        source_id = (source.get("member") or {}).get("agentId")
        _source_name, source_team = name_and_team(source_id)
        if source_team and source_team != RESOLVER.field(ctx, "teamName"):
            retire_member(ctx, args.dry_run)
        return undo
    team = RESOLVER.field(ctx, "teamName")
    ensure_inbox(team, RESOLVER.field(ctx, "agentName"), args.dry_run)
    if args.no_update_config:
        return None
    if ctx.get("team_entry"):
        return update_team_config(ctx, RESOLVER.roster_record(ctx), pane, args.dry_run, alive)
    if RESOLVER.has_roster(team):
        return register_member(RESOLVER.roster_record(ctx), pane, args.dry_run, alive)
    return None


def reserve_membership(ctx, args):
    """The claim half of record_membership, taken before the spawn.

    Routed the same way as the commit, so the two phases cannot disagree about
    which roster this member belongs in. Returns the record that was claimed,
    or None when nothing was, which is exactly what a rollback needs to know.
    """
    if getattr(args, "bare", False):
        return None
    team = ctx.get("to_team")
    if not team:
        # Nothing to claim when the caller asked for no roster write, or when
        # the member is already listed and the commit will patch that entry.
        if args.no_update_config or ctx.get("team_entry"):
            return None
        team = RESOLVER.field(ctx, "teamName")
        if not RESOLVER.has_roster(team):
            return None
    record = RESOLVER.roster_record(ctx)
    return record if reserve_member(record, args.dry_run) else None


def release_membership(record, args):
    """Give back a claim whose launch never happened. No record, nothing to give.

    A roster that refuses the write keeps the claim, and nothing here can change
    that: taking the entry out needs the same lock that was refused. So the
    refusal is reported rather than raised. The caller is on its way to say why
    the launch failed, which is what the reader is here for, and a refusal
    thrown over the top of it would replace that with a message about a file.
    The entry left behind is named instead, so both facts arrive.
    """
    if not record:
        return
    try:
        release_member(record, args.dry_run)
    except Refusal:
        warn(f"{record['agentId']} stays listed in "
             f"{RESOLVER.roster_path(record.get('team'))}, claimed for a launch that did "
             "not happen; resuming that member again takes the entry over")


def report_launch(ctx, command, prefix="", extra=()):
    """The facts a launch reports, whichever way it launches.

    One block, because two kept by hand drift apart: a field living in only
    the member block leaves a lead to exec without ever printing its command.
    What genuinely differs between the paths is the
    mechanism - a pane and a socket, or taking over this terminal - so that
    is what `extra` carries, and everything common is answered here once.
    """
    identity = ctx["target"]["identity"]
    role = "lead" if identity["role"] == "lead" else "agent"
    agent_id = identity["agentId"]
    if not prefix:
        # A single-agent run separates its report from whatever warned above
        # it; a team run's [name] headers already do this.
        print()
    print(f"{prefix}{role:<8} {agent_id or '(unknown)'}")
    # The uuid alone, not the file it lives in. A transcript path is one token
    # fill() cannot break, so it stayed whole and ran far past every other row
    # here, and it only repeated the report: the file is named for the uuid on
    # this row, in a projects directory named for the cwd a few rows below.
    # --explain says which transcript each resolved field was read out of, and
    # names it by this same uuid.
    print(f"{prefix}session  {ctx['target']['session']}")
    print(f"{prefix}via      {ctx['target']['via']}")
    if ctx.get("placed"):
        print(fill(f"{prefix}team     {ctx['placed'][0]}  ({ctx['placed'][1]})"))
    title = bounded_title(ctx["target"]["transcript"].get("title"), 100)
    if title:
        print(fill(f"{prefix}title    {title}"))
    for label, value in extra:
        print(fill(f"{prefix}{label:<8} {value}"))
    # Read off the command rather than a flag, so the row describes the launch
    # actually being reported. Passing no identity is not the same as having
    # none: a conversation whose window start carries stamps is adopted by the
    # harness on the way up, and a reader who typed --bare has every reason to
    # expect otherwise.
    if "--agent-id" not in command:
        said = "no team, name, model or effort is passed"
        path = ctx["target"]["transcript"]["path"]
        stamped, state = RESOLVER.restored_identity(path)
        if state == "restored":
            said += f"; the harness still brings it back as {stamped}, from its own stamps"
        print(fill(f"{prefix}identity {said}"))
    print(wrap_command(command, f"{prefix}command  ", f"{prefix}{'':11}", paste=True))
    # The facts end here and the doing starts. Without the gap the two run
    # together as one wall, and the report is long enough that a reader needs
    # to be told where to stop reading facts.
    print()


def lead_move(ctx, args, dest):
    """Return source team and whether lead migration takes over the transcript.

    Window-start stamps identify a flag-bound source team; lead spawn records
    identify a plain source team. `--into-team` requests takeover and retirement
    of the source identity. The team component of an agent ID addresses the lead
    without requesting migration.
    """
    path = ctx["target"]["transcript"]["path"]
    if not path or not dest:
        return None, False
    stamped, state = RESOLVER.restored_identity(path)
    source = stamped if state else next(iter(RESOLVER.teams_led_by(path.stem)), None)
    if not source or source == dest:
        return None, False
    return source, bool(args.to_team)


def clear_lead_holder(ctx, args, table, prefix=""):
    """Stop current holders before lead migration and return clearance status.

    Stopping the holder first preserves one transcript writer and removes that
    process from later team-retirement objections. Dry-run reports the stop and
    returns the expected cleared state.
    """
    others, ours = RESOLVER.lead_holders(ctx["target"]["session"], table)
    if ours:
        die(f"you are running this transcript yourself (pid {ours[0]}); process "
            "replacement requires an external caller. Run this from another "
            "terminal, or exit that session first")
    cleared = True
    for pid in others:
        # A dry run named the kill and did nothing, which is the preview of a
        # run that would have cleared it; a real kill that did not work has
        # already said so, and leaves the guard below to stop the run.
        cleared = (kill_holder(pid, "", args, indent=prefix + "  ")
                   or args.dry_run) and cleared
    return cleared


def crew_left_behind(source, dest, prefix=""):
    """Render members and mail that retain the source team during lead migration.

    Member processes, transcript stamps, and mailboxes keep their source-team
    identity. The report uses `team_runtime` states and names the per-member move.
    """
    team_state = RESOLVER.team_runtime(source)
    said = []
    for name, (state, _why) in sorted(team_state["population"].items()):
        if name == "team-lead":
            continue
        # Both halves: these are report lines about who stays behind, and a
        # member we are running inside stays behind like any other.
        live = team_state["runtimes"][name]["processes"]
        said.append(f"{name} ({state}"
                    + (f", running as pid {live[0][0]}" if live else "") + ")")
    if said:
        lines = [f"crew     {len(said)} {'stays' if len(said) == 1 else 'stay'} "
                 f"on {source}: " + ", ".join(said)]
    else:
        lines = [f"crew     source team {source} has zero other members"]
    for name, (count, oldest) in sorted(RESOLVER.inbox_state(source).items()):
        if count is None:
            lines.append(f"mail     {name}'s inbox is {oldest}; it stays where it is")
        elif count:
            lines.append(f"mail     {count} waiting for {name} on {source}, "
                         f"oldest {said_when(oldest)}; delivery remains on the source team")
    if said:
        lines.append(f"remedy   --into-team live on each member moves it onto {dest} "
                     "once this lead is running as it, one restart each")
    return [fill(f"{prefix}{line}") for line in lines]


def lead_rebind(ctx, args, source, dest, prefix=""):
    """Apply the durable source-team change for lead migration.

    `--into-team` reaches this function. A loadable stamped source team is retired,
    or `--force` restamps the lead while preserving a live source team. An
    unstamped window already accepts destination argv. The crew report describes
    members that retain source identity.
    """
    ctx["lead_moving"] = dest
    path = ctx["target"]["transcript"]["path"]
    stamped, state = RESOLVER.restored_identity(path) if path else (None, None)
    # Gathered before the reap, because the reap takes the roster and the
    # inboxes it is read from into a receipt, and a report that ran afterwards
    # would call every listed member former and every mailbox empty.
    crew = crew_left_behind(source, dest, prefix)
    route = True
    if state == "restored" and stamped != dest:
        route = rebind_reap(stamped, dest, args, prefix, path=path)
    for line in crew:
        print(line)
    if route == "reaped":
        print(fill(f"{prefix}note     their conversations still restore with stamps "
                   f"naming {source}, whose roster is absent. Plain resume starts a "
                   f"plain session; {TOOL} reapplies member identity flags"))
    elif route == "restamped":
        print(fill(f"{prefix}note     {source} keeps its roster, its mail and its "
                   "members; this conversation is the only thing that moved"))


def run_one(args, passthrough, table, prefix="", pending=()):
    """Resume one agent. Returns Outcome(status, socket, is_lead), status being
    'noop' | 'launched' | 'manual' | 'failed'.

    The socket is whichever server this agent ended up on, or None when it never
    reached one. Only this function knows which, and an agent that noops still
    has a pane worth attaching to, so the caller is told rather than left to
    read it off a field set partway through.

    A refusal is left to propagate. Whether one agent's refusal ends the run is
    a question about the batch, not about this agent, so run_agents answers it.
    """
    ctx = build(args)
    agent_id = RESOLVER.field(ctx, "agentId")

    # A requested placement changes the effective identity before explanations,
    # role handling, command construction, or persistence can read it.
    if args.to_team:
        ctx["to_team"] = resolve_to_team(args, ctx)
        if ctx["target"]["identity"]["role"] == "lead":
            ctx["to_lead"] = ctx["target"]["session"]
        else:
            ctx["to_lead"] = RESOLVER.team_lead_session(ctx["to_team"])
        RESOLVER.set_effective_identity(
            ctx, team=ctx["to_team"], parent=ctx["to_lead"],
            source="explicit --into-team")
        agent_id = RESOLVER.field(ctx, "agentId")

    note_cwd(ctx)

    # Lead recovery runs as the interactive foreground session. The next lead's
    # exit cleanup targets pane members, so this path emits no member pane or
    # roster patch.
    if agent_id and ctx["target"]["identity"]["role"] == "lead":
        # Where a lead is being moved, the destination is resolved before
        # anything is built from it, so the command below is the one that runs.
        # A team named inside the agent id is not a destination and needs none
        # of this: it is already part of the identity being resumed.
        dest = ctx.get("to_team") or RESOLVER.field(ctx, "teamName")
        source, taking_over = lead_move(ctx, args, dest)
        if args.explain:
            explain(ctx)
        command = build_command(ctx, args, passthrough)
        # A lead is the socket's namesake - a swarm server is named after the
        # lead's pid, and members resolve theirs by asking who their lead is -
        # so where its crew already sits is a launch fact for the lead too.
        # Becoming the lead makes this process that pid, which is why the line
        # says which server the crew is on rather than which one it will own.
        lead_team = (ctx.get("placed") or (None,))[0] or RESOLVER.field(ctx, "teamName")
        crew_socket, crew_why = RESOLVER.crew_socket(lead_team, table)
        seat = [("cwd", ctx["target"]["cwd"] or "(inherit)")]
        if crew_socket:
            seats = RESOLVER.crew_sockets(lead_team, table)
            # A lead can sit across several servers at once, because becoming
            # one gives this process a new pid and the next spawn creates a
            # server named after it. Naming one of them as the socket would be
            # a half-answer; the rest are named too, with what is on them.
            elsewhere = {s: who for s, who in seats.items() if s != crew_socket}
            seat.insert(0, ("socket", f"{crew_socket}  [{crew_why}] "
                                      f"({RESOLVER.socket_state(crew_socket)})"))
            for other, who in sorted(elsewhere.items()):
                seat.insert(1, ("also", f"{other} hosts {', '.join(who)} "
                                        f"({RESOLVER.socket_state(other)})"))
        report_launch(ctx, command, prefix, extra=seat)
        # Migration stops the current holder before liveness validation. Successful
        # clearance exempts that holder; a failed stop remains a live-holder no-op.
        cleared = taking_over and clear_lead_holder(ctx, args, table, prefix)
        # Live-holder validation preserves one process per transcript.
        running = None if cleared else already_running(ctx, args)
        if running:
            return noop_outcome(ctx, args, prefix, why=running[0])
        # Every guard that could still turn this into a noop has passed, so the
        # team the stamps name may now be retired (or restamped) for a launch
        # that is really going to happen. Only a move gets here: a launch that
        # spells its team inside the agent id is addressed, not sent, so it
        # retires nothing and leaves the crew report to the runs that do move.
        if taking_over:
            lead_rebind(ctx, args, source, dest, prefix)
        # The remaining path launches the lead, so identity validation runs here.
        enforce_ctx(ctx, args)
        # Validate the executable before roster reconstruction so a missing binary
        # leaves team state unchanged.
        if not args.dry_run and not shutil.which(command[0]):
            die(f"cannot exec {command[0]}: not found or not executable")
        # Flag-bound lead startup reads the destination roster. Reconstruct that
        # roster before exec, using the explicit destination after migration.
        rebuild_team(ctx, args.dry_run)
        # Members launch before the lead. The foreground process then becomes the
        # interactive lead from the resolved cwd so --resume finds its transcript.
        if sys.stdout.isatty() and not args.dry_run:
            # Exec ends transcript-wait reporting, so print pending members before
            # replacement. Waiting here could delay the foreground lead by 45 seconds.
            if pending:
                names = ", ".join(label for label, _path, _since in pending)
                print(f"{prefix}loading  {len(pending)} member transcript(s) remained pending "
                      f"at takeover: {names}")
            print(f"{prefix}exec     taking over this terminal")
            # Roster reconstruction writes inactive member entries needed for retry,
            # so lead exec failure preserves that directory and reports the exec error.
            become_agent(ctx, command, prefix)
        print(f"{prefix}run this in your terminal (lead launches are interactive):")
        # still pastes as one command however it wrapped; the env prefix is
        # part of the command, because the shell this lands in may not export
        # what the identity flags need to bind
        print(wrap_command(env_prefixed(command), f"{prefix}  ", f"{prefix}    ", paste=True))
        return Outcome("manual", None, True, None)

    if args.to_team:
        dest = ctx["to_team"]
        # A transcript that restores as another team un-does this rebind at
        # every restart; retiring that team (guards willing) makes the flags
        # win, the whole conversation intact.
        rebinding = ctx["target"]["transcript"]["path"]
        stamped, state = (RESOLVER.restored_identity(rebinding)
                          if rebinding else (None, None))
        if state == "restored" and stamped != dest:
            # The route it took comes back truthy, and recording it is what
            # keeps later identity validation from rejecting this approved move
            # has just made - or, in a dry run, where the reap only printed its
            # would-lines, from refusing the preview of a launch that works.
            # A blocked rebind stops the run here rather than returning, so the
            # record is written only where the move really was taken.
            if rebind_reap(stamped, dest, args, prefix):
                ctx["member_moving"] = dest
    else:
        rebuild_team(ctx, args.dry_run)
        auto_redirect(ctx, args, table, prefix)

    agent_id = RESOLVER.field(ctx, "agentId")
    if args.explain:
        explain(ctx)

    if args.here:
        # A member given this terminal takes the lead's route: exec, so the
        # process becomes the agent. No seat is resolved because none is used,
        # and nothing after this point in the run happens.
        command = build_command(ctx, args, passthrough)
        adopted = inherit_credentials(ctx)
        cwd = ctx["target"]["cwd"]
        seat = [("runs", RESOLVER.current_terminal_note()),
                ("cwd", cwd or "(inherit)")]
        if adopted:
            seat.append(("creds", f"inherited {', '.join(adopted)} from the lead"))
        report_launch(ctx, command, prefix, extra=seat)
        running = already_running(ctx, args, table=table)
        if running:
            return noop_outcome(ctx, args, prefix, why=running[0], report=running[1])
        enforce_ctx(ctx, args)
        # Check what we are about to run before writing anything, the same order
        # the lead path takes: writing the roster first and finding the binary
        # unusable second lists a member for a launch that never happened, and
        # this exit is not one the rollback below can reach.
        if not args.dry_run and not shutil.which(command[0]):
            die(f"cannot exec {command[0]}: not found or not executable")
        # Listed with no pane: a member that is running and reachable, which a
        # later team run places in a pane like any other. What that write found
        # is kept, because nothing from here on is certain to start the agent.
        undo = record_membership(ctx, args, None)
        # One line, both tenses, so the preview cannot drift from the act.
        print(f"{prefix}exec     this terminal "
              f"{'would become' if args.dry_run else 'becomes'} {agent_id}")
        if args.dry_run:
            return Outcome("manual", None, False, None)
        become_agent(ctx, command, prefix, undo=undo)

    socket, how = resolve_socket(ctx, args, table)
    if not socket:
        warn("could not determine a tmux socket; pass --socket claude-swarm-<lead-pid>")
        return Outcome("failed", None, False, None)

    cwd = ctx["target"]["cwd"]
    want_pane = RESOLVER.field(ctx, "tmuxPaneId")
    if want_pane and not re.fullmatch(r"%\d+", str(want_pane)):
        want_pane = None  # e.g. the lead's "leader" placeholder
    want_pane, pane_said = RESOLVER.seat_note(want_pane, socket)

    command = build_command(ctx, args, passthrough)
    adopted = inherit_credentials(ctx)

    seat = [("socket", f"{socket}  [{how}] ({RESOLVER.socket_state(socket)})"),
            ("pane", pane_said),
            ("cwd", cwd or "(inherit)")]
    if adopted:
        seat.append(("creds", f"inherited {', '.join(adopted)} from the lead"))
    report_launch(ctx, command, prefix, extra=seat)

    # Same agent already in that pane -> nothing to do. Anything else in it -> new pane.
    pane_rows = (RESOLVER.runtime(table)["by_pane"].get((socket, want_pane), [])
                 if want_pane else [])
    occupants = [(row["pid"], row["args"]) for row in pane_rows
                 if RESOLVER.is_claude(row["args"])]
    # The strangers half only: this sorts the pane's occupants into "this agent"
    # and "somebody else" to decide whether to reuse the pane or take a new one,
    # and our own lineage is neither of those to a launch.
    agent_runtime = (ctx.get("runtime") if agent_id else None)
    if agent_id and (not agent_runtime or agent_runtime.get("agent_id") != agent_id):
        agent_runtime = RESOLVER.agent_runtime(agent_id, table)
    worn = {row["pid"] for row in (agent_runtime or {}).get("other_processes", [])}
    here = [pid for pid, _cmd in occupants if pid in worn]
    others = [pid for pid, _ in occupants if pid not in here]

    holder_runtime = ctx["holders"]
    strangers_hold, held_by_us = holder_runtime["others"], holder_runtime["ours"]
    if held_by_us and not args.force:
        die(f"you are running this transcript yourself (pid {held_by_us[0]['pid']}); "
            "nothing can replace a process from inside it. Exit first, or have "
            "the lead run this")

    replace_pane = None
    if ctx.get("to_team") and not ctx.get("auto_redirect"):
        # Explicit --into-team only: this is the migrate half, and it kills.
        # A redirected launch never reaches here, so the default cannot kill.
        # Never guess a pane here: pane ids are per-server, so a recorded id
        # from another socket names an unrelated pane on this one, and killing
        # it would take out a stranger while the old holder kept writing.
        for index, holder in enumerate(strangers_hold):
            pid = holder["pid"]
            holder_socket, holder_pane = holder["socket"], holder["pane"]
            if index == 0 and holder_socket == socket and holder_pane:
                replace_pane = holder_pane
                print(f"{prefix}rebind   replacing pid {pid} in pane {holder_pane}")
                continue
            where = (f" in pane {holder_pane} on {holder_socket}"
                     if holder_pane else f" outside {socket}")
            kill_holder(pid, where, args)
    # One step for every way this agent could already be alive: in this pane,
    # holding the transcript, or wearing this id elsewhere.
    running = already_running(ctx, args, table=table, here=here, pane=want_pane)
    if running:
        why, report = running
        if report and not args.no_tint:
            tint_pane(socket, want_pane, RESOLVER.field(ctx, "color"),
                      RESOLVER.field(ctx, "agentName"), args.dry_run)
        return noop_outcome(ctx, args, prefix, socket=socket, pane=want_pane,
                            report=report, why=why)
    if others and not replace_pane:
        warn(f"pane {want_pane} runs a different claude (pid {', '.join(map(str, others))}); using a new pane")

    # Every guard that could still turn this into a noop has passed, so the run
    # is about to act and identity validation applies.
    enforce_ctx(ctx, args)

    # Already standing in the right place: run the agent in this pane instead of
    # splitting a new one and leaving the shell we were invoked from idle beside
    # it. Bookkeeping has to happen first, since exec never returns.
    in_socket, in_pane = RESOLVER.current_tmux()
    # Never when a tool is driving (its shell would be swallowed), never inside
    # --team (the loop would end), and never when a live holder has to be killed
    # first: exec cannot respawn the pane, so that case belongs to launch().
    if (in_socket == socket and in_pane and not replace_pane
            and not getattr(args, "in_team", False) and not os.environ.get("CLAUDECODE")):
        if in_pane == want_pane or not RESOLVER.pane_exists(socket, want_pane):
            print(f"{prefix}exec     you are in {in_pane} on {socket}; running here rather than splitting")
            # The same roster write every other launch makes, through the one
            # function that decides which roster a member belongs in. A second
            # copy of that routing lived here and had already drifted: it wrote
            # the destination on a rebind and rolled the source back, so a
            # failed exec left the destination claiming a live member.
            undo = record_membership(ctx, args, in_pane)
            rendered = f"exec in {cwd or os.getcwd()}: {' '.join(shlex.quote(c) for c in command)}"
            step(args.dry_run, f"would {rendered}", rendered, indent=prefix)
            if args.dry_run:
                return Outcome("launched", socket, False, None)
            if not args.no_tint:
                tint_pane(socket, in_pane, RESOLVER.field(ctx, "color"), RESOLVER.field(ctx, "agentName"), False)
            become_agent(ctx, command, prefix, undo=undo)

    try:
        launched_at = ctx["target"]["transcript"]["path"].stat().st_mtime
    except OSError:
        launched_at = 0.0
    # Claimed before the spawn, patched with its pane below. The boot looks
    # itself up in the roster on the way in, so an entry written only afterwards
    # is racing the launch it describes.
    claimed = reserve_membership(ctx, args)
    try:
        pane, action = launch(socket, want_pane, cwd, command, args.dry_run, replace_pane)
    except LaunchFailed as exc:
        # A member's pane is that member's problem. The run continues, so the
        # summary, the flag check and the write report still reach every agent
        # that did launch. The claim goes back first: nothing started, so the
        # roster must not be left describing a member that never existed.
        release_membership(claimed, args)
        warn(f"{prefix}{RESOLVER.field(ctx, "agentId")} did not launch: {exc}")
        return Outcome("failed", socket, False, None)
    # At the steps' indent, not flush left: this is one of the things the launch
    # did, and a launch that alternates between two margins reads as two
    # interleaved reports rather than one sequence.
    print(fill(f"{prefix}  {'would run' if args.dry_run else 'running'} in pane "
               f"{pane or '<new>'} ({action})"))
    if not args.no_tint:
        tint_pane(socket, pane, RESOLVER.field(ctx, "color"), RESOLVER.field(ctx, "agentName"), args.dry_run)

    alive, wrote = True, True
    if not args.dry_run:
        alive, why = launch_survived(socket, pane, RESOLVER.field(ctx, "agentId"),
                                     ctx["target"]["transcript"]["path"], launched_at)
        wrote = alive and why == "wrote to its transcript"
        if alive:
            print(f"{prefix}alive    {why}")
        else:
            warn(f"the launch in pane {pane} is not running: {why}; recording it as inactive")

    record_membership(ctx, args, pane, alive)

    # A launch that has not written yet is not a verdict, only an unfinished
    # observation: the settle window is a second and a half and a healthy agent
    # takes tens of seconds to load a large session. Hand it back so the run can
    # answer it at the end rather than leaving "not yet" as the last word.
    unwritten = ((RESOLVER.field(ctx, "agentId") or ctx["target"]["session"][:8],
                  ctx["target"]["transcript"]["path"], launched_at) if alive and not wrote else None)
    return Outcome("launched" if alive else "failed", socket, False, unwritten)


def render_transcript_row(stem, fact=None, note=None, completion=False, limit=None,
                          report_label=None, width=None):
    """One transcript row, shared by listings, completion, refusals, and reports."""
    if completion and report_label is not None:
        raise ValueError("a transcript row cannot be completion and report output")
    report = report_label is not None
    if limit is None:
        limit = REPORT_TRANSCRIPT_TITLE if report else COMPLETION_TITLE
    where = None
    if fact:
        path = fact["path"]
        when = ms_str(fact["mtime"]) if fact.get("mtime") else "missing"
        raw_title = fact.get("title")
        title = (clip(raw_title, limit) if report else bounded_title(raw_title, limit))
        where = f"{path.parent.name}, {when}"
        if report:
            desc = title or ""
        else:
            desc = f"{title}  [{where}]" if title else where
    else:
        desc = "transcript not found"
    if note:
        desc = f"{note}; {desc}" if desc else note
    if report:
        value = f"{stem} — {desc}" if desc else f"{stem} —"
        return render_labeled_row(
            report_label, value, trailer=f"[{where}]" if where else None,
            width=width)
    separator = ":" if completion else "  "
    return f"{stem}{separator}{desc}"


def completion_request(topic):
    """(kind, subject or None) for one completion request string."""
    kind, separator, subject = topic.partition(":")
    return kind, subject if separator else None


def run_complete(topic):
    """Candidates on stdout, and nothing on stderr.

    This runs on every TAB. A warning here lands in the middle of whatever the
    user is typing, and the conditions that produce one (an uncorroborated
    claimant, a stale roster) are the ordinary state of the corpus rather than
    anything a completion should interrupt to report.
    """
    with capturing("err"):
        return _complete(topic)


def _complete(topic):
    """Emit completion candidates. `selector` prefixes each line with its group
    so one process serves all three, instead of paying interpreter startup thrice."""
    dynamic, subject = completion_request(topic)
    if dynamic == "flags":
        # Tab separated, where teams and sessions are colon separated. Not a
        # style choice: seven of these help strings contain a colon of their
        # own, so a colon-separated line would split inside the prose and hand
        # zsh half a sentence. No help string contains a tab, and
        # completion-flags-are-parseable is what keeps that true.
        #
        # Four fields: the flag, the line the menu gives it, the topic that
        # completes its value, and the word standing for that value. The last
        # two are empty for a flag that takes no value, which the parser
        # already knows and is not asked about here.
        #
        # _actions is argparse's own list and has no public spelling. Reading
        # it is still the point of this topic: the alternative is scraping this
        # file for add_argument calls, and two flags interpolate a constant
        # into their help, where a scraper sees an f-string and the person at
        # the prompt needs the sentence.
        for action in build_parser()._actions:
            longs = [opt for opt in action.option_strings if opt.startswith("--")]
            # The first long spelling is the one offered; the rest are aliases,
            # which is what this completion has always done with --terminate,
            # --cleanup-sockets and --no-colour. -h/--help is why the rule says
            # first *long* rather than first: the first long option names the flag whatever
            # order its spellings are declared in.
            if not longs or action.help is argparse.SUPPRESS:
                continue
            # A flag with no declared row is a failed check, not a broken TAB:
            # the listing falls back to the help page's sentence and the suite
            # says so. See every-flag-declares-a-menu-row.
            row = getattr(action, "menu_row", None) or action.help or ""
            if action.nargs == 0:
                print(f"{longs[0]}\t{row}\t\t")
                continue
            value = (action.metavar or action.dest).lower().replace("_", " ")
            print(f"{longs[0]}\t{row}\t{getattr(action, 'completer', None) or ''}\t{value}")
        return 0

    if subject is not None and dynamic in ("as-agent-name", "as-agent"):
        entry, _why = RESOLVER.side_transcript(subject)
        if not entry:
            return 0
        name = entry["name"] or entry["task_id"]
        if dynamic == "as-agent-name":
            print(name)
            return 0
        current, evidence = RESOLVER.team_for_parent_session(entry["parent"])
        teams = []
        if current:
            teams.append(current)
        teams.extend(team for team in sorted(RESOLVER.known_teams()) if team not in teams)
        for team in teams:
            desc = (f"current parent's team ({evidence})" if team == current
                    else "another known team")
            print(f"{agent_id_of(name, team)}:{desc}")
        return 0

    if subject is not None and dynamic == "into-session":
        path, _mate, mate_team = RESOLVER.demote_subject(subject)
        if not path:
            return 0
        preferred = []
        labels = {}
        receipt = RESOLVER.receipt_carried_by(path)
        mate_team = mate_team or (receipt.get("team") if receipt else None)
        parent = (receipt.get("parent") if receipt
                  and receipt["direction"] == "promote" else None)
        if parent:
            preferred.append(parent)
            labels[parent] = "parent from latest promotion receipt"
        if mate_team:
            lead, _why = RESOLVER.team_lead_transcript(mate_team)
            if lead and lead != path and lead.stem not in preferred:
                preferred.append(lead.stem)
                labels[lead.stem] = f"lead of current team {mate_team}"
            for name, soul in RESOLVER.team_souls(mate_team).items():
                member = soul.path
                if member == path or member.stem in preferred:
                    continue
                preferred.append(member.stem)
                labels[member.stem] = f"{name} in current team {mate_team}"
        all_paths = RESOLVER.transcripts_by_mtime()
        by_stem = {candidate.stem: candidate for candidate in all_paths}
        emitted = set()
        for stem in preferred:
            candidate_path = by_stem.get(stem)
            print(render_transcript_row(
                stem, RESOLVER.transcript_fact(path=candidate_path)
                if candidate_path else None,
                labels.get(stem), completion=True))
            emitted.add(stem)
        for candidate in all_paths:
            if candidate.stem not in emitted and candidate != path:
                print(render_transcript_row(
                    candidate.stem, RESOLVER.transcript_fact(path=candidate),
                    completion=True))
        return 0

    if topic == "selector":
        # A uuid is a valid selector, so the selector position offers them too;
        # they were previously reachable only behind --resume.
        for group in ("names", "teams", "leads"):
            buffer = io.StringIO()
            with capturing("out", into=buffer):
                run_complete(group)
            for line in buffer.getvalue().splitlines():
                print(f"{group}\t{line}")
        return 0

    if topic == "sockets":
        for path in RESOLVER.swarm_sockets():
            state = "live" if RESOLVER.socket_alive(path) else "dead"
            print(f"{path.name}:{state}, {ms_str(int(path.stat().st_mtime * 1000))}")
        return 0

    if topic == "sessions":
        # transcripts_by_mtime is newest first already, and re-sorting it here
        # put the listing back in path order. Every topic is offered newest
        # first, which is also the order the completion's bare-TAB cap assumes.
        for path in RESOLVER.transcripts_by_mtime():
            print(render_transcript_row(
                path.stem, RESOLVER.transcript_fact(path=path), completion=True))
        return 0

    if topic == "sides":
        # side_transcripts lists in path order, which is what --sides reports
        # want; a completion wants the newest first, like every other topic.
        for e in sorted(RESOLVER.side_transcripts(), key=lambda e: e["mtime"], reverse=True):
            name = e["name"] or e["task_id"]
            print(f"{e['parent'][:8]}/{name}:{e['grammar']}, {ms_str(e['mtime'])}")
        return 0

    entries = RESOLVER.scan_teams()
    entries.sort(key=lambda e: e["ts"], reverse=True)

    if topic == "agent-ids":
        for entry in entries:
            agent_id = entry["member"].get("agentId")
            if agent_id:
                ansi = "" if NO_COLOR else COLOR_ANSI.get(agent_colour(agent_id, entry["member"]), "")
                print(f"{agent_id}\tjoined {ms_str(entry['ts'])}\t{ansi}")
        return 0

    if topic == "teams":
        # A team outlives its directory, and the selector accepts and rebuilds
        # these, so listing only the tidy ones offers less than the tool takes.
        # Rostered first, newest first, because entries arrive that way; the
        # rest after them. Both kinds are described by the same function, so a
        # reader reads one grammar down the whole list.
        seen, order = set(), []
        for entry in entries:
            if entry["team"] not in seen:
                seen.add(entry["team"])
                order.append(entry["team"])
        order += [t for t in sorted(RESOLVER.known_teams()) if t not in seen]
        for team in order:
            print(f"{team}:{completion_team_line(team, entries, limit=COMPLETION_TITLE)}")
        return 0

    if topic == "leads":
        seen = set()
        for entry in entries:
            agent_id = entry["member"].get("agentId")
            if not agent_id or agent_id in seen or agent_id != entry.get("leadAgentId"):
                continue
            seen.add(agent_id)
            # a bare "team-lead" names every team, so only full ids, titled
            lead_fact = RESOLVER.transcript_fact(entry.get("leadSessionId"))
            title = bounded_title((lead_fact or {}).get("title"), COMPLETION_TITLE)
            if not title and not lead_fact:
                # Completion does not resolve the whole team to prove this
                # negative. A spawn-backed lead is still looked up below for a
                # roster-less team; this row reports only what its roster names.
                title = "roster's lead session id does not name a transcript file"
            joined = f"joined {ms_str(entry['ts'])}"
            print(f"{agent_id}\t{title + ', ' + joined if title else joined}\t")
        for team, evidence in sorted(RESOLVER.known_teams().items()):
            if agent_id_of("team-lead", team) in seen or RESOLVER.has_roster(team):
                continue
            path, why = RESOLVER.lead_transcript_for(team)
            if not path:
                continue
            title = bounded_title((RESOLVER.transcript_fact(path=path) or {}).get("title"),
                              COMPLETION_TITLE)
            label = f"{title}, no roster" if title else f"no roster, found by {evidence}"
            print(f"{agent_id_of('team-lead', team)}\t{label}\t")
        return 0

    if topic == "names":
        # A roster is where an agent's colour and join time live, but not where
        # its existence is decided: the harness deletes a team dir when its lead
        # exits, leaving members that are still perfectly resurrectable. So the
        # candidates are every stamped transcript, enriched from the roster when
        # one survives.
        candidates = {}
        for path, (name, team) in RESOLVER.stamp_index().items():
            if not name or not team or name == "team-lead":
                continue
            agent_id = agent_id_of(name, team)
            try:
                when = int(path.stat().st_mtime * 1000)
            except OSError:
                continue
            if agent_id not in candidates or when > candidates[agent_id][0]:
                candidates[agent_id] = (when, path, None)
        live_entries = [entry for entry in RESOLVER.runtime()["live_sessions"]
                        if entry["alive"] and entry["agent_id"]]
        live_agents = {entry["agent_id"] for entry in live_entries}
        live_paths = {entry["agent_id"]: entry["transcript"]["path"]
                      for entry in live_entries if entry.get("transcript")}
        for entry in entries:
            member = entry["member"]
            agent_id, name = member.get("agentId"), member.get("name")
            if not agent_id or not name or agent_id == entry.get("leadAgentId"):
                continue
            known = candidates.get(agent_id)
            candidates[agent_id] = (
                max(entry["ts"], known[0] if known else 0),
                live_paths.get(agent_id) or (known[1] if known else None),
                member,
            )
        # One row per agent. The same name is registered in several teams after
        # a rebind, and only one of those registrations is worth offering:
        # a live one, else one whose bounded evidence names a transcript, else
        # the newest roster claim. Full operational resolution happens only when
        # that candidate is selected.
        best = {}
        for agent_id, (when, path, member) in candidates.items():
            name = name_and_team(agent_id)[0]
            rank = (agent_id in live_agents, path is not None, when)
            if name not in best or rank > best[name][0]:
                best[name] = (rank, agent_id)
        candidates = {agent_id: candidates[agent_id] for _, agent_id in best.values()}

        # Group by team, newest team first and newest member first. Transcript
        # stamps keep rosterless members with their recorded teammates.
        by_team = collections.defaultdict(list)
        for agent_id, (when, path, member) in candidates.items():
            by_team[name_and_team(agent_id)[1]].append((when, agent_id, path, member))
        rosters = {e["team"] for e in RESOLVER.scan_teams()}
        for team in sorted(by_team, key=lambda t: max(w for w, *_ in by_team[t]), reverse=True):
            members = sorted(by_team[team], reverse=True)
            label = f"{team}  {ms_str(members[0][0])}"
            if team not in rosters:
                label += ", roster missing"
            for when, agent_id, path, member in members:
                title = bounded_title((RESOLVER.transcript_fact(path=path) or {}).get("title"),
                              COMPLETION_TITLE) if path else None
                stamp = f"joined {ms_str(when)}" if member else f"last active {ms_str(when)}"
                desc = f"{title}, {stamp}" if title else stamp
                ansi = "" if NO_COLOR else COLOR_ANSI.get(agent_colour(agent_id, member), "")
                print(f"{label}\t{agent_id}\t{desc}\t{ansi}")
        return 0

    die(f"unknown completion topic {topic!r}")


SOCKET_GRACE_S = 60  # preserve new sockets while their server may still be binding


def cleanup_sockets(dry=False):
    """Remove tmux socket files whose AF_UNIX liveness probe reports no server.

    Resolver performs the millisecond-scale probe for the SessionStart hook.
    `run_cleanup` renders the aggregate outcome.
    """
    removed = []
    for path in RESOLVER.dead_sockets():
        if dry:
            removed.append(path.name)
            continue
        try:
            path.unlink()
            removed.append(path.name)
        except OSError as exc:
            warn(f"cannot remove {path}: {exc}")
    return removed


# Team-directory creation precedes registry, spawn, and process evidence. This
# short grace period covers that publication interval.
TEAM_GRACE_S = 300

# Descriptions in completion have a whole terminal row to themselves.
COMPLETION_TITLE = 400
# A dossier carries several facts below one agent. Its transcript title identifies
# the work without taking over the report the way a completion-sized title can.
REPORT_TRANSCRIPT_TITLE = 160
# The abort listing is read under time pressure, with a finger on a key, so it
# gets a glance-sized title rather than the completion menu's paragraph.
ABORT_TITLE = 60
NO_COLOR = False  # zsh truncates to the real terminal width


def remove_if_cruft(path, dry, kind):
    """Remove a directory after a current-state validation and staged recheck.

    Entries created during the first check preserve the directory during the
    second check.
    """
    if not path.is_dir():
        return True
    if RESOLVER.roster_path(path.name).parent.parent not in path.parents \
            and (CLAUDE_DIR / "tasks") not in path.parents:
        warn(f"preserving {path}: path lies outside the directories this tool owns")
        return False
    if kind == "team":
        reason = RESOLVER.scaffolding_objection(path)
        if reason:
            warn(f"preserving {path.name}: {reason}")
            return False
    else:  # a task dir must be completely empty
        leftovers = list(path.iterdir())
        if leftovers:
            warn(f"preserving {path}: holds {', '.join(p.name for p in leftovers[:3])}")
            return False
    if dry:
        return True

    # Atomic rename removes the directory from writer reach before the final
    # content and lock validation. A writer that lands before rename appears in the
    # staged recheck. A writer arriving after rename sees the original path absent
    # or recreates a new directory, so its lock target stays separate from the
    # staged directory. Unexpected staged content moves back to the original path.
    #
    # What is left is the interval between the re-prove and the unlink loop.
    # drop_lock has an interval of the same kind before its own unlink and
    # narrows it by comparing the bytes it read against the bytes still at that
    # name; the loop below has no equivalent, because it deletes whatever entries
    # the staged directory holds rather than one file it read. Closing it needs
    # the sweep to hold this team's lock across the check, the rename and the
    # delete, which changes how the sweep takes locks and is not done here.
    staged = staged_path(path)
    try:
        os.rename(path, staged)
    except OSError as exc:
        warn(f"cannot stage {path} for removal: {exc}")
        return False

    reason = RESOLVER.scaffolding_objection(staged) if kind == "team" else (
        f"holds {', '.join(p.name for p in list(staged.iterdir())[:3])}" if any(staged.iterdir()) else None
    )
    if reason:
        try:
            os.rename(staged, path)
            warn(f"not removing {path.name}: {reason} (appeared while removing; put back)")
        except OSError as exc:
            warn(f"{path.name}: {reason}, and restoring it failed: {exc}; it is at {staged}")
        return False

    try:
        # config.json last, so an interrupted deletion leaves something the
        # keep-checks still recognise as a team rather than a headless dir.
        for sub in sorted(staged.iterdir(), key=lambda p: p.name == "config.json"):
            if sub.is_dir():
                for inbox in sorted(sub.iterdir()):
                    inbox.unlink()
                sub.rmdir()
            else:
                sub.unlink()
        staged.rmdir()
    except OSError as exc:
        warn(f"cannot remove {staged}: {exc}")
        return False
    return True


def team_keep_reason(cfg, table):
    """Why this team must be kept, or None if nothing in it is resurrectable.

    Every fact here is an engine answer; what is left is the order they are
    asked in and the words the sweep prints.

    Empty means provably unresurrectable: no live process running as it, no
    lead transcript, and not one member with a transcript. Teams in that state
    are the residue of a Claude launch that registered a team at startup and
    exited before the first prompt, so nothing was ever written. Anything less
    certain is left alone; the cost of a stale directory is nothing, and the
    cost of deleting a resurrectable team is somebody's memory.
    """
    entries = [e for e in RESOLVER.scan_teams() if e["cfg"] == cfg]
    if not entries:
        return "unreadable or memberless roster"
    team, lead_session = entries[0]["team"], entries[0]["leadSessionId"]

    if RESOLVER.made_moments_ago(cfg.parent):
        return "created moments ago"
    lead = RESOLVER.agent_runtime(
        agent_id_of("team-lead", team), table, parent_session=lead_session)
    if lead["pid"] and lead["alive"]:
        return f"pid {lead['pid']} is live for this team"
    # Cleanup uses Resolver's resumable-member search before deciding that a team
    # directory contains finished work.
    souls = RESOLVER.team_souls(team, entries)
    if souls:
        return f"resumable transcripts: {', '.join(sorted(souls))}"
    return RESOLVER.scaffolding_objection(cfg.parent)


def sweep_dead_lock(cfg, dry):
    """Remove a regular roster lock whose recorded owner has exited.

    Claude Code represents its lock as a directory and clears it with `rmdir`.
    The regular file used here makes that operation return `ENOTDIR`, which can
    block later roster updates and teammate spawn. Resolver supplies owner
    liveness, and `drop_lock` verifies the bytes again before unlinking. Live,
    unreadable, and Claude-managed locks remain.
    """
    lock = RESOLVER.lock_for(cfg)
    owner, gone, seen = RESOLVER.lock_holder(lock)
    if not gone:
        return None
    said = f"{cfg.parent.name} (pid {owner['pid']}, which is gone)"
    if dry:
        return said
    took, stuck = drop_lock(lock, seen)
    if stuck:
        warn(f"cannot remove {lock}: {stuck}")
    return said if took else None


def cleanup_teams(dry=False):
    """Remove finished team and task directories, and stale regular-file locks.

    Return removed teams, preserved-team reasons, and removed-lock descriptions.
    SessionStart stays quiet; dry-run renders preservation reasons. A removed team
    directory includes its lock entry, while preserved teams receive separate
    stale-lock cleanup.
    """
    removed, kept, locks = [], [], []
    table = RESOLVER.process_table()
    for cfg in sorted(RESOLVER.roster_path(d.name) for d in RESOLVER.team_dirs()):
        keep = team_keep_reason(cfg, table)
        if keep:
            kept.append((cfg.parent.name, keep))
            left = sweep_dead_lock(cfg, dry)
            if left:
                locks.append(left)
            continue
        if not remove_if_cruft(cfg.parent, dry, "team"):
            continue
        remove_if_cruft(CLAUDE_DIR / "tasks" / cfg.parent.name, dry, "tasks")
        removed.append(cfg.parent.name)
    return removed, kept, locks


def run_agent_dossier(agent_id, team_state, requested=False, ledger=None):
    """Print one agent's diagnosis below its team's doctor report."""
    if not agent_id or "@" not in str(agent_id):
        die("an agent dossier needs name@team")
    diagnosis = RESOLVER.agent_diagnosis(agent_id, team_state=team_state)
    lead = diagnosis["lead"]
    pid, alive, detail, grade = (
        lead["pid"], lead["alive"], lead["detail"], lead["grade"])
    marker = "  [requested]" if requested else ""
    print(f"agent    {diagnosis['agent_id']}{marker}")
    name, team = name_and_team(diagnosis["agent_id"])
    resolved = RESOLVER.resolve_transcript(
        name=name, team=team, quick=True, runtime=diagnosis["runtime"])
    transcript = getattr(resolved, "transcript", None) if resolved else None
    stem = transcript["session"] if transcript else "(none)"
    note = getattr(resolved, "reason", None) if resolved and not transcript else None
    print(render_transcript_row(
        stem, transcript, note=note, report_label="session"))
    parent_stem, parent_note = RESOLVER.spawn_parent_of(agent_id)
    parent_fact = RESOLVER.transcript_fact(parent_stem) if parent_stem else None
    print(render_transcript_row(
        parent_stem or "(none)", parent_fact, note=parent_note,
        report_label="parent"))
    # Runtime resolves process and seat together. The roster's recorded pane is
    # not used here because the process may have moved or may run outside tmux.
    runtime = diagnosis["runtime"]
    seat = runtime["seat_state"]
    seat_socket, seat_pane = runtime["socket"], runtime["pane"]
    # Both halves, for the word at the end of the line. The usual way to ask
    # this is from inside the session being asked about, and "it is live" reads
    # as some other process unless the line says which one.
    inside = (f"  (pid {runtime['ours'][0][0]}, which this command is running inside)"
              if runtime["ours"] else "")
    print(fill("seat     " + {"seated": f"in pane {seat_pane} on {seat_socket}",
                              "unseated": "none; it is live and in no tmux pane",
                              "not running": "none; it is not running"}[seat] + inside))
    if pid:
        print(fill(f"lead     pid {pid}{'' if alive else ', not running'}"
                   + (f"  ({detail})" if detail else "") + f" [{grade}]"))
    else:
        print("lead     (none)")
    # A grade rates an answer. With no team to rate, the boot-timing grade would
    # describe a pairing that never happened, so an unknown says only that.
    said_team, said_grade = diagnosis["lead_team"]
    print(fill(f"runs as  {said_team}  [{said_grade}]" if said_team
               else "runs as  (unknown)"))
    said = {True: "yes", False: "no", None: "unknowable"}[diagnosis["polls"][0]]
    print(fill(f"polls    {said}  ({diagnosis['polls'][1]})"))
    print(f"listed   {'yes' if diagnosis['listed'] else 'no'}")
    reachable, why = diagnosis["reachable"]
    # "At its next turn boundary": delivery queues while a recipient's turn
    # runs, so the dossier must not imply an immediacy nothing guarantees.
    verdict = {True: "reaches its lead at its next turn boundary",
               False: "does not reach its lead",
               None: "may not reach its lead"}[reachable]
    print(fill(f"mail     {verdict}: {why}"))
    held = transcript["session"] if transcript else None
    fragile = RESOLVER.rebind_fragility(held, team)
    if fragile:
        print(fill(f"fragile  {fragile}"))
    addressed = ([row for row in ledger if row["to"] == name]
                 if ledger is not None else RESOLVER.mail_ledger(team, to=name))
    held_count = sum(row["state"] == "in memory" for row in addressed)
    lost = sum(row["state"] == "unexplained" for row in addressed)
    if held_count or lost:
        print(fill(f"ledger   {held_count} in its memory, {lost} unexplained, of "
                   f"{len(addressed)} sends addressed to it"))
    for what, cost in diagnosis["remedies"]:
        print(fill(f"remedy   {what}  ({cost})"))
    return 0


def doctor_dossier_ids(team, state, requested=None):
    """Agent IDs in doctor order: requested, real lead, then roster order."""
    requested_name, requested_team = name_and_team(requested)
    priority = ([requested_name] if requested_name and requested_team == team else [])
    priority.append("team-lead")
    names, seen = [], set()
    for name in priority + list(state["dossier_order"]):
        if name and name not in seen:
            names.append(name)
            seen.add(name)
    return tuple(agent_id_of(name, team) for name in names)


# What each verdict claims, in the order of how much is wrong.
DOCTOR_LEGEND = (
    # Only what the verdict tests. Mail waiting in a mailbox does not demote a
    # team whose lead is live and reading it, and an unrecorded member is a note
    # rather than a fault, so claiming either here would describe a state this
    # verdict never asked about.
    ("CONNECTED", "a live lead runs this team and reads its mail, and nothing here needs a person"),
    ("DEGRADED", "nothing is lost yet, but a person must act: the team is dormant, "
                 "one agent is worn by two processes, or the crew sits on two servers"),
    ("UNKNOWABLE", "a plain lead reads the roster from its own memory, which cannot be "
                   "seen from outside"),
    ("SEVERED", "members are running or mail is waiting, and no live lead reads this team"),
)

# Colour restates a verdict for a glance; the word itself stays the carrier.
VERDICT_SGR = {"CONNECTED": "32", "DEGRADED": "33", "UNKNOWABLE": "36", "SEVERED": "31"}


def undelivered_mail_lines(rows):
    """Report lines for the ledger states a mailbox file cannot show.

    The inbox file is pruned the moment a busy recipient queues mail into
    memory, so the file's silence proves nothing; these lines carry the two
    states only the send-vs-delivery join can see. The counts are
    per-recipient facts and stay per-recipient; the physics is shared and
    is said once, however many recipients hold mail.
    """
    out = []
    held = collections.Counter(r["to"] for r in rows if r["state"] == "in memory")
    if held:
        out.append("mail     " + ", ".join(f"{count} in {to}'s memory"
                                           for to, count in held.most_common()))
        out.append(f"{'':9}delivery waits on each holder's next turn boundary "
                   "and dies with its process")
    for r in rows:
        if r["state"] == "unexplained":
            out.append(f"mail     unexplained: {r['sender']} -> {r['to']} at "
                       f"{ms_str(r['sent'])}  {(r['summary'] or '')[:40]}")
    return out


def doctor_member_lines(runtime):
    """Render the structured member rows in a team-runtime answer."""
    return render_agent_rows(
        (row["pid"], row["agent_id"], row["title"] or "(no title)", row["color"])
        for row in runtime["member_rows"]
    )


def diagnose_team(team, table=None, deep=False, ledger=None, team_state=None):
    """(verdict, lines, remedies) for one team. Asks the engine; reads nothing.

    Every fact here is an answer, so the doctor cannot reach a conclusion the
    tool would not reach when it acts. `deep` adds the send-vs-delivery join,
    which reads every member transcript in full and so runs only for a named
    team, never in the sweep.
    """
    table = RESOLVER.process_table() if table is None else table
    runtime = (RESOLVER.team_runtime(team, table)
               if team_state is None else team_state)
    lead = runtime["lead"]
    pid, alive, detail = lead["pid"], lead["alive"], lead["detail"]
    lead_team, exact_team = lead["runs_as"], lead["runs_as_exact"]
    worn = lead["worn_team"]
    groups = runtime["names_by_membership"]
    listed = groups.get("listed", [])
    unrecorded = groups.get("unrecorded", [])
    former = groups.get("former", [])
    converted = groups.get("converted", [])
    mail = RESOLVER.inbox_state(team)
    waiting = {n: v for n, v in mail.items() if v[0]}
    torn = {n: v[1] for n, v in mail.items() if v[0] is None}
    live = runtime["live"]
    doubled = runtime["doubled"]

    if pid:
        lines = [f"lead     pid {pid}{'' if alive else ', not running'}"
                 + (f"  ({detail})" if detail else "")]
    else:
        lines = ["lead     (none)"]
    lead_row = next((row for row in runtime["member_rows"]
                     if row["name"] == "team-lead"), None)
    if lead_row and lead_row["title"]:
        lines.append(f"title    {lead_row['title']}")
    if pid and alive:
        # Same rule as the dossier: no answer, no grade for it.
        grade = "exact" if exact_team else "inferred from boot timing"
        lines.append(f"runs as  {lead_team}  [{grade}]" if lead_team
                     else "runs as  (unknown)")
    lines.append(f"members  {len(listed)} listed, {len(unrecorded)} unrecorded, "
                 f"{len(former)} former, {len(live)} live"
                 + (f", {len(converted)} converted" if converted else ""))
    lines.extend(doctor_member_lines(runtime))
    # A lead never sits in a pane, so team_runtime omits it from seating. The
    # doctor reads the one seat answer per live member for both the split and the
    # warning below.
    seats = runtime["seat_sockets"]
    split = runtime["split"]
    if split:
        lines.append(f"warning  its crew is seated on {len(seats)} servers: "
                     f"{', '.join(sorted(seats))}")
    # Said, never judged. Running a member outside tmux is a deliberate way to
    # run one (the bg substrate this skill's own docs describe), so demoting the
    # verdict for it would call a working arrangement broken. What is owed is
    # what changes operationally, and every clause below is what this file's own
    # code does with such a member: select_jobs keeps it, already_running turns
    # its launch into a noop, and no pane lookup can return a process that is a
    # descendant of no pane.
    unseated = runtime["unseated"]
    if unseated:
        one = len(unseated) == 1
        it = "it" if one else "them"
        stop = agent_id_of(unseated[0], team) if one else "each of them"
        lines.append(f"warning  {', '.join(unseated)} {'is' if one else 'are'} live "
                     f"and in no tmux pane; a run of this team leaves {it} there, "
                     f"because a live member makes that run a noop rather than a "
                     f"relaunch, and nothing that looks for {it} in a pane finds "
                     f"{it}. To seat {it}: {TOOL} --stop {stop}, then run the team "
                     f"again, at the cost of {'its turn' if one else 'their turns'}")
    # One note per state, however many members share it: eight members in one
    # state are one fact about eight names, not eight sentences.
    if unrecorded:
        one = len(unrecorded) == 1
        lines.append(f"note     {', '.join(sorted(unrecorded))} "
                     f"{'is' if one else 'are'} running and in no roster; "
                     f"resuming {'it' if one else 'each'} registers it")
    if converted:
        one = len(converted) == 1
        lines.append(f"note     {', '.join(sorted(converted))} "
                     f"{'was' if one else 'were'} promoted and "
                     f"{'has' if one else 'have'} not launched; "
                     f"{'its receipt is its' if one else 'their receipts are their'} "
                     "membership until then")
    for name, (count, oldest) in sorted(waiting.items()):
        lines.append(f"mail     {count} waiting for {name}, oldest {said_when(oldest)}")
    for name, why in sorted(torn.items()):
        lines.append(f"mail     {name}'s inbox is {why}; its contents are unknown")
    if deep:
        checked = set()
        for name, procs in sorted(live.items()):
            for _pid, held in procs:
                if not held or held in checked:
                    continue
                checked.add(held)
                fragile = RESOLVER.rebind_fragility(held, team)
                if fragile:
                    lines.append(f"note     {name} {fragile}")
        lines.extend(undelivered_mail_lines(
            RESOLVER.mail_ledger(team) if ledger is None else ledger))
    for name in doubled:
        lines.append(f"warning  {name} is worn by {len(live[name])} processes at once")

    reads = bool(pid and alive and lead_team == team)
    remedies = []
    if (waiting or live) and not reads:
        verdict = "SEVERED"
        remedies.append((f"{TOOL} {team}", "rebuilds the roster and places its members"))
        if pid and alive and lead_team and lead_team != team:
            remedies.append(("--into-team live on each member", "restarts them onto {lead_team}"
                             .format(lead_team=lead_team)))
    elif not reads:
        # Dormant, and the block so far has only said what is there. A reader of
        # one block cannot tell which of the three degraded states it is looking
        # at unless a line says, so this arm says it too.
        verdict = "DEGRADED"
        lines.append("warning  this team is dormant: no member of it is running, "
                     "no mail is waiting, and no live lead reads it")
        if listed:
            remedies.append((f"{TOOL} {team}", "starts the members its roster lists"))
        else:
            # A run of a team with nothing listed either forges a roster from the
            # transcript that spawned into it, or refuses naming what it could
            # not find. Which one happens is a transcript walk this sweep does
            # not pay for, so the remedy names both outcomes rather than
            # promising the one it cannot know it will get.
            remedies.append((f"{TOOL} {team}",
                             "rebuilds a roster from the transcripts and starts what "
                             "it recovers, or refuses saying what it could not find"))
    elif not worn:
        verdict = "UNKNOWABLE"
        # Both ways to make the lead read, cheap one first: it learns of
        # members only from its own spawns or a flag-bound boot, never from
        # a roster written from outside.
        remedies.append(("start any teammate from inside the lead",
                         "it starts reading mail immediately; costs nothing"))
        remedies.append((f"{TOOL} {agent_id_of('team-lead', team)}",
                         "restarts the lead with team flags; it reads this roster "
                         "on the way up and loses its current turn"))
    elif doubled or split:
        # A verdict names what an operator must act on. Former members are the
        # trace of work that finished; an unrecorded one is fixed by the next run
        # of it. What is left needs a person: two processes on one agent are a
        # turn from the two-writers state, and a split crew stays split.
        verdict = "DEGRADED"
        if split:
            remedies.append((f"{TOOL} {team}", "reseats the crew together"))
        for name in doubled:
            # Two steps, because --stop resolves an agent id to every process
            # wearing it and ends each one; the id names both wearers, so the
            # stop cannot be aimed at one of them and the resume is what leaves
            # exactly one behind.
            remedies.append((f"{TOOL} --stop {agent_id_of(name, team)}",
                             f"ends all {len(live[name])} processes wearing that id"))
            remedies.append((f"{TOOL} {agent_id_of(name, team)}", "starts one of them again"))
    else:
        verdict = "CONNECTED"
    return verdict, lines, remedies


def doctor_subject(args):
    """The team and requested agent from the main selector's resolved fields."""
    team = getattr(args, "team", None)
    agent_id = getattr(args, "agent_id", None)
    session = getattr(args, "resume", None)
    if team:
        return team, None, True
    if agent_id or session:
        ctx = RESOLVER.identity(session_uuid=session, agent_id=agent_id)
        identity = ctx["target"]["identity"]
        team, agent_id = identity["teamName"], identity["agentId"]
        if not team:
            die("the selected conversation has no effective team to diagnose")
        if not agent_id:
            die("the selected conversation has no effective agent identity to diagnose")
        return team, agent_id, True
    return None, None, False


def run_doctor(args):
    """Diagnose named teams and, for direct targets, each of their agents."""
    target, requested, show_dossiers = doctor_subject(args)
    if target:
        # A resolved selector names one team. A census of every team on the
        # machine answers a question this run never asks.
        teams = [target]
        skipped = 0
    else:
        everything = RESOLVER.known_teams()
        interesting = RESOLVER.teams_with_live_evidence()
        teams = sorted(interesting) if not args.all_members else sorted(everything)
        skipped = 0 if args.all_members else len(everything) - len(teams)
    worst, seen = 0, set()
    blocks = []
    ledgers, states = {}, {}
    for team in teams:
        state = RESOLVER.team_runtime(team)
        states[team] = state
        ledger = RESOLVER.mail_ledger(team) if target else None
        if ledger is not None:
            ledgers[team] = ledger
        verdict, lines, remedies = diagnose_team(
            team, deep=bool(target), ledger=ledger, team_state=state)
        seen.add(verdict)
        # A remedy is a command plus an explanation of what it does. The
        # command carries the team name and so differs per block; the
        # explanation does not. Blanking the name gives the shape two blocks
        # needing the same act share. Whole token only: a team name that is a
        # prefix of a longer one must not blank half of the longer one.
        shaped = [(what, cost, re.sub(rf"(?<![\w-]){re.escape(team)}(?![\w-])",
                                      "<team>", what))
                  for what, cost in remedies]
        blocks.append((team, verdict, lines, shaped))
        if verdict == "SEVERED":
            worst = 1
    # Nine teams needing the same act printed that act's explanation nine
    # times, differing only by a name the block heading already carried. The
    # command stays in the block, because it is what a reader copies and it
    # differs; the explanation is stated once below, with the legend. Only
    # what actually repeats moves: an act one block asks for keeps its
    # parenthetical where it stands. A named team is a single block, so
    # nothing in it can repeat and it still explains itself in full.
    by_shape = collections.defaultdict(set)
    for team, _verdict, _lines, shaped in blocks:
        for _what, cost, shape in shaped:
            by_shape[(shape, cost)].add(team)
    shared = {pair for pair, wanting in by_shape.items() if len(wanting) > 1}
    # Which explanation a block's remedy means. Three of the shared ones on
    # this machine open with the same command, the plain rebuild with the team
    # blanked to <team>, so a bare command in a block matched all three and
    # pointed at none of them. A letter ties the
    # two ends, the way --explain ties a field's row to its source, and it goes
    # where the explanation would have gone, so the remedy column still reads
    # as command-then-parenthesis whichever kind of block it is.
    tag = {pair: (chr(ord("A") + at) if at < 26 else f"S{at}")
           for at, pair in enumerate(sorted(shared))}
    for team, verdict, lines, shaped in blocks:
        print("\n" + f"{verdict:<11} {team}".replace(
            verdict, tint(verdict, VERDICT_SGR.get(verdict)), 1))
        for line in lines:
            print(line if isinstance(line, RenderedLine) else fill(f"  {line}"))
        for what, cost, shape in shaped:
            print(fill(f"  remedy   {what}  ({tag[(shape, cost)]})"
                       if (shape, cost) in shared
                       else f"  remedy   {what}  ({cost})"))
    if not target:
        # How many of how many, and why the rest were passed over. The second
        # number is the same population --census totals, which is what lets a
        # reader lay the two reports side by side; what a team is and how the
        # evidence for one splits are the census's own subject, and saying them
        # here put a definition in the middle of a count.
        said = f"\n{len(teams)} of {len(everything)} teams examined"
        if skipped:
            said += (f"; the other {skipped} have nothing live and no mail "
                     "waiting, and --all covers them")
        print(fill(said))
    # Only where mail was actually reported: a sweep counts it from the inbox
    # files, and the join that also finds mail taken into a recipient's memory
    # runs for a named team. A reader looking at mail counts can act on that;
    # printed under a sweep that found none, it was a fact about nothing.
    if not target and any(line.startswith("mail ")
                          for _team, _verdict, lines, _shaped in blocks
                          for line in lines):
        print(fill("\nthese counts come from the inbox files; --mail-ledger <team> "
                   "joins sends against deliveries for one team"))
    for stem in RESOLVER.nameless_receipts():
        print(fill(f"\nnote     promoted transcript {stem[:8]} has no identity in its "
                   "last conversion receipt, so no team can count it; re-promote "
                   "to record one"))
    # The legend explains the verdicts on screen; a rulebook recited under a
    # single-team report says three things that did not happen.
    if seen:
        print("\nverdict" + ("s" if len(seen) > 1 else ""))
        for name, meaning in DOCTOR_LEGEND:
            if name in seen:
                print(fill(f"  {name:<11} {meaning}").replace(
                    name, tint(name, VERDICT_SGR.get(name)), 1))
    if shared:
        # The half the blocks above left out, beside the other legend, with
        # <team> where each block prints its own name.
        column = max(len(shape) for shape, _cost in shared)
        print("\nremedies  (each block's remedy line ends with its letter)")
        for shape, cost in sorted(shared):
            print(fill(f"  {tag[(shape, cost)]}  {shape:<{column}}  {cost}"))
    if show_dossiers:
        for team in teams:
            print(f"\nagent dossiers  {team}")
            for agent_id in doctor_dossier_ids(team, states[team], requested):
                print()
                run_agent_dossier(
                    agent_id, states[team], requested=agent_id == requested,
                    ledger=ledgers[team])
    return worst


RECEIPTS_DIR = CLAUDE_DIR / TOOL / "receipts"


def demote_mail_receipt_path(stem):
    """The archive written only when --with-mail preserves inbox bytes."""
    return RECEIPTS_DIR / f"{stem}.demote-mail.json"


def materialize(plan):
    """Apply a proved promote. The only mover of a side transcript.

    The destination is written before the source is removed, so a crash
    between those steps leaves two copies on disk, never zero. The transcript's
    last in-file conversion receipt is the complete description of the move.
    """
    if plan["objections"] or not plan["proved"]:
        raise ValueError("materialize was handed an unproved plan")
    dest, source = plan["dest_path"], plan["source"]
    try:
        keep_mode = source.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    replace_text(dest, _jsonl_text(plan["lines"], plan["newline"]), mode=keep_mode)
    source.unlink()
    meta = source.with_name(source.stem + ".meta.json")
    if meta.exists():
        meta.unlink()
    return plan["receipt"]


def embed(plan):
    """Apply a proved demote. The only mover of a teammate into subagents/."""
    if plan["objections"] or not plan["proved"]:
        raise ValueError("embed was handed an unproved plan")
    dest, source = plan["dest_path"], plan["source"]
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        keep_mode = source.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    receipt = {key: value for key, value in plan["receipt"].items()
               if not key.startswith("_")}
    replace_text(dest, _jsonl_text(plan["lines"], plan["newline"]), mode=keep_mode)
    meta_path = dest.with_name(dest.stem + ".meta.json")
    if "side_meta_b64" in receipt:
        replace_bytes(meta_path, base64.b64decode(
            receipt["side_meta_b64"], validate=True),
            mode=receipt["side_meta_mode"])
    else:
        # No stored meta means this teammate was born one; the synthesized
        # meta says so instead of pretending a fork history.
        replace_text(meta_path, json.dumps(
            {"isFork": False, "description": f"demoted from session {source.stem}"}))
    if "mail" in receipt:
        RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
        replace_json(demote_mail_receipt_path(source.stem), {
            "source": str(source), "dest": str(dest),
            "at": int(time.time() * 1000), "mail": receipt["mail"]})
    source.unlink()
    return receipt


def differing(before, after):
    """Which entries changed between two reads of the same files.

    A name on one side only is a change; so is a byte difference; and so is a
    stat fact moving under identical bytes, because a writer that replaces a
    file by rename leaves the same text on a new inode.
    """
    return sorted(name for name in set(before) | set(after)
                  if before.get(name) != after.get(name))


def said_reads(reads):
    """What a read covered, and the facts each entry was read under.

    The facts are the honest part of a preview: they say which version of the
    file the reader was looking at, so a line about what a receipt would hold
    can be checked against what is on disk now.
    """
    return ", ".join(
        (f"{name} ({read['size']} bytes, last written "
         f"{ms_str(read['mtime_ns'] // 1_000_000)})") if read["size"] is not None
        else f"{name} ({read['why']})"
        for name, read in sorted(reads.items()))


def reap_team(team, dry=False, prefix=""):
    """Retire a team so a restore of it finds nothing. The rebind's one act.

    Claim, then catch. The receipt is prepared from a read of the live
    directory and held in memory; the directory is then renamed aside in one
    step, and the staged copy is read again. Whatever landed between the first
    read and the rename is in that second read, and it goes into the receipt
    instead of under the delete. The rename is the cut and sits as late as it
    can, which is what makes that window small rather than absent.

    Nothing is left at the vacated name. A tombstone there was considered and
    dropped: it would stop the next writer, and stopping writers is not what
    this is for. This catches late mail up to the last moment and never stands
    in anybody's way. A sender arriving after the cut writes where it likes and
    keeps what it wrote, and if it remakes the directory this says where its
    mail ended up and leaves it there.

    One verification read follows the catch, and one is enough. A difference at
    that point means something is still writing past the cut, which the reap's
    own preconditions said was not so: the directory goes back under its own
    name, the receipt is not written, nothing is deleted, and the refusal names
    the file that moved. Retrying would only ask the same broken question again.

    Then the delete, and only of files this tool made: the SCAFFOLDING names
    the sweep works from, and .json mailboxes inside inboxes. A team directory
    can hold a stray somebody put there, notes.txt or a scratch file, and it is
    not ours to remove because it was standing next to our config.json. What
    may go is decided before any of it goes, and anything else keeps the
    directory: it goes back under the team's own name holding what was kept,
    and the report names it. The retirement holds either way, since the roster
    is in the receipt and off the disk, which is all a retirement is.

    A dry run cannot claim anything, because it makes no cut. It reads the live
    directory once and says what a receipt taken at that moment would hold;
    anything written after that read is in no preview.
    """
    team_dir = RESOLVER.team_dir(team)
    # Where it goes at the cut. The name is settled here; the rename that uses
    # it is the last thing before the staged read.
    staged = staged_path(team_dir)
    receipt_at = RECEIPTS_DIR / f"{team}.json"

    def prepared(reads):
        """The receipt these bytes make, held in memory until it is earned."""
        return {"kind": "rebind-reap", "team": team, "at": int(time.time() * 1000),
                "config": reads.get("config.json", {}).get("text"),
                "mail": {name.split("/", 1)[1]: read["text"]
                         for name, read in sorted(reads.items())
                         if name.startswith("inboxes/")}}

    if dry:
        step(True, f"would archive {said_reads(RESOLVER.receipt_contents(team_dir))}, "
                   "as they read just now; a dry run makes no cut, so anything "
                   "written after that read is in no preview", "", indent=prefix)
        return receipt_at

    live = RESOLVER.receipt_contents(team_dir)
    receipt = prepared(live)

    # The cut. After this the name is free and the bytes are out of reach, in
    # one step: a writer either landed before it, and is in the staged copy, or
    # lands after it, and keeps what it wrote.
    try:
        os.rename(team_dir, staged)
    except OSError as exc:
        die(f"cannot move {team}'s directory aside to reap it: {exc}")

    caught = RESOLVER.receipt_contents(staged)
    late = differing(live, caught)
    if late:
        # Something landed between the read and the cut. It is in the staged
        # copy, so the receipt is prepared again from there.
        receipt = prepared(caught)

    again = RESOLVER.receipt_contents(staged)
    moved = differing(caught, again)
    if moved:
        changed = ", ".join(moved)
        try:
            os.rename(staged, team_dir)
        except OSError as exc:
            die(f"{changed} changed after {team} was moved aside, and moving it "
                f"back failed: {exc}. Nothing was deleted; the directory is at "
                f"{staged}")
        die(f"{changed} changed after {team} was moved aside, so something is "
            f"still writing to this team. Nothing was deleted and the directory "
            f"is back at {team_dir}; stop that writer, then run this again")

    RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
    replace_json(receipt_at, receipt)

    # Receipt first, then the delete, and only of what this tool made. A team
    # directory can hold a file somebody put there by hand, and standing next
    # to our scaffolding is not what makes something ours to remove. What may
    # go is decided in one read before any of it goes.
    mine, strays = RESOLVER.scaffolding_and_strays(staged)
    for path in sorted(mine, key=lambda p: p.name == "config.json"):
        # config.json last: an interrupted delete leaves something the sweep
        # still reads as a team rather than a directory with no roster.
        try:
            path.unlink()
        except OSError as exc:
            strays.append(f"{path.relative_to(staged)} ({exc})")
    for empty in (RESOLVER.inboxes_in(staged), staged):
        try:
            empty.rmdir()
        except OSError:
            pass    # something is still in it, and what that is is said below
    step(False, "", f"archived {said_reads(caught)}" + (
        f", including {', '.join(late)}, written after the first read" if late else ""),
        indent=prefix)

    if staged.is_dir():
        # Kept, not deleted, and put back where its owner left it. The team is
        # retired all the same: the roster is in the receipt and off the disk,
        # and that is the whole of what a retirement is.
        held = (f"holds {some_of(strays)}, which this tool did not put there"
                if strays else "would not go although this tool's own files "
                "are gone from it")
        where, aside = team_dir, ""
        if team in {d.name for d in RESOLVER.team_dirs()}:
            where, aside = staged, (
                f"; the name {team_dir} is taken again, by something that "
                "remade it after the cut, so this is left where it is rather "
                "than written over that")
        else:
            try:
                os.rename(staged, team_dir)
            except OSError as exc:
                where, aside = staged, f"; putting it back under its own name failed: {exc}"
        warn(f"{team}'s directory {held}, so nothing there was deleted and it "
             f"is at {where}{aside}. Its roster is archived in {receipt_at} and "
             "gone from disk either way, so the team is retired")
    elif team in {d.name for d in RESOLVER.team_dirs()}:
        waiting = [f"{RESOLVER.inbox_path(team, name)} ({count})"
                   for name, (count, _oldest) in sorted(RESOLVER.inbox_state(team).items())
                   if count]
        warn(f"{team_dir} is there again: something resolved the name and remade "
             "it after the reap. It is left alone" +
             (f", and its mail is waiting at {', '.join(waiting)}" if waiting else ""))
    return receipt_at


def archive_inbox(team, name):
    """Take one mailbox's bytes for a receipt without losing what lands mid-take.

    reap_team's shape scaled to one file, and the cut is the same primitive one
    level down: the rename of the inbox itself. Reading the file and then
    writing [] over it loses whatever arrived in between, because that write is
    a whole-file replace and knows nothing about the message it covers. A
    rename takes the old bytes out of reach in one step, so a sender either
    landed before the cut, and is read off the staged file into the receipt, or
    lands after it and keeps what it wrote.

    What is different one level down is that a directory can be vacated and a
    mailbox cannot: an absent inbox is a name a sender may remake, and a
    zero-byte one wedges reader and writer both. So an empty mailbox goes
    straight back at the name, installed by a link from a file already holding
    [], because a link is atomic and fails rather than overwriting. A sender
    that got there first in that gap keeps its file and its mail; this takes
    nothing from it.

    Returns (the bytes for the receipt, the staged file). The caller unlinks
    the staged file once the receipt naming those bytes is on disk, so a crash
    in between leaves the mail in the staged copy rather than nowhere.
    """
    team_dir = RESOLVER.team_dir(team)
    box = RESOLVER.inbox_path(team, name)
    key = f"inboxes/{box.name}"
    live = RESOLVER.receipt_contents(team_dir, only=box.name)
    if live[key]["size"] is None:
        return None, None      # no mailbox here to archive

    staged = staged_path(box)
    try:
        os.rename(box, staged)
    except OSError as exc:
        die(f"cannot move {name}'s inbox aside to archive it: {exc}")
    seed = staged.with_name(staged.name + ".seed")
    try:
        seed.write_text("[]")
        os.link(seed, box)
    except FileExistsError:
        warn(f"{box} was remade while its mail was being archived; whatever is "
             "in it now belongs to whoever wrote it and is left alone")
    except OSError as exc:
        warn(f"{box} could not be put back as an empty mailbox: {exc}; a sender "
             "finds no inbox there until something seeds one")
    finally:
        try:
            seed.unlink()
        except OSError:
            pass

    caught = RESOLVER.receipt_contents(team_dir, only=staged.name)
    taken = caught[key]["text"] if differing(live, caught) else live[key]["text"]

    again = RESOLVER.receipt_contents(team_dir, only=staged.name)
    if differing(caught, again):
        # Same refusal as the reap's, for the same reason: one write past the
        # cut is enough to say the file is not ours to take.
        back = RESOLVER.receipt_contents(team_dir, only=box.name)
        if back[key]["text"] == "[]":
            os.rename(staged, box)   # the cut, run backwards
            where = box
        else:
            where = staged           # a sender is using the name; leave it be
        die(f"{name}'s inbox changed after it was moved aside, so something is "
            f"still writing to it. Nothing was archived and nothing was emptied; "
            f"the mail is at {where}")
    return taken, staged


def apply_restamp(plan):
    """Apply a proved restamp; its only receipt is the in-file record."""
    if plan["objections"] or not plan["proved"]:
        raise ValueError("apply_restamp was handed an unproved plan")
    path = plan["path"]
    try:
        keep_mode = path.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    replace_text(path, "\n".join(plan["lines"]) + "\n", mode=keep_mode)


def reap_blockers(stamped, args, table=None):
    """Why this team cannot be retired: one line per objection, under a heading
    that says what the group is and how to get past it. Read-only, so a caller
    can know it is blocked before it asks anyone anything - the reason a
    redirect presents one decision and not three.

    The lines are shaped for warn/die: a heading, then its bullets, so ten
    objections read as a list rather than a wall, and a bounded list says how
    much it left out. The way out heads its group rather than trailing its
    last bullet, so it reads as belonging to the group.

    A process that both wears the team and holds a transcript stamped with it
    arrives as one row and is listed once, in the group whose remedy it needs:
    holding is the strict one, since --force cannot rewrite a file under a
    live writer.
    """
    table = RESOLVER.process_table() if table is None else table
    rows = RESOLVER.reap_objections(stamped, table, archive_mail=args.with_mail)
    held = [r for r in rows if "holds" in r["kinds"]]
    alive = [r for r in rows if "holds" not in r["kinds"]
             and r["kinds"] & {"wears", "operates"}]
    mail = [r for r in rows if "mail" in r["kinds"]]
    lines = []

    def blocker(group, heading):
        lines.append(heading)
        lines.extend(f"- {r['said']}" for r in group[:4])
        if len(group) > 4:
            lines.append(f"- and {len(group) - 4} more like these")

    if mail:
        blocker(mail, "mail is waiting, and --with-mail archives it into the receipt:")
    if alive and not args.force:
        blocker(alive, "a live process runs as it, and --force instead rewrites the "
                       "team this conversation comes back as: two fields, receipted, "
                       "reversible:")
    if held:
        blocker(held, "a live process holds a transcript stamped with it; "
                      "stop it first, nothing forces this one:")
    return lines


def rebind_reap(stamped, dest, args, prefix="", path=None, fatal=True):
    """Retire the stamped team so a rebind onto dest holds - or, on --force
    against a living team, restamp the window-start instead. Returns which of
    the two it took, or False when it was blocked and the caller lives.

    --force never buys a reap: it buys the OTHER trade, two fields of
    testimony rewritten in place with a receipt confessing the old values.
    Mail objections keep their own remedy (--with-mail); a live holder of
    the transcript itself is absolute either way - a whole-file replace
    under a live appender is the lost-update disease, self-inflicted.

    Invariant, not accident: the destination team's roster must be readable
    at boot or the session comes up identity-less. The tool meets it because
    registration precedes launch; if that order ever changes, this sentence
    is the tripwire. A reaped life also applies no teamAllowedPaths (hook
    init is structurally unreachable with the stamped team absent); a
    restamped life keeps its hooks, since the destination roster loads.
    """
    table = RESOLVER.process_table()
    lines = reap_blockers(stamped, args, table)
    if lines:
        said = (f"a rebind onto {dest} needs {stamped} retired, and it "
                "refuses:\n" + "\n".join(lines))
        # A redirect is a courtesy the run offers, so it reports and leaves
        # the agent where it is; an explicit --into-team was asked for, so it
        # stops the run.
        if fatal:
            die(said)
        warn(said)
        return False
    # Nothing objects that --force does not answer: a live wearer is what the
    # restamp is for, and reap_blockers has already withheld it under --force.
    if args.force and RESOLVER.reap_objections(stamped, table,
                                               archive_mail=args.with_mail):
        holders = (RESOLVER.runtime(table)["transcripts"].get(
            path.stem, {"others": [], "ours": []}) if path else
                   {"others": [], "ours": []})
        if holders["others"] or holders["ours"]:
            pid = (holders["others"][0]["pid"] if holders["others"] else
                   holders["ours"][0]["pid"])
            die(f"pid {pid} holds this transcript; a restamp under a live "
                "writer loses whatever it writes next. Stop it first, then "
                "retry with --force")
        plan = RESOLVER.rewriter.restamp_plan(path, dest)
        if plan["objections"] or not plan["proved"]:
            die("; ".join(plan["objections"]) or "the rewrite could not be proved")
        step(args.dry_run,
             f"would rewrite the team this conversation comes back as: {stamped} "
             f"-> {dest}  (receipt: last {RESTAMP_RECORD} record in {path})",
             f"rewrote the team this conversation comes back as: {stamped} "
             f"-> {dest}  (receipt: last {RESTAMP_RECORD} record in {path})",
             indent=prefix)
        if not args.dry_run:
            apply_restamp(plan)
        print(f"{prefix}rebound  this transcript runs as {dest} from now on; "
              "nothing further is needed")
        return "restamped"
    receipt = RECEIPTS_DIR / f"{stamped}.json"
    print(f"{prefix}{'would reap' if args.dry_run else 'reaped'}   {stamped}  "
          f"(roster archived: {receipt})")
    # One call for both tenses, so the preview is the same read the real run
    # starts from rather than a second account of it.
    reap_team(stamped, dry=args.dry_run, prefix=prefix + "         ")
    print(f"{prefix}rebound  this transcript now runs as {dest}")
    print(fill(f"{prefix}fragile  it goes back to {stamped} if that team is ever "
               f"recreated; run /compact in it to make {dest} permanent"))
    print(fill(f"{prefix}quiet    until then it sends no idle notifications; "
               "mail still works in both directions"))
    return "reaped"


def ask_default_no(question, dry_run=False):
    """Ask one y/N question. A preview or input-less run takes the default."""
    if dry_run:
        print("choice   no  (dry run; y/N defaults to no)")
        return False
    if not sys.stdin.isatty():
        print("choice   no  (no terminal; y/N defaults to no)")
        return False
    try:
        answer = input(question + " [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer in ("y", "yes")


def promotion_identity(entry, args):
    """(name, team, name_defaulted, team_evidence) for one promote."""
    typed_name, typed_team = name_and_team(args.as_) if args.as_ else (None, None)
    name = typed_name or entry["name"] or entry["task_id"]
    if typed_team:
        return name, typed_team, not typed_name, "--as-agent"

    current_team, evidence = RESOLVER.team_for_parent_session(entry["parent"])
    if not current_team:
        half = (f"--as-agent {args.as_} gives a name and no team" if args.as_
                else f"no --as-agent was passed; {name} is the name taken from "
                     "the side transcript")
        die(f"{half}. The current parent session {entry['parent']} has no deducible "
            f"team ({evidence}); type --as-agent {agent_id_of(name, '<team>')}")

    terminal = RESOLVER.rewriter.terminal_receipt_in_file(entry["path"])
    undo_identity = ((terminal.get("name"), terminal.get("team"))
                     if terminal else (None, None))
    can_offer = (terminal and terminal["direction"] == "demote"
                 and all(undo_identity) and undo_identity[1] != current_team)
    if can_offer:
        undo = RESOLVER.rewriter.conversion_plan(
            entry["path"], "promote", identity=undo_identity,
            unwrap=True if getattr(args, "unwrap", False) else None)
        clean = (undo.get("proved") and not undo["receipt"].get("_emitted"))
        if clean:
            print(fill(f"undo     the final demote receipt can restore "
                       f"{agent_id_of(*undo_identity)} exactly"))
            print(fill(f"current  this side transcript now belongs to parent "
                       f"{entry['parent']}, whose deduced team is {current_team} ({evidence})"))
            if ask_default_no("cleanly undo that demote instead", args.dry_run):
                return undo_identity[0], undo_identity[1], False, "accepted clean undo"

    # When both choices name the same team, retaining the receipt's name makes
    # the opposite conversion an exact undo. A typed name remains explicit.
    if (terminal and not typed_name and terminal["direction"] == "demote"
            and terminal.get("team") == current_team and terminal.get("name")):
        name = terminal["name"]
    return name, current_team, not typed_name, evidence


def run_promote(args):
    """--promote <side> [--as-agent name@team]: a side transcript becomes a teammate."""
    entry, why = RESOLVER.side_transcript(args.promote)
    if not entry:
        die(why)
    name, team, defaulted, team_evidence = promotion_identity(entry, args)
    # The spoken identity goes in before the plan is built, because until the
    # first launch registers this member the promoted transcript is the only
    # thing that says who it is, and it says so in the line it carries.
    plan = RESOLVER.rewriter.conversion_plan(
        entry["path"], "promote", identity=(name, team),
        unwrap=True if getattr(args, "unwrap", False) else None)
    if plan["objections"] or not plan["proved"]:
        die("; ".join(plan["objections"]) or "the inverse could not be proved")
    dest = plan["dest_path"]
    if dest.exists():
        die(f"a transcript already exists at {dest}; refusing the collision")
    settled = int(time.time() * 1000) - 60_000
    if entry["mtime"] >= settled and not args.force:
        die("this side transcript was written within the last minute; its task "
            "may still be running. --force to convert it anyway")
    print(f"promote  {entry['parent'][:8]}/{entry['name'] or entry['task_id']}  "
          f"({entry['grammar']}, {len(plan['lines'])} lines)")
    if defaulted:
        print(f"name     {name}  (from the side transcript's meta)")
    print(f"as       {agent_id_of(name, team)}")
    if not (args.as_ and name_and_team(args.as_)[1]):
        print(f"team     {team}  ({team_evidence})")
    print(f"into     {dest}")
    if plan["receipt"].get("_emitted"):
        print(f"receipt  wrote the last {RECEIPT_RECORD} record in {dest}")
    else:
        print(f"receipt  consumed the inverse {RECEIPT_RECORD} record")
    # One spelling of the launch line; the dry and real paths differ only in
    # their annotation, so the preview cannot drift from what a run prints.
    launch = [sys.argv[0], agent_id_of(name, team), "--resume", dest.stem]
    launch_line = f"launch   {shlex.join(launch)}"
    if args.dry_run:
        print(f"{launch_line}  (dry run; nothing written)")
        return 0
    materialize(plan)
    if args.no_launch:
        print("member   recorded in the transcript; the population and the doctor "
              "see it, and the first launch registers it")
        print(f"{launch_line}")
        return 0
    os.execvp(launch[0], launch)


def demotion_parent(path, mate, mate_team, args):
    """(session, evidence) for the side transcript a demote will create."""
    if args.into:
        return args.into, "--into-session"
    receipt = RESOLVER.receipt_carried_by(path)
    if (receipt and receipt["direction"] == "promote"
            and receipt.get("parent")):
        return receipt["parent"], "the latest promotion receipt"
    if not mate_team:
        return None, "no promotion receipt or current team names a parent"

    lead, why = RESOLVER.team_lead_transcript(mate_team)
    if not lead:
        return None, f"no promotion receipt; {why}"
    if lead == path:
        return None, (f"no promotion receipt, and this transcript is itself the lead "
                      f"of {mate_team}")

    print(fill("warning  no promotion receipt records the former parent, so this "
               "cannot be selected as a clean undo"))
    print(fill(f"candidate the transcript currently belongs to {mate_team}; its lead "
               f"session is {lead.stem} ({why})"))
    question = f"demote it under team {mate_team}'s lead session {lead.stem}"
    if args.dry_run or not sys.stdin.isatty():
        ask_default_no(question, dry_run=args.dry_run)
        die(f"left unchanged; pass --into-session {lead.stem} explicitly to choose that parent")
    if not ask_default_no(question):
        die(f"left unchanged; pass --into-session {lead.stem} explicitly to choose that parent")
    return lead.stem, f"confirmed team lead of {mate_team}"


def run_demote(args):
    """--demote <session> [--into-session <parent>]: a teammate becomes a side transcript."""
    path, mate, mate_team = RESOLVER.demote_subject(args.demote)
    if not path:
        die(f"no transcript for {args.demote!r}; name the session uuid")
    table = RESOLVER.process_table()
    # Both halves of the holder question, self first: the agent demoting the
    # very transcript it is running is the caller this gate most needs to
    # stop. No --force: embedding the file one's own harness will next flush
    # is never right.
    holders = RESOLVER.runtime(table)["transcripts"].get(
        path.stem, {"others": [], "ours": []})
    if holders["ours"]:
        die(f"you are demoting the transcript you are running (pid "
            f"{holders['ours'][0]['pid']}); nothing can embed a conversation from inside it")
    if holders["others"] and not args.force:
        die(f"pid {holders['others'][0]['pid']} is running this conversation and appending to "
            "its file; a demote copies that file and then deletes it, so "
            "whatever the process writes after the copy is lost. --force overrides")
    beheads = RESOLVER.live_led(path.stem)
    if beheads and not args.force:
        die(f"this transcript leads {', '.join(beheads)} with members running; "
            "demoting it beheads them. --force overrides")
    if mate_team and mate:
        waiting = RESOLVER.inbox_state(mate_team).get(mate)
        if waiting and waiting[0] is None and not args.with_mail:
            die(f"{mate}'s inbox in {mate_team} is {waiting[1]}; it may hold "
                "mail this demote would lose. Repair it, or pass --with-mail "
                "to preserve its bytes in a mail archive")
        if waiting and waiting[0] and not args.with_mail:
            die(f"{waiting[0]} message(s) wait in {mate_team}'s inbox for {mate}, "
                f"oldest {waiting[1]}; read them first or pass --with-mail "
                "to preserve them in a mail archive")
    into, into_evidence = demotion_parent(path, mate, mate_team, args)
    plan = RESOLVER.rewriter.conversion_plan(path, "demote", into=into)
    if plan["objections"] or not plan["proved"]:
        die("; ".join(plan["objections"]) or "the inverse could not be proved")
    if plan["dest_path"].exists():
        die(f"a side transcript already exists at {plan['dest_path']}; "
            "refusing the collision")
    print(f"demote   {path.stem[:8]}  ->  {plan['dest_path']}")
    if not args.into:
        print(f"parent   {into}  ({into_evidence})")
    if args.dry_run:
        return 0
    staged_mail = None
    if mate_team and mate and args.with_mail:
        plan["receipt"]["mail"], staged_mail = archive_inbox(mate_team, mate)
    embed(plan)
    if staged_mail is not None:
        # The mail archive is on disk now, so the copy it was read from can go.
        # Until this point a crash leaves the mail in that copy.
        staged_mail.unlink()
        print(f"mail     {demote_mail_receipt_path(path.stem)}")
    consumed = plan["receipt"].get("_consumed")
    emitted = plan["receipt"].get("_emitted")
    if consumed and emitted:
        print("receipt  replaced the inverse record with a demote record in the side transcript")
    elif consumed:
        print(f"receipt  consumed the inverse {RECEIPT_RECORD} record")
    else:
        print(f"receipt  wrote a demote {RECEIPT_RECORD} record in the side transcript")
    return 0


# One layout for the ledger's header and its rows, so a label cannot drift
# off the column it names. The state column is as wide as the longest state
# ("unknown recipient"), so every summary starts in the same column.
MAIL_ROW = "{sent:<19}  {sender:>14} -> {to:<14} {state:<17} {summary}"


def run_mail_ledger(selector=None):
    """A team's mail, send side joined against delivery side. Read-only.

    A row is a per-send fact and stays one. The explanation attached to a row
    is not: seventeen sends to one unknown name printed the same sentence
    seventeen times. So the explanations are grouped by addressee and state
    and said once under the rows, each carrying how many sends it covers.
    The states themselves stay on their own rows, where they were asked for.
    """
    if not selector:
        die("--mail-ledger needs a team, as session-<id> or a prefix of it")
    team = selector if selector.startswith("session-") else f"session-{selector[:8]}"
    ledger = RESOLVER.mail_ledger(team)
    if not ledger:
        die(f"no authored mail found for {team} (no stamped transcripts, or "
            "nobody used SendMessage)")
    print(MAIL_ROW.format(sent="sent", sender="from", to="to", state="state",
                          summary="summary"))
    # What the fixed columns leave. Formatting the row with every field empty
    # measures the layout rather than restating its widths here.
    room = max(term_width() - len(MAIL_ROW.format(
        sent="", sender="", to="", state="", summary="")), 24)
    notes = {}
    for entry in ledger:
        print(MAIL_ROW.format(
            sent=ms_str(entry["sent"]), sender=entry["sender"],
            to=entry["to"] or "?", state=entry["state"],
            summary=clip(entry["summary"], room)))
        if entry["state"] not in ("delivered", "protocol"):
            # Keyed on the detail too: within a group it is the same sentence
            # every time, and a group whose detail ever differed gets its own
            # note rather than losing one of them.
            key = (entry["to"] or "?", entry["state"], entry["detail"])
            notes[key] = notes.get(key, 0) + 1
    if notes:
        print(fill("\nnotes    one per addressee and state, however many sends "
                   "repeat it"))
        counted = {key: f"{n} send{'' if n == 1 else 's'}, {key[1]}"
                   for key, n in notes.items()}
        column = max(len(said) for said in counted.values())
        for key in notes:
            to, _state, detail = key
            head = f"  {to:<14} {counted[key]:<{column}}  "
            # fill hangs a continuation under the first column of a line, which
            # here is the addressee. The detail is the last column, so a long
            # one is indented back to it rather than into the counts.
            body = fill(detail, width=max(term_width() - len(head), 24)).split("\n")
            print("\n".join([head + body[0]]
                            + [" " * len(head) + line for line in body[1:]]))
    tallies = collections.Counter(e["state"] for e in ledger)
    print("\n" + ", ".join(f"{n} {state}" for state, n in tallies.most_common()))
    return 1 if tallies.get("unexplained") else 0


def run_sides(selector=None):
    """List side transcripts grouped under the sessions they hang from,
    newest first. Read-only; the engine classifies.

    The grammar column is the load-bearing one: conversion acts only on the
    two shapes it can prove an inverse for, so this listing is also the
    census of what a promote could and could not touch. A machine-wide
    sweep shows each parent's newest few and counts the rest by grammar,
    because nine hundred interleaved rows are a dump, not a report; naming
    a parent lists it in full.
    """
    sides = RESOLVER.side_transcripts()
    named = bool(selector)
    if selector:
        want = selector[len("session-"):] if selector.startswith("session-") else selector
        sides = [e for e in sides if e["parent"].startswith(want)]
        if not sides:
            die(f"no side transcripts under a session starting {selector!r}")
    sides.sort(key=lambda e: e["mtime"], reverse=True)
    counts = collections.Counter(e["grammar"] for e in sides)

    by_parent = {}
    for e in sides:
        by_parent.setdefault(e["parent"], []).append(e)
    shown_parents = list(by_parent) if named else list(by_parent)[:15]
    if not named:
        plural = "s" if len(by_parent) != 1 else ""
        print(fill(f"side transcripts under {len(by_parent)} session{plural}, "
                   "most recently active first; --sides <session> lists one in full"))
    cap = None if named else 3
    for parent in shown_parents:
        entries = by_parent[parent]
        breakdown = collections.Counter(e["grammar"] for e in entries)
        said = ", ".join(f"{n} {g}" for g, n in breakdown.most_common())
        print(f"\n{parent}  ({said})")
        title = bounded_title(
            (RESOLVER.transcript_fact(parent) or {}).get("title"), 90)
        if title:
            print(fill(f"  {title}"))
        for e in entries[:cap]:
            name = e["name"] or e["task_id"]
            kind = e["agent_type"] or "?"
            print(f"  {name:32} {e['grammar']:15} {kind:16} {ms_str(e['mtime'])}")
            if e["grammar"] == SIDE_CLASS_UNCLASSIFIABLE:
                print(fill(f"    {e['detail']}"))
        left = len(entries) - len(entries[:cap])
        if left:
            print(f"  ...and {left} more  (--sides {parent[:8]} lists them)")
    folded_parents = len(by_parent) - len(shown_parents)
    if folded_parents:
        folded_count = sum(len(by_parent[p]) for p in list(by_parent)[15:])
        print(fill(f"\n...and {folded_parents} older "
                   f"session{'s' if folded_parents != 1 else ''} holding "
                   f"{folded_count} side transcript{'s' if folded_count != 1 else ''}; "
                   "--sides <session> lists any of them"))
    total = sum(counts.values())
    print(f"\n{total} side transcript{'s' if total != 1 else ''}: " +
          ", ".join(f"{n} {g}" for g, n in counts.most_common()))
    return 0


def conformance(part, whole):
    """A census row's `part` of `whole`: the ratio, or a quieter form when
    everything counted conforms.

    Most of these rows read n/n, and printing the ratio anyway makes the eye
    compare two numbers on every line to find the one line worth stopping at.
    "all n" leaves the slash to the rows that have something to say. Nothing
    counted keeps the ratio, because "all 0" claims a conformance no member
    demonstrated.
    """
    return f"all {whole}" if whole and part == whole else f"{part}/{whole}"


def run_census():
    """Count what this machine's ~/.claude actually contains. Read-only.

    Every number comes from the readers the tool itself resolves with, which is
    the point. A probe that re-implements a reader judges the behaviour by
    its own answer: a regex that cannot tell a label record from an identity
    stamp reports damage that does not exist, and a bounded window read as if
    it were the whole file reports a session title as an identity. A census built on the
    engine cannot disagree with the engine; if a reader is wrong, the census
    reports something implausible instead of accusing the tool.

    The shapes differ between machines, which is why the frequencies live in a
    command rather than in a docstring: run it on the box in question.

    What it counts is that box, not the harness. A ~/.claude is written by the
    harness, by this tool, and by anyone following the hand-forging recipes, and
    the last two leave rosters that look like the first. So a shape seen here is
    evidence that the shape occurs, never evidence that the harness produces it:
    check whether our own ecosystem could have written it before concluding
    anything about the harness from a count.
    """
    print(f"census of {CLAUDE_DIR}\n")

    rosters = RESOLVER.rosters()
    members = [(cfg, data, member) for cfg, data, _ in rosters
               for member in data.get("members", [])]
    id_agrees = sum(1 for _, _, m in members
                    if m.get("agentId") and m.get("name")
                    and name_and_team(m["agentId"])[0] == m["name"])
    id_total = sum(1 for _, _, m in members if m.get("agentId") and m.get("name"))
    lead_agrees = sum(1 for _, data, _ in rosters_leads(rosters)
                      if data.get("leadAgentId") == agent_id_of("team-lead", data.get("name")))
    print("identity")
    print(f"  roster members whose id is name@team   {conformance(id_agrees, id_total)}")
    print(f"  rosters whose lead is team-lead@team   {conformance(lead_agrees, len(rosters))}")

    payload_pairs = [(p.get("agent_id"), p.get("name"), p.get("team_name"))
                     for p in RESOLVER.spawn_payloads()]
    payload_ok = sum(1 for aid, name, team in payload_pairs
                     if aid and name and team and aid == agent_id_of(name, team))
    payload_total = sum(1 for aid, name, team in payload_pairs if aid and name and team)
    print(f"  spawn payloads whose id is name@team   "
          f"{conformance(payload_ok, payload_total)}")

    resolves = sum(1 for _, data, _ in rosters
                   if data.get("leadSessionId") and RESOLVER.transcript_path(data["leadSessionId"]))
    named = sum(1 for _, data, _ in rosters if data.get("leadSessionId"))
    print("\nleads")
    print(f"  rosters naming a lead session          {conformance(named, len(rosters))}")
    print(f"  ...whose session is a real transcript  {conformance(resolves, named)}")
    print("  ...which is the shape resolved from the roster alone; the rest are")
    print("     found through the records of who spawned whom")

    known = RESOLVER.known_teams()
    by_evidence = collections.Counter(known.values())
    print("\nteams")
    for evidence, count in by_evidence.most_common():
        print(f"  {evidence:38} {count}")
    # The rows above are one set cut three ways, and the doctor sweeps that
    # whole set. Both reports print a team count and they are different
    # numbers, so each says which set its number is over; adjacent counts of
    # two different things otherwise read as one of them being wrong.
    print(fill(f"  ...{len(known)} teams in all, each on one row above, under the "
               f"strongest evidence for it; --doctor --all examines this same "
               f"set, a block per team"))
    # Two columns, each labelled, because "contested" means two different things
    # and an unlabelled count of either invites a disagreement between people who
    # are both measuring correctly.
    claimed = {t: {path for _stamp, path in hits} for t, hits in RESOLVER.led_teams().items()}
    contested = {t: paths for t, paths in claimed.items() if len(paths) > 1}
    unresolved = [t for t in contested if not RESOLVER.lead_transcript_for(t)[0]]
    print(f"  teams claimed by several transcripts    {len(contested)}"
          + (f" (up to {max(len(v) for v in contested.values())} each)" if contested else ""))
    print(f"  ...still unresolved after corroboration {len(unresolved)}")
    print("  ...the rest are decided by the ladder; these are refused, not guessed")

    stamps = RESOLVER.stamp_index()
    both = sum(1 for name, team in stamps.values() if name and team)
    name_only = sum(1 for name, team in stamps.values() if name and not team)
    print("\ntranscripts")
    print(f"  stamped with a name and a team         {both}")
    print(f"  stamped with a name and no team        {name_only}")
    if name_only:
        # Only when there is something to explain. Under a zero this described
        # a category the machine does not have.
        print("  ...either ran team-less or were launched with mismatched team flags")
    return 0


def rosters_leads(rosters):
    """The roster entries that name a lead, for counting."""
    return [(cfg, data, mtime) for cfg, data, mtime in rosters if data.get("leadAgentId")]


def run_cleanup(dry=False):
    """Everything the SessionStart hook does: reap what nothing can use.

    No record is kept of the id a boot is handed: it names the transcript,
    not the team the boot mints.

    The outcome is said first and the per-team reasons after it, because a
    preview whose first line is its twenty-ninth "keeping" makes the reader
    scroll to learn that nothing happened. In the hook the whole sweep is
    still silent unless something was actually removed.
    """
    sockets = cleanup_sockets(dry)
    removed, kept, locks = cleanup_teams(dry)
    said = "would remove" if dry else "removed"
    if sockets:
        print(fill(f"{said} {len(sockets)} dead socket(s): {', '.join(sockets)}"))
    if removed:
        print(fill(f"{said} {len(removed)} empty team(s): {', '.join(removed)}"))
    if locks:
        print(fill(f"{said} {len(locks)} roster lock(s) this tool left behind: "
                   f"{', '.join(locks)}"))
    if dry:
        if not (sockets or removed or locks):
            print(f"nothing to clean up: {len(kept)} team(s) kept, no dead sockets")
        for team, why in kept:
            print(fill(f"  keeping {team}: {why}"))
    return 0


HOOK_MARKER = "--cleanup"


def replace_json(path, data, indent=2, raw=False, mode=None):
    """One implementation of the atomic whole-file-write guarantee; every
    writer routes through it.

    `raw` writes the text as given; the default serialises JSON. A reader can
    only ever see a whole file, and the guarantee lives here and nowhere else.
    A replaced file keeps its mode rather than taking the umask; `mode` sets
    one explicitly - a private transcript must not come back group-readable.
    """
    if mode is None:
        try:
            mode = path.stat().st_mode & 0o777
        except OSError:
            mode = None
    if raw:
        tmp = path.with_suffix(path.suffix + f".tmp-{TOOL}")
        tmp.write_bytes(data if isinstance(data, bytes) else data.encode("utf-8"))
    else:
        tmp = path.with_suffix(f".json.tmp-{TOOL}")
        tmp.write_text(json.dumps(data, indent=indent) + "\n")
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


def replace_text(path, text, mode=None):
    """Write text where a reader can only ever see a whole file."""
    replace_json(path, text, raw=True, mode=mode)


def replace_bytes(path, data, mode=None):
    """Write bytes where a reader can only ever see a whole file."""
    replace_json(path, data, raw=True, mode=mode)


def write_settings(settings, data):
    if settings.exists():
        settings.with_suffix(f".json.bak-{TOOL}").write_text(settings.read_text())
    replace_json(settings, data)


def install_hook(command, dry=False):
    """Add the SessionStart janitor hook, preserving everything else.

    A dry run reads the file and writes neither it nor its backup. The two
    outcomes it can preview are different enough to be worth telling apart:
    adding a hook that is not there, and replacing an older command of ours
    that is.
    """
    settings = CLAUDE_DIR / "settings.json"
    try:
        data = json.loads(settings.read_text()) if settings.exists() else {}
    except ValueError as exc:
        warn(f"{settings} is not valid JSON ({exc}); leaving hooks alone")
        return False
    if not isinstance(data, dict):
        warn(f"{settings} is not a JSON object; leaving hooks alone")
        return False

    entries = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    for entry in entries:
        for hook in entry.get("hooks", []):
            existing = hook.get("command") or ""
            if existing == command:
                print(f"ok        SessionStart cleanup hook already in {settings}")
                return True
            if TOOL in existing or "resume-agent --cleanup" in existing:
                # An older command for this same tool: update in place rather
                # than leave two hooks reaping the same things.
                if not dry:
                    hook["command"] = command
                    write_settings(settings, data)
                step(dry, f"would update the SessionStart hook already in {settings} "
                          f"(now: {existing})",
                     f"rehooked  SessionStart in {settings} (was: {existing})", indent="")
                return True
    if not dry:
        entries.append(
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": command,
                        "async": True,  # a janitor must never delay session start
                        "timeout": 10,
                    }
                ]
            }
        )
        write_settings(settings, data)
    step(dry, f"would add the SessionStart cleanup hook to {settings} ({command})",
         f"hooked    SessionStart in {settings} (backup: settings.json.bak-{TOOL})",
         indent="")
    return True


def drop_stale_compdumps(dry=False):
    """Delete completion caches that predate this install.

    zsh does not rescan fpath when a cached dump exists, and oh-my-zsh only
    refreshes it about daily, so a freshly linked completion silently does
    nothing in new shells. The dump is a cache and regenerates on next start,
    so removing it is cheap; leaving it means the install did not take.
    """
    stale = []
    for dump in sorted(Path.home().glob(".zcompdump*")):
        try:
            if dump.suffix == ".zwc" or TOOL not in dump.read_text(errors="replace"):
                if not dry:
                    dump.unlink()
                stale.append(dump.name)
        except OSError:
            continue
    if stale:
        step(dry, f"would clear stale completion cache: {', '.join(stale)}",
             f"cleared stale completion cache: {', '.join(stale)}")


def run_install(dry=False):
    """Symlink the script into ~/.local/bin and its zsh completion onto fpath.

    Under a dry run every act says what it would do and none of them happen:
    no directory is made, no symlink created, no settings file or backup
    written, no completion cache deleted. What a real run would refuse it
    still refuses out loud, so the preview's exit code is the one the install
    would come back with.
    """
    src = Path(__file__).resolve()
    comp_src = src.parent / f"_{TOOL}"
    failed = False

    def link(target, dest):
        nonlocal failed
        if not dry:
            dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.resolve() == target:
            print(f"ok        {dest} -> {target} (already)")
            return
        if dest.exists() or dest.is_symlink():
            warn(f"skipping {dest}: exists and points elsewhere ({dest.resolve()})")
            failed = True
            return
        rel = os.path.relpath(target, dest.parent)
        if not dry:
            dest.symlink_to(rel)
        step(dry, f"would link {dest} -> {rel}", f"linked    {dest} -> {rel}", indent="")

    link(src, Path.home() / ".local/bin" / TOOL)

    bin_path = Path.home() / ".local/bin" / TOOL
    if not install_hook(f"{bin_path} {HOOK_MARKER} >/dev/null 2>&1", dry):
        failed = True

    if not comp_src.exists():
        warn(f"no completion file at {comp_src}; script link done, completion skipped")
        return 1

    # Prefer a dir already on fpath; oh-my-zsh puts custom/completions there.
    omz = Path(os.environ.get("ZSH") or Path.home() / ".oh-my-zsh")
    if omz.is_dir():
        link(comp_src, omz / "custom/completions" / f"_{TOOL}")
        drop_stale_compdumps(dry)
        step(dry, "completion would be active in new shells",
             "completion active in new shells; reload this one with: exec zsh", indent="")
    else:
        comp_dir = Path.home() / ".zsh/completions"
        link(comp_src, comp_dir / f"_{TOOL}")
        print(f"add to ~/.zshrc before compinit: fpath=({comp_dir} $fpath)")
    return 1 if failed else 0


def run_poison(args):
    """Recipe 1 steps 0 and 2: (un)set ANTHROPIC_BASE_URL on the swarm server.

    While poisoned, every NEW pane's claude dies at TCP connect: $0 billed, no
    5-hour window anchored. Processes already running keep the env they were
    born with, in both directions; env is fixed at exec.

    A dry run names the socket and what it would set or clear, and runs no
    tmux command that changes anything. It still reads the server's current
    value, which changes nothing and is the useful half of the preview: it
    says what the set would replace.
    """
    sock = args.socket or RESOLVER.newest_live_socket()
    if not sock:
        die("no live swarm socket; pass --socket claude-swarm-<pid>")
    if not RESOLVER.socket_alive(sock):
        die(f"socket {sock} has no live tmux server; poison lives in server env, nothing to set")

    # Both directions in one shape: what to run, what it would do, what it did,
    # and what to say after. Written as two branches they had to grow a dry
    # guard each, and the guard is the part that must not be got wrong twice.
    if args.poison:
        setenv = ("-g", "ANTHROPIC_BASE_URL", POISON_URL)
        would = f"would poison {sock}: new panes would get ANTHROPIC_BASE_URL={POISON_URL}"
        did = f"poisoned {sock}: new panes get ANTHROPIC_BASE_URL={POISON_URL}"
        after = (f"placeholders will sit in an API error; unpoison with: "
                 f"{TOOL} --unpoison --socket {sock}")
    else:
        setenv = ("-gu", "ANTHROPIC_BASE_URL")
        would = f"would unpoison {sock}: new panes would get a working API again"
        did = f"unpoisoned {sock}: new panes get a working API again"
        after = "live placeholders keep their poisoned env; the swap's env scrub handles the pane"
    if not args.dry_run:
        res = tmux(sock, "set-environment", *setenv)
        if res.returncode != 0:
            die(f"set-environment {' '.join(setenv)} failed on {sock}: {res.stderr.strip()}")
    step(args.dry_run, would, did, indent="")
    if not args.dry_run:
        # What the poison does to a pane, which a preview has not done to one.
        print(after)

    cur = tmux(sock, "show-environment", "-g", "ANTHROPIC_BASE_URL")
    state = cur.stdout.strip() if cur.returncode == 0 else "-ANTHROPIC_BASE_URL (unset)"
    print(f"server env {'still' if args.dry_run else 'now'}: {state}")
    return 0


def team_socket(data, args, table):
    """(socket, why) for the whole team, so every member lands on the same server.

    Evidence strongest first, the same order resolve_socket uses per member:
    --socket, the server already hosting a live member, the live lead's pid, and
    a server named after the team.

    A live member outranks the lead's pid because it is where a process
    demonstrably is, while the pid only says where a server would be if the lead
    had made one. A lead never does: it runs in your terminal rather than a pane,
    so a socket named after its pid holds nothing unless a member happened to be
    launched while that lead was up. Members resurrected without a live lead land
    on the team's own server and never move, so the moment a lead appears the two
    names disagree and the pid names an empty server. Asking the members first is
    what keeps one team on one socket across those transitions.
    """
    if args.socket:
        return args.socket, "--socket"
    team = data.get("name")
    lead_id = data.get("leadAgentId")
    # The lead is skipped because it never runs in a pane, so it can never be
    # the process that answers where the team's server is.
    sock, why = RESOLVER.crew_socket(team, table)
    if not sock:
        # A team whose crew is not running yet still has a roster to go on.
        sock, why = RESOLVER.socket_hosting(
            [m.get("agentId") for m in data.get("members", []) if m.get("agentId") != lead_id],
            table,
        )
    if sock:
        return sock, why
    lead = RESOLVER.agent_runtime(
        agent_id_of("team-lead", team), table,
        parent_session=data.get("leadSessionId"))
    pid = lead["pid"]
    if pid and lead["alive"]:
        return f"{SOCKET_PREFIX}{pid}", f"lead pid {pid}"
    if pid:
        warn(f"the lead of {team} last ran as pid {pid}, which is gone; using the team's own server")
    # Same answer resolve_socket reaches per member, said once: with the lead
    # gone the team gets a server of its own, named after it.
    if team:
        warn(f"no live lead for {team}; standing up that team's own server, as if its lead were up")
        return f"{SOCKET_PREFIX}{team}", f"resurrected server for {team}"
    return None, "unresolved"


class Outcome(collections.namedtuple("Outcome", "status socket is_lead pending_write")):
    """What one agent's run produced: how it went, where it landed, and whether
    it was the lead. The role comes from resolution rather than from the entry
    point, so a single resume and a team resume answer it the same way."""


def report_transcript_writes(pending, args, grace=LAUNCH_WRITE_S):
    """Finish the observation a launch left open.

    launch_survived waits a second and a half for a resumed agent to write its
    own transcript, which is the proof it loaded the session rather than merely
    started a process. A large session takes tens of seconds to get there, so
    "no transcript write yet" is the ordinary result and saying only that leaves
    the run reporting a question instead of an answer. The rest of the run has
    already bought some of the wait; this spends what is left.
    """
    if args.dry_run or not pending:
        return
    print()
    deadline = time.monotonic() + grace
    waiting = list(pending)
    while waiting and time.monotonic() < deadline:
        for item in list(waiting):
            label, path, since = item
            try:
                if path.stat().st_mtime > since:
                    print(f"wrote    {label} loaded its session and wrote its transcript")
                    waiting.remove(item)
            except OSError:
                pass
        if waiting:
            time.sleep(0.5)
    for label, path, _since in waiting:
        warn(f"{label} is running but has not written its transcript in {grace:.0f}s; "
             f"it may still be loading, or it may be stuck before it got there")


def run_agents(args, passthrough, table, jobs, socket=None, prefix=""):
    """Run each prepared invocation, then finish the run once.

    A single agent is a team of one, and both entry points come through here so
    that stays true. Attaching is decided in one place: it depends on this run
    having left something in a pane, not on which entry point asked. A noop
    counts, since an agent already sitting in its pane is worth showing.

    `jobs` is (label, args) pairs; a None args is a member that was skipped.
    `socket` pins the whole run to one server when the caller already knows it,
    as a team does; otherwise the first agent to reach one decides.
    """
    check_flag_scope(passthrough, sum(1 for _, a in jobs if a is not None))
    seen = [label for label, _a in jobs]
    twice = sorted({label for label in seen if seen.count(label) > 1})
    if twice:
        # Two jobs for one agent is two launches of one conversation. The guards
        # that would catch the second read a process table snapshotted before the
        # first, so they see nothing and it proceeds. Refused here rather than in
        # each job-builder, so no future one can reintroduce it.
        die(f"{', '.join(twice)} appears twice in this run; that would start a "
            f"second process on one transcript")
    results, outcomes = [], []
    refused = None
    for label, sub_args in jobs:
        if label is not None:
            print(f"\n[{label}]")
        if sub_args is None:
            print(f"{prefix}skipped")
            results.append((label, "skipped"))
            continue
        try:
            outcome = run_one(sub_args, passthrough, table, prefix=prefix,
                              pending=[o.pending_write for o in outcomes if o.pending_write])
        except Refusal as exc:
            # A member's refusal is that member's problem, the way a member's
            # pane is: the rest of the team still comes up, and the summary,
            # the flag check and the write report still reach every agent that
            # did. The refusal itself is kept, not discarded, and the run ends
            # in it below. Discarding it here left main returning an ordinary
            # code, which reads as a verb that did its work, so the end-of-run
            # audit judged it as one and refused a declaration the run never
            # got far enough to exercise.
            refused = refused or exc
            outcome = Outcome("failed", None, False, None)
        results.append((label, outcome.status))
        outcomes.append(outcome)
        socket = socket or outcome.socket
    if len(jobs) > 1:
        print("\nsummary")
        for label, status in results:
            print(f"  {label:<24} {status}")
    report_transcript_writes([o.pending_write for o in outcomes if o.pending_write], args)
    check_flags_took_effect(passthrough, results, args)
    # The run ends by handing over the lead's command, and attaching would
    # bury it. Keyed on that handover rather than on the lead being in the
    # run: a lead that was already up leaves this shell with nothing to look
    # at, so the swarm is the only thing left to offer.
    handover = any(o.is_lead and o.status == "manual" for o in outcomes)
    # Offered only where a server exists to attach to: after a launch one
    # does, and a noop on a dead socket must not promise a keypress whose
    # only outcome is "nothing to attach to".
    if (not handover and not args.dry_run and socket and RESOLVER.socket_alive(socket)
            and any(s in ("launched", "noop") for _, s in results)):
        print()
        targets = [a.agent_id for _, a in jobs if a is not None and getattr(a, "agent_id", None)]
        if confirm_attach(targets, table, socket):
            maybe_attach(args, socket)
    if refused:
        # Last, so everything the run did manage has already been reported.
        # A run that refused ends in its refusal: the exit code is the one the
        # refusal asked for, and the end-of-run audit, which judges what a verb
        # computed against what it declared, has nothing to judge here.
        raise refused
    return 1 if any(s == "failed" for _, s in results) else 0


def rebuild_roster(team, args, passthrough, table):
    """Forge a reaped team's roster from its lead's transcript, or die saying why.

    Nothing here sends the reader off to forge a roster by hand, because
    everything needed is already here: the lead is found through
    the corroboration ladder, build adopts its identity from the payloads, and
    rebuild_team's lead branch rebuilds the members with the colours and models
    those payloads recorded.
    """
    path, claim = RESOLVER.lead_transcript_for(team)
    if not path:
        die(f"no roster for {team} and none can be rebuilt: {claim['why']}")
    if not claim["corroborated"]:
        # Said here rather than by the answer, because this is the run that
        # acts on it: a listing asks the same question and has nothing to warn
        # about.
        warn(f"resuming the only transcript claiming {team}; nothing corroborates it. "
             f"If that is the wrong conversation, name the right one with --resume")
    print(f"team     {team} has no roster; rebuilding from {path.stem[:8]} ({claim['why']})")
    lead = copy.copy(args)
    lead.team, lead.agent_id, lead.resume = None, None, path.stem
    lead.for_team = team
    ctx = build(lead)
    enforce_ctx(ctx, args)
    config = rebuild_team(ctx, args.dry_run, evidence=claim)
    if not config:
        die(f"could not rebuild a roster for {team}")
    if not args.dry_run and not RESOLVER.has_roster(team):
        die(f"forged a roster for {team} but it is not on disk")
    return config


def select_jobs(members, population, live, lead_id, all_members, team):
    """(members to run, names left out) for one team run.

    Liveness is evidence about the world, a record is evidence about the past,
    and which agents to run is a question about the world. So the live members
    plus the lead, where live means wearing the team in argv whether or not any
    record has heard of it, and the record proposes nobody by itself while
    anyone is alive. Only when nothing is alive does the record become the
    world. This is the live-argv rung's logic at the level of a set: a process
    wearing the team is a member, its identity frozen at exec, for the same
    reason argv outranks stamps. --all is always everything.
    """
    def entry(name):
        # A live member the record lacks is not a former anything. It is running
        # now and merely unrecorded, and a section header calling it an ex-member
        # describes the record's gap as the agent's state.
        kind = "unrecorded" if name in live else "former"
        return {"agentId": agent_id_of(name, team), "name": name, kind: True}

    listed = {m.get("name") for m in members if m.get("name")}
    if all_members:
        members = members + [entry(n) for n in sorted(population) if n not in listed]
        return members, []
    if live:
        kept = [m for m in members if m.get("name") in live or m.get("agentId") == lead_id]
        have = {m.get("name") for m in kept}
        # Every live member, not merely the live ones the record happens to
        # carry: a member running now is the team whether or not the roster ever
        # heard of it, and narrowing the record alone files a working agent
        # under former.
        members = kept + [entry(n) for n in sorted(live - have)]
        listed = {m.get("name") for m in members if m.get("name")}
    return members, [n for n in sorted(population) if n not in listed]


def former_members_note(former):
    """What a default team run is leaving out, or None when it leaves out nothing.

    A bounded sweep says what it dropped. The harness prunes a member from the
    roster when that member finishes, so reviving them all by default would
    restart work that already ended, and dropping them silently would report a
    team smaller than the one on disk as if it were the whole of it.
    """
    if not former:
        return None
    return (f"{len(former)} more belong to this team and are not running; "
            f"pass --all to resume them too")


def run_team(args, passthrough, table):
    data = RESOLVER.roster_of(args.team)
    if data is None:
        data = rebuild_roster(args.team, args, passthrough, table)

    members = data.get("members", [])
    if not members:
        die(f"team {args.team} has no members")
    lead_id = data.get("leadAgentId")
    socket, socket_why = team_socket(data, args, table)

    # Members first, lead last: the lead is not spawned into a pane, so its turn
    # only prints the command for you to run, and that reads better at the end.
    # Members boot fine without it: the mailbox is a directory, not a process.
    # Against the roster in hand, not the one on disk. A rebuilt team's roster is
    # a value this run just forged, and on a dry run it was never written, so
    # asking the disk calls every member of it a former and the union doubles.
    team_state = RESOLVER.team_runtime(args.team, table)
    population = team_state["population"]
    # The strangers half only: this set decides who gets launched, and a member
    # this run is running inside cannot be relaunched by it. run_one refuses that
    # one by name if the roster puts it in the job list anyway.
    live = {name for name, runtime in team_state["runtimes"].items()
            if runtime["others"]}
    members, former = select_jobs(members, population, live, lead_id,
                                  getattr(args, "all_members", False), args.team)
    ordered = sorted(members, key=lambda m: 1 if m.get("agentId") == lead_id else 0)
    where = (f"socket {socket} ({socket_why}, {RESOLVER.socket_state(socket)})" if socket
             else "socket resolved per member")
    print(fill(f"team     {args.team}  ({len(ordered)} members, {where})"))
    note = former_members_note(former)
    if note:
        print(fill(f"         {note}"))

    jobs = []
    for member in ordered:
        agent_id = member.get("agentId")
        name = member.get("name") or "?"
        if member.get("unrecorded"):
            print(f"  [{name}] unrecorded member, running now, will re-register")
        elif member.get("former"):
            print(f"  [{name}] former member, will re-register")
        ensure_inbox(args.team, name, args.dry_run)  # every member, not just the launched ones
        if args.no_lead and agent_id == lead_id:
            jobs.append((name, None))
            continue
        one = copy.copy(args)
        one.agent_id, one.resume, one.team, one.socket = agent_id, None, None, socket
        one.socket_reason = "team socket" if not args.socket else "--socket"
        one.in_team = True  # never exec the lead mid-loop; the members need us alive
        jobs.append((name, one))
    return run_agents(args, passthrough, table, jobs, socket=socket, prefix="  ")


def set_tmux_target(session, window):
    global TMUX_SESSION, TMUX_WINDOW
    TMUX_SESSION = session or TMUX_SESSION
    TMUX_WINDOW = window or TMUX_WINDOW


# Every check this suite defines, registered as the file loads, so what the
# suite contains is a lookup rather than something a run discovers.
UNITS = []

# Checks the runner performs itself, because their subject is the run rather
# than anything a unit can reach.
RUNNER_CHECKS = (("live-checks-say-nothing-mid-run",
                  "a live check writes nothing to stdout or stderr between the verdicts"),)

# The runner's own check when it splits the tier, listed only then, because a
# run that took no shares has nothing to say about them and a row reporting on
# shares that do not exist would pass without asking anything.
SHARED_CHECKS = (("live-shares-report-in-full",
                  "every share of a split live run reported every verdict it ran"),)

# The runner's own check that its tier got to the end, keyed by whether the
# tier is the live one. A tier prints only once it has run everything, so a
# unit that exits or raises takes every verdict gathered before it; this row is
# what says which unit did that. Two ids because a live run inherits the
# read-only tier's rows from the child that ran it, and one id cannot be
# registered twice in one run.
UNIT_ENDED = {
    False: ("every-unit-reported", "no unit ended the read-only run before it reported"),
    True: ("every-live-unit-reported", "no unit ended the live run before it reported"),
}


def ran_unit(run, s):
    """One unit's rows, and what ended the run when the unit did not report.

    Returns (rows, None) from a unit that reported, and ([], what ended it)
    from one that exited or raised. The tier stops there rather than running
    what is left: a unit patches RESOLVER, tmux, sys.stdin and globals and
    restores them on its way out, so a unit after one that never got there
    would be answering against whatever was left set.

    KeyboardInterrupt is not caught. answered() turns a Ctrl-C into a
    sentence about what is still running, and a catch here would take that
    away.

    A raising unit's traceback still reaches the real stderr, printed here
    because catching the exception is what stops Python printing it. A refusal
    has none to print and needs none: it carries what it refused with, so the
    row names the reason even when die() wrote it into a buffer the unit
    discarded. SystemExit is still caught beside it, for a unit ended by
    something that is not a refusal at all.
    """
    try:
        return run(s), None
    except KeyboardInterrupt:
        raise
    except Refusal as refused:
        return [], f"refused: {refused.said}"
    except SystemExit as exc:
        return [], f"SystemExit: {exc.code}"
    except BaseException as exc:
        traceback.print_exc()
        return [], f"{type(exc).__name__}: {exc}"


def unit(*ids, live=False):
    """Register one unit of the suite under the ids it produces."""
    def take(run):
        UNITS.append((run.__name__, ids, run, live))
        return run
    return take


def fixture_line(record, spaced=False):
    """One record of a fixture transcript, as the line a .jsonl file holds.

    Every fixture in this suite that stands up a transcript writes its records
    through here. The compact form is what the harness writes; `spaced=True`
    supplies the second byte-stable form accepted by the conversion codec.

    Deliberately not the writer under test. _codec_dump is what the product
    spells a line with; a fixture that asked it could not see it go wrong.
    Both use ensure_ascii=False because real transcript text is Unicode.
    """
    kwargs = {} if spaced else {"separators": (",", ":")}
    return json.dumps(record, ensure_ascii=False, **kwargs)


def fixture_receipt(**overrides):
    """One complete current-schema conversion receipt for synthetic tests."""
    receipt = {
        "schema_version": 1,
        "direction": "promote",
        "grammar": SIDE_GRAMMAR_REGULAR,
        "parent": "PARENT",
        "root": "ROOT",
        "dest_stem": "DEST",
        "task_id": "TASK",
        "unwrapped": False,
        "visible_human_wrapper_edits": {
            "original_payloads": [], "intervals": []},
        "source_newline": {"line": "lf", "final": "lf"},
    }
    receipt.update(overrides)
    if receipt.get("grammar") == SIDE_GRAMMAR_FORK_REFERENCE:
        receipt.setdefault("graft", "GRAFT")
        receipt.setdefault("ref", fixture_line({
            "type": "fork-context-ref", "parentSessionId": receipt["parent"],
            "parentLastUuid": receipt["graft"]}))
        receipt.setdefault("prefix_uuids", [receipt["graft"]])
    if (receipt.get("name") and receipt.get("team")
            and receipt.get("name") != "team-lead"
            and "root_stamps" not in receipt):
        receipt["root_stamps"] = {
            "agentName": [False, None], "teamName": [False, None]}
    return receipt


def fixture_target(session, path=None, title=None, identity=None, cwd=None,
                   via="test fixture", objections=()):
    """One immutable resume target for tests that do not run the resolver."""
    supplied = identity or {}
    values = {
        "agentId": supplied.get("agentId"),
        "agentName": supplied.get("agentName"),
        "teamName": supplied.get("teamName"),
        "parentSessionId": supplied.get("parentSessionId"),
        "role": supplied.get("role", "member"),
        "source": supplied.get("source", "test fixture"),
    }
    values["provenance"] = types.MappingProxyType({
        field: supplied.get("provenance", {}).get(
            field, (values[field], 0, values["source"]))
        for field in IDENTITY_FIELDS
    })
    fact = types.MappingProxyType({
        "session": session,
        "path": Path(path or f"/nonexistent/{session}.jsonl"),
        "title": title,
        "mtime": 0,
    })
    return types.MappingProxyType({
        "session": session,
        "transcript": fact,
        "cwd": cwd,
        "cwd_provenance": (cwd, 0, "test fixture"),
        "identity": types.MappingProxyType(values),
        "via": via,
        "objections": tuple(objections),
    })


def fixture_reap_receipt(stem):
    """Parse one team-reap archive for tests that inspect its bytes."""
    try:
        return json.loads((RECEIPTS_DIR / f"{stem}.json").read_text())
    except (OSError, ValueError):
        return None


def check_rows():
    """One place says what registering a check means.

    Returns (the rows registered so far, the function that registers one). A row
    is a check's id, the name it prints under, its verdict and its detail, and
    an id may be registered once. Two rows under one id would let --failed name
    a check that also passed, so a second one stops the run rather than
    reporting either of them.

    Every producer of rows registers here: the read-only tier, a whole live
    tier, one share of one, and the merge of several shares. That last one is
    why a merge folds before it registers rather than after: each share reports
    on its own printing under the one id, and the fold is what makes those into
    the single row the run states.
    """
    rows = []
    seen_ids = set()

    def register(cid, name, ok, detail=""):
        if cid in seen_ids:
            raise RuntimeError(f"duplicate check id: {cid!r}")
        seen_ids.add(cid)
        rows.append((cid, name, ok, detail))

    return rows, register


def _live_context(child=None):
    """Everything the units share, computed once.

    A dependency between units is written down here rather than
    inherited from scope, so a unit run on its own says what it wants
    instead of reading whatever a neighbour left behind.

    child is the read-only run a parent has already done, for a worker given
    one share of the tier. Without it the context runs its own.
    """
    s = types.SimpleNamespace()
    # The suite's own functions, taken from the registry rather than listed: a
    # unit added later is covered without anyone remembering, which is what a
    # hand-kept exemption list gets wrong.
    s.suite_fns = ({run.__name__ for _n, _i, run, _l in UNITS}
                   | {"_suite_context", "_live_context", "run_selftest",
                      "live_checks", "unit"})
    """Checks that need a real process, a real terminal or a real directory.

    Kept apart from the read-only ones because they spawn, chdir and open a pty,
    and --selftest runs from a SessionStart hook where changing nothing is the
    contract. Everything here undoes itself: processes are killed, the cwd is
    restored, temporary trees are removed.

    They exist because the alternative is leaving these paths to one-off
    scripts, and a path only a one-off script ever tested is an untested path.
    """
    import pty
    import subprocess as sp
    # A warning printed while the suite runs is the tool talking to an operator
    # who is not there, and it lands in the middle of the results. The read-only
    # tier is run as a child rather than captured in this process, because
    # capturing our own stderr would swallow a traceback and let a crash read as
    # a clean run. The child is passed no --live, so this does not nest.
    # The child is where the read-only tier runs for a live invocation. Its
    # stderr is what the check below is about, and its verdicts are the tier's
    # own, so they are taken here rather than computed a second time in the
    # parent, so one invocation answers each check once.
    # Running the read-only tier belongs to the invocation once, not to each
    # worker of one. A run given a share is handed what the parent already ran,
    # so a sharded run inherits the same verdicts from the same child instead of
    # answering the read-only tier once per share.
    quiet = child or sp.run([sys.executable, str(Path(__file__).resolve()), "--selftest"],
                           capture_output=True, text=True, timeout=900)
    inherited, summary = verdicts_from(quiet.stdout)
    counted = summary and summary.split("/")[1].split()[0]

    s.counted = counted
    s.inherited = inherited
    s.pty = pty
    s.quiet = quiet
    s.sp = sp
    s.summary = summary
    return s


