@unit(('runtime-api-has-no-legacy-wearers',
       'the runtime API exposes no wearer or lead-pid compatibility path'),
      ('team-runtime-owns-population',
       'team population has no runtime-free compatibility projection'),
      ('process-command-read-stays-in-realm',
       'raw process commands are read only while building the process snapshot'),
      ('runtime-provenance-does-not-branch-on-prose',
       'runtime decisions do not parse resolution provenance prose'),
      ('doctor-consumes-team-runtime',
       'the doctor renders structured team-runtime facts without resolving them'))
def _check_runtime_api_has_no_legacy_wearers(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast, tree = s.ast, s.tree
    funcs, callers_of = s.funcs, s.callers_of
    legacy = sorted(name for name in funcs if name in ("wearers", "lead_pid"))
    lead_owners = callers_of("_lead_process")
    check("runtime-api-has-no-legacy-wearers",
          "the runtime API exposes no wearer or lead-pid compatibility path",
          not legacy and lead_owners == {"agent_runtime"},
          f"legacy functions={legacy}, private callers={sorted(lead_owners)}")

    population_projection = "team_population" in funcs or callers_of("team_population")
    check("team-runtime-owns-population",
          "team population has no runtime-free compatibility projection",
          not population_projection,
          f"function={('team_population' in funcs)}, "
          f"callers={sorted(callers_of('team_population'))}")

    raw_readers = callers_of("_cmdline")
    check("process-command-read-stays-in-realm",
          "raw process commands are read only while building the process snapshot",
          raw_readers == {"process_table"}, ", ".join(sorted(raw_readers)))

    def is_prose_fact(node):
        return ((isinstance(node, ast.Attribute)
                 and node.attr in ("via", "why", "how", "detail"))
                or (isinstance(node, ast.Subscript)
                    and isinstance(node.slice, ast.Constant)
                    and node.slice.value in ("via", "why", "how", "detail")))

    prose_branches = []
    for fn in ast.walk(tree):
        if not isinstance(fn, ast.FunctionDef) or fn.lineno in s.selftest_lines:
            continue
        for node in ast.walk(fn):
            if (isinstance(node, ast.Compare)
                    and any(is_prose_fact(part) for part in ast.walk(node))):
                prose_branches.append(f"{fn.name}:{node.lineno}")
            if (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                    and node.func.attr in ("startswith", "endswith")
                    and is_prose_fact(node.func.value)):
                prose_branches.append(f"{fn.name}:{node.lineno}")
    check("runtime-provenance-does-not-branch-on-prose",
          "runtime decisions do not parse resolution provenance prose",
          not prose_branches, ", ".join(sorted(set(prose_branches))))

    doctor_calls = callers_of("team_runtime")
    report_functions = {"diagnose_team", "doctor_member_lines", "run_doctor"}
    runtime_queries = (
        "agent_runtime", "_lead_process", "resolve_transcript", "transcript_fact",
        "roster_of", "team_lead_session",
    )
    direct = sorted({caller for query in runtime_queries
                     for caller in callers_of(query)} & report_functions)
    helper_source = s.src_of(funcs["doctor_member_lines"]) or ""
    check("doctor-consumes-team-runtime",
          "the doctor renders structured team-runtime facts without resolving them",
          "diagnose_team" in doctor_calls and not direct
          and 'runtime["member_rows"]' in helper_source,
          f"team_runtime callers={sorted(doctor_calls)}, direct={direct}")
    return checked


