    def _tmux_server_fact(self, socket):
        """Return one immutable observation of a tmux server and its panes."""
        path = self._socket_dir() / socket
        try:
            stat = path.stat()
            socket_generation = (
                stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns)
        except OSError:
            socket_generation = ("absent",)
        alive = self._socket_alive(socket)
        server_pid = None
        if alive:
            shown = tmux(socket, "display-message", "-p", "#{pid}")
            if shown.returncode == 0 and shown.stdout.strip().isdigit():
                server_pid = int(shown.stdout.strip())
        server_process = None
        if server_pid:
            state, ppid, started = self._proc_stat(server_pid)
            server_process = immutable({
                "pid": server_pid,
                "ppid": ppid,
                "proc_start": started or "",
                "argv": self._cmdline(server_pid),
                "state": state,
            })
        panes = []
        for pane in self._list_panes(socket) if alive else ():
            state, ppid, started = self._proc_stat(pane["pid"])
            panes.append(immutable({
                **pane,
                "root": immutable({
                    "pid": pane["pid"], "ppid": ppid,
                    "proc_start": started or "",
                    "argv": self._cmdline(pane["pid"]), "state": state,
                }),
            }))
        session_live = bool(
            alive and any(pane["session"] == TMUX_SESSION for pane in panes))
        base_url = ""
        if alive:
            shown = tmux(socket, "show-environment", "-g", "ANTHROPIC_BASE_URL")
            if shown.returncode == 0:
                base_url = shown.stdout.strip().partition("=")[2]
        clients = self._attached_clients(socket) if session_live else 0
        state = ("no server" if not alive else
                 f"server up, no {TMUX_SESSION} session" if not session_live else
                 f"live, {clients} client{'' if clients == 1 else 's'} attached")
        return immutable({
            "socket": socket,
            "path": path,
            "socket_generation": socket_generation,
            "alive": alive,
            "server": server_process,
            "session_live": session_live,
            "panes": tuple(panes),
            "base_url": base_url,
            "clients": clients,
            "state": state,
        })

    @staticmethod
    def _tmux_launch_generation(server, action, target, wanted_present):
        """Facts that can change the selected tmux command or its environment."""
        process = server["server"]
        server_identity = ((process["pid"], process["proc_start"])
                           if process else None)
        return (
            server["socket_generation"], server_identity,
            server["alive"], server["session_live"], server["base_url"],
            action, target, wanted_present,
        )

    def _tmux_launch_action(self, destination, server=None):
        """Select one tmux action from one retained server observation."""
        if destination is None:
            return None
        server = server or self._tmux_server_fact(destination.socket)
        panes = tuple(
            pane for pane in server["panes"]
            if pane["session"] == TMUX_SESSION)
        wanted = next(
            (pane for pane in panes if pane["pane"] == destination.pane), None)
        if not server["session_live"]:
            action, target = "new-session", None
        elif wanted:
            action, target = "split", wanted["pane"]
        elif panes:
            action, target = "split", panes[0]["pane"]
        else:
            action, target = "new-window", None
        wanted_present = bool(wanted)
        return immutable({
            "destination": destination,
            "server": server,
            "action": action,
            "target_pane": target,
            "wanted_present": wanted_present,
            "generation": self._tmux_launch_generation(
                server, action, target, wanted_present),
        })

    def revalidate_launch(self, launch):
        """Compare retained runtime, transcript, and tmux launch generations."""
        changed = []
        selected_action = launch.get("launch_action")
        current_action = self._tmux_launch_action(launch.get("destination"))
        action_matches = bool(
            selected_action is None and current_action is None
            or selected_action is not None and current_action is not None
            and selected_action["generation"] == current_action["generation"])
        if not action_matches:
            changed.append("tmux destination generation")
        process = launch["process"]
        table = self._process_table(refresh=True)
        snapshot = self._runtime(table)
        current_processes = self._runtime_generation(
            snapshot, agent_ids=process["generation_agents"],
            sessions=process["generation_sessions"],
            teams=process["generation_teams"])
        if current_processes != process["generation"]:
            changed.append("launch runtime generation")
        current_transcript = self._file_generation(launch["transcript"]["path"])
        if current_transcript != launch["transcript_generation"]:
            changed.append("launch transcript generation")
        return immutable({
            "matches": not changed,
            "changed": tuple(changed),
            "selected": {
                "action": selected_action,
                "processes": process["generation"],
                "transcript": launch["transcript_generation"],
            },
            "current": {
                "action": current_action,
                "processes": current_processes,
                "transcript": current_transcript,
            },
        })

    def _with_launch_destination(self, launch, requested_socket=None,
                                 socket_reason=None):
        """Complete one launch answer with its destination and pane evidence."""
        process = launch["process"]
        warnings = []
        socket = requested_socket
        why = socket_reason or "--socket" if requested_socket else None
        if not socket:
            crew = process["crew"]
            if crew.destination:
                socket, why = crew.destination.socket, crew.provenance
        if not socket:
            for record in (process.get("runtime") or {}).get("external", ()):
                seat = record["seat"]
                if seat:
                    socket = seat.socket
                    why = f"live pane {seat.pane} of pid {record['pid']}"
                    break
        if not socket:
            team = launch["identity"]["teamName"]
            lead = process["lead"]
            pid, alive, how = lead["pid"], lead["alive"], lead["how"]
            if pid and not alive:
                warnings.append(
                    f"the lead last ran as pid {pid}, which is gone; using the "
                    "team's own server")
                pid = None
            if pid:
                socket, why = f"{SOCKET_PREFIX}{pid}", how
                if not launch["route"]["to_team"]:
                    diagnosis = process["diagnosis"]
                    if diagnosis and not launch["route"]["stale_team_warned"]:
                        reachable, detail = diagnosis["reachable"]
                        if reachable is False:
                            remedy = "; ".join(
                                f"{what} ({cost})"
                                for what, cost in diagnosis["remedies"])
                            warnings.append(
                                f"{detail}{'. ' + remedy if remedy else ''}")
            elif team:
                socket = f"{SOCKET_PREFIX}{team}"
                why = f"resurrected server for {team}"
                warnings.append(
                    f"no live lead for {team}; standing up that team's own server, "
                    "as if its lead were up")
        recorded = launch["settings"].get("tmuxPaneId")
        if recorded and not re.fullmatch(r"%\d+", str(recorded)):
            recorded = None
        pane_reference = None
        destination = None
        launch_action = None
        socket_states = {}
        if socket:
            server = self._tmux_server_fact(socket)
            present = {row["pane"] for row in server["panes"]}
            if recorded and recorded in present:
                state, pane = "present", recorded
            elif recorded:
                state, pane = "gone", None
            else:
                state, pane = "absent", None
            destination = LaunchDestination(socket, pane)
            pane_reference = RosterPaneReference(recorded, state, destination)
            launch_action = self._tmux_launch_action(destination, server=server)
            socket_states[socket] = server["state"]
        for crew_socket in process["crew"].by_socket:
            if crew_socket not in socket_states:
                socket_states[crew_socket] = self._socket_state(crew_socket)
        return types.MappingProxyType({
            **launch,
            "destination": destination,
            "destination_provenance": why,
            "pane_reference": pane_reference,
            "launch_action": launch_action,
            "socket_states": immutable(socket_states),
            "destination_warnings": tuple(warnings),
            "requested_socket": requested_socket,
            "requested_socket_reason": socket_reason,
        })

    def selector_answer(self, token=None, session_uuid=None, agent_id=None,
                        table=None, census=None):
        """Return one complete immutable selector classification and selection."""
        if token is None:
            selection = self._identity(
                session_uuid=session_uuid, agent_id=agent_id,
                table=table, census=census, terminal=TerminalContext())
            return types.MappingProxyType({
                "kind": "agent_id" if agent_id else "uuid",
                "token": agent_id or session_uuid,
                "selection": selection,
                "candidates": (),
                "ambiguity": None,
                "reason": selection["via"],
            })

        kind, value, reason = self._classify(token)
        candidates = ()
        selection = value
        ambiguity = None
        if kind == "name":
            selection = value.path.stem
            candidates = tuple(sorted(self._name_rosters(token)))
        elif kind == "ambiguous":
            ambiguity = reason
            rows = []
            table = self._retained_table(self._process_table() if table is None else table)
            for entry in value:
                candidate_id = entry["member"].get("agentId")
                runtime = self._agent_runtime(candidate_id, table)
                records = runtime["records"]
                rows.append(immutable({
                    "agent_id": candidate_id,
                    "joined": entry["ts"],
                    "running": bool(records),
                    "state_note": records[0]["state_note"] if records else "",
                    "colour": agent_colour(
                        candidate_id, entry["member"],
                        self._spawn_payload(candidate_id)),
                }))
            candidates = tuple(rows)
            selection = None
        return types.MappingProxyType({
            "kind": kind,
            "token": token,
            "selection": selection,
            "candidates": candidates,
            "ambiguity": ambiguity,
            "reason": reason,
        })

    def launch_plan(self, session_uuid=None, agent_id=None, for_team=None,
                    keep_team=False, table=None, census=None, terminal=None,
                    requested_socket=None, socket_reason=None):
        """Return one complete immutable launch answer, including destination."""
        table = (self._process_table(refresh=True) if table is None
                 else tuple(table))
        launch = self._identity(
            session_uuid=session_uuid, agent_id=agent_id, for_team=for_team,
            keep_team=keep_team, table=table, census=census, terminal=terminal)
        return self._with_launch_destination(
            launch, requested_socket=requested_socket,
            socket_reason=socket_reason)

    def _retarget_launch(self, launch, agent_id=None, team=None, parent=None,
                         source="resolved identity", route=None, census=None):
        """Replace coupled launch facts and recompute the exact destination."""
        updated = self._set_effective_identity(
            launch, agent_id=agent_id, team=team, parent=parent,
            source=source, route=route, census=census)
        return self._with_launch_destination(
            updated, requested_socket=launch.get("requested_socket"),
            socket_reason=launch.get("requested_socket_reason"))

    def _objections(self, res, want_name, want_team):
        """Return typed contradictions between transcript and requested identity.

        `enforce_identity` applies `--force` and rebind rules to these facts at the
        action boundary.
        """
        stamped_name, stamped_team = res.stamped("agentName"), res.stamped("teamName")
        objections = []

        if stamped_name is None:
            # Unstamped means a lead transcript. Only an exact rung may claim one.
            if res.strength < EXACT:
                objections.append(("unstamped_below_exact", None, None, res.via))
            return objections

        if want_name and stamped_name != want_name:
            # Name mismatch always remains an objection because Claude Code stamps
            # the launch name onto every later line. Corroboration is included so
            # the refusal can name the appropriate remedy. Corroboration is the
            # basis of the lead claim, so an answer with no claim, or a claim
            # with no basis, is not corroborated.
            corroborated = res.evidence.get("basis") is not None
            objections.append(("name_mismatch", stamped_name, want_name,
                               f"{res.via}|corroborated" if corroborated else res.via))

        if want_team and stamped_team and stamped_team != want_team:
            # Rebinding can tolerate a stale team stamp when a unique name or live
            # argv identifies the requested agent.
            tolerated = (res.strength == NAME_ONLY or res.identity_from_argv())
            why = "tolerated" if tolerated else res.via
            if not tolerated:
                # A transcript that was a teammate first and later led another team
                # carries stamps from the earlier life and payloads from the newer
                # one. Which came first decides what an override means, so the
                # relation is measured rather than left for the reader to guess.
                stamped_ts = res.fields.get("teamName", (None, 0))[1]
                claimed_ts = max((stamp for stamp, payload in self._log(res.path.stem)
                                  if payload.get("team_name") == want_team), default=0)
                if stamped_ts and claimed_ts > stamped_ts:
                    why += "|newer"
            objections.append(("team_mismatch", stamped_team, want_team, why))
        return objections

    def _classify(self, token):
        """Classify a selector as UUID, agent ID, team, name, ambiguity, or unknown.

        Ambiguous results include candidates so callers can render live state while
        Resolver retains the classification decision.
        """
        if UUID_RE.match(token):
            return "uuid", token, "a session uuid"
        if "@" in token:
            return "agent_id", token, "a full agent id"
        team_why = self._team_evidence(token)
        if team_why:
            return "team", token, team_why
        if implicit_team_block(token):
            return ("unknown", None,
                    "matches implicit-team syntax; roster, spawn-record, and transcript-stamp "
                    "searches all returned empty")
        matches = self._roster_entries(name=token)
        teams = {entry["team"] for entry in matches}
        if len(teams) > 1:
            found = self._resolve_transcript(name=token)
            if found:
                return "name", found, (f"carried by {len(teams)} rosters but matched by one "
                                        f"transcript ({found.via})")
            return "ambiguous", matches, f"in {len(teams)} rosters"
        if matches:
            return "agent_id", matches[0]["member"].get("agentId"), "the only roster naming it"
        found = self._resolve_transcript(name=token)
        if found:
            return "name", found, f"matched by transcript ({found.via})"
        return "unknown", None, f"roster search returned empty: {found.reason}"

    def _roster_entries(self, agent_id=None, name=None, team=None, lead_only=False,
                       census=None):
        """Return matching roster entries from one census, newest first."""
        found = [
            entry for entry in self._scan_teams(census)
            if (agent_id is None or entry["member"].get("agentId") == agent_id)
            and (name is None or entry["member"].get("name") == name)
            and (team is None or entry["team"] == team)
            and (not lead_only or entry["member"].get("agentId") == entry.get("leadAgentId"))
        ]
        found.sort(key=lambda entry: entry["ts"], reverse=True)
        return tuple(found)

    def _roster_census(self):
        """Read and parse each stable config once, retaining its descriptor evidence.

        Unreadable configs retain the existing skip behavior. An absent lookup
        therefore does not prove the path is missing. Unstable reads refuse the
        selection rather than interpreting bytes from competing generations.
        """
        out = []
        for cfg in (self._roster_path(d.name) for d in self._team_dirs()):
            observation = self._file_observation(cfg)
            if observation.generation == ("absent",):
                continue
            if not observation.physical:
                die(f"roster {cfg} changed while it was read; select it again")
            problem = None
            try:
                parsed = json.loads(observation.raw)
            except (ValueError, UnicodeDecodeError) as exc:
                parsed = None
                problem = f"invalid JSON: {exc}"
            else:
                if not isinstance(parsed, dict):
                    problem = (f"top-level value is {type(parsed).__name__}, "
                               "expected object")
            out.append(self.RosterSnapshot(
                observation, parsed if problem is None else {}, problem))
        return tuple(out)

    @classmethod
    def _retained_census(cls, census):
        """Detach a census sequence while preserving its complete typed records."""
        retained = census if type(census) is tuple else tuple(census)
        if any(type(record) is not cls.RosterSnapshot for record in retained):
            raise TypeError("a retained census requires complete roster snapshots")
        return retained

    @classmethod
    def _update_census(cls, census, path, replacement=None):
        """Insert, replace or remove one physical path, preserving unrelated records."""
        census = cls._retained_census(census)
        if replacement is not None:
            if type(replacement) is not cls.RosterSnapshot or replacement.path != path:
                raise ValueError("census replacement must describe its selected path")
        found = False
        result = []
        for record in census:
            if record.path == path:
                if not found and replacement is not None:
                    result.append(replacement)
                found = True
            else:
                result.append(record)
        if not found and replacement is not None:
            result.append(replacement)
        if len(result) == len(census) and all(a is b for a, b in zip(result, census)):
            return census
        return tuple(result)

    def _roster_snapshot(self, team, census=None):
        """Return the selected census record unchanged, or a complete absent record."""
        census = (self._roster_census() if census is None else
                  self._retained_census(census))
        found = next((record for record in census if record.team == team), None)
        if found is not None:
            return found
        return self.RosterSnapshot(
            FileObservation(self._roster_path(team), ("absent",), None), {})

    def _rosters(self, census=None):
        """Return complete valid records from one retained census."""
        census = (self._roster_census() if census is None else
                  self._retained_census(census))
        return tuple(record for record in census if record.state == "valid")

    def _roster_of(self, team, census=None):
        """One valid parsed roster from one census, or None for non-valid state."""
        snapshot = self._roster_snapshot(team, census)
        return snapshot.data if snapshot.state == "valid" else None

    def _scan_teams(self, census=None):
        """Every member of every team config from one roster census."""
        entries = []
        for roster in self._rosters(census):
            data = roster.data
            for member in data.get("members", ()):
                entries.append(immutable({
                    "cfg": roster.path,
                    "team": roster.team,
                    "leadSessionId": data.get("leadSessionId"),
                    "leadAgentId": data.get("leadAgentId"),
                    "member": member,
                    "ts": member.get("joinedAt") or data.get("createdAt") or roster.mtime,
                }))
        return tuple(entries)

    def _scan_transcript(self, path):
        """(fields, last_activity_ms) from one session JSONL."""
        fields = {}
        try:
            mtime = int(path.stat().st_mtime * 1000)
        except OSError:
            return {}, 0  # the harness rewrites this tree while we read it
        last_ts = first_ts = 0
        headers = []
        cwds = []

        def put(key, value, ts):
            if value in (None, ""):
                return
            if key not in fields or ts >= fields[key][1]:
                fields[key] = (value, ts)

        try:
            handle = path.open(errors="replace")
        except OSError:
            return {}, mtime
        with handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                # Sidechain and materialized-parent records remain model context,
                # but neither contributes actions or identity to this transcript.
                if rec.get("isSidechain") or not self._authored_here(path, rec):
                    continue
                ts = iso_ms(rec.get("timestamp"))
                if ts:
                    last_ts = max(last_ts, ts)
                    first_ts = first_ts or ts
                kind = rec.get("type")
                # header records carry no timestamp; stamp them with the first real one
                if kind == "agent-setting":
                    headers.append(("agentType", rec.get("agentSetting")))
                elif kind == "permission-mode":
                    headers.append(("permissionMode", rec.get("permissionMode")))
                elif kind == "mode":
                    headers.append(("mode", rec.get("mode")))
                stamp = _identity_stamp(rec)
                for key, value in stamp.items():
                    put(key, value, ts or mtime)
                if kind == "agent-name" and isinstance(rec.get("agentName"), str):
                    # The harness's label channel, not an identity stamp. Its
                    # value is a display name or a session title.
                    put("_label", rec["agentName"], ts or mtime)
                for key in ("cwd", "version", "gitBranch", "effort"):
                    if rec.get(key) is not None:
                        put(key, rec[key], ts or mtime)
                if rec.get("cwd") and (not cwds or cwds[-1] != rec["cwd"]):
                    cwds.append(rec["cwd"])  # /cd moves it mid-session; keep the trail
                msg = rec.get("message")
                model = msg.get("model") if kind == "assistant" and isinstance(msg, dict) else None
                if model and not model.startswith("<"):
                    put("model", model, ts or mtime)  # skip "<synthetic>" error stubs

        for key, value in headers:
            put(key, value, first_ts or mtime)
        if cwds:
            fields["_cwds"] = (cwds, last_ts or mtime)  # underscore keys stay out of the merge
        return fields, (last_ts or mtime)

    def _lead_holders(self, session_uuid, table):
        """Return external and caller-lineage holders of a lead transcript.

        Flag-bound leads appear through `--resume` argv. Plain leads resumed from
        the picker appear through the session registry. This method merges both and
        applies the caller-lineage split to registry rows.
        """
        holders = self._runtime(table)["transcripts"].get(
            session_uuid, {"session": session_uuid, "processes": [],
                           "others": [], "ours": []})
        others = [row["pid"] for row in holders["others"]]
        ours = [row["pid"] for row in holders["ours"]]
        owner = self._runtime(table)["best_by_session"].get(session_uuid)
        if owner and owner["alive"] and owner["pid"] not in others and owner["pid"] not in ours:
            (ours if owner.get("ours") else others).append(owner["pid"])
        return others, ours

    def _session_registry(self):
        """Raw session observations, read once by the runtime snapshot.

        While the selftest runs, only a unit declared to read the machine reads
        the registry, and its fence is told every pid the registry names;
        anywhere else in the selftest the registry is empty
        (_ProcessFence.sees_registry).
        """
        if self._registry is not None:
            return self._registry
        entries = []
        fence = PROCESS_FENCE
        for path in (SESSIONS_DIR.glob("*.json") if fence is None or fence.sees_registry()
                     else ()):
            try:
                data = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if data.get("pid"):
                entries.append(dict(data))
        if fence is not None:
            fence.name(entry["pid"] for entry in entries)
        self._registry = entries
        return entries

    def _configured_teammate_mode(self):
        """Return `teammateMode` from settings, or None for unavailable input.

        `install_hook` owns settings edits; runtime callers consume this parsed
        answer.
        """
        try:
            return json.loads((CLAUDE_DIR / "settings.json").read_text()).get("teammateMode")
        except (OSError, ValueError):
            return None

    def teammate_mode_answer(self):
        """Return the configured teammate mode and tmux compatibility verdict."""
        mode = self._configured_teammate_mode()
        return immutable({
            "mode": mode,
            "available": mode in (None, "tmux", "auto"),
        })

    def _socket_dir(self):
        """Where tmux keeps its socket files. A path question, like roster_path."""
        return Path(os.environ.get("TMUX_TMPDIR") or f"/tmp/tmux-{os.getuid()}")

    def _socket_alive(self, socket):
        """Return whether a tmux server accepts a connection on this socket.

        The AF_UNIX probe takes microseconds and supplies one liveness answer to
        cleanup and launch code.
        """
        path = socket if isinstance(socket, Path) else self._socket_dir() / socket
        probe = socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM)
        probe.settimeout(0.2)
        try:
            probe.connect(str(path))
            return True
        except (ConnectionRefusedError, FileNotFoundError):
            return False
        except OSError:
            return True  # ambiguous: assume live rather than reap or clobber
        finally:
            probe.close()

    def _swarm_sockets(self):
        """Swarm socket files, newest first. The one place that directory is listed."""
        return sorted(self._socket_dir().glob(f"{SOCKET_PREFIX}*"),
                      key=lambda p: p.stat().st_mtime, reverse=True)

    def _newest_live_socket(self):
        """The most recently touched swarm socket with a server behind it."""
        for path in self._swarm_sockets():
            if self._socket_alive(path):
                return path.name
        return None

    def _dead_sockets(self):
        """Swarm socket files with no server behind them, and old enough to say so.

        A socket younger than the grace is not evidence of anything: a server
        mid-bind has a file and no listener yet, and reaping it takes the
        server's name out from under it. Age is the whole of the difference,
        so it is judged here rather than by whoever does the unlinking.
        """
        stale = []
        now = time.time()
        for path in self._swarm_sockets():
            try:
                if now - path.stat().st_mtime < SOCKET_GRACE_S:
                    continue
            except OSError:
                continue
            if not self._socket_alive(path):
                stale.append(path)
        return stale

    def _swarm_session_live(self, socket):
        """Is the swarm session actually up on this socket? Server plus session:
        a live server with no claude-swarm session still needs one created."""
        return bool(socket) and self._socket_alive(socket) and tmux(
            socket, "has-session", "-t", TMUX_SESSION).returncode == 0

    def _attached_clients(self, socket):
        """How many tmux clients are watching the swarm session on this socket."""
        result = tmux(socket, "list-clients", "-t", TMUX_SESSION)
        return len([line for line in result.stdout.splitlines() if line]) if result.returncode == 0 else 0

    def _socket_state(self, socket):
        """What is actually true of this socket right now.

        The `how` label a caller carries only says where the name came from.
        Printed alone, a derived name reads as a running server that may
        already be gone.
        """
        if not socket:
            return "unresolved"
        # The state, not a promise: whether anything gets created is the
        # launch's to say, and a run that noops creates nothing.
        if not self._socket_alive(socket):
            return "no server"
        if not self._swarm_session_live(socket):
            return f"server up, no {TMUX_SESSION} session"
        clients = self._attached_clients(socket)
        return f"live, {clients} client{'' if clients == 1 else 's'} attached"

    def socket_control_answer(self, requested=None):
        """Return the selected swarm socket and its current control state."""
        socket = requested or self._newest_live_socket()
        return immutable({
            "socket": socket,
            "state": self._socket_state(socket),
            "reason": "--socket" if requested else
                      "newest live swarm socket" if socket else
                      "no live swarm socket",
            "alive": self._socket_alive(socket) if socket else False,
        })

    def attach_decision(self, socket, terminal=None, no_attach=False, attach=False,
                        tool_driving=False, is_tty=False):
        """Return one immutable decision about attaching to a launched swarm."""
        terminal = self._terminal_context() if terminal is None else terminal
        alive = bool(socket) and self._socket_alive(socket)
        reason = None
        action = "skip"
        if not socket or no_attach:
            reason = "disabled" if no_attach else "no socket"
        elif not alive:
            reason = "no server"
        elif tool_driving:
            reason = "a Claude Code tool is driving"
        elif not is_tty:
            reason = "not a terminal"
        elif terminal.inside_tmux:
            reason = "already inside tmux"
        elif not attach and self._attached_clients(socket):
            reason = "someone is already watching it"
        else:
            action = "attach"
        if reason and attach and alive and reason not in ("disabled", "no socket"):
            action = "refuse"
        command = ("tmux", "-L", socket, "attach", "-t", TMUX_SESSION) \
            if socket else ()
        return immutable({
            "socket": socket,
            "terminal": terminal,
            "alive": alive,
            "action": action,
            "reason": reason,
            "command": command,
        })

    def launch_observation(self, seat, agent_id, transcript=None, since=None):
        """Wait for one launch and return its complete immutable observation."""
        started = time.monotonic()

        def present():
            table = self._process_table(refresh=True)
            snapshot = self._runtime(table)
            appeared = (self._agent_runtime(agent_id, table)["external"]
                        if agent_id else ())
            if appeared:
                return True, appeared[0]
            if seat:
                occupant = next(
                    (row for row in snapshot["by_seat"].get(seat, ())
                     if self._is_claude(row["argv"])), None)
                if occupant:
                    return True, occupant
            return False, None

        deadline = started + LAUNCH_APPEAR_S
        appeared, process = present()
        while not appeared and time.monotonic() <= deadline:
            time.sleep(0.1)
            appeared, process = present()
        if not appeared:
            return immutable({
                "seat": seat, "agent_id": agent_id, "transcript": transcript,
                "started_at": started, "appeared": False, "survived": False,
                "wrote": False, "process": None, "state": "absent",
                "detail": f"nothing appeared in {LAUNCH_APPEAR_S:.0f}s",
            })

        settle_until = time.monotonic() + LAUNCH_SETTLE_S
        wrote = False
        while time.monotonic() < settle_until:
            if transcript and since is not None:
                try:
                    if transcript.stat().st_mtime > since:
                        wrote = True
                        break
                except OSError:
                    pass
            time.sleep(0.1)
        survived, current = present()
        if wrote:
            survived, detail, state = True, "wrote to its transcript", "running"
        elif survived:
            detail, state = "running, no transcript write yet", "running"
        else:
            detail = f"it started and exited within {LAUNCH_SETTLE_S:.1f}s"
            state = "exited"
        return immutable({
            "seat": seat, "agent_id": agent_id, "transcript": transcript,
            "started_at": started, "appeared": True, "survived": survived,
            "wrote": wrote, "process": current or process, "state": state,
            "detail": detail,
        })

    def _list_panes(self, socket):
        """Return tmux pane rows as session, window, pane, and PID fields.

        A failed tmux query returns an empty pane result.
        """
        res = tmux(socket, "list-panes", "-a", "-F",
                   "#{session_name}\t#{window_id}\t#{pane_id}\t#{pane_pid}")
        if res.returncode != 0:
            return []
        panes = []
        for line in res.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) == 4 and parts[3].isdigit():
                panes.append({"session": parts[0], "window": parts[1],
                              "pane": parts[2], "pid": int(parts[3])})
        return panes

    def _pane_exists(self, socket, pane):
        """Return whether this server currently lists the pane ID."""
        return bool(pane) and any(p["pane"] == pane for p in self._list_panes(socket))

    def _descendants_of(self, root_pid, table=None):
        """Every live pid under this one, as a question rather than a transform.

        A caller asking what it started asks this, so what counts as under a
        process is decided in one place. The suite asks it to tell the
        processes a run made from the ones the machine was already running.
        """
        return self._descendants(root_pid, self._process_table() if table is None else table)

    def _descendants(self, root_pid, table):
        """Return descendant PIDs from an existing process-table snapshot."""
        kids = defaultdict(list)
        for pid, ppid, _ in table:
            kids[ppid].append(pid)
        seen, stack = set(), [root_pid]
        while stack:
            pid = stack.pop()
            if pid in seen:
                continue
            seen.add(pid)
            stack.extend(kids.get(pid, []))
        return seen

    def _seat_index(self, table):
        """Map each live PID to one immutable observed Seat.

        Tmux supplies each pane's root PID. Every process below that root belongs
        to the pane, regardless of intervening shells or launch wrappers. A Seat
        keeps the socket with the server-local pane ID, and the exact Seat object
        is reused by the process record and the runtime index.
        """
        if table is self._seat_table and self._seats is not None:
            return self._seats
        seats = {}
        for path in self._swarm_sockets():
            socket = path.name if isinstance(path, Path) else Path(path).name
            if not self._socket_alive(socket):
                continue
            for pane in self._list_panes(socket):
                seat = Seat(socket, pane["pane"])
                for pid in self._descendants(pane["pid"], table):
                    seats.setdefault(pid, seat)
        self._seat_table = table
        self._seats = types.MappingProxyType(seats)
        return self._seats

    @staticmethod
    def _retained_table(table):
        """Own process rows and argv values while retaining already immutable tuples."""
        rows = []
        for row in table:
            if len(row) != 3:
                raise ValueError("a process row requires pid, parent pid and argv")
            pid, ppid, argv = row
            if type(pid) is not int or type(ppid) is not int:
                raise TypeError("process identifiers must be integers")
            args = argv if type(argv) is tuple else tuple(argv)
            if any(type(arg) is not str for arg in args):
                raise TypeError("process arguments must be strings")
            rows.append(row if type(row) is tuple and args is argv else (pid, ppid, args))
        if type(table) is tuple and all(a is b for a, b in zip(rows, table)):
            return table
        return tuple(rows)

    def _runtime(self, table=None):
        """One canonical runtime snapshot, limited to the declared evidence."""
        table = self._retained_table(self._process_table() if table is None else table)
        if table is self._runtime_table and self._runtime_snapshot is not None:
            return self._runtime_snapshot
        want_registry = self._needs[NEED.REGISTRY] is not DECLARED.ABSENT
        want_seats = self._needs[NEED.SEATS] is not DECLARED.ABSENT
        seats = self._seat_index(table) if want_seats else {}
        if want_seats:
            self._exercise(NEED.SEATS)
        lineage = self._own_lineage(table)
        by_pid = {}
        for pid, ppid, argv in table:
            seat = seats.get(pid)
            proc_state, _current_ppid, started = self._proc_stat(pid)
            claude_process = self._is_claude(argv)
            options = self._argv_options(argv) if claude_process else {}
            session = options.get("--resume")
            agent_id = options.get("--agent-id")
            by_pid[pid] = {"pid": pid, "ppid": ppid,
                           "proc_start": started or "",
                           "proc_state": proc_state or "",
                           "state_note": self._state_note(pid, proc_state),
                           "argv": argv, "args": shlex.join(argv),
                           "is_claude": claude_process,
                           "alive": True, "ours": pid in lineage,
                           "agent_id": agent_id, "session": session,
                           "team": name_and_team(agent_id)[1] if agent_id else None,
                           "seat": seat, "registry": [],
                           "updated": 0, "started": 0}

        observations = []
        if want_registry:
            self._exercise(NEED.REGISTRY)
            for data in self._session_registry():
                alive = self._pid_alive(data["pid"], data.get("procStart"))
                observation = types.MappingProxyType({
                    "pid": data["pid"], "session": data.get("sessionId"),
                    "updated": data.get("updatedAt") or 0,
                    "started": data.get("startedAt") or 0, "alive": alive})
                observations.append(observation)
                record = by_pid.get(data["pid"])
                if alive and record is None:
                    proc_state, ppid, started = self._proc_stat(data["pid"])
                    record = by_pid[data["pid"]] = {
                        "pid": data["pid"], "ppid": ppid,
                        "proc_start": started or data.get("procStart") or "",
                        "proc_state": proc_state or "",
                        "state_note": self._state_note(data["pid"], proc_state),
                        "argv": (), "args": "", "is_claude": False,
                        "alive": True, "ours": data["pid"] in lineage,
                        "agent_id": None, "session": None, "team": None,
                        "seat": None, "registry": [],
                        "updated": 0, "started": 0}
                if alive:
                    record["registry"].append(observation)
                    record["session"] = record["session"] or observation["session"]
                    record["updated"] = max(record["updated"], observation["updated"])
                    record["started"] = max(record["started"], observation["started"])

        for record in by_pid.values():
            record["transcript"] = (self._transcript_fact(record["session"])
                                    if record["session"] else None)
        by_pid = {pid: types.MappingProxyType(
            {**record, "registry": tuple(record["registry"])})
            for pid, record in by_pid.items()}
        by_agent = defaultdict(list)
        by_transcript = defaultdict(list)
        by_seat = defaultdict(list)
        by_session = defaultdict(list)
        live_session_records = []
        for record in by_pid.values():
            if record["agent_id"]:
                by_agent[record["agent_id"]].append(record)
            if record["session"]:
                by_transcript[record["session"]].append(record)
                by_session[record["session"]].append(record)
            if record["seat"]:
                by_seat[record["seat"]].append(record)
            if record["session"] or record["agent_id"] or record["registry"]:
                live_session_records.append(record)
        for observation in observations:
            if observation["session"]:
                by_session[observation["session"]].append(observation)
        best_by_session = {}
        for session, rows in by_session.items():
            best_by_session[session] = max(
                rows, key=lambda row: (1 if row["alive"] else 0,
                                       row.get("updated") or 0))

        transcripts = {
            session: types.MappingProxyType(
                {"session": session,
                 "fact": next((row["transcript"] for row in rows
                               if row["transcript"]), None),
                 "processes": tuple(rows),
                 "others": tuple(row for row in rows if not row["ours"]),
                 "ours": tuple(row for row in rows if row["ours"])})
            for session, rows in by_transcript.items()}
        snapshot = types.MappingProxyType({
            "table": table,
            "records": tuple(by_pid.values()),
            "by_pid": types.MappingProxyType(by_pid),
            "by_agent": types.MappingProxyType(
                {key: tuple(rows) for key, rows in by_agent.items()}),
            "by_transcript": types.MappingProxyType(
                {key: tuple(rows) for key, rows in by_transcript.items()}),
            "transcripts": types.MappingProxyType(transcripts),
            "by_session": types.MappingProxyType(
                {key: tuple(rows) for key, rows in by_session.items()}),
            "best_by_session": types.MappingProxyType(best_by_session),
            "by_seat": types.MappingProxyType(
                {seat: tuple(rows) for seat, rows in by_seat.items()}),
            "registry": tuple(observations),
            "live_sessions": tuple(live_session_records),
        })
        self._runtime_table = table
        self._runtime_snapshot = snapshot
        return snapshot

    @staticmethod
    def _runtime_generation(snapshot, agent_ids=(), sessions=(), teams=(),
                            exclude_pids=()):
        """Fingerprint only process facts that can change a selected operation."""
        agent_ids, sessions, teams = set(agent_ids), set(sessions), set(teams)
        exclude_pids = set(exclude_pids)
        rows = []
        for record in snapshot["records"]:
            if record["pid"] in exclude_pids:
                continue
            if not (record["agent_id"] in agent_ids
                    or record["session"] in sessions
                    or record["team"] in teams):
                continue
            seat = record["seat"]
            rows.append((
                record["pid"], record["ppid"], record["proc_start"],
                record["argv"], record["agent_id"], record["session"],
                record["team"], seat,
            ))
        return tuple(sorted(rows, key=lambda row: row[0]))

    @staticmethod
    def _process_fact_signature(record):
        """The kernel and argv facts that distinguish one process generation."""
        if not record:
            return None
        return (
            record["pid"], record.get("ppid"), record.get("proc_start") or "",
            tuple(record.get("argv") or ()), record.get("agent_id"),
            record.get("session"), record.get("team"), record.get("seat"),
        )

    def stop_plan(self, team=None, agent_id=None, seats=(), session=None,
                  table=None):
        """Return the exact processes selected by one stop request."""
        table = self._retained_table(self._process_table() if table is None else table)
        snapshot = self._runtime(table)
        selection = None
        roster = None
        objection = None
        targets = []

        def add(record, label, colour=""):
            transcript = record.get("transcript") or {}
            targets.append(immutable({
                "process": record,
                "label": label,
                "agent_id": record.get("agent_id") or label,
                "title": (title_value(transcript.get("title")) or "(no title)"),
                "colour": colour,
            }))

        if team:
            selection = immutable({"kind": "team", "value": team})
            roster = self._roster_snapshot(team)
            if roster.state != "valid":
                objection = (f"no valid team config at {roster.path}: "
                             f"{roster.problem}")
            else:
                listed = tuple(
                    member.get("agentId") for member in roster.data.get("members", ())
                    if member.get("agentId"))
                for listed_id in listed:
                    member = next(
                        (item for item in roster.data.get("members", ())
                         if item.get("agentId") == listed_id), {})
                    colour = agent_colour(
                        listed_id, member, self._spawn_payload(listed_id))
                    for record in self._agent_runtime(
                            listed_id, table, census=(roster,))["external"]:
                        add(record, listed_id, colour)
                if not targets:
                    objection = (
                        f"nothing running for {team}: its roster lists no members"
                        if not listed else
                        f"nothing running for {team}: none of its {len(listed)} listed "
                        f"member(s) is running ({some_of(listed)})")
        elif seats:
            # `seats` are the panes one run created. Every process in them
            # descends from a launch that run made, so this stops what the run
            # started and nothing else. An agent id would also select a copy
            # that was already running in some other pane, and the lead's id
            # selects the lead wherever it runs.
            selected_seats = tuple(dict.fromkeys(seat for seat in seats if seat))
            selection = immutable({"kind": "seats", "value": selected_seats})
            for seat in selected_seats:
                for record in snapshot["by_seat"].get(seat, ()):
                    if not record["is_claude"] or record["ours"]:
                        continue
                    colour = agent_colour(
                        record["agent_id"],
                        spawn=self._spawn_payload(record["agent_id"]))
                    add(record, record["agent_id"] or f"pane {seat.pane}", colour)
            if not targets:
                objection = "nothing this run started is still running"
        elif agent_id:
            selection = immutable({"kind": "agent", "value": agent_id})
            colour = agent_colour(
                agent_id, spawn=self._spawn_payload(agent_id))
            for record in self._agent_runtime(agent_id, table)["external"]:
                add(record, agent_id, colour)
            if not targets:
                objection = f"agent id {agent_id} has zero live processes"
        elif session:
            selection = immutable({"kind": "session", "value": session})
            for record in snapshot["transcripts"].get(
                    session, immutable({"others": ()}))["others"]:
                add(record, session[:8])
            if not targets:
                objection = (f"nothing running for {session}: no live process holds "
                              "that transcript")
        else:
            selection = immutable({"kind": "missing", "value": None})
            objection = "--stop needs an agent, a session or a team to stop"

        external = tuple(targets)
        self_holders = tuple(
            immutable({"process": record, "label": session[:8] if session else "self"})
            for record in (snapshot["transcripts"].get(session, {}).get("ours", ())
                           if session else ()))
        return types.MappingProxyType({
            "selection": selection,
            "targets": external,
            "external_holders": external,
            "self_holders": self_holders,
            "generation": tuple(
                self._process_fact_signature(target["process"])
                for target in external),
            "roster": roster,
            "objection": objection,
        })

    def revalidate_stop(self, target):
        """Compare one selected stop target with its current process generation."""
        selected = target["process"]
        table = self._process_table(refresh=True)
        current = self._runtime(table)["by_pid"].get(selected["pid"])
        selected_signature = self._process_fact_signature(selected)
        current_signature = self._process_fact_signature(current)
        recycled = current is not None and current_signature != selected_signature
        return immutable({
            "matches": current is None or not recycled,
            "changed": (() if current_signature == selected_signature else
                        (f"process {selected['pid']}",)),
            "selected": selected,
            "current": current,
            "still_live": current if current_signature == selected_signature else None,
            "gone": current is None,
            "recycled": recycled,
        })

    def _terminal_context(self):
        """Load the current process's tmux environment once as raw evidence."""
        if self._terminal is not None:
            return self._terminal
        tmux_value = os.environ.get("TMUX")
        pane = os.environ.get("TMUX_PANE")
        socket = Path(tmux_value.split(",")[0]).name if tmux_value else None
        seat = Seat(socket, pane) if socket and pane else None
        self._terminal = TerminalContext(
            seat=seat, socket_without_pane=socket if socket and not pane else None)
        return self._terminal

    def _crew_placement(self, team, table):
        """Return every external crew Seat and one selected launch destination."""
        if not team:
            return CrewPlacement((), types.MappingProxyType({}), False, None, None)
        records = sorted(
            (record for record in self._runtime(table)["live_sessions"]
             if record.get("team") == team and record.get("agent_id")
             and not record["ours"] and record["seat"]),
            key=lambda record: (record["agent_id"], record["pid"]))
        seats = tuple(record["seat"] for record in records)
        grouped = collections.defaultdict(list)
        for record in records:
            grouped[record["seat"].socket].append(record["agent_id"])
        by_socket = types.MappingProxyType({
            socket: tuple(agent_ids) for socket, agent_ids in sorted(grouped.items())})
        selected = records[0] if records else None
        destination = (LaunchDestination(selected["seat"].socket)
                       if selected else None)
        provenance = (f"live pane {selected['seat'].pane} of pid {selected['pid']}"
                      if selected else None)
        return CrewPlacement(
            seats, by_socket, len(by_socket) > 1, destination, provenance)

    def _spawn_by_agent(self):
        """{"name@team": payload} for every teammate any lead ever spawned.

        A member's colour, agent type and full model live in the roster, and the
        roster dies with its team. The lead that spawned it recorded all three, so
        this is where they survive. Only the transcripts that mention a spawn are
        read, which is a fraction of the tree.
        """
        if self._by_agent is not None:
            return self._by_agent
        self._by_agent = {}
        leads = self._grep_files(SPAWN_MARKER, [self._projects_dir], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            for _, payload in self._log(path.stem):
                name, team = payload.get("name"), payload.get("team_name")
                if name and team:
                    self._by_agent[agent_id_of(name, team)] = payload
        return self._by_agent

    def _spawn_payload(self, agent_id, lead_session=None):
        """The harness's spawn record for an agent, wherever it survives.

        The single lookup for both the merge and the completion display, so an
        agent cannot be offered in one colour and launched in another. Cheap path
        first, the lead transcript the roster names; then the cross-file index,
        which is the only route once a team is named after a boot uuid that
        names no existing transcript.
        """
        if not agent_id:
            return {}
        # Keyed on name and team together: a lead that respawns a name into a later
        # team holds a payload for each, and the name alone returns whichever came
        # last, which is the wrong life's colour and model.
        name, team = name_and_team(agent_id)
        if lead_session and team:
            found = next((payload for payload in self._members_spawned_into(lead_session, team)
                          if payload.get("name") == name), None)
            if found:
                return found
        return self._spawn_by_agent().get(agent_id, {})

    def _spawn_records(self, lead_session):
        """{name: spawn payload} from the lead's transcript.

        Spawning a teammate writes the harness's whole payload into the lead's
        conversation: type, model with its [1m] suffix, color, pane id, prompt. That
        makes it the last-resort source for anything the roster would have held,
        and the only surviving one once a team dir is deleted, since no teammate
        transcript records its own color.
        """
        if not lead_session:
            return {}
        if lead_session in self._spawns:
            return self._spawns[lead_session]
        path = self._transcript_path(lead_session)
        self._ingest_spawn_lines([path] if path else [])
        return self._spawns.setdefault(lead_session, {})

    def _stamp_index(self):
        """{path: (agentName, teamName)} for every stamped transcript, built once.

        Reads a bounded window of each file rather than grepping: every line carries
        the stamps, so the tail answers it, and the tail is also the *current* pair
        after a rebind. A file stamped only mid-history is missed here, which is why
        this powers path-only lookups and never resolution (verify=True greps whole
        files). Grep is the wrong tool for the index: -m1 exits early on stamped
        files but scans every byte of the unstamped ones, and this tree holds 2GB of
        those, which cost 1.7s per pass.

        Complete records in the window are parsed and handed to the same
        `_identity_stamp` classifier as the full transcript scan. Display-label,
        sidechain, and nested content fields therefore cannot become index stamps.
        """
        self._exercise(NEED.STAMPS)
        if self._stamps is not None:
            return self._stamps
        index = {}
        carried = self._carried_receipts()
        for path in self._projects_dir.glob("*/*.jsonl"):
            copied = frozenset((carried.get(path) or {}).get("prefix_uuids") or ())
            if copied:
                fields, _last = self._scan_transcript(path)
                name = fields.get("agentName", (None,))[0]
                team = fields.get("teamName", (None,))[0]
                if name or team:
                    index[path] = (name, team)
                continue
            try:
                size = path.stat().st_size
                with path.open("rb") as handle:
                    tail = _complete_tail_window(handle, size, INDEX_CHUNK)
                    stamps = _stamps_in(tail)
                    if not stamps and size > INDEX_CHUNK:  # stamped only after a resume
                        stamps = _stamps_in(
                            _complete_head_window(handle, size, INDEX_CHUNK))
            except OSError:
                continue
            if stamps:
                index[path] = (stamps.get("agentName"), stamps.get("teamName"))
        self._stamps = index
        return self._stamps

    def _carried_receipts(self):
        """{path: last in-file receipt} for promoted main transcripts.

        This is the corpus-wide conversion census. A literal search narrows the
        main transcript tree first; only matching files are parsed backward to
        validate the record and select the last receipt. Search failure keeps the
        old full scan as the correctness fallback, while zero matches means zero.
        """
        self._exercise(NEED.CONVERSION_CENSUS)
        if self._carried is None:
            scope = tuple(self._projects_dir.glob("*/*.jsonl"))
            self._carried_scope = frozenset(scope)
            marker = f'"type":"{RECEIPT_RECORD}"'
            candidates = self._grep_files(marker, [self._projects_dir], True)
            if candidates is None:
                candidates = scope
            found = {}
            for path in candidates:
                receipt = self._receipt_carried_by(path)
                if receipt:
                    found[path] = receipt
            self._carried = types.MappingProxyType(found)
        return self._carried

    def _receipt_carried_by(self, path):
        """The canonical parsed conversion receipt for one transcript, or None."""
        path = Path(path)
        if path not in self._receipts:
            covered = (self._carried is not None
                       and path in (self._carried_scope or ()))
            parsed = (self._carried.get(path) if covered
                      else self._rewriter.receipt_in_file(path))
            self._receipts[path] = immutable(parsed) if parsed else None
        return self._receipts[path]

    def _copied_prefix_uuids(self, path):
        """UUIDs copied from a parent into this promoted transcript."""
        self._exercise(NEED.CONVERSION_CENSUS)
        path = Path(path)
        if path not in self._copied_prefixes:
            self._carried_receipts()
            receipt = self._receipt_carried_by(path)
            prefix = receipt.get("prefix_uuids") if receipt else None
            self._copied_prefixes[path] = frozenset(prefix or ())
        return self._copied_prefixes[path]

    def _authored_here(self, path, record):
        """Whether this record is an action authored by this transcript."""
        uuid = record.get("uuid")
        return not uuid or uuid not in self._copied_prefix_uuids(path)

    def _team_for_parent_session(self, session):
        """(team, evidence) for the team a side transcript's current parent led.

        The directory containing a side transcript says who owns it now. That
        parent can differ from the fork-context-ref's history source after a
        demote, so promotion asks this session rather than the reference record.
        A live parent answers from the identity it operates as. Otherwise the
        newest spawn payload says which team it led when it last created a
        teammate; restored window-start stamps are the remaining exact record.
        """
        snapshot = self._runtime()
        live = snapshot["best_by_session"].get(session)
        if live and live["alive"]:
            operating = self._operating_team(live["pid"], snapshot)
            if operating["team"] and operating["exact"]:
                return operating["team"], f"live parent pid {live['pid']}"
        led = self._teams_led_by(session)
        if led:
            return led[0], "the parent's newest teammate spawn"
        path = self._transcript_path(session)
        if path:
            restored = self._restore_fact(path)
            if restored["state"] == "restored":
                return restored["team"], "the parent's restored identity"
        return None, "no live identity, teammate spawn, or restored identity names its team"

    @staticmethod
    def _move_remedies(team, lead_team, moves):
        """The moves a report offers a team with a lead that runs as `lead_team`.

        Only those team_moves found the planner would make, each with the flags
        the planner needs. When the live move is not made because live
        processes keep the team from being retired, stopping them is offered.
        """
        remedies = []
        archived = f", and archives the mail waiting on {team} into the receipt"
        automatic, live = moves["automatic"], moves["live"]
        if automatic["flags"] is not None:
            remedies.append((
                " ".join((f"{TOOL} {team} --all",) + automatic["flags"]),
                f"starts its stopped members on {lead_team}, where their lead reads"
                + (", after asking" if automatic["decision"]["confirmation"] == "pending"
                   else "")
                + (archived if "--with-mail" in automatic["flags"] else "")))
        if live["flags"] is not None:
            remedies.append((
                " ".join((f"{TOOL} {team} --into-team live --all",) + live["flags"]),
                f"restarts its members onto {lead_team}, asking before it ends each "
                "running one" + (archived if "--with-mail" in live["flags"] else "")))
        else:
            blockers = (live["last"]["rebind"] or {}).get("blockers") or ()
            pids = [row["pid"] for row in blockers if row["pid"] is not None]
            if pids and len(pids) == len(blockers):
                remedies.append((
                    f"stop pid {', '.join(map(str, pids))}",
                    f"{'it runs' if len(pids) == 1 else 'they run'} as {team}, which "
                    f"the move retires; after that {TOOL} {team} --into-team live --all "
                    "moves its members"))
        return tuple(remedies)

    @staticmethod
    def _move_refusal(team, offer):
        """Why a move a report could offer is not made, from its last decision."""
        decision = offer["last"]
        rebind = decision["rebind"]
        if decision["refusal"] or decision["objections"]:
            return ("moving them is refused: "
                    + (decision["refusal"] or decision["objections"][0]))
        if rebind and rebind["action"] == "blocked":
            return (f"moving them needs {team} retired, which waits on "
                    + "; ".join(row["said"] for row in rebind["blockers"][:3]))
        return f"moving them is not made: {decision['reason']}"

    def _team_delivery_facts(self, team, lead, addressed_roster, census=None,
                             table=None, moves=None):
        """Interpret lead and polling evidence once for every member of a team.

        When the lead runs as another team, the remedies are the planner's: the
        moves team_moves finds it would make, each with the flags it needs, and
        --keep-team, which starts the member where it is. `moves` is that
        answer when the caller already has it.
        """
        pid, alive, exact_lead = lead["pid"], lead["alive"], lead["exact"]
        lead_team, exact_team = lead["runs_as"], lead["runs_as_exact"]
        if lead_team:
            runtime_snapshot = self._roster_snapshot(lead_team, census)
            runtime_state = runtime_snapshot.state
            runtime_problem = runtime_snapshot.problem
            runtime_roster = runtime_snapshot.data
        else:
            runtime_state = "valid"
            runtime_problem = None
            runtime_roster = addressed_roster
        runtime_members = [member for member in runtime_roster.get("members", [])
                           if member.get("name") != "team-lead"]
        worn = lead["worn_team"]
        if not (pid and alive):
            polls = (False, "the lead is stopped")
        elif runtime_state == "invalid":
            polls = (False, f"the roster is invalid: {runtime_problem}")
        elif runtime_state == "absent":
            polls = (False, "the roster is absent")
        elif not runtime_members:
            polls = (False, "the roster lists no members")
        elif worn:
            polls = (True, "its argv names the team, so it read this roster when it booted")
        else:
            polls = (None, "a plain lead reads its own memory of the roster, which a roster "
                           "written from outside does not reach")

        common_reachable, common_remedies = None, ()
        if not (pid and alive):
            common_reachable = (False, f"lead process for {team} is stopped")
            common_remedies = (("resume the lead", "starts a process"),)
        elif lead_team and lead_team != team:
            follow = self._lead_destination(team, lead, table, census)
            refused, offered = follow["refusal"], ()
            if not refused:
                moves = moves or self._team_moves(team, lead, table, census)
                offered = self._move_remedies(team, lead_team, moves)
                if not any(what.startswith(TOOL) for what, _cost in offered):
                    refused = self._move_refusal(team, moves["live"])
            common_reachable = (
                False, f"its lead is live but runs as {lead_team}, so mail sent "
                f"to {team} remains unpolled" + (f", and {refused}" if refused else ""))
            common_remedies = offered + (("--keep-team",
                                          f"starts it on {team}, where its lead does not "
                                          "read its mail"),)
        elif lead_team is None:
            common_reachable = (
                False, "its lead is live and structural team resolution returned "
                "unknown, so mailbox polling cannot be located")
            common_remedies = (
                ("have the lead start any teammate",
                 "a spawn records the team it runs as and starts it reading mail; "
                 "immediate, costs nothing"),
                ("resume the lead under its own identity",
                 "restarts it, and it then states its team in argv, at the cost of "
                 "its current turn"),
            )
        return types.MappingProxyType({
            "lead": lead,
            "lead_grade": "exact" if exact_lead else "inferred",
            "lead_team": (lead_team, "exact" if exact_team else
                          f"inferred: {lead['runs_as_basis']}"),
            "polls": polls,
            "common_reachable": common_reachable,
            "common_remedies": common_remedies,
            "addressed_members": tuple(addressed_roster.get("members", [])),
            "addressed_lead_id": addressed_roster.get("leadAgentId"),
        })

    def _member_delivery_facts(self, agent_id, delivery):
        """Member-specific reachability from one shared team delivery answer."""
        name, team = name_and_team(agent_id)
        lead_team = delivery["lead_team"][0]
        polls = delivery["polls"]
        listed = (any(member.get("agentId") == agent_id
                      or member.get("name") == name
                      for member in delivery["addressed_members"])
                  or (name == "team-lead"
                      and delivery["addressed_lead_id"] == agent_id))

        if delivery["common_reachable"] is not None:
            reachable, why = delivery["common_reachable"]
            remedies = delivery["common_remedies"]
        elif not listed:
            reachable, why = False, (f"{lead_team} roster member search returned empty, so the "
                                     "lead has no runtime registration for it")
            remedies = (("resume this member once", "a launch; it registers itself"),)
            if polls[0] is False:
                why += "; that roster lists no members at all, so nothing is polled yet"
                remedies += (("have the lead start any teammate",
                              "it starts reading mail immediately; costs nothing"),
                             (f"resume the lead as {agent_id_of('team-lead', lead_team)}",
                              "restarts it with team flags; it reads the roster on "
                              "the way up and loses its current turn"))
        elif polls[0] is None:
            reachable, why = None, (f"listed in {lead_team}, but whether its lead is still "
                                    f"reading cannot be told from outside its process")
            remedies = (("have the lead start any teammate",
                         "it starts reading mail immediately; costs nothing"),
                        (f"resume the lead as {agent_id_of('team-lead', lead_team)}",
                         "restarts it with team flags; it reads this roster on "
                         "the way up and loses its current turn"))
        else:
            reachable, why = True, f"listed in {lead_team}, and {lead_team}'s live lead polls it"
            remedies = ()
        return types.MappingProxyType({
            "lead": delivery["lead"],
            "lead_grade": delivery["lead_grade"],
            "lead_team": delivery["lead_team"],
            "polls": polls,
            "listed": listed,
            "reachable": (reachable, why),
            "remedies": remedies,
        })

    @staticmethod
    def _shared_doctor_facts(members):
        """Facts and remedies common to every canonical member."""
        members = tuple(members)
        if not members:
            return types.MappingProxyType({"remedies": ()})
        shared = {}
        for key in ("lead", "lead_grade", "lead_team", "polls", "reachable"):
            first = members[0][key]
            if all(member[key] == first for member in members[1:]):
                shared[key] = first
        shared["remedies"] = tuple(
            remedy for remedy in members[0]["remedies"]
            if all(remedy in member["remedies"] for member in members[1:])
        )
        return types.MappingProxyType(shared)

    @staticmethod
    def _team_conclusion(team, members, inbox, shared, follow=None, moves=None):
        """One structured doctor verdict from canonical member records.

        `follow` is lead_destination's answer when the live lead runs as
        another team, and `moves` team_moves' when that answer has no
        objection, so the remedies offered are the moves the planner makes.
        """
        lead_id = agent_id_of("team-lead", team)
        lead_member = next(member for member in members
                           if member["agent_id"] == lead_id)
        lead = lead_member["runtime"]
        groups = collections.defaultdict(list)
        live = {}
        for member in members:
            groups[member["membership"][0]].append(member["name"])
            processes = member["runtime"].get("records") or ()
            if processes:
                live[member["name"]] = processes
        groups = types.MappingProxyType({
            membership: tuple(sorted(names))
            for membership, names in groups.items()
        })
        listed = groups.get("listed", ())
        unrecorded = groups.get("unrecorded", ())
        former = groups.get("former", ())
        converted = groups.get("converted", ())
        waiting = types.MappingProxyType({
            name: value for name, value in inbox.items() if value[0]
        })
        torn = types.MappingProxyType({
            name: value[1] for name, value in inbox.items() if value[0] is None
        })
        doubled = tuple(sorted(
            member["name"] for member in members
            if len(member["runtime"]["records"]) > 1
        ))
        socket_members = collections.defaultdict(set)
        socket_seats = collections.defaultdict(list)
        for member in members:
            if member["name"] == "team-lead":
                continue
            for seat in member["runtime"]["seats"]:
                socket_members[seat.socket].add(member["name"])
                socket_seats[seat.socket].append(seat)
        sockets = tuple(types.MappingProxyType({
            "socket": socket,
            "members": tuple(sorted(socket_members[socket])),
            "seats": tuple(sorted(set(socket_seats[socket]))),
        }) for socket in sorted(socket_members))
        seats = tuple(seat for record in sockets for seat in record["seats"])
        unseated = tuple(sorted(
            member["name"] for member in members
            if member["name"] != "team-lead"
            and any(record["seat"] is None
                    for record in member["runtime"]["records"])
        ))
        reads = bool(
            lead["pid"] and lead["alive"] and lead["runs_as"] == team)
        remedies = []
        dormant = False
        if (waiting or live) and not reads:
            verdict = "SEVERED"
            lead_team = lead["runs_as"]
            if follow is None:
                remedies.append((
                    f"{TOOL} {team}", "rebuilds the roster and places its members"))
            elif not follow["objections"]:
                remedies.extend(Resolver._move_remedies(team, lead_team, moves))
            if follow is not None:
                remedies.append((
                    f"{TOOL} {team} --keep-team",
                    f"starts its members on {team}, where their lead does not "
                    "read their mail"))
        elif not reads:
            verdict = "DEGRADED"
            dormant = True
            if listed:
                remedies.append((
                    f"{TOOL} {team}", "starts the members its roster lists"))
            else:
                remedies.append((
                    f"{TOOL} {team}",
                    "rebuilds a roster from the transcripts and starts what it "
                    "recovers, or refuses saying what it could not find"))
        elif not lead["worn_team"]:
            verdict = "UNKNOWABLE"
            remedies.append((
                "start any teammate from inside the lead",
                "it starts reading mail immediately; costs nothing"))
            remedies.append((
                f"{TOOL} {lead_id}",
                "restarts the lead with team flags; it reads this roster on the "
                "way up and loses its current turn"))
        elif doubled or len(sockets) > 1:
            verdict = "DEGRADED"
            if len(sockets) > 1:
                remedies.append((f"{TOOL} {team}", "reseats the crew together"))
            for name in doubled:
                remedies.append((
                    f"{TOOL} --stop {agent_id_of(name, team)}",
                    f"ends all {len(live[name])} processes wearing that id"))
                remedies.append((
                    f"{TOOL} {agent_id_of(name, team)}",
                    "starts one of them again"))
        else:
            verdict = "CONNECTED"
        for remedy in shared.get("remedies", ()):
            if remedy not in remedies:
                remedies.append(remedy)
        return types.MappingProxyType({
            "lead_member": lead_member,
            "groups": groups,
            "listed": listed,
            "unrecorded": unrecorded,
            "former": former,
            "converted": converted,
            "live": types.MappingProxyType(live),
            "waiting": waiting,
            "torn": torn,
            "doubled": doubled,
            "seats": seats,
            "sockets": sockets,
            "split": len(sockets) > 1,
            "unseated": unseated,
            "reads": reads,
            "dormant": dormant,
            "verdict": verdict,
            "remedies": tuple(remedies),
        })

    def _agent_diagnosis(self, agent_id, parent_session=None, table=None,
                        census=None, member_runtime=None, lead_runtime=None):
        """Return composed lead, member, team, and mailbox status.

        This question is used by live redirect and reachability warnings. Doctor
        builds its richer member records separately so this answer does not acquire
        transcript, parent, color, ledger, or report-order responsibilities.
        """
        name, team = name_and_team(agent_id)
        member_runtime = member_runtime or self._agent_runtime(
            agent_id, table,
            parent_session=parent_session if name == "team-lead" else None,
            census=census)
        lead = (member_runtime if name == "team-lead" else
                lead_runtime or self._agent_runtime(
                    agent_id_of("team-lead", team), table,
                    parent_session=parent_session, census=census))
        delivery = self._team_delivery_facts(
            team, lead, self._roster_snapshot(team, census).data,
            census=census, table=table)
        return types.MappingProxyType({
            "agent_id": agent_id,
            "name": name,
            "team": team,
            "runtime": member_runtime,
            **self._member_delivery_facts(agent_id, delivery),
        })

    @staticmethod
    def _doctor_member_ids(team, runtime, requested=None):
        """Requested member, genuine lead, then stable runtime population order."""
        requested_name, requested_team = name_and_team(requested)
        priority = ([requested_name]
                    if requested_name and requested_team == team else [])
        priority.append("team-lead")
        names, seen = [], set()
        for name in priority + list(runtime["member_order"]):
            if name and name not in seen:
                names.append(name)
                seen.add(name)
        return tuple(agent_id_of(name, team) for name in names)

    def _team_diagnosis(self, team, requested=None, deep=False, table=None,
                       census=None, mailbox_generation=None):
        """One immutable member record per agent for a doctor team report."""
        table = self._process_table() if table is None else table
        table = self._retained_table(table)
        census = self._roster_census() if census is None else self._retained_census(census)
        mailbox_generation = (self._mailbox_generation(team)
                              if mailbox_generation is None else mailbox_generation)
        description = self._team_description(team, table=table, census=census)
        runtime = self._team_runtime(
            team, table, census=census,
            member_answer=description["member_answer"])
        roster = runtime["roster"]
        order = self._doctor_member_ids(team, runtime, requested)
        lead = runtime["lead"]
        follow = (self._lead_destination(team, lead, table, census)
                  if lead["pid"] and lead["alive"] and lead["runs_as"]
                  and lead["runs_as"] != team else None)
        moves = (self._team_moves(team, lead, table, census, runtime)
                 if follow and not follow["objections"] else None)
        delivery = (self._team_delivery_facts(
            team, lead, roster, census=census, table=table, moves=moves)
                    if deep else None)
        ledger = (self._mail_ledger(
            team, table=table, census=census, description=description,
            mailbox_generation=mailbox_generation)
                  if deep else ())
        inbox = immutable(self._inbox_state(
            team, generation=mailbox_generation))
        members = []
        for agent_id in order:
            name, _team = name_and_team(agent_id)
            canonical = runtime["member_records"].get(name)
            member_runtime = (canonical["runtime"] if canonical is not None else
                              runtime["runtimes"].get(name)
                              or self._agent_runtime(agent_id, table))
            membership = (canonical["membership"] if canonical is not None else
                          ("not listed", "no current roster or transcript assignment"))
            is_lead = name == "team-lead"
            resolution = (canonical["resolution"] if canonical is not None else
                          description["lead_resolution"] if is_lead else
                          self._resolve_transcript(
                              team=team,
                              name=name,
                              quick=True,
                              runtime=member_runtime,
                              table=table,
                              census=census,
                          ))
            transcript = resolution.transcript
            parent = None
            fragile = None
            addressed = ()
            member_delivery = {}
            if deep:
                parent_stem, parent_note = self._spawn_parent_of(agent_id)
                parent = types.MappingProxyType({
                    "stem": parent_stem,
                    "note": parent_note,
                    "fact": self._transcript_fact(parent_stem) if parent_stem else None,
                })
                held = transcript["session"] if transcript else None
                fragile = self._rebind_fragility(held, team, census)
                addressed = tuple(row for row in ledger if row["to"] == name)
                member_delivery = self._member_delivery_facts(agent_id, delivery)
            colour = (canonical["colour"] if canonical is not None else
                      agent_colour(agent_id, None, self._spawn_payload(agent_id)))
            members.append(types.MappingProxyType({
                **member_delivery,
                "agent_id": agent_id,
                "name": name,
                "team": team,
                "requested": agent_id == requested,
                "membership": membership,
                "member": canonical["member"] if canonical is not None else None,
                "canonical": canonical,
                "runtime": member_runtime,
                "resolution": resolution,
                "parent": parent,
                "colour": colour,
                "fragile": fragile,
                "ledger": addressed,
            }))
        members = tuple(members)
        shared = (self._shared_doctor_facts(members) if deep
                  else types.MappingProxyType({"remedies": ()}))
        conclusion = self._team_conclusion(team, members, inbox, shared, follow, moves)
        return types.MappingProxyType({
            "team": team,
            "deep": deep,
            "description": description,
            "roster_generation": description["roster"].generation,
            "mailbox_generation": mailbox_generation,
            "members": members,
            "by_agent": types.MappingProxyType({
                member["agent_id"]: member for member in members}),
            "shared": shared,
            "conclusion": conclusion,
            "ledger": ledger,
        })

    def doctor_answer(self, request):
        """Return one complete immutable diagnosis for one typed request."""
        if not isinstance(request, DoctorRequest):
            raise TypeError("doctor_answer requires DoctorRequest")
        table = self._process_table()
        table = self._retained_table(table)
        snapshot = self._runtime(table)
        census = self._roster_census()
        target = request.team
        requested = None
        objections = []
        if request.agent_id or request.session_uuid:
            try:
                launch = self._identity(
                    session_uuid=request.session_uuid,
                    agent_id=request.agent_id,
                    table=table, census=census, terminal=TerminalContext())
            except Refusal as exc:
                launch = None
                objections.append(exc.said)
            if launch:
                identity = launch["identity"]
                target = identity["teamName"]
                requested = identity["agentId"]
                if not target:
                    objections.append(
                        "the selected conversation has no effective team to diagnose")
                if not requested:
                    objections.append(
                        "the selected conversation has no effective agent identity to diagnose")

        direct = bool(target)
        if direct:
            known = immutable({target: "requested directly"})
            candidates = (target,)
        else:
            known = self._known_teams(census)
            candidates = tuple(sorted(known))
        mailbox_generations = immutable({
            team: self._mailbox_generation(team) for team in candidates})
        if direct or request.include_dormant:
            teams = candidates
        else:
            interesting = self._teams_with_live_evidence(
                table=table, census=census,
                mailbox_generations=mailbox_generations)
            teams = tuple(team for team in candidates if team in interesting)
        if objections:
            teams = ()

        diagnoses = tuple(self._team_diagnosis(
            team, requested=requested if direct else None, deep=direct,
            table=table, census=census,
            mailbox_generation=mailbox_generations[team])
            for team in teams)
        blocks = []
        seen = set()
        for state in diagnoses:
            verdict, lines, remedies = diagnose_team(state)
            seen.add(verdict)
            normalized_remedies = tuple(immutable({
                "command": what,
                "cost": cost,
                "normalized_command": re.sub(
                    rf"(?<![\w-]){re.escape(state['team'])}(?![\w-])",
                    "<team>", what),
            }) for what, cost in remedies)
            blocks.append(immutable({
                "team": state["team"],
                "diagnosis": state,
                "verdict": verdict,
                "lines": tuple(lines),
                "remedies": normalized_remedies,
            }))
        by_command = collections.defaultdict(set)
        for block in blocks:
            for remedy in block["remedies"]:
                pair = (remedy["normalized_command"], remedy["cost"])
                by_command[pair].add(block["team"])
        shared_remedies = tuple(sorted(
            pair for pair, wanting in by_command.items() if len(wanting) > 1))
        rank = {name: at for at, (name, _meaning) in enumerate(DOCTOR_LEGEND)}
        exit_verdict = (max(seen, key=lambda item: rank[item]) if seen else None)
        nameless = tuple(immutable({
            "session": path.stem,
            "path": path,
            "receipt": receipt,
            "transcript": self._transcript_fact(path=path),
        }) for path, receipt in sorted(self._carried_receipts().items())
            if not (receipt.get("name") and receipt.get("team")))
        examined = len(teams)
        total = len(candidates)
        return immutable({
            "request": request,
            "target": target,
            "requested_agent": requested,
            "teams": teams,
            "diagnoses": diagnoses,
            "by_team": {state["team"]: state for state in diagnoses},
            "blocks": tuple(blocks),
            "known": known,
            "process": {
                "table": table,
                "snapshot": snapshot,
                "generation": self._runtime_generation(snapshot, teams=teams),
            },
            "census": census,
            "roster_generations": {
                state["team"]: state["roster_generation"] for state in diagnoses},
            "mailbox_generations": mailbox_generations,
            "examined": examined,
            "total": total,
            "skipped": total - examined,
            "nameless_promotions": nameless,
            "dossiers": {"show": direct, "requested": requested},
            "verdicts": tuple(name for name, _meaning in DOCTOR_LEGEND
                              if name in seen),
            "shared_remedies": shared_remedies,
            "mail_ledger_note": (not direct and any(
                str(line).startswith("mail ")
                for block in blocks for line in block["lines"])),
            "objections": tuple(objections),
            "refusal": objections[0] if objections else None,
            "exit_verdict": exit_verdict,
            "exit_code": 1 if "SEVERED" in seen or objections else 0,
        })

    def _spawn_parent_of(self, agent_id):
        """(stem, evidence) of the transcript with a spawn payload that names
        this agent. The agent dossier's parentage line asks this separately;
        the answer walks the spawn corpus, so the doctor declares that work
        when it is pointed at an agent."""
        parent = next((stem for stem, entries in self._every_log().items()
                       for _stamp, payload in entries
                       if payload.get("agent_id") == agent_id), None)
        return (parent, "spawn payload naming it" if parent
                else "no spawn payload names this agent")

    def _teams_led_by(self, session_stem):
        """Teams this transcript led, newest first.

        A lead resumed several times creates a fresh implicit team each life
        and keeps appending to one transcript, so several teams can be named by
        one file. The newest is the one it was running as when it stopped.
        """
        led = self._led_teams()
        mine = [(stamp, team) for team, hits in led.items()
                for stamp, path in hits if path.stem == session_stem]
        mine.sort(reverse=True)
        return [team for _, team in mine]

    def _transcript_paths(self, session_uuid):
        """Every file carrying one session UUID, in stable path order."""
        return tuple(sorted(self._projects_dir.glob(f"*/{session_uuid}.jsonl")))

    def _transcript_path(self, session_uuid):
        """The sole file carrying one session UUID, or None when not unique."""
        hits = self._transcript_paths(session_uuid)
        return hits[0] if len(hits) == 1 else None

    def _transcript_fact(self, session_uuid=None, path=None):
        """Immutable path, title, and activity time for one transcript."""
        path = Path(path) if path else self._transcript_path(session_uuid)
        if not path:
            return None
        if path in self._transcript_facts:
            return self._transcript_facts[path]
        title = None
        if self._needs[NEED.TITLES] is not DECLARED.ABSENT:
            self._exercise(NEED.TITLES)
            title = _session_title(path)
        try:
            mtime = int(path.stat().st_mtime * 1000)
        except OSError:
            mtime = None
        fact = types.MappingProxyType({"session": path.stem, "path": path,
                                       "title": title, "mtime": mtime})
        self._transcript_facts[path] = fact
        return fact

    def _side_transcripts(self, parent=None):
        """Every side transcript on this machine, classified by its own bytes.

        A side transcript lives at <project>/<parent-session>/subagents/
        agent-<taskId>.jsonl, with an optional .meta.json beside it. The meta
        contributes a display name and an agent type and classifies nothing:
        this corpus holds a meta that says fork beside a file with the bytes of
        a regular chain, and the file wins.

        Grammars, decided by the first record alone:
          fork-reference  line 1 is a fork-context-ref naming the parent, the leaf it
                          forked from, and a context length; history is by reference.
          regular         the first record is a null-parent sidechain record with a
                          uuid; the chain carries its own history.
        Anything else is reported as what it is, never guessed at.
        """
        self._exercise(NEED.SIDES)
        out = self._side_listing(parent)
        for entry in out:
            entry["grammar"], entry["detail"], entry["root"] = \
                self._side_grammar(entry["path"])
        return out

    def _side_listing(self, parent=None):
        """The corpus by its cheap facts alone (path, parent, meta, mtime):
        side_transcripts without the classification, for the selector that
        narrows to a hit before anything reads bytes."""
        pattern = f"*/{parent or '*'}/subagents/agent-*.jsonl"
        out = []
        for path in sorted(self._projects_dir.glob(pattern)):
            try:
                mtime = int(path.stat().st_mtime * 1000)
            except OSError:
                continue
            entry = {"path": path, "parent": path.parent.parent.name,
                     "task_id": path.stem[len("agent-"):],
                     "name": None, "agent_type": None, "mtime": mtime}
            try:
                meta = json.loads(path.with_name(path.stem + ".meta.json").read_text())
                entry["name"] = meta.get("name")
                entry["agent_type"] = meta.get("agentType")
            except (OSError, ValueError):
                pass
            out.append(entry)
        return out

    def _side_grammar(self, path):
        """(grammar, detail, root) for one side transcript, from its first records.

        fork-reference -> the ref record itself; regular -> the root uuid; either way
        `root` is the chain root's uuid (for a fork-reference transcript, the null-parent
        record after the ref: 138 of 138 here carry one). unclassifiable ->
        a sentence naming what the first record actually is, root None.
        """
        self._exercise(NEED.SIDES)
        try:
            with path.open(errors="replace") as handle:
                first = handle.readline().strip()
                second = handle.readline().strip()
        except OSError as err:
            return SIDE_CLASS_UNCLASSIFIABLE, f"unreadable ({err.__class__.__name__})", None
        if not first:
            return SIDE_CLASS_UNCLASSIFIABLE, "the file is empty", None
        try:
            rec = json.loads(first)
        except ValueError:
            return SIDE_CLASS_UNCLASSIFIABLE, "the first line is not JSON", None
        if rec.get("type") == "fork-context-ref":
            try:
                nxt = json.loads(second) if second else {}
            except ValueError:
                nxt = {}
            root = nxt.get("uuid") if nxt.get("parentUuid") is None else None
            return SIDE_GRAMMAR_FORK_REFERENCE, rec, root
        if rec.get("parentUuid") is None and rec.get("isSidechain") is True and rec.get("uuid"):
            return SIDE_GRAMMAR_REGULAR, rec["uuid"], rec["uuid"]
        parent = "null" if rec.get("parentUuid") is None else "set"
        return SIDE_CLASS_UNCLASSIFIABLE, (f"the first record is type={rec.get('type', '?')}, "
                                  f"parentUuid={parent}, isSidechain={rec.get('isSidechain')}"), None

    def _side_transcript(self, selector):
        """One side transcript for a typed selector, or (None, why not).

        Accepted spellings are task ID, `<parent-session-prefix>/<name>`, regular
        sidechain root UUID, or a meta name carried by one side transcript. Multiple
        matches return a candidate list.

        Classification is paid only where a spelling requires it: task ids
        and parent/name pairs match on the cheap facts and classify the hit
        alone; roots live in the bytes, so only that fallback (and the bare
        name behind it, to keep the spelling order exact) reads the corpus.
        """
        sides = self._side_listing()

        def classified(entry):
            entry = dict(entry)
            entry["grammar"], entry["detail"], entry["root"] = \
                self._side_grammar(entry["path"])
            return entry

        if "/" in selector:
            parent_part, _, name_part = selector.partition("/")
            hits = [e for e in sides if e["parent"].startswith(parent_part)
                    and name_part in (e["name"], e["task_id"])]
        else:
            hits = [e for e in sides if e["task_id"] == selector]
            if not hits:
                sides = [classified(e) for e in sides]
                hits = [e for e in sides if e["root"] == selector]
                hits = hits or [e for e in sides if e["name"] == selector]
        if not hits:
            # The file is agent-<task id>.jsonl, so a listing shows the one
            # spelling this does not take, and a person reads it off the
            # listing and types it. When dropping the prefix (and the suffix,
            # for a name copied whole) lands on a real task id, say that id
            # rather than a flat no-match against a name that plainly exists.
            bare = selector.removesuffix(".jsonl").removeprefix("agent-")
            if bare != selector and any(e["task_id"] == bare for e in sides):
                return None, (f"{selector!r} is the file's name; this takes the "
                              f"task id inside it, so type {bare}")
            return None, f"no side transcript matches {selector!r}"
        if len(hits) > 1:
            # A refusal names what it refused between, in spellings that can
            # actually be typed apart: when the pretty form collides, the
            # colliding candidates are named by task id instead.
            pretty = [f"{e['parent'][:8]}/{e['name'] or e['task_id']}" for e in hits]
            tallies = collections.Counter(pretty)
            named = [p if tallies[p] == 1 else f"{e['parent'][:8]}/{e['task_id']}"
                     for p, e in zip(pretty, hits)]
            shown = ", ".join(named[:6])
            more = f" and {len(hits) - 6} more" if len(hits) > 6 else ""
            return None, f"{len(hits)} side transcripts match {selector!r}: {shown}{more}"
        hit = hits[0]
        return (hit if "grammar" in hit else classified(hit)), ""

    def completion_answer(self, topic):
        """Return one immutable completion answer with fully rendered rows."""
        dynamic, separator, subject = topic.partition(":")
        subject = subject if separator else None
        semantic = self._completion_answer(dynamic, subject)
        return types.MappingProxyType({
            **semantic,
            "rows": tuple(render_completion_answer(semantic)),
        })

    def _completion_answer(self, dynamic, subject=None):
        """Assemble completion semantics; the module renderer only formats rows."""
        entries = []
        if dynamic == "flags":
            for action in build_parser()._actions:
                longs = [option for option in action.option_strings
                         if option.startswith("--")]
                if not longs or action.help is argparse.SUPPRESS:
                    continue
                value = "" if action.nargs == 0 else (
                    action.metavar or action.dest).lower().replace("_", " ")
                entries.append(immutable({
                    "option": longs[0],
                    "description": getattr(action, "menu_row", None)
                                   or action.help or "",
                    "completer": "" if action.nargs == 0 else
                                 getattr(action, "completer", None) or "",
                    "value": value,
                }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})

        if subject is not None and dynamic in ("as-agent-name", "as-agent"):
            entry, _reason = self._side_transcript(subject)
            if not entry:
                return immutable({"topic": dynamic, "entries": ()})
            name = entry["name"] or entry["task_id"]
            if dynamic == "as-agent-name":
                entries.append(immutable({"name": name}))
            else:
                current, evidence = self._team_for_parent_session(entry["parent"])
                teams = ([current] if current else []) + [
                    team for team in sorted(self._known_teams()) if team != current]
                for team in teams:
                    entries.append(immutable({
                        "agent_id": agent_id_of(name, team),
                        "description": (f"current parent's team ({evidence})"
                                        if team == current else "another known team"),
                    }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})

        if subject is not None and dynamic == "into-session":
            path, _name, team = self._demote_subject(subject)
            if not path:
                return immutable({"topic": dynamic, "entries": ()})
            preferred, labels = [], {}
            receipt = self._receipt_carried_by(path)
            team = team or (receipt.get("team") if receipt else None)
            parent = (receipt.get("parent") if receipt
                      and receipt["direction"] == "promote" else None)
            if parent:
                preferred.append(parent)
                labels[parent] = "parent from latest promotion receipt"
            if team:
                census = self._roster_census()
                description = self._team_description(
                    team, table=self._process_table(), census=census)
                lead = (description["lead_fact"] or {}).get("path")
                if lead and lead != path and lead.stem not in preferred:
                    preferred.append(lead.stem)
                    labels[lead.stem] = f"lead of current team {team}"
                for name, resolution in self._team_member_resolutions(team).items():
                    member = resolution.path
                    if member == path or member.stem in preferred:
                        continue
                    preferred.append(member.stem)
                    labels[member.stem] = f"{name} in current team {team}"
            all_paths = self._transcripts_by_mtime()
            by_stem = {candidate.stem: candidate for candidate in all_paths}
            emitted = set()
            for stem in preferred:
                candidate = by_stem.get(stem)
                entries.append(immutable({
                    "stem": stem,
                    "fact": self._transcript_fact(path=candidate) if candidate else None,
                    "note": labels.get(stem),
                }))
                emitted.add(stem)
            for candidate in all_paths:
                if candidate.stem != path.stem and candidate.stem not in emitted:
                    entries.append(immutable({
                        "stem": candidate.stem,
                        "fact": self._transcript_fact(path=candidate),
                        "note": None,
                    }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})

        if dynamic == "selector":
            groups = tuple(
                immutable({"group": group,
                           "answer": self._completion_answer(group)})
                for group in ("names", "teams", "leads"))
            return immutable({"topic": dynamic, "entries": groups})
        if dynamic == "sockets":
            for path in self._swarm_sockets():
                try:
                    mtime = int(path.stat().st_mtime * 1000)
                except OSError:
                    continue
                entries.append(immutable({
                    "socket": path.name,
                    "state": "live" if self._socket_alive(path) else "dead",
                    "mtime": mtime,
                }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})
        if dynamic == "sessions":
            for path in self._transcripts_by_mtime():
                entries.append(immutable({
                    "stem": path.stem,
                    "fact": self._transcript_fact(path=path),
                }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})
        if dynamic == "sides":
            for entry in sorted(
                    self._side_transcripts(), key=lambda item: item["mtime"],
                    reverse=True):
                entries.append(immutable({
                    "parent": entry["parent"],
                    "name": entry["name"] or entry["task_id"],
                    "grammar": entry["grammar"],
                    "mtime": entry["mtime"],
                }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})

        census = self._roster_census()
        table = (self._process_table()
                 if dynamic in {"teams", "leads", "names"} else None)
        if dynamic == "names":
            assignments = self._durable_assignment_index()
            teams = set(self._known_teams(census)) | set(assignments["by_team"])
            described = [self._team_description(
                team, table=table, census=census) for team in teams]
            described.sort(
                key=lambda item: (item["activity"] or 0, item["team"]),
                reverse=True)
            for description in described:
                team = description["team"]
                runtime = self._team_runtime(
                    team, table,
                    census=census, member_answer=description["member_answer"])
                group = immutable({
                    "team": team,
                    "activity": description["activity"],
                    "roster_missing": description["roster"].state == "absent",
                    "standing": description["standing"],
                })
                for name in runtime["member_order"]:
                    if name == "team-lead":
                        continue
                    member = runtime["member_records"][name]
                    entries.append(types.MappingProxyType({
                        "group": group,
                        "member": member["member"],
                        "member_record": member,
                        "agent_id": member["agent_id"],
                        "title": title_value(member["title"]),
                        "when": member["activity"],
                        "listed": member["roster_member"] is not None,
                        "colour": member["colour"],
                    }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})

        roster_entries = sorted(
            self._scan_teams(census), key=lambda entry: entry["ts"], reverse=True)
        if dynamic == "agent-ids":
            for entry in roster_entries:
                agent_id = entry["member"].get("agentId")
                if agent_id:
                    entries.append(immutable({
                        "agent_id": agent_id,
                        "joined": entry["ts"],
                        "colour": agent_colour(
                            agent_id, entry["member"], self._spawn_payload(agent_id)),
                    }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})
        if dynamic == "teams":
            seen, order = set(), []
            for entry in roster_entries:
                if entry["team"] not in seen:
                    seen.add(entry["team"])
                    order.append(entry["team"])
            order.extend(team for team in sorted(self._known_teams(census))
                         if team not in seen)
            for team in order:
                entries.append(immutable({
                    "team": team,
                    "description": self._team_description(
                        team, table=table, census=census),
                }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})
        if dynamic == "leads":
            seen = set()
            for entry in roster_entries:
                team = entry["team"]
                agent_id = entry.get("leadAgentId") or agent_id_of("team-lead", team)
                if agent_id in seen:
                    continue
                seen.add(agent_id)
                entries.append(immutable({
                    "agent_id": agent_id,
                    "joined": entry["ts"],
                    "description": self._team_description(
                        team, table=table, census=census),
                    "rostered": True,
                    "evidence": None,
                }))
            for team, evidence in sorted(self._known_teams(census).items()):
                agent_id = agent_id_of("team-lead", team)
                if agent_id in seen:
                    continue
                description = self._team_description(
                    team, table=table, census=census)
                if description["lead_fact"]:
                    entries.append(immutable({
                        "agent_id": agent_id,
                        "joined": None,
                        "description": description,
                        "rostered": False,
                        "evidence": evidence,
                    }))
            return immutable({"topic": dynamic, "entries": tuple(entries)})
        return immutable({
            "topic": dynamic, "entries": (),
            "objection": f"unknown completion topic {dynamic!r}",
        })

    def mail_answer(self, selector=None, to=None):
        """Return one complete immutable authored-mail answer."""
        if not selector:
            return immutable({
                "team": None, "entries": (), "groups": (), "tallies": (),
                "objection": "--mail-ledger needs a team, as session-<id> or a prefix of it",
            })
        team = selector if selector.startswith("session-") else f"session-{selector[:8]}"
        entries = self._mail_ledger(team, to=to)
        if not entries:
            return immutable({
                "team": team, "entries": (), "groups": (), "tallies": (),
                "objection": (f"no authored mail found for {team} (no stamped "
                              "transcripts, or nobody used SendMessage)"),
            })
        grouped = collections.OrderedDict()
        for entry in entries:
            if entry["state"] in ("delivered", "protocol"):
                continue
            key = (entry["to"] or "?", entry["state"], entry["detail"])
            grouped[key] = grouped.get(key, 0) + 1
        groups = tuple(immutable({
            "to": key[0], "state": key[1], "detail": key[2], "count": count,
        }) for key, count in grouped.items())
        tallies = tuple(collections.Counter(
            entry["state"] for entry in entries).most_common())
        return immutable({
            "team": team,
            "entries": entries,
            "groups": groups,
            "tallies": tallies,
            "objection": None,
        })

    def sides_answer(self, selector=None):
        """Return side transcripts grouped under canonical parent facts."""
        sides = list(self._side_transcripts())
        named = bool(selector)
        if selector:
            wanted = (selector[len("session-"):] if selector.startswith("session-")
                      else selector)
            sides = [entry for entry in sides
                     if entry["parent"].startswith(wanted)]
            if not sides:
                return immutable({
                    "selector": selector, "parents": (), "counts": (), "total": 0,
                    "folded_parents": 0, "folded_count": 0,
                    "objection": (f"no side transcripts under a session starting "
                                  f"{selector!r}"),
                })
        sides.sort(key=lambda entry: entry["mtime"], reverse=True)
        counts = tuple(collections.Counter(
            entry["grammar"] for entry in sides).most_common())
        by_parent = collections.OrderedDict()
        for entry in sides:
            by_parent.setdefault(entry["parent"], []).append(entry)
        shown = list(by_parent) if named else list(by_parent)[:15]
        cap = None if named else 3
        parents = []
        for parent in shown:
            parent_entries = by_parent[parent]
            visible = parent_entries if cap is None else parent_entries[:cap]
            parents.append(immutable({
                "parent": parent,
                "title": title_value(
                    (self._transcript_fact(parent) or {}).get("title")),
                "entries": tuple(visible),
                "counts": tuple(collections.Counter(
                    entry["grammar"] for entry in parent_entries).most_common()),
                "hidden": len(parent_entries) - len(visible),
            }))
        folded_parents = len(by_parent) - len(shown)
        folded_count = sum(len(by_parent[parent])
                           for parent in list(by_parent)[len(shown):])
        return immutable({
            "selector": selector,
            "named": named,
            "parents": tuple(parents),
            "counts": counts,
            "total": len(sides),
            "parent_count": len(by_parent),
            "folded_parents": folded_parents,
            "folded_count": folded_count,
            "objection": None,
        })

    def census_answer(self):
        """Return one immutable machine-wide evidence census."""
        rosters = self._rosters()
        members = tuple(member for roster in rosters
                        for member in roster.data.get("members", ()))
        member_pairs = sum(
            1 for member in members
            if member.get("agentId") and member.get("name"))
        member_agrees = sum(
            1 for member in members
            if member.get("agentId") and member.get("name")
            and name_and_team(member["agentId"])[0] == member["name"])
        lead_agrees = sum(
            1 for roster in rosters
            if roster.data.get("leadAgentId") == agent_id_of("team-lead", roster.team))
        payload_pairs = tuple(
            (payload.get("agent_id"), payload.get("name"), payload.get("team_name"))
            for payload in self._spawn_payloads())
        payload_total = sum(1 for aid, name, team in payload_pairs
                            if aid and name and team)
        payload_agrees = sum(
            1 for aid, name, team in payload_pairs
            if aid and name and team and aid == agent_id_of(name, team))
        named_leads = sum(1 for roster in rosters
                          if roster.data.get("leadSessionId"))
        resolved_leads = sum(
            1 for roster in rosters
            if roster.data.get("leadSessionId")
            and self._transcript_path(roster.data["leadSessionId"]))
        known = self._known_teams()
        evidence_counts = tuple(collections.Counter(known.values()).most_common())
        claimed = {team: {path for _stamp, path in hits}
                   for team, hits in self._led_teams().items()}
        contested = {team: paths for team, paths in claimed.items()
                     if len(paths) > 1}
        unresolved = tuple(
            team for team in contested if not self._lead_transcript_for(team)[0])
        stamps = self._stamp_index()
        both = sum(1 for name, team in stamps.values() if name and team)
        name_only = sum(1 for name, team in stamps.values() if name and not team)
        return immutable({
            "identity": immutable({
                "member_agrees": member_agrees,
                "member_total": member_pairs,
                "lead_agrees": lead_agrees,
                "roster_total": len(rosters),
                "payload_agrees": payload_agrees,
                "payload_total": payload_total,
            }),
            "leads": immutable({
                "named": named_leads,
                "resolved": resolved_leads,
                "roster_total": len(rosters),
            }),
            "teams": immutable({
                "known": len(known),
                "by_evidence": evidence_counts,
                "contested": len(contested),
                "max_claimants": max((len(paths) for paths in contested.values()),
                                     default=0),
                "unresolved": len(unresolved),
            }),
            "transcripts": immutable({
                "both": both,
                "name_only": name_only,
            }),
        })

    def cleanup_plan(self):
        """Return one complete immutable cleanup selection and its generations."""
        census = self._roster_census()
        entries = self._scan_teams(census)
        table = self._process_table()
        snapshot = self._runtime(table)
        actions = []
        agent_ids, sessions, teams = set(), set(), set()
        for team_dir in sorted(self._team_dirs()):
            team = team_dir.name
            cfg = self._roster_path(team)
            team_entries = tuple(entry for entry in entries if entry["cfg"] == cfg)
            reason = None
            if not team_entries:
                reason = "unreadable or memberless roster"
            elif self._made_moments_ago(team_dir):
                reason = "created moments ago"
            else:
                lead_session = team_entries[0]["leadSessionId"]
                lead_id = agent_id_of("team-lead", team)
                lead = self._agent_runtime(
                    lead_id, table, parent_session=lead_session, census=census)
                if lead["pid"] and lead["alive"]:
                    reason = f"pid {lead['pid']} is live for this team"
                else:
                    resolutions = self._team_member_resolutions(team, team_entries)
                    if resolutions:
                        reason = f"resumable transcripts: {', '.join(sorted(resolutions))}"
                    else:
                        reason = self._scaffolding_objection(
                            team_dir, census=census)
                agent_ids.add(lead_id)
                if lead_session:
                    sessions.add(lead_session)
            teams.add(team)
            lock = self._lock_for(cfg)
            owner, gone, seen = self._lock_holder(lock)
            mine, strays = self._scaffolding_and_strays(team_dir)
            actions.append(immutable({
                "team": team,
                "team_dir": team_dir,
                "tasks_dir": CLAUDE_DIR / "tasks" / team,
                "cfg": cfg,
                "action": "keep" if reason else "remove",
                "reason": reason,
                "generation": self._directory_generation(team_dir),
                "tasks_generation": self._directory_generation(
                    CLAUDE_DIR / "tasks" / team),
                "owned": tuple(path.relative_to(team_dir) for path in mine),
                "strays": tuple(strays),
                "lock": immutable({
                    "path": lock, "owner": owner, "gone": gone,
                    "seen": seen,
                    "generation": self._path_generation(lock),
                }),
            }))
        sockets = tuple(immutable({
            "path": path,
            "generation": self._path_generation(path),
        }) for path in self._dead_sockets())
        process_generation = self._runtime_generation(
            snapshot, agent_ids=agent_ids, sessions=sessions, teams=teams)
        return immutable({
            "dead_sockets": sockets,
            "team_actions": tuple(actions),
            "process_generation": process_generation,
            "process_agents": tuple(sorted(agent_ids)),
            "process_sessions": tuple(sorted(sessions)),
            "process_teams": tuple(sorted(teams)),
            "census": census,
        })

    def revalidate_cleanup(self, plan):
        """Compare a cleanup selection before removing any selected path."""
        changed = []
        for socket in plan["dead_sockets"]:
            if (self._path_generation(socket["path"]) != socket["generation"]
                    or self._socket_alive(socket["path"])):
                changed.append(f"socket {socket['path'].name}")
        for action in plan["team_actions"]:
            if self._directory_generation(action["team_dir"]) != action["generation"]:
                changed.append(f"team directory {action['team']}")
            if self._directory_generation(
                    action["tasks_dir"]) != action["tasks_generation"]:
                changed.append(f"task directory {action['team']}")
            lock = action["lock"]
            if self._path_generation(lock["path"]) != lock["generation"]:
                changed.append(f"roster lock {action['team']}")
        table = self._process_table(refresh=True)
        process_generation = self._runtime_generation(
            self._runtime(table), agent_ids=plan["process_agents"],
            sessions=plan["process_sessions"], teams=plan["process_teams"])
        if process_generation != plan["process_generation"]:
            changed.append("cleanup runtime")
        return immutable({
            "matches": not changed,
            "changed": tuple(changed),
        })

    def revalidate_cleanup_cut(self, action, staged):
        """Compare one renamed cleanup directory before deleting its contents."""
        current = self._directory_generation(staged)
        return immutable({
            "matches": current == action["generation"],
            "changed": () if current == action["generation"] else
                       (f"staged team directory {action['team']}",),
            "selected": action["generation"],
            "current": current,
        })

    @staticmethod
    def _selected_write(original, raw, mode):
        """Retain the exact byte update chosen from one file observation."""
        if not original.physical and original.generation != ("absent",):
            raise ValueError("cannot select a write from an unstable file observation")
        return immutable({
            "path": original.path, "original": original,
            "bytes": raw, "mode": mode,
            "action": "replace" if original.physical else "create",
        })

    def _roster_write(self, roster, data):
        """Own and serialize a roster once, choosing its existing mode or 0600."""
        owned = self.RosterSnapshot.preview(roster.path, data).data
        raw = (json.dumps(json_value(owned), indent=2) + "\n").encode("utf-8")
        mode = roster.mode if roster.mode is not None else 0o600
        return immutable({
            **self._selected_write(roster.observation, raw, mode), "data": owned,
        })

    def _membership_write(self, roster, data, backed_up):
        write = self._roster_write(roster, data)
        backup = None
        if roster.path not in backed_up:
            original = self._file_observation(roster.path.with_suffix(f".json.bak-{TOOL}"))
            backup = immutable({
                **self._selected_write(original, roster.raw, write["mode"]),
                # Each invocation replaces an older backup on its first write.
                "action": "replace",
            })
        return immutable({
            **write, "team": roster.team, "roster": roster, "backup": backup,
            "lock": self._lock_for(roster.path),
            "lock_owner": immutable({
                "tool": TOOL, "pid": os.getpid(),
                "procStart": self._proc_start(os.getpid()),
            }),
        })

    def _complete_rebuild(self, launch, applied):
        """Validate retained effect domains before comparison, without reads or serialization."""
        def rejected(*objections):
            # Preserve the caller's launch identity without copying rejected input.
            return types.MappingProxyType({"launch": launch, "written_roster": None,
                                           "objections": objections})

        if (not isinstance(applied, Applied) or type(applied.operation) is not str
                or applied.operation != "rebuild"):
            return rejected("completion requires rebuild Applied evidence")
        plan, effects = applied.plan, applied.effects
        if not isinstance(plan, Mapping) or not isinstance(effects, Mapping):
            return rejected("the rebuild has incomplete applied evidence")
        objections = []
        write = plan.get("write")
        original = plan.get("original")
        if (plan.get("launch") is not launch
                or type(original) is not self.RosterSnapshot
                or original is not launch["roster"]["destination"]):
            objections.append("the applied rebuild belongs to another launch or selection")
        action, durable_action = plan.get("action"), applied.durable_action
        rebuild_actions = ("create", "replace-invalid")
        if (applied.confirmation is not True or applied.dry_run is not False
                or type(action) is not str or type(durable_action) is not str
                or action not in rebuild_actions or durable_action not in rebuild_actions
                or durable_action != action):
            objections.append("the rebuild does not report confirmed applied effects")
        if not isinstance(write, Mapping):
            objections.append("the rebuild has no selected write")
        written = effects.get("written")
        observed = written.get("observation") if isinstance(written, Mapping) else None
        if (not isinstance(written, Mapping) or not isinstance(write, Mapping)
                or written.get("selection") is not write
                or plan.get("config") is not write.get("data")
                or not _written_matches(write.get("path"), write.get("bytes"),
                                        write.get("mode"), observed)):
            objections.append("the written roster does not match the selected rebuild")
        if effects.get("original") is not original:
            objections.append("the rebuild does not retain its selected original observation")
        if objections:
            return rejected(*objections)
        try:
            written_roster = self.RosterSnapshot(observed, write.get("data"))
            reported_roster = self.RosterSnapshot(observed, written.get("data"))
        except (TypeError, ValueError) as exc:
            return rejected(f"the written roster has invalid config data: {exc}")
        if reported_roster.data != written_roster.data:
            objections.append("the reported config does not match the selected rebuild")
        backup, rollback = effects.get("backup"), effects.get("rollback")
        if action == "replace-invalid":
            selected_backup = plan.get("backup_write")
            if (not isinstance(backup, Mapping) or not isinstance(selected_backup, Mapping)
                    or backup.get("selection") is not selected_backup
                    or not _written_matches(selected_backup.get("path"), selected_backup.get("bytes"),
                                            selected_backup.get("mode"), backup.get("observation"))):
                objections.append("the invalid-roster backup does not match its selection")
            retained_original = plan.get("retained_original")
            if (type(rollback) is not FileObservation or type(retained_original) is not FileObservation
                    or not retained_original.physical or rollback != retained_original):
                objections.append("the retained rollback file does not match the original")
        elif backup is not None or rollback is not None:
            objections.append("a created roster reports unexpected backup or rollback effects")
        selected_inboxes = plan.get("inboxes")
        reported = effects.get("inboxes")
        if (type(selected_inboxes) is not tuple
                or any(not isinstance(selected, Mapping) for selected in selected_inboxes)
                or type(reported) is not tuple or len(reported) != len(selected_inboxes)):
            objections.append("the applied rebuild has incomplete inbox evidence")
        else:
            inbox_actions = ("create", "replace-empty", "keep")
            for at, (selected, effect) in enumerate(zip(selected_inboxes, reported)):
                before, inbox_action = selected.get("observation"), selected.get("action")
                reported_action = effect.get("action") if isinstance(effect, Mapping) else None
                if (not isinstance(effect, Mapping)
                        or effect.get("selection") is not selected
                        or type(inbox_action) is not str or type(reported_action) is not str
                        or inbox_action not in inbox_actions or reported_action not in inbox_actions
                        or reported_action != inbox_action
                        or type(before) is not FileObservation
                        or type(effect.get("before")) is not FileObservation
                        or type(effect.get("after")) is not FileObservation
                        or effect.get("before") != before):
                    matches = False
                elif inbox_action == "keep":
                    matches = before.physical and before.raw != b"" and effect["after"] == before
                else:
                    matches = ((before.generation == ("absent",) if inbox_action == "create" else
                                before.physical and before.raw == b"")
                               and _written_matches(before.path, selected.get("bytes"),
                                                    selected.get("mode"), effect["after"]))
                if not matches:
                    name = selected.get("name")
                    label = name if type(name) is str else f"#{at + 1}"
                    objections.append(f"inbox {label} does not match its selected effect")
        if objections:
            return rejected(*objections)
        census = self._update_census(launch["roster"]["census"], observed.path, written_roster)
        completed_launch = immutable({
            **launch,
            "roster": immutable({**launch["roster"], "census": census,
                                 "destination": written_roster}),
        })
        return types.MappingProxyType({
            "launch": completed_launch, "written_roster": written_roster,
            "original_generation": original.generation,
            "replacement_generation": observed.generation, "objections": (),
        })

    def rebuild_plan(self, launch=None, applied=None, now_ms=None,
                     team=None, table=None, census=None):
        """Return one complete missing-roster reconstruction answer.

        The rebuilt roster records a lead session only when
        `lead_corroboration` ties that transcript to the team by something
        besides its spawn payloads. Every path that rebuilds a roster asks
        here, so the same transcript is recorded or left out whichever command
        made the roster.
        """
        if launch is None:
            census = self._roster_census() if census is None else self._retained_census(census)
            table = self._retained_table(self._process_table() if table is None else table)
            selected = self._roster_snapshot(team, census)
            description = self._team_description(team, table=table, census=census)
            resolution = description["lead_resolution"]
            path = (description["lead_fact"] or {}).get("path")
            if not path:
                return immutable({
                    "launch": None, "team": team, "action": "blocked",
                    "config": None, "generation": selected.generation,
                    "inboxes": (), "lead_resolution": resolution,
                    "objections": (
                        f"no roster for {team} and none can be rebuilt: "
                        f"{resolution.reason}",),
                })
            launch = self.launch_plan(
                session_uuid=path.stem, for_team=team,
                table=table, census=census)
            planned = self.rebuild_plan(launch, now_ms=now_ms)
            return types.MappingProxyType({
                **planned,
                "lead_resolution": resolution,
                "lead_claim": resolution.evidence,
                "lead_path": path,
                "selected_roster": selected,
            })
        if applied is not None:
            return self._complete_rebuild(launch, applied)
        record = launch["roster"]["record"]
        team, name = record["team"], record["name"]
        destination = launch["roster"]["destination"]
        if (not team or not (name or launch.get("leads_team"))
                or destination.state == "valid"):
            return immutable({
                "launch": launch, "team": team, "action": "none",
                "config": destination.data, "generation": destination.generation,
                "inboxes": (), "objections": (),
            })
        now_ms = int(time.time() * 1000) if now_ms is None else now_ms
        lead_sid = record["parentSession"]
        if name == "team-lead" or launch.get("leads_team"):
            members = [{
                "agentId": agent_id_of("team-lead", team),
                "name": "team-lead", "agentType": "team-lead",
                "joinedAt": now_ms, "tmuxPaneId": "leader",
                **({"cwd": record["cwd"]} if record.get("cwd") else {}),
                "subscriptions": [], "backendType": "in-process",
            }]
            for payload in self._members_spawned_into(launch["session"], team):
                member = {
                    "agentId": payload.get("agent_id")
                               or agent_id_of(payload["name"], team),
                    "name": payload["name"], "joinedAt": now_ms,
                    "tmuxPaneId": payload.get("tmux_pane_id") or "",
                    "subscriptions": [],
                    "agentType": payload.get("agent_type") or DEFAULT_AGENT_TYPE,
                    "planModeRequired": bool(payload.get("plan_mode_required")),
                    "backendType": "tmux", "isActive": False,
                }
                for key in ("color", "model"):
                    if payload.get(key):
                        member[key] = payload[key]
                members.append(member)
            lead_session = launch["session"]
            note = "lead + " + (
                ", ".join(member["name"] for member in members[1:])
                or "no members recovered")
        else:
            member = {
                "agentId": record["agentId"], "name": name,
                "joinedAt": now_ms, "tmuxPaneId": "", "subscriptions": [],
                "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
                "planModeRequired": bool(record.get("planModeRequired")),
                **({"cwd": record["cwd"]} if record.get("cwd") else {}),
                "backendType": "tmux", "isActive": False,
            }
            member.update({key: record[key] for key in SYNCED_FIELDS
                           if record.get(key)})
            members = [{
                "agentId": agent_id_of("team-lead", team),
                "name": "team-lead", "agentType": "team-lead",
                "joinedAt": now_ms, "tmuxPaneId": "leader",
                **({"cwd": record["cwd"]} if record.get("cwd") else {}),
                "subscriptions": [], "backendType": "in-process",
            }, member]
            lead_session = lead_sid
            note = f"lead + {name}"
        lead_path = self._transcript_path(lead_session) if lead_session else None
        if not (lead_path and self._lead_corroboration(
                team, lead_path, launch["process"]["table"],
                launch["roster"]["census"])):
            lead_session = ""
        config = immutable({
            "name": team, "createdAt": now_ms,
            "leadAgentId": agent_id_of("team-lead", team),
            "leadSessionId": lead_session,
            "members": members,
        })
        inboxes = tuple(
            self._inbox_seed_fact(team, member["name"])
            for member in members)
        action = ("create" if destination.state == "absent"
                  else "replace-invalid")
        backup_path = (None if action == "create" else
                       destination.path.with_name(
                           f"{destination.path.name}.invalid-{TOOL}.bak"))
        rollback_path = (None if action == "create" else
                         destination.path.with_name(
                             f".{destination.path.name}.{TOOL}-rebuild-"
                             f"{os.getpid()}.rollback"))
        objections = []
        write = self._roster_write(destination, config)
        config = write["data"]
        backup_original = self._file_observation(backup_path) if backup_path else None
        rollback_original = self._file_observation(rollback_path) if rollback_path else None
        backup_write = (self._selected_write(backup_original, destination.raw, write["mode"])
                        if backup_original is not None else None)
        retained_original = (FileObservation(rollback_path, destination.generation, destination.mode)
                             if rollback_path else None)
        if backup_original is not None and backup_original.generation != ("absent",):
            objections.append(f"the exact invalid-roster backup already exists at "
                              f"{backup_path}")
        if rollback_original is not None and rollback_original.generation != ("absent",):
            objections.append(f"a rebuild rollback file already exists at {rollback_path}")
        return immutable({
            "launch": launch,
            "team": team,
            "action": action,
            "cfg": destination.path,
            "generation": destination.generation,
            "original": destination,
            "write": write,
            "backup_path": backup_path,
            "backup_write": backup_write,
            "rollback_path": rollback_path,
            "retained_original": retained_original,
            "observations": tuple(item for item in (
                destination.observation, backup_original, rollback_original)
                if item is not None),
            "confirmation": ("helpful" if action == "replace-invalid" else "automatic"),
            "config": config,
            "members": tuple(members),
            "inboxes": inboxes,
            "note": note,
            "process_generation": self._runtime_generation(
                launch["process"]["snapshot"],
                agent_ids=tuple(member["agentId"] for member in members),
                sessions=(launch["session"],), teams=(team,)),
            "objections": tuple(objections),
        })

    def revalidate_rebuild(self, plan, observations=None, include_inboxes=True):
        """Compare the complete expected file observations for this rebuild phase."""
        if plan["action"] == "none":
            return immutable({"matches": True, "changed": ()})
        expected = plan["observations"] if observations is None else tuple(observations)
        changed = []
        if {item.path for item in expected} != {item.path for item in plan["observations"]}:
            changed.append("rebuild observation paths")
        current = tuple(self._file_observation(item.path) for item in expected)
        for selected, observed in zip(expected, current):
            if selected != observed:
                changed.append(f"file {selected.path}")
        if include_inboxes:
            for inbox in plan["inboxes"]:
                if self._file_observation(inbox["observation"].path) != inbox["observation"]:
                    changed.append(f"inbox {inbox['name']}")
        table = self._process_table(refresh=True)
        process_generation = self._runtime_generation(
            self._runtime(table),
            agent_ids=tuple(member["agentId"] for member in plan["members"]),
            sessions=(plan["launch"]["session"],), teams=(plan["team"],))
        if process_generation != plan["process_generation"]:
            changed.append(f"runtime {plan['team']}")
        return immutable({
            "matches": not changed, "changed": tuple(changed),
            "selected": expected, "current": current,
        })

    def membership_plan(self, launch, operation, pane=None, alive=True,
                        claim=None, undo=None, now_ms=None, backed_up=frozenset()):
        """Return one complete roster and inbox persistence answer."""
        record = launch["roster"]["record"]
        backed_up = frozenset(backed_up)
        if operation in ("release", "restore"):
            token = claim if operation == "release" else undo
            team = token["team"] if token else None
        else:
            team = record["team"]
        if not team or operation not in {"reserve", "record", "release", "restore"}:
            return immutable({
                "operation": operation, "record": record,
                "action": "none", "writes": (), "inboxes": (),
                "claim": claim, "rollback": undo, "objections": (),
            })
        if operation in ("reserve", "record") and launch["identity"]["role"] == "lead":
            return immutable({
                "operation": operation, "record": record,
                "action": "none", "writes": (), "inboxes": (),
                "claim": None, "rollback": None, "objections": (),
            })
        now_ms = int(time.time() * 1000) if now_ms is None else now_ms
        roster = self._roster_snapshot(team)
        data = (json_value(roster.data)
                if roster.state == "valid" else None)
        objections = []
        writes = []
        inboxes = []
        selected_claim = claim
        rollback = None
        if roster.state != "valid":
            return immutable({
                "operation": operation, "record": record,
                "action": "none", "writes": (), "inboxes": (),
                "claim": claim, "rollback": undo, "objections": (),
            })
        agent_id = record["agentId"] if operation in ("reserve", "record") \
            else (claim or undo)["agent_id"]
        members = data.setdefault("members", [])
        matches = [member for member in members
                   if member.get("agentId") == agent_id]
        marker = (claim or {}).get("marker")
        previous = copy.deepcopy(matches[0]) if matches else None
        if operation == "reserve":
            if not launch["route"].get("to_team") \
                    and launch["roster"].get("selected"):
                action = "none"
            elif matches:
                action = "none"
            else:
                marker = f"{os.getpid()}:{time.time_ns()}:{launch['session']}"
                member = {
                    "agentId": agent_id, "name": record["name"],
                    "joinedAt": now_ms, "subscriptions": [],
                    "planModeRequired": bool(record.get("planModeRequired")),
                    **({"cwd": record["cwd"]} if record.get("cwd") else {}),
                    **{key: record[key] for key in SYNCED_FIELDS if record.get(key)},
                    "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
                    "_agentResumeClaim": marker,
                }
                members.append(member)
                action = "write"
                selected_claim = immutable({
                    "team": team, "agent_id": agent_id, "marker": marker,
                    "record": record, "launch": launch,
                })
        elif operation == "record":
            if agent_id == data.get("leadAgentId"):
                objections.append(
                    f"refusing to register the lead {agent_id} as a pane-backed member")
                action = "blocked"
            else:
                member = matches[0] if matches else None
                if member is None:
                    member = {
                        "agentId": agent_id, "name": record["name"],
                        "joinedAt": now_ms, "subscriptions": [],
                        "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
                        "planModeRequired": bool(record.get("planModeRequired")),
                        **({"cwd": record["cwd"]} if record.get("cwd") else {}),
                    }
                    members.append(member)
                if marker and member.get("_agentResumeClaim") not in (None, marker):
                    objections.append(
                        f"the roster claim for {agent_id} belongs to another launch")
                    action = "blocked"
                else:
                    rollback_previous = (
                        None if marker and member.get("_agentResumeClaim") == marker
                        else previous)
                    member.pop("_agentResumeClaim", None)
                    member.update({key: record[key] for key in SYNCED_FIELDS
                                   if record.get(key)})
                    member.update({
                        "tmuxPaneId": pane or "", "backendType": "tmux",
                        "isActive": alive,
                    })
                    action = "write"
                    rollback = immutable({
                        "team": team, "agent_id": agent_id,
                        "previous": rollback_previous,
                        "written": immutable(copy.deepcopy(member)),
                        "record": record, "launch": launch,
                    })
                inboxes.append(
                    self._inbox_seed_fact(team, record["name"]))
        elif operation == "release":
            owned = [member for member in matches
                     if member.get("_agentResumeClaim") == marker]
            if not owned:
                action = "none"
            else:
                data["members"] = [member for member in members
                                   if member is not owned[0]]
                action = "write"
        else:
            written = undo["written"]
            if not matches or matches[0] != json_value(written):
                objections.append(
                    f"the roster entry for {agent_id} changed after this launch wrote it")
                action = "blocked"
            elif undo["previous"] is None:
                data["members"] = [member for member in members
                                   if member is not matches[0]]
                action = "write"
            else:
                at = members.index(matches[0])
                members[at] = json_value(undo["previous"])
                action = "write"
        if action == "write":
            writes.append(self._membership_write(roster, data, backed_up))
        if operation == "record" and action == "write" and launch["route"]["to_team"]:
            source_entry = launch["roster"].get("source") or launch["roster"].get("selected")
            source_id = ((source_entry or {}).get("member") or {}).get("agentId")
            _source_name, source_team = name_and_team(source_id)
            if source_team and source_team != team:
                source_roster = self._roster_snapshot(source_team)
                source_data = (json_value(source_roster.data)
                               if source_roster.state == "valid" else None)
                changed_source = False
                for source_member in (source_data.get("members", ())
                                      if source_data is not None else ()):
                    if (source_member.get("agentId") == source_id
                            and source_member.get("isActive")):
                        source_member["isActive"] = False
                        changed_source = True
                if changed_source:
                    writes.append(self._membership_write(source_roster, source_data, backed_up))
        return immutable({
            "operation": operation,
            "record": record,
            "action": action,
            "writes": tuple(writes),
            "inboxes": tuple(inboxes),
            "claim": selected_claim,
            "rollback": rollback,
            "objections": tuple(objections),
        })

    def revalidate_membership(self, plan, inspect_lock=False, only_team=None,
                              include_inboxes=True):
        """Compare selected roster, backup, and inbox observations before persistence."""
        changed = []
        locks = []
        for write in plan["writes"]:
            if only_team is not None and write["team"] != only_team:
                continue
            current = self._file_observation(write["path"])
            if current != write["original"]:
                changed.append(f"roster {write['team']}")
            backup = write["backup"]
            if backup and self._file_observation(backup["path"]) != backup["original"]:
                changed.append(f"backup {write['team']}")
            if inspect_lock:
                owner, gone, seen = self._lock_holder(write["lock"])
                locks.append(immutable({
                    "path": write["lock"], "owner": owner,
                    "gone": gone, "seen": seen,
                }))
        if include_inboxes:
            for inbox in plan["inboxes"]:
                if self._file_observation(inbox["observation"].path) != inbox["observation"]:
                    changed.append(f"inbox {inbox['name']}")
        return immutable({
            "matches": not changed,
            "changed": tuple(changed),
            "locks": tuple(locks),
        })

    def promotion_plan(self, selector, as_agent=None, unwrap=None, force=False,
                       now_ms=None):
        """Return one complete immutable side-to-member conversion answer."""
        entry, reason = self._side_transcript(selector)
        if not entry:
            return immutable({
                "selector": selector, "entry": None, "objections": (reason,),
                "conversion": None, "undo": None, "identity": None,
            })
        typed_name, typed_team = name_and_team(as_agent) if as_agent else (None, None)
        name = typed_name or entry["name"] or entry["task_id"]
        current_team, team_evidence = self._team_for_parent_session(entry["parent"])
        objections = []
        if typed_team:
            team = typed_team
            team_evidence = "--as-agent"
        elif current_team:
            team = current_team
        else:
            team = None
            half = (f"--as-agent {as_agent} gives a name and no team" if as_agent
                    else f"no --as-agent was passed; {name} is the name taken from "
                         "the side transcript")
            objections.append(
                f"{half}. The current parent session {entry['parent']} has no "
                f"deducible team ({team_evidence}); type --as-agent "
                f"{agent_id_of(name, '<team>')}")

        terminal = self._rewriter.terminal_receipt_in_file(entry["path"])
        if (terminal and not typed_name and terminal["direction"] == "demote"
                and terminal.get("team") == team and terminal.get("name")):
            name = terminal["name"]
        identity = immutable({
            "name": name, "team": team,
            "agentId": agent_id_of(name, team) if name and team else None,
            "name_defaulted": not bool(typed_name),
            "team_evidence": team_evidence,
        })
        grammar = (entry["grammar"], entry["detail"], entry["root"])
        conversion = (self._rewriter.conversion_plan(
            entry["path"], "promote", identity=(name, team), unwrap=unwrap,
            grammar=grammar, projects_dir=self._projects_dir)
                      if name and team else None)
        if conversion and (conversion["objections"] or not conversion["proved"]):
            objections.extend(conversion["objections"] or
                              ("the inverse could not be proved",))
        destination = conversion["dest_path"] if conversion else None
        destination_generation = (self._file_generation(destination)
                                  if destination else None)
        if destination_generation and destination_generation != ("absent",):
            objections.append(
                f"a transcript already exists at {destination}; refusing the collision")
        now_ms = int(time.time() * 1000) if now_ms is None else now_ms
        age_objection = None
        if entry["mtime"] >= now_ms - 60_000 and not force:
            age_objection = (
                "this side transcript was written within the last minute; its task "
                "may still be running. --force to convert it anyway")
            objections.append(age_objection)

        undo = None
        undo_identity = ((terminal.get("name"), terminal.get("team"))
                         if terminal else (None, None))
        if (terminal and terminal["direction"] == "demote"
                and all(undo_identity) and undo_identity[1] != current_team):
            undo_conversion = self._rewriter.conversion_plan(
                entry["path"], "promote", identity=undo_identity,
                unwrap=unwrap, grammar=grammar, projects_dir=self._projects_dir)
            if (undo_conversion.get("proved")
                    and not undo_conversion["receipt"].get("_emitted")):
                undo = immutable({
                    "identity": immutable({
                        "name": undo_identity[0], "team": undo_identity[1],
                        "agentId": agent_id_of(*undo_identity),
                        "name_defaulted": False,
                        "team_evidence": "accepted clean undo",
                    }),
                    "conversion": undo_conversion,
                    "destination_generation": self._file_generation(
                        undo_conversion["dest_path"]),
                })
        parent_path = self._transcript_path(entry["parent"])
        return types.MappingProxyType({
            "selector": selector,
            "entry": immutable(entry),
            "identity": identity,
            "identity_source": team_evidence,
            "terminal_receipt": immutable(terminal) if terminal else None,
            "undo": undo,
            "conversion": conversion,
            "source_generation": self._file_generation(entry["path"]),
            "side_meta_generation": self._file_generation(
                entry["path"].with_name(entry["path"].stem + ".meta.json")),
            "parent_path": parent_path,
            "parent_generation": (self._file_generation(parent_path)
                                  if parent_path else ("absent",)),
            "destination_generation": destination_generation,
            "process_generation": (),
            "mailbox_generation": None,
            "holders": (),
            "age_objection": age_objection,
            "objections": tuple(objections),
            "launch": immutable({
                "session": destination.stem if destination else None,
                "agent_id": identity["agentId"],
            }),
        })

    def demotion_plan(self, selector, into=None, force=False, archive_mail=False,
                      table=None, census=None):
        """Return one complete immutable member-to-side conversion answer."""
        path, name, team = self._demote_subject(selector)
        if not path:
            return immutable({
                "selector": selector, "path": None,
                "objections": (f"no transcript for {selector!r}; name the session uuid",),
                "conversion": None, "parent": None,
            })
        table = self._retained_table(self._process_table() if table is None else table)
        snapshot = self._runtime(table)
        holders = snapshot["transcripts"].get(
            path.stem, immutable({"others": (), "ours": ()}))
        census = self._roster_census() if census is None else self._retained_census(census)
        parent = self._demotion_parent(
            path, name, team, into=into, table=table, census=census)
        waiting = self._inbox_state(team).get(name) if team and name else None
        led = self._live_led(path.stem, table)
        objections = []
        if holders["ours"]:
            objections.append(
                f"you are demoting the transcript you are running (pid "
                f"{holders['ours'][0]['pid']}); nothing can embed a conversation "
                "from inside it")
        if holders["others"] and not force:
            objections.append(
                f"pid {holders['others'][0]['pid']} is running this conversation and "
                "appending to its file; a demote copies that file and then deletes it, "
                "so whatever the process writes after the copy is lost. --force overrides")
        if led and not force:
            objections.append(
                f"this transcript leads {', '.join(led)} with members running; "
                "demoting it beheads them. --force overrides")
        if waiting and not archive_mail:
            if waiting[0] is None:
                objections.append(
                    f"{name}'s inbox in {team} is {waiting[1]}; it may hold mail "
                    "this demote would lose. Repair it, or pass --with-mail to "
                    "preserve its bytes in a mail archive")
            elif waiting[0]:
                objections.append(
                    f"{waiting[0]} message(s) wait in {team}'s inbox for {name}, "
                    f"oldest {waiting[1]}; read them first or pass --with-mail "
                    "to preserve them in a mail archive")
        if parent["objection"]:
            objections.append(parent["objection"] +
                              (f". {parent['remedy']}" if parent["remedy"] else ""))

        parent_uuids = None
        terminal = self._rewriter.terminal_receipt_in_file(path)
        if terminal and terminal.get("ref"):
            try:
                ref = json.loads(terminal["ref"])
            except ValueError:
                ref = {}
            from_session = ref.get("parentSessionId")
            parent_path = path.parent / f"{from_session}.jsonl" if from_session else None
            parent_snapshot = (self._transcript_snapshot(parent_path)
                               if parent_path else None)
            parent_uuids = parent_snapshot["uuids"] if parent_snapshot else frozenset()
        conversion = None
        if parent["parent"]:
            conversion = self._rewriter.conversion_plan(
                path, "demote", into=parent["parent"],
                parent_uuids=parent_uuids, projects_dir=self._projects_dir)
            if conversion["objections"] or not conversion["proved"]:
                objections.extend(conversion["objections"] or
                                  ("the inverse could not be proved",))
        destination = conversion["dest_path"] if conversion else None
        destination_generation = (self._file_generation(destination)
                                  if destination else None)
        if destination_generation and destination_generation != ("absent",):
            objections.append(
                f"a side transcript already exists at {destination}; "
                "refusing the collision")
        destination_meta = (destination.with_name(destination.stem + ".meta.json")
                            if destination else None)
        destination_meta_generation = (self._file_generation(destination_meta)
                                       if destination_meta else None)
        if (destination_meta_generation
                and destination_meta_generation != ("absent",)):
            objections.append(
                f"side metadata already exists at {destination_meta}; "
                "refusing the collision")
        holder_processes = tuple(holders["others"] + holders["ours"])
        archive = (self._archive_inbox_plan(team, name)
                   if archive_mail and team and name else None)
        return types.MappingProxyType({
            "selector": selector,
            "path": path,
            "identity": immutable({
                "name": name, "team": team,
                "agentId": agent_id_of(name, team) if name and team else None,
            }),
            "holders": immutable(holders),
            "holder_processes": holder_processes,
            "led_teams": led,
            "mail": waiting,
            "archive": archive,
            "parent": parent,
            "conversion": conversion,
            "source_generation": self._file_generation(path),
            "side_meta_generation": None,
            "parent_generation": (self._file_generation(parent["fact"]["path"])
                                  if parent.get("fact") else None),
            "destination_generation": destination_generation,
            "destination_meta": destination_meta,
            "destination_meta_generation": destination_meta_generation,
            "process_generation": self._runtime_generation(
                snapshot, sessions=(path.stem,),
                teams=tuple(item for item in (team,) if item)),
            "mailbox_generation": (self._mailbox_generation(team)
                                   if team and name and not archive_mail else None),
            "archive_mail": archive_mail,
            "force": force,
            "objections": tuple(objections),
            "confirmation_required": parent["confirmation_required"],
        })

    def revalidate_conversion(self, plan, destination_created=None,
                              destination_meta_created=None):
        """Compare one conversion's saved inputs without selecting a new answer."""
        changed = []
        source = self._file_generation(plan["path"] if plan.get("path")
                                      else plan["entry"]["path"])
        if source != plan["source_generation"]:
            changed.append("source transcript")
        parent_path = (plan.get("parent_path") or
                       ((plan.get("parent") or {}).get("fact") or {}).get("path"))
        parent_generation = plan.get("parent_generation")
        current_parent = (self._file_generation(parent_path)
                          if parent_path else ("absent",))
        if parent_generation is not None and current_parent != parent_generation:
            changed.append("conversion parent transcript")
        meta_generation = plan.get("side_meta_generation")
        if meta_generation is not None:
            entry_path = plan["entry"]["path"]
            current_meta = self._file_generation(
                entry_path.with_name(entry_path.stem + ".meta.json"))
            if current_meta != meta_generation:
                changed.append("side transcript metadata")
        destination = plan["conversion"]["dest_path"] if plan.get("conversion") else None
        current_destination = self._file_generation(destination) if destination else None
        expected_destination = (destination_created if destination_created is not None
                                else plan["destination_generation"])
        if current_destination != expected_destination:
            changed.append("conversion destination")
        destination_meta = plan.get("destination_meta")
        current_destination_meta = (self._file_generation(destination_meta)
                                    if destination_meta else None)
        expected_destination_meta = (
            destination_meta_created if destination_meta_created is not None
            else plan.get("destination_meta_generation"))
        if (destination_meta is not None
                and current_destination_meta != expected_destination_meta):
            changed.append("conversion destination metadata")
        if plan.get("process_generation"):
            table = self._process_table(refresh=True)
            snapshot = self._runtime(table)
            identity = plan.get("identity") or {}
            current_processes = self._runtime_generation(
                snapshot,
                sessions=((plan.get("path") or plan["entry"]["path"]).stem,),
                teams=tuple(item for item in (identity.get("team"),) if item))
            if current_processes != plan["process_generation"]:
                changed.append("conversion runtime")
        mailbox_generation = plan.get("mailbox_generation")
        identity = plan.get("identity") or {}
        if mailbox_generation is not None:
            current_mailboxes = self._mailbox_generation(identity.get("team"))
            if current_mailboxes != mailbox_generation:
                changed.append("conversion mailboxes")
        return immutable({
            "matches": not changed,
            "changed": tuple(changed),
            "selected": immutable({
                "source": plan["source_generation"],
                "parent": parent_generation,
                "destination": expected_destination,
                "destination_meta": expected_destination_meta,
            }),
            "current": immutable({
                "source": source,
                "parent": current_parent,
                "destination": current_destination,
                "destination_meta": current_destination_meta,
            }),
        })


class TranscriptRewriter:
    """Transform closed transcript inputs and prove each inverse in memory."""

    @staticmethod
    def _last_record_at(raws, record_type, field):
        """(payload, one-based line) for the last matching JSONL record."""
        for index in range(len(raws) - 1, -1, -1):
            try:
                rec = json.loads(raws[index])
            except (ValueError, UnicodeDecodeError):
                continue
            if not isinstance(rec, dict) or rec.get("type") != record_type:
                continue
            payload = rec.get(field)
            if isinstance(payload, dict):
                return payload, index + 1
        return None, None

    @classmethod
    def _consume_last_record(cls, raws, record_type, field):
        """Last payload, raw line, position, and lines without that record."""
        payload, line = cls._last_record_at(raws, record_type, field)
        if line is None:
            return None, None, None, list(raws)
        remaining = list(raws)
        raw = remaining.pop(line - 1)
        return payload, raw, line - 1, remaining

    def restamp_plan(self, path, team, name=None, start=None):
        """Return one deeply immutable proved restamp plan."""
        return immutable(self._restamp_plan(path, team, name, start=start))

    def _restamp_plan(self, path, team, name=None, start=None):
        """Plan a window-start identity restamp and verify its memory round trip.

        The edit set is limited to teamName and optional agentName on the located
        window-start record. Applying the reverse must reproduce the original line
        bytes before the plan becomes writable.
        """
        if not start:
            return {"objections": ["this conversation carries no stamped identity "
                                   "record to rewrite"], "proved": False}
        old_name, old_team, uuid = start
        if old_team == team and (name is None or name == old_name):
            return {"objections": [f"its identity record already says {team}; "
                                   "nothing to rewrite"], "proved": False}
        try:
            text = path.read_bytes().decode("utf-8", "strict")
        except (OSError, UnicodeDecodeError) as err:
            return {"objections": [f"unreadable: {err}"], "proved": False}
        raws, newline, newline_objection = _split_jsonl_text(text)
        if newline_objection:
            return {"objections": [newline_objection], "proved": False}
        # The latest restamp remains active after later Claude Code records. Its
        # `old` value keeps the origin, so repeated restamps record one net change
        # and a return to origin removes the receipt.
        prior, _prior_raw, prior_position, raws = self._consume_last_record(
            raws, RESTAMP_RECORD, "restamp")
        origin = (prior or {}).get("old") or None
        for i, raw in enumerate(raws):
            if f'"{uuid}"' not in raw:
                continue
            loaded, why = self._codec_load(raw)
            if loaded is None:
                return {"objections": [f"its identity record {why}"],
                        "proved": False}
            rec, style = loaded
            # Byte round-trip accepts any JSON value. Restamping requires an object
            # record with a UUID, so other JSON types produce an objection before
            # record selection or editing.
            if not isinstance(rec, dict):
                return {"objections": [f"line {i + 1} carries {uuid} but is a "
                                       f"{type(rec).__name__}, not a record"],
                        "proved": False}
            if rec.get("uuid") != uuid:
                continue
            new = dict(rec)
            new["teamName"] = team
            if name:
                new["agentName"] = name
            allowed = {"teamName"} | ({"agentName"} if name else set())
            changed = {k for k in set(rec) | set(new)
                       if rec.get(k, _MISSING) != new.get(k, _MISSING)}
            if changed - allowed:
                return {"objections": [f"the edit set would need "
                                       f"{sorted(changed - allowed)[0]}"],
                        "proved": False}
            back = dict(new)
            back["teamName"] = old_team
            if name:
                back["agentName"] = old_name
            if self._codec_dump(back, style) != raw:
                return {"objections": ["the inverse does not restore the line"],
                        "proved": False}
            out = list(raws)
            out[i] = self._codec_dump(new, style)
            was = origin or {"teamName": old_team, "agentName": old_name}
            now = {"teamName": team, "agentName": name or old_name}
            receipt = {"kind": "restamp", "stem": path.stem, "uuid": uuid,
                       "old": was, "new": now, "at": int(time.time() * 1000)}
            # When the new identity equals the origin, omit the receipt and restore
            # the original transcript bytes.
            if now != was:
                rendered = json.dumps({"type": RESTAMP_RECORD, "restamp": receipt},
                                      separators=(",", ":"), ensure_ascii=False,
                                      sort_keys=True)
                if prior_position is None:
                    out.append(rendered)
                else:
                    out.insert(prior_position, rendered)
            return {"path": path, "lines": out, "newline": newline,
                    "receipt": receipt, "objections": [], "proved": True}
        return {"objections": [f"identity record {uuid} not found as a line"],
                "proved": False}

    @classmethod
    def _last_record_in_file(cls, path, record_type, field):
        """The payload from the last matching record in a JSONL, read backward."""
        marker = record_type.encode()
        try:
            size = path.stat().st_size
            handle = path.open("rb")
        except OSError:
            return None
        carry, at = b"", size
        with handle:
            while at:
                take = min(INDEX_CHUNK, at)
                at -= take
                handle.seek(at)
                block = handle.read(take) + carry
                lines = block.split(b"\n")
                carry = lines.pop(0) if at else b""
                candidates = [raw for raw in lines if marker in raw]
                payload, _line = cls._last_record_at(candidates, record_type, field)
                if payload is not None:
                    return payload
            if carry and marker in carry:
                payload, _line = cls._last_record_at([carry], record_type, field)
                return payload
        return None

    @staticmethod
    def receipt_objection(receipt):
        """Return why a conversion receipt is not the current complete schema."""
        if not isinstance(receipt, dict):
            return "the conversion receipt is not an object"
        missing = sorted(RECEIPT_REQUIRED - set(receipt))
        if missing:
            return "the conversion receipt is missing " + ", ".join(missing)
        unknown = sorted(set(receipt) - set(RECEIPT_KEYS))
        if unknown:
            return "the conversion receipt has unknown fields " + ", ".join(unknown)
        null_optional = sorted(field for field in set(receipt) - RECEIPT_REQUIRED
                               if receipt[field] is None)
        if null_optional:
            return ("the conversion receipt must omit empty optional fields "
                    + ", ".join(null_optional))
        if type(receipt["schema_version"]) is not int:
            return "the conversion receipt has invalid schema_version value"
        if receipt["schema_version"] != 1:
            return (f"unsupported conversion receipt schema_version "
                    f"{receipt['schema_version']!r}; expected 1")
        for field in ("dest_stem", "parent", "task_id"):
            if not isinstance(receipt[field], str) or not receipt[field]:
                return f"the conversion receipt has invalid {field} value"
        if (receipt["root"] is not None
                and (not isinstance(receipt["root"], str) or not receipt["root"])):
            return "the conversion receipt has invalid root value"
        if receipt["direction"] == "promote" and not receipt["root"]:
            return "a promotion receipt has no root"
        if (not isinstance(receipt["direction"], str)
                or receipt["direction"] not in ("promote", "demote")):
            return f"the conversion receipt has invalid direction {receipt['direction']!r}"
        if (not isinstance(receipt["grammar"], str)
                or receipt["grammar"] not in SIDE_GRAMMARS):
            return (f"unsupported conversion grammar {receipt['grammar']!r}; expected "
                    f"{SIDE_GRAMMAR_OPTIONS}")
        fork_fields = (receipt.get("graft"), receipt.get("ref"),
                       receipt.get("prefix_uuids"))
        if receipt["grammar"] == SIDE_GRAMMAR_FORK_REFERENCE:
            if (not all(fork_fields[:2]) or not isinstance(fork_fields[2], list)
                    or not fork_fields[2]):
                return "a fork-reference receipt is missing its copied-prefix fields"
        elif any(value is not None for value in fork_fields):
            return "a regular receipt carries fork-reference fields"
        if not isinstance(receipt["unwrapped"], bool):
            return "the conversion receipt has invalid unwrapped value"
        edits = receipt["visible_human_wrapper_edits"]
        if not isinstance(edits, dict) or set(edits) != {"original_payloads", "intervals"}:
            return "the conversion receipt has invalid visible_human_wrapper_edits value"
        payloads, intervals = edits["original_payloads"], edits["intervals"]
        if (not isinstance(payloads, list)
                or not all(isinstance(item, list) and len(item) == 2
                           and isinstance(item[0], str)
                           and item[0] in HUMAN_MESSAGE_WRAPPERS
                           and isinstance(item[1], str) for item in payloads)):
            return "the conversion receipt has invalid original_payloads value"
        if (not isinstance(intervals, list)
                or not all(isinstance(item, list) and len(item) == 3
                           and isinstance(item[0], str) and item[0]
                           and isinstance(item[1], str) and item[1]
                           and isinstance(item[2], list)
                           and all(type(ref) is int and 0 <= ref < len(payloads)
                                   for ref in item[2]) for item in intervals)):
            return "the conversion receipt has invalid wrapper edit intervals value"
        refs = [ref for _first, _last, interval_refs in intervals
                for ref in interval_refs]
        if not receipt["unwrapped"] and (payloads or refs):
            return "a wrapped conversion receipt carries unneeded original payloads"
        if receipt["unwrapped"] and (
                any(not interval_refs for _first, _last, interval_refs in intervals)
                or len(refs) != len(set(refs))
                or set(refs) != set(range(len(payloads)))):
            return "an unwrapped conversion receipt has inconsistent payload references"
        if not _valid_newline(receipt["source_newline"]):
            return "the conversion receipt has invalid source_newline metadata"
        if bool(receipt.get("name")) != bool(receipt.get("team")):
            return "the conversion receipt must carry both name and team or neither"
        for field in ("name", "team"):
            if field in receipt and (not isinstance(receipt[field], str)
                                     or not receipt[field]):
                return f"the conversion receipt has invalid {field} value"
        for field in ("graft", "previous_record", "ref"):
            if (field in receipt
                    and (not isinstance(receipt[field], str) or not receipt[field])):
                return f"the conversion receipt has invalid {field} value"
        if ("side_meta_b64" in receipt) != ("side_meta_mode" in receipt):
            return "the conversion receipt must pair side_meta_b64 and side_meta_mode"
        if "side_meta_b64" in receipt:
            encoded = receipt["side_meta_b64"]
            mode = receipt["side_meta_mode"]
            if not isinstance(encoded, str):
                return "the conversion receipt has invalid side_meta_b64 value"
            if type(mode) is not int or not 0 <= mode <= 0o777:
                return "the conversion receipt has invalid side_meta_mode value"
            try:
                decoded = base64.b64decode(encoded, validate=True)
            except (binascii.Error, ValueError):
                return "the conversion receipt has invalid side_meta_b64 value"
            if base64.b64encode(decoded).decode("ascii") != encoded:
                return "the conversion receipt has non-canonical side_meta_b64 value"
        for field in ("inserted_sidechain", "prefix_uuids"):
            value = receipt.get(field)
            if value is not None and (not isinstance(value, list) or not value
                                      or not all(isinstance(item, str) and item
                                                 for item in value)
                                      or len(value) != len(set(value))):
                return f"the conversion receipt has invalid {field} value"
        if bool(receipt.get("previous_record") is not None) != bool(
                receipt.get("previous_position") is not None):
            return "the conversion receipt must pair previous_record and previous_position"
        if (receipt.get("previous_position") is not None
                and (type(receipt["previous_position"]) is not int
                     or receipt["previous_position"] < 0)):
            return "the conversion receipt has invalid previous_position value"
        stripped = receipt.get("stripped")
        if stripped is not None and (not isinstance(stripped, list) or not stripped
                                     or not all(isinstance(item, list) and len(item) == 2
                                                and type(item[0]) is int and item[0] >= 0
                                                and isinstance(item[1], str) and item[1]
                                                for item in stripped)):
            return "the conversion receipt has invalid stripped value"
        root_stamps = receipt.get("root_stamps")
        member_identity = bool(receipt.get("name") and receipt.get("team")
                               and receipt.get("name") != "team-lead")
        if member_identity and root_stamps is None:
            return "a member conversion receipt must carry root_stamps"
        if not member_identity and root_stamps is not None:
            return "a non-member conversion receipt must not carry root_stamps"
        if root_stamps is not None and not (
                isinstance(root_stamps, dict)
                and set(root_stamps) == {"agentName", "teamName"}
                and all(isinstance(root_stamps[field], list)
                        and len(root_stamps[field]) == 2
                        and isinstance(root_stamps[field][0], bool)
                        and (root_stamps[field][0]
                             or root_stamps[field][1] is None)
                        for field in ("agentName", "teamName"))):
            return "the conversion receipt has invalid root_stamps"
        return None

    @classmethod
    def receipt_in_file(cls, path):
        """The last valid current-schema conversion receipt in one JSONL."""
        receipt = cls._last_record_in_file(path, RECEIPT_RECORD, "receipt")
        return receipt if receipt and not cls.receipt_objection(receipt) else None

    @classmethod
    def terminal_receipt_in_file(cls, path):
        """Return a conversion receipt when it occupies the final nonempty line.

        Embedded receipts supply demotion defaults. A final receipt additionally
        represents the immediately reversible conversion.
        """
        try:
            raws = Path(path).read_text(errors="strict").splitlines()
        except (OSError, UnicodeDecodeError):
            return None
        if not raws:
            return None
        try:
            rec = json.loads(raws[-1])
        except ValueError:
            return None
        if not isinstance(rec, dict) or rec.get("type") != RECEIPT_RECORD:
            return None
        receipt = rec.get("receipt")
        return (receipt if receipt and not cls.receipt_objection(receipt)
                else None)

    # -- side transcript <-> teammate conversion: this rewriter plans, proves
    #    the inverse, and never writes; materialize/embed consume a proved plan.

    @staticmethod
    def _codec_load(raw):
        """(record, dump style) for one line, or (None, why).

        A line is convertible only when one dump form reproduces its bytes,
        because the round-trip proof is a byte comparison: a line the codec
        cannot reproduce untouched cannot be proved restored either.
        """
        try:
            rec = json.loads(raw)
        except ValueError:
            return None, "is not JSON"
        for style, kwargs in (("compact", {"separators": (",", ":")}), ("spaced", {})):
            if json.dumps(rec, ensure_ascii=False, **kwargs) == raw:
                return (rec, style), None
        return None, "has bytes no dump form reproduces"

    @staticmethod
    def _codec_dump(rec, style):
        kwargs = {"separators": (",", ":")} if style == "compact" else {}
        return json.dumps(rec, ensure_ascii=False, **kwargs)

    @staticmethod
    def _insert_after(rec, anchor, key, value):
        """The record with key set right after anchor, harness key order."""
        out = {}
        for k, v in rec.items():
            out[k] = v
            if k == anchor:
                out[key] = value
        if key not in out:
            out = {key: value, **rec}
        return out

    @staticmethod
    def _is_tool_result_user(rec):
        """Whether this user record carries a tool result."""
        content = (rec.get("message") or {}).get("content")
        return isinstance(content, list) and any(
            isinstance(block, dict) and block.get("type") == "tool_result"
            for block in content)

    def _transcript_chain(self, path, leaf_uuid):
        """The message chain Claude Code can reach from leaf_uuid in one file.

        Progress records are aliases for their nearest non-progress parent. A
        missing parent gets the same five-second, same-sidechain timestamp
        fallback as 2.1.220. Parallel assistant fragments and their tool results
        are inserted after the chain assistant with the message id they share.
        """
        messages, progress = {}, {}
        try:
            handle = path.open(errors="strict")
        except OSError as err:
            return None, f"the referenced parent transcript is unreadable ({err})"
        with handle:
            for line in handle:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                uuid = _record_uuid(rec)
                if not uuid:
                    continue
                if rec.get("type") == "progress":
                    parent = rec.get("parentUuid")
                    progress[uuid] = progress.get(parent, parent)
                    continue
                if rec.get("type") not in ("user", "assistant", "attachment", "system"):
                    continue
                rec = dict(rec)
                if rec.get("parentUuid") in progress:
                    rec["parentUuid"] = progress[rec["parentUuid"]]
                messages[uuid] = rec
        cursor = messages.get(leaf_uuid)
        if cursor is None:
            return None, f"the referenced parent transcript does not carry {leaf_uuid}"
        reverse, seen = [], set()
        while cursor is not None:
            if cursor["uuid"] in seen:
                return None, f"the referenced parent chain cycles at {cursor['uuid']}"
            seen.add(cursor["uuid"])
            reverse.append(cursor)
            parent = cursor.get("parentUuid")
            if parent is None:
                break
            found = messages.get(parent)
            if found is None:
                now, nearest, distance = iso_ms(cursor.get("timestamp")), None, 5001
                if now:
                    for candidate in messages.values():
                        if candidate["uuid"] in seen or \
                                candidate.get("isSidechain") != cursor.get("isSidechain"):
                            continue
                        then = iso_ms(candidate.get("timestamp"))
                        gap = now - then
                        if then and 0 <= gap <= 5000 and gap < distance:
                            nearest, distance = candidate, gap
                found = nearest
            if found is None:
                return None, (f"the referenced parent chain breaks at {cursor['uuid']}: "
                              f"parent {parent} is absent")
            cursor = found
        chain = list(reversed(reverse))

        assistants = [rec for rec in chain if rec.get("type") == "assistant"]
        by_message, tool_results = {}, {}
        for rec in messages.values():
            if rec.get("type") == "assistant" and (rec.get("message") or {}).get("id"):
                by_message.setdefault(rec["message"]["id"], []).append(rec)
            elif rec.get("type") == "user" and rec.get("parentUuid") and \
                    self._is_tool_result_user(rec):
                tool_results.setdefault(rec["parentUuid"], []).append(rec)
        inserted, recovered, handled = {}, set(seen), set()
        for rec in assistants:
            message_id = (rec.get("message") or {}).get("id")
            if not message_id or message_id in handled:
                continue
            handled.add(message_id)
            variants = by_message.get(message_id, [rec])
            fragments = sorted((item for item in variants if item["uuid"] not in recovered),
                               key=lambda item: item.get("timestamp") or "")
            results = []
            for item in variants:
                results.extend(result for result in tool_results.get(item["uuid"], [])
                               if result["uuid"] not in recovered)
            results.sort(key=lambda item: item.get("timestamp") or "")
            extras = fragments + results
            if extras:
                inserted[rec["uuid"]] = extras
                recovered.update(item["uuid"] for item in extras)
        if inserted:
            expanded = []
            for rec in chain:
                expanded.append(rec)
                expanded.extend(inserted.get(rec["uuid"], ()))
            chain = expanded
        return [rec for rec in chain if not rec.get("isSidechain")], None

    def _materialized_prefix(self, source, ref, dest_stem, own_uuids):
        """Copy a fork-reference transcript's inherited parent chain into a main transcript."""
        parent, leaf = ref.get("parentSessionId"), ref.get("parentLastUuid")
        if not parent or not leaf:
            return None, None, None, "the fork-context-ref names no parent session or leaf"
        parent_path = source.parent.parent.parent / f"{parent}.jsonl"
        chain, why = self._transcript_chain(parent_path, leaf)
        if chain is None:
            return None, None, None, why
        lines, uuids, previous = [], [], None
        known = set(own_uuids)
        for rec in chain:
            uuid = rec.get("uuid")
            if not uuid:
                continue
            if uuid in known:
                return None, None, None, (f"the referenced parent prefix reuses uuid {uuid} "
                                          "inside the side transcript")
            known.add(uuid)
            copied = dict(rec)
            copied["parentUuid"] = previous
            copied["isSidechain"] = False
            copied["sessionId"] = dest_stem
            for field in ("logicalParentUuid", "agentName", "teamName", "sessionKind",
                          "slug", "sourceToolAssistantUUID"):
                copied.pop(field, None)
            lines.append(json.dumps(copied, separators=(",", ":"), ensure_ascii=False))
            uuids.append(uuid)
            previous = uuid
        if previous is None:
            return (None, None, None,
                    "the referenced parent prefix contains no main-session records")
        return lines, uuids, previous, None

    def _convert(self, raws, direction, receipt, rescan_visible_humans=False):
        """(out_lines, objections) - one edit set, applied forward or backward.

        `receipt` is both the record of a promote and the parameters of the
        demote that undoes it: the forward pass fills it, the backward pass
        consumes it, so the two directions cannot drift apart. The fields a
        conversion may touch are closed (sessionId, isSidechain, the fork-reference
        root's parentUuid, known human wrappers' isMeta and optional message content,
        the ref line, its materialized prefix, and last-prompt trailers, in that
        vocabulary and no other); a line is an objection, not an edit, when its
        transform would need any other field.
        """
        objections, parsed = [], []
        for n, raw in enumerate(raws, 1):
            loaded, why = self._codec_load(raw)
            if loaded is None:
                objections.append(f"line {n} {why}")
                continue
            parsed.append((n, raw) + loaded)
        prefix_lines = receipt.get("_prefix_lines") or [] if direction == "promote" else []
        prefix_parsed = []
        for n, raw in enumerate(prefix_lines, 1):
            loaded, why = self._codec_load(raw)
            if loaded is None:
                objections.append(f"materialized prefix line {n} {why}")
                continue
            prefix_parsed.append((n, raw) + loaded)
        if objections:
            return None, objections

        parent, dest = receipt["parent"], receipt["dest_stem"]
        out = []

        edits = receipt["visible_human_wrapper_edits"]
        original_payloads = list(edits["original_payloads"])
        interval_specs = edits["intervals"]
        visible_order, visible_by_uuid, payload_ref = [], {}, {}
        candidates = prefix_parsed + parsed
        positions = {rec.get("uuid"): at for at, (_n, _raw, rec, _style)
                     in enumerate(candidates) if rec.get("uuid")}

        def complete_wrapper(rec):
            content = (rec.get("message") or {}).get("content")
            wrapped = _human_wrapper_text(content)
            return (wrapped if wrapped and (
                _human_message_matches(rec, content, True)
                or _human_message_matches(rec, content, False)) else None)

        for first, last, refs in interval_specs:
            if first not in positions or last not in positions or positions[first] > positions[last]:
                objections.append(
                    f"the conversion receipt has an unresolved visible human interval {first}..{last}")
                continue
            rows = [row for row in candidates[positions[first]:positions[last] + 1]
                    if row[2].get("uuid")]
            if refs and len(refs) != len(rows):
                objections.append(
                    f"visible human interval {first}..{last} has the wrong payload count "
                    f"({len(refs)} for {[rec.get('uuid') for _n, _raw, rec, _style in rows]})")
                continue
            for offset, (_n, _raw, rec, _style) in enumerate(rows):
                uuid = rec.get("uuid")
                if uuid in visible_by_uuid:
                    objections.append(
                        f"visible human intervals repeat uuid {uuid}")
                    continue
                if refs:
                    ref = refs[offset]
                    visible_by_uuid[uuid] = tuple(original_payloads[ref])
                    payload_ref[uuid] = ref
                else:
                    wrapped = complete_wrapper(rec)
                    if wrapped is None:
                        objections.append(
                            f"visible human interval {first}..{last} contains non-human {uuid}")
                        continue
                    visible_by_uuid[uuid] = wrapped
                visible_order.append(uuid)

        unwrapped = receipt["unwrapped"]
        discover_visible = direction == "promote" and rescan_visible_humans
        if discover_visible:
            selected = {positions[uuid] for uuid in visible_order if uuid in positions}
            for at, (_n, _raw, rec, _style) in enumerate(candidates):
                wrapped = _wrapped_human_message(rec)
                uuid = rec.get("uuid")
                if wrapped is None or not uuid:
                    continue
                selected.add(at)
                if uuid not in visible_by_uuid:
                    visible_order.append(uuid)
                    visible_by_uuid[uuid] = wrapped
                    if unwrapped:
                        payload_ref[uuid] = len(original_payloads)
                        original_payloads.append([wrapped[0], wrapped[1]])
            intervals = []
            for at in sorted(selected):
                uuid = candidates[at][2].get("uuid")
                ref = payload_ref.get(uuid)
                separated = (intervals and any(
                    candidates[pos][2].get("uuid")
                    for pos in range(intervals[-1][3] + 1, at)))
                if not intervals or separated:
                    intervals.append([uuid, uuid, [] if ref is None else [ref], at])
                else:
                    intervals[-1][1], intervals[-1][3] = uuid, at
                    if ref is not None:
                        intervals[-1][2].append(ref)
            interval_specs = [[first, last, refs]
                              for first, last, refs, _at in intervals]
        receipt["visible_human_wrapper_edits"] = {
            "original_payloads": original_payloads,
            "intervals": interval_specs,
        }
        seen_visible = set()
        root_stamps = receipt.get("root_stamps")
        stamp_member_root = bool(receipt.get("name") and receipt.get("team")
                                 and receipt.get("name") != "team-lead")

        def visibility_edit(n, rec, new, where="line"):
            """Apply one recorded human edit and return its per-record vocabulary."""
            uuid = new.get("uuid")
            if uuid not in visible_by_uuid:
                return new, ()
            if uuid in seen_visible:
                objections.append(f"{where} {n}: visible human uuid {uuid} is repeated")
            seen_visible.add(uuid)
            version, inner = visible_by_uuid[uuid]
            if direction == "promote":
                if _wrapped_human_message(rec) != (version, inner):
                    objections.append(
                        f"{where} {n}: visible human {uuid} no longer matches its receipt")
                    return new, ()
                new["isMeta"] = False
                extra = ("isMeta",)
                if unwrapped:
                    message = dict(new["message"])
                    message["content"] = inner
                    new["message"] = message
                    extra += ("message",)
                return new, extra

            wrapped = _human_wrapper_content(version, inner)
            expected = inner if unwrapped else wrapped
            if not _human_message_matches(rec, expected, False):
                objections.append(
                    f"{where} {n}: visible human {uuid} no longer matches its receipt")
                return new, ()
            new["isMeta"] = True
            extra = ("isMeta",)
            if unwrapped:
                restored = dict(new["message"])
                restored["content"] = wrapped
                new["message"] = restored
                extra += ("message",)
            return new, extra

        if direction == "promote":
            for n, _raw, rec, style in prefix_parsed:
                new, extra = visibility_edit(n, rec, dict(rec), "materialized prefix line")
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(
                        f"materialized prefix line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            root_uuid = receipt.get("root")
            inserted = set(receipt.get("inserted_sidechain") or [])
            for n, raw, rec, style in parsed:
                if (n == 1 and receipt["grammar"] == SIDE_GRAMMAR_FORK_REFERENCE
                        and rec.get("type") == "fork-context-ref"):
                    receipt["ref"] = raw
                    continue
                new = dict(rec)
                extra = ()
                if new.get("sessionId") == parent:
                    new["sessionId"] = dest
                if new.get("uuid") in inserted and new.get("isSidechain") is True:
                    # The demote being undone put this field here; remove it
                    # rather than flip it, or the round trip grows a field.
                    new.pop("isSidechain")
                elif new.get("isSidechain") is True:
                    new["isSidechain"] = False
                new, visibility_extra = visibility_edit(n, rec, new)
                extra += visibility_extra
                if (receipt["grammar"] == SIDE_GRAMMAR_FORK_REFERENCE and receipt.get("ref")
                        and new.get("uuid") == root_uuid):
                    graft = receipt.get("graft")
                    if not graft:
                        objections.append("the fork-reference promotion has no materialized parent leaf")
                    else:
                        new["parentUuid"] = graft
                        new.pop("logicalParentUuid", None)
                        extra += ("parentUuid",)
                if new.get("uuid") == root_uuid and stamp_member_root:
                    if root_stamps is None:
                        root_stamps = {
                            field: [field in rec, rec.get(field)]
                            for field in ("agentName", "teamName")
                        }
                        receipt["root_stamps"] = root_stamps
                    else:
                        for field in ("agentName", "teamName"):
                            present, value = root_stamps[field]
                            if (field in rec) != present or (present and rec.get(field) != value):
                                objections.append(
                                    f"line {n}: promoted member root {field} no longer matches its receipt")
                    new["agentName"] = receipt["name"]
                    new["teamName"] = receipt["team"]
                    extra += ("agentName", "teamName")
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(f"line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            if receipt.get("stripped"):
                # Undoing a demote restores the original trailer bytes and
                # positions. Generating a new trailer would invent transcript history.
                # Their positions are relative to the side transcript, which
                # does not contain a fork-reference promotion's copied prefix.
                offset = len(prefix_lines)
                for pos, raw in receipt["stripped"]:
                    out.insert(offset + pos, raw)
            else:
                leaf = next((json.loads(line).get("uuid") for line in reversed(out)
                             if '"uuid"' in line and json.loads(line).get("uuid")), None)
                if leaf is None:
                    objections.append("no record carries a uuid, so there is no leaf")
                # The text the resume picker shows: the last human prompt. A
                # persistent mid-turn wrapper is storage syntax, not its title.
                prompt_records = prefix_parsed + parsed
                said = next((text for _n, _raw, rec, _s in reversed(prompt_records)
                             for text in [_picker_prompt_text(rec)] if text), "")
                trailer = {"type": "last-prompt", "lastPrompt": said,
                           "leafUuid": leaf, "sessionId": dest}
                out.append(json.dumps(trailer, separators=(",", ":"), ensure_ascii=False))
                receipt["trailer"] = out[-1]
        else:
            trailers, inserted = [], []
            prefix_uuids = receipt.get("prefix_uuids") or []
            prefix_set, removed_prefix = set(prefix_uuids), []
            root_seen = False
            for n, raw, rec, style in parsed:
                if rec.get("uuid") in prefix_set:
                    restored, extra = visibility_edit(
                        n, rec, dict(rec), "materialized prefix line")
                    bad = self._edit_closure(rec, restored, extra)
                    if bad:
                        objections.append(
                            f"materialized prefix line {n}: the edit set would need {bad}")
                    removed_prefix.append((rec["uuid"], self._codec_dump(restored, style)))
                    continue
                if rec.get("type") == "last-prompt":
                    # Positions count earlier trailers too, so the undo can
                    # reinsert sequentially and land every line where it sat.
                    trailers.append((len(out) + len(trailers), raw))
                    continue
                new = dict(rec)
                extra = ()
                if new.get("sessionId") == dest:
                    new["sessionId"] = parent
                if new.get("isSidechain") is False:
                    new["isSidechain"] = True
                elif "isSidechain" not in new and new.get("uuid"):
                    # A post-promotion message can lack this field. Demotion adds
                    # it and records the UUID so promotion removes it again.
                    # UUID-less harness records can carry sessionId, but they do
                    # not belong to either message chain and stay without it.
                    anchor = ("logicalParentUuid" if "logicalParentUuid" in new
                              else "parentUuid")
                    new = self._insert_after(new, anchor, "isSidechain", True)
                    inserted.append(new["uuid"])
                new, visibility_extra = visibility_edit(n, rec, new)
                extra += visibility_extra
                if new.get("uuid") == receipt.get("root"):
                    root_seen = True
                    graft = receipt.get("graft")
                    if prefix_uuids:
                        if new.get("parentUuid") != graft:
                            objections.append(f"line {n}: the promoted root no longer points to "
                                              "its materialized parent leaf")
                        else:
                            new["parentUuid"] = None
                            extra += ("parentUuid",)
                    if root_stamps is not None:
                        for field in ("agentName", "teamName"):
                            expected = receipt.get("name" if field == "agentName" else "team")
                            if rec.get(field) != expected:
                                objections.append(
                                    f"line {n}: promoted member root {field} no longer matches its receipt")
                                continue
                            present, value = root_stamps[field]
                            if present:
                                new[field] = value
                            else:
                                new.pop(field, None)
                        extra += ("agentName", "teamName")
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(f"line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            if prefix_uuids:
                removed_uuids = [uuid for uuid, _raw in removed_prefix]
                if removed_uuids != prefix_uuids:
                    objections.append("the materialized parent prefix is incomplete or reordered")
                if not root_seen:
                    objections.append("the promoted root is absent, so its parent link cannot be restored")
                receipt["_prefix_lines"] = [raw for _uuid, raw in removed_prefix]
            if receipt.get("ref"):
                out.insert(0, receipt["ref"])
            if trailers:
                receipt["stripped"] = trailers
            else:
                receipt.pop("stripped", None)
            if inserted:
                receipt["inserted_sidechain"] = inserted
            else:
                receipt.pop("inserted_sidechain", None)
        missing_visible = [uuid for uuid in visible_order if uuid not in seen_visible]
        if missing_visible:
            objections.append(f"the transcript is missing visible human {missing_visible[0]}")
        return out, objections

    @staticmethod
    def _receipt_line(receipt):
        """The in-file record one converted transcript carries for its inverse."""
        carried = {k: json_value(receipt[k]) for k in RECEIPT_KEYS
                   if k in RECEIPT_REQUIRED or receipt.get(k) is not None}
        return json.dumps({"type": RECEIPT_RECORD, "receipt": carried},
                          separators=(",", ":"), ensure_ascii=False, sort_keys=True)

    @staticmethod
    def _carried_receipt_at(raws):
        """(receipt, one-based line) for the last conversion receipt."""
        return TranscriptRewriter._last_record_at(raws, RECEIPT_RECORD, "receipt")

    @classmethod
    def carried_receipt(cls, raws):
        """The last valid current-schema receipt in these JSONL lines."""
        receipt = cls._carried_receipt_at(raws)[0]
        return receipt if receipt and not cls.receipt_objection(receipt) else None

    @staticmethod
    def _edit_closure(before, after, extra=()):
        """The first field outside the conversion vocabulary, or None.

        `extra` widens the vocabulary for one record when a conversion needs
        it, and nothing else ever does.
        """
        allowed = {"sessionId", "isSidechain", "logicalParentUuid", *extra}
        for key in set(before) | set(after):
            if key in allowed:
                continue
            if before.get(key, _MISSING) != after.get(key, _MISSING):
                return key
        return None

    def conversion_plan(self, source, direction, into=None, dest=None, identity=None,
                        unwrap=None, grammar=None, parent_uuids=None,
                        projects_dir=None):
        """Return one deeply immutable proved conversion plan from closed inputs."""
        return immutable(self._conversion_plan(
            source, direction, into=into, dest=dest,
            identity=identity, unwrap=unwrap, grammar=grammar,
            parent_uuids=parent_uuids, projects_dir=projects_dir))

    def _conversion_plan(self, source, direction, into=None, dest=None, identity=None,
                         unwrap=None, grammar=None, parent_uuids=None,
                         projects_dir=None):
        """Plan one conversion and byte-prove the opposite conversion restores it."""
        source = Path(source)
        try:
            text = source.read_bytes().decode("utf-8", "strict")
        except (OSError, UnicodeDecodeError) as err:
            return immutable({
                "objections": (f"unreadable source: {err}",), "proved": False})
        raws, source_newline, newline_objection = _split_jsonl_text(text)
        if newline_objection:
            return immutable({"objections": (newline_objection,), "proved": False})

        carried, carried_raw, carried_position, without_carried = \
            self._consume_last_record(raws, RECEIPT_RECORD, "receipt")
        receipt_objection = self.receipt_objection(carried) if carried is not None else None
        if receipt_objection:
            return immutable({"objections": (receipt_objection,), "proved": False})
        carried_direction = carried["direction"] if carried is not None else None
        consumes = carried is not None and carried_direction != direction
        body = without_carried if consumes else list(raws)
        prior = dict(carried) if consumes else {}
        output_newline = (prior.get("source_newline", source_newline)
                          if consumes else source_newline)
        exact_inverse = False
        rescan_visible_humans = False

        if direction == "promote":
            if not grammar or len(grammar) != 3:
                return immutable({
                    "objections": ("promotion needs one selected side grammar",),
                    "proved": False})
            grammar, detail, root = grammar
            if grammar == SIDE_CLASS_UNCLASSIFIABLE:
                return immutable({
                    "objections": (f"not convertible: {detail}",),
                    "proved": False})
            parent = source.parent.parent.name
            expected_dest = prior.get("dest_stem") if consumes else root
            destination = dest or expected_dest
            expected_identity = (prior.get("name"), prior.get("team"))
            prior_unwrapped = prior["unwrapped"] if consumes else False
            selected_unwrapped = (prior_unwrapped if consumes and unwrap is None
                                  else unwrap is True)
            changes_visibility_mode = (consumes and unwrap is not None
                                       and selected_unwrapped != prior_unwrapped)
            exact_inverse = (consumes and destination == expected_dest
                             and (identity is None or identity == expected_identity)
                             and not changes_visibility_mode)
            receipt = dict(prior)
            if not consumes:
                receipt["visible_human_wrapper_edits"] = {
                    "original_payloads": [], "intervals": []}
                rescan_visible_humans = True
            elif changes_visibility_mode:
                receipt["visible_human_wrapper_edits"] = {
                    "original_payloads": [], "intervals": []}
                rescan_visible_humans = True
            elif not exact_inverse:
                # A new promotion keeps the carried edits and takes ownership of
                # any eligible wrappers added since that receipt was written.
                rescan_visible_humans = True
            receipt.update({"schema_version": 1, "direction": "promote",
                            "grammar": grammar,
                            "parent": parent, "root": root or prior.get("root"),
                            "dest_stem": destination,
                            "task_id": prior.get("task_id") or
                                       source.stem[len("agent-"):],
                            "unwrapped": selected_unwrapped})
            if identity:
                receipt["name"], receipt["team"] = identity
            if receipt.get("name") == "team-lead":
                receipt.pop("root_stamps", None)
            meta = source.with_name(source.stem + ".meta.json")
            if not consumes:
                try:
                    with meta.open("rb") as handle:
                        receipt["side_meta_b64"] = base64.b64encode(
                            handle.read()).decode("ascii")
                        receipt["side_meta_mode"] = os.fstat(
                            handle.fileno()).st_mode & 0o777
                except OSError:
                    receipt.pop("side_meta_b64", None)
                    receipt.pop("side_meta_mode", None)
            objections = []
            if grammar == SIDE_GRAMMAR_FORK_REFERENCE:
                own_uuids = set()
                for raw in body[1:]:
                    try:
                        rec = json.loads(raw)
                    except ValueError:
                        continue
                    if isinstance(rec, dict) and rec.get("uuid"):
                        own_uuids.add(rec["uuid"])
                prefix, prefix_uuids, graft, why = self._materialized_prefix(
                    source, detail, destination, own_uuids)
                if why:
                    objections.append(why)
                    out = None
                else:
                    if prior.get("prefix_uuids") and prior["prefix_uuids"] != prefix_uuids:
                        objections.append("the referenced parent prefix no longer has the recorded UUIDs")
                    receipt["_prefix_lines"] = prefix
                    receipt["prefix_uuids"] = prefix_uuids
                    receipt["graft"] = graft
                    out, objections = self._convert(
                        body, "promote", receipt,
                        rescan_visible_humans=rescan_visible_humans)
            else:
                out, objections = self._convert(
                    body, "promote", receipt,
                    rescan_visible_humans=rescan_visible_humans)
            dest_path = source.parent.parent.parent / f"{destination}.jsonl"
        else:
            expected_parent = prior.get("parent") if consumes else None
            into = into or expected_parent
            exact_inverse = consumes and into == expected_parent
            if not into:
                return immutable({
                    "objections": ("demote needs one selected parent session",),
                    "proved": False})
            ref_raw = prior.get("ref")
            if ref_raw and not exact_inverse:
                try:
                    ref = json.loads(ref_raw)
                except ValueError:
                    ref = {}
                anchor, from_session = ref.get("parentLastUuid"), ref.get("parentSessionId")
                if anchor and (parent_uuids is None or anchor not in parent_uuids):
                    return immutable({"objections": (
                        f"this fork inherits its context by reference from "
                        f"{from_session}, which no longer carries {anchor}; moving "
                        f"it would leave that prefix unresolvable",), "proved": False})
            receipt = dict(prior)
            receipt.update({"schema_version": 1, "direction": "demote",
                            "grammar": prior["grammar"] if consumes else SIDE_GRAMMAR_REGULAR,
                            "parent": into, "dest_stem": source.stem,
                            "task_id": dest or prior.get("task_id") or source.stem,
                            "root": prior.get("root")})
            if not consumes:
                receipt["unwrapped"] = False
                receipt["visible_human_wrapper_edits"] = {
                    "original_payloads": [], "intervals": []}
            out, objections = self._convert(body, "demote", receipt)
            if projects_dir is None:
                return immutable({
                    "objections": ("demotion needs the selected projects directory",),
                    "proved": False})
            dest_path = (Path(projects_dir) / source.parent.name / into / "subagents"
                         / f"agent-{receipt['task_id']}.jsonl")

        # A receipt records both record separators and the final terminator so
        # its inverse writer restores LF, CRLF, or no final terminator exactly.
        receipt["source_newline"] = source_newline
        emits = not exact_inverse
        output_record_raw = None
        if out is not None and not objections:
            if emits:
                if consumes:
                    receipt["previous_record"] = carried_raw
                    receipt["previous_position"] = carried_position
                else:
                    receipt.pop("previous_record", None)
                    receipt.pop("previous_position", None)
                output_record_raw = self._receipt_line(receipt)
                out.append(output_record_raw)
            elif prior.get("previous_record") is not None:
                output_record_raw = prior["previous_record"]
                out.insert(prior["previous_position"], output_record_raw)
        if out is not None and len(out) > 1 and output_newline["line"] == "none":
            # A one-record input has no separator to preserve. Once conversion
            # adds records, LF separates them while the absent final terminator
            # remains absent and the receipt retains the source's `none` state.
            output_newline = {"line": "lf", "final": "none"}

        proved = False
        if out is not None and not objections:
            inverse_body = list(out)
            if output_record_raw is not None:
                _output, output_raw, _output_position, inverse_body = \
                    self._consume_last_record(inverse_body, RECEIPT_RECORD, "receipt")
                if output_raw != output_record_raw:
                    objections.append("the output conversion receipt is not the last one selected")
            if not objections:
                back, back_obj = self._convert(
                    inverse_body, "demote" if direction == "promote" else "promote",
                    dict(receipt))
                if back_obj:
                    objections.append(f"the inverse raises its own objections: {back_obj[0]}")
                else:
                    if consumes:
                        back.insert(carried_position, carried_raw)
                    proved = _jsonl_text(back, source_newline) == text
                    if not proved:
                        objections.append("the inverse does not restore the source bytes")

        receipt["_consumed"] = consumes
        receipt["_emitted"] = emits
        return immutable({
            "direction": direction,
            "source": source,
            "dest_path": dest_path,
            "lines": out or (),
            "newline": output_newline,
            "receipt": receipt,
            "objections": objections,
            "proved": proved,
        })


_MISSING = object()


RESOLVER = Resolver()


# What a revived pane needs from the lead's environment. The harness's swarm
# server is started BY the leader, so its panes inherit these; a server we start
# does not, because tool subprocesses have the credentials scrubbed. A new
# server inherits them from us; topping up an existing one puts the value on a
# transient tmux client argv, which is why that path only runs for variables the
# server is actually missing.
AUTH_ENV = ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")
# The traffic variable's name reads like a preference, so it invites being
# dropped from this set as "not a credential". It belongs: when the credential
# arrives as an OAuth access token in the environment rather than from a normal
# login, it has to travel with the token, so the two move together or neither
# works. The report calls the whole set creds for that reason.
INHERIT_ENV = AUTH_ENV + ("CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",)


def credential_names(ctx):
    """Names this launch would copy from its selected lead process."""
    fact = ctx["process"]["credentials"]
    if fact["process"] is None:
        return ()
    return tuple(sorted(key for key in fact["values"] if not os.environ.get(key)))


def inherit_credentials(ctx):
    """Adopt the credential fact retained by the complete launch answer."""
    adopted = credential_names(ctx)
    values = ctx["process"]["credentials"]["values"]
    for key in adopted:
        os.environ[key] = values[key]
    # Only shout when the revived agent would have no way to authenticate at
    # all. The usual setup keeps credentials in a file, and the traffic flag is
    # optional, so warning about either on every run trains you to ignore a tool
    # that kills things.
    if not any(os.environ.get(key) for key in AUTH_ENV) and not (CLAUDE_DIR / ".credentials.json").exists():
        warn("no auth env var on this lead and no ~/.claude/.credentials.json; "
             "the revived agent will have nothing to authenticate with")
    return sorted(adopted)


# ---------------------------------------------------------------- disk scanners

TAG_RE = re.compile(r"</?[a-zA-Z][a-zA-Z0-9_-]*[^>]*>")

# roster color -> ANSI SGR, for colorizing completion candidates
COLOR_ANSI = {
    "red": "31", "green": "32", "yellow": "33", "blue": "34", "purple": "35",
    "magenta": "35", "cyan": "36", "orange": "38;5;208", "pink": "38;5;205",
}

# The harness's titler sometimes echoes an agent name instead of titling,
# and repeats it down the file. Real ai titles are natural language, so
# any whitespace-free ai title is treated as absent; this set catches multiword
# junk. A custom title gets the benefit of the doubt on its wording, since a
# person may have typed it, but not on its authorship: see _harness_wrote.
JUNK_TITLES = {"new session"}

# What the harness wraps around its own records. A slash command, its output,
# and the caveat prepended to a local command all arrive wearing a user's hat.
HARNESS_TAGS = ("<command-name>", "<command-message>", "<command-args>",
                "<local-command-caveat>", "<local-command-stdout>",
                "<local-command-stderr>", "<system-reminder>")


def _harness_wrote(text):
    """Is this text the machinery talking rather than the person?

    Asked in one place because both paths to a title need the same answer and
    only one of them had it: the title records the harness writes, and the
    first user message read when there are none. The filtered path was the
    rarely taken one, so a conversation that opened with a slash command as
    its prompt was titled with the caveat wrapped around it, which describes the
    tool the person was running rather than the work they were doing.
    """
    text = text.lstrip()
    return text.startswith("Caveat:") or any(tag in text for tag in HARNESS_TAGS)


def _title_event(record):
    """Title event fields from one top-level harness title record."""
    if not isinstance(record, dict):
        return None
    kind = record.get("type")
    field = {"custom-title": "customTitle", "ai-title": "aiTitle"}.get(kind)
    if field is None:
        return None
    text = record.get(field)
    if not isinstance(text, str):
        return None
    timestamp = iso_ms(record.get("timestamp")) or None
    return kind, text, timestamp, record.get("uuid")


def _title_events_in(raw, drop_first=False, drop_last=False):
    """Structured title events from complete lines in one byte window."""
    lines = raw.split(b"\n")
    if drop_first and lines:
        lines.pop(0)
    if drop_last and lines:
        lines.pop()
    for line in lines:
        if b'-title"' not in line:
            continue
        try:
            record = json.loads(line)
        except (ValueError, UnicodeDecodeError):
            continue
        event = _title_event(record)
        if event:
            yield event


def _first_user_message(head_lines):
    """Return the first human user-title candidate with its record provenance."""
    for line in head_lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") != "user" or rec.get("isMeta"):
            continue
        content = (rec.get("message") or {}).get("content")
        if isinstance(content, list):
            content = next((c.get("text") for c in content if isinstance(c, dict) and c.get("type") == "text"), None)
        if not isinstance(content, str) or _harness_wrote(content):
            continue  # exclude harness-generated user-role records from titles
        text = TAG_RE.sub(" ", content).strip()  # unwrap teammate-message/command tags
        if text:
            return ("first-user-message", text,
                    iso_ms(rec.get("timestamp")) or None, rec.get("uuid"))
    return None


def _session_title(path):
    """Newest custom title, else newest AI title, else first human user text."""
    path = Path(path)

    def pick(found):
        for kind in ("custom-title", "ai-title"):
            event = found.get(kind)
            if not event:
                continue
            _kind, text, timestamp, record_uuid = event
            text = " ".join(text.split())
            if not text or _harness_wrote(text):
                continue
            if kind == "ai-title" and (
                    " " not in text or text.lower() in JUNK_TITLES):
                continue
            value = " ".join(
                re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text).split())
            if value:
                return TitleFact(value, kind, path, timestamp, record_uuid)
        return None

    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            tail_at = max(0, size - TITLE_TAIL_BYTES)
            drop_first = False
            if tail_at:
                fh.seek(tail_at - 1)
                drop_first = fh.read(1) != b"\n"
            fh.seek(tail_at)
            found = {}
            for event in _title_events_in(fh.read(), drop_first=drop_first):
                found[event[0]] = event
            title = pick(found)
            if not title:
                had_records = bool(found)
                fh.seek(0)
                head_raw = fh.read(TITLE_HEAD_BYTES)
                drop_last = size > len(head_raw) and not head_raw.endswith(b"\n")
                if not had_records:
                    for event in _title_events_in(
                            head_raw, drop_last=drop_last):
                        found[event[0]] = event
                    title = pick(found)
                if not title:
                    head = head_raw.decode("utf-8", "replace")
                    first = _first_user_message(head.splitlines())
                    if first:
                        kind, text, timestamp, record_uuid = first
                        value = " ".join(
                            re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text).split())
                        title = (TitleFact(value, kind, path, timestamp, record_uuid)
                                 if value else None)
    except OSError:
        return None
    return title


def title_value(title):
    """Return display text from one canonical TitleFact."""
    return title.value if title else None


def bounded_title(title, limit):
    """Bound already-resolved title text for one display."""
    if not title:
        return None
    return title[:limit - 3] + "..." if len(title) > limit else title


UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)


# ------------------------------------------------------- transcript resolution
#
# Resolver selects every agent transcript through resolve_transcript(). Each
# result carries its evidence source and strength for reporting and identity
# validation.

EXACT, STAMPS, NAME_ONLY = 3, 2, 1


@dataclasses.dataclass(frozen=True)
class Resolution:
    """A complete transcript answer. `path` None means no evidence."""

    path: object = None
    fields: object = None
    last_ts: int = 0
    via: str = ""
    strength: int = 0
    others: tuple = ()
    reason: str = ""
    answered: bool = False
    runtime: object = None
    evidence: object = None
    transcript: object = None

    def __bool__(self):
        return self.path is not None

    def stamped(self, key):
        return (self.fields or {}).get(key, (None,))[0]

    def identity_from_argv(self):
        """Whether argv identified this transcript as the requested agent."""
        if not self.runtime or not self.path:
            return False
        return any(
            record["session"] == self.path.stem
            and self.runtime["evidence"].get(record["pid"], {}).get("states_identity")
            for record in self.runtime["records"]
        )


def render_team_line(title, count, when, standing=None):
    """Render already-decided team facts without deciding how complete they are."""
    plural = "member" if count == 1 else "members"
    said = [standing] if standing else []
    if when:
        said.append(f"{count} {plural}")
        said.append(when)
    facts = ", ".join(said)
    return f"{title}  [{facts}]" if title else facts


def flatten_cwd(cwd):
    """A cwd's project dir name. Every non-alphanumeric becomes '-' (verified
    against 70 of this machine's project dirs). Lossy, so it has no inverse."""
    return re.sub(r"[^a-zA-Z0-9]", "-", cwd)


def note_cwd(ctx):
    """Print a resolved cwd warning only for a run that may launch the target."""
    warning = ctx.get("cwd_warning")
    if warning:
        warn(warning)


def enter_agent_cwd(ctx, prefix=""):
    """Enter the resolved agent cwd before replacing the current process.

    Foreground lead and in-pane member launches use this path. New-pane launches
    pass the Resolver answer to tmux `-c`, keeping cwd selection consistent across
    launch modes.
    """
    where = ctx["cwd"]
    if not where or os.path.realpath(where) == os.path.realpath(os.getcwd()):
        return where
    print(f"{prefix}cd       {where}")
    try:
        os.chdir(where)
    except OSError as exc:
        die(f"cannot enter {where}: {exc}")
    return where


def build(args, table=None, census=None, terminal=None):
    """Translate parsed flags into a resolved identity and judged objections.

    Callers enforce objections after no-op detection, at the point where a launch
    or write begins.
    """
    return RESOLVER.launch_plan(
        session_uuid=args.resume, agent_id=args.agent_id,
        for_team=getattr(args, "for_team", None),
        keep_team=getattr(args, "keep_team", False),
        table=table, census=census, terminal=terminal,
        requested_socket=getattr(args, "socket", None),
        socket_reason=getattr(args, "socket_reason", None))


def enforce_ctx(ctx, args):
    """Validate identity and restore behavior before the first action."""
    # Lead migration explicitly requests a team change, so its expected stamp
    # mismatch is allowed after the rebind step records `lead_moving`.
    enforce_identity(ctx, ctx["objections"],
                     allow_team_change=(bool(args.to_team)
                                        or bool(ctx["route"]["lead_moving"])),
                     force=args.force)
    enforce_restore(ctx, args)


def enforce_restore(ctx, args):
    """Validate that window-start restore will preserve the requested team.

    A loadable stamped team controls line stamps, spawns, and future restore;
    argv controls idle and message routing for the current split process. A
    null-parent appended record becomes the window root and truncates earlier
    context, while a chained record stays outside restore lookup. Durable rebind
    therefore requires retiring or restamping the source team before launch.
    """
    path = ctx["transcript"]["path"]
    if not path:
        return
    # A move has already been through the rebind step, which retired the team
    # the stamps name or rewrote them. Asking again here would re-refuse a move
    # this run has just made, and in a dry run, where neither has happened yet,
    # would refuse the preview of it. Both paths record it, and both record it
    # only once the rebind came back with the route it took: a blocked one
    # records nothing, so a launch that never moved still meets the refusal.
    if ctx["route"]["lead_moving"] or ctx["route"]["member_moving"]:
        return
    # Asked here, at the action boundary, because a rebuild or a retirement
    # earlier in this run changes which team the stamps bring it back as.
    restore = RESOLVER.restore_answer(ctx)
    if restore["state"] != "restored":
        return
    restored = (restore["name"], restore["team"])
    wanted = (ctx["identity"]["agentName"], ctx["identity"]["teamName"])
    if restored == wanted:
        return
    said_restore = agent_id_of(*restored) if all(restored) else str(restored)
    said_wanted = agent_id_of(*wanted) if all(wanted) else str(wanted)
    force_note = (" --force cannot make this safe because Claude Code restores the "
                  "complete root identity after argv is parsed." if args.force else "")
    die(f"this conversation restores as {said_restore}, not {said_wanted}. "
        "Launching it would split its process identity from the identity written "
        f"into its transcript and app state.{force_note} Restamp the active root or "
        "perform a proved team migration first")


def already_running(ctx, args, here=(), pane=None):
    """Return a no-op reason when the transcript already has a live holder.

    Leads use session-registry ownership. Members add target-pane and matching
    agent-ID checks. `report=True` marks an agent already in the requested pane as
    a successful existing state. Explicit migration proceeds because its action
    stops the holder first; automatic redirect applies only to stopped members.
    """
    identity = ctx["identity"]
    is_lead = identity["role"] == "lead"
    agent_id = identity["agentId"]
    if args.force:
        return None
    route = ctx["route"]
    migrating = bool(route["to_team"]) and not route["automatic"]
    if not is_lead and here and not migrating:
        record = ctx["process"]["snapshot"]["by_pid"].get(here[0]) or {}
        return (f"{agent_id} is already running in pane {pane} "
                f"(pid {here[0]}{record.get('state_note', '')})", True)
    if not is_lead and route["to_team"]:
        return None
    owner = ctx["process"]["snapshot"]["best_by_session"].get(ctx["session"])
    if owner and owner["alive"]:
        # Where that process actually sits, asked of the process rather than
        # echoed from a roster: a member can be live outside tmux entirely.
        where = ""
        if not is_lead and agent_id:
            processes = (ctx["process"].get("runtime") or {}).get(
                "records", ())
            holder = next((row for row in processes if row["pid"] == owner["pid"]), None)
            holder = holder or next((row for row in processes if row["seat"]), None)
            seat = holder["seat"] if holder else None
            where = (f", in pane {seat.pane} on {seat.socket}"
                     if seat else ", outside any tmux pane")
        owner_record = ctx["process"]["snapshot"]["by_pid"].get(owner["pid"]) or {}
        return (f"session {ctx['session']} is live as pid {owner['pid']}"
                f"{owner_record.get('state_note', '')}{where}; pass --force to run a second copy", False)
    if not is_lead and agent_id:
        # The strangers half only: this decides whether to launch, and a launch
        # that counted the process it is running inside could never spawn past
        # itself. Running this transcript ourselves is refused in run_one.
        runtime = ctx["process"]["runtime"]
        elsewhere = [row["pid"] for row in runtime["external"]
                      if row["pid"] not in here]
        if elsewhere:
            return (f"{agent_id} is already running outside pane {pane or '?'} "
                    f"(pid {', '.join(map(str, elsewhere))}); pass --force to "
                    "start another instance", False)
    return None


def noop_outcome(ctx, args, prefix, why, socket=None, pane=None, report=False):
    """Report a no-op, record membership, note identity, and return its outcome."""
    # An agent already sitting where it was asked to sit is the run working,
    # not a hazard, so that one says so in the report's own grammar.
    is_lead = ctx["identity"]["role"] == "lead"
    print(fill(f"{prefix}noop     {why}")) if report else warn(why)
    if not is_lead:
        record_membership(ctx, args, pane)
    note_identity(ctx, prefix)
    return Outcome("noop", socket, is_lead, None)


def note_identity(ctx, prefix=""):
    """Report identity contradictions for a no-op outcome."""
    for kind, stamped, wanted, _why in ctx["objections"]:
        if kind == "team_mismatch":
            warn(f"{prefix}note: this transcript is stamped team={stamped}, not {wanted}; "
                 "it is live under that identity regardless")
        elif kind == "name_mismatch":
            warn(f"{prefix}note: this transcript is stamped agentName={stamped!r}, "
                 f"not {wanted!r}; it is live under that identity regardless")


def enforce_identity(target, objections, allow_team_change, force):
    """Apply force and team-change rules to resolved identity contradictions.

    Name mismatches stop launch by default because they would bind one agent ID to
    another agent's transcript.
    """
    for kind, stamped, wanted, why in objections:
        if kind == "unstamped_below_exact":
            message = (f"{target['transcript']['path'].name} carries no agent stamps and was matched by {why}; "
                       "only an exact session id may claim an unstamped transcript")
            if not force:
                die(f"{message} (--force to override)")
            warn(f"--force: {message}")
        elif kind == "name_mismatch":
            why, _, corroborated = why.partition("|")
            message = (f"{target['transcript']['path'].name} is stamped agentName={stamped!r}, not {wanted!r} "
                       f"(matched by {why})")
            if corroborated:
                # Corroborated evidence agrees on the identity being asked for, so
                # the stamp is the odd one out. The match above names that
                # evidence; it can be the roster, the spawn payloads or a live
                # process, so this sentence names none of them. Two histories
                # produce the disagreement and the remedy is the same, but the
                # diagnosis is not: a launch that carried the wrong name, or a
                # session that was a teammate first and was later resumed into
                # leading a team. The second has an honest past, so naming only
                # the first would accuse it of damage it does not have. Both are
                # stated and neither is assumed.
                message += (f"; that evidence is corroborated and says {wanted!r}, so the "
                            f"stamp is either a launch that carried the wrong name or this "
                            f"session's earlier life as a teammate")
            if not force:
                die(f"{message}. --force resumes it as {wanted!r}, and the lines it writes "
                    f"from then on are stamped correctly")
            warn(f"--force: {message}; resuming as {wanted!r}")
        elif kind == "team_mismatch":
            why, _, newer = why.partition("|")
            if allow_team_change or why == "tolerated":
                warn(f"{target['transcript']['path'].name} is stamped team={stamped}, resuming as {wanted}")
            elif not force:
                message = (f"{target['transcript']['path'].name} is stamped team={stamped}, not {wanted} "
                           f"(matched by {why})")
                if newer:
                    message += (f"; the payloads naming {wanted} were written after those "
                                f"stamps, so --force ratifies the newer evidence rather than "
                                f"overriding the older")
                # The team in an agent id says which agent this is, not where to
                # send it, so a reader who wanted the move has to be told the
                # flag that performs one. --force only lets this launch past the
                # contradiction; the stamps still bring it back as they were.
                die(f"{message}. --into-team {wanted} moves it there instead, retiring "
                    f"{stamped} so the move is still there after the next restart; "
                    f"--force to override")
            else:
                warn(f"--force: {target['transcript']['path'].name} is stamped team={stamped}, resuming as {wanted}")


def apply_selector(token, args):
    """Turn the bare argument into --resume, --agent-id or --team.

    The engine decides what the token is; this sets the flag and does the talking.
    An ambiguous name is refused here rather than in the engine because the
    refusal is worth annotating with who is running, which is presentation.
    """
    answer = RESOLVER.selector_answer(token=token)
    kind, value, why = answer["kind"], answer["selection"], answer["reason"]

    if kind == "uuid":
        if args.resume and args.resume != token:
            die(f"conflicting sessions: {token} and --resume {args.resume}")
        args.resume = token
    elif kind == "agent_id":
        if args.agent_id and args.agent_id != value:
            die(f"conflicting agents: {token} and --agent-id {args.agent_id}")
        args.agent_id = value
    elif kind == "team":
        # Asked here because a bare token is only known to be a team once the
        # engine has classified it; asking earlier reads a flag nobody set.
        if getattr(args, "here", False):
            die(f"--here gives this terminal to one agent, and {token} covers "
                "every member of it; name the one agent to run here")
        if why != "a roster on disk":
            print(f"team     {token} has no roster on disk; rebuilding it from {why}")
        args.team = token
    elif kind == "name":
        if answer["candidates"]:
            warn(f"{token!r} is {why}")
        else:
            warn(f"no team config lists {token!r}; {why}")
        args.resume = value
    elif kind == "ambiguous":
        warn(f"{token!r} is {why}, so it names nobody; pick one:")
        for candidate in answer["candidates"]:
            state = (f"running{candidate['state_note']}" if candidate["running"]
                     else "not running")
            warn(f"    {candidate['agent_id']:<44} joined "
                 f"{ms_str(candidate['joined'])}  [{state}]")
        die("pass one of those ids, or a session uuid")
    else:
        die(f"{token} {why}")


