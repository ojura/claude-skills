@unit(('ending-names-what-it-cannot-open',
       "the cleanup names as left a running process it could not open a pidfd for, and asks "
       "whether a descriptor is ready with poll, which takes one numbered 1024 or more"))
def _check_ending_names_what_it_cannot_open(s):
    """end_process_tree on a sleeper while pidfd_open fails, and ready_to_read on fd 1500.

    A stand-in for os.pidfd_open answers EMFILE, so end_processes cannot open
    the sleeper and signals nothing; the sleeper has to be named as left all
    the same. The readiness question is put to a pipe's read end moved to
    descriptor 1500, above the 1024 select.select takes, with the soft limit
    on open descriptors raised for the length of the question when it is
    lower, and put back.
    """
    import errno
    import resource
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sleeper = subprocess.Popen(["sleep", "30"], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    started = _ProcessFence.start_time(sleeper.pid)
    real_open = os.pidfd_open

    def unopenable(_pid, *_flags):
        raise OSError(errno.EMFILE, os.strerror(errno.EMFILE))

    try:
        os.pidfd_open = unopenable
        try:
            left = end_process_tree(sleeper.pid, started, grace=0.2)
        finally:
            os.pidfd_open = real_open
        still = sleeper.poll() is None
    finally:
        sleeper.kill()
        sleeper.wait()
    told = {
        "a running process it could not open is named as left": left == [sleeper.pid],
        "and was left running, unsignalled": still,
    }
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    high = 1500
    readings = None
    if hard == resource.RLIM_INFINITY or hard > high:
        read_end, write_end = os.pipe()
        try:
            if soft != resource.RLIM_INFINITY and soft <= high:
                resource.setrlimit(resource.RLIMIT_NOFILE, (high + 1, hard))
            os.dup2(read_end, high)
            try:
                before = ready_to_read(high)
                os.close(write_end)
                write_end = None
                readings = (before, ready_to_read(high, 1.0))
            except ValueError:
                readings = "raised ValueError"
            finally:
                os.close(high)
        finally:
            os.close(read_end)
            if write_end is not None:
                os.close(write_end)
            resource.setrlimit(resource.RLIMIT_NOFILE, (soft, hard))
    told["readiness is asked of a descriptor numbered 1500, not ready and then ready"] = (
        readings == (False, True))
    wrong = sorted(claim for claim, ok in told.items() if not ok)
    check("ending-names-what-it-cannot-open",
          "the cleanup names as left a running process it could not open a pidfd for, and "
          "asks whether a descriptor is ready with poll, which takes one numbered 1024 or more",
          not wrong, ", ".join(wrong) + (f"; left {left}, readings {readings}, limit "
                                         f"{(soft, hard)}" if wrong else ""))
    return checked


@unit(('stray-ends-when-its-making-raises',
       "a stray start_stray is making when an exception reaches it, once the stray has said "
       "its pid, has exited within half a second of the exception leaving start_stray"))
def _check_stray_ends_when_its_making_raises(s):
    """start_stray with a stand-in for time.sleep that raises once the stray has said its pid.

    The stand-in waits for the pid in the told file, opens a pidfd for it, and
    raises Terminated, as SIGTERM would there. start_stray ends the stray by
    that pid, through end_stray, which returns once the stray's life line has
    closed, and the line closes as the stray exits. The pidfd turns ready when
    the exit has finished, whichever process above this run reaps the stray,
    a moment after the line closes, so the arm allows half a second for it.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    room = Path(tempfile.mkdtemp(prefix=own("se")))
    told_file = room / "pid"
    real_sleep = time.sleep
    held = {}

    def raising(seconds):
        if held:
            return real_sleep(seconds)
        held["pid"], deadline = 0, time.monotonic() + 10
        while time.monotonic() < deadline and not held["pid"]:
            with contextlib.suppress(OSError, ValueError):
                held["pid"] = int(told_file.read_text().strip() or 0)
            if not held["pid"]:
                real_sleep(0.02)
        with contextlib.suppress(OSError):
            held["fd"] = os.pidfd_open(held["pid"])
        raise Terminated("a SIGTERM while start_stray waits")

    raised = False
    try:
        time.sleep = raising
        try:
            start_stray(told_file)
        except Terminated:
            raised = True
        finally:
            time.sleep = real_sleep
        ended = "fd" in held and ready_to_read(held["fd"], 0.5)
    finally:
        if "fd" in held:
            if not ready_to_read(held["fd"]):
                with contextlib.suppress(OSError):
                    import signal
                    signal.pidfd_send_signal(held["fd"], signal.SIGKILL)
            os.close(held["fd"])
        shutil.rmtree(room, ignore_errors=True)
    told = {
        "the exception left start_stray": raised,
        "the stray had said its pid": bool(held.get("pid")),
        "and had exited within half a second of start_stray letting the exception go": ended,
    }
    wrong = sorted(claim for claim, ok in told.items() if not ok)
    check("stray-ends-when-its-making-raises",
          "a stray start_stray is making when an exception reaches it, once the stray has said "
          "its pid, has exited within half a second of the exception leaving start_stray",
          not wrong, ", ".join(wrong) + (f"; {held}" if wrong else ""))
    return checked


@unit(('walks-find-a-process-orphaned-mid-walk',
       "a process orphaned while a walk reads the run's children files is found by the walk "
       "all the same, also when it is handed to a subreaper below the run: end_processes "
       "ends it rather than naming it as left, identity reads it and admit lets it be read, "
       "unrefused, and an undeclared table lists it"))
def _check_walks_find_a_process_orphaned_mid_walk(s):
    """Each reader that walks, while a real parent exits in the middle of its walk.

    Each reader runs in a run of its own, MID_WALK_FIXTURE: end_processes,
    which reads through run_processes, with the parent left a zombie; identity
    with it reaped; admit, which reads through _tree, with it left a zombie;
    the engine's table, narrowed through the same _tree as an undeclared
    unit's, with it reaped; and identity again with a subreaper between the
    run and the parent, so the sleeper is handed to that subreaper and not to
    the run. The fixture ends what it started; a sleeper of one that is still
    running after is ended here.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    room = Path(tempfile.mkdtemp(prefix=own("mw")))
    tool = str(Path(__file__).resolve())
    said, told = {}, {}
    try:
        for label, reader, parent_ends in (
                ("end_processes", "end_processes", "zombie"), ("identity", "identity", "reap"),
                ("admit", "admit", "zombie"), ("table", "table", "reap"),
                ("identity below a subreaper", "identity", "nested")):
            answer = room / f"{reader}-{parent_ends}"
            run = subprocess.run([sys.executable, "-B", "-c", MID_WALK_FIXTURE, tool, reader,
                                  parent_ends, str(answer)],
                                 stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                 timeout=120)
            try:
                said[label] = json.loads(answer.read_text())
            except (OSError, ValueError):
                said[label] = {"exit": run.returncode, "stderr": run.stderr.strip()[-300:]}
        ending = said["end_processes"]
        told["end_processes ends it rather than naming it as left"] = (
            ending.get("fired") is True and ending.get("ended") == [ending.get("sleeper")]
            and ending.get("left") == [] and ending.get("refused") == []
            and ending.get("refusals") == [])
        for label, claim in (("identity", "identity reads it, unrefused"),
                             ("admit", "admit lets it be read, unrefused"),
                             ("identity below a subreaper",
                              "identity reads it when it is handed to a subreaper below the run, "
                              "unrefused")):
            told[claim] = (said[label].get("fired") is True and said[label].get("read") is True
                           and said[label].get("refusals") == [])
        told["an undeclared table lists it"] = (
            said["table"].get("fired") is True and said["table"].get("read") is True)
    finally:
        end_left_behind([str(found.get("sleeper")) for found in said.values()
                         if found.get("sleeper")])
        shutil.rmtree(room, ignore_errors=True)
    wrong = sorted(claim for claim, ok in told.items() if not ok)
    check("walks-find-a-process-orphaned-mid-walk",
          "a process orphaned while a walk reads the run's children files is found by the walk "
          "all the same, also when it is handed to a subreaper below the run: end_processes "
          "ends it rather than naming it as left, identity reads it and admit lets it be read, "
          "unrefused, and an undeclared table lists it",
          not wrong, ", ".join(wrong) + (f"; {said}" if wrong else ""))
    return checked


@unit(('synthetic-tmux-allowlist-is-exact',
       'the suite-support allowlist names exactly the one fixture and the process fence'),
      ('synthetic-tmux-defined-once',
       'the synthetic tmux fixture is defined once'),
      ('synthetic-tmux-no-second-fixture',
       'no other class answers tmux commands'),
      ('synthetic-tmux-installed-one-way',
       "tmux is swapped only by the fixture's own installation method"),
      ('synthetic-tmux-cleanup-exemption-is-one-site',
       'exactly one hand-written swap is exempt, and it is the named cleanup'),
      ('synthetic-tmux-restores-after-a-raise',
       'a failure inside the fixture still puts the world back'))
def _check_synthetic_tmux_is_one_fixture(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    src_of = s.src_of
    tree = s.tree

    # The allowlist that exempts suite support code from the engine-only bans
    # is also the thing that would let a second fake tmux in, by being widened.
    # So its value is asserted here rather than trusted where it is used: the
    # exemption and the policy are separate statements, and this one has to be
    # edited on purpose, with this name in the diff.
    check("synthetic-tmux-allowlist-is-exact",
          "the suite-support allowlist names exactly the one fixture and the process fence",
          s.suite_classes == {"_FakeTmux", "_ProcessFence"}, repr(sorted(s.suite_classes)))

    fixtures = [n for n in ast.walk(tree)
                if isinstance(n, ast.ClassDef) and n.name == "_FakeTmux"]
    check("synthetic-tmux-defined-once",
          "the synthetic tmux fixture is defined once",
          len(fixtures) == 1,
          f"{len(fixtures)} at {[n.lineno for n in fixtures]}")

    # A tmux command vocabulary is what a second server fake needs in order to
    # answer at all, so two or more of these words in one class is the mark of
    # one whatever it calls itself. The allowlist exempts _FakeTmux from the
    # engine-only bans; anything else speaking this vocabulary is either a
    # rival fixture or production code that has drifted out of the engine.
    words = ("new-session", "has-session", "list-panes", "list-sessions",
             "split-window", "send-keys", "kill-server", "respawn-pane",
             "display-message", "select-pane", "new-window")

    def speaks_tmux(node):
        body = src_of(node) or ""
        return sum(f'"{word}"' in body for word in words) >= 2

    # The engine is the one class that is meant to speak this vocabulary: it
    # owns tmux, and the bans elsewhere exist to keep it that way. Taken from
    # the tree rather than written down, so renaming it cannot quietly open a
    # second exemption here.
    speakers = {"_FakeTmux", s.engine_node.name}
    rivals = sorted(node.name for node in tree.body
                    if isinstance(node, ast.ClassDef) and node.name not in speakers
                    and speaks_tmux(node))
    check("synthetic-tmux-no-second-fixture",
          "no other class answers tmux commands",
          not rivals, ", ".join(rivals))

    # Swapping the global by hand is what installed() replaces, and the half
    # that gets forgotten is the restore. A unit that raises with the real tmux
    # still swapped out hands the next unit a fake server, and in a sharded
    # tier that next unit belongs to somebody else's verdict.
    method = next((f for f in (fixtures[0].body if fixtures else [])
                   if isinstance(f, ast.FunctionDef) and f.name == "installed"), None)
    inside = set(range(method.lineno, method.end_lineno + 1)) if method else set()

    # This unit swaps tmux by hand too, in the finally that puts the world back
    # when the implementation it is testing is the broken thing. It is the one
    # caller that cannot delegate its restore to installed(). Exempting its
    # line range would excuse any swap anyone later added anywhere in it, so
    # the exemption is the exact statement instead: this pair of names, in this
    # order, assigned from these two saved values. Anything else in the same
    # function is still caught.
    def is_the_one_cleanup(node):
        if not (isinstance(node, ast.Assign) and len(node.targets) == 1
                and isinstance(node.targets[0], ast.Tuple)
                and isinstance(node.value, ast.Tuple)):
            return False
        swapped = [target.slice.value for target in node.targets[0].elts
                   if isinstance(target, ast.Subscript)
                   and isinstance(target.value, ast.Call)
                   and getattr(target.value.func, "id", "") == "globals"
                   and isinstance(target.slice, ast.Constant)]
        return (swapped == ["tmux", "RESOLVER"]
                and [getattr(value, "id", None) for value in node.value.elts]
                == ["was_tmux", "was_resolver"])

    own_check = next((node for node in tree.body
                      if isinstance(node, ast.FunctionDef)
                      and node.name == "_check_synthetic_tmux_is_one_fixture"), None)
    cleanups = [node for node in (ast.walk(own_check) if own_check else ())
                if is_the_one_cleanup(node)]
    inside |= {node.lineno for node in cleanups}
    check("synthetic-tmux-cleanup-exemption-is-one-site",
          "exactly one hand-written swap is exempt, and it is the named cleanup",
          len(cleanups) == 1, f"{len(cleanups)} matching statements")

    def swaps_tmux(node):
        if (isinstance(node, ast.Subscript) and isinstance(node.ctx, ast.Store)
                and isinstance(node.slice, ast.Constant) and node.slice.value == "tmux"):
            return isinstance(node.value, ast.Call) and getattr(node.value.func, "id", "") == "globals"
        # globals().update(tmux=...) reaches the same global by another spelling.
        return (isinstance(node, ast.Call)
                and isinstance(node.func, ast.Attribute) and node.func.attr == "update"
                and isinstance(node.func.value, ast.Call)
                and getattr(node.func.value.func, "id", "") == "globals"
                and any(kw.arg == "tmux" for kw in node.keywords))

    by_hand = sorted({node.lineno for node in ast.walk(tree)
                      if swaps_tmux(node)} - inside)
    check("synthetic-tmux-installed-one-way",
          "tmux is swapped only by the fixture's own installation method",
          method is not None and not by_hand,
          f"lines {by_hand}" if by_hand else "no installation method found")

    # The restoration worth proving is the one after a failure: the successful
    # path puts the world back in any arrangement of this code, including the
    # hand-written ones this replaced.
    was_tmux, was_resolver = globals()["tmux"], globals()["RESOLVER"]
    probe, eng = _FakeTmux(), Resolver(needs=Needs(maybe=set(NEED)))
    was_inputs = {name: getattr(eng, name) for name in _FakeTmux.ENGINE_INPUTS}
    swapped = False
    try:
        try:
            with probe.installed(eng):
                # Every one of the eight inputs the fixture installs is its own
                # while it is installed, so the comparison after the raise is
                # about inputs that really were replaced.
                swapped = (globals()["tmux"] is probe and globals()["RESOLVER"] is eng
                           and getattr(eng._process_table, "world", None) is probe
                           and all(getattr(eng, name) != was
                                   for name, was in was_inputs.items()))
                raise ZeroDivisionError("a unit failing part-way through its fixture")
        except ZeroDivisionError:
            pass
        restored = (globals()["tmux"] is was_tmux
                    and globals()["RESOLVER"] is was_resolver
                    and all(getattr(eng, name) == was for name, was in was_inputs.items()))
    finally:
        # This check is the one place that deliberately leaves a raise inside
        # the fixture, so it is also the one place that must not depend on the
        # fixture to clean up: when the implementation under test is the broken
        # thing, its restore is exactly what cannot be trusted. Put the globals
        # back here regardless, or a red verdict here hands every later unit a
        # fake tmux server and turns one failure into a tier of them.
        globals()["tmux"], globals()["RESOLVER"] = was_tmux, was_resolver
        for name, was in was_inputs.items():
            setattr(eng, name, was)
    check("synthetic-tmux-restores-after-a-raise",
          "a failure inside the fixture still puts the world back",
          swapped and restored,
          f"installed {swapped}, restored {restored}")
    return checked


@unit(('suite-region-is-derived',
       'the code this rule covers is derived from the call graph, not listed'),
      ('suite-never-invokes-real-tmux',
       'no suite code runs a tmux command, binary or server'),
      ('suite-never-delegates-socket-questions',
       'no suite code asks the process-wide engine about sockets'),
      ('suite-builds-socket-names-only',
       'the suite spells socket names with the prefix and does nothing else with it'))
def _check_suite_never_reaches_real_tmux(s):
    """Nothing the suite runs may reach the tmux on this machine.

    Every fixture is synthetic now, which is a fact about today's code rather
    than a property of it: one `tmux(...)` added to a unit brings the real
    server back, and it would pass, because a real tmux answers. So the ban
    is on the ways there are of reaching one.

    It bans invoking, not naming. A check about the tmux command vocabulary
    has to write the words down, `_FakeTmux` answers by naming
    every command it supports, and a fixture says which synthetic commands
    should fail by naming them. Banning the strings would hit all three and
    need an exemption each, and exemptions are what a rule like this dies of.
    Calling `tmux(...)`, running the binary, binding a socket and asking the
    process-wide engine for one are the four things that actually reach the
    machine, and none of them is something a synthetic fixture needs.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast_, tree = s.ast, s.tree
    tops = {node.name: node for node in tree.body
            if isinstance(node, (ast_.FunctionDef, ast_.ClassDef))}

    def named_in(node):
        found = set()
        for sub in ast_.walk(node):
            if isinstance(sub, ast_.Call):
                func = sub.func
                name = (func.id if isinstance(func, ast_.Name)
                        else func.attr if isinstance(func, ast_.Attribute) else None)
                if name in tops:
                    found.add(name)
            elif isinstance(sub, ast_.Name) and sub.id in tops:
                found.add(sub.id)
        return found

    def reached_from(seeds, without=()):
        seen, stack = set(), list(seeds)
        while stack:
            name = stack.pop()
            if name in seen or name not in tops or name in without:
                continue
            seen.add(name)
            stack.extend(named_in(tops[name]))
        return seen

    runner = {"run_selftest", "live_checks", "_suite_context", "_live_context"}
    units = {name for name, _ids, _run, _live in UNITS}
    # Production is what main does other than run the suite, so the closure
    # from main stops at the suite's entry point. What the suite reaches and
    # production does not is the region, derived rather than listed: a helper
    # added to the suite later is covered without anyone remembering, which is
    # the part a hand-kept list always gets wrong.
    production = reached_from(["main"], without={"run_selftest"})
    region = sorted(reached_from(units | runner) - production)

    # A derivation that quietly returned nothing would leave both bans below
    # passing over an empty region, which is the failure that looks most like
    # success. So the region states what it must contain and must not.
    holds = set(region)
    derived = {
        "it covers every registered unit": units <= holds,
        "and the runner and the suite's own helpers":
            {"run_selftest", "resume_run", "stop_fixture", "own", "started_here"}
            <= holds,
        "and the one synthetic fixture": "_FakeTmux" in holds,
        "it leaves production alone":
            not ({"tmux", "launch", "run_poison", "tint_pane", "main"} & holds),
    }
    wrong = sorted(name for name, ok in derived.items() if not ok)
    check("suite-region-is-derived",
          "the code this rule covers is derived from the call graph, not listed",
          not wrong, ", ".join(wrong) + f"; region of {len(region)}")

    SPAWNERS = {"run", "Popen", "call", "check_call", "check_output"}
    # Socket discovery and liveness, and the questions that put a command on a
    # server. Banned on RESOLVER, the process-wide engine: a fixture asks the
    # engine it attached itself to, and that one answers out of the fixture.
    DELEGATED = {"_swarm_sockets", "_socket_alive", "_socket_dir",
                 "_newest_live_socket", "_dead_sockets", "_list_panes",
                 "_attached_clients", "_swarm_session_live", "_tmux_server_fact"}

    def runs_the_binary(node):
        """A subprocess call that runs tmux."""
        func = node.func
        if not (isinstance(func, ast_.Attribute) and func.attr in SPAWNERS):
            return False
        first = node.args[0] if node.args else None
        if isinstance(first, (ast_.List, ast_.Tuple)) and first.elts:
            first = first.elts[0]
        return (isinstance(first, ast_.Constant) and isinstance(first.value, str)
                and (first.value == "tmux" or first.value.startswith("tmux ")))

    invoked, delegated = [], []
    for name in region:
        for node in ast_.walk(tops[name]):
            if not isinstance(node, ast_.Call):
                continue
            func = node.func
            if isinstance(func, ast_.Name) and func.id == "tmux":
                invoked.append(f"{name}:{node.lineno} calls tmux()")
            elif runs_the_binary(node):
                invoked.append(f"{name}:{node.lineno} runs the tmux binary")
            elif isinstance(func, ast_.Attribute) and func.attr in ("bind", "listen"):
                invoked.append(f"{name}:{node.lineno} {func.attr}s a socket")
            elif (isinstance(func, ast_.Attribute) and func.attr in DELEGATED
                  and isinstance(func.value, ast_.Name) and func.value.id == "RESOLVER"):
                delegated.append(f"{name}:{node.lineno} RESOLVER.{func.attr}()")

    check("suite-never-invokes-real-tmux",
          "no suite code runs a tmux command, binary or server",
          not invoked, "; ".join(sorted(invoked)))
    check("suite-never-delegates-socket-questions",
          "no suite code asks the process-wide engine about sockets",
          not delegated, "; ".join(sorted(delegated)))

    # SOCKET_PREFIX is the name of what a swarm socket is called, and the
    # suite builds synthetic socket names out of it. Banning it would buy
    # nothing but a second copy of the literal in the fixtures. What it may
    # not do is leave a string: handed to a path, a probe, a subprocess
    # argument or a server command, it stops naming a socket and starts
    # looking for one. So it is allowed exactly where it is spelled, inside
    # an f-string or a string concatenation, and nowhere else.
    spelt = []
    for name in region:
        parent = {}
        for outer in ast_.walk(tops[name]):
            for inner in ast_.iter_child_nodes(outer):
                parent[inner] = outer
        for node in ast_.walk(tops[name]):
            if not (isinstance(node, ast_.Name) and node.id == "SOCKET_PREFIX"):
                continue
            holder = parent.get(node)
            building = (isinstance(holder, ast_.FormattedValue)
                        or (isinstance(holder, ast_.BinOp)
                            and isinstance(holder.op, ast_.Add)))
            if not building:
                spelt.append(f"{name}:{node.lineno} in "
                             f"{type(holder).__name__ if holder else 'nothing'}")
    check("suite-builds-socket-names-only",
          "the suite spells socket names with the prefix and does nothing else with it",
          not spelt, "; ".join(sorted(spelt)))
    return checked


@unit(('tier-canary-is-listed-once',
       'each listing names the tmux canaries its run reports, once each, and no other'),
      ('tier-canary-listing-matches-the-row-it-reports',
       'the listed description is the string the executed row prints'),
      ('tier-canary-failure-names-its-row',
       'a check that shells out to tmux and swallows it fails under its own id'))
def _check_tier_canary_is_listed_and_reports(s):
    """A verdict nobody can look up beforehand is one a harness cannot key on.

    The tmux canary is the runner's own row rather than a unit's, so it does
    not arrive through the registry that --list walks, and it was missing from
    the listing while still being reported at the end. Anything that reads the
    listing to learn what a run can say would have found no such id, and then
    been handed one.

    So the listing and the verdict are asked for together here, and the
    description is compared as a string rather than assumed equal because both
    sides happen to read the same table today.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    def listed(live):
        said = io.StringIO()
        with capturing("out", into=said):
            run_selftest(live=live, list_only=True)
        found = {}
        for line in said.getvalue().splitlines():
            cid, _, rest = line.strip().partition("  ")
            found.setdefault(cid, []).append(rest.strip())
        return found

    # A read-only run reports its own canary only. A live run reports its own
    # and the read-only one, which arrives with the rest of the table the
    # child printed, so its listing names both, each once.
    read_only, live_listing = listed(False), listed(True)
    mine, theirs = TIER_TMUX[False][0], TIER_TMUX[True][0]
    once = {
        "the read-only listing names its own canary once":
            len(read_only.get(mine, ())) == 1,
        "and not the live one's, which a read-only run never reports":
            theirs not in read_only,
        "the live listing names its own canary once":
            len(live_listing.get(theirs, ())) == 1,
        "and the read-only one it inherits, once":
            len(live_listing.get(mine, ())) == 1,
    }
    wrong = sorted(name for name, ok in once.items() if not ok)
    check("tier-canary-is-listed-once",
          "each listing names the tmux canaries its run reports, once each, and no other",
          not wrong, ", ".join(wrong))

    # Both sides read TIER_TMUX today, so this cannot fail while that holds.
    # It is here because that is the property being relied on: a listing that
    # grew its own copy of the wording would still list the right id, and
    # anything keying on id plus description would stop finding the row.
    same = {
        "the read-only description is the one it reports":
            read_only.get(mine, [None])[0] == TIER_TMUX[False][1],
        "and the live one is too":
            live_listing.get(theirs, [None])[0] == TIER_TMUX[True][1],
    }
    wrong = sorted(name for name, ok in same.items() if not ok)
    check("tier-canary-listing-matches-the-row-it-reports",
          "the listed description is the string the executed row prints",
          not wrong,
          f"{read_only.get(mine)} vs {TIER_TMUX[False][1]!r}" if wrong else "")

    # A copy carrying one unit that runs a tmux and swallows the failure, which
    # is the case the canary exists for: nothing else in the run would notice.
    # Trimmed to that one unit so this costs a second rather than a tier.
    forced = Path(tempfile.mkdtemp(prefix=own(f"{TOOL}-selftest-forcedtmux")))
    source = Path(__file__).resolve()
    guard = '\n\nif __name__ == "__main__":'
    probe = (
        '\n\n@unit(("forced-tmux-probe", "a check that shells out to tmux"))'
        '\ndef _check_forced_tmux_probe(s):'
        '\n    with contextlib.suppress(Exception):'
        '\n        subprocess.run(["tmux", "-L", "forced", "list-panes"],'
        '\n                       capture_output=True)'
        '\n    return [("forced-tmux-probe", "a check that shells out to tmux", True, "")]'
        '\n\nUNITS[:] = [u for u in UNITS if u[0] == "_check_forced_tmux_probe"]' + guard)
    text = source.read_text()
    copied = forced / TOOL
    copied.write_text(text.replace(guard, probe, 1))
    copied.chmod(0o755)
    # The corpus preflight refuses without one beside the copy, and this is a
    # copy of the tool rather than a copy of the tree.
    (forced / "test").symlink_to(source.parent / "test")
    try:
        run = subprocess.run(
            [sys.executable, str(copied), "--selftest", "--failed"],
            capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=60,
            env=dict(os.environ, NO_COLOR="1"))
    finally:
        shutil.rmtree(forced, ignore_errors=True)

    rows = {}
    for line in run.stdout.splitlines():
        cid, _, rest = line.strip().partition("  ")
        rows.setdefault(cid, []).append(rest.strip())
    summary = next((line for line in run.stdout.splitlines()
                    if line.startswith("checks:")), "")
    said = rows.get(mine, [""])[0]
    forcing = {
        "the canary is the row that failed": mine in rows,
        "it printed under the description it is listed with":
            said.startswith(TIER_TMUX[False][1]),
        "it named the call that was made": "list-panes" in said,
        "the run counted it": "failed" in summary and not summary.endswith("0 failed"),
        "and the run exits nonzero": run.returncode != 0,
    }
    wrong = sorted(name for name, ok in forcing.items() if not ok)
    check("tier-canary-failure-names-its-row",
          "a check that shells out to tmux and swallows it fails under its own id",
          not wrong, ", ".join(wrong) + f"; summary {summary!r}, row {said[:90]!r}")
    return checked


@unit(('poisoned-path-catches-no-tmux',
       'a synthetic run executes no tmux, with a tmux on PATH that would say so'),
      ('poisoned-path-decoy-would-fire',
       'the decoy is what tmux resolves to and it does record a call'),
      ('synthetic-run-leaves-the-socket-directory-empty',
       'a synthetic run adds nothing to the run\'s socket directory'))
def _check_poisoned_path_catches_no_tmux(s):
    """Runtime evidence for what the source ban can only argue.

    The ban above reads calls. It cannot see a tmux reached through a
    variable, from a library, or by a subprocess of a subprocess, and those
    are exactly the ways something comes back after everyone has stopped
    looking. So the machine is arranged to make any of them visible: a
    directory holding one executable named tmux goes on the front of PATH,
    and it writes down what it was asked to do.

    The control matters as much as the measurement. A PATH that was not
    really poisoned, or a decoy that never recorded anything, gives a silent
    pass to a run that shelled out ten times. So the decoy is made to fire
    first, on purpose, and only then is the recording cleared and the real
    fixtures run.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    bin_dir = Path(tempfile.mkdtemp(prefix=own(f"{TOOL}-selftest-pathcanary")))
    marker = bin_dir / "asked"
    decoy = bin_dir / "tmux"
    decoy.write_text("#!/bin/sh\n"
                     f'printf "%s\\n" "$*" >> {marker}\n'
                     "exit 1\n")
    decoy.chmod(0o755)

    sockets = Path(os.environ["TMUX_TMPDIR"])
    before = set(sockets.glob("*"))
    was_path = os.environ.get("PATH", "")
    control, resolved = [], None
    try:
        os.environ["PATH"] = f"{bin_dir}{os.pathsep}{was_path}"
        resolved = shutil.which("tmux")
        # Fire it deliberately, so an empty recording afterwards is evidence
        # rather than an absence of wiring. Run by the path the lookup
        # returned rather than by the name: what the name resolves to is what
        # the line above establishes, and what this adds is that running the
        # thing it resolves to gets written down. Naming tmux as a program to
        # execute is the one move the suite is banned from making, and the ban
        # is worth more here than the shorter spelling.
        if resolved:
            subprocess.run([resolved, "-V"], capture_output=True)
        control = marker.read_text().splitlines() if marker.exists() else []
        marker.unlink(missing_ok=True)

        # The synthetic paths that would reach a server if a fixture ever fell
        # through: a whole resume, and a verb about server state and nothing
        # else.
        resume_run("willow@session-corpus-alpha", listed=False)
        engine = Resolver(needs=Needs(maybe=set(NEED)))
        server = _FakeTmux(sockets=["claude-swarm-pathcanary"])
        with server.installed(engine), capturing("out"):
            run_poison(types.SimpleNamespace(
                socket="claude-swarm-pathcanary", poison=True, dry_run=False))
    finally:
        os.environ["PATH"] = was_path
        asked = marker.read_text().splitlines() if marker.exists() else []
        shutil.rmtree(bin_dir, ignore_errors=True)
    after = set(sockets.glob("*"))

    check("poisoned-path-decoy-would-fire",
          "the decoy is what tmux resolves to and it does record a call",
          resolved == str(decoy) and control == ["-V"],
          f"resolved to {resolved}, recorded {control}")
    check("poisoned-path-catches-no-tmux",
          "a synthetic run executes no tmux, with a tmux on PATH that would say so",
          not asked, f"{len(asked)} call(s): {asked[:3]}")
    check("synthetic-run-leaves-the-socket-directory-empty",
          "a synthetic run adds nothing to the run's socket directory",
          after == before,
          f"appeared: {sorted(p.name for p in after - before)}")
    return checked


@unit(('selftest-without-corpus-refuses-before-units',
       'a suite with no corpus beside it says so once and runs nothing'))
def _check_selftest_without_corpus_refuses(s):
    """The preflight in the runner, proved from outside.

    A copy of the tool with no test/corpus beside it is the whole fixture:
    the corpus is resolved from __file__, so a copy somewhere else has none.
    What is asked of it is what an operator would see. One sentence naming
    the directory, a nonzero exit, and no tally, because a partial count is
    the thing that gets read as a result and pasted into a report.

    Its own session and a timeout, so a copy that hangs instead of refusing
    is ended along with anything it started rather than holding the tier.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    elsewhere = Path(tempfile.mkdtemp(prefix=own(f"{TOOL}-selftest-nocorpus")))
    copied = elsewhere / TOOL
    shutil.copy2(Path(__file__).resolve(), copied)
    try:
        run = start_copy_run([sys.executable, str(copied), "--selftest", "--failed"],
                             dict(os.environ, NO_COLOR="1"))
        # 60s, and it has to stay below whatever bound the harness running
        # this suite gives the suite as a whole. If the outer bound ends this
        # process first, the copy and anything it started are still under the
        # run, which ends them, or under whatever adopted the run's orphans.
        with owned_group(run) as stop:
            finished = collected(run, 60, stop)
        out, err, code = finished.stdout, finished.stderr, finished.returncode
        timed_out = code is None
    finally:
        shutil.rmtree(elsewhere, ignore_errors=True)

    said = [line for line in err.splitlines() if line.strip()]
    # warn() wraps one message over several lines with a continuation marker,
    # so what gets counted is messages: a line carrying the marker is the rest
    # of the one above it, not a second complaint.
    messages = [line for line in said if WRAP_ARROW not in line]
    flat = " ".join(without_wrap_arrows(err).split())
    refusing = {
        # Stated apart from the exit code, so a copy that hung is reported as
        # having hung rather than as having exited with something odd.
        "it answers rather than hanging": not timed_out,
        "it exits nonzero": code not in (0, None),
        "it complains exactly once": len(messages) == 1,
        "it says the corpus is missing and names where it looked":
            "no selftest corpus at" in flat
            and str(elsewhere / "test" / "corpus") in flat,
        "it counts nothing": "checks:" not in out,
        "it runs no unit": " ok, " not in out,
    }
    wrong = sorted(name for name, ok in refusing.items() if not ok)
    check("selftest-without-corpus-refuses-before-units",
          "a suite with no corpus beside it says so once and runs nothing",
          not wrong, ", ".join(wrong)
          + f"; exit {code}, timed out {timed_out}, said {said[:2]}")
    return checked


@unit(('fixture-leaves-no-socket-file',
       'a fixture creates no socket node, and none survives a run that raises'))
def _check_fixture_leaves_no_socket_file(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # This used to prove a fixture cleaned up the socket file it had bound.
    # No fixture binds one any more: _FakeTmux answers discovery and liveness,
    # so the stronger claim is available and it is the one asked here. A node
    # that is never created cannot be left behind by a run that dies.
    # The directory this run pointed tmux at, read from the environment the
    # runner set rather than from the engine. Asking the engine would put a
    # production discovery call inside a test measuring what the tests leave
    # behind, and the two would agree even if the engine started answering
    # with the machine's directory again.
    where = Path(os.environ["TMUX_TMPDIR"])
    before = set(where.glob("*")) if where.exists() else set()

    resume_run("willow@session-corpus-alpha", listed=False)
    settled = set(where.glob("*")) if where.exists() else set()

    def boom(_action):
        raise ZeroDivisionError("a check failing part-way through a fixture")

    # The raise is answered inside the run rather than reaching here, so what
    # is asked of it is the same question, not whether it propagated.
    with contextlib.suppress(ZeroDivisionError):
        resume_run("echo@session-corpus-alpha", listed=False,
                   observe_launch_action=boom)
    after = set(where.glob("*")) if where.exists() else set()

    # Structural, because the runtime half only speaks for the fixtures that
    # happen to run here. Binding is what would put a node on the machine, so
    # the suite is not allowed to reach for it at all. Production keeps its own
    # AF_UNIX probe in _socket_alive, which connects and never binds.
    ast_, tree = s.ast, s.tree
    selftest_lines = s.selftest_lines
    binding = sorted({node.lineno for node in ast_.walk(tree)
                      if isinstance(node, ast_.Call)
                      and isinstance(node.func, ast_.Attribute)
                      and node.func.attr in ("bind", "listen")
                      and node.lineno in selftest_lines})

    facts = {
        "a run that finishes leaves no socket node": settled == before,
        "a run that breaks part-way leaves none either": after == before,
        "the suite never binds a socket": not binding,
    }
    wrong = sorted(name for name, ok in facts.items() if not ok)
    check("fixture-leaves-no-socket-file",
          "a fixture creates no socket node, and none survives a run that raises",
          not wrong,
          "; ".join(wrong + [f"appeared {sorted(p.name for p in after - before)}, "
                             f"binds at {binding}"]) if wrong else "")
    return checked


@unit(('suite-helpers-defined-once',
       'each shared suite helper is defined exactly once'),
      ('suite-helpers-are-not-published',
       'no shared helper is handed between units through the context object'))
def _check_suite_helpers_have_no_hidden_order(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast_, tree = s.ast, s.tree
    # Shared fixtures live at module level and are called directly. Reached
    # through the context object instead, a helper only exists once whichever
    # unit happens to build it has run, so the suite acquires an order it never
    # states and a unit registered earlier dies on an attribute that is not
    # there yet. That is what both hoists removed.
    helpers = {"resume_run": ast_.FunctionDef, "_FakeTmux": ast_.ClassDef}
    counts = {name: sum(1 for node in ast_.walk(tree)
                        if isinstance(node, kind) and node.name == name)
              for name, kind in helpers.items()}
    astray = sorted(f"{name} defined {n} times" for name, n in counts.items() if n != 1)
    check("suite-helpers-defined-once",
          "each shared suite helper is defined exactly once",
          not astray, "; ".join(astray))

    published = sorted({f"s.{node.attr} at line {node.lineno}"
                        for node in ast_.walk(tree)
                        if isinstance(node, ast_.Attribute)
                        and isinstance(node.value, ast_.Name) and node.value.id == "s"
                        and node.attr in helpers})
    check("suite-helpers-are-not-published",
          "no shared helper is handed between units through the context object",
          not published, "; ".join(published))
    return checked


