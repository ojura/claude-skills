                caught = exc
        # Later Resolver reads are permitted, including after a refused applier.
        after = _retained_transcript_answers(eng, path, (), census)
        cold = _retained_transcript_answers(_roster_cold_engine(f), path, (), census)
        okay = (caught is None and events == ['installed', 'refresh'] and not forbidden_reads
                and before['stamps'] == old_stamps and before['assignments']['records'] == old_assignments
                and {team: answer['member_order'] for team, answer in before['members'].items()} == old_orders
