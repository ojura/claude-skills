def _conversion_test_plan(f, kind):
    """Build promotion, inverse demotion, or fresh demotion from synthetic bytes."""
    f.transcript("parent", "team-lead", "B")
    f.config("B", {"name": "B", "leadAgentId": "team-lead@B", "leadSessionId": "parent",
                   "members": [{"name": "team-lead", "agentId": "team-lead@B"}]})
    eng = f.engine
    if kind == "generated-meta":
        f.transcript("born", "fresh", "B", (
            {"type": "last-prompt", "leafUuid": "born-root", "sessionId": "born"},))
        return eng.demotion_plan("born", into="parent", force=True)
    source = f.project / "parent" / "subagents" / "agent-side.jsonl"
    source.parent.mkdir(parents=True)
    source.write_text(fixture_line({
        "parentUuid": None, "isSidechain": True, "sessionId": "parent", "agentId": "side",
        "type": "user", "uuid": "promoted-root", "message": {"role": "user", "content": "fixture"},
    }) + "\n")
    source.chmod(0o640)
    meta = source.with_name("agent-side.meta.json")
    meta.write_bytes(b'{"agentType":"worker","name":"converted"}')
    meta.chmod(0o604)
    plan = eng.promotion_plan("side", as_agent="converted@B", force=True)
    if kind == "promote":
        return plan
    selected = plan["conversion"]
    if selected is None:
        raise ValueError(f"fixture promotion returned no conversion: {plan['objections']}")
    try:
        materialize(plan)
    except (Refusal, OSError, AttributeError, KeyError, TypeError, ValueError) as exc:
        raise ValueError(f"fixture promotion: {type(exc).__name__}: {exc}") from exc
    return eng.demotion_plan(selected["dest_path"].stem, force=True)


