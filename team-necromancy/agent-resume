class NEED(enum.Enum):
    """The corpus-scale computes a run may ask the engine for, by name.

    Declared to the constructor, never passed to a method: a verb states up
    front what it consumes, the engine refuses to compute anything else, and
    the end-of-run audit refuses a declaration a smaller set would have
    satisfied. The default is nothing, so every caller must say what it needs.
    The values are the plain words the refusal prints.
    """
    PROCS = "the process table and normalized runtime"
    REGISTRY = "the session registry"
    SEATS = "live tmux process placement"
    STAMPS = "transcript identity stamps"
    SPAWNS = "the spawn payload corpus"
    SIDES = "side transcript classification"
    MAIL = "the send-vs-delivery mail join"
    TITLES = "transcript titles"
    CONVERSION_CENSUS = "the promoted-member conversion receipt corpus"
    PLACEMENT = "launch team placement"


class DECLARED(enum.Enum):
    """How firmly a verb declared one need. Absence is an answer, not a gap."""
    HARD = "declared"            # always computed; unexercised is a fault
    MAYBE = "declared if used"   # a runtime branch decides; unexercised is fine
    ABSENT = "not declared"      # computing it at all is a fault


class Needs:
    """What one verb may compute, and how firmly it said so.

    A declaration is two buckets rather than a bag of mixed elements, so an
    author writing one has to place every need in exactly one of them. The
    conditional bucket is for a runtime branch (liveness, corpus content)
    deciding, never for an author who has not worked out what the input
    implies; each entry carries a comment naming what decides it.

    Asking is one operation, needs[X], which distinguishes all three states.
    A wrapper object could not: it carried no equality, so membership tests
    answered no both for a conditional declaration and for none at all, and
    a check written that way passed with its subject deleted.
    """

    def __init__(self, hard=(), maybe=()):
        self._hard = frozenset(hard)
        self._maybe = frozenset(maybe) - self._hard   # hard wins; nothing is both

    def __getitem__(self, need):
        if need in self._hard:
            return DECLARED.HARD
        if need in self._maybe:
            return DECLARED.MAYBE
        return DECLARED.ABSENT

    @property
    def hard(self):
        """The needs that make a declaration fat when a run leaves them unused."""
        return self._hard

    @property
    def reachable(self):
        """Every need this run may compute, however firmly declared."""
        return self._hard | self._maybe

    def __eq__(self, other):
        return (isinstance(other, Needs)
                and (self._hard, self._maybe) == (other._hard, other._maybe))

    def __hash__(self):
        return hash((self._hard, self._maybe))

    def __repr__(self):
        return (f"Needs(hard={sorted(n.name for n in self._hard)}, "
                f"maybe={sorted(n.name for n in self._maybe)})")


# What a team directory holds that this tool or the harness wrote. One list,
# because two questions are asked of it and they must not drift: the sweep asks
# whether a directory holds anything else before removing it, and the reap asks
# which entries it may delete. A reap that recognised a name the sweep does not
# would delete a file the sweep was written to spare.
SCAFFOLDING = frozenset({
    "config.json",
    "inboxes",              # holding .json mailboxes and nothing else
    f"config.json.bak-{TOOL}",
    f"config.json.tmp-{TOOL}",
    "config.json.lock",
})


class Cache:
    """One of the engine's held answers, and its own entry in the list of them.

    The fence that keeps callers out of the engine's storage needs to know what
    that storage is called. Declaring a cache is what registers it here, so the
    list of names is the set of caches themselves and says exactly what the
    class holds.

    `empty` is what the cache holds before anything fills it, called per engine
    when it is a factory, so two engines never share one dict.
    """

    registry = {}

    def __init__(self, sources, empty=None):
        self.sources = frozenset(sources)
        self.empty = empty

    def __set_name__(self, owner, name):
        self.name, self.slot = name, f"__cache_{name}"
        Cache.registry[name] = self

    def __get__(self, engine, owner=None):
        if engine is None:
            return self
        if self.slot not in engine.__dict__:
            engine.__dict__[self.slot] = self.empty() if callable(self.empty) else self.empty
        return engine.__dict__[self.slot]

    def __set__(self, engine, value):
        engine.__dict__[self.slot] = value


class Resolver:
    """Own evidence reads, cache lifetime, and structured resolution answers.

    Each source has one lazy loader, making the complete evidence set enumerable.
    Cache descriptors state when retained evidence expires. Launch, tmux,
    roster, and cleanup actions consume Resolver answers through functions such
    as `roster_record`.

    `needs` declares corpus-scale computations at construction. Loaders accept
    declared work, and `audit_needs` requires every hard declaration to be used.
    Conditional work belongs in the Maybe bucket.
    """

    @dataclasses.dataclass(frozen=True)
    class RosterSnapshot:
        """Own a complete roster interpretation without reading its path again."""

        observation: object
        data: Mapping
        parse_problem: object = None
        preview_path: object = None
        _generation: tuple = dataclasses.field(init=False, repr=False)

        def __post_init__(self):
            if not isinstance(self.data, Mapping):
                raise TypeError("roster data must be an object")
            if self.parse_problem is not None and type(self.parse_problem) is not str:
                raise TypeError("roster parse problem must be a string or None")
            owned = immutable(json_value(self.data, strict=True))
            object.__setattr__(self, "data", owned)
            if self.observation is None:
                if type(self.preview_path) is not type(Path()) or self.parse_problem is not None:
                    raise ValueError("a roster preview needs a path and valid config data")
                generation = ("preview", owned)
            else:
                if type(self.observation) is not FileObservation or self.preview_path is not None:
                    raise TypeError("a physical roster needs one file observation")
                generation = self.observation.generation
                if not self.observation.physical and generation != ("absent",):
                    raise ValueError("an unstable file observation cannot become a roster")
                if generation == ("absent",) and (owned or self.parse_problem is not None):
                    raise ValueError("an absent roster has no parsed data or parse problem")
                if self.parse_problem is not None and owned:
                    raise ValueError("an invalid roster has no parsed data")
            object.__setattr__(self, "_generation", generation)

        @classmethod
        def preview(cls, path, data):
            return cls(None, data, preview_path=path)

        @property
        def path(self):
            return self.observation.path if self.observation is not None else self.preview_path

        @property
        def generation(self):
            return self._generation

        @property
        def state(self):
            if self.generation == ("absent",):
                return "absent"
            return "invalid" if self.parse_problem is not None else "valid"

        @property
        def team(self):
            return (self.data.get("name") or self.path.parent.name
                    if self.state == "valid" else self.path.parent.name)

        @property
        def problem(self):
            return "config.json is absent" if self.state == "absent" else self.parse_problem

        @property
        def raw(self):
            return self.observation.raw if self.observation is not None else None

        @property
        def mode(self):
            return self.observation.mode if self.observation is not None else None

        @property
        def mtime(self):
            return self.observation.mtime if self.observation is not None else 0

    # The descriptor registry also supplies cache ownership and invalidation.
    _procs = Cache({"process"})
    _stamps = Cache({"transcript"})
    _carried = Cache({"transcript"})
    _carried_scope = Cache({"transcript"})
    _receipts = Cache({"transcript"}, dict)
    _spawns = Cache({"transcript"}, dict)
    _spawn_log = Cache({"transcript"}, dict)
    _by_agent = Cache({"transcript"})
    _by_team = Cache({"transcript"})
    _seat_table = Cache({"process"})
    _seats = Cache({"process"})
    _runtime_table = Cache({"process", "transcript"})
    _runtime_snapshot = Cache({"process", "transcript"})
    _team_assignments = Cache({"transcript"})
    _team_member_answers = Cache({"process", "transcript"}, dict)
    _team_descriptions = Cache({"process", "transcript"}, dict)
    _registry = Cache({"process"})
    _transcript_facts = Cache({"transcript"}, dict)
    _transcript_snapshots = Cache({"transcript"}, dict)
    _copied_prefixes = Cache({"transcript"}, dict)
    _operating_answers = Cache({"process", "transcript"}, dict)
    _terminal = Cache(set())
    _boot_time = Cache(set())

    def __init__(self, needs=None):
        self._needs = needs if needs is not None else Needs()
        self._exercised = set()
        self._teams_dir = TEAMS_DIR   # overridable so a test resolver can read a synthetic tree
        self._projects_dir = PROJECTS_DIR  # same, for the transcript tree
        self._rewriter = TranscriptRewriter()

    def _exercise(self, need):
        """Record one declared compute happening, or refuse an undeclared one."""
        if self._needs[need] is DECLARED.ABSENT:
            raise RuntimeError(
                f"this run declared no need for {need.value}; the engine "
                f"computes only what its constructor was told, so declare "
                f"NEED.{need.name} where the verb states its needs, in the "
                f"maybe bucket if only some runs of that verb reach it")
        self._exercised.add(need)

    def _audit_needs(self):
        """Require every hard computation declaration to be exercised.

        The verb calls this explicitly because Python discards exceptions raised
        by `__del__`. Conditional declarations may remain unused. The error lists
        declared and computed work so the caller can classify each path from the
        code.
        """
        fat = self._needs.hard - self._exercised
        if fat:
            named = ", ".join(sorted(n.name for n in fat))
            computed = ", ".join(sorted(n.name for n in self._exercised)) or "nothing"
            raise RuntimeError(
                f"declared and never computed: {named}; this run computed "
                f"{computed}. Read this verb's paths, work out which of them "
                f"reach {named}, and declare what they do.")

    def audit_answer(self):
        """Return the complete declaration-use audit for this Resolver."""
        missing = frozenset(self._needs.hard - self._exercised)
        unexpected = frozenset(
            need for need in self._exercised
            if self._needs[need] is DECLARED.ABSENT)
        return immutable({
            "declared": tuple(sorted(need.name for need in self._needs.hard)),
            "exercised": tuple(sorted(need.name for need in self._exercised)),
            "missing": tuple(sorted(need.name for need in missing)),
            "unexpected": tuple(sorted(need.name for need in unexpected)),
            "result": "ok" if not missing and not unexpected else "invalid",
        })

    def _invalidate(self, source):
        """Discard owned cache slots without reading or changing retained answers."""
        for descriptor in Cache.registry.values():
            if source in descriptor.sources:
                self.__dict__.pop(descriptor.slot, None)

    def refresh_transcript_evidence(self):
        """Discard discovery evidence after this command attempts transcript changes."""
        self._invalidate("transcript")

    def _grep_files(self, needle, scope, recursive):
        """Files containing this literal."""
        result = self._search("files", needle, scope, recursive)
        if result.returncode > 1:
            warn(f"search failed ({result.stderr.strip() or 'unknown'}); falling back to a full scan")
            return None
        return [Path(p) for p in result.stdout.splitlines() if p]

    def _search(self, kind, needle, paths, recursive):
        """Run a literal search with command-owned options.

        Removing RIPGREP_CONFIG_PATH keeps user options such as
        `--max-filesize=1` and `--max-depth=0` from narrowing the transcript
        corpus. The grep fallback uses the same explicit search bounds.
        """
        env = {name: value for name, value in os.environ.items()
               if name != "RIPGREP_CONFIG_PATH"}
        return subprocess.run(self._searcher(kind, needle, paths, recursive),
                              capture_output=True, text=True, env=env)

    def _searcher(self, kind, needle, paths, recursive):
        """Build literal-search argv, preferring ripgrep for parallel traversal."""
        files = [str(p) for p in paths]
        # subagents/ holds sidechain transcripts, which are never evidence
        # candidates, so a recursive sweep does not descend into them.
        if shutil.which("rg"):
            argv = ["rg", "--no-ignore", "-F", needle]
            argv += ["-l"] if kind == "files" else ["-N", "-H"]
            if recursive:
                argv += ["--glob", "*.jsonl", "--glob", "!**/subagents/**"]
            return argv + files
        argv = ["grep", "-F", needle, "-l" if kind == "files" else "-H"]
        if recursive:
            argv += ["-r", "--include=*.jsonl", "--exclude-dir=subagents"]
        return argv + files

    def _stamped_candidates(self, name, team=None, verify=True):
        """Return the newest transcripts with current lines that carry these stamps.

        The shared stamp index performs bounded end reads. Verification parses
        candidates because a rebound transcript can mention several teams.
        `verify=False` returns the indexed paths. An empty index result triggers a
        whole-file literal search to cover stamps located only in mid-history.
        """
        self._exercise(NEED.STAMPS)  # the grep fallback is stamps work too
        files = [p for p, (n, t) in self._stamp_index().items() if n == name and (not team or t == team)]

        if not verify:
            # The index is cached for the process, so a file may be gone by now.
            stamped = []
            for path in files:
                try:
                    stamped.append((path, {}, int(path.stat().st_mtime * 1000)))
                except OSError:
                    continue
            stamped.sort(key=lambda item: item[2], reverse=True)
            return stamped

        def confirm(paths):
            out = []
            for path in paths:
                fields, last_ts = self._scan_transcript(path)
                if fields.get("agentName", (None,))[0] != name:
                    continue
                if team and fields.get("teamName", (None,))[0] != team:
                    continue
                out.append((path, fields, last_ts))
            out.sort(key=lambda item: item[2], reverse=True)
            return out

        found = confirm(files)
        if not found:
            # The index can both miss (stamps only mid-history) and mislead (a stamp
            # quoted inside message content). Either way the answer is not yet "no",
            # so re-ask over whole files before saying so.
            deep = self._grep_files('"agentName"', [self._projects_dir], True)
            if deep is None:  # grep unavailable
                deep = sorted(self._projects_dir.glob("*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
            elif team and deep:
                deep = self._grep_files('"teamName"', deep, False) or []
            seen = set(files)
            found = confirm(p for p in deep if p not in seen)
        return found

    def _ingest_spawn_lines(self, paths):
        """Parse the spawn payloads out of these transcripts into the caches.

        grep pulls out the handful of matching lines; only those are parsed. A
        payload is taken from the parsed structure, never from raw bytes, so a
        transcript that merely discusses spawning cannot contribute a quoted
        example as if it were real.
        """
        self._exercise(NEED.SPAWNS)
        paths = [p for p in paths if p and p.stem not in self._spawns]
        for path in paths:
            self._spawns[path.stem], self._spawn_log[path.stem] = {}, []
        if not paths:
            return
        result = self._search("lines", SPAWN_MARKER, paths, False)
        if result.returncode > 1:
            warn(f"search failed reading spawn records ({result.stderr.strip() or 'unknown'})")
            return
        for line in result.stdout.splitlines():
            where, _, text = line.partition(":")
            stem = Path(where).stem
            if stem not in self._spawns:
                continue
            try:
                record = json.loads(text)
            except ValueError:
                continue
            # A sidechain line belongs to a subagent. A materialized promotion
            # prefix belongs to the parent conversation. Both remain context, but
            # neither is an action authored by this transcript.
            if record.get("isSidechain") or not self._authored_here(Path(where), record):
                continue
            payload = _spawn_event(record)
            if payload is None:
                continue
            stamp = iso_ms(record.get("timestamp"))
            self._spawns[stem][payload["name"]] = payload  # last spawn of a name wins
            self._spawn_log[stem].append((stamp, payload))

    def _session_names_team(self, session_id, team):
        """Does this session id name this team?

        True when the team is an implicit one, named session-<eight hex> after
        a session, and this id opens with those eight hex. A team named by a
        --team-name flag is named after no session, so it answers False for
        every id.

        The one place a session is matched to a team name. A caller holding a
        registry entry, a transcript stem or a candidate path asks here instead
        of taking the name apart and comparing prefixes for itself, because
        eight hex is not a session id: a match narrows the field and settles
        nothing, and that is one judgement, not four.
        """
        block = implicit_team_block(team)
        return bool(block and str(session_id or "").startswith(block))

    def _sessions_naming(self, team):
        """Every transcript with a session id that names this team, newest first.

        More than one is an ordinary answer, since eight hex is not a session
        id, and all of them come back: which of several conversations to
        believe is the caller's judgement and it needs to see that there were
        several.

        transcripts_starting narrows the tree to the block and
        session_names_team decides, so the match is made in one place.
        """
        block = implicit_team_block(team)
        if not block:
            return []
        return sorted((path for path in self._transcripts_starting(block)
                       if self._session_names_team(path.stem, team)),
                      key=lambda path: path.stat().st_mtime, reverse=True)

    def _registry_entries_naming(self, team, snapshot):
        """Every session registry entry with a session id that names this team.

        The registry is read only for an implicit team's name, which a session
        id gives: a flag-named team is nobody's session id, so there is nothing
        in there to find and the whole of ~/.claude/sessions is left unparsed.
        The caller supplies the runtime snapshot so one resolution cannot mix
        observations.
        """
        if not implicit_team_block(team):
            return []
        return [row for row in snapshot["registry"]
                if self._session_names_team(row.get("session"), team)]

    def _lead_process(self, snapshot, parent_session=None, team=None, census=None):
        """Return structured process evidence for a team lead.

        `agent_runtime` exposes this private process read to public callers.
        The lead is first the process holding the lead's conversation: the
        parent session, or the transcript that named an implicit team at its
        fresh boot. Then a process launched as the team's lead, then a plain
        process that operates as the team (operating_team), and last the
        process holding the conversation with spawn payloads that claim the
        team. That conversation may have spawned into the team in an earlier
        life, so the last rung says so and is exact only when the claim is
        corroborated. Which team the lead process operates as now is a separate
        answer. Socket resolution and credential inheritance both consume this
        answer.
        """
        def process(pid=None, alive=False, how=None, detail=None, exact=False, kind=None):
            return {"pid": pid, "alive": alive, "how": how, "detail": detail,
                    "exact": exact, "kind": kind}

        if parent_session:
            entry = snapshot["best_by_session"].get(parent_session)
            if entry:
                pid, alive = entry["pid"], entry["alive"]
                return process(
                    pid, alive, f"lead pid {pid}" + ("" if alive else " (dead)"),
                    f"session {parent_session}", True, "session",
                )
        if team:
            # A fresh lead shares its internal and transcript IDs, giving its
            # implicit team an exact registry join. The measured corpus contains
            # this relation in 16 of 37 team directories. A later process on the
            # same transcript keeps that registry session but creates a team of
            # its own, so a process that operates as another team is skipped.
            for data in self._registry_entries_naming(team, snapshot):
                if data["alive"]:
                    elsewhere = self._operating_team(data["pid"], snapshot, census)["team"]
                    if elsewhere and elsewhere != team:
                        continue
                    return process(
                        data["pid"], True,
                        f"pid {data['pid']} runs the session team {team} is named after",
                        f"runs the session team {team} is named after", True, "session-team",
                    )
            # A flag-bound lead advertises exact identity in argv. The session
            # registry contains plain launches, so argv supplies this process row.
            masquerade = next((e for e in snapshot["live_sessions"]
                               if e["alive"] and e["agent_id"] == agent_id_of("team-lead", team)), None)
            if masquerade:
                return process(
                    masquerade["pid"], True,
                    f"pid {masquerade['pid']} was launched as {masquerade['agent_id']}",
                    f"was launched as {masquerade['agent_id']}", True, "argv",
                )
            # A plain process leads a team it operates as. The ones asked are
            # those that spawned into it since they started, and those that
            # started within TEAM_MINT_WINDOW_MS after it was created, and the
            # answer itself decides; a plain process that only the stamps on the
            # first record of its restored window put on the team is not looked
            # for here.
            paired = {owner for named, owner, _ in self._boot_join(snapshot, census)
                      if named == team}
            operating = []
            for entry in snapshot["live_sessions"]:
                if not entry["alive"] or entry["agent_id"]:
                    continue
                start_ms = self._process_start_ms(entry)
                spawned_since = bool(entry["session"] and start_ms and any(
                    payload.get("team_name") == team and stamp and stamp >= start_ms
                    for stamp, payload in self._log(entry["session"])))
                if entry["pid"] in paired or spawned_since:
                    answer = self._operating_team(entry["pid"], snapshot, census)
                    if answer["team"] == team:
                        operating.append((answer["exact"], entry["updated"], entry["pid"], answer))
            if operating:
                exact, _updated, pid, answer = max(operating, key=lambda row: row[:3])
                # Why this pid was picked, in words that name no team: what it
                # runs as is the separate runs_as answer, and a report prints both.
                why = {"written": "has written transcript records stamped with this team, "
                                  "or spawned a teammate into it, since it started",
                       "paired": f"is the only process that started within "
                                 f"{TEAM_MINT_WINDOW_MS // 1000} s after this team was created",
                       }.get(answer["rule"], "resumed a conversation, and the teamName in the "
                                             "first record of its restored window is this team")
                return process(pid, True, f"pid {pid} {why}", why, exact, "operates")
            path, claim = self._lead_transcript_for(
                team, table=snapshot["table"], census=census)
            holder = snapshot["best_by_session"].get(path.stem) if path else None
            if holder and holder["alive"]:
                return process(
                    holder["pid"], True,
                    f"pid {holder['pid']} runs the conversation that spawned teammates "
                    f"into team {team}",
                    f"runs the conversation that spawned teammates into team {team}",
                    claim.get("basis") is not None, "conversation",
                )
        return process()

    @staticmethod
    def _lead_claim(kind, why, basis=None, **facts):
        """Build the one record of how a lead transcript was chosen for a team.

        `kind` names the rung that chose it and `why` says so in words. `basis`
        is what `lead_corroboration` found tying that transcript to the team, or
        None when nothing did. Every rung that chooses a lead for a team returns
        this record as its evidence: the live lead process, roster
        `leadSessionId` and the spawn-payload claims in resolve_transcript, and
        the durable assignment team_members uses for a listed lead. A reader
        never has to know which of them answered. A session uuid names a
        transcript, not a team, so that rung carries none.
        """
        return {"kind": kind, "why": why, "basis": basis, **facts}

    @classmethod
    def _judged_lead_claim(cls, kind, chosen_by, basis):
        """The claim for a transcript `chosen_by` picked, once `basis` is known.

        The rungs that pick a transcript and then ask lead_corroboration about
        it all report the answer in this one phrase.
        """
        return cls._lead_claim(
            kind, f"{chosen_by}, corroborated by {basis}" if basis
            else f"{chosen_by}, uncorroborated", basis)

    def _lead_corroboration(self, team, path, table=None, census=None):
        """Name the evidence besides spawn payloads that this transcript leads team.

        The evidence is a live process holding it that was launched as the
        team's lead or that operates as the team (operating_team), roster
        `leadSessionId`, member names shared by roster and spawn records, live
        spawned members, or the implicit team-name prefix. Returns the first that
        holds, or None. Choosing among claimants and deciding what a rebuilt
        roster may record both ask here, so the two cannot disagree.

        A populated leadSessionId counts as evidence. Reconstructed rosters leave
        it empty for an uncorroborated lead, so spawn records never corroborate
        themselves through a roster derived from those records.
        """
        rosters = [e for e in self._roster_entries(team=team, census=census)
                   if e.get("leadSessionId")]
        snapshot = self._runtime(table)
        holders = [row for row in ((snapshot.get("transcripts") or {}).get(path.stem)
                                   or {}).get("processes", ()) if row["alive"]]
        if any(row["agent_id"] == agent_id_of("team-lead", team) for row in holders):
            return f"live process launched as {agent_id_of('team-lead', team)}"
        if any(self._operating_team(row["pid"], snapshot, census)["team"] == team
               for row in holders):
            return f"live process running as {team}"
        if path.stem in {e.get("leadSessionId") for e in rosters}:
            return "roster leadSessionId"
        spawned = {payload["name"] for payload
                   in self._members_spawned_into(path.stem, team)}
        if spawned & {e["member"].get("name") for e in rosters}:
            return "member names"
        # Live members spawned by this claimant provide current process
        # evidence. Fork siblings share child history, so this distinguishes
        # different payload sets while leaving copied histories tied. A member
        # running in a process that is this command's own ancestor counts like
        # any other; dropping it would leave a claimant uncorroborated exactly
        # when the asker is its own child.
        if any(self._agent_runtime(agent_id_of(name, team), table,
                                   census=census)["records"]
               for name in spawned):
            return "live members it spawned"
        if self._session_names_team(path.stem, team):
            return "team-name block"
        return None

    def _lead_transcript_for(self, team, table=None, census=None):
        """Return the transcript and evidence claim for a team's lead.

        Forked history and quoted spawn payloads can create several claimants.
        `lead_corroboration` judges each one. One corroborated claimant wins. A
        sole claimant remains usable for dead-team recovery and is marked
        uncorroborated. Multiple unresolved claimants produce an ambiguity result.
        """
        hits = self._led_teams().get(team) or []
        if not hits:
            return None, self._lead_claim(
                "none", f"no transcript records spawning into {team}")

        backed = [(path, basis) for _, path in hits
                  if (basis := self._lead_corroboration(team, path, table, census))]
        if len(backed) == 1:
            return backed[0][0], self._judged_lead_claim(
                "corroborated", f"spawn payloads naming {team}", backed[0][1])
        if len(hits) == 1:
            # The answer says it is uncorroborated; it does not warn about it.
            # Reports ask this question too, and a listing that said "resuming"
            # would describe an act nobody asked for. Whoever resumes says so,
            # from this provenance.
            return hits[0][1], self._judged_lead_claim(
                "sole", f"sole payload claimant for {team}", None)
        listed = ", ".join(path.stem[:8] for _, path in hits)
        if len(backed) > 1:
            return None, self._lead_claim(
                "ambiguous-corroborated",
                f"{len(backed)} transcripts claim {team} with corroboration "
                f"({listed}); name one with --resume",
            )
        return None, self._lead_claim(
            "ambiguous",
            f"{len(hits)} transcripts claim {team}; corroboration is empty "
            f"({listed}); name one with --resume",
        )

    def _led_teams(self):
        """Map each team to lead transcripts ordered by latest spawn timestamp.

        Lead transcript lines carry session identity. Their teammate spawn records
        add team identity and therefore identify teams led by the transcript. A
        fresh implicit team also records the transcript ID in the roster. A resumed
        lead uses a process-life internal ID, making spawn records the durable link.

        Roster provenance varies between Claude Code, this tool, and manual recipes,
        so resolution evaluates each record instead of inferring provenance from
        corpus counts. This method reuses the spawn-record scan.
        """
        self._exercise(NEED.SPAWNS)
        if self._by_team is not None:
            return self._by_team
        self._by_team = {}
        leads = self._grep_files(SPAWN_MARKER, [self._projects_dir], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            newest = {}
            for stamp, payload in self._log(path.stem):
                team = payload.get("team_name")
                if team:
                    newest[team] = max(newest.get(team, 0), stamp or 0)
            for team, stamp in newest.items():
                self._by_team.setdefault(team, []).append((stamp, path))
        for team in self._by_team:
            self._by_team[team].sort(reverse=True)
        return self._by_team

    def _agent_runtime(self, agent_id, table=None, parent_session=None, census=None):
        """The live process answer for any agent identity.

        Members state identity in argv. A plain lead does not: the session
        registry and the team evidence identify its process instead. This method
        accepts both sources, deduplicates by pid, keeps the transcript each
        process holds, records which evidence established each pid, and marks
        the processes in this command's ancestry.

        The lead-only fields carry the same engine evidence diagnose_team needs
        for its verdict. A report consumes this answer; it does not call
        _lead_process or team_minted_by separately and assemble another runtime
        model of its own.
        """
        table = self._process_table() if table is None else table
        snapshot = self._runtime(table)
        pairs = {}
        evidence = {}

        def add(rows, kind, how):
            for pid, held in rows:
                if pid not in pairs or (held and not pairs[pid]):
                    pairs[pid] = held
                evidence[pid] = {
                    "kind": kind,
                    "how": how(pid),
                    "states_identity": kind == "argv",
                }

        argv_records = snapshot["by_agent"].get(agent_id, [])
        add([(row["pid"], row["session"]) for row in argv_records],
            "argv", lambda pid: f"live pid {pid} launched as {agent_id}")

        name, team = name_and_team(agent_id)
        lead_pid = None
        lead_alive = False
        lead_how = None
        lead_detail = None
        lead_exact = False
        # runs_as is the lead's operating_team answer. A member's argv names the
        # team it sends to, which is worn_team; the team it reads from is not
        # asked here, because nothing consumes it for a member.
        runs_as, runs_as_exact, runs_as_basis, runs_as_open = None, False, None, ()
        worn = team if pairs else None
        if name == "team-lead" and team:
            lead_process = self._lead_process(
                snapshot, parent_session, team, census=census)
            lead_pid = lead_process["pid"]
            lead_alive = lead_process["alive"]
            lead_how = lead_process["how"]
            lead_detail = lead_process["detail"]
            lead_exact = lead_process["exact"]
            if lead_pid and lead_alive:
                held = (snapshot["by_pid"].get(lead_pid) or {}).get("session")
                if lead_pid not in evidence:
                    add([(lead_pid, held)], lead_process["kind"], lambda _pid: lead_how)
                elif held and not pairs[lead_pid]:
                    pairs[lead_pid] = held
                operating = self._operating_team(lead_pid, snapshot, census)
                runs_as, runs_as_exact = operating["team"], operating["exact"]
                runs_as_basis = operating["basis"]
                runs_as_open = () if runs_as else operating["possible"]
                worn = operating["argv_team"]

        ordered = sorted(pairs.items())
        process_index = snapshot["by_pid"]
        process_rows = [process_index[pid] for pid, _held in ordered
                        if pid in process_index]
        other_rows = [row for row in process_rows if not row["ours"]]
        our_rows = [row for row in process_rows if row["ours"]]
        seated_rows = [row for row in process_rows if row["seat"] is not None]
        unseated_rows = [row for row in process_rows if row["seat"] is None]
        seats = tuple(row["seat"] for row in seated_rows)
        if not ordered:
            seat_state = "stopped"
        elif seated_rows and unseated_rows:
            seat_state = "mixed"
        elif seated_rows:
            seat_state = "seated"
        else:
            seat_state = "outside tmux"
        pid = lead_pid if name == "team-lead" else (ordered[0][0] if len(ordered) == 1 else None)
        alive = lead_alive if name == "team-lead" else bool(ordered)
        how = lead_how if name == "team-lead" else (
            f"pid {pid} was launched as {agent_id}" if pid else None)
        exact = lead_exact if name == "team-lead" else bool(pid)
        detail = lead_detail if name == "team-lead" else (
            f"was launched as {agent_id}" if pid else None)
        return immutable({
            "agent_id": agent_id,
            "pid": pid,
            "alive": alive,
            "how": how,
            "detail": detail,
            "exact": exact,
            "records": process_rows,
            "external": other_rows,
            "lineage": our_rows,
            "seat_state": seat_state,
            "seats": seats,
            "evidence": evidence,
            "runs_as": runs_as,
            "runs_as_exact": runs_as_exact,
            "runs_as_basis": runs_as_basis,
            "runs_as_open": runs_as_open,
            "worn_team": worn,
        })

    def _log(self, stem):
        """Load and return this transcript's spawn entries.

        Loading at the read point distinguishes an actual empty result from an
        uninitialized cache.
        """
        self._spawn_records(stem)
        return self._spawn_log.get(stem) or []

    def _every_log(self):
        """{transcript stem: entries} for the whole tree, filled on demand."""
        self._led_teams()
        return dict(self._spawn_log)

    @staticmethod
    def _launch_roster_record(identity, settings, cwd):
        """Build the exact immutable roster record owned by one launch answer."""
        return immutable({
            "name": identity["agentName"],
            "team": identity["teamName"],
            "agentId": identity["agentId"] or "",
            "parentSession": identity["parentSessionId"] or "",
            "agentType": settings.get("agentType"),
            "planModeRequired": settings.get("permissionMode") == "plan",
            "cwd": cwd,
            "color": settings.get("color"),
            "model": settings.get("model"),
        })

    def _spawn_payloads(self):
        """Every spawn payload on this machine."""
        return [payload for entries in self._every_log().values() for _stamp, payload in entries]

    def _members_spawned_into(self, lead_session, team):
        """The payloads for every teammate this lead spawned into this team.

        A team-membership question, like team_minted_by's, not the per-agent payload
        lookup spawn_payload owns: it asks who a roster should list, not what one
        known agent was created with. A lead resumed several times spawns into a
        fresh implicit team each life while appending to one transcript, so payloads
        naming another team are skipped rather than adopted.
        """
        latest = {}
        for _stamp, payload in self._log(lead_session):
            if payload.get("name") and payload.get("team_name") == team:
                latest[payload["name"]] = payload  # last spawn of that name into this team
        return list(latest.values())

    def _name_rosters(self, name, census=None):
        """Teams in one census with a roster that carries this agent name."""
        return frozenset(e["team"] for e in self._scan_teams(census)
                         if e["member"].get("name") == name)

    def _same_name_other_case(self, name, team=None, census=None):
        """Return roster agent IDs that match this name case-insensitively.

        Refusals use these candidates to distinguish an unknown name from a case
        mismatch. The existing roster scan supplies the candidate set.
        """
        if not name:
            return []
        near = set()
        for entry in self._scan_teams(census):
            theirs = entry["member"].get("name")
            if not theirs or theirs == name:
                continue
            if team and entry["team"].lower() != team.lower():
                continue
            if theirs.lower() == name.lower():
                near.add(agent_id_of(theirs, entry["team"]))
        return sorted(near)

    def _proc_stat(self, pid):
        """Return state, parent PID, and start time from `/proc/<pid>/stat`.

        Resolver keeps this parser private and exposes interpreted answers through
        `pid_alive` and `state_note`. Field 2 can contain spaces and parentheses,
        so parsing starts after the final closing parenthesis.
        """
        if not self._may_read(pid, "stat"):
            return None, None, None
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except (OSError, ValueError):
            # ValueError catches a comm that is not valid utf-8. The table
            # now reads this for every process on the machine, other users'
            # included, so a name we cannot decode has to answer "unknown"
            # rather than end the whole snapshot.
            return None, None, None
        try:
            rest = stat[stat.rindex(")") + 2:].split()
            return rest[0], int(rest[1]), rest[19]
        except (ValueError, IndexError):
            return None, None, None

    def _pid_alive(self, pid, procstart=None):
        """Is this process still running, and still the one that was meant?

        A zombie is not alive. A ctrl-z'd process is: it still owns its
        session and will pick up where it left off; callers nudge instead of
        stepping on it. `procstart` is what stops a recycled pid number from
        answering yes for a stranger.
        """
        state, _ppid, st = self._proc_stat(pid)
        if st is None or state in ("Z", "X"):
            return False
        return procstart in (None, "", st)

    def _proc_start(self, pid):
        """The start time the kernel records for this pid, or "" for one we
        cannot read.

        The other half of the identity pid_alive checks: anything writing a pid
        down for a later run to test asks here for the value to write beside it,
        so both sides of that test come from one parser.
        """
        return self._proc_stat(pid)[2] or ""

    @staticmethod
    def _state_note(pid, state):
        """Render a retained kernel process state without another procfs read."""
        if state in ("T", "t"):
            return f", suspended; `kill -CONT {pid}` (or fg) to wake it"
        return ""

    def _proc_env(self, pid, names):
        """The values this process was given for these environment variables.

        Env is fixed at exec, so this is what the process is actually running
        with rather than what anyone since has set. Nothing outside can read
        it and stay honest: /proc/<pid>/environ is the only source.
        """
        if not self._may_read(pid, "environ"):
            return {}
        try:
            raw = Path(f"/proc/{pid}/environ").read_bytes()
        except OSError:
            return {}
        found = {}
        for item in raw.split(b"\0"):
            if b"=" not in item:
                continue
            key, value = item.split(b"=", 1)
            key = key.decode("utf-8", "replace")
            if key in names:
                found[key] = value.decode("utf-8", "replace")
        return found

    def _credential_fact(self, lead):
        """Return credentials tied to the exact selected lead generation."""
        pid = (lead or {}).get("pid")
        selected = next(
            (row for row in (lead or {}).get("records", ()) if row["pid"] == pid),
            None)
        if not pid or not (lead or {}).get("alive") or selected is None:
            return immutable({"process": None, "values": {}})
        return immutable({
            "process": selected,
            "values": self._proc_env(pid, INHERIT_ENV),
        })

    def _cmdline(self, pid):
        """One process's exact argv tuple from NUL-delimited procfs bytes."""
        if not self._may_read(pid, "cmdline"):
            return ()
        try:
            raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        except OSError:
            return ()
        return tuple(item.decode("utf-8", "replace")
                     for item in raw.split(b"\0") if item)

    @staticmethod
    def _may_read(pid, reader):
        """Whether `reader` may read this pid's /proc entry.

        Outside the selftest, always. While it runs, in the selftest process
        and in every tool run one of its units starts, the fence decides, and
        a pid it refuses is answered as a process that does not exist. Nothing
        of it is read but the start time the fence compares for a pid a
        declared unit's listing named or one the run knows.
        """
        fence = PROCESS_FENCE
        return fence is None or fence.admit(pid, reader)

    def _process_table(self, refresh=False):
        """Return one PID-sorted snapshot of process parentage and full argv.

        `/proc` supplies complete command lines independent of terminal width and
        locale. Rows require a command line, which selects user processes and
        excludes kernel threads and zombies. Exiting processes reparent their
        children, preserving the ancestry walks. In the measured sample, 402 of
        403 commandless PIDs were kernel threads and one was a zombie.
        """
        self._exercise(NEED.PROCS)
        if refresh:
            self._invalidate("process")
        if self._procs is not None and not refresh:
            return self._procs
        rows = []
        listed = [int(entry.name) for entry in Path("/proc").iterdir()
                  if entry.name.isdigit()]
        if PROCESS_FENCE is not None:
            # While the selftest runs, the fence says which of these the table
            # may read, before any of them is read (_ProcessFence.listing).
            listed = PROCESS_FENCE.listing(listed)
        for pid in listed:
            argv = self._cmdline(pid)
            if not argv:
                continue
            _state, ppid, _started = self._proc_stat(pid)
            if ppid is None:
                # It exited between the listing and the read. A row with no
                # parent would sit outside every chain anyway.
                continue
            rows.append((pid, ppid, argv))
        rows.sort()
        self._procs = tuple(rows)
        return self._procs

    def _known_teams(self, census=None):
        """Map every known team to its strongest existence evidence.

        Transcript stamps and spawn records survive graceful team-directory
        cleanup. A roster directory adds current disk evidence. Selection and
        completion consume this shared enumeration.
        """
        found = {}
        for _name, stamped in self._stamp_index().values():
            if stamped:
                found[stamped] = "a transcript stamped with it"
        for team in self._led_teams():
            found[team] = "spawn payloads naming it"
        roster_census = self._roster_census() if census is None else self._retained_census(census)
        for record in roster_census:
            # A parsed roster makes the directory evidence of a team. Inbox-only
            # directories and malformed files contribute no team identity.
            if record.state == "valid":
                found[record.team] = "a roster on disk"
        return types.MappingProxyType(found)

    def _team_evidence(self, token, census=None):
        """Why this token is a team, or None."""
        return self._known_teams(census).get(token)

    def _lead_session_for(self, team, table=None, census=None):
        """Return the lead session from one roster and process generation."""
        for entry in self._scan_teams(census):
            if entry["team"] == team and entry.get("leadSessionId"):
                if self._transcript_path(entry["leadSessionId"]):
                    return entry["leadSessionId"]
        path, _why = self._lead_transcript_for(team, table=table, census=census)
        if path:
            return path.stem
        hits = self._sessions_naming(team)
        if len(hits) > 1:
            warn(f"{len(hits)} transcripts name team {team}; assuming {hits[0].stem}")
        return hits[0].stem if hits else None

    def _team_dir(self, team):
        """This team's directory. Everything the team owns is inside it, and
        every path answer below is this one plus a name."""
        return self._teams_dir / team

    def _roster_in(self, team_dir):
        """The roster inside a team directory.

        By directory rather than by team name, because a reap reads one team
        twice, once where it lives and once at the staged path it was renamed
        to, and that path is nobody's team name.
        """
        return team_dir / "config.json"

    def _inboxes_in(self, team_dir):
        """The mailbox directory inside a team directory, for the same reason
        roster_in takes a directory."""
        return team_dir / "inboxes"

    def _roster_path(self, team):
        """Where this team's roster lives. A path question, not a write: the class
        answers where things are so writers never have to know the layout."""
        return self._roster_in(self._team_dir(team))

    def _lock_for(self, cfg):
        """Where the lock for this roster lives.

        By roster path rather than by team name: both callers already hold the
        roster with the lock they are about to take or clear, and the layout is
        answered here so neither has to spell the filename.
        """
        return cfg.with_name("config.json.lock")

    def _lock_holder(self, lock):
        """Return owner record, owner-exited state, and bytes read from a lock.

        A recognized owner record is regular-file JSON written by this tool with
        PID and process start time. Directories, empty files, malformed JSON, and
        incomplete process identity return an unrecognized owner. PID plus start
        time handles PID reuse.

        Callers compare the returned bytes immediately before unlinking. A new
        owner's replacement changes the comparison and preserves the file. Byte
        comparison is required because the filesystem can reuse an inode after
        replacement.
        """
        try:
            raw = lock.read_bytes()
        except OSError:
            return None, False, None
        try:
            owner = json.loads(raw)
        except ValueError:
            return None, False, raw
        if not isinstance(owner, dict) or owner.get("tool") != TOOL:
            return None, False, raw
        if not isinstance(owner.get("pid"), int) or not isinstance(owner.get("procStart"), str):
            return None, False, raw
        if not owner["procStart"]:
            return None, False, raw
        return owner, not self._pid_alive(owner["pid"], owner["procStart"]), raw

    def _lock_objection(self, lock):
        """Return the reason a roster lock preserves its team directory.

        A `proper-lockfile` directory belongs to Claude Code. A recognized record
        with a live owner belongs to an active `team_lock` writer. An unreadable or
        empty regular file may belong to a writer between exclusive creation and
        ownership-record publication. Each case preserves the directory.

        A recognized record permits cleanup once its owner has exited, because
        `sweep_dead_lock` can remove that exact regular file. `lock_holder` supplies
        the shared ownership decision used by roster writes and cleanup.
        """
        if lock.is_dir():
            return f"{lock.name} is a directory, which is the harness's own lock on this roster"
        owner, gone, seen = self._lock_holder(lock)
        if seen is not None:
            if owner:
                return None if gone else f"{lock.name} is held by pid {owner['pid']}, which is running"
            return (f"{lock.name} carries no owner record, so a run of this tool is either "
                    "inside it or was killed inside it")
        # A missing path permits removal. Sockets, FIFOs, and inaccessible paths
        # preserve the directory as unexpected entries.
        return None if not lock.exists() else f"{lock.name} is not a regular file"

    def _inbox_path(self, team, name):
        """Where this member's mailbox lives."""
        return self._inboxes_in(self._team_dir(team)) / f"{name}.json"

    def _inbox_seeded(self, team, name):
        """Does this member already have a mailbox file with something in it?

        Zero bytes is the state that matters: an empty file is a parse error
        that wedges both reader and writer, so it counts as no mailbox at all
        and the seeder writes `[]` over it.
        """
        try:
            path = self._inbox_path(team, name)
            return path.exists() and path.stat().st_size > 0
        except OSError:
            return False

    @staticmethod
    def _mailbox_documents(generation):
        """Parse mailbox bytes retained by one exact mailbox generation."""
        documents = {}
        for filename, fact in generation:
            name = Path(filename).stem
            if fact and fact[0] == "changed-during-read":
                documents[name] = (None, "changed while it was read")
                continue
            raw = fact[-1] if fact and isinstance(fact[-1], bytes) else None
            if raw is None:
                documents[name] = (None, "unreadable")
                continue
            try:
                documents[name] = (json.loads(raw or b"[]"), None)
            except (ValueError, UnicodeDecodeError):
                documents[name] = (None, "unreadable, possibly torn mid-write")
        return documents

    def _inbox_state(self, team, generation=None):
        """Return mailbox state derived from one retained exact generation."""
        generation = (self._mailbox_generation(team) if generation is None
                      else generation)
        state = {}
        for name, (mail, error) in self._mailbox_documents(generation).items():
            if error:
                state[name] = (None, error)
            elif not isinstance(mail, list):
                state[name] = (
                    None, f"mailbox value is {type(mail).__name__}, expected array")
            else:
                stamps = sorted(m.get("timestamp") or "" for m in mail
                                if isinstance(m, dict))
                state[name] = (len(mail), stamps[0] if stamps else None)
        return state

    def _team_dirs(self):
        """Every team directory on disk, roster or not."""
        return [d for d in self._teams_dir.glob("*") if d.is_dir()]

    def _made_moments_ago(self, team_dir):
        """Return whether the team directory is inside the creation grace period.

        Team-directory creation precedes registry, spawn, and process evidence.
        The grace period preserves a team while those records appear.
        """
        try:
            return time.time() - team_dir.stat().st_mtime < TEAM_GRACE_S
        except OSError:
            return False

    def _scaffolding_objection(self, team_dir, census=None):
        """Return the first reason this team directory must be preserved.

        Validate the roster, inbox arrays, roster lock, and the tool-owned names
        in `SCAFFOLDING`. Symlinks, nested or unexpected entries, undelivered mail,
        unreadable data, and active or uncertain locks each preserve the
        directory. Lock validation protects a concurrent roster writer even when
        transcript evidence classifies the team as finished.
        """
        known = SCAFFOLDING
        lock = self._lock_for(self._roster_in(team_dir))
        try:
            entries = list(team_dir.iterdir())
        except OSError as exc:
            return f"unreadable ({exc})"

        for item in entries:
            if item.is_symlink():
                return f"{item.name} is a symlink"
            if item.name not in known:
                return f"unexpected entry {item.name!r}"
            if item.name == lock.name:
                held = self._lock_objection(item)
                if held:
                    return held
                continue
            if item.name != "inboxes":
                if not item.is_file():
                    return f"{item.name} is not a regular file"
                continue

            if not item.is_dir():
                return "inboxes is not a directory"
            for inbox in item.iterdir():
                if inbox.is_symlink():
                    return f"inboxes/{inbox.name} is a symlink"
                if not inbox.is_file():
                    return f"inboxes/{inbox.name} is not a regular file"
                if inbox.suffix != ".json":
                    return f"inboxes/{inbox.name} is not a .json file"
                try:
                    mail = json.loads(inbox.read_text() or "[]")
                except (OSError, ValueError) as exc:
                    return f"inboxes/{inbox.name} is unreadable or not JSON ({exc})"
                if not isinstance(mail, list):
                    return f"inboxes/{inbox.name} is not a message array"
                if mail:
                    return f"inboxes/{inbox.name} holds {len(mail)} undelivered message(s)"
            # The final removal check parses each file again because removal
            # requires the current entry to remain a mailbox array.

        config = self._roster_in(team_dir)
        census = self._roster_census() if census is None else self._retained_census(census)
        roster = next((record for record in census if record.path == config), None)
        if roster is None or roster.state == "absent":
            return "no config.json"
        if roster.state != "valid":
            return f"config.json unreadable ({roster.problem})"
        data = roster.data
        if not isinstance(data.get("members", ()), tuple):
            return "config.json is not a roster"
        return None

    def _scaffolding_and_strays(self, team_dir):
        """Return tool-owned paths and retained relative entry names.

        Top-level ownership uses `SCAFFOLDING`. Inside `inboxes`, ownership covers
        regular `.json` files. Symlinks, directories in file positions, and other
        names enter the retained list. Callers complete this read before deleting
        any returned path.
        """
        mine, strays = [], []
        try:
            entries = sorted(team_dir.iterdir())
        except OSError as exc:
            return [], [f"unreadable ({exc})"]
        for item in entries:
            if item.name not in SCAFFOLDING or item.is_symlink():
                strays.append(item.name)
            elif item.name == "inboxes":
                try:
                    boxes = sorted(item.iterdir())
                except OSError as exc:
                    strays.append(f"inboxes ({exc})")
                    continue
                for box in boxes:
                    if box.is_symlink() or not box.is_file() or box.suffix != ".json":
                        strays.append(f"inboxes/{box.name}")
                    else:
                        mine.append(box)
            elif not item.is_file():
                strays.append(item.name)
            else:
                mine.append(item)
        return mine, strays

    def _receipt_contents(self, team_dir, only=None):
        """Return receipt-ready roster and mailbox contents from a team directory.

        Each entry includes decoded text plus size, nanosecond mtime, and inode
        from the descriptor used for the read. Normalized keys remove staging
        suffixes so pre-stage and post-stage reads align. A directory argument
        supports both live and staged locations; `only` narrows the read to one
        mailbox. Read failures retain the entry with a reason. Reap and archive
        callers perform the later rename, write, and delete actions.
        """
        if only is not None:
            wanted = [self._inboxes_in(team_dir) / only]
        else:
            wanted = [self._roster_in(team_dir)]
            try:
                wanted += sorted(self._inboxes_in(team_dir).glob("*.json"))
            except OSError:
                pass
        reads = {}
        for path in wanted:
            key = ("config.json" if path.parent == team_dir
                   else f"inboxes/{unstaged(path.name)}")
            try:
                with open(path, "rb") as handle:
                    raw = handle.read()
                    facts = os.fstat(handle.fileno())
            except OSError as exc:
                reads[key] = {"text": None, "why": str(exc),
                              "size": None, "mtime_ns": None, "ino": None}
                continue
            try:
                text, why = raw.decode(), None
            except UnicodeDecodeError as exc:
                text, why = None, f"not text ({exc})"
            reads[key] = {"text": text, "why": why, "size": facts.st_size,
                          "mtime_ns": facts.st_mtime_ns, "ino": facts.st_ino}
        return reads

    def _transcripts_by_mtime(self):
        """Every transcript, newest first."""
        return sorted(self._projects_dir.glob("*/*.jsonl"),
                      key=lambda path: path.stat().st_mtime, reverse=True)

    def _transcripts_starting(self, block):
        """Transcripts with a uuid that opens with this block. A path question,
        so it belongs to whoever owns the tree rather than to a caller globbing
        it."""
        return list(self._projects_dir.glob(f"*/{block}-*.jsonl"))

    def _resolution(self, path=None, fields=None, last_ts=0, via="", strength=0,
                    others=(), reason="", answered=False, runtime=None,
                    evidence=None):
        """Build one complete immutable transcript resolution."""
        return Resolution(
            path=path,
            fields=immutable(fields or {}),
            last_ts=last_ts,
            via=via,
            strength=strength,
            others=immutable(others),
            reason=reason,
            answered=answered,
            runtime=immutable(runtime) if runtime is not None else None,
            evidence=immutable(evidence or {}),
            transcript=self._transcript_fact(path=path) if path else None,
        )

    def _resolve_transcript(self, session_uuid=None, lead_session=None, team=None, name=None,
                           is_lead=False, quick=False, runtime=None, table=None,
                           census=None):
        """Choose one transcript by ordered evidence.

        Priority is explicit session UUID, live runtime, roster `leadSessionId`,
        combined agent and team stamps, unique agent-name stamps, then lead spawn
        records. Live argv describes current flag-bound identity and therefore
        outranks recorded identity. Plain leads use session and team process
        evidence.

        Lead lines carry session identity, so fresh leads resolve through
        `leadSessionId` and resumed leads can resolve through spawn records. Bare
        names shared across several transcript conversations produce ambiguity.
        """
        if session_uuid:
            paths = self._transcript_paths(session_uuid)
            if len(paths) > 1:
                return self._resolution(
                    reason=(f"{len(paths)} transcript files carry session {session_uuid}; "
                            "the UUID cannot choose between them, so resolve the duplicate "
                            "files before resuming"),
                    answered=True,
                    evidence={"kind": "session-ambiguity", "paths": paths},
                )
            if paths:
                path = paths[0]
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return self._resolution(path, fields, last, via="session uuid", strength=EXACT)
            return self._resolution(reason=f"no transcript file for session {session_uuid}")

        # Live runtime outranks recorded identity. Members and flag-bound leads
        # state identity in argv; plain leads join through session and team
        # process evidence.
        if name and team:
            # Both halves: argv is the strongest evidence this tool has, and our
            # own lineage carries the same argv as anyone else's process. A plain
            # lead can reach the same answer through its session runtime instead;
            # agent_runtime records which process evidence actually answered.
            runtime = (self._agent_runtime(
                agent_id_of(name, team), table, census=census)
                       if runtime is None else runtime)
            seen = runtime["records"]
            held = {record["session"] for record in seen if record["session"]}
            if len(held) > 1:
                locations = ", ".join(
                    f"pid {record['pid']} on {record['session'][:8]}"
                    for record in seen if record["session"])
                return self._resolution(reason=(
                    f"{len(seen)} live processes run {agent_id_of(name, team)} on "
                    f"different conversations ({locations}); name the one you mean "
                    "with --resume"))
            if held:
                held_session = held.pop()
                path = self._transcript_path(held_session)
                if path:
                    if len(seen) > 1:
                        warn(f"{len(seen)} live processes run {agent_id_of(name, team)} on this one "
                             f"conversation (pids {', '.join(str(record['pid']) for record in seen)})")
                    matching = [record["pid"] for record in seen
                                if record["session"] == held_session]
                    proof = next(
                        (runtime["evidence"].get(pid) for pid in matching
                         if runtime["evidence"].get(pid, {}).get("states_identity")),
                        None,
                    ) or next(
                        (runtime["evidence"].get(pid) for pid in matching
                         if runtime["evidence"].get(pid)),
                        None,
                    )
                    fields, last = ({}, 0) if quick else self._scan_transcript(path)
                    via = proof["how"] if proof else "live process runtime"
                    # The process outranks the claimants, but the evidence that
                    # it holds this team's lead transcript can be the same spawn
                    # payloads they rest on, so it is judged the same way.
                    claim = (self._judged_lead_claim(
                        "live-runtime", via,
                        self._lead_corroboration(team, path, table, census))
                             if is_lead else None)
                    return self._resolution(
                        path, fields, last, strength=EXACT, via=via,
                        runtime=runtime, evidence=claim,
                    )

        if lead_session or is_lead:
            path = self._transcript_path(lead_session) if lead_session else None
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return self._resolution(
                    path, fields, last, via="roster leadSessionId", strength=EXACT,
                    evidence=self._lead_claim(
                        "roster-lead", "roster leadSessionId",
                        "roster leadSessionId"),
                )
            path, claim = (self._lead_transcript_for(
                team, table=table, census=census) if team else
                           (None, self._lead_claim("none", "no team was named")))
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return self._resolution(
                    path, fields, last, via=claim["why"], strength=EXACT,
                    evidence=claim,
                )
            named = (f"roster names lead session {lead_session}, which has no transcript, and "
                     if lead_session else "")
            return self._resolution(reason=f"{named}{claim['why']}")

        if team and name:
            # Promotion is an intentional identity assignment. Ordinary stamps
            # written later describe what a process wore; they do not silently
            # transfer this conversation to another address. An explicitly typed
            # different address still reaches its own roster or stamp evidence.
            promoted = [(path, receipt)
                        for path, receipt in self._carried_receipts().items()
                        if receipt.get("team") == team and receipt.get("name") == name]
            if len(promoted) > 1:
                return self._resolution(
                    reason=(f"{len(promoted)} promotion receipts assign "
                            f"{agent_id_of(name, team)} to different conversations; "
                            "choose one with --resume"),
                    answered=True,
                    evidence={"kind": "promoted-ambiguity",
                              "paths": tuple(path for path, _receipt in promoted)},
                )
            if promoted:
                # The record sits in the transcript it describes, so the carrier
                # path is the answer rather than dest_stem copied out of the receipt.
                found, _receipt = promoted[0]
                fields, last = ({}, 0) if quick else self._scan_transcript(found)
                return self._resolution(found, fields, last, via="conversion receipt",
                                        strength=EXACT)
            hits = self._stamped_candidates(name, team, verify=not quick)
            if hits:
                return self._resolution(*hits[0], via="agentName+teamName stamps",
                                        strength=STAMPS, others=hits[1:])

        if name:
            rosters = self._name_rosters(name, census)
            hits = self._stamped_candidates(name, None, verify=not quick)
            if len(rosters) > 1:
                # Roster entries are addresses. Rebinding can leave source and
                # destination addresses for one conversation. Transcript evidence
                # determines whether the name identifies one or several agents.
                paths = {path for path, _fields, _last in hits}
                if len(paths) == 1:
                    return self._resolution(
                        *hits[0], via=f"agentName on one transcript across {len(rosters)} rosters",
                        strength=NAME_ONLY)
                return self._resolution(reason=(
                    f"transcript search for {name!r} on team={team} returned empty; the bare name spans "
                    f"{len(rosters)} rosters and {len(paths)} transcripts, so qualify it with name@team or --resume"
                ))
            if hits:
                return self._resolution(
                    *hits[0], via="agentName only (unique across rosters)", strength=NAME_ONLY,
                    others=hits[1:])
        label = agent_id_of(name or "?", team or "?")
        # Every rung is spent. If a roster carries this word under different
        # capitals, saying so is the whole difference between a dead end and a
        # typo, and it costs one pass over rosters already read.
        near = self._same_name_other_case(name, team, census)
        if near:
            return self._resolution(answered=True, reason=(
                f"no transcript found for {label}; {some_of(near)} "
                f"{'differs' if len(near) == 1 else 'differ'} from it only in case"
            ))
        return self._resolution(reason=f"no transcript found for {label}")

    def _boot_join(self, snapshot, census=None):
        """[(team, pid, createdAt)] pairing each implicit team with the live process
        that created it, newest first.

        A boot creates its implicit team, named after its internal session id,
        while sessions/<pid>.json keeps the *resumed transcript* id. The two
        diverge after a resume (before one they are the same id, which
        _lead_process exploits as an exact join), and nothing else records the
        post-resume internal id, so for those teams time is a join of last
        resort: a team dir is created a few hundred ms before the session file
        when a boot creates it eagerly (measured 281, 252 and 402ms), but it
        can instead be created at the first spawn, minutes later, which this
        window does not cover. That is why the exact rungs above it are tried
        first.
        """
        live = [(row["pid"], row["started"])
                for row in snapshot["registry"] if row["alive"]]
        pairs = []
        for roster in self._rosters(census):
            created = roster.data.get("createdAt") or 0
            for pid, started in live:
                if 0 <= started - created <= TEAM_MINT_WINDOW_MS:
                    pairs.append((roster.team, pid, created))
        pairs.sort(key=lambda item: item[2], reverse=True)
        for team in {name for name, _, _ in pairs}:
            owners = {pid for name, pid, _ in pairs if name == team}
            if len(owners) > 1:
                warn(f"{len(owners)} processes started within {TEAM_MINT_WINDOW_MS}ms "
                     f"after {team} was created ({', '.join(map(str, sorted(owners)))}), "
                     "so their start times do not say which one created it")
        return pairs

    def _durable_assignment_index(self):
        """Return one retained current identity assignment per transcript.

        A restamp is an intentional move and outranks the conversion identity it
        replaced. A promotion receipt outranks later incidental stamps. Ordinary
        transcripts use their indexed complete identity pair. File generations are
        retained opaquely; callers never index their heterogeneous tuple shapes.
        """
        if self._team_assignments is not None:
            return self._team_assignments
        stamps = self._stamp_index()
        carried = self._carried_receipts()
        records = []
        for path in sorted(set(stamps) | set(carried)):
            restamp = self._rewriter._last_record_in_file(
                path, RESTAMP_RECORD, "restamp")
            moved = (restamp or {}).get("new") or {}
            receipt = carried.get(path) or {}
            stamped_name, stamped_team = stamps.get(path) or (None, None)
            if moved.get("agentName") and moved.get("teamName"):
                name, assigned_team = moved["agentName"], moved["teamName"]
                source = "restamp receipt"
            elif receipt.get("name") and receipt.get("team"):
                name, assigned_team = receipt["name"], receipt["team"]
                source = "conversion receipt"
            else:
                name, assigned_team = stamped_name, stamped_team
                source = "transcript identity"
            if not (name and assigned_team):
                continue
            records.append(types.MappingProxyType({
                "agent_id": agent_id_of(name, assigned_team),
                "name": name,
                "team": assigned_team,
                "path": path,
                "source": source,
                "generation": self._path_generation(path),
            }))
        by_agent, by_name, by_team = defaultdict(list), defaultdict(list), defaultdict(list)
        for record in records:
            by_agent[record["agent_id"]].append(record)
            by_name[record["name"]].append(record)
            by_team[record["team"]].append(record)
        self._team_assignments = types.MappingProxyType({
            "records": tuple(records),
            "by_agent": immutable(dict(by_agent)),
            "by_name": immutable(dict(by_name)),
            "by_team": immutable(dict(by_team)),
            "generation": tuple(
                (record["path"], record["generation"], record["agent_id"])
                for record in records),
        })
        return self._team_assignments

    def _team_members(self, team, table=None, census=None, enrich=False):
        """Return one immutable current member answer for exact retained inputs.

        The source roster row of a moved member remains historical. When that row
        is inactive and one durable transcript assignment names another team, it
        does not enter this team's current order. Activity never chooses between
        source and destination. Runtime, transcript, title, color, membership, and
        display activity are selected once and reused by every projection.
        """
        census = (self._roster_census() if census is None else
                  self._retained_census(census))
        snapshot = self._runtime(table)
        table = snapshot["table"]
        assignments = self._durable_assignment_index()
        bucket = self._team_member_answers.setdefault(team, [])
        for answer in bucket:
            if (answer["snapshot"] is snapshot
                    and answer["census"] is census
                    and answer["assignments"] is assignments
                    and answer["enriched"] is bool(enrich)):
                return answer

        roster_snapshot = self._roster_snapshot(team, census)
        roster = roster_snapshot.data
        entries = self._roster_entries(team=team, census=census)
        by_member = {id(entry["member"]): entry for entry in entries}
        seeds = {}
        roster_order = []

        def seed(name, agent_id=None, member=None, entry=None, assignment=None):
            if not name:
                return
            agent_id = agent_id or agent_id_of(name, team)
            current = seeds.get(name)
            if current is None:
                seeds[name] = {
                    "name": name, "agent_id": agent_id,
                    "member": member, "entry": entry,
                    "assignment": assignment,
                }
                return
            if member is not None and current["member"] is None:
                current["member"], current["entry"] = member, entry
            if assignment is not None and current["assignment"] is None:
                current["assignment"] = assignment

        for member in roster.get("members", ()):
            name = member.get("name")
            if not name:
                continue
            agent_id = member.get("agentId") or agent_id_of(name, team)
            exact = assignments["by_agent"].get(agent_id, ())
            other = tuple(record for record in assignments["by_name"].get(name, ())
                          if record["team"] != team)
            historical = (member.get("isActive") is False
                          and not exact and len({row["agent_id"] for row in other}) == 1)
            if historical:
                continue
            if name not in seeds:
                roster_order.append(name)
            seed(name, agent_id, member, by_member.get(id(member)),
                 exact[0] if len(exact) == 1 else None)

        for assignment in assignments["by_team"].get(team, ()):
            if assignment["name"] != "team-lead":
                exact = assignments["by_agent"].get(assignment["agent_id"], ())
                seed(assignment["name"], assignment["agent_id"],
                     assignment=assignment if len(exact) == 1 else None)
        for observed in snapshot["live_sessions"]:
            agent_id = observed.get("agent_id")
            name, observed_team = name_and_team(agent_id)
            if name and observed_team == team:
                seed(name, agent_id)

        lead_id = agent_id_of("team-lead", team)
        lead_runtime = self._agent_runtime(
            lead_id, table, parent_session=roster.get("leadSessionId"),
            census=census)
        if lead_runtime["records"] and "team-lead" not in seeds:
            seed("team-lead", lead_id)

        records = []
        runtimes = {}
        spawn_allowed = (enrich
                         and self._needs[NEED.SPAWNS] is not DECLARED.ABSENT)
        for name in roster_order + sorted(
                candidate for candidate in seeds if candidate not in set(roster_order)):
            selected = seeds[name]
            agent_id = selected["agent_id"]
            member = selected["member"]
            entry = selected["entry"]
            assignment = selected["assignment"]
            runtime = (lead_runtime if name == "team-lead" else
                       self._agent_runtime(agent_id, table, census=census))
            runtimes[name] = runtime
            if enrich:
                if name == "team-lead" and roster.get("leadSessionId"):
                    resolution = self._resolve_transcript(
                        lead_session=roster.get("leadSessionId"), team=team,
                        name=name, is_lead=True, quick=True, runtime=runtime,
                        table=table, census=census)
                elif assignment is not None:
                    resolution = self._resolution(
                        path=assignment["path"], via=assignment["source"],
                        strength=EXACT,
                        evidence=self._judged_lead_claim(
                            "assignment", assignment["source"],
                            self._lead_corroboration(
                                team, assignment["path"], table, census))
                        if name == "team-lead" else None)
                else:
                    resolution = self._resolve_transcript(
                        team=team, name=name, is_lead=name == "team-lead",
                        quick=True, runtime=runtime, table=table, census=census)
                transcript = resolution.transcript
            else:
                resolution = None
                transcript = None
            if member is not None:
                membership = ("listed", "listed in the roster")
                source_member = member
            elif assignment is not None and assignment["source"] == "conversion receipt":
                membership = (
                    "converted", "a conversion receipt; registers on first launch")
                source_member = immutable({
                    "agentId": agent_id, "name": name, "converted": True})
            elif runtime["records"]:
                membership = ("unrecorded", "running, and in no roster")
                source_member = immutable({
                    "agentId": agent_id, "name": name, "unrecorded": True})
            else:
                membership = ("former", "a transcript assigned to this team")
                source_member = immutable({
                    "agentId": agent_id, "name": name, "former": True})
            if entry is not None and entry["ts"]:
                activity, activity_source = entry["ts"], "roster membership"
            elif transcript and transcript.get("mtime"):
                activity, activity_source = transcript["mtime"], "transcript"
            else:
                started = [row.get("started") or 0 for row in runtime["records"]]
                activity = max(started, default=0) or None
                activity_source = "runtime" if activity else None
            spawn = self._spawn_payload(agent_id) if spawn_allowed else None
            records.append(types.MappingProxyType({
                "agent_id": agent_id,
                "name": name,
                "team": team,
                "member": source_member,
                "roster_member": member,
                "roster_entry": entry,
                "roster_generation": roster_snapshot.generation,
                "assignment": assignment,
                "membership": membership,
                "runtime": runtime,
                "resolution": resolution,
                "transcript": transcript,
                "title": (transcript or {}).get("title"),
                "colour": agent_colour(agent_id, member, spawn),
                "activity": activity,
                "activity_source": activity_source,
            }))
        by_name = types.MappingProxyType({record["name"]: record for record in records})
        by_agent = types.MappingProxyType({record["agent_id"]: record for record in records})
        member_order = tuple(record["name"] for record in records)
        answer = types.MappingProxyType({
            "team": team,
            "table": table,
            "enriched": bool(enrich),
            "snapshot": snapshot,
            "census": census,
            "roster_snapshot": roster_snapshot,
            "roster": roster,
            "roster_generation": roster_snapshot.generation,
            "assignments": assignments,
            "assignment_generation": assignments["generation"],
            "members": tuple(records),
            "by_name": by_name,
            "by_agent": by_agent,
            "member_order": member_order,
            "runtimes": types.MappingProxyType(runtimes),
            "lead": lead_runtime,
        })
        bucket.append(answer)
        return answer

    def _team_runtime(self, team, table=None, census=None, member_answer=None):
        """Project population and process facts from one retained member answer."""
        members = (member_answer if member_answer is not None else
                   self._team_members(team, table=table, census=census))
        population = types.MappingProxyType({
            record["name"]: record["membership"] for record in members["members"]})
        return types.MappingProxyType({
            "team": team,
            "table": members["table"],
            "snapshot": members["snapshot"],
            "census": members["census"],
            "roster_snapshot": members["roster_snapshot"],
            "roster": members["roster"],
            "members": members["members"],
            "member_records": members["by_name"],
            "population": population,
            "runtimes": members["runtimes"],
            "lead": members["lead"],
            "member_order": members["member_order"],
            "generation": types.MappingProxyType({
                "roster": members["roster_generation"],
                "assignments": members["assignment_generation"],
            }),
        })

    @staticmethod
    def _socket_for_ids(snapshot, agent_ids):
        """Return the first external seated process for these exact identities."""
        for agent_id in agent_ids:
            for process in snapshot["by_agent"].get(agent_id, ()):
                seat = process["seat"]
                if not process["ours"] and seat:
                    return (seat.socket,
                            f"live pane {seat.pane} of pid {process['pid']}")
        return None, None

    @staticmethod
    def _select_team_jobs(members, population, live, lead_id, all_members, team):
        """Choose one ordered member set from a single team generation."""
        def inferred(name):
            kind = "unrecorded" if name in live else "former"
            return immutable({
                "agentId": agent_id_of(name, team), "name": name, kind: True})

        members = list(members)
        listed = {member.get("name") for member in members if member.get("name")}
        if all_members:
            members += [inferred(name) for name in sorted(population)
                        if name not in listed]
            return tuple(members), ()
        if live:
            kept = [member for member in members
                    if member.get("name") in live
                    or member.get("agentId") == lead_id]
            have = {member.get("name") for member in kept}
            members = kept + [inferred(name) for name in sorted(live - have)]
            listed = {member.get("name") for member in members if member.get("name")}
        former = tuple(name for name in sorted(population) if name not in listed)
        return tuple(members), former

    def _team_jobs(self, team, runtime, all_members=False):
        """The members a run of `team` starts, the lead last, and who it leaves out.

        Returns (ordered members, former names, live names): the selection
        team_run_plan launches, which the doctor and a lead move's crew report
        ask the planner about too.
        """
        roster = runtime["roster"]
        lead_id = roster.get("leadAgentId")
        live = frozenset(
            name for name, facts in runtime["runtimes"].items() if facts["external"])
        selected, former = self._select_team_jobs(
            tuple(roster.get("members", ())), runtime["population"], live, lead_id,
            all_members, team)
        ordered = tuple(sorted(
            selected, key=lambda member: 1 if member.get("agentId") == lead_id else 0))
        return ordered, former, live

    def _team_movers(self, runtime, members, table, census):
        """`members` other than the lead as team_redirect reads them (mover rows).

        Each row says where the member's conversation is, whether it is running
        and which processes hold it: ones a move ends (`holders`) and this
        process or its ancestors, which no move can end (`ours`).
        """
        snapshot = runtime["snapshot"]
        lead_id = runtime["roster"].get("leadAgentId")
        movers = []
        for member in members:
            name = member.get("name")
            if member.get("agentId") == lead_id or name == "team-lead":
                continue
            record = runtime["member_records"].get(name)
            member_runtime = (record["runtime"] if record else
                              self._agent_runtime(member.get("agentId"), table,
                                                  census=census))
            resolution = record["resolution"] if record else None
            path = resolution.path if resolution else None
            held = (((snapshot.get("transcripts") or {}).get(path.stem) or {}).get(
                "processes", ()) if path else ())
            running = {row["pid"]: row["ours"]
                       for row in tuple(held) + tuple(member_runtime["records"])}
            movers.append(immutable({
                "agent_id": member.get("agentId"),
                "path": path,
                "running": bool(member_runtime["external"] or held),
                "holders": tuple(sorted(pid for pid, ours in running.items()
                                        if not ours)),
                "ours": tuple(sorted(pid for pid, ours in running.items() if ours)),
            }))
        return tuple(movers)

    def team_run_plan(self, team, table=None, all_members=False,
                      requested_socket=None, census=None, preview_roster=None,
                      redirect=None):
        """Return one run plan using the member answer's exact retained selection.

        `redirect` is the MemberRedirectRequest the run applies to its members.
        With one, the plan carries the run's one redirect decision for them
        (team_redirect), made here before any member launches; without one, the
        plan decides nothing about where members go.
        """
        census = (self._roster_census() if census is None else
                  self._retained_census(census))
        if preview_roster is not None:
            preview = self.RosterSnapshot.preview(self._roster_path(team), preview_roster)
            census = self._update_census(census, preview.path, preview)
        members_answer = (self._team_members(team, table, census, enrich=True)
                          if redirect is not None else None)
        runtime = self._team_runtime(team, table, census=census,
                                     member_answer=members_answer)
        table, census = runtime["table"], runtime["census"]
        roster_snapshot = runtime["roster_snapshot"]
        roster = runtime["roster"]
        members = tuple(roster.get("members", ()))
        lead_id = roster.get("leadAgentId")
        ordered, former, live = self._team_jobs(team, runtime, all_members)

        warnings = []
        if requested_socket:
            socket, socket_why = requested_socket, "--socket"
        else:
            snapshot = runtime["snapshot"]
            crew_ids = sorted(
                row["agent_id"] for row in snapshot["live_sessions"]
                if row.get("team") == team and row.get("agent_id"))
            socket, socket_why = self._socket_for_ids(snapshot, crew_ids)
            if not socket:
                listed_ids = [member.get("agentId") for member in members
                              if member.get("agentId")
                              and member.get("agentId") != lead_id]
                socket, socket_why = self._socket_for_ids(snapshot, listed_ids)
            if not socket:
                lead = runtime["lead"]
                pid = lead["pid"]
                if pid and lead["alive"]:
                    socket, socket_why = f"{SOCKET_PREFIX}{pid}", f"lead pid {pid}"
                else:
                    if pid:
                        warnings.append(
                            f"the lead of {team} last ran as pid {pid}, which is gone; "
                            "using the team's own server")
                    socket = f"{SOCKET_PREFIX}{team}" if team else None
                    socket_why = (f"resurrected server for {team}"
                                  if team else "unresolved")
                    if team:
                        warnings.append(
                            f"no live lead for {team}; standing up that team's own "
                            "server, as if its lead were up")
        agent_ids = tuple(
            agent_id_of(name, team) for name in runtime["runtimes"])
        sessions = tuple(
            record["session"] for facts in runtime["runtimes"].values()
            for record in facts["records"] if record["session"])
        process_generation = self._runtime_generation(
            runtime["snapshot"], agent_ids=agent_ids,
            sessions=sessions, teams=(team,))
        destination = LaunchDestination(socket) if socket else None
        placement = self._tmux_launch_action(destination) if destination else None
        inboxes = tuple(
            self._inbox_seed_fact(team, member.get("name") or "?")
            for member in ordered)
        selection = None
        if redirect is not None:
            selection = self._team_redirect(
                team, redirect, runtime["lead"],
                self._team_movers(runtime, ordered, table, census), table, census)
        return types.MappingProxyType({
            "team": team,
            "table": table,
            "snapshot": runtime["snapshot"],
            "census": census,
            "roster_snapshot": roster_snapshot,
            "generation": roster_snapshot.generation,
            "process_generation": process_generation,
            "process_agents": agent_ids,
            "process_sessions": sessions,
            "roster": roster,
            "runtime": runtime,
            "lead_id": lead_id,
            "members": ordered,
            "inboxes": inboxes,
            "former": former,
            "live": live,
            "destination": destination,
            "destination_why": socket_why,
            "destination_state": (placement["server"]["state"]
                                  if placement else "unresolved"),
            "placement_generation": (placement["generation"]
                                     if placement else None),
            "warnings": tuple(warnings),
            "redirect": selection,
        })

    def revalidate_team_run(self, plan, cleared=()):
        """Compare selected roster and process facts without choosing new jobs.

        `cleared` are the pids the run ended to move its members: each must be
        gone, and every other process is compared as selected.
        """
        current = self._roster_snapshot(plan["team"])
        table = self._process_table(refresh=True)
        snapshot = self._runtime(table)
        process_generation = self._runtime_generation(
            snapshot, agent_ids=plan["process_agents"],
            sessions=plan["process_sessions"], teams=(plan["team"],),
            exclude_pids=cleared)
        selected_generation = (self._runtime_generation(
            plan["snapshot"], agent_ids=plan["process_agents"],
            sessions=plan["process_sessions"], teams=(plan["team"],),
            exclude_pids=cleared) if cleared else plan["process_generation"])
        changed = []
        if current.observation != plan["roster_snapshot"].observation:
            changed.append(f"roster {plan['team']}")
        if process_generation != selected_generation:
            changed.append(f"runtime {plan['team']}")
        for pid in cleared:
            if pid in snapshot["by_pid"]:
                changed.append(f"stopped pid {pid} remains")
        current_placement = (self._tmux_launch_action(plan["destination"])
                             if plan["destination"] else None)
        current_generation = (current_placement["generation"]
                              if current_placement else None)
        if current_generation != plan["placement_generation"]:
            changed.append(f"tmux destination {plan['team']}")
        for inbox in plan["inboxes"]:
            if self._file_observation(inbox["observation"].path) != inbox["observation"]:
                changed.append(f"inbox {inbox['name']}")
        selection = plan["redirect"]
        if selection and selection["action"] == "redirect":
            # Where the members go was decided on this roster; the source's
            # roster and the team's processes are compared above.
            moved_to = self._roster_snapshot(selection["destination"])
            if moved_to.observation != selection["destination_roster"].observation:
                changed.append(f"destination roster {selection['destination']}")
        return immutable({
            "matches": not changed,
            "changed": tuple(changed),
            "selected": plan["roster_snapshot"],
            "current": current,
        })

    def _converted_members(self, team):
        """{name: receipt} for promoted members with a membership that is a receipt.

        A promote records the spoken identity in the line the transcript
        carries, so the transcript's own existence is the evidence: a demote
        takes the file away, and there is nothing left to describe. That is
        read off the same pass as the stamps, which a promoted transcript has
        none of, and is why its membership has to be asked for separately.
        """
        return {r["name"]: r for path, r in sorted(self._carried_receipts().items())
                if r.get("team") == team and r.get("name") and path.exists()}

    def _mail_ledger(self, team, to=None, table=None, census=None,
                    description=None, mailbox_generation=None):
        """[{sender, to, summary, sent, state, detail}] for a team's authored mail.

        Conversational mail is double-recorded: every send sits verbatim in
        the sender's transcript as a SendMessage tool use, and every delivery
        lands in the recipient's as a teammate-message wrapper carrying the
        body unchanged. The join is pure evidence-reading, and an unmatched
        send has four honest states rather than one: still in the inbox
        file (queued), the recipient has not written since (pending a turn
        boundary), taken into a live recipient's memory (in memory - the
        drain-then-die window while it stands open), or the recipient has
        written and no delivery matches (unexplained - what that window
        leaves behind when it closes on a loss). Seven states in all, with
        delivered, protocol and unknown recipient.

        Harness-emitted traffic (idle notifications) has no send side, so it
        never appears here; protocol-object sends are counted, not joined.
        The transcript join is the ONLY durable record, two ways over:
        cleanup deletes inbox dirs wholesale, and normal delivery prunes the
        inbox on queueing (bundle-confirmed), so "in memory" is the one
        state any instrument can show while a loss window is open.

        `to` is the caller's declared need. A named recipient narrows the
        join to sends addressed to it, with identical states to the full
        ledger's rows for it: every transcript is still opened, because a
        send to it can originate anywhere, but only its own file pays the
        delivery side, and everyone else's parses only its send lines.
        """
        self._exercise(NEED.MAIL)
        table = self._process_table() if table is None else table
        table = self._retained_table(table)
        census = self._roster_census() if census is None else self._retained_census(census)
        description = (self._team_description(team, table=table, census=census)
                       if description is None else description)
        mailbox_generation = (self._mailbox_generation(team)
                              if mailbox_generation is None else mailbox_generation)
        mailbox_documents = self._mailbox_documents(mailbox_generation)
        people = {}
        for path, (name, stamped) in self._stamp_index().items():
            if stamped == team and name and name not in people:
                people[name] = path
        lead_fact = description["lead_fact"]
        if lead_fact and "team-lead" not in people:
            people["team-lead"] = lead_fact["path"]

        sends, boxes, wrappers, last_write = [], {}, {}, {}
        for name, path in people.items():
            # The caller's declared need bounds the walk: sends to the named
            # recipient originate anywhere, so every transcript is opened, but
            # only the recipient's own file pays the delivery side (wrappers,
            # last write, inbox), and everyone else's parses only its sends.
            wants_delivery = to is None or name == to
            if wants_delivery:
                snapshot = self._transcript_snapshot(path, include_mail=True)
                if not snapshot:
                    continue
                sends.extend({"sender": name, **entry}
                             for entry in snapshot["sends"])
                wrappers[name] = snapshot["wrappers"]
                last_write[name] = snapshot["last_write"]
            else:
                try:
                    handle = path.open(errors="replace")
                except OSError:
                    continue
                with handle:
                    for line in handle:
                        if '"SendMessage"' not in line:
                            continue
                        try:
                            rec = json.loads(line)
                        except ValueError:
                            continue
                        if rec.get("isSidechain"):
                            continue
                        stamp = iso_ms(rec.get("timestamp"))
                        sends.extend({"sender": name, **entry}
                                     for entry in self._send_evidence(rec, stamp))
                wrappers[name] = ()
            if wants_delivery:
                inbox, error = mailbox_documents.get(name, ([], None))
                boxes[name] = [m.get("text") or str(m.get("message", ""))
                               for m in inbox if isinstance(m, dict)] \
                    if not error and isinstance(inbox, list) else []

        ledger = []
        for send in sorted(sends, key=lambda s: s["sent"] or 0):
            addressee = send["to"]
            if to is not None and addressee != to:
                continue
            entry = {k: send[k] for k in ("sender", "to", "summary", "sent")}
            if send["body"] is None:
                entry.update(state="protocol", detail="an object send; not joined")
            elif addressee not in people:
                entry.update(state="unknown recipient",
                             detail=f"{addressee!r} has no transcript stamped with this team")
            elif any(who == send["sender"] and body == send["body"]
                     for who, body in wrappers.get(addressee, [])):
                entry.update(state="delivered", detail="the body sits in the "
                             "recipient's transcript verbatim")
            elif any(send["body"] == text for text in boxes.get(addressee, [])):
                entry.update(state="queued", detail="still in the inbox file; "
                             "delivery is a turn-boundary event")
            elif (last_write.get(addressee) or 0) <= (send["sent"] or 0):
                entry.update(state="pending", detail="the recipient has not "
                             "written since the send")
            elif self._runtime(table)["by_transcript"].get(people[addressee].stem):
                # Marked read on queueing, held in the recipient's RAM: the
                # drain-then-die window is open until its turn ends. Both
                # halves of the holder question, because the recipient may be
                # the very process asking.
                entry.update(state="in memory", detail="the recipient is live "
                             "mid-turn; delivery waits on its next boundary "
                             "and dies with its process")
            else:
                entry.update(state="unexplained", detail="the recipient has "
                             "written since, no delivery matches, and no live "
                             "process holds its transcript")
            ledger.append(immutable(entry))
        return tuple(ledger)

    @staticmethod
    def _objector_said(row):
        """Render one process's complete rebind objection as one sentence.

        Argv identity and the team the process operates as merge into one row,
        so reports count each PID once.
        """
        parts = []
        if "wears" in row["kinds"]:
            parts.append(f"runs as it ({row['worn']})")
        operating = row.get("operating")
        if "operates" in row["kinds"] and operating is not None:
            parts.append(("operates as it" if operating["team"] else "may operate as it")
                         + f" ({operating['basis']})")
        tail = "; that pid is this process" if row["ours"] else ""
        return f"pid {row['pid']} {' and '.join(parts)}{tail}"

    def _reap_objections(self, team, table, archive_mail=False, census=None):
        """Return one structured rebind objection per process or mailbox.

        Retiring a team takes away the config and inboxes its live processes
        use: one wearing it in argv sends there, and one operating as it reads
        there (operating_team). Either objects, and so does one the evidence
        leaves possibly operating as it. Waiting mail also preserves the team
        unless the caller archives it. Typed rows let callers group remedies by
        evidence kind while counting each PID once.
        """
        procs = {}
        snapshot = self._runtime(table)

        def process_row(entry):
            return procs.setdefault(entry["pid"], {
                "pid": entry["pid"], "kinds": set(), "worn": None,
                "operating": None, "ours": bool(entry.get("ours"))})

        for entry in snapshot["live_sessions"]:
            if not entry.get("alive"):
                continue
            if entry.get("team") == team:
                row = process_row(entry)
                row["kinds"].add("wears")
                row["worn"] = entry.get("agent_id") or "in argv"
                continue
            operating = self._operating_team(entry["pid"], snapshot, census)
            if team in operating["possible"]:
                row = process_row(entry)
                row["kinds"].add("operates")
                row["operating"] = operating
        out = [{"pid": row["pid"], "kinds": frozenset(row["kinds"]),
                "said": self._objector_said(row)} for row in procs.values()]
        if not archive_mail:
            for name, (count, oldest) in self._inbox_state(team).items():
                if count is None:
                    out.append({"pid": None, "kinds": frozenset({"mail"}),
                                "said": f"{name}'s inbox is {oldest}"})
                elif count:
                    out.append({"pid": None, "kinds": frozenset({"mail"}),
                                "said": f"{count} unread for {name}, "
                                        f"oldest {said_when(oldest)}"})
        return tuple(immutable(row) for row in out)

    def _nameless_receipts(self):
        """Promoted transcript roots with a last in-file receipt that has no identity."""
        return [path.stem for path, receipt in self._carried_receipts().items()
                if not (receipt.get("name") and receipt.get("team"))]

    def _live_teams(self):
        """Teams a live process is currently running as, from its own argv."""
        return {e["team"] for e in self._runtime()["live_sessions"] if e.get("team")}

    @staticmethod
    def _snapshot_signature(stat):
        """File identity and content-change fields used by transcript snapshots."""
        return (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns)

    @staticmethod
    def _path_generation(path):
        """Return one path's lstat identity, including an explicit absent state."""
        path = Path(path)
        try:
            stat = path.lstat()
        except OSError:
            return ("absent",)
        return (stat.st_mode, stat.st_dev, stat.st_ino, stat.st_size,
                stat.st_mtime_ns)

    @classmethod
    def _file_observation(cls, path):
        """Read bytes and mode together; preserve the existing OSError-as-absence rule."""
        path = Path(path)
        try:
            with path.open("rb") as handle:
                raw = handle.read()
                stat = os.fstat(handle.fileno())
            current = path.stat()
        except OSError:
            return FileObservation(path, ("absent",), None)
        descriptor = cls._snapshot_signature(stat)
        named = cls._snapshot_signature(current)
        generation = ((*descriptor, raw) if descriptor == named else
                      ("changed-during-read", descriptor, named, raw))
        return FileObservation(path, generation, stat.st_mode & 0o777)

    @classmethod
    def _file_generation(cls, path):
        return cls._file_observation(path).generation

    def _directory_generation(self, path):
        """Return a recursive path/type/generation inventory for one directory."""
        path = Path(path)
        if not path.is_dir():
            return ((".", self._path_generation(path)),)
        rows = [(".", self._path_generation(path))]
        try:
            descendants = sorted(path.rglob("*"), key=lambda item: str(item))
        except OSError:
            descendants = []
        for item in descendants:
            relative = str(item.relative_to(path))
            generation = (self._file_generation(item) if item.is_file()
                          else self._path_generation(item))
            rows.append((relative, generation))
        return tuple(rows)

    def _mailbox_generation(self, team):
        """Return every mailbox path and exact generation for one team."""
        inboxes = self._inboxes_in(self._team_dir(team))
        try:
            paths = tuple(sorted(inboxes.glob("*.json")))
        except OSError:
            paths = ()
        return tuple((path.name, self._file_generation(path)) for path in paths)

    def _inbox_seed_fact(self, team, name):
        """Select mailbox bytes and permissions together with its before-observation."""
        path = self._inbox_path(team, name)
        observation = self._file_observation(path)
        if observation.generation == ("absent",):
            action = "create"
        elif observation.physical and observation.raw == b"":
            action = "replace-empty"
        elif observation.physical:
            action = "keep"
        else:
            die(f"inbox {path} changed while it was read; select it again")
        return immutable({
            "name": name, "observation": observation, "action": action,
            **({"bytes": b"[]",
                "mode": observation.mode if observation.mode is not None else 0o600}
               if action != "keep" else {}),
        })

    @staticmethod
    def _send_evidence(rec, stamp):
        """Structured SendMessage entries carried by one transcript record."""
        found = []
        content = (rec.get("message") or {}).get("content")
        if rec.get("type") == "assistant" and isinstance(content, list):
            for block in content:
                if (isinstance(block, dict) and block.get("type") == "tool_use"
                        and block.get("name") == "SendMessage"):
                    spec = block.get("input") or {}
                    body = spec.get("message")
                    found.append(types.MappingProxyType({
                        "to": spec.get("to") or spec.get("recipient"),
                        "summary": spec.get("summary") or "",
                        "sent": stamp,
                        "body": body if isinstance(body, str) else None,
                    }))
        return tuple(found)

    def _derive_transcript_snapshot(self, lines, include_mail):
        """Derive requested immutable facts from complete JSONL lines."""
        records, leaves, duplicate_uuids = {}, [], set()
        sends, wrappers, newest = [], [], 0
        for raw_line in lines:
            line = raw_line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                # The parent walk consumes object records with type, UUID, and
                # parentUuid fields. Arrays, strings, and numbers stay outside
                # that record set.
                continue
            if include_mail:
                send_candidate = '"SendMessage"' in raw_line
                delivery_candidate = "<teammate-message" in raw_line
                mail_candidate = (send_candidate or delivery_candidate
                                  or '"timestamp"' in raw_line)
                if mail_candidate and not rec.get("isSidechain"):
                    stamp = iso_ms(rec.get("timestamp"))
                    if stamp:
                        newest = max(newest, stamp)
                    if send_candidate:
                        sends.extend(self._send_evidence(rec, stamp))
                    if delivery_candidate:
                        wrappers.extend(_delivery_events(rec))
            if rec.get("type") == "last-prompt":
                # Preserve file order for the probe that distinguishes
                # final-record selection from the loader's set-latest rule.
                leaf = rec.get("leafUuid")
                if isinstance(leaf, str) and leaf and leaf not in leaves:
                    leaves.append(leaf)
                continue
            uuid = _record_uuid(rec) if "uuid" in rec else None
            if uuid:
                parent = rec.get("parentUuid")
                stamp = (_identity_stamp(rec) if parent is None and (
                    "agentName" in rec or "teamName" in rec) else {})
                if uuid in records:
                    duplicate_uuids.add(uuid)
                # Claude Code's UUID map and the prior implementation both use the
                # last top-level record when a compacted transcript repeats one.
                records[uuid] = (parent, stamp.get("agentName"),
                                 stamp.get("teamName"), iso_ms(rec.get("timestamp")),
                                 rec.get("type"))
        candidates = [(ts, uuid) for uuid, (_p, _a, _t, ts, kind) in records.items()
                      if uuid in leaves and kind in ("user", "assistant")]
        start = None
        if candidates:
            cursor = max(candidates)[1]
            seen = set()
            while cursor in records and cursor not in seen:
                seen.add(cursor)
                parent = records[cursor][0]
                if parent is None:
                    _p, name, team, _ts, _k = records[cursor]
                    start = (name, team, cursor) if name and team else None
                    break
                cursor = parent
        return types.MappingProxyType({
            "start": start,
            "uuids": frozenset(records),
            "duplicate_uuids": frozenset(duplicate_uuids),
            "mail_complete": include_mail,
            "last_write": newest,
            "sends": tuple(sends),
            "wrappers": tuple(wrappers),
        })

    def _stable_transcript_snapshot(self, path, include_mail):
        """Derive one complete snapshot while the file stays unchanged."""
        while True:
            try:
                with path.open(errors="replace") as handle:
                    before = self._snapshot_signature(os.fstat(handle.fileno()))
                    fact = self._derive_transcript_snapshot(handle, include_mail)
                    after = self._snapshot_signature(os.fstat(handle.fileno()))
                current = self._snapshot_signature(path.stat())
            except OSError:
                return None
            if before == after == current:
                return current, fact

    def _transcript_snapshot(self, path, include_mail=False):
        """Return cached window-root and requested mail facts for one file snapshot."""
        path = Path(path)
        try:
            current = self._snapshot_signature(path.stat())
        except OSError:
            return None
        cached = self._transcript_snapshots.get(path)
        if (cached and cached[0] == current
                and (cached[1]["mail_complete"] or not include_mail)):
            return cached[1]
        read = self._stable_transcript_snapshot(path, include_mail)
        if not read:
            return None
        signature, fact = read
        self._transcript_snapshots[path] = (signature, fact)
        return fact

    def _window_start(self, path):
        """Return agentName, teamName, and UUID from the restored window root.

        Claude Code 2.1.220 selects the timestamp-latest user or assistant leaf
        named by any `last-prompt` record, walks `parentUuid` to the root, and
        adopts the root's complete identity pair. Restored identity and launch
        validation share one full-file snapshot and this walk. A corrupt chain
        can trigger Claude Code's timestamp fallback, which lies outside this
        reconstruction.
        """
        fact = self._transcript_snapshot(path)
        return fact["start"] if fact else None

    @staticmethod
    def _last_stamp(path, since_ms):
        """(timestamp, agentName, teamName) of the last stamped record written at
        or after `since_ms`, or None.

        A process stamps every line it writes with the team it operates as, so
        a stamp written after it started is its own statement of that team. A
        transcript is only appended to, so it is read backward from the end and
        the read stops at the first record written before `since_ms`: what a
        process wrote since it started is all that is read, however long the
        conversation behind it.
        """
        try:
            size = path.stat().st_size
            handle = path.open("rb")
        except OSError:
            return None
        carry, at = b"", size
        with handle:
            while at or carry:
                if at:
                    take = min(INDEX_CHUNK, at)
                    at -= take
                    handle.seek(at)
                    lines = (handle.read(take) + carry).split(b"\n")
                    carry = lines.pop(0) if at else b""
                else:
                    lines, carry = [carry], b""
                for raw in reversed(lines):
                    if b'"timestamp"' not in raw:
                        continue
                    try:
                        record = json.loads(raw)
                    except ValueError:
                        continue
                    written_at = (iso_ms(record.get("timestamp"))
                                  if isinstance(record, dict) else None)
                    if not written_at:
                        continue
                    if written_at < since_ms:
                        return None
                    stamp = _identity_stamp(record)
                    if stamp.get("teamName"):
                        return written_at, stamp.get("agentName"), stamp["teamName"]
        return None

    @staticmethod
    def _mount_rule(stamped, argv_team, judge):
        """Apply Claude Code's mount order to the two teams a process can take.

        At mount a process takes its argv team when that config loads, then
        adopts its window root's team when that config loads, so a stamped team
        that loads wins over argv. A process has no team context when neither
        its argv team nor its stamped team loads. `judge(team)` answers
        ("yes" | "no" | "unknown", why) for one team. Returns (team, rule,
        possible, why): `rule` is stamped, argv, none, unknown or plain (no
        candidate at all), and `possible` lists the teams an unknown leaves open.
        """
        said = []
        if stamped:
            verdict, why = judge(stamped)
            said.append(f"the teamName in the first record of its restored window is "
                        f"{stamped}, and {why}")
            if verdict == "yes":
                return stamped, "stamped", (stamped,), said[0]
            if verdict == "unknown":
                open_argv = (argv_team,) if argv_team and judge(argv_team)[0] != "no" else ()
                return None, "unknown", (stamped,) + open_argv, said[0]
        if not argv_team:
            return None, "plain", (), "; ".join(said)
        verdict, why = judge(argv_team)
        said.append(f"its argv names {argv_team}, and {why}")
        if verdict == "yes":
            return argv_team, "argv", (argv_team,), "; ".join(said)
        if verdict == "unknown":
            return None, "unknown", (argv_team,), "; ".join(said)
        return None, "none", (), "; ".join(said) + ", so it took no team"

    def _loads_now(self, team, census=None):
        """("yes" | "no", why) for whether a process mounting now loads `team`.

        A team config loads when it parses as a JSON object, as Claude Code's
        reader requires, so an unparsable file loads no more than an absent one.
        """
        state = self._roster_snapshot(team, census).state
        return (("yes", f"{team}'s config parses") if state == "valid"
                else ("no", f"{team}'s config is {state}"))

    def _retired_at(self, team):
        """When this tool last retired `team`, from its reap receipt, or None."""
        try:
            receipt = json.loads((RECEIPTS_DIR / f"{team}.json").read_text())
        except (OSError, ValueError):
            return None
        at = receipt.get("at") if isinstance(receipt, dict) else None
        return at if type(at) is int else None

    def _loaded_at_start(self, team, start_ms, census=None):
        """("yes" | "no" | "unknown", why) for whether `team` loaded at a mount.

        A process mounts its team context once, shortly after it starts. Its
        config could have loaded then when it parses now and either its bytes
        were written before the start or its createdAt is earlier. A createdAt
        later than the start by more than TEAM_MINT_WINDOW_MS, the bound this
        module also gives a boot's own team work, is a config that appeared
        after the mount; whether an earlier config of the team was there at
        the mount is another question. This tool's reap receipt says when it
        last retired the team: after the start means the team existed while
        the process ran and the config there now is a new one, so the mount
        stays unknown. An absent or unparsable config may have loaded and gone
        since, so it, an unknown start, and a creation inside that window
        decide nothing.
        """
        roster = self._roster_snapshot(team, census)
        if roster.state != "valid":
            return "unknown", (f"{team}'s config is {roster.state} now, and nothing "
                               "records whether it loaded when the process started")
        if not start_ms:
            return "unknown", "the process start time is unknown"
        observed = roster.observation
        if observed is not None and observed.physical and roster.mtime <= start_ms:
            return "yes", f"{team}'s config was last written before the process started"
        created = roster.data.get("createdAt")
        if type(created) is int and created <= start_ms:
            return "yes", f"{team} was created before the process started"
        if type(created) is int and created > start_ms + TEAM_MINT_WINDOW_MS:
            retired = self._retired_at(team)
            if retired and retired > start_ms:
                return "unknown", (f"{team} was created again after this tool retired it "
                                   "while the process ran, so the config the process "
                                   "could have mounted is not the one there now")
            return "no", f"{team} was created after the process started"
        return "unknown", f"{team} appeared too close to the process start to tell"

    def _restore_fact(self, path, census=None):
        """Return the identity a process launched now on this transcript comes back as.

        The launch has not mounted yet, so the census it was planned with is what
        its mount reads. `restored` means the window root's team loads and takes
        over from argv; `stamped-team-missing` means it does not, so argv
        identity applies; None means the window start has no complete pair.
        """
        start = self._window_start(path) if path else None
        if not start:
            return immutable({
                "name": None, "team": None, "agentId": None,
                "root_uuid": None, "state": None,
            })
        name, team, uuid = start
        _team, rule, _possible, _why = self._mount_rule(
            team, None, lambda candidate: self._loads_now(candidate, census))
        return immutable({
            "name": name,
            "team": team,
            "agentId": agent_id_of(name, team),
            "root_uuid": uuid,
            "state": "restored" if rule == "stamped" else "stamped-team-missing",
        })

    def restore_answer(self, launch):
        """Return what a launch's process comes back as, for its own census."""
        return self._restore_fact(launch["transcript"]["path"],
                                  launch["roster"]["census"])

    def _boot_ms(self):
        """When this machine booted, in epoch milliseconds, or 0 if unreadable.

        /proc/uptime counts to the hundredth of a second, where /proc/stat's
        btime counts whole seconds.
        """
        if self._boot_time is None:
            try:
                uptime = float(Path("/proc/uptime").read_text().split()[0])
                self._boot_time = int(time.time() * 1000 - uptime * 1000)
            except (OSError, ValueError, IndexError):
                self._boot_time = 0
        return self._boot_time

    def _process_start_ms(self, record):
        """When one process started, in epoch milliseconds, or None if unknown.

        The kernel's start time counts clock ticks from boot and exists for every
        live process; a session registry record's startedAt, written once the
        process is up, is the fallback for a record when its kernel start was
        not read.
        """
        ticks = (record or {}).get("proc_start")
        boot = self._boot_ms()
        if boot and isinstance(ticks, str) and ticks.isdigit():
            return boot + int(ticks) * 1000 // os.sysconf("SC_CLK_TCK")
        return (record or {}).get("started") or None

    def _operating_team(self, pid, snapshot, census=None):
        """Which team live process `pid` operates as, and how that is known.

        A teammate reads its inbox from the team it operates as and sends to its
        argv team. Claude Code fixes the first at mount (see mount_rule) and
        stamps every line the process writes with it; a lead's spawn payloads
        name it too. Lines and spawns the process wrote after it started decide,
        and only they are exact. Otherwise the mount rule is applied to whether
        each candidate config could have loaded when the process started, and a
        process with no argv or stamped team takes the implicit team created
        within TEAM_MINT_WINDOW_MS before it started, when no other process
        started that soon after that team and no other team it could have
        created was created that soon before it. Spawns written by earlier
        processes on the same transcript say nothing about this one. When the
        evidence does not decide, `team` is None and `possible` names the teams
        left open.
        """
        # Kept per retained snapshot and census, which the answer read; with no
        # census the rosters are read now, so nothing is kept.
        key = (pid, id(snapshot), id(census))
        held = self._operating_answers.get(key) if census is not None else None
        if held and held[0] is snapshot and held[1] is census:
            return held[2]
        record = next((entry for entry in snapshot["live_sessions"]
                       if entry["pid"] == pid), None)
        argv_team = (record or {}).get("team")
        session = (record or {}).get("session")
        path = self._transcript_path(session) if session else None
        start_ms = self._process_start_ms(record) if record else None

        def answer(team, exact, rule, basis, possible=()):
            return immutable({
                "pid": pid, "team": team, "exact": exact, "rule": rule,
                "basis": basis, "possible": (team,) if team else tuple(possible),
                "argv_team": argv_team, "session": session, "start": start_ms,
            })

        found = None
        if record is None:
            found = answer(None, False, "unknown", "no live process record")
        holders = ((snapshot.get("transcripts") or {}).get(session) or {}).get(
            "processes", ()) if session else ()
        sole = all(row["pid"] == pid for row in holders)
        if found is None and path and start_ms and sole:
            written = []
            last = self._last_stamp(path, start_ms)
            if last:
                written.append((last[0], last[2],
                                f"the lines it wrote since it started are stamped {last[2]}"))
            for stamp, payload in self._log(session):
                if payload.get("team_name") and stamp and stamp >= start_ms:
                    written.append((stamp, payload["team_name"],
                                    f"it spawned into {payload['team_name']} after it started"))
            if written:
                _at, team, basis = max(written, key=lambda item: item[0])
                found = answer(team, True, "written", basis)
        if found is None:
            # The window root is read only now, when the transcript records the
            # process wrote since it started have not decided: finding it walks
            # the whole transcript.
            window = self._window_start(path) if path else None
            team, rule, possible, why = self._mount_rule(
                window[1] if window else None, argv_team,
                lambda candidate: self._loaded_at_start(candidate, start_ms, census))
            if rule != "plain":
                found = answer(team, False, rule, why, possible)
            else:
                paired = self._sole_mint_pairing(pid, snapshot, census)
                if paired:
                    window_s = TEAM_MINT_WINDOW_MS // 1000
                    found = answer(paired, False, "paired",
                                   f"it is the only process that started within {window_s} s "
                                   f"after {paired} was created, and {paired} is the only team "
                                   f"it could have created that was created within {window_s} s "
                                   "before it started")
                else:
                    candidates = self._mint_candidates(pid, snapshot, census)["teams"]
                    open_teams = tuple(sorted({
                        team for team, owner, _ in self._boot_join(snapshot, census)
                        if owner == pid and team in candidates}))
                    found = answer(None, False, "unknown", "; ".join(filter(None, (
                        why, "its start time singles out no team it could have created: "
                        f"that needs exactly one such team created within "
                        f"{TEAM_MINT_WINDOW_MS // 1000} s before it started, and no other "
                        f"process started within {TEAM_MINT_WINDOW_MS // 1000} s after that "
                        "team was created"))),
                        open_teams)
        if census is not None:
            self._operating_answers[key] = (snapshot, census, found)
        return found

    def _live_led(self, stem, table=None):
        """Return teams led by this transcript that have live members.

        Placement consumes the complete list, and demotion uses it to preserve
        live team members.
        """
        live = {entry["team"] for entry in self._runtime(table)["live_sessions"]
                if entry.get("team")}
        return tuple(team for team in self._teams_led_by(stem) if team in live)

    def _demote_subject(self, selector):
        """(path, name, team) for the transcript a demote names.

        The engine picks the transcript and reads its identity; the verb only
        consumes the answer.
        """
        path = self._transcript_path(selector)
        if not path:
            return None, None, None
        fields, _ts = self._scan_transcript(path)
        return (path, fields.get("agentName", (None,))[0],
                fields.get("teamName", (None,))[0])

    def _demotion_parent(self, path, mate, mate_team, into=None, table=None,
                        census=None):
        """Return one immutable parent selection for a demotion."""
        path = Path(path)
        census = self._roster_census() if census is None else self._retained_census(census)
        if into:
            parent = into
            fact = self._transcript_fact(parent)
            return immutable({
                "parent": parent,
                "fact": fact,
                "source": "--into-session",
                "confirmation_required": False,
                "objection": None,
                "remedy": None,
            })
        receipt = self._receipt_carried_by(path)
        if (receipt and receipt.get("direction") == "promote"
                and receipt.get("parent")):
            parent = receipt["parent"]
            return immutable({
                "parent": parent,
                "fact": self._transcript_fact(parent),
                "source": "the latest promotion receipt",
                "confirmation_required": False,
                "objection": None,
                "remedy": None,
            })
        if not mate_team:
            objection = self._demotion_parent_objection(path, receipt)
            return immutable({
                "parent": None, "fact": None, "source": None,
                "confirmation_required": False,
                "objection": objection,
                "remedy": "pass --into-session <session>",
            })
        description = self._team_description(
            mate_team, table=table, census=census)
        lead = (description["lead_fact"] or {}).get("path")
        if not lead:
            objection = (f"no promotion receipt; "
                          f"{description['lead_resolution'].reason}")
            return immutable({
                "parent": None, "fact": None, "source": None,
                "confirmation_required": False,
                "objection": objection,
                "remedy": "pass --into-session <session>",
            })
        if lead == path:
            objection = (f"no promotion receipt, and this transcript is itself the "
                          f"lead of {mate_team}")
            return immutable({
                "parent": None, "fact": description["lead_fact"], "source": None,
                "confirmation_required": False,
                "objection": objection,
                "remedy": "pass --into-session <session>",
            })
        return immutable({
            "parent": lead.stem,
            "fact": description["lead_fact"],
            "source": f"team lead of {mate_team}",
            "confirmation_required": True,
            "objection": None,
            "remedy": f"pass --into-session {lead.stem} explicitly",
        })

    def _demotion_parent_objection(self, source, carried):
        """Resolve the complete objection when a demote has no parent answer."""
        if carried is not None:
            why = "the last conversion record it carries names no parent session"
        else:
            why = ("it carries no conversion record, so nothing in the transcript "
                   "says where it came from")
        name, team = self._stamp_index().get(Path(source)) or (None, None)
        if not (name and team):
            return (f"demote needs the parent session (--into-session): {why}, and it "
                    "carries no agent stamps to look a spawn payload up by")
        agent_id = agent_id_of(name, team)
        parent, _how = self._spawn_parent_of(agent_id)
        if parent:
            return (f"demote needs the parent session (--into-session): {why}. The spawn "
                    f"payload naming {agent_id} is in {parent}, so that is the "
                    "likely --into-session")
        return (f"demote needs the parent session (--into-session): {why}, and no spawn "
                f"payload names {agent_id}")

    def _rebind_fragility(self, stem, team, census=None):
        """Return the compaction remedy for a temporary argv-based rebind.

        Recreating the stamped team would make window-start identity active again.
        Compaction under the destination team makes that identity durable.
        """
        path = self._transcript_path(stem) if stem else None
        restored = self._restore_fact(path, census)
        stamped, state = restored["team"], restored["state"]
        if state == "stamped-team-missing" and stamped and stamped != team:
            return (f"this conversation still restores with stamps naming {stamped}; "
                    f"recreating that team reactivates them. Run /compact under {team} "
                    "to make the destination identity durable. Mail works during the "
                    "current process life")
        return None

    def _reap_plan(self, team):
        """Return one exact team retirement cut and receipt input."""
        team_dir = self._team_dir(team)
        mine, strays = self._scaffolding_and_strays(team_dir)
        return immutable({
            "kind": "team",
            "team": team,
            "path": team_dir,
            "staged": staged_path(team_dir),
            "generation": self._directory_generation(team_dir),
            "receipt_path": RECEIPTS_DIR / f"{team}.json",
            "receipt_contents": immutable(self._receipt_contents(team_dir)),
            "tool_files": tuple(path.relative_to(team_dir) for path in mine),
            "strays": tuple(strays),
            "objections": (),
        })

    def _archive_inbox_plan(self, team, name):
        """Return one exact mailbox archive cut."""
        team_dir = self._team_dir(team)
        box = self._inbox_path(team, name)
        key = f"inboxes/{box.name}"
        contents = self._receipt_contents(team_dir, only=box.name)
        read = contents.get(key)
        return immutable({
            "kind": "inbox",
            "team": team,
            "name": name,
            "path": box,
            "staged": staged_path(box),
            "generation": self._file_generation(box),
            "receipt_key": key,
            "receipt_contents": immutable(contents),
            "present": bool(read and read["size"] is not None),
            "objections": (),
        })

    def revalidate_reap(self, plan, staged=None, expected_generation=None):
        """Compare one retirement or mailbox cut without selecting another path."""
        path = Path(staged) if staged is not None else plan["path"]
        current = (self._directory_generation(path) if plan["kind"] == "team"
                   else self._file_generation(path))
        expected = (plan["generation"] if expected_generation is None
                    else expected_generation)
        contents = (self._receipt_contents(path) if plan["kind"] == "team" else
                    self._receipt_contents(
                        path.parent.parent, only=path.name))
        if plan["kind"] == "team":
            mine, strays = self._scaffolding_and_strays(path)
            tool_files = tuple(item.relative_to(path) for item in mine)
        else:
            tool_files, strays = (), ()
        return immutable({
            "matches": current == expected,
            "changed": () if current == expected else
                       (f"{plan['kind']} generation {plan['team']}",),
            "selected": expected,
            "current": current,
            "contents": immutable(contents),
            "tool_files": tool_files,
            "strays": tuple(strays),
        })

    @staticmethod
    def _file_identity(path):
        """Which file a path names, as (device, inode), or ("absent",).

        Appending keeps a file's identity, and replacing or removing it does
        not. A working lead appends to its transcript all the time, so a plan
        that names that transcript compares this, not its bytes.
        """
        try:
            stat = Path(path).stat()
        except OSError:
            return ("absent",)
        return (stat.st_dev, stat.st_ino)

    def _destination_answer(self, team, source, table=None, census=None):
        """Whether a member of `source` can be moved onto `team`.

        A moved member needs the team's roster and a selected lead session for
        its parent. Every decision that moves members asks here, explicit, live
        and automatic, and so does every report that offers a move, since it
        offers what that decision would do. `refusal` is why the move cannot be
        made, or None; `objections` refuse a move asked for with --into-team,
        so their way out says to drop that flag to stay where the member is.
        """
        roster = self._roster_snapshot(team, census)
        parent = (self._lead_session_for(team, table=table, census=census)
                  if roster.state == "valid" else None)
        refusal = (f"no team config at {roster.path}" if roster.state != "valid"
                   else None if parent else f"team {team} has no selected lead session")
        objections = (() if refusal is None else (refusal,) if roster.state != "valid"
                      else (f"{refusal}; drop --into-team and pass --keep-team to stay "
                            f"on {source}, or pass --into-team a team that has one",))
        return immutable({"team": team, "roster": roster, "parent": parent,
                          "refusal": refusal, "objections": objections})

    def _lead_destination(self, source, lead, table=None, census=None):
        """The team a member of `source` would follow its live lead onto.

        The lead's operating team, judged by destination_answer once the lead
        is known to be live and its team known. `objections` are what refuse
        `--into-team live`.
        """
        team = lead["runs_as"]
        target = (self._destination_answer(team, source, table, census)
                  if team and lead["pid"] and lead["alive"] else None)
        if not (lead["pid"] and lead["alive"]):
            refusal = f"no live lead for team {source}"
        elif not team:
            refusal = f"cannot tell which team pid {lead['pid']} runs as"
        else:
            refusal = target["refusal"]
        objections = (target["objections"] if target else
                      (f"{refusal}; pass --into-team <name> explicitly",))
        return immutable({
            "team": team, "exact": bool(team and lead["runs_as_exact"]),
            "how": lead["how"], "roster": target["roster"] if target else None,
            "parent": target["parent"] if target else None,
            "refusal": refusal, "objections": objections,
        })

    def _move_offer(self, source, kind, lead, movers, table, census, destination=None,
                    single=False, ended=()):
        """The planner's decision for one move a report offers, under the fewest flags.

        The move is decided as given, then with --with-mail, which archives the
        mail that retiring `source` would otherwise drop, and, for a move of one
        member (`single`), with --force, which rewrites that conversation
        instead of retiring the team. `flags` are the first under which the
        decision moves at least one member; None means no flag does, and
        `plain`, the decision as given, and `last`, the one under the most
        flags, say why. `ended` are processes an earlier step ends first.
        """
        trials = ((), ("--with-mail",)) + ((("--force",),) if single else ())
        plain = None
        for flags in trials:
            decision = self._team_redirect(source, MemberRedirectRequest(
                kind=kind, destination=destination,
                archive_mail="--with-mail" in flags, force="--force" in flags),
                lead, movers, table, census, ended=ended)
            plain = plain or decision
            if decision["action"] == "redirect" and decision["moving"]:
                return immutable({"flags": flags, "decision": decision,
                                  "plain": plain, "last": decision})
        return immutable({"flags": None, "decision": None, "plain": plain,
                          "last": decision})

    def _team_moves(self, team, lead, table, census, runtime=None):
        """What the planner does with the two moves a report offers a team.

        `automatic` is the run of the team with --all, which starts its
        stopped members on the team their lead runs as, and `live` the run
        with --into-team live --all, which restarts the running ones too:
        each the decision team_run_plan makes for that command now
        (move_offer), so the doctor offers a move only as the planner would
        make it. --all, because a run without it starts only the members that
        are running while any are, and nobody reads the mail of the members it
        leaves behind. `runtime` is the team's, from a member answer
        with its transcripts resolved, as team_run_plan reads it.
        """
        if runtime is None:
            runtime = self._team_runtime(team, table, census=census, member_answer=(
                self._team_members(team, table, census, enrich=True)))
        ordered, _former, _live = self._team_jobs(team, runtime, all_members=True)
        movers = self._team_movers(runtime, ordered, table, census)
        return immutable({kind: self._move_offer(team, kind, lead, movers, table, census)
                          for kind in ("automatic", "live")})

    def _crew_move(self, source, dest, rebind, ended, table, census):
        """What the planner would do with the crew a lead move leaves on `source`.

        The move is the run of SOURCE with --into-team DEST --all, decided
        (move_offer) for the world the lead move leaves: the processes it ends
        are gone, and when it retires `source`, that roster with them. The crew
        report offers it only as the planner would make it, and says why not
        otherwise.
        """
        after = (self._update_census(census, self._roster_in(rebind["reap"]["path"]))
                 if rebind and rebind["action"] == "reap" else census)
        runtime = self._team_runtime(source, table, census=after, member_answer=(
            self._team_members(source, table, after, enrich=True)))
        ordered, _former, _live = self._team_jobs(source, runtime, all_members=True)
        offer = self._move_offer(
            source, "explicit", runtime["lead"],
            self._team_movers(runtime, ordered, table, after), table, after,
            destination=dest, ended=ended)
        return immutable({**offer, "refusal": (None if offer["flags"] is not None
                                               else self._move_refusal(source, offer))})

    @staticmethod
    def _launch_mover(launch):
        """One member a run would launch, as team_redirect reads it."""
        holders = launch["process"]["holders"]
        owner = launch["process"]["snapshot"]["best_by_session"].get(launch["session"])
        runtime = launch["process"]["runtime"] or {}
        held = tuple(holders["others"]) + tuple(holders["ours"])
        return immutable({
            "agent_id": launch["identity"]["agentId"],
            "path": launch["transcript"]["path"],
            "running": bool(held or (owner and owner["alive"])
                            or runtime.get("external")),
            "holders": tuple(row["pid"] for row in holders["others"]),
            "ours": tuple(row["pid"] for row in holders["ours"]),
        })

    def _team_redirect(self, source, request, lead, movers, table, census, ended=()):
        """The one redirect decision for the members a run launches from `source`.

        Made before any member launches: where they go, whether the team their
        stamps restore them as is retired, and whether a person must confirm,
        once for the run. member_redirect_plan carries it out for each member, so
        no member's step decides the team's fate again. `movers` are the members
        the run would launch (launch_mover rows). An automatic move leaves a
        running member where it is; an explicit or live one restarts it. A
        running member has already moved when all its live processes operate as
        the destination, whatever roster still lists it: it is `arrived`, and
        the run neither starts, stops nor counts it as staying. `ended` are
        processes an earlier step ends before this decision is carried out, as
        a lead move does before its crew moves.
        """
        kind = request.kind
        objections, reason, confirmation, action = [], None, "accepted", None
        follow = (self._lead_destination(source, lead, table, census)
                  if kind in ("live", "automatic") else None)
        destination = follow["team"] if follow else request.destination
        if follow:
            reason = lead["how"]
        proposed = destination
        snapshot = self._runtime(table)

        def operates_as(row):
            """The one team every live process of this member operates as, or None."""
            teams = {team for pid in row["holders"] + row["ours"]
                     for team in self._operating_team(pid, snapshot, census)["possible"]}
            return next(iter(teams)) if len(teams) == 1 else None

        arrived = tuple(row for row in movers
                        if row["running"] and destination and destination != source
                        and operates_as(row) == destination)
        moving = tuple(row for row in movers if row not in arrived
                       and (kind != "automatic" or not row["running"]))
        everyone_arrived = bool(arrived) and len(arrived) == len(movers)
        # A running member that moves is restarted, so its process is ended
        # before the team is retired (settle_stops); this process is one no
        # move can end, so a member held by it refuses the move outright.
        stops = tuple(immutable({"agent_id": row["agent_id"],
                                 "process": snapshot["by_pid"][pid]})
                      for row in moving for pid in row["holders"]
                      if pid in snapshot["by_pid"])
        for row in moving:
            for pid in row["ours"]:
                objections.append(
                    f"you are running {row['agent_id']}'s conversation yourself (pid "
                    f"{pid}); nothing can replace a process from inside it. Exit it "
                    "first, or have the lead run this")
        if kind == "automatic":
            if request.keep_team or not source:
                action = "stay"
                reason = "--keep-team" if request.keep_team else "no source team"
            elif not (lead["pid"] and lead["alive"] and lead["exact"]):
                action, reason = "stay", "the source lead is not known exactly"
            elif not destination:
                action, reason = "stay", "the source lead's current team is unknown"
            elif destination == source:
                action = "stay"
            elif not moving:
                action, reason = "stay", (f"it already runs as {destination}"
                                          if everyone_arrived else
                                          "the member is already running")
            elif follow["roster"].state != "valid":
                action, reason = "stay", "the lead's team has no destination roster"
            elif not follow["parent"]:
                # Blocked rather than a quiet stay: starting a member where its
                # lead does not read mail is the question decline_unreachable asks.
                action, reason = "blocked", (f"{follow['refusal']}; pass --keep-team to "
                                             f"stay on {source}, or --into-team <name>")
            elif not follow["exact"]:
                confirmation = "pending"
        # Why the destination refuses the move, when its objection is one of
        # them, so a report can say so without the flag advice in the objection.
        refusal = None
        if kind == "live" and destination != source and not everyone_arrived:
            objections.extend(follow["objections"])
            refusal = follow["refusal"]
        if kind != "automatic" and everyone_arrived:
            action, reason = "stay", f"it already runs as {destination}"
        if action == "stay" or (action is None and destination == source):
            action, destination = "stay", source
        target = (follow if follow and destination == follow["team"] else
                  self._destination_answer(destination, source, table, census)
                  if destination else None)
        destination_roster = target["roster"] if target else None
        parent = target["parent"] if target else None
        if kind == "explicit" and destination != source:
            objections.extend(target["objections"])
            refusal = target["refusal"]
        stamped, rebind = None, None
        if action is None and not objections:
            restoring = {}
            for row in moving:
                fact = self._restore_fact(row["path"], census)
                if fact["state"] == "restored" and fact["team"] != destination:
                    restoring.setdefault(fact["team"], []).append(row["agent_id"])
            if len(restoring) > 1:
                objections.append(
                    f"the members come back as {some_of(sorted(restoring))}, which "
                    "would each need retiring; move one team's members at a time")
            elif restoring:
                stamped = next(iter(restoring))
                # A process this run is itself cannot be ended to move it, so
                # it stays among the objections to retiring its team.
                rebind = self._rebind_plan(
                    stamped, destination, None, table, census=census,
                    force=request.force, archive_mail=request.archive_mail,
                    cleared_pids=tuple(pid for row in moving for pid in row["holders"])
                    + tuple(ended))
        if objections or (rebind and rebind["action"] == "blocked"):
            action = "blocked"
        census_after = (self._update_census(census, self._roster_in(rebind["reap"]["path"]))
                        if rebind and rebind["action"] == "reap" else census)
        return immutable({
            "kind": kind,
            "source": source,
            "proposed_destination": proposed,
            "destination": destination,
            "reason": reason,
            "confirmation": confirmation,
            "action": action or "redirect",
            "parent": parent,
            "destination_roster": destination_roster,
            "lead": lead,
            "movers": tuple(movers),
            "moving": moving,
            "stops": stops,
            "arrived": arrived,
            "arrived_team": proposed if arrived else None,
            "stamped": stamped,
            "rebind": rebind,
            "census": census,
            "census_after": census_after,
            "objections": tuple(objections),
            "refusal": refusal,
        })

    def member_redirect_plan(self, launch, request):
        """Return one immutable member redirect selection from retained launch facts.

        Where the members go and whether their team is retired is the run's
        team_redirect decision: the one a team run made before its first member,
        carried in `request.team` with the answer the run got for it, or this
        member's own when it is the whole run. This plan carries that decision
        out for one member: its launch on the destination, the holders it stops,
        and, under --force, the restamp of its own conversation.
        """
        if not isinstance(request, MemberRedirectRequest):
            raise TypeError("member_redirect_plan requires MemberRedirectRequest")
        source = launch["identity"]["teamName"]
        lead = launch["process"]["lead"]
        census = launch["roster"]["census"]
        table = launch["process"]["table"]
        snapshot = launch["process"]["snapshot"]
        mover = self._launch_mover(launch)
        team = request.team or self._team_redirect(
            source, request, lead, (mover,), table, census)
        objections = list(team["objections"])
        if launch["identity"]["role"] == "lead":
            objections.append("member redirect cannot select a lead launch")
        action, reason = team["action"], team["reason"]
        destination, confirmation = team["destination"], team["confirmation"]
        declined = False
        if request.team is not None:
            # The run asked its one question before the first member.
            confirmation = "accepted"
            if request.team_answer in ("stay", "declined"):
                declined = request.team_answer == "declined"
                action, destination = "stay", source
                reason = ("starts where its lead does not read mail, as agreed for the team"
                          if declined else "the run declined the redirect for the team")
            elif action == "redirect" and request.kind == "automatic" and mover["running"]:
                action, destination = "stay", source
                reason = "the member is already running"
        arrived = (team["arrived_team"] if any(row["agent_id"] == mover["agent_id"]
                                               for row in team["arrived"]) else None)
        if arrived:
            # Already running as the team its lead runs as: the decision leaves
            # it there, so this member is neither started nor kept on the source.
            action, destination, confirmation = "stay", source, "accepted"
            reason = f"it already runs as {arrived}"
        destination_roster = (self._roster_snapshot(destination, census)
                              if destination else None)
        if (destination and destination != source and action != "blocked"
                and destination_roster.state != "valid"):
            objections.append(f"no team config at {destination_roster.path}")
        parent = (team["parent"] if destination == team["destination"] else
                  self._lead_session_for(destination, table=table, census=census)
                  if destination else None)
        parent_fact = self._transcript_fact(parent) if parent else None
        parent_identity = (self._file_identity(parent_fact["path"])
                           if parent_fact else ("absent",))
        rebind = None
        team_rebind = team["rebind"]
        if action != "stay" and team_rebind is not None:
            if team_rebind["action"] == "restamp":
                fact = self._restore_fact(launch["transcript"]["path"], census)
                if fact["state"] == "restored" and fact["team"] != destination:
                    rebind = self._rebind_plan(
                        fact["team"], destination, launch["transcript"]["path"], table,
                        census=census, force=request.force,
                        archive_mail=request.archive_mail,
                        cleared_pids=mover["holders"], mode="restamp")
            elif request.team is None or team_rebind["action"] == "blocked":
                # A team run retires the team itself before its first member, so
                # only a run of one member, or a refusal, reaches the member here.
                rebind = team_rebind

        route = {
            "to_team": destination if destination != source else None,
            "to_lead": parent,
            "automatic": request.kind == "automatic",
        }
        redirected = (self._retarget_launch(
            launch, team=destination, parent=parent,
            source=("automatic lead redirect" if request.kind == "automatic"
                    else "explicit --into-team"),
            route=route, census=census)
                      if destination and destination != source else launch)
        # The identity it already runs under, for the report and the roster
        # that lists it there; nothing is launched with it.
        arrived_launch = (self._retarget_launch(
            launch, team=arrived,
            parent=self._destination_answer(arrived, source, table, census)["parent"],
            source="already running there", route={"arrived": arrived}, census=census)
                          if arrived else None)
        holders = launch["process"]["holders"]
        if request.team is not None and team["stops"]:
            # The run ended these before its first member (settle_stops), so
            # this member's step neither asks about them nor ends them again.
            settled = {stop["process"]["pid"] for stop in team["stops"]}
            holders = immutable({**holders, "others": tuple(
                row for row in holders["others"] if row["pid"] not in settled)})
        holder_processes = tuple(holders["others"] + holders["ours"])
        action = ("blocked" if objections or action == "blocked" else
                  "stay" if destination == source else
                  "blocked" if rebind and rebind["action"] == "blocked" else
                  "migrate" if holder_processes else "redirect")
        lead_agent = agent_id_of("team-lead", destination) if destination else None
        lead_generation = self._runtime_generation(
            snapshot,
            agent_ids=(lead_agent,) if lead_agent else (),
            sessions=(parent,) if parent else (),
            teams=(destination,) if destination else ())
        return immutable({
            "request": request,
            "team": team,
            "launch": launch,
            "declined_launch": self._set_effective_identity(
                launch, route={"stale_team_warned": True}),
            "declined": declined,
            "arrived": arrived,
            "arrived_launch": arrived_launch,
            "redirected_launch": redirected,
            "kind": request.kind,
            "source": source,
            "proposed_destination": team["proposed_destination"],
            "destination": destination,
            "reason": reason,
            "confirmation": confirmation,
            "effective_identity": redirected["identity"],
            "parent": parent,
            "source_roster": launch["roster"].get("destination"),
            "destination_roster": destination_roster,
            "parent_fact": parent_fact,
            "parent_identity": parent_identity,
            "lead": lead,
            "lead_generation": lead_generation,
            "holders": holders,
            "holder_processes": holder_processes,
            "mailbox_generation": (rebind or {}).get("mailbox_generation"),
            "rebind": rebind,
            "action": action,
            "completion_intent": {
                "identity": redirected["identity"],
                "route": redirected["route"],
                "destination": redirected.get("destination"),
                "launch_action": redirected.get("launch_action"),
            },
            "placement_generation": ((redirected.get("launch_action") or {}).get(
                "generation")),
            "objections": tuple(objections),
        })

    def revalidate_member_redirect(self, plan, confirmation=True, after_clear=False):
        """Compare retained member redirect facts without selecting another route."""
        if not confirmation or plan["action"] == "stay":
            return immutable({
                "matches": True, "changed": (), "confirmation": bool(confirmation),
                "launch": plan["launch"],
            })
        changed = []
        destination = self._roster_snapshot(plan["destination"])
        if destination.observation != plan["destination_roster"].observation:
            changed.append(f"destination roster {plan['destination']}")
        # The lead's transcript is compared by identity: a working lead appends
        # to it all the time, and that changes nothing this plan selected.
        current_parent = (self._file_identity(plan["parent_fact"]["path"])
                          if plan["parent_fact"] else ("absent",))
        if current_parent != plan["parent_identity"]:
            changed.append(f"lead transcript {plan['parent']}")
        table = self._process_table(refresh=True)
        snapshot = self._runtime(table)
        lead_agent = agent_id_of("team-lead", plan["destination"])
        current_lead = self._runtime_generation(
            snapshot, agent_ids=(lead_agent,),
            sessions=(plan["parent"],) if plan["parent"] else (),
            teams=(plan["destination"],))
        if current_lead != plan["lead_generation"]:
            changed.append(f"destination lead {plan['destination']}")
        for selected in plan["holder_processes"]:
            current = snapshot["by_pid"].get(selected["pid"])
            if after_clear:
                if current is not None:
                    changed.append(f"selected holder pid {selected['pid']} remains")
            elif (current is not None
                  and self._process_fact_signature(current)
                  != self._process_fact_signature(selected)):
                changed.append(f"selected holder pid {selected['pid']} was reused")
        if plan["rebind"] and not after_clear:
            nested = self._revalidate_rebind(plan["rebind"])
            changed.extend(nested["changed"])
        if not after_clear:
            placement = self.revalidate_launch(plan["redirected_launch"])
            changed.extend(placement["changed"])
        return immutable({
            "matches": not changed,
            "changed": tuple(dict.fromkeys(changed)),
            "confirmation": bool(confirmation),
            "launch": plan["redirected_launch"],
            "snapshot": snapshot,
        })

    def complete_member_migration(self, applied):
        """Verify selected member migration effects and return its complete launch."""
        if not isinstance(applied, Applied) or applied.operation != "member-redirect":
            raise TypeError("complete_member_migration requires member redirect Applied")
        plan = applied.plan
        if not applied.confirmation:
            return immutable({
                "launch": plan["launch"], "matches": True,
                "changed": (), "applied": applied,
            })
        if applied.dry_run:
            # A preview claims the move only when the durable step it previewed
            # came back as selected; otherwise the restore gate judges the launch.
            nested = plan["rebind"]
            moved = applied.durable_action == (nested["action"] if nested else None)
            selected = plan["redirected_launch"]
            census = selected["roster"]["census"]
            preview = self._complete_routed_launch(
                selected, census, selected["process"]["table"],
                selected["process"]["snapshot"],
                selected["transcript_generation"],
                {"member_moving": plan["destination"] if moved else None},
                rebind=nested if moved else None)
            return immutable({
                "launch": preview, "matches": True,
                "changed": (), "applied": applied,
            })
        changed = []
        destination = self._roster_snapshot(plan["destination"])
        if destination.observation != plan["destination_roster"].observation:
            changed.append(f"destination roster {plan['destination']}")
        # The lead's transcript is compared by identity: a working lead appends
        # to it all the time, and that changes nothing this plan selected.
        current_parent = (self._file_identity(plan["parent_fact"]["path"])
                          if plan["parent_fact"] else ("absent",))
        if current_parent != plan["parent_identity"]:
            changed.append(f"lead transcript {plan['parent']}")
        table = self._process_table(refresh=True)
        snapshot = self._runtime(table)
        lead_agent = agent_id_of("team-lead", plan["destination"])
        current_lead = self._runtime_generation(
            snapshot, agent_ids=(lead_agent,),
            sessions=(plan["parent"],) if plan["parent"] else (),
            teams=(plan["destination"],))
        if current_lead != plan["lead_generation"]:
            changed.append(f"destination lead {plan['destination']}")
        for selected in plan["holder_processes"]:
            current = snapshot["by_pid"].get(selected["pid"])
            if current is not None:
                changed.append(f"selected holder pid {selected['pid']} remains")
        selected_action = plan["redirected_launch"].get("launch_action")
        current_action = self._tmux_launch_action(
            plan["redirected_launch"].get("destination"))
        selected_generation = ((selected_action or {}).get("generation"))
        current_generation = ((current_action or {}).get("generation"))
        if current_generation != selected_generation:
            changed.append("tmux destination generation")

        nested = plan["rebind"]
        current_transcript = self._file_generation(
            plan["redirected_launch"]["transcript"]["path"])
        if nested:
            if applied.durable_action != nested["action"]:
                changed.append("durable member redirect action")
            if nested["action"] == "reap" and nested["reap"]["path"].exists():
                changed.append(f"source team {nested['source']} still exists")
            elif nested["action"] == "restamp":
                expected = _jsonl_text(
                    nested["restamp"]["lines"], nested["restamp"]["newline"]
                ).encode("utf-8")
                if not current_transcript or current_transcript[-1] != expected:
                    changed.append("selected restamp result")
        elif current_transcript != plan["redirected_launch"]["transcript_generation"]:
            changed.append("launch transcript generation")

        launch = plan["redirected_launch"]
        if not changed:
            census = launch["roster"]["census"]
            launch = self._complete_routed_launch(
                launch, census, table, snapshot, current_transcript,
                {"member_moving": plan["destination"]},
                rebind=nested)
            if launch["identity"] != plan["completion_intent"]["identity"]:
                changed.append("completed member identity")
            if launch.get("destination") is not plan["completion_intent"]["destination"]:
                changed.append("completed launch destination identity")
            if launch.get("launch_action") is not plan["completion_intent"]["launch_action"]:
                changed.append("completed launch action identity")
        return immutable({
            "launch": launch,
            "matches": not changed,
            "changed": tuple(dict.fromkeys(changed)),
            "applied": applied,
        })

    def _rebind_plan(self, source, dest, path, table, census=None, force=False,
                     archive_mail=False, cleared_pids=(), mode=None):
        """Return one immutable retirement or restamp selection.

        Retiring `source` takes its config and inboxes away, so every process
        that sends or reads as it (reap_objections) must be gone, and its mail
        archived or absent. --force instead rewrites the team this one
        conversation comes back as and leaves the team in place, so its only
        conflict is a live process holding that conversation. `mode` "restamp"
        carries out a retirement decision the run already made for the whole
        team, so one member's step does not decide the team's fate again. `path`
        is None for that team-wide decision, which no single transcript has.
        """
        table = self._retained_table(table)
        census = self._roster_census() if census is None else self._retained_census(census)
        source_roster = self._roster_snapshot(source, census)
        destination_roster = self._roster_snapshot(dest, census)
        cleared_pids = frozenset(cleared_pids)
        snapshot = self._runtime(table)
        cleared_processes = tuple(
            snapshot["by_pid"][pid] for pid in sorted(cleared_pids)
            if pid in snapshot["by_pid"])
        rows = tuple(
            row for row in self._reap_objections(
                source, table, archive_mail=archive_mail, census=census)
            if row["pid"] not in cleared_pids)
        alive = tuple(row for row in rows if row["kinds"] & {"wears", "operates"})
        mail = tuple(row for row in rows if "mail" in row["kinds"])
        stem = Path(path).stem if path else None
        held = tuple(
            immutable({
                "pid": row["pid"], "kinds": frozenset({"holds"}),
                "said": f"pid {row['pid']} holds this conversation"
                        + ("; that pid is this process" if row["ours"] else ""),
            })
            for row in ((snapshot.get("transcripts") or {}).get(stem) or {}).get(
                "processes", ())
            if stem and row["pid"] not in cleared_pids)
        action = mode or ("reap" if not rows else "restamp" if force else "blocked")
        blockers = (rows if action == "blocked" else
                    held if action == "restamp" else ())
        if blockers:
            action = "blocked"
        restamp = None
        if action == "restamp" and path is not None:
            restamp = self._rewriter.restamp_plan(
                path, dest, start=self._window_start(path))
            if restamp["objections"] or not restamp["proved"]:
                action = "blocked"
                blockers += (immutable({
                    "pid": None,
                    "kinds": frozenset({"rewrite"}),
                    "said": "; ".join(restamp["objections"])
                            or "the rewrite could not be proved",
                }),)
        transcript_generation = self._file_generation(path) if path else None
        # A restamp touches one transcript, so only its holders are compared
        # again; a retirement also needs every process wearing either team.
        process_generation = self._runtime_generation(
            snapshot, sessions=(stem,) if stem else (),
            teams=(source, dest) if action == "reap" else (),
            exclude_pids=cleared_pids)
        mailbox_generation = (self._mailbox_generation(source)
                              if action == "reap" and not archive_mail else None)
        reap = self._reap_plan(source) if action == "reap" else None
        return types.MappingProxyType({
            "source": source,
            "dest": dest,
            "path": Path(path) if path else None,
            "table": table,
            "snapshot": snapshot,
            "census": census,
            "source_roster": source_roster,
            "destination_roster": destination_roster,
            "transcript_generation": transcript_generation,
            "process_generation": process_generation,
            "mailbox_generation": mailbox_generation,
            "rows": rows,
            "held": held,
            "alive": alive,
            "mail": mail,
            "blockers": blockers,
            "action": action,
            "restamp": restamp,
            "reap": reap,
            "archive_mail": archive_mail,
            "force": force,
            "cleared_pids": cleared_pids,
            "cleared_processes": cleared_processes,
            "mode": mode,
        })

    def _revalidate_rebind(self, plan):
        """Compare generations without selecting another rebind action."""
        source = self._roster_snapshot(plan["source"])
        destination = self._roster_snapshot(plan["dest"])
        transcript = (self._file_generation(plan["path"])
                      if plan["path"] is not None else None)
        table = self._process_table(refresh=True)
        snapshot = self._runtime(table)
        process_generation = self._runtime_generation(
            snapshot,
            sessions=(plan["path"].stem,) if plan["path"] is not None else (),
            teams=((plan["source"], plan["dest"]) if plan["action"] == "reap" else ()),
            exclude_pids=plan["cleared_pids"])
        mailbox_generation = (self._mailbox_generation(plan["source"])
                              if plan["mailbox_generation"] is not None else None)
        changed = []
        for selected in plan["cleared_processes"]:
            current = snapshot["by_pid"].get(selected["pid"])
            if (current is not None
                    and self._process_fact_signature(current)
                    != self._process_fact_signature(selected)):
                changed.append(f"selected holder pid {selected['pid']} was reused")
        if source.observation != plan["source_roster"].observation:
            changed.append(f"source roster {plan['source']}")
        if destination.observation != plan["destination_roster"].observation:
            changed.append(f"destination roster {plan['dest']}")
        if transcript != plan["transcript_generation"]:
            changed.append(f"transcript {plan['path'].stem}")
        if process_generation != plan["process_generation"]:
            changed.append(f"runtime for {plan['source']} -> {plan['dest']}")
        if mailbox_generation != plan["mailbox_generation"]:
            changed.append(f"mailboxes for {plan['source']}")
        if (plan["reap"] and self._directory_generation(plan["reap"]["path"])
                != plan["reap"]["generation"]):
            changed.append(f"team directory {plan['source']}")
        return immutable({
            "matches": not changed,
            "changed": tuple(changed),
            "selected": immutable({
                "source_roster": plan["source_roster"].generation,
                "destination_roster": plan["destination_roster"].generation,
                "transcript": plan["transcript_generation"],
                "processes": plan["process_generation"],
                "mailboxes": plan["mailbox_generation"],
            }),
            "current": immutable({
                "source_roster": source.generation,
                "destination_roster": destination.generation,
                "transcript": transcript,
                "processes": process_generation,
                "mailboxes": mailbox_generation,
            }),
        })

    def lead_migration_plan(self, launch, request):
        """Return one complete immutable lead migration selection."""
        if not isinstance(request, LeadMigrationRequest):
            raise TypeError("lead_migration_plan requires LeadMigrationRequest")
        path = launch["transcript"]["path"]
        census = launch["roster"]["census"]
        restored = self._restore_fact(path, census)
        stamped, state = restored["team"], restored["state"]
        teams_led = tuple(self._teams_led_by(path.stem)) if path else ()
        source = stamped if state else next(iter(teams_led), None)
        requested = request.destination
        dest = (launch["process"]["lead"]["runs_as"]
                if requested in ("live", "auto") else requested)
        objections = []
        if launch["identity"]["role"] != "lead":
            objections.append("lead migration cannot select a member launch")
        if not dest:
            objections.append("the selected lead has no live destination team")
            dest = source
        taking_over = bool(source and source != dest)
        table = launch["process"]["table"]
        route = {
            "to_team": dest if taking_over else None,
            "to_lead": launch["session"],
            "automatic": False,
        }
        target_launch = (self._retarget_launch(
            launch, team=dest, parent=launch["session"],
            source="explicit --into-team", route=route, census=census)
                         if taking_over else launch)
        source_roster = self._roster_snapshot(source, census) if source else None
        destination_roster = self._roster_snapshot(dest, census)
        runtime = (self._team_runtime(
            source, table, census=census)
                   if source else None)
        crew = []
        if runtime:
            for name, membership in sorted(runtime["population"].items()):
                if name == "team-lead":
                    continue
                crew.append(immutable({
                    "name": name,
                    "membership": membership,
                    "runtime": runtime["runtimes"][name],
                }))
        inbox_generation = (self._mailbox_generation(source) if source else ())
        mailbox_generation = (None if request.archive_mail else inbox_generation)
        inbox = (immutable(self._inbox_state(
            source, generation=inbox_generation))
                 if source else immutable({}))
        holder_processes = tuple(
            launch["process"]["lead_holders"]["others"]
            + launch["process"]["lead_holders"]["ours"])
        holder_pids = tuple(row["pid"] for row in holder_processes)
        process_generation = self._runtime_generation(
            launch["process"]["snapshot"],
            sessions=((path.stem,) if path else ()),
            teams=tuple(item for item in (source, dest) if item),
            exclude_pids=holder_pids)
        transcript_generation = (self._file_generation(path)
                                 if path else ("absent",))
        rebind = None
        if taking_over and state == "restored" and stamped != dest:
            rebind = self._rebind_plan(
                stamped, dest, path, table, census=census,
                force=request.force, archive_mail=request.archive_mail,
                cleared_pids=tuple(
                    row["pid"] for row in
                    launch["process"]["lead_holders"]["others"]))
        # What moving the crew left on the source would take once this lead
        # runs as the destination: the planner's decision, as the doctor asks it.
        crew_move = (self._crew_move(source, dest, rebind, holder_pids, table, census)
                     if taking_over and source else None)
        actions = []
        if taking_over:
            if launch["process"]["lead_holders"]["others"]:
                actions.append("stop transcript holders")
            if rebind:
                actions.append(rebind["action"])
            actions.append("launch destination lead")
        return immutable({
            "request": request,
            "original_launch": launch,
            "launch": target_launch,
            "path": path,
            "transcript": launch["transcript"],
            "source": source,
            "dest": dest,
            "source_identity": (immutable({
                "agentId": agent_id_of("team-lead", source),
                "teamName": source,
            }) if source else None),
            "destination_identity": target_launch["identity"],
            "teams_led": teams_led,
            "taking_over": taking_over,
            "runtime": runtime,
            "crew": tuple(crew),
            "crew_move": crew_move,
            "inbox": inbox,
            "rebind": rebind,
            "holders": launch["process"]["lead_holders"],
            "holder_processes": holder_processes,
            "process_generation": process_generation,
            "transcript_generation": transcript_generation,
            "inbox_generation": inbox_generation,
            "mailbox_generation": mailbox_generation,
            "actions": tuple(actions),
            "source_roster": source_roster,
            "destination_roster": destination_roster,
            "completion_intent": {
                "identity": target_launch["identity"],
                "route": target_launch["route"],
                "destination": target_launch.get("destination"),
                "launch_action": target_launch.get("launch_action"),
            },
            "placement_generation": ((target_launch.get("launch_action") or {}).get(
                "generation")),
            "objections": tuple(objections),
        })

    def revalidate_lead_migration(self, plan, after_clear=False):
        """Revalidate a selected lead migration without choosing new semantics."""
        changed = []
        if plan["rebind"] and not after_clear:
            rebind = self._revalidate_rebind(plan["rebind"])
            changed.extend(rebind["changed"])
        if plan["source_roster"]:
            current = self._roster_snapshot(plan["source"])
            if current.observation != plan["source_roster"].observation:
                changed.append(f"source roster {plan['source']}")
        current_dest = self._roster_snapshot(plan["dest"])
        if current_dest.observation != plan["destination_roster"].observation:
            changed.append(f"destination roster {plan['dest']}")
        table = self._process_table(refresh=True)
        snapshot = self._runtime(table)
        holder_pids = tuple(row["pid"] for row in plan["holder_processes"])
        process_generation = self._runtime_generation(
            snapshot, sessions=((plan["path"].stem,) if plan["path"] else ()),
            teams=tuple(item for item in (plan["source"], plan["dest"]) if item),
            exclude_pids=holder_pids)
        if process_generation != plan["process_generation"]:
            changed.append("lead migration runtime")
        for selected in plan["holder_processes"]:
            current = snapshot["by_pid"].get(selected["pid"])
            if after_clear:
                if current is not None:
                    changed.append(f"selected holder pid {selected['pid']} remains")
            elif (current is not None
                    and self._process_fact_signature(current)
                    != self._process_fact_signature(selected)):
                changed.append(f"selected holder pid {selected['pid']} was reused")
        transcript = (self._file_generation(plan["path"])
                      if plan["path"] else ("absent",))
        if transcript != plan["transcript_generation"]:
            changed.append("lead transcript")
        mailboxes = (self._mailbox_generation(plan["source"])
                     if plan["source"] and plan["mailbox_generation"] is not None
                     else None)
        if mailboxes != plan["mailbox_generation"]:
            changed.append(f"mailboxes for {plan['source']}")
        if not after_clear:
            placement = self.revalidate_launch(plan["launch"])
            changed.extend(placement["changed"])
        else:
            selected_action = plan["launch"].get("launch_action")
            current_action = self._tmux_launch_action(plan["launch"].get("destination"))
            if ((selected_action or {}).get("generation")
                    != (current_action or {}).get("generation")):
                changed.append("tmux destination generation")
        return immutable({
            "matches": not changed,
            "changed": tuple(dict.fromkeys(changed)),
            "snapshot": snapshot,
            "table": table,
        })

    def complete_lead_migration(self, applied):
        """Verify selected lead migration effects and return its complete launch."""
        if not isinstance(applied, Applied) or applied.operation != "lead-migration":
            raise TypeError("complete_lead_migration requires lead migration Applied")
        plan = applied.plan
        if applied.dry_run or not plan["taking_over"]:
            nested = plan["rebind"]
            census = plan["launch"]["roster"]["census"]
            selected = plan["launch"]
            preview = self._complete_routed_launch(
                selected, census, selected["process"]["table"],
                selected["process"]["snapshot"],
                selected["transcript_generation"],
                {"lead_moving": plan["dest"]},
                rebind=nested)
            return immutable({
                "launch": preview, "matches": True,
                "changed": (), "applied": applied,
            })
        changed = []
        nested = plan["rebind"]
        current_dest = self._roster_snapshot(plan["dest"])
        if current_dest.observation != plan["destination_roster"].observation:
            changed.append(f"destination roster {plan['dest']}")
        current_source = (self._roster_snapshot(plan["source"])
                          if plan["source"] else None)
        if nested and nested["action"] == "reap":
            if current_source and current_source.generation != ("absent",):
                changed.append(f"source roster {plan['source']} still exists")
        elif (plan["source_roster"] and current_source
              and current_source.observation
              != plan["source_roster"].observation):
            changed.append(f"source roster {plan['source']}")
        table = self._process_table(refresh=True)
        snapshot = self._runtime(table)
        holder_pids = tuple(row["pid"] for row in plan["holder_processes"])
        process_generation = self._runtime_generation(
            snapshot, sessions=((plan["path"].stem,) if plan["path"] else ()),
            teams=tuple(item for item in (plan["source"], plan["dest"]) if item),
            exclude_pids=holder_pids)
        if process_generation != plan["process_generation"]:
            changed.append("lead migration runtime")
        for selected in plan["holder_processes"]:
            if snapshot["by_pid"].get(selected["pid"]) is not None:
                changed.append(f"selected holder pid {selected['pid']} remains")
        selected_action = plan["launch"].get("launch_action")
        current_action = self._tmux_launch_action(plan["launch"].get("destination"))
        if ((selected_action or {}).get("generation")
                != (current_action or {}).get("generation")):
            changed.append("tmux destination generation")
        current_transcript = self._file_generation(plan["path"])
        if nested:
            if applied.durable_action != nested["action"]:
                changed.append("durable lead migration action")
            if nested["action"] == "reap" and nested["reap"]["path"].exists():
                changed.append(f"source team {nested['source']} still exists")
            elif nested["action"] == "restamp":
                expected = _jsonl_text(
                    nested["restamp"]["lines"], nested["restamp"]["newline"]
                ).encode("utf-8")
                if not current_transcript or current_transcript[-1] != expected:
                    changed.append("selected lead restamp result")
        elif current_transcript != plan["transcript_generation"]:
            changed.append("lead transcript")
        launch = plan["launch"]
        if not changed:
            census = launch["roster"]["census"]
            launch = self._complete_routed_launch(
                launch, census, table, snapshot, current_transcript,
                {"lead_moving": plan["dest"]},
                rebind=nested)
            if launch["identity"] != plan["completion_intent"]["identity"]:
                changed.append("completed lead identity")
            if launch.get("destination") is not plan["completion_intent"]["destination"]:
                changed.append("completed lead destination identity")
            if launch.get("launch_action") is not plan["completion_intent"]["launch_action"]:
                changed.append("completed lead launch action identity")
        return immutable({
            "launch": launch,
            "matches": not changed,
            "changed": tuple(dict.fromkeys(changed)),
            "applied": applied,
        })

    def _teams_with_live_evidence(self, table=None, census=None,
                                 mailbox_generations=None):
        """Return teams with a live process or undelivered mailbox state."""
        table = self._retained_table(self._process_table() if table is None else table)
        teams = {e["team"] for e in self._runtime(table)["live_sessions"]
                 if e.get("team")}
        for team in self._known_teams(census):
            if team in teams:
                continue
            lead = self._agent_runtime(
                agent_id_of("team-lead", team), table, census=census)
            generation = ((mailbox_generations or {}).get(team)
                          if mailbox_generations is not None else None)
            if lead["alive"] or any(
                    n is None or n for n, _o in
                    self._inbox_state(team, generation=generation).values()):
                teams.add(team)
        return teams

    def _minted_by_a_resumed_life(self, team, census=None):
        """Return whether disk evidence identifies a resumed-process team.

        A fresh process records a `leadSessionId` that resolves to its transcript.
        A resumed process records its new internal ID, yielding an empty transcript
        lookup. The measured corpus contains 19 fresh-process relations and four
        resumed-process relations among 23 teams.
        """
        data = self._roster_snapshot(team, census).data
        lead_session = data.get("leadSessionId")
        if not lead_session:
            return None
        return self._transcript_path(lead_session) is None

    def _mint_candidates(self, pid, snapshot, census=None):
        """Return teams this process could have created.

        A fresh boot names its implicit team after its session id and records
        that id as leadSessionId; a resumed life uses a new internal id, which
        names no transcript. A process holding a transcript may be either, so
        both kinds are candidates, and creation and start times decide between
        them: _sole_mint_pairing takes only a team created within
        TEAM_MINT_WINDOW_MS before this process started, so a team the
        transcript's fresh boot created long before is not taken.
        """
        entry = next((e for e in snapshot["live_sessions"] if e["pid"] == pid), None)
        session = (entry or {}).get("session")
        fresh = []
        if session:
            derived = f"session-{session[:8]}"
            data = self._roster_snapshot(derived, census).data
            if data.get("leadSessionId") == session:
                fresh = [derived]
        pool = [t for t in self._known_teams(census)
                if self._minted_by_a_resumed_life(t, census)]
        return {"teams": fresh + [t for t in pool if t not in fresh],
                "own_session": tuple(fresh),
                "why": "the teams this process could have created when it started"}

    def _sole_mint_pairing(self, pid, snapshot, census=None):
        """The team only this process could have created, or None if ambiguous.

        Unique in both directions. _boot_join warns when several processes fall
        in one team's window but returns them anyway, and it never asks whether
        one process falls inside several teams' windows, so neither direction is
        established by appearing in that list.
        """
        candidates = self._mint_candidates(pid, snapshot, census)
        pairs = [p for p in self._boot_join(snapshot, census)
                 if p[0] in candidates["teams"]]
        mine = {team for team, owner, _ in pairs if owner == pid}
        if len(mine) != 1:
            return None
        team = mine.pop()
        return team if {owner for t, owner, _ in pairs if t == team} == {pid} else None

    def _is_claude(self, argv):
        """Classify direct argv without inspecting strings inside wrapper arguments."""
        if not argv:
            return False
        options = self._argv_options(argv)
        agent_id = options.get("--agent-id")
        name, team = name_and_team(agent_id)
        consistent_identity = bool(
            name and team
            and options.get("--agent-name") == name
            and options.get("--team-name") == team)
        return consistent_identity or bool(CLAUDE_PROC.search(argv[0]))

    @staticmethod
    def _argv_options(argv):
        """Direct option values from exact `/proc/<pid>/cmdline` arguments."""
        options = {}
        for index, token in enumerate(argv):
            if not token.startswith("--"):
                continue
            if "=" in token:
                flag, _, value = token.partition("=")
                options[flag] = value
            elif index + 1 < len(argv):
                options[token] = argv[index + 1]
        return types.MappingProxyType(options)

    def _own_lineage(self, table):
        """Return the caller PID and ancestors from the existing process table."""
        parents = {p: pp for p, pp, _ in table}
        pid, chain = os.getpid(), set()
        while pid and pid not in chain:
            chain.add(pid)
            pid = parents.get(pid)
        return chain

    def _team_description(self, team, table=None, census=None):
        """Return one description object for the retained member answer.

        Completion, doctor, listings, and runtime reuse its member records,
        order, lead resolution, and transcript fact. Repeated queries with the
        same retained inputs reuse the answer and therefore the description.
        """
        members = self._team_members(team, table=table, census=census, enrich=True)
        table, census = members["table"], members["census"]
        roster_snapshot = members["roster_snapshot"]
        bucket = self._team_descriptions.setdefault(team, [])
        for description in bucket:
            if description["member_answer"] is members:
                return description

        lead_member = members["by_name"].get("team-lead")
        if lead_member is not None:
            resolution = lead_member["resolution"]
        else:
            resolution = self._resolve_transcript(
                lead_session=members["roster"].get("leadSessionId"),
                team=team, name="team-lead", is_lead=True, quick=True,
                table=table, census=census)
        fact = resolution.transcript
        current_entries = tuple(
            record["roster_entry"] for record in members["members"]
            if record["roster_entry"] is not None)
        activity = max(
            (record["activity"] or 0 for record in members["members"]),
            default=0) or None
        if roster_snapshot.state == "valid":
            count = len(members["members"])
            activity = (activity or members["roster"].get("createdAt")
                        or roster_snapshot.mtime)
            standing = None
        elif roster_snapshot.state == "invalid":
            count = len(members["members"])
            activity = activity or roster_snapshot.mtime
            standing = f"roster invalid: {roster_snapshot.problem}"
        elif fact:
            count = len(members["members"])
            activity = activity or fact["mtime"]
            standing = "roster missing"
        else:
            count = len(members["members"])
            standing = "roster missing; lead transcript search is empty"
        description = types.MappingProxyType({
            "team": team,
            "table": table,
            "census": census,
            "roster": roster_snapshot,
            "entries": current_entries,
            "member_answer": members,
            "members": members["members"],
            "by_agent": members["by_agent"],
            "member_order": members["member_order"],
            "lead_resolution": resolution,
            "lead_fact": fact,
            "count": count,
            "activity": activity,
            "standing": standing,
            "generation": types.MappingProxyType({
                "roster": roster_snapshot.generation,
                "assignments": members["assignment_generation"],
            }),
        })
        bucket.append(description)
        return description

    def _team_member_resolutions(self, team, entries=None):
        """Map team member names to resumable transcript resolutions.

        Cleanup and completion consume this shared answer so both classify the
        team from the same transcript search.
        """
        if entries is None:
            entries = self._roster_entries(team=team)
        resolutions = {}
        lead_session = entries[0]["leadSessionId"] if entries else None
        if lead_session:
            found = self._resolve_transcript(lead_session=lead_session, team=team, is_lead=True, quick=True)
            if found:
                resolutions["team-lead"] = found
        named = [entry["member"].get("name") for entry in entries]
        if not entries:
            # Transcript stamps preserve member identity after roster cleanup, so
            # rosterless teams still receive a member search.
            named = [stamped_name for stamped_name, stamped_team in self._stamp_index().values()
                     if stamped_team == team]
        for name in named:
            if name and name != "team-lead" and name not in resolutions:
                found = self._resolve_transcript(team=team, name=name, quick=True)
                if found:
                    resolutions[name] = found
        return resolutions

    class _Merged:
        """Field values from many sources; most recent wins."""

        def __init__(self):
            self.cands = defaultdict(list)

        def add(self, field, value, ts, source):
            if value in (None, ""):
                return
            self.cands[field].append((value, ts or 0, source))

        def pick(self, field):
            """Choose the newest candidate and preserve its bracketed variant.

            Recency selects the base value. A candidate beginning with that value
            plus `[` is a more specific spelling, such as `claude-opus-5[1m]`, so
            the longest such variant wins. Other longer strings remain distinct
            values. Merged non-model fields use plain tokens, and cwd reaches this
            fallback only when transcript and roster values are unavailable.
            """
            cands = self.cands.get(field)
            if not cands:
                return None, None, None
            value, ts, source = max(cands, key=lambda c: c[1])
            richer = ([c for c in cands if isinstance(c[0], str) and c[0].startswith(value + "[")]
                      if isinstance(value, str) else [])
            if richer:
                # Preserve the superseded base value in provenance so --explain
                # can render the Resolver decision directly.
                plainer = value
                value, ts, source = max(richer, key=lambda c: len(c[0]))
                source += f" (more specific than {plainer})"
            return value, ts, source

        def conflicts(self, field):
            return {c[0] for c in self.cands.get(field, [])}

    def _place(self, res, typed_team, for_team=None, to_team=None, keep_team=False,
              table=None):
        """Return the launch team and placement reason.

        `to_team` and `for_team` are explicit destinations. `keep_team` preserves
        the addressed team. Otherwise a single team with live members wins over
        the addressed team. Several live teams require an explicit selection.
        """
        self._exercise(NEED.PLACEMENT)
        spoken = to_team or for_team
        if spoken:
            return spoken, "asked for"
        live_led = self._live_led(res.path.stem, table)
        if keep_team:
            if typed_team and live_led and typed_team not in live_led:
                warn(f"--keep-team: staying on {typed_team}, though this transcript's "
                     f"live members are on {', '.join(live_led)}; their mail goes "
                     f"unread while it runs as {typed_team}")
            return typed_team, "as typed"
        if len(live_led) > 1:
            die(f"this transcript leads {len(live_led)} teams with members running "
                f"({', '.join(live_led)}); name one with --team")
        if live_led and live_led[0] != typed_team:
            return live_led[0], (f"its live members are here; {typed_team} as addressed "
                                 f"has nobody running" if typed_team
                                 else "its live members are here")
        return typed_team, "as addressed"

    def _identity(self, session_uuid=None, agent_id=None, for_team=None, to_team=None,
                 keep_team=False, table=None, census=None, terminal=None):
        """Resolve one transcript and merge its launch identity.

        Sources are roster entries, transcript fields, live argv, promotion
        receipts, lead spawn records, and lead-session lookup. Dated observations
        use newest-first precedence. An explicit complete identity or promotion
        receipt assigns the effective identity independently of those observations;
        spawn and roster launch fields are then selected for that assigned identity.

        Live argv sets agentId, agentName, and teamName together one millisecond
        after transcript activity because it describes the current process. Model
        selection preserves the longest bracketed variant of the winning base
        value. `place` selects the destination before the merge and removes source
        roster evidence after a team change. Lead spawn records provide structural
        team identity through `leads_team` and `lead_agent_id`.

        Callers consume `field`, `provenance`, `conflicts`, and judged objections.
        `enforce_ctx` applies those objections at the action boundary.
        """
        table = self._process_table() if table is None else table
        table = self._retained_table(table)
        census = self._roster_census() if census is None else self._retained_census(census)
        terminal = self._terminal_context() if terminal is None else terminal
        merged = self._Merged()
        leads_team = None
        team_entry = None
        source_team_entry = None
        transcript = None
        session_uuid = session_uuid
        others = []

        if agent_id:
            matches = self._roster_entries(agent_id=agent_id, census=census)
            if matches:
                team_entry = matches[0]
                if len(matches) > 1:
                    warn(f"{len(matches)} team configs claim {agent_id}; using {team_entry['cfg']}")
            else:
                warn(f"no team config lists {agent_id}; falling back to name@team parsing")

        team = name = None
        if team_entry:
            team, name = team_entry["team"], team_entry["member"].get("name")
        elif agent_id:
            name, team = name_and_team(agent_id)

        worn_id = agent_id_of(name, team) if name and team else None
        requested_name, requested_team = name_and_team(agent_id)
        explicit_identity = bool(requested_name and requested_team)
        # The harness reserves the name, so a lead is a lead whether or not a roster
        # survives to say so; without this a reaped team's lead is refused as a name
        # that lives in several rosters.
        is_lead_member = ((bool(team_entry) and team_entry["member"].get("agentId") == team_entry.get("leadAgentId"))
                          or name == "team-lead")
        res = self._resolve_transcript(
            session_uuid=session_uuid,
            lead_session=(team_entry.get("leadSessionId")
                          if is_lead_member and team_entry else None),
            team=team,
            name=name,
            is_lead=is_lead_member,
            table=table,
            census=census,
        )
        if not res:
            reason = res.reason
            if res.evidence.get("kind") in {
                    "promoted-ambiguity", "session-ambiguity"}:
                rows = [render_transcript_row(
                    path.stem, self._transcript_fact(path=path), limit=ABORT_TITLE)
                    for path in res.evidence["paths"]]
                reason += "\n" + "\n".join(f"  {row}" for row in rows)
            die(reason if res.answered else
                f"{reason}; a truly in-process agent leaves only a sidechain under the lead's "
                "subagents/ dir, which no CLI can resume")
        objections = self._objections(res, name, team)
        transcript = (res.path, res.fields, res.last_ts)
        others = [(p, f, t) for p, f, t in res.others]
        session_uuid = res.path.stem

        # What a promote wrote into this file when it made it. Read here, where
        # the file is known, so both the refusal below and the merge further
        # down work off one answer. Only the pair counts: half an identity places
        # nobody, and the receipt writes both halves or neither.
        receipt = self._receipt_carried_by(res.path)
        promoted_as = ((receipt.get("name"), receipt.get("team"))
                       if receipt and receipt.get("name")
                       and receipt.get("team") else None)

        # Placement precedes merging for a launch. Diagnosis resolves the same
        # canonical target but keeps the addressed identity and performs no launch
        # placement work.
        if self._needs[NEED.PLACEMENT] is DECLARED.ABSENT:
            if for_team or to_team or keep_team:
                self._exercise(NEED.PLACEMENT)
            placed, placed_why = team, "as addressed"
        else:
            placed, placed_why = self._place(
                res, team, for_team, to_team, keep_team, table=table)
        redirected = bool(placed and placed != team)
        if redirected:
            team, source_team_entry, team_entry = placed, team_entry, None

        assigned_agent_id = (agent_id if explicit_identity else
                             agent_id_of(*promoted_as) if promoted_as else None)
        if redirected and assigned_agent_id:
            assigned_name, _assigned_team = name_and_team(assigned_agent_id)
            assigned_agent_id = agent_id_of(assigned_name, team)

        # An explicit assignment or promotion receipt decides which roster may
        # contribute launch fields. A roster inferred from later transcript stamps
        # can still describe the conversation's former identity, but its model,
        # color, cwd, and parent do not belong to the assigned agent.
        if assigned_agent_id:
            entry_id = ((team_entry or {}).get("member") or {}).get("agentId")
            if entry_id and entry_id != assigned_agent_id:
                source_team_entry, team_entry = team_entry, None
            if not team_entry and not redirected:
                matches = self._roster_entries(
                    agent_id=assigned_agent_id, census=census)
                team_entry = matches[0] if matches else None

        if not team_entry and not assigned_agent_id:
            # A uuid or a stranger's id adopts the roster the transcript names.
            stamped_team, stamped_name = res.stamped("teamName"), res.stamped("agentName")
            # A lead transcript can contain stamps from one team and spawn records
            # for several. An explicitly requested led team selects the relevant
            # spawn-record identity.
            asked = for_team or team
            leads_asked = bool(asked and asked != stamped_team
                               and asked in self._teams_led_by(session_uuid))
            if stamped_team and stamped_name and not leads_asked:
                matches = self._roster_entries(
                    team=stamped_team, name=stamped_name, census=census)
                team_entry = matches[0] if matches else None
            elif not stamped_team or leads_asked:
                # Teammate identity requires both agent and team stamps. A lone name
                # can come from a named plain session or mismatched launch flags.
                # Spawn records provide structural lead identity and select the team
                # requested by the caller.
                led_teams_here = self._teams_led_by(session_uuid)
                # `--team` and the team component of an agent ID both identify the
                # team being reconstructed.
                wanted = for_team or team
                for led in ([wanted] if wanted in led_teams_here else led_teams_here):
                    matches = self._roster_entries(
                        team=led, lead_only=True, census=census)
                    if matches:
                        team_entry = matches[0]
                        break
                    # Spawn records establish this transcript as the team lead even
                    # when the roster directory is absent. Store that structural fact
                    # in `leads_team`; roster reconstruction then writes
                    # team-lead@<team> independently of the session's display name.
                    leads_team = led
                    merged.add("teamName", led, res.last_ts, "spawn payloads in this transcript")
                    merged.add("agentName", "team-lead", res.last_ts, "spawn payloads in this transcript")
                    merged.add("agentId", agent_id_of("team-lead", led), res.last_ts, "spawn payloads in this transcript")
                    break
                else:
                    # Promotion receipts provide identity before the first launch.
                    # Other transcripts reaching this point have an empty complete-
                    # stamp result and zero spawn records, which identifies plain
                    # session history.
                    if not agent_id and not promoted_as:
                        die(
                            f"{res.path.name} contains plain session history: complete agent "
                            "stamps and teammate spawn records both resolve empty. Resume it "
                            "with plain `claude --resume`, or pass --agent-id to assign identity."
                        )

        # ---- team config contributions
        # Provenance names teams by team name and transcripts by session ID, matching
        # the object labels rendered by --explain.
        if team_entry:
            member, ts, src = (team_entry["member"], team_entry["ts"],
                               f"roster of {team_entry['team']}")
            merged.add("agentId", member.get("agentId"), ts, src)
            merged.add("agentName", member.get("name"), ts, src)
            merged.add("teamName", team_entry["team"], ts, src)
            merged.add("color", member.get("color"), ts, src)
            merged.add("agentType", member.get("agentType"), ts, src)
            merged.add("model", member.get("model"), ts, src)
            merged.add("cwd", member.get("cwd"), ts, src)
            merged.add("tmuxPaneId", member.get("tmuxPaneId"), ts, src)
            merged.add("backendType", member.get("backendType"), ts, src)
            merged.add("parentSessionId", team_entry["leadSessionId"], ts, src)
            if member.get("planModeRequired"):
                merged.add("permissionMode", "plan", ts, src)

        # ---- transcript contributions
        path, fields, last_ts = transcript
        src = f"transcript {path.stem}"
        for field, (value, ts) in fields.items():
            if not field.startswith("_"):
                merged.add(field, value, ts, src)
        if not merged.cands.get("agentId"):
            name = fields.get("agentName", (None,))[0]
            team = fields.get("teamName", (None,))[0]
            if name and team:
                merged.add("agentId", agent_id_of(name, team), last_ts, src + " (derived)")

        # ---- live argv sets the identity triple
        # A process that identifies this transcript supplies current --agent-id and
        # --team-name values. Add agentId, agentName, and teamName at one timestamp so
        # the launch cannot combine components from different sources. Other fields
        # retain ordinary merge precedence.
        if res.identity_from_argv() and worn_id:
            worn_name, worn_team = name_and_team(worn_id)
            argv_ts = last_ts + 1  # current process identity outranks transcript records
            merged.add("agentId", worn_id, argv_ts, "live argv")
            merged.add("agentName", worn_name, argv_ts, "live argv")
            merged.add("teamName", worn_team, argv_ts, "live argv")

        # ---- promotion receipt identity
        # Keep the receipt among merge candidates for explanations and conflicts.
        # The effective target separately treats its identity assignment as
        # authoritative, regardless of newer observations in this list.
        if promoted_as:
            merged.add("agentName", promoted_as[0], 0, "promote receipt")
            merged.add("teamName", promoted_as[1], 0, "promote receipt")
            merged.add("agentId", agent_id_of(*promoted_as), 0, "promote receipt")

        # ---- lead spawn record
        # Timestamp 0 places dated roster and transcript fields above the spawn
        # snapshot. The lookup uses an explicit or promoted identity when one was
        # assigned, so a conflicting later stamp cannot import another agent's
        # model, color, or parent.
        lookup_agent_id = assigned_agent_id or merged.pick("agentId")[0]
        record = self._spawn_payload(lookup_agent_id, merged.pick("parentSessionId")[0])
        if record:
            for key, field in SPAWN_FIELDS.items():
                merged.add(field, record.get(key), 0, "lead transcript spawn record")
            if record.get("plan_mode_required"):
                merged.add("permissionMode", "plan", 0, "lead transcript spawn record")

        # Team-directory cleanup removes leadSessionId. Resolver restores the parent
        # through its ordered roster, spawn-record, and name-prefix evidence.
        if not merged.cands.get("parentSessionId"):
            parent_team = (name_and_team(assigned_agent_id)[1] if assigned_agent_id
                           else merged.pick("teamName")[0])
            lead = self._lead_session_for(
                parent_team or "", table=table, census=census)
            if lead:
                merged.add("parentSessionId", lead, transcript[2], "engine: lead session for team")

        resolved_agent_id = merged.pick("agentId")[0]
        effective_agent_id = assigned_agent_id or resolved_agent_id
        effective_name = name_and_team(effective_agent_id)[0]
        snapshot = self._runtime(table)
        runtime = (self._agent_runtime(
            effective_agent_id, table,
            parent_session=merged.pick("parentSessionId")[0], census=census)
            if effective_agent_id else None)
        holders = snapshot["transcripts"].get(
            session_uuid, immutable({
                "session": session_uuid,
                "fact": res.transcript,
                "processes": (),
                "others": (),
                "ours": (),
            }))
        if runtime and runtime["pid"]:
            merged.add("pid", runtime["pid"], int(time.time() * 1000),
                       "process runtime")

        lead_agent_id = (agent_id_of("team-lead", leads_team) if leads_team
                         else team_entry["leadAgentId"] if team_entry
                         else effective_agent_id if effective_name == "team-lead" else None)
        candidates = immutable({field: tuple(values)
                                for field, values in merged.cands.items()})
        fields = {field: merged.pick(field)[0] for field in candidates}
        provenance = {field: merged.pick(field) for field in candidates}
        conflicts = {field: frozenset(merged.conflicts(field))
                     for field in candidates}
        cwd, cwd_warning = self._resolved_agent_cwd(
            team_entry, receipt, res.path, transcript[1],
            fallback=merged.pick("cwd")[0])
        merged_cwd = merged.pick("cwd")
        cwd_provenance = (merged_cwd if merged_cwd[0] == cwd else
                          (cwd, max((item[1] or 0 for values in candidates.values()
                                    for item in values), default=0) + 1,
                           f"resolved cwd for transcript {session_uuid}"))
        fields["cwd"] = cwd
        provenance["cwd"] = cwd_provenance
        conflicts.setdefault("cwd", frozenset())
        identity_source = ("explicit --agent-id" if explicit_identity else
                           "promote receipt" if promoted_as else
                           merged.pick("agentId")[2])
        if redirected:
            identity_source = f"placement: {placed_why}"
        settings = immutable({
            field: value for field, value in fields.items()
            if field not in IDENTITY_FIELDS and field != "cwd"
        })
        explanation = types.MappingProxyType({
            "selected": immutable(provenance),
            "candidates": candidates,
            "conflicts": immutable(conflicts),
            "other_transcripts": immutable(others),
        })
        launch = types.MappingProxyType({
            "session": res.transcript["session"],
            "transcript": res.transcript,
            "transcript_generation": self._file_generation(res.path),
            "terminal": terminal,
            "cwd": cwd,
            "cwd_warning": cwd_warning,
            "identity": None,
            "settings": settings,
            "explanation": explanation,
            "via": res.via,
            "objections": tuple(objections),
            "process": types.MappingProxyType({
                "table": table,
                "snapshot": snapshot,
                "runtime": runtime,
                "holders": holders,
            }),
            "roster": types.MappingProxyType({
                "census": census,
                "selected": team_entry,
                "source": source_team_entry,
                "destination": self._roster_snapshot(
                    name_and_team(effective_agent_id)[1], census)
                if effective_agent_id else None,
            }),
            "placement": (immutable({"team": placed, "why": placed_why})
                          if redirected else None),
            "route": immutable({
                "to_team": to_team,
                "to_lead": None,
                "automatic": False,
                "lead_moving": None,
                "member_moving": None,
                "stale_team_warned": False,
                "arrived": None,
            }),
            "receipt": immutable(receipt) if receipt else None,
            # A lead found from spawn records may have no roster entry yet.
            "lead_agent_id": lead_agent_id,
            "leads_team": leads_team,
        })
        return self._set_effective_identity(
            launch, agent_id=effective_agent_id,
            parent=merged.pick("parentSessionId")[0], source=identity_source)

    def _resolved_agent_cwd(self, team_entry, receipt, path, fields, fallback=None):
        """Resolve cwd and any launch-only warning for the selected transcript.

        `/cd` can add several cwd values. Prefer the newest recorded cwd with a
        flattened path that matches the transcript's project directory.
        Promotion keeps the main transcript beside its parent session, so the
        promotion receipt can supply a matching cwd from that parent
        transcript. A remaining candidate is used with a warning.

        Flattening maps all non-alphanumeric characters to `-`, making the project
        directory name non-invertible. In the measured corpus, 767 of 771
        transcripts with cwd records contain a matching value.
        """
        trail = list(fields.get("_cwds", ([],))[0])
        roster_cwd = (team_entry or {}).get("member", {}).get("cwd")
        candidates = trail + ([roster_cwd] if roster_cwd else [])
        project = path.parent.name

        consistent = [c for c in candidates if flatten_cwd(c) == project]
        if consistent:
            return consistent[-1], None
        inherited = self._promoted_from_cwds(receipt, path)
        if inherited:
            return inherited[-1], None
        if candidates:
            # The target carries the warning to the action boundary. A doctor uses
            # the same identity resolver but starts nothing, so it must not make a
            # launch claim merely by selecting a conversation.
            warning = (f"starting in {candidates[-1]}, the last directory this conversation "
                       f"ran in. Claude looks for a conversation only among the ones kept "
                       f"for the directory it starts in, and this conversation is kept "
                       f"under a different one, so the resume may not find it")
            return candidates[-1], warning
        warning = (None if fallback else
                   "cwd evidence is empty, so the agent starts in the directory this command "
                   "was run from. Claude looks for a conversation only among the ones kept "
                   "for the directory it starts in, so the resume may not find it")
        return fallback or None, warning

    def _promoted_from_cwds(self, receipt, path):
        """Return parent-session cwd values matching a promoted file's project dir.

        The promotion receipt identifies the parent transcript. Matching its cwd
        trail also verifies that the receipt and promoted file share a project
        directory.
        """
        parent = (receipt or {}).get("parent")
        source = self._transcript_path(parent) if parent else None
        if not source:
            return []
        project = path.parent.name
        fields, _last = self._scan_transcript(source)
        return [c for c in fields.get("_cwds", ([],))[0] if flatten_cwd(c) == project]

    def _set_effective_identity(self, launch, agent_id=None, team=None, parent=None,
                               source="resolved identity", route=None, census=None):
        """Return one complete launch answer with a replaced effective identity.

        Runtime, holders, roster facts, fields, provenance, and routing are rebuilt
        together from the retained process table and roster census. No caller patches
        one of those facts after changing the identity.
        """
        if (route is not None and agent_id is None and team is None
                and parent is None and census is None):
            route_values = dict(launch["route"])
            route_values.update(route)
            return types.MappingProxyType({
                **launch, "route": immutable(route_values)})

        current = launch.get("identity") or {}
        settings = launch["settings"]
        explanation = launch["explanation"]
        selected_facts = dict(explanation["selected"])
        agent_id = agent_id or current.get("agentId") or selected_facts.get(
            "agentId", (None,))[0]
        name, current_team = name_and_team(agent_id)
        team = team or current_team
        if name and team:
            agent_id = agent_id_of(name, team)
        parent = (parent if parent is not None else current.get("parentSessionId")
                  or selected_facts.get("parentSessionId", (None,))[0])
        stamp = max((candidate[1] or 0
                     for values in explanation["candidates"].values()
                     for candidate in values), default=0) + 1
        values = {
            "agentId": agent_id,
            "agentName": name,
            "teamName": team,
            "parentSessionId": parent,
        }
        authoritative = source.startswith("explicit") or source == "promote receipt"
        for field, value in values.items():
            prior = selected_facts.get(field, (None, 0, None))
            selected_facts[field] = (
                prior if prior[0] == value and not authoritative
                else (value, stamp, source))

        roster = launch["roster"]
        census = self._retained_census(roster["census"] if census is None else census)
        selected = roster.get("selected")
        selected_id = ((selected or {}).get("member") or {}).get("agentId")
        source_entry = roster.get("source")
        if selected_id and selected_id != agent_id:
            source_entry = source_entry or selected
            selected = None
        if agent_id and selected is None:
            matches = self._roster_entries(agent_id=agent_id, census=census)
            selected = matches[0] if matches else None
        lead_id = (selected.get("leadAgentId") if selected else
                   launch.get("lead_agent_id"))
        identity = immutable({
            **values,
            "role": ("lead" if name == "team-lead" or agent_id == lead_id
                     else "member"),
            "source": source,
        })

        process = launch["process"]
        table = process["table"]
        runtime = (self._agent_runtime(
            agent_id, table, parent_session=parent, census=census)
                   if agent_id else None)
        lead = (runtime if name == "team-lead" else
                self._agent_runtime(
                    agent_id_of("team-lead", team), table,
                    parent_session=parent, census=census)
                if team else None)
        crew = self._crew_placement(team, table)
        credentials = self._credential_fact(lead)
        diagnosis = (self._agent_diagnosis(
            agent_id, parent, table=table, census=census,
            member_runtime=runtime, lead_runtime=lead)
                     if agent_id else None)
        holder_rows = process["holders"]
        lead_others = list(holder_rows["others"])
        lead_ours = list(holder_rows["ours"])
        owner = process["snapshot"]["best_by_session"].get(launch["session"])
        known_pids = {row["pid"] for row in lead_others + lead_ours}
        if owner and owner["alive"] and owner["pid"] not in known_pids:
            owner_record = process["snapshot"]["by_pid"].get(owner["pid"])
            if owner_record:
                (lead_ours if owner_record["ours"] else lead_others).append(
                    owner_record)
        route_values = dict(launch["route"])
        if route:
            route_values.update(route)
        destination = self._roster_snapshot(team, census) if team else None
        process_agents = tuple(dict.fromkeys(
            value for value in (
                agent_id, agent_id_of("team-lead", team) if team else None)
            if value))
        process_sessions = tuple(dict.fromkeys(
            value for value in (launch["session"], parent) if value))
        process_teams = (team,) if team else ()
        process_generation = self._runtime_generation(
            process["snapshot"], agent_ids=process_agents,
            sessions=process_sessions, teams=process_teams)
        return types.MappingProxyType({
            **launch,
            "identity": identity,
            "explanation": types.MappingProxyType({
                **explanation, "selected": immutable(selected_facts)}),
            "process": types.MappingProxyType({
                "table": table,
                "snapshot": process["snapshot"],
                "runtime": runtime,
                "lead": lead,
                "holders": process["holders"],
                "lead_holders": immutable(
                    {"others": lead_others, "ours": lead_ours}),
                "crew": crew,
                "credentials": credentials,
                "generation": process_generation,
                "generation_agents": process_agents,
                "generation_sessions": process_sessions,
                "generation_teams": process_teams,
                "diagnosis": diagnosis,
            }),
            "roster": types.MappingProxyType({
                "census": census,
                "selected": selected,
                "source": source_entry,
                "destination": destination,
                "record": self._launch_roster_record(identity, settings, launch["cwd"]),
            }),
            "route": immutable(route_values),
            "lead_agent_id": lead_id,
        })

