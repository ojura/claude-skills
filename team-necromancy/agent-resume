@unit(("smoke-counts-only-what-it-started",
       "the smoke tier counts processes it started, not the machine's"), live=True)
def _check_smoke_counts_only_what_it_started(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # A process wearing a fixture identity that this run did not start is
    # another run's, or a person's. The tier asks what it started, so it must
    # not see one. Demonstrated with a process put outside this lineage on
    # purpose: it is started by a child that exits, so init adopts it and its
    # parent chain never reaches us. Nothing here waits on a clock.
    sp = s.sp
    sp = s.sp
    told_pid = Path(tempfile.mkdtemp(prefix=f"{TOOL}-stray-")) / "pid"
    # setsid puts it in its own session, so its parent chain never reaches
    # this run. It writes its own pid, and the read below waits on that file
    # appearing rather than on a clock.
    # --fork makes setsid detach even when it is not already a group leader;
    # without it setsid execs in place and the fixture stays this run's child,
    # which is the opposite of what this check needs.
    sp.Popen(["setsid", "--fork", sys.executable, "-c",
              "import os, sys, time;"
              "open(sys.argv[1], 'w').write(str(os.getpid()));"
              "time.sleep(30)",
              str(told_pid), "--agent-id", "stray@session-corpus-alpha"]).wait()
    orphan = 0
    while not orphan:
        try:
            orphan = int(told_pid.read_text().strip() or 0)
        except (OSError, ValueError):
            orphan = 0
    try:
        table = RESOLVER.process_table(refresh=True)
        rows = {pid: cmd for pid, _ppid, cmd in table}
        # The tier's own question, not a copy of it: a narrowing removed from
        # started_here has to show up here, or this check is asserting its own
        # arithmetic rather than the code the tier runs.
        counted = started_here()
        wearing = {str(pid) for pid, cmd in rows.items()
                   if "--agent-id" in cmd and "session-corpus-" in cmd}
        told = {
            "the stray is running and wears a fixture identity":
                orphan in rows and "session-corpus-alpha" in rows.get(orphan, ""),
            "it is not in this run's lineage":
                orphan not in RESOLVER.descendants_of(os.getpid(), table),
            "so what this run started does not count it":
                str(orphan) not in counted,
            # Without the narrowing there is nothing to prove: the machine-wide
            # question is the one that would have counted it.
            "though the machine-wide question would have":
                str(orphan) in wearing,
        }
    finally:
        # Nobody else will: it is in its own session by design.
        try:
            os.kill(orphan, 9)
        except OSError:
            pass
    wrong = sorted(k for k, ok in told.items() if not ok)
    check("smoke-counts-only-what-it-started",
          "the smoke tier counts processes it started, not the machine's",
          not wrong, ", ".join(wrong))
    return checked


def verdicts_from(said):
    """(rows, the summary line) for what another process reported.

    A run that died mid-way leaves a short list and no summary, and taking its
    rows on trust would report the checks it never reached as absent rather
    than as unanswered. The stated count is the one thing that can contradict
    the rows, so callers compare rather than believe.
    """
    rows, summary = [], None
    for line in said.splitlines():
        verdict = line.strip()
        if verdict.startswith(("PASS  ", "FAIL  ")):
            rest = verdict[6:]
            cid, _, name = rest.partition("  ")
            name, _, detail = name.strip().partition("  (")
            rows.append((cid.strip(), name.strip(),
                         verdict.startswith("PASS"), detail.rstrip(")")))
        elif "checks passed" in verdict:
            summary = verdict
    return rows, summary


def tree_state(root):
    """Every path under root and what it holds.

    Nothing was written is measured over the whole tree rather than over the
    files somebody thought of, so a run that writes something nobody named
    still fails. Two checks ask it, a preview that must write nothing and a
    help that must do nothing, and one function keeps them asking the same
    question.
    """
    state = {}
    for path in sorted(root.rglob("*")):
        rel = str(path.relative_to(root))
        if path.is_symlink():
            state[rel] = "-> " + os.readlink(path)
        elif path.is_file():
            state[rel] = path.read_text(errors="replace")
        else:
            state[rel] = "<a directory>"
    return state


def started_here():
    """Anything a launch from this run would have added to the machine.

    Narrowed twice, because the question is what this run started and the
    machine answers about everything: to agents wearing a fixture identity,
    since real agents run here too, and then to processes descending from this
    run and sockets this run named. Another run's fixture is its own business,
    and counting it reports a leak nobody here made.

    One function rather than one per caller, so the check that this narrowing
    holds asks the same question the tier asks rather than a copy of it.
    """
    table = RESOLVER.process_table(refresh=True)
    mine = RESOLVER.descendants_of(os.getpid(), table)
    return ({str(pid) for pid, _ppid, cmd in table
             if pid in mine and "--agent-id" in cmd and "session-corpus-" in cmd}
            | {sock.name for sock in RESOLVER.swarm_sockets()
               if sock.name.endswith(f"-{os.getpid()}")})


def hand_down(quiet, where):
    """Write a read-only child's output where a worker can read it back."""
    where.write_text(json.dumps({"args": quiet.args, "returncode": quiet.returncode,
                                 "stdout": quiet.stdout, "stderr": quiet.stderr}))
    return where


def handed_down(where):
    """The child a parent already ran, as the run of it this process skipped.

    A file rather than the worker's stdin: the read-only tier prints a line per
    check, and a pipe nobody is reading stops accepting them partway, which
    would hang the run rather than fail it.
    """
    got = json.loads(Path(where).read_text())
    return subprocess.CompletedProcess(got["args"], got["returncode"],
                                       got["stdout"], got["stderr"])


def in_share(count, share):
    """Which places in a list of that many units this share answers for.

    Taken by position rather than by name, so a unit added later moves at most
    one unit between shares. For any number of shares each place falls in
    exactly one of them, which is what lets the shares be merged into one
    tier's worth of verdicts. share=None is the whole tier.
    """
    return [at for at in range(count)
            if share is None or at % share[1] == share[0]]


def _live_in_parallel(jobs):
    """The live units run in jobs processes at once, their verdicts merged.

    Each worker owns its fixtures, because a fixture is named for the run that
    made it and a run asks only about what it started, so two workers cannot
    see each other. The read-only tier is inherited once here rather than
    once per worker.

    A worker that dies leaves rows without the summary that counts them, and
    the gap is reported as a failure rather than passing as fewer checks.

    Returns the rows and the register that filled them, the same pair
    live_checks hands back, so a caller adds a row of its own the one way.
    """
    s = _live_context()
    out, register = check_rows()
    for row in s.inherited:
        register(*row)
    workers, short = [], []
    # The two ids every share reports under, held back as they arrive and
    # folded once each below. Both are a statement about one share's own run,
    # and the merge has to state them for the run as a whole.
    held = {RUNNER_CHECKS[0][0]: [], UNIT_ENDED[True][0]: []}
    with tempfile.TemporaryDirectory(prefix=f"{TOOL}-shares-") as room:
        inherit = hand_down(s.quiet, Path(room) / "read-only.json")
        try:
            workers = [subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve()),
                 "--selftest", "--live", "--share", f"{at}/{jobs}",
                 "--inherit", str(inherit)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                for at in range(jobs)]
            for at, worker in enumerate(workers):
                # A worker that hangs would hold this run open with no way out,
                # so it is given a bound and killed by the code that started it.
                try:
                    said, worker_err = worker.communicate(timeout=900)
                except subprocess.TimeoutExpired:
                    worker.kill()
                    said, worker_err = worker.communicate()
                rows, summary = verdicts_from(said)
                counted = summary and summary.split("/")[1].split()[0]
                if counted is None or int(counted) != len(rows):
                    short.append(f"share {at}/{jobs}: {len(rows)} row(s), "
                                 f"it said {summary!r}")
                if worker_err.strip():
                    short.append(f"share {at}/{jobs} stderr:\n{worker_err.strip()}")
                for row in rows:
                    if row[0] in held:
                        held[row[0]].append(row)
                    else:
                        register(*row)
        finally:
            # Whatever ended this run, no worker of it outlives it, and the
            # file they read is removed with the directory holding it.
            for worker in workers:
                if worker.poll() is None:
                    worker.kill()
                    worker.wait()
                # A killed worker never reached its own teardown, so its
                # fixtures are removed by the run that killed it. They are
                # named for the process that made them, which is what makes
                # them findable from here and nobody else's to remove.
                for left in RESOLVER.socket_dir().glob(f"{TOOL}-selftest-*-{worker.pid}"):
                    with contextlib.suppress(OSError):
                        left.unlink()

    # One verdict for the shares between them, reported whether or not any fell
    # short, so the run says the merge was whole rather than saying nothing.
    register(SHARED_CHECKS[0][0], SHARED_CHECKS[0][1], not short, "; ".join(short))
    # The units ran in the workers, so the workers are what watched them print
    # and what saw one of them end a share. Each id's jobs rows become one, and
    # counting them keeps a worker that never reached the row from reading as a
    # worker with nothing to report.
    for cid, said in (RUNNER_CHECKS[0], UNIT_ENDED[True]):
        rows = held[cid]
        wrong = "; ".join(detail for _c, _n, ok, detail in rows if not ok)
        register(cid, said, len(rows) == jobs and not wrong,
                 wrong or (f"{len(rows)} of {jobs} share(s) said"
                           if len(rows) != jobs else ""))
    return out, register


def live_checks(share=None, child=None):
    """Run the live units, or one share of them, against the live context.

    A share is (which, out_of): the units whose place in the registry falls in
    it, and none of the read-only verdicts, which the run that asked for
    shares inherits once for all of them.

    The read-only tier's verdicts come from the child the context ran, so a
    live invocation answers those questions once.

    Returns the rows and the register that filled them: run_selftest has one
    row of its own to add about what this tier printed while it ran, and it
    goes in through that same register. A share refuses a repeated id here, in
    the worker, the way a whole tier refuses one.
    """
    s = _live_context(child)
    out, register = check_rows()
    if not share:
        for row in s.inherited:
            register(*row)
    live_units = [run for _n, _i, run, is_live in UNITS if is_live]
    ended = ""
    for at in in_share(len(live_units), share):
        produced, stopped = ran_unit(live_units[at], s)
        if stopped:
            ended = f"{live_units[at].__name__} ended the run with {stopped}"
            break
        for row in produced:
            register(*row)
    # Registered by a share too, so a unit that ends one worker is named rather
    # than read as a worker that simply had less to say. The merge folds the
    # shares' rows into one, the way it folds what they each watched.
    register(*UNIT_ENDED[True], not ended, ended)
    return out, register

# What one TAB does, pinned by structure rather than by a clock because a timing
# assertion on someone else's machine is a coin toss. zsh reruns completion once
# per matcher-list specification until one produces matches, and oh-my-zsh sets
# three. Nothing was kept between those runs, so a word matching nothing read the
# corpus three times. The first check keeps one emitter call per topic.
#
# The second check keeps the answer complete. LISTMAX is set to zero in this
# isolated terminal so zsh renders the entire synthetic corpus without asking
# for confirmation; that setting belongs to the test, not to the installed
# completion. The assertion is about which candidates the completion offers,
# not about how a particular shell chooses to page or confirm a long listing.


HOSTILE_ROW = "a [bracket] pair, a colon: an apostrophe's, a \"quote\""


COMPLETION_DRIVER = r"""
emulate -L zsh
zmodload zsh/zpty
zmodload zsh/datetime
local bindir=$1 fpdir=$2 fakehome=$3 calls=$4 tool=$5
local chunk buf
local -F deadline
drain() { while zpty -r -t z chunk 0.1 2>/dev/null; do :; done }
await() {  # marker seconds
  deadline=$(( EPOCHREALTIME + $2 ))
  buf=''
  while (( EPOCHREALTIME < deadline )); do
    zpty -r -t z chunk 0.1 2>/dev/null && buf+=$chunk
    [[ $buf == *$1* ]] && return 0
  done
  return 1
}
tabbed() {  # seconds: one completion, waited for rather than timed
  # The completion says when it is done, from inside zle, because nothing
  # outside can. Keys sent ahead of it do not work: zsh treats input waiting to
  # be read as a reason not to list at all, so queuing a marker behind the TAB
  # cancelled the listing the check is about. Waiting for a quiet stretch
  # instead measured the end of the listing by guess, and a machine that paused
  # mid-listing for longer than the guess took a part of it for the whole.
  zpty -w -n z $'\024'      # ^T, bound at setup to complete and then say so
  await TAB-DONE $1 || return 1
  zpty -w -n z $'\025'      # discard the completed line
  drain
}
zpty -b z "HOME=$fakehome CLAUDE_CONFIG_DIR= PATH=$bindir:\$PATH zsh -f -i" \
  || { print DRIVE_FAIL no-pty; return 1 }
# The shell is asked to say it is up rather than waited at in the hope it
# says so on its own: -f skipped every rc file, so nothing here prints a
# greeting, and waiting for one cost the full timeout on every run.
# A pty echoes what is typed, so a marker typed whole would be matched from
# the echo before the shell had read it; split, only the shell's own output
# spells it.
zpty -w z 'print REA${:-}DY'
await READY 10 || { print DRIVE_FAIL no-shell; zpty -d z; return 1 }
drain
# -f skipped every rc file, so the setup is sent instead: a terminal tall and
# wide enough for the synthetic corpus, the three matcher specs oh-my-zsh sets,
# and LISTMAX=0 so the test can inspect every offered candidate without an
# interactive confirmation interrupting its own driver.
zpty -w z "stty rows 400 cols 200; fpath=($fpdir \$fpath); autoload -Uz compinit; compinit -u -D; zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|=*' 'l:|=* r:|=*'; LISTMAX=0; tabmark() { zle expand-or-complete; zle -R; print -r -- TAB-BUFFER:\${BUFFER} >/dev/tty; print -r -- TAB-DONE >/dev/tty; }; zle -N tabmark; bindkey '^T' tabmark; print SETUP\${:-}-DONE"
await SETUP-DONE 30 || { print DRIVE_FAIL no-setup; zpty -d z; return 1 }
drain
zpty -w -n z "$tool zzqqxxnothing"
tabbed 40 || { print DRIVE_FAIL no-tab-one; zpty -d z; return 1 }
cp -- $calls $calls.after-one-tab
zpty -w -n z "$tool "
tabbed 40 || { print DRIVE_FAIL no-tab-bare; zpty -d z; return 1 }
print -r -- "$buf" > $calls.bare
zpty -w -n z "$tool --"
tabbed 40 || { print DRIVE_FAIL no-tab-flags; zpty -d z; return 1 }
print -r -- "$buf" > $calls.flags
zpty -w -n z "$tool --promote side --as-agent "
tabbed 40 || { print DRIVE_FAIL no-tab-as-name; zpty -d z; return 1 }
print -r -- "$buf" > $calls.as-name
zpty -w -n z "$tool --promote side --as-agent side-name@"
tabbed 40 || { print DRIVE_FAIL no-tab-as-team; zpty -d z; return 1 }
print -r -- "$buf" > $calls.as-team
cp -- $calls $calls.before-nocache
mkdir -p $calls.cache-before $calls.cache-after
cp -a $fakehome/.cache/$tool/*(N.) $calls.cache-before/ 2>/dev/null
zpty -w z "zstyle ':completion:*:*:$tool:*' use-cache false; print NOCACHE\${:-}-SET"
await NOCACHE-SET 10 || { print DRIVE_FAIL no-nocache-style; zpty -d z; return 1 }
drain
zpty -w -n z "$tool zzqqxxnothing"
tabbed 40 || { print DRIVE_FAIL no-tab-nocache; zpty -d z; return 1 }
cp -- $calls $calls.after-nocache
cp -a $fakehome/.cache/$tool/*(N.) $calls.cache-after/ 2>/dev/null
zpty -d z
print DRIVE_OK
"""


def completion_tab_checks():
    """Both TAB checks off one drive of a real interactive zsh.

    The corpus is a stub emitter printing 320 candidates in the shape the real
    one prints, and HOME is a temporary directory, so this reads and writes
    nothing of the machine's own: what is being tested is the completion file,
    not this machine's teams.
    """
    out = []
    zsh = shutil.which("zsh")
    if not zsh:
        for cid, name in (("completion-reads-corpus-once",
                           "one TAB reads the corpus once, however often zsh reruns it"),
                          ("completion-bare-tab-offers-whole-corpus",
                           "a bare TAB offers every teammate, team and lead"),
                          ("completion-flag-row-survives-escaping",
                           "a menu row keeps its brackets, colon and quotes on the way into zsh"),
                          ("completion-as-agent-is-staged",
                           "--as-agent first inserts name@, then offers the current parent team first"),
                          ("completion-use-cache-false-bypasses-cache",
                           "use-cache false reruns emitters without changing cache files")):
            out.append((cid, name, False, "no zsh on this machine, and only zsh can answer this"))
        return out

    stage = Path(tempfile.mkdtemp(prefix=f"{TOOL}-tab-"))
    try:
        binned, fpdir, home = stage / "bin", stage / "fp", stage / "home"
        for path in (binned, fpdir, home / ".claude" / "teams", home / ".claude" / "projects"):
            path.mkdir(parents=True)
        # Five session clusters of forty, then teams and leads: the shape and
        # the order the real emitter prints, at about the size it prints here.
        lines = [f"names\tsession-{g:08x}  2026-08-0{g + 1} 10:00:00\t"
                 f"agent{g}-{m:02d}@session-{g:08x}\ttask {g}.{m}\t"
                 for g in range(5) for m in range(40)]
        lines += [f"teams\tsession-{i:08x}:2 members, 2026-08-01 10:00:00" for i in range(60)]
        lines += [f"leads\tteam-lead@session-{i:08x}\tled something, joined 2026-08-01 10:00:00\t"
                  for i in range(60)]
        (stage / "lines").write_text("\n".join(lines) + "\n")
        calls = stage / "calls"
        calls.touch()
        stub = binned / TOOL
        # One flag whose menu row carries every character that means something
        # to _arguments or to the shell: a bracket pair, a colon, an apostrophe
        # and a double quote. Proving the escaping against these is the point;
        # proving it against the flags that happen to exist today would only
        # say that today's prose is tame.
        hostile = HOSTILE_ROW
        (stage / "flags").write_text(
            "--plain\ta plain row\t\t\n"
            f"--hostile\t{hostile}\t\t\n"
            "--valued\ttakes something\t\tthing\n"
            "--promote\tconvert a side\tsides\tside\n"
            "--as-agent\toverride identity\t_agent_resume_as_agent\tname@team\n")
        stub.write_text(f'#!/bin/sh\necho "$2" >> {calls}\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "selector" ] '
                        f'&& exec cat {stage / "lines"}\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "flags" ] '
                        f'&& exec cat {stage / "flags"}\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "as-agent-name:side" ] '
                        f'&& printf "side-name\\n" && exit 0\n'
                        f'[ "$1" = "--complete" ] && [ "$2" = "as-agent:side" ] '
                        f'&& printf "side-name@current:current parent\\nside-name@other:another team\\n" && exit 0\n'
                        f'exit 0\n')
        stub.chmod(0o755)
        shutil.copy2(Path(__file__).resolve().parent / f"_{TOOL}", fpdir / f"_{TOOL}")
        (stage / "drive.zsh").write_text(COMPLETION_DRIVER)

        # Its own session, so the backstop timeout can take the whole group:
        # the drive holds an interactive shell open on a pty, and killing only
        # the script it started would leave that shell behind for the checks
        # that count what is running.
        drive = subprocess.Popen([zsh, str(stage / "drive.zsh"), str(binned), str(fpdir),
                                  str(home), str(calls), TOOL],
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 text=True, start_new_session=True)
        try:
            run = subprocess.CompletedProcess(drive.args, 0, *drive.communicate(timeout=300))
        except subprocess.TimeoutExpired:
            os.killpg(os.getpgid(drive.pid), 9)
            run = subprocess.CompletedProcess(drive.args, -1, *drive.communicate())
        drove = "DRIVE_OK" in run.stdout
        first = calls.with_suffix(".after-one-tab")
        topics = first.read_text().split() if first.exists() else []
        # One read per topic is the floor: a TAB asks for flags always and for
        # the selector when the word is in the selector's place. Twice for the
        # same topic is the fault, because that is zsh running the whole
        # completion again under the next matcher spec with nothing kept.
        twice = sorted({t for t in topics if topics.count(t) > 1})
        listing = calls.with_suffix(".bare")
        shown = listing.read_text(errors="replace") if listing.exists() else ""
        # The pty carries the escapes the terminal would have acted on; strip
        # them, and \r as well, so one displayed row reads as one line here.
        plain = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", shown).replace("\r", "\n")
        rows = [row for row in plain.split("\n") if " -- " in row]
        asked = "possibilities" in plain

        said = run.stdout.strip().splitlines()[-1:] or [(run.stderr or "no output").strip()[:80]]
        stalled = f"the drive did not finish: {said[0]}"
        out.append(("completion-reads-corpus-once",
                    "one TAB reads each topic once, however often zsh reruns it",
                    drove and bool(topics) and not twice,
                    f"read twice: {twice}" if twice else f"{len(topics)} read(s): {topics}"
                    if drove else stalled))
        flagfile = calls.with_suffix(".flags")
        flagged = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "",
                         flagfile.read_text(errors="replace") if flagfile.exists() else ""
                         ).replace("\r", "\n")
        # zsh wraps a listing at the terminal width, so the row is compared
        # with its own line breaks taken back out.
        unwrapped = flagged.replace("\n", "")
        intact = HOSTILE_ROW.replace("\n", "") in unwrapped
        offered_hostile = "--hostile" in flagged
        out.append(("completion-flag-row-survives-escaping",
                    "a menu row keeps its brackets, colon and quotes on the way into zsh",
                    drove and offered_hostile and intact,
                    (f"offered: {offered_hostile}, row intact: {intact}")
                    if drove else stalled))
        out.append(("completion-bare-tab-offers-whole-corpus",
                    "a bare TAB offers every teammate, team and lead",
                    drove and not asked and len(rows) == len(lines),
                    f"{len(rows)} of {len(lines)} rows offered, zsh asked first: {asked}"
                    if drove else stalled))
        name_file, team_file = calls.with_suffix(".as-name"), calls.with_suffix(".as-team")
        name_text = (name_file.read_text(errors="replace") if name_file.exists() else "")
        team_text = (team_file.read_text(errors="replace") if team_file.exists() else "")
        name_plain = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", name_text).replace("\r", "\n")
        team_plain = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", team_text).replace("\r", "\n")
        buffers = re.findall(r"TAB-BUFFER:([^\n]*)", name_plain)
        staged = bool(buffers and buffers[-1].endswith("--as-agent side-name@"))
        current_at, other_at = team_plain.find("side-name@current"), team_plain.find("side-name@other")
        ordered = current_at >= 0 and other_at > current_at
        out.append(("completion-as-agent-is-staged",
                    "--as-agent first inserts name@, then offers the current parent team first",
                    drove and staged and ordered,
                    (f"buffer={buffers[-1]!r}, current index={current_at}, other index={other_at}"
                     if buffers else "no TAB-BUFFER marker") if drove else stalled))
        before_calls = calls.with_suffix(".before-nocache")
        after_calls = calls.with_suffix(".after-nocache")
        before_topics = before_calls.read_text().split() if before_calls.exists() else []
        after_topics = after_calls.read_text().split() if after_calls.exists() else []

        def cache_snapshot(directory):
            return {path.relative_to(directory).as_posix():
                    (path.read_bytes(), path.stat().st_mtime_ns)
                    for path in directory.rglob("*") if path.is_file()}

        cache_before = cache_snapshot(calls.with_suffix(".cache-before"))
        cache_after = cache_snapshot(calls.with_suffix(".cache-after"))
        reran = (after_topics.count("flags") > before_topics.count("flags")
                 and after_topics.count("selector") > before_topics.count("selector"))
        out.append(("completion-use-cache-false-bypasses-cache",
                    "use-cache false reruns emitters without changing cache files",
                    drove and reran and cache_before == cache_after,
                    (f"calls {len(before_topics)} -> {len(after_topics)}, "
                     f"cache files {len(cache_before)}, unchanged {cache_before == cache_after}")
                    if drove else stalled))
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    return out


def check_line(cid, name, detail="", verdict=None, idwidth=0, namewidth=0):
    """One check as a line, wherever it is printed.

    The failure list, the full table and the listing show the same check with
    different amounts of it: a verdict where there is one to report, columns
    where there are rows to line up, a detail where the check left one. Asked
    here so the three cannot drift, which is how a listing once lost the
    description while the other two kept it.
    """
    said = "" if verdict is None else f"  {'PASS' if verdict else 'FAIL'}  "
    return (f"{said}{cid:<{idwidth}}  {name:<{namewidth}}"
            + (f"  ({detail})" if detail else ""))


def check_report(results, failed_only=False):
    """The suite's verdicts as lines.

    The failure list names one check per line and ends with a summary, so a
    reader can diff two runs instead of searching one, and a run that died
    has no summary to be mistaken for a clean one.
    """
    failed = sum(1 for _, _, ok, _ in results if not ok)
    if failed_only:
        lines = [check_line(cid, name, detail)
                 for cid, name, ok, detail in results if not ok]
        return lines + [f"checks: {len(results) - failed} ok, {failed} failed"]
    idwidth = max((len(cid) for cid, _, _, _ in results), default=0)
    width = max((len(name) for _, name, _, _ in results), default=0)
    lines = [check_line(cid, name, detail, verdict=ok,
                        idwidth=idwidth, namewidth=width)
             for cid, name, ok, detail in results]
    return lines + ["", f"{len(results) - failed}/{len(results)} checks passed"]


def _selftest_report(results, failed_only):
    """Print one tier's verdicts, however the run assembled them."""
    for line in check_report(results, failed_only):
        print(line)
    return 1 if any(not ok for _, _, ok, _ in results) else 0


def _suite_context():
    """Everything the units share, computed once.

    A dependency between units is written down here rather than
    inherited from scope, so a unit run on its own says what it wants
    instead of reading whatever a neighbour left behind.
    """
    s = types.SimpleNamespace()
    # The suite's own functions, taken from the registry rather than listed: a
    # unit added later is covered without anyone remembering, which is what a
    # hand-kept exemption list gets wrong.
    s.suite_fns = ({run.__name__ for _n, _i, run, _l in UNITS}
                   | {"_suite_context", "_live_context", "run_selftest",
                      "live_checks", "unit"})
    """Assert the invariants this tool keeps rediscovering. Read-only.

    Two kinds: structural ones read from this file's own syntax tree, because
    an invariant like "only the engine picks a transcript" is a property of the
    code rather than of a run; and behavioural ones exercised against the
    portable fixture corpus under test/, so the answer never depends on what
    happens to be on the machine running the suite (see corpus_engine()).
    """
    import ast
    import tempfile

    def corpus_engine():
        """A Resolver pointed at test/corpus/ instead of this machine.

        A fresh instance every call, never the shared RESOLVER: sharing one
        would let one check's cached stamps or spawn index leak into the
        next. The fixture is checked-in data, composed once, so every
        machine that runs this suite - a laptop with years of real teams or
        a bare CI checkout with none - exercises the same behaviour.
        """
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        corpus = Path(__file__).resolve().parent / "test" / "corpus"
        eng.projects_dir = corpus / "projects"
        eng.teams_dir = corpus / "teams"
        return eng

    source = Path(__file__).resolve().read_text()
    tree = ast.parse(source)
    _source_lines = source.splitlines()
    _segments = {}

    def src_of(node):
        """The source text of one node, sliced from lines split once.

        Identical to ast.get_source_segment, which re-splits the whole file on
        every call. Structural checks ask for a function's text a few hundred
        times per run, and over this file that was most of the read-only tier's
        runtime: measured 2.28s for one pass over the 446 function and class
        nodes against 0.0008s for this. Verified equal to get_source_segment on
        every one of them, nested ones included.
        """
        key = (node.lineno, node.col_offset, node.end_lineno, node.end_col_offset)
        text = _segments.get(key)
        if text is None:
            first, last = node.lineno - 1, node.end_lineno - 1
            if first == last:
                text = _source_lines[first][node.col_offset:node.end_col_offset]
            else:
                text = "\n".join([_source_lines[first][node.col_offset:]]
                                  + _source_lines[first + 1:last]
                                  + [_source_lines[last][:node.end_col_offset]])
            _segments[key] = text
        return text

    def is_delegate(node):
        """A transitional forwarder: one return of RESOLVER.<same name>(*a, **k).

        Recognised by shape rather than by a name list, so the step-5 deletion
        cannot leave a stale exemption behind, and so a hand-written function
        cannot quietly acquire one.
        """
        if len(node.body) != 1 or not isinstance(node.body[0], ast.Return):
            return False
        call = node.body[0].value
        return (isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute)
                and getattr(call.func.value, "id", None) == "RESOLVER"
                and call.func.attr == node.name)

    funcs = {n.name: n for n in ast.walk(tree)
             if isinstance(n, ast.FunctionDef) and not is_delegate(n)}

    # What each function calls, by either spelling, indexed in one pass. The
    # question below is asked a few dozen times and each answer is a lookup:
    # one walk over the tree serves them all.
    _calls_in = {}
    for _name, _node in funcs.items():
        _called = set()
        for _sub in ast.walk(_node):
            if isinstance(_sub, ast.Call):
                _spelled = getattr(_sub.func, "id", None)
                if _spelled is None and isinstance(_sub.func, ast.Attribute):
                    _spelled = _sub.func.attr
                if _spelled is not None:
                    _called.add(_spelled)
        _calls_in[_name] = _called

    def callers_of(target):
        """Callers by either spelling: a module function calls `target(...)`, an
        engine method calls `self.target(...)`. Matching only the first lets
        every invariant below pass by vacuity for an engine that is a class,
        which is the opposite of what they are for."""
        return {name for name, called in _calls_in.items() if target in called}

    # -- structural
    dupes = [n for n in ("resolve_transcript", "edit_team_config", "socket_alive",
                         "runtime", "agent_runtime", "team_runtime",
                         "_lead_process", "stamp_index", "process_table", "_session_registry")
             if sum(1 for f in ast.walk(tree) if isinstance(f, ast.FunctionDef)
                    and f.name == n and not is_delegate(f)) != 1]

    # What the units read. The rest of what this function binds is read here,
    # through the closures that need it: callers_of holds _calls_in, src_of
    # holds _segments and _source_lines, and is_delegate is called by funcs and
    # by dupes above.
    s.ast = ast
    s.callers_of = callers_of
    s.corpus_engine = corpus_engine
    s.dupes = dupes
    s.funcs = funcs
    s.source = source
    s.src_of = src_of
    s.tempfile = tempfile
    s.tree = tree
    return s


