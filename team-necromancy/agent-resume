        # prints the command for the operator to run rather than spawning one.
        # A "launched" here would mean it had started a lead behind their back.
        "the migration goes through and hands the launch back": status == "manual",
        "the transcript comes back as the destination team": after.get("stamp") == dest,
        "it says so in a receipt naming both teams":
            len(receipts) == 1
