            == [("cmdline", stranger), ("stat", stranger)]
            and [(pane["root"]["argv"], pane["root"]["state"]) for pane in fact["panes"]]
            == [((), None)])
        everything += fence.leave()
        # A grandchild the run learns in one unit, which its own parent then
        # reaps: asked about in the next unit, it is gone and known, so it reads
        # as gone and is not refused.
        parent = subprocess.Popen([sys.executable, "-c",
                                   "import subprocess, sys\n"
                                   "child = subprocess.Popen(['sleep', '30'])\n"
                                   "print(child.pid, flush=True)\n"
                                   "sys.stdin.readline()\n"
                                   "child.kill()\n"
                                   "child.wait()\n"
                                   "print('reaped', flush=True)\n"
                                   "sys.stdin.readline()\n"],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
