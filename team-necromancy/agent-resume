def demote_mail_receipt_path(stem):
    """The archive written only when --with-mail preserves inbox bytes."""
    return RECEIPTS_DIR / f"{stem}.demote-mail.json"


def _write_descriptor(descriptor, path, data, mode):
    """Write selected bytes and capture the descriptor's actual permissions."""
    with os.fdopen(descriptor, "wb", closefd=False) as handle:
        handle.write(data)
        handle.flush()
        if mode is not None:
            os.fchmod(handle.fileno(), mode)
        os.fsync(handle.fileno())
    stat = os.fstat(descriptor)
    return FileObservation(
        path, (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns, data),
        stat.st_mode & 0o777)


def write_new_bytes(path, data, mode=0o600):
    """Create one absent destination exclusively and return its file observation."""
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    except FileExistsError:
        die(f"a conversion destination appeared at {path}; nothing was overwritten")
    try:
        return _write_descriptor(descriptor, path, data, mode)
    finally:
        os.close(descriptor)


def materialize(operation):
    """Apply one proved promotion after exact pre-write and pre-unlink checks."""
    plan = operation["conversion"]
    if plan["objections"] or not plan["proved"]:
        raise ValueError("materialize was handed an unproved plan")
    checked = RESOLVER.revalidate_conversion(operation)
    if not checked["matches"]:
        die("the selected promotion inputs changed (" +
            ", ".join(checked["changed"]) + "); nothing was written")
    dest, source = plan["dest_path"], plan["source"]
    try:
        keep_mode = source.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    data = _jsonl_text(plan["lines"], plan["newline"]).encode("utf-8")
    try:
        created = write_new_bytes(dest, data, keep_mode)
    finally:
        RESOLVER.refresh_transcript_evidence()
    checked = RESOLVER.revalidate_conversion(
        operation, destination_created=created.generation)
    if not checked["matches"]:
        die("promotion inputs changed after the destination was created (" +
            ", ".join(checked["changed"]) + f"); source remains at {source} "
            f"and the proved copy remains at {dest}")
    source.unlink()
    RESOLVER.refresh_transcript_evidence()
    meta = source.with_name(source.stem + ".meta.json")
    if operation["side_meta_generation"] != ("absent",):
        meta.unlink()
        RESOLVER.refresh_transcript_evidence()
    return plan["receipt"]


def embed(operation):
    """Apply one proved demotion after exact pre-write and pre-unlink checks."""
    plan = operation["conversion"]
    if plan["objections"] or not plan["proved"]:
        raise ValueError("embed was handed an unproved plan")
    checked = RESOLVER.revalidate_conversion(operation)
    if not checked["matches"]:
        die("the selected demotion inputs changed (" +
            ", ".join(checked["changed"]) + "); nothing was written")
    dest, source = plan["dest_path"], plan["source"]
    try:
        keep_mode = source.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    receipt = {key: value for key, value in plan["receipt"].items()
               if not key.startswith("_")}
    data = _jsonl_text(plan["lines"], plan["newline"]).encode("utf-8")
    try:
        created = write_new_bytes(dest, data, keep_mode)
    finally:
        RESOLVER.refresh_transcript_evidence()
    meta_path = operation["destination_meta"]
    if "side_meta_b64" in receipt:
        meta_data = base64.b64decode(receipt["side_meta_b64"], validate=True)
        meta_mode = receipt["side_meta_mode"]
    else:
        meta_data = json.dumps({
            "isFork": False,
            "description": f"demoted from session {source.stem}",
        }).encode("utf-8")
        meta_mode = 0o600
    try:
        created_meta = write_new_bytes(meta_path, meta_data, meta_mode)
    finally:
        RESOLVER.refresh_transcript_evidence()
    checked = RESOLVER.revalidate_conversion(
        operation, destination_created=created.generation,
        destination_meta_created=created_meta.generation)
    if not checked["matches"]:
        die("demotion inputs changed after the destination was created (" +
            ", ".join(checked["changed"]) + f"); source remains at {source}, "
            f"the proved copy remains at {dest}, and its metadata remains at {meta_path}")
    if "mail" in receipt:
        RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
        replace_json(demote_mail_receipt_path(source.stem), {
            "source": str(source), "dest": str(dest),
            "at": int(time.time() * 1000), "mail": receipt["mail"]})
    source.unlink()
    RESOLVER.refresh_transcript_evidence()
    return receipt


def differing(before, after):
    """Which entries changed between two reads of the same files.

    A name on one side only is a change; so is a byte difference; and so is a
    stat fact moving under identical bytes, because a writer that replaces a
    file by rename leaves the same text on a new inode.
    """
    return sorted(name for name in set(before) | set(after)
                  if before.get(name) != after.get(name))


def said_reads(reads):
    """What a read covered, and the facts each entry was read under.

    The facts are the honest part of a preview: they say which version of the
    file the reader was looking at, so a line about what a receipt would hold
    can be checked against what is on disk now.
    """
    return ", ".join(
        (f"{name} ({read['size']} bytes, last written "
         f"{ms_str(read['mtime_ns'] // 1_000_000)})") if read["size"] is not None
        else f"{name} ({read['why']})"
        for name, read in sorted(reads.items()))


def reap_team(plan, dry=False, prefix=""):
    """Apply one selected team retirement cut and capture late owned writes."""
    team = plan["team"]
    team_dir, staged = plan["path"], plan["staged"]
    receipt_at = plan["receipt_path"]

    def prepared(reads):
        return {"kind": "rebind-reap", "team": team,
                "at": int(time.time() * 1000),
                "config": reads.get("config.json", {}).get("text"),
                "mail": {name.split("/", 1)[1]: read["text"]
                         for name, read in sorted(reads.items())
                         if name.startswith("inboxes/")}}

    if dry:
        step(True, f"would archive {said_reads(plan['receipt_contents'])}, as they "
                   "read just now; a dry run makes no cut, so anything written "
                   "after that read is in no preview", "", indent=prefix)
        return receipt_at
    checked = RESOLVER.revalidate_reap(plan)
    if not checked["matches"]:
        die("the selected reap generation changed; nothing was moved. Run the command again")
    try:
        os.rename(team_dir, staged)
    except OSError as exc:
        die(f"cannot move {team}'s directory aside to reap it: {exc}")

    caught = RESOLVER.revalidate_reap(plan, staged=staged)
    late = caught["current"] != plan["generation"]
    stable = RESOLVER.revalidate_reap(
        plan, staged=staged, expected_generation=caught["current"])
    if not stable["matches"]:
        try:
            os.rename(staged, team_dir)
        except OSError as exc:
            die(f"{team} changed after the cut and moving it back failed: {exc}; "
                f"nothing was deleted and the directory is at {staged}")
        die(f"{team} changed after it was moved aside, so something is still writing "
            f"to it. Nothing was deleted and the directory is back at {team_dir}")

    receipt = prepared(caught["contents"])
    RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
    replace_json(receipt_at, receipt)
    strays = list(caught["strays"])
    for relative in sorted(caught["tool_files"],
                           key=lambda item: item.name == "config.json"):
        try:
            (staged / relative).unlink()
        except OSError as exc:
            strays.append(f"{relative} ({exc})")
    for empty in (staged / "inboxes", staged):
        try:
            empty.rmdir()
        except OSError:
            pass
    step(False, "", f"archived {said_reads(caught['contents'])}" +
         (", including writes captured at the cut" if late else ""), indent=prefix)
    if staged.is_dir():
        where = staged
        if not team_dir.exists():
            try:
                os.rename(staged, team_dir)
                where = team_dir
            except OSError:
                pass
        held = (f"holds {some_of(strays)}, which this tool did not put there"
                if strays else "still holds entries after its owned files were removed")
        warn(f"{team}'s directory {held}; it is at {where}. Its roster is archived "
             f"in {receipt_at}, so the team is retired")
    elif team_dir.exists():
        warn(f"{team_dir} was recreated after the reap and is left alone")
    return receipt_at


def archive_inbox(plan):
    """Apply one selected mailbox cut and retain every byte before that cut."""
    if not plan or not plan["present"]:
        return None, None
    checked = RESOLVER.revalidate_reap(plan)
    if not checked["matches"]:
        die("the selected mailbox generation changed; nothing was archived")
    box, staged = plan["path"], plan["staged"]
    try:
        os.rename(box, staged)
    except OSError as exc:
        die(f"cannot move {plan['name']}'s inbox aside to archive it: {exc}")
    seed = staged.with_name(staged.name + ".seed")
    try:
        seed.write_text("[]")
        os.link(seed, box)
    except FileExistsError:
        warn(f"{box} was remade while its mail was being archived; its current "
             "contents are left alone")
    except OSError as exc:
        warn(f"{box} could not be put back as an empty mailbox: {exc}")
    finally:
        try:
            seed.unlink()
        except OSError:
            pass
    caught = RESOLVER.revalidate_reap(plan, staged=staged)
    stable = RESOLVER.revalidate_reap(
        plan, staged=staged, expected_generation=caught["current"])
    if not stable["matches"]:
        try:
            if box.read_text() == "[]":
                os.replace(staged, box)
                where = box
            else:
                where = staged
        except OSError:
            where = staged
        die(f"{plan['name']}'s inbox changed after it was moved aside. Nothing "
            f"was archived; the mail is at {where}")
    read = caught["contents"].get(plan["receipt_key"])
    return (read["text"] if read else None), staged


def apply_restamp(plan):
    """Apply a proved restamp; its only receipt is the in-file record."""
    if plan["objections"] or not plan["proved"]:
        raise ValueError("apply_restamp was handed an unproved plan")
    path = plan["path"]
    try:
        keep_mode = path.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    replace_text(
        path, _jsonl_text(plan["lines"], plan["newline"]), mode=keep_mode)
    RESOLVER.refresh_transcript_evidence()


def reap_blockers(plan):
    """Render the objections already classified by one rebind plan."""
    lines = []

    def blocker(group, heading):
        lines.append(heading)
        lines.extend(f"- {row['said']}" for row in group[:4])
        if len(group) > 4:
            lines.append(f"- and {len(group) - 4} more like these")

    def kind(*wanted):
        return tuple(row for row in plan["blockers"] if row["kinds"] & set(wanted))

    mail, alive, held, rewrite = (
        kind("mail"), kind("wears", "operates"), kind("holds"), kind("rewrite"))
    if mail:
        blocker(mail,
                "mail is waiting, and --with-mail archives it into the receipt:")
    if alive:
        blocker(alive,
                "a live process runs as it, and --force instead rewrites the "
                "team this conversation comes back as: two fields, receipted, "
                "reversible:")
    if held:
        blocker(held,
                "a live process holds this conversation, and a rewrite cannot "
                "run under it; stop it first, nothing forces this one:")
    if rewrite:
        blocker(rewrite, "the identity rewrite could not be proved:")
    return tuple(lines)


def rebind_reap(plan, args, prefix="", fatal=True, members=None):
    """Apply the action selected by one immutable rebind plan.

    `members` names the members a team run retires the team for, once, before
    the first of them starts; without it the plan is one conversation's.
    """
    lines = reap_blockers(plan)
    if plan["action"] == "blocked":
        said = (f"a rebind onto {plan['dest']} needs {plan['source']} retired, "
                "and it refuses:\n" + "\n".join(lines))
        if fatal:
            die(said)
        warn(said)
        return False
    stamped, dest, path = plan["source"], plan["dest"], plan["path"]
    if plan["action"] == "restamp":
        restamp = plan["restamp"]
        step(args.dry_run,
             f"would rewrite the team this conversation comes back as: {stamped} "
             f"-> {dest}  (receipt: last {RESTAMP_RECORD} record in {path})",
             f"rewrote the team this conversation comes back as: {stamped} "
             f"-> {dest}  (receipt: last {RESTAMP_RECORD} record in {path})",
             indent=prefix)
        if not args.dry_run:
            apply_restamp(restamp)
        print(f"{prefix}rebound  this transcript runs as {dest} from now on; "
              "nothing further is needed")
        return "restamped"
    receipt = RECEIPTS_DIR / f"{stamped}.json"
    print(f"{prefix}{'would reap' if args.dry_run else 'reaped'}   {stamped}  "
          f"(roster archived: {receipt})")
    reap_team(plan["reap"], dry=args.dry_run, prefix=prefix + "         ")
    if members:
        print(fill(f"{prefix}rebound  {members} start as {dest}"))
        print(fill(f"{prefix}fragile  they go back to {stamped} if that team is ever "
                   f"recreated; run /compact in each to make {dest} permanent"))
        print(fill(f"{prefix}quiet    until then they send no idle notifications; "
                   "mail still works in both directions"))
        return "reaped"
    print(f"{prefix}rebound  this transcript now runs as {dest}")
    print(fill(f"{prefix}fragile  it goes back to {stamped} if that team is ever "
               f"recreated; run /compact in it to make {dest} permanent"))
    print(fill(f"{prefix}quiet    until then it sends no idle notifications; "
               "mail still works in both directions"))
    return "reaped"


def ask_default_yes(question):
    """Ask one helpful Y/n question; an unattended run takes the default."""
    if not sys.stdin.isatty():
        return True
    try:
        answer = input(question + " [Y/n] ").strip().lower()
    except EOFError:
        answer = ""
    except KeyboardInterrupt:
        print()
        return False
    return not answer.startswith("n")


def ask_default_no(question, dry_run=False):
    """Ask one y/N question. A preview or input-less run takes the default."""
    if dry_run:
        print("choice   no  (dry run; y/N defaults to no)")
        return False
    if not sys.stdin.isatty():
        print("choice   no  (no terminal; y/N defaults to no)")
        return False
    try:
        answer = input(question + " [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer in ("y", "yes")


def promotion_identity(plan, args):
    """Apply the user's undo choice to alternatives already proved by Resolver."""
    selected = plan
    undo = plan.get("undo")
    if undo:
        print(fill(f"undo     the final demote receipt can restore "
                   f"{undo['identity']['agentId']} exactly"))
        entry = plan["entry"]
        print(fill(f"current  this side transcript now belongs to parent "
                   f"{entry['parent']}, with the deduced team "
                   f"{plan['identity']['team']} ({plan['identity_source']})"))
        if ask_default_no("cleanly undo that demote instead", args.dry_run):
            selected = types.MappingProxyType({
                **plan,
                "identity": undo["identity"],
                "identity_source": "accepted clean undo",
                "conversion": undo["conversion"],
                "destination_generation": undo["destination_generation"],
                "objections": tuple(
                    item for item in (plan.get("age_objection"),)
                    if item),
            })
    return selected


def run_promote(args):
    """--promote <side> [--as-agent name@team]: a side transcript becomes a teammate."""
    operation = RESOLVER.promotion_plan(
        args.promote, as_agent=args.as_,
        unwrap=True if getattr(args, "unwrap", False) else None,
        force=args.force)
    operation = promotion_identity(operation, args)
    if operation["objections"]:
        die("; ".join(operation["objections"]))
    entry = operation["entry"]
    identity = operation["identity"]
    plan = operation["conversion"]
    name, team = identity["name"], identity["team"]
    dest = plan["dest_path"]
    print(f"promote  {entry['parent'][:8]}/{entry['name'] or entry['task_id']}  "
          f"({entry['grammar']}, {len(plan['lines'])} lines)")
    if identity["name_defaulted"]:
        print(f"name     {name}  (from the side transcript's meta)")
    print(f"as       {identity['agentId']}")
    if not (args.as_ and name_and_team(args.as_)[1]):
        print(f"team     {team}  ({operation['identity_source']})")
    print(f"into     {dest}")
    if plan["receipt"].get("_emitted"):
        print(f"receipt  wrote the last {RECEIPT_RECORD} record in {dest}")
    else:
        print(f"receipt  consumed the inverse {RECEIPT_RECORD} record")
    launch = [sys.argv[0], identity["agentId"], "--resume", dest.stem]
    launch_line = f"launch   {shlex.join(launch)}"
    if args.dry_run:
        print(f"{launch_line}  (dry run; nothing written)")
        return 0
    materialize(operation)
    if args.no_launch:
        print("member   recorded in the transcript; the population and the doctor "
              "see it, and the first launch registers it")
        print(f"{launch_line}")
        return 0
    os.execvp(launch[0], launch)


def authorize_demotion_parent(selection, mate_team, args):
    """Apply confirmation policy without selecting another parent."""
    if selection["objection"]:
        remedy = f". {selection['remedy']}" if selection["remedy"] else ""
        die(f"{selection['objection']}{remedy}")
    if not selection["confirmation_required"]:
        return selection
    parent = selection["parent"]
    print(fill("warning  no promotion receipt records the former parent, so this "
               "cannot be selected as a clean undo"))
    print(fill(f"candidate the transcript currently belongs to {mate_team}; its lead "
               f"session is {parent} ({selection['source']})"))
    question = f"demote it under team {mate_team}'s lead session {parent}"
    if args.dry_run or not sys.stdin.isatty():
        ask_default_no(question, dry_run=args.dry_run)
        die(f"left unchanged; {selection['remedy']}")
    if not ask_default_no(question):
        die(f"left unchanged; {selection['remedy']}")
    return selection


def run_demote(args):
    """--demote <session> [--into-session <parent>]: a teammate becomes a side transcript."""
    operation = RESOLVER.demotion_plan(
        args.demote, into=args.into, force=args.force,
        archive_mail=args.with_mail)
    if operation["objections"]:
        die("; ".join(operation["objections"]))
    identity = operation["identity"]
    parent = authorize_demotion_parent(
        operation["parent"], identity["team"], args)
    plan = operation["conversion"]
    path = operation["path"]
    print(f"demote   {path.stem[:8]}  ->  {plan['dest_path']}")
    if not args.into:
        print(f"parent   {parent['parent']}  ({parent['source']})")
    if args.dry_run:
        return 0
    staged_mail = None
    if identity["team"] and identity["name"] and args.with_mail:
        mail, staged_mail = archive_inbox(operation["archive"])
        plan = types.MappingProxyType({
            **plan,
            "receipt": immutable({**plan["receipt"], "mail": mail}),
        })
        operation = types.MappingProxyType({**operation, "conversion": plan})
    embed(operation)
    if staged_mail is not None:
        staged_mail.unlink()
        print(f"mail     {demote_mail_receipt_path(path.stem)}")
    consumed = plan["receipt"].get("_consumed")
    emitted = plan["receipt"].get("_emitted")
    if consumed and emitted:
        print("receipt  replaced the inverse record with a demote record in the side transcript")
    elif consumed:
        print(f"receipt  consumed the inverse {RECEIPT_RECORD} record")
    else:
        print(f"receipt  wrote a demote {RECEIPT_RECORD} record in the side transcript")
    return 0


# One layout for the ledger's header and its rows, so a label cannot drift
# off the column it names. The state column is as wide as the longest state
# ("unknown recipient"), so every summary starts in the same column.
MAIL_ROW = "{sent:<19}  {sender:>14} -> {to:<14} {state:<17} {summary}"


def run_mail_ledger(selector=None):
    """A team's mail, send side joined against delivery side. Read-only.

    A row is a per-send fact and stays one. The explanation attached to a row
    is not: seventeen sends to one unknown name printed the same sentence
    seventeen times. So the explanations are grouped by addressee and state
    and said once under the rows, each carrying how many sends it covers.
    The states themselves stay on their own rows, where they were asked for.
    """
    answer = RESOLVER.mail_answer(selector)
    if answer["objection"]:
        die(answer["objection"])
    ledger = answer["entries"]
    print(MAIL_ROW.format(sent="sent", sender="from", to="to", state="state",
                          summary="summary"))
    # What the fixed columns leave. Formatting the row with every field empty
    # measures the layout rather than restating its widths here.
    room = max(term_width() - len(MAIL_ROW.format(
        sent="", sender="", to="", state="", summary="")), 24)
    for entry in ledger:
        print(MAIL_ROW.format(
            sent=ms_str(entry["sent"]), sender=entry["sender"],
            to=entry["to"] or "?", state=entry["state"],
            summary=clip(entry["summary"], room)))
    if answer["groups"]:
        print(fill("\nnotes    one per addressee and state, however many sends "
                   "repeat it"))
        counted = tuple(
            f"{group['count']} send{'' if group['count'] == 1 else 's'}, "
            f"{group['state']}" for group in answer["groups"])
        column = max(len(said) for said in counted)
        for group, said in zip(answer["groups"], counted):
            head = f"  {group['to']:<14} {said:<{column}}  "
            detail = group["detail"]
            # fill hangs a continuation under the first column of a line, which
            # here is the addressee. The detail is the last column, so a long
            # one is indented back to it rather than into the counts.
            body = fill(detail, width=max(term_width() - len(head), 24)).split("\n")
            print("\n".join([head + body[0]]
                            + [" " * len(head) + line for line in body[1:]]))
    print("\n" + ", ".join(
        f"{count} {state}" for state, count in answer["tallies"]))
    return 1 if any(
        state == "unexplained" for state, _count in answer["tallies"]) else 0


def run_sides(selector=None):
    """List side transcripts grouped under the sessions they hang from,
    newest first. Read-only; the engine classifies.

    The grammar column is the load-bearing one: conversion acts only on the
    two shapes it can prove an inverse for, so this listing is also the
    census of what a promote could and could not touch. A machine-wide
    sweep shows each parent's newest few and counts the rest by grammar,
    because nine hundred interleaved rows are a dump, not a report; naming
    a parent lists it in full.
    """
    answer = RESOLVER.sides_answer(selector)
    if answer["objection"]:
        die(answer["objection"])
    if not answer["named"]:
        plural = "s" if answer["parent_count"] != 1 else ""
        print(fill(f"side transcripts under {answer['parent_count']} session{plural}, "
                   "most recently active first; --sides <session> lists one in full"))
    for parent_record in answer["parents"]:
        parent = parent_record["parent"]
        entries = parent_record["entries"]
        said = ", ".join(
            f"{count} {grammar}" for grammar, count in parent_record["counts"])
        print(f"\n{parent}  ({said})")
        title = bounded_title(parent_record["title"], 90)
        if title:
            print(fill(f"  {title}"))
        for e in entries:
            name = e["name"] or e["task_id"]
            kind = e["agent_type"] or "?"
            print(f"  {name:32} {e['grammar']:15} {kind:16} {ms_str(e['mtime'])}")
            if e["grammar"] == SIDE_CLASS_UNCLASSIFIABLE:
                print(fill(f"    {e['detail']}"))
        if parent_record["hidden"]:
            print(f"  ...and {parent_record['hidden']} more  "
                  f"(--sides {parent[:8]} lists them)")
    if answer["folded_parents"]:
        folded_parents = answer["folded_parents"]
        folded_count = answer["folded_count"]
        print(fill(f"\n...and {folded_parents} older "
                   f"session{'s' if folded_parents != 1 else ''} holding "
                   f"{folded_count} side transcript{'s' if folded_count != 1 else ''}; "
                   "--sides <session> lists any of them"))
    total = answer["total"]
    print(f"\n{total} side transcript{'s' if total != 1 else ''}: " +
          ", ".join(f"{count} {grammar}"
                    for grammar, count in answer["counts"]))
    return 0


def conformance(part, whole):
    """A census row's `part` of `whole`: the ratio, or a quieter form when
    everything counted conforms.

    Most of these rows read n/n, and printing the ratio anyway makes the eye
    compare two numbers on every line to find the one line worth stopping at.
    "all n" leaves the slash to the rows that have something to say. Nothing
    counted keeps the ratio, because "all 0" claims a conformance no member
    demonstrated.
    """
    return f"all {whole}" if whole and part == whole else f"{part}/{whole}"


def run_census():
    """Render Resolver's complete machine-wide evidence census."""
    answer = RESOLVER.census_answer()
    print(f"census of {CLAUDE_DIR}\n")
    identity = answer["identity"]
    print("identity")
    print("  roster members with id name@team       "
          + conformance(identity["member_agrees"], identity["member_total"]))
    print("  rosters with lead team-lead@team       "
          + conformance(identity["lead_agrees"], identity["roster_total"]))
    print("  spawn payloads with id name@team       "
          + conformance(identity["payload_agrees"], identity["payload_total"]))

    leads = answer["leads"]
    print("\nleads")
    print("  rosters naming a lead session          "
          + conformance(leads["named"], leads["roster_total"]))
    print("  ...that is a real transcript           "
          + conformance(leads["resolved"], leads["named"]))
    print("  ...which are the leads resolved from the roster alone; the rest are")
    print("     found through the records of who spawned whom")

    teams = answer["teams"]
    print("\nteams")
    for evidence, count in teams["by_evidence"]:
        print(f"  {evidence:38} {count}")
    print(fill(f"  ...{teams['known']} teams in all, each on one row above, under "
               "the strongest evidence for it; --doctor --all examines this "
               "set, a block per team"))
    maximum = (f" (up to {teams['max_claimants']} each)"
               if teams["contested"] else "")
    print(f"  teams claimed by several transcripts    {teams['contested']}{maximum}")
    print(f"  ...still unresolved after corroboration {teams['unresolved']}")
    print("  ...the rest are decided by the ladder; these are refused, not guessed")

    transcripts = answer["transcripts"]
    print("\ntranscripts")
    print(f"  stamped with a name and a team         {transcripts['both']}")
    print(f"  stamped with a name and no team        {transcripts['name_only']}")
    if transcripts["name_only"]:
        print("  ...either ran team-less or were launched with mismatched team flags")
    return 0


def rosters_leads(rosters):
    """The roster entries that name a lead, for counting."""
    return [(cfg, data, mtime) for cfg, data, mtime in rosters if data.get("leadAgentId")]


def run_cleanup(dry=False):
    """Everything the SessionStart hook does: reap what nothing can use.

    No record is kept of the id a boot is handed: it names the transcript,
    not the team the boot creates.

    The outcome is said first and the per-team reasons after it, because a
    preview that opens with its twenty-ninth "keeping" makes the reader
    scroll to learn that nothing happened. In the hook the whole sweep is
    still silent unless something was actually removed.
    """
    plan = RESOLVER.cleanup_plan()
    if not dry:
        checked = RESOLVER.revalidate_cleanup(plan)
        if not checked["matches"]:
            die("cleanup evidence changed (" + ", ".join(checked["changed"])
                + "); nothing was removed. Run the command again")
    sockets = cleanup_sockets(plan, dry)
    removed, kept, locks = cleanup_teams(plan, dry)
    said = "would remove" if dry else "removed"
    if sockets:
        print(fill(f"{said} {len(sockets)} dead socket(s): {', '.join(sockets)}"))
    if removed:
        print(fill(f"{said} {len(removed)} empty team(s): {', '.join(removed)}"))
    if locks:
        print(fill(f"{said} {len(locks)} roster lock(s) this tool left behind: "
                   f"{', '.join(locks)}"))
    if dry:
        if not (sockets or removed or locks):
            print(f"nothing to clean up: {len(kept)} team(s) kept, no dead sockets")
        for team, why in kept:
            print(fill(f"  keeping {team}: {why}"))
    return 0


HOOK_MARKER = "--cleanup"


def replace_json(path, data, indent=2, raw=False, mode=None,
                 retained=None):
    """Atomically replace one file and return its descriptor observation.

    Complete observation construction and descriptor close before installation.
    The transcript applier can therefore refresh immediately on successful return.
    """
    if retained is not None:
        with retained.path.open("rb") as handle:
            payload = handle.read()
            facts = os.fstat(handle.fileno())
        current = FileObservation(
            retained.path, (facts.st_dev, facts.st_ino, facts.st_size,
                            facts.st_mtime_ns, payload), facts.st_mode & 0o777)
        if current != retained:
            die(f"retained file {retained.path} changed before restoration")
        installed = FileObservation(path, current.generation, current.mode)
        os.replace(retained.path, path)
        return installed
    if mode is None:
        try:
            mode = path.stat().st_mode & 0o777
        except OSError:
            mode = None
    if raw:
        tmp = path.with_suffix(path.suffix + f".tmp-{TOOL}")
        payload = data if isinstance(data, bytes) else data.encode("utf-8")
    else:
        tmp = path.with_suffix(f".json.tmp-{TOOL}")
        payload = (json.dumps(data, indent=indent) + "\n").encode("utf-8")
    descriptor = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        observed = _write_descriptor(descriptor, path, payload, mode)
    finally:
        os.close(descriptor)
    os.replace(tmp, path)
    return observed


def replace_text(path, text, mode=None):
    """Write text where a reader can only ever see a whole file."""
    return replace_json(path, text, raw=True, mode=mode)


def replace_bytes(path, data, mode=None):
    """Write bytes where a reader can only ever see a whole file."""
    return replace_json(path, data, raw=True, mode=mode)


def replace_retained_path(path, retained):
    """Install the retained observed inode through the atomic replacement writer."""
    return replace_json(path, None, retained=retained)


def write_settings(settings, data):
    if settings.exists():
        settings.with_suffix(f".json.bak-{TOOL}").write_text(settings.read_text())
    replace_json(settings, data)


def install_hook(command, dry=False):
    """Add the SessionStart janitor hook, preserving everything else.

    A dry run reads the file and writes neither it nor its backup. The two
    outcomes it can preview are different enough to be worth telling apart:
    adding a hook that is not there, and replacing an older command of ours
    that is.
    """
    settings = CLAUDE_DIR / "settings.json"
    try:
        data = json.loads(settings.read_text()) if settings.exists() else {}
    except ValueError as exc:
        warn(f"{settings} is not valid JSON ({exc}); leaving hooks alone")
        return False
    if not isinstance(data, dict):
        warn(f"{settings} is not a JSON object; leaving hooks alone")
        return False

    entries = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    for entry in entries:
        for hook in entry.get("hooks", []):
            existing = hook.get("command") or ""
            if existing == command:
                print(f"ok        SessionStart cleanup hook already in {settings}")
                return True
            if TOOL in existing or "resume-agent --cleanup" in existing:
                # An older command for this same tool: update in place rather
                # than leave two hooks reaping the same things.
                if not dry:
                    hook["command"] = command
                    write_settings(settings, data)
                step(dry, f"would update the SessionStart hook already in {settings} "
                          f"(now: {existing})",
                     f"rehooked  SessionStart in {settings} (was: {existing})", indent="")
                return True
    if not dry:
        entries.append(
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": command,
                        "async": True,  # a janitor must never delay session start
                        "timeout": 10,
                    }
                ]
            }
        )
        write_settings(settings, data)
    step(dry, f"would add the SessionStart cleanup hook to {settings} ({command})",
         f"hooked    SessionStart in {settings} (backup: settings.json.bak-{TOOL})",
         indent="")
    return True


def drop_stale_compdumps(dry=False):
    """Delete completion caches that predate this install.

    zsh does not rescan fpath when a cached dump exists, and oh-my-zsh only
    refreshes it about daily, so a freshly linked completion silently does
    nothing in new shells. The dump is a cache and regenerates on next start,
    so removing it is cheap; leaving it means the install did not take.
    """
    stale = []
    for dump in sorted(Path.home().glob(".zcompdump*")):
        try:
            if dump.suffix == ".zwc" or TOOL not in dump.read_text(errors="replace"):
                if not dry:
                    dump.unlink()
                stale.append(dump.name)
        except OSError:
            continue
    if stale:
        step(dry, f"would clear stale completion cache: {', '.join(stale)}",
             f"cleared stale completion cache: {', '.join(stale)}")


def run_install(dry=False):
    """Symlink the script into ~/.local/bin and its zsh completion onto fpath.

    Under a dry run every act says what it would do and none of them happen:
    no directory is made, no symlink created, no settings file or backup
    written, no completion cache deleted. What a real run would refuse it
    still refuses out loud, so the preview's exit code is the one the install
    would come back with.
    """
    src = Path(__file__).resolve()
    comp_src = src.parent / f"_{TOOL}"
    failed = False

    def link(target, dest):
        nonlocal failed
        if not dry:
            dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.resolve() == target:
            print(f"ok        {dest} -> {target} (already)")
            return
        if dest.exists() or dest.is_symlink():
            warn(f"skipping {dest}: exists and points elsewhere ({dest.resolve()})")
            failed = True
            return
        rel = os.path.relpath(target, dest.parent)
        if not dry:
            dest.symlink_to(rel)
        step(dry, f"would link {dest} -> {rel}", f"linked    {dest} -> {rel}", indent="")

    link(src, Path.home() / ".local/bin" / TOOL)

    bin_path = Path.home() / ".local/bin" / TOOL
    if not install_hook(f"{bin_path} {HOOK_MARKER} >/dev/null 2>&1", dry):
        failed = True

    if not comp_src.exists():
        warn(f"no completion file at {comp_src}; script link done, completion skipped")
        return 1

    # Prefer a dir already on fpath; oh-my-zsh puts custom/completions there.
    omz = Path(os.environ.get("ZSH") or Path.home() / ".oh-my-zsh")
    if omz.is_dir():
        link(comp_src, omz / "custom/completions" / f"_{TOOL}")
        drop_stale_compdumps(dry)
        step(dry, "completion would be active in new shells",
             "completion active in new shells; reload this one with: exec zsh", indent="")
    else:
        comp_dir = Path.home() / ".zsh/completions"
        link(comp_src, comp_dir / f"_{TOOL}")
        print(f"add to ~/.zshrc before compinit: fpath=({comp_dir} $fpath)")
    return 1 if failed else 0


def run_poison(args):
    """Recipe 1 steps 0 and 2: (un)set ANTHROPIC_BASE_URL on the swarm server.

    While poisoned, every NEW pane's claude dies at TCP connect: $0 billed, no
    5-hour window anchored. Processes already running keep the env they were
    born with, in both directions; env is fixed at exec.

    A dry run names the socket and what it would set or clear, and runs no
    tmux command that changes anything. It still reads the server's current
    value, which changes nothing and is the useful half of the preview: it
    says what the set would replace.
    """
    control = RESOLVER.socket_control_answer(args.socket)
    sock = control["socket"]
    if not sock:
        die("no live swarm socket; pass --socket claude-swarm-<pid>")
    if not control["alive"]:
        die(f"socket {sock} has no live tmux server; poison lives in server env, nothing to set")

    # Both directions in one shape: what to run, what it would do, what it did,
    # and what to say after. Written as two branches they had to grow a dry
    # guard each, and the guard is the part that must not be got wrong twice.
    if args.poison:
        setenv = ("-g", "ANTHROPIC_BASE_URL", POISON_URL)
        would = f"would poison {sock}: new panes would get ANTHROPIC_BASE_URL={POISON_URL}"
        did = f"poisoned {sock}: new panes get ANTHROPIC_BASE_URL={POISON_URL}"
        after = (f"placeholders will sit in an API error; unpoison with: "
                 f"{TOOL} --unpoison --socket {sock}")
    else:
        setenv = ("-gu", "ANTHROPIC_BASE_URL")
        would = f"would unpoison {sock}: new panes would get a working API again"
        did = f"unpoisoned {sock}: new panes get a working API again"
        after = "live placeholders keep their poisoned env; the swap's env scrub handles the pane"
    if not args.dry_run:
        res = tmux(sock, "set-environment", *setenv)
        if res.returncode != 0:
            die(f"set-environment {' '.join(setenv)} failed on {sock}: {res.stderr.strip()}")
    step(args.dry_run, would, did, indent="")
    if not args.dry_run:
        # What the poison does to a pane, which a preview has not done to one.
        print(after)

    cur = tmux(sock, "show-environment", "-g", "ANTHROPIC_BASE_URL")
    state = cur.stdout.strip() if cur.returncode == 0 else "-ANTHROPIC_BASE_URL (unset)"
    print(f"server env {'still' if args.dry_run else 'now'}: {state}")
    return 0


class Outcome(collections.namedtuple(
        "Outcome", "status socket is_lead pending_write started_in",
        defaults=(None,))):
    """What one agent's run produced: how it went, where it landed, and whether
    it was the lead. The role comes from resolution rather than from the entry
    point, so a single resume and a team resume answer it the same way.

    `started_in` is the pane this run created for the agent's new process. It
    is None when the run started no process there: a noop, a refusal, a dry
    run, or a lead with its command handed to the terminal."""


def report_transcript_writes(pending, args, grace=LAUNCH_WRITE_S):
    """Finish the observation a launch left open.

    launch_survived waits a second and a half for a resumed agent to write its
    own transcript, which is the proof it loaded the session rather than merely
    started a process. A large session takes tens of seconds to get there, so
    "no transcript write yet" is the ordinary result and saying only that leaves
    the run reporting a question instead of an answer. The rest of the run has
    already bought some of the wait; this spends what is left.
    """
    if args.dry_run or not pending:
        return
    print()
    deadline = time.monotonic() + grace
    waiting = list(pending)
    while waiting and time.monotonic() < deadline:
        for item in list(waiting):
            label, path, since = item
            try:
                if path.stat().st_mtime > since:
                    print(f"wrote    {label} loaded its session and wrote its transcript")
                    waiting.remove(item)
            except OSError:
                pass
        if waiting:
            time.sleep(0.5)
    for label, path, _since in waiting:
        warn(f"{label} is running but has not written its transcript in {grace:.0f}s; "
             f"it may still be loading, or it may be stuck before it got there")


def run_agents(args, passthrough, table, jobs, socket=None, prefix="", terminal=None):
    """Run each prepared invocation, then finish the run once.

    A single agent is a team of one, and both entry points come through here so
    that stays true. Attaching is decided in one place: it depends on this run
    having left something in a pane, not on which entry point asked. A noop
    counts, since an agent already sitting in its pane is worth showing.

    `jobs` is (label, args) pairs; a None args is a member that was skipped.
    `table` is the process snapshot selected before the first job. After a job
    runs, the next job asks Resolver for a current snapshot that includes the
    processes started earlier in this batch. `socket` pins the whole run to one
    server when the caller already knows it, as a team does; otherwise the first
    agent to reach one decides.
    """
    check_flag_scope(passthrough, sum(1 for _, a in jobs if a is not None))
    seen = [label for label, _a in jobs]
    twice = sorted({label for label in seen if seen.count(label) > 1})
    if twice:
        # Two jobs for one agent is two launches of one conversation. The guards
        # that would catch the second read a process table snapshotted before the
        # first, so they see nothing and it proceeds. Refused here rather than in
        # each job-builder, so no future one can reintroduce it.
        die(f"{', '.join(twice)} appears twice in this run; that would start a "
            f"second process on one transcript")
    results, outcomes = [], []
    refused = None
    for label, sub_args in jobs:
        if label is not None:
            print(f"\n[{label}]")
        if sub_args is None:
            print(f"{prefix}skipped")
            results.append((label, "skipped"))
            continue
        if outcomes and not args.dry_run:
            sub_args.roster_census = None
        try:
            outcome = run_one(
                sub_args, passthrough, table, prefix=prefix,
                pending=[o.pending_write for o in outcomes if o.pending_write],
                terminal=terminal)
        except Refusal as exc:
            # A member's refusal is that member's problem, the way a member's
            # pane is: the rest of the team still comes up, and the summary,
            # the flag check and the write report still reach every agent that
            # did. The refusal itself is kept, not discarded, and the run ends
            # in it below. Discarding it here left main returning an ordinary
            # code, which reads as a verb that did its work, so the end-of-run
            # audit judged it as one and refused a declaration the run never
            # got far enough to exercise.
            refused = refused or exc
            outcome = Outcome("failed", None, False, None)
        # A completed, failed, or refused job may have changed processes before
        # returning. The next member selects from the current process table and
        # then revalidates that selection immediately before its own writes.
        table = None
        results.append((label, outcome.status))
        outcomes.append(outcome)
        socket = socket or outcome.socket
    if len(jobs) > 1:
        print("\nsummary")
        for label, status in results:
            print(f"  {label:<24} {status}")
    report_transcript_writes([o.pending_write for o in outcomes if o.pending_write], args)
    check_flags_took_effect(passthrough, results, args)
    # The run ends by handing over the lead's command, and attaching would
    # bury it. Keyed on that handover rather than on the lead being in the
    # run: a lead that was already up leaves this shell with nothing to look
    # at, so the swarm is the only thing left to offer.
    handover = any(o.is_lead and o.status == "manual" for o in outcomes)
    # Offered only where a server exists to attach to: after a launch one
    # does, and a noop on a dead socket must not promise a keypress that can
    # only end in "nothing to attach to".
    if (not handover and not args.dry_run and socket
            and any(s in ("launched", "noop") for _, s in results)):
        decision = RESOLVER.attach_decision(
            socket, terminal, no_attach=args.no_attach, attach=args.attach,
            tool_driving=bool(os.environ.get("CLAUDECODE")),
            is_tty=sys.stdout.isatty())
        if decision["alive"]:
            print()
            started = tuple(o.started_in for o in outcomes if o.started_in)
            if decision["action"] != "attach" or confirm_attach(started, socket):
                maybe_attach(decision)
    if refused:
        # Last, so everything the run did manage has already been reported.
        # A run that refused ends in its refusal: the exit code is the one the
        # refusal asked for, and the end-of-run audit, which judges what a verb
        # computed against what it declared, has nothing to judge here.
        raise refused
    return 1 if any(s == "failed" for _, s in results) else 0


def rebuild_roster(team, args, passthrough, table, selected=None, census=None):
    """Apply Resolver's complete reconstruction answer for one missing team."""
    plan = RESOLVER.rebuild_plan(
        team=team, table=table, census=census)
    if plan["objections"]:
        die("; ".join(plan["objections"]))
    path = plan["lead_path"]
    if not plan["config"].get("leadSessionId"):
        warn(f"nothing corroborates {path.stem[:8]} as the lead of {team}, so the "
             "rebuilt roster leaves leadSessionId empty. If that is the wrong "
             "conversation, name the right one with --resume")
    print(f"team     {team} has no roster; rebuilding from {path.stem[:8]} "
          f"({plan['lead_claim']['why']})")
    enforce_ctx(plan["launch"], args)
    _launch, config = apply_rebuild_plan(
        plan, args.dry_run, assume_yes=args.yes)
    if not config:
        die(f"could not rebuild a roster for {team}")
    return config


def former_members_note(former):
    """What a default team run is leaving out, or None when it leaves out nothing.

    A bounded sweep says what it dropped. The harness prunes a member from the
    roster when that member finishes, so reviving them all by default would
    restart work that already ended, and dropping them silently would report a
    team smaller than the one on disk as if it were the whole of it.
    """
    if not former:
        return None
    return (f"{len(former)} more belong to this team and are not running; "
            f"pass --all to resume them too")


def team_redirect_request(args):
    """The redirect a team run decides once for every member it starts."""
    to_team = args.to_team
    live = to_team in ("live", "auto")
    return MemberRedirectRequest(
        kind="automatic" if not to_team else "live" if live else "explicit",
        destination=None if not to_team or live else to_team,
        force=args.force, archive_mail=args.with_mail,
        keep_team=bool(args.keep_team) and not to_team)


def apply_team_redirect(plan, args, prefix=""):
    """Carry out a team run's one redirect decision before its first member.

    The run asks its one question here, ends the running members it moves
    (settle_stops) and only then retires the source team, at most once, so no
    member's step decides any of it again. Returns the answer each member's
    step is given (follow, stay, or declined) and the pids it ended.
    """
    selection = plan["redirect"]
    if selection["action"] == "stay":
        return "follow", ()
    if selection["action"] == "blocked":
        if selection["kind"] != "automatic":
            if selection["rebind"] and selection["rebind"]["action"] == "blocked":
                rebind_reap(selection["rebind"], args, prefix)
            die("; ".join(selection["objections"]))
        warn(f"{redirect_subject(selection)} cannot follow their lead onto "
             f"{selection['proposed_destination']}:\n"
             + "\n".join(redirect_blockers(selection)))
        decline_unreachable(selection, args, prefix)
        return "declined", ()
    if not confirm_redirect(selection, prefix):
        return "stay", ()
    ended = settle_stops(selection, args, prefix)
    if ended:
        checked = RESOLVER.revalidate_team_run(plan, cleared=ended)
        if not checked["matches"]:
            die("the team changed while its members were stopped ("
                + ", ".join(checked["changed"]) + "); "
                f"{selection['source']} was not retired and no member was started. "
                "Run the command again")
    rebind = selection["rebind"]
    if rebind and rebind["action"] == "reap":
        rebind_reap(rebind, args, prefix, members=redirect_subject(selection))
    return "follow", ended


def run_team(args, passthrough):
    request = team_redirect_request(args)
    plan = RESOLVER.team_run_plan(
        args.team,
        all_members=getattr(args, "all_members", False),
        requested_socket=args.socket, redirect=request)
    selection = plan["redirect"]
    if not args.dry_run:
        checked = RESOLVER.revalidate_team_run(plan)
        if not checked["matches"]:
            die("the selected team-run generations changed ("
                + ", ".join(checked["changed"])
                + "); nothing was launched or written. Run the command again")
    # Decided once, before any member: where the members go, whether their
    # team is retired, and the run's one question about it.
    answer, ended = apply_team_redirect(plan, args)
    following = answer == "follow" and selection["action"] == "redirect"
    # A team is not rebuilt when its members follow their lead elsewhere: its
    # roster would only make their stamps restore them onto it again.
    if not following and plan["roster_snapshot"].state != "valid":
        config = rebuild_roster(
            args.team, args, passthrough, plan["table"])
        plan = RESOLVER.team_run_plan(
            args.team, plan["table"],
            all_members=getattr(args, "all_members", False),
            requested_socket=args.socket,
            preview_roster=config if args.dry_run else None)
        if not args.dry_run:
            checked = RESOLVER.revalidate_team_run(plan)
            if not checked["matches"]:
                die("the rebuilt team-run generations changed ("
                    + ", ".join(checked["changed"])
                    + "); nothing was launched. Run the command again")
    if not plan["members"]:
        die(f"team {args.team} has no members")
    for warning in plan["warnings"]:
        warn(warning)
    destination = plan["destination"]
    socket = destination.socket if destination else None
    where = (f"socket {socket} ({plan['destination_why']}, "
             f"{plan['destination_state']})" if socket else
             "socket resolved per member")
    print(fill(f"team     {args.team}  ({len(plan['members'])} members, {where})"))
    note = former_members_note(plan["former"])
    if note:
        print(fill(f"         {note}"))
    if not following:
        for inbox in plan["inboxes"]:
            seed_selected_inbox(inbox, dry=args.dry_run)
    jobs = []
    for member in plan["members"]:
        agent_id = member.get("agentId")
        name = member.get("name") or "?"
        if member.get("unrecorded"):
            print(f"  [{name}] unrecorded member, running now, will re-register")
        elif member.get("former"):
            print(f"  [{name}] former member, will re-register")
        if args.no_lead and agent_id == plan["lead_id"]:
            jobs.append((name, None))
            continue
        one = copy.copy(args)
        one.agent_id, one.resume, one.team, one.socket = agent_id, None, None, socket
        one.socket_reason = "team socket" if not args.socket else "--socket"
        one.roster_census = selection["census_after"] if following else plan["census"]
        one.team_selection, one.team_answer = selection, answer
        one.in_team = True
        jobs.append((name, one))
    # Processes the run ended are gone from the table the plan was made with,
    # so the first member is selected from the current one.
    return run_agents(args, passthrough, None if ended else plan["table"], jobs,
                      socket=socket, prefix="  ")


