class NEED(enum.Enum):
    """The corpus-scale computes a run may ask the engine for, by name.

    Declared to the constructor, never passed to a method: a verb states up
    front what it consumes, the engine refuses to compute anything else, and
    the end-of-run audit refuses a declaration a smaller set would have
    satisfied. The default is nothing, so every caller must say what it needs.
    The values are the plain words the refusal prints.
    """
    PROCS = "the process table"
    STAMPS = "transcript identity stamps"
    SPAWNS = "the spawn payload corpus"
    SIDES = "side transcript classification"
    MAIL = "the send-vs-delivery mail join"
    TITLES = "transcript titles"


class DECLARED(enum.Enum):
    """How firmly a verb declared one need. Absence is an answer, not a gap."""
    HARD = "declared"            # always computed; unexercised is a fault
    MAYBE = "declared if used"   # a runtime branch decides; unexercised is fine
    ABSENT = "not declared"      # computing it at all is a fault


class Needs:
    """What one verb may compute, and how firmly it said so.

    A declaration is two buckets rather than a bag of mixed elements, so an
    author writing one has to place every need in exactly one of them. The
    conditional bucket is for a runtime branch (liveness, corpus content)
    deciding, never for an author who has not worked out what the input
    implies; each entry carries a comment naming what decides it.

    Asking is one operation, needs[X], which distinguishes all three states.
    A wrapper object could not: it carried no equality, so membership tests
    answered no both for a conditional declaration and for none at all, and
    a check written that way passed with its subject deleted.
    """

    def __init__(self, hard=(), maybe=()):
        self._hard = frozenset(hard)
        self._maybe = frozenset(maybe) - self._hard   # hard wins; nothing is both

    def __getitem__(self, need):
        if need in self._hard:
            return DECLARED.HARD
        if need in self._maybe:
            return DECLARED.MAYBE
        return DECLARED.ABSENT

    @property
    def hard(self):
        """The needs whose absence from a run is a fat declaration."""
        return self._hard

    @property
    def reachable(self):
        """Every need this run may compute, however firmly declared."""
        return self._hard | self._maybe

    def __eq__(self, other):
        return (isinstance(other, Needs)
                and (self._hard, self._maybe) == (other._hard, other._maybe))

    def __hash__(self):
        return hash((self._hard, self._maybe))

    def __repr__(self):
        return (f"Needs(hard={sorted(n.name for n in self._hard)}, "
                f"maybe={sorted(n.name for n in self._maybe)})")


class Resolver:
    """Everything a resolution reads, loaded once per run and held together.

    One field per source, filled on first use by the loader that owns it. The
    point of collecting them is that the set becomes enumerable: an answer
    derived from anything not in here is reaching past the evidence, and that is
    visible rather than a matter of noticing.

    A run is one process, so these were already per-run state as module
    globals. What the object adds is a place for cache lifetime to be stated
    (`refresh_procs`) instead of implied by a keyword argument.

    It answers and never acts. No tmux, no exec, no roster writes, no forge:
    those consume answers, and keeping them out is what stops this becoming the
    one class that does everything.

    Which leaves the writers needing values. They take a description from here
    rather than the assembled identity: `roster_record` says what belongs in a
    roster entry and where it goes, and the writers write it. The engine
    describes, the writer writes.

    `needs` declares, at construction and nowhere else, which corpus-scale
    computes this engine may perform (see NEED); the loaders refuse the rest,
    and audit_needs() at the end of a run refuses hard declarations that were
    never exercised. Compute is never toggled per call: a method either may
    ask its loader or the whole run may not.
    """

    def __init__(self, needs=None):
        self.needs = needs if needs is not None else Needs()
        self.exercised = set()
        self._procs = None       # pid -> row, from ps
        self._stamps = None      # transcript stem -> (agentName, teamName)
        self._carried = None     # transcript path -> the receipt it carries
        self._spawns = {}        # transcript stem -> {name: last payload of that name}
        self._spawn_log = {}     # transcript stem -> [(stamp, payload)] in file order
        self._by_agent = None    # "name@team" -> payload, across every transcript
        self._by_team = None     # team -> [(stamp, path)] of transcripts that led it
        self.teams_dir = TEAMS_DIR   # overridable so a test engine can read a synthetic tree
        self.projects_dir = PROJECTS_DIR  # same, for the transcript tree

    def _exercise(self, need):
        """Record one declared compute happening, or refuse an undeclared one."""
        if self.needs[need] is DECLARED.ABSENT:
            raise RuntimeError(
                f"this run declared no need for {need.value}; the engine "
                f"computes only what its constructor was told, so declare "
                f"NEED.{need.name} where the verb states its needs, in the "
                f"maybe bucket if only some runs of that verb reach it")
        self.exercised.add(need)

    def audit_needs(self):
        """Refuse a declaration a smaller set would have satisfied.

        The destructor's contract, spelled where Python can enforce it: a
        raise from __del__ is swallowed, so the run calls this when its verb
        completes. Conditional declarations are the escape for branchy paths
        and pass silently when unexercised.
        """
        fat = self.needs.hard - self.exercised
        if fat:
            raise RuntimeError(
                "declared and never computed: "
                + ", ".join(sorted(n.name for n in fat))
                + "; a smaller declaration would have served this run, so "
                  "drop it or move it to the maybe bucket if some runs of "
                  "this verb genuinely use it")

    def refresh_procs(self):
        self._procs = None
    def _grep_files(self, needle, scope, recursive):
        """Files containing this literal."""
        result = subprocess.run(self._searcher("files", needle, scope, recursive), capture_output=True, text=True)
        if result.returncode > 1:
            warn(f"search failed ({result.stderr.strip() or 'unknown'}); falling back to a full scan")
            return None
        return [Path(p) for p in result.stdout.splitlines() if p]

    def _searcher(self, kind, needle, paths, recursive):
        """argv for a literal search, preferring ripgrep when installed.

        Same question either way; rg walks the tree in parallel, which is several
        times faster on a transcript tree this size.
        """
        files = [str(p) for p in paths]
        # subagents/ holds sidechain transcripts, which are never evidence
        # candidates, so a recursive sweep does not descend into them.
        if shutil.which("rg"):
            argv = ["rg", "--no-ignore", "-F", needle]
            argv += ["-l"] if kind == "files" else ["-N", "-H"]
            if recursive:
                argv += ["--glob", "*.jsonl", "--glob", "!**/subagents/**"]
            return argv + files
        argv = ["grep", "-F", needle, "-l" if kind == "files" else "-H"]
        if recursive:
            argv += ["-r", "--include=*.jsonl", "--exclude-dir=subagents"]
        return argv + files

    def _stamped_candidates(self, name, team=None, verify=True):
        """Transcripts whose own lines carry these stamps, newest first.

        Narrow, then confirm. The stamp index narrows (one bounded read per file,
        shared across every lookup in the process); the survivors are parsed to
        check the stamps are *current*, since a rebound agent's file mentions two
        teams. `verify=False` returns the narrowing alone, for callers that need a
        path and nothing else.

        The index reads only each file's ends, so it cannot see stamps that appear
        solely mid-history. When it finds nothing, grep re-asks over whole files
        before the answer is allowed to be "no transcript".
        """
        self._exercise(NEED.STAMPS)  # the grep fallback is stamps work too
        files = [p for p, (n, t) in self.stamp_index().items() if n == name and (not team or t == team)]

        if not verify:
            # The index is cached for the process, so a file may be gone by now.
            stamped = []
            for path in files:
                try:
                    stamped.append((path, {}, int(path.stat().st_mtime * 1000)))
                except OSError:
                    continue
            stamped.sort(key=lambda item: item[2], reverse=True)
            return stamped


        def confirm(paths):
            out = []
            for path in paths:
                fields, last_ts = self._scan_transcript(path)
                if fields.get("agentName", (None,))[0] != name:
                    continue
                if team and fields.get("teamName", (None,))[0] != team:
                    continue
                out.append((path, fields, last_ts))
            out.sort(key=lambda item: item[2], reverse=True)
            return out

        found = confirm(files)
        if not found:
            # The index can both miss (stamps only mid-history) and mislead (a stamp
            # quoted inside message content). Either way the answer is not yet "no",
            # so re-ask over whole files before saying so.
            deep = self._grep_files(f'"agentName":"{name}"', [self.projects_dir], True)
            if deep is None:  # grep unavailable
                deep = sorted(self.projects_dir.glob("*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
            elif team and deep:
                deep = self._grep_files(f'"teamName":"{team}"', deep, False) or []
            seen = set(files)
            found = confirm(p for p in deep if p not in seen)
        return found

    def _ingest_spawn_lines(self, paths):
        """Parse the spawn payloads out of these transcripts into the caches.

        grep pulls out the handful of matching lines; only those are parsed. A
        payload is taken from the parsed structure, never from raw bytes, so a
        transcript that merely discusses spawning cannot contribute a quoted
        example as if it were real.
        """
        self._exercise(NEED.SPAWNS)
        paths = [p for p in paths if p and p.stem not in self._spawns]
        for path in paths:
            self._spawns[path.stem], self._spawn_log[path.stem] = {}, []
        if not paths:
            return
        result = subprocess.run(self._searcher("lines", SPAWN_MARKER, paths, False), capture_output=True, text=True)
        if result.returncode > 1:
            warn(f"search failed reading spawn records ({result.stderr.strip() or 'unknown'})")
            return
        for line in result.stdout.splitlines():
            where, _, text = line.partition(":")
            stem = Path(where).stem
            if stem not in self._spawns:
                continue
            try:
                record = json.loads(text)
            except ValueError:
                continue
            # A sidechain line is a subagent's record, not this conversation's evidence.
            if record.get("isSidechain"):
                continue
            stamp = iso_ms(record.get("timestamp"))
            for payload in self._walk_spawn_payloads(record):
                self._spawns[stem][payload["name"]] = payload  # last spawn of a name wins
                self._spawn_log[stem].append((stamp, payload))

    def lead_pid(self, parent_session=None, team=None):
        """(pid, alive, how, exact) for the live process this agent's lead runs as.

        The roster names that lead in one of two shapes, and they answer differently.
        A team minted on a fresh boot carries that boot's id, which is also the
        lead's transcript and is in the session registry, so the exact join below
        answers it. A team minted by a lead that had already been resumed carries an
        internal id from that later life, which has no transcript and no registry
        entry, and only the payload evidence reaches it. Do not assume either shape.
        Socket resolution and credential inheritance both need this exact answer, so
        they ask here rather than each handling half the cases.
        """
        if parent_session:
            entry = self.lead_pid_for(parent_session)
            if entry:
                pid, _, alive = entry
                return pid, alive, f"lead pid {pid}" + ("" if alive else " (dead)"), True
        if team:
            # A fresh lead's internal id IS its transcript id, so its implicit team
            # is named after a session the registry knows: an exact join, preferred
            # over the time window below. (16 of 37 team dirs here are that shape.)
            block = re.fullmatch(r"session-([0-9a-f]{8})", team)
            if block:
                for data in self.session_registry():
                    if str(data.get("sessionId", "")).startswith(block.group(1)):
                        if self.pid_alive(data["pid"], data.get("procStart")):
                            # The registry records the id a life resumed from,
                            # not the identity restore gave it: a transcript
                            # whose window-start restores to another team makes
                            # this pid that team's lead, not this one's.
                            joined = self.transcript_path(str(data.get("sessionId", "")))
                            if joined:
                                rteam, state = self.restored_identity(joined)
                                if state == "restored" and rteam != team:
                                    continue
                            return data["pid"], True, f"pid {data['pid']}, whose session id names team {team}", True
            # A masqueraded lead writes no sessions/<pid>.json at all (the registry
            # is for unbound launches), so every rung above it is blind to one.
            # It does advertise its identity in argv, which is exact evidence.
            masquerade = next((e for e in self.live_sessions()
                               if e["alive"] and e["agent"] == f"team-lead@{team}"), None)
            if masquerade:
                return masquerade["pid"], True, f"pid {masquerade['pid']}, masquerading as {masquerade['agent']}", True

            pid = self._pid_running_team(team)
            if pid:
                return pid, True, f"pid {pid}, which spawned into team {team}", True
            pid = self._pid_that_minted(team)
            if pid:
                # The pairing says why this pid was picked, and nothing more. What
                # a process runs as comes from its window-start stamps and its
                # argv, which team_minted_by reads and the "runs as" line prints;
                # a boot time inside a team's window is only the reason this pid
                # was the candidate. Naming a team here put a claim on the line
                # above the one that answers it, and the two disagreed on screen.
                return pid, True, f"pid {pid}, whose boot pairs with this team's creation", False
        return None, False, None, False

    def lead_pid_for(self, session_id):
        """(pid, updatedAt, alive) for whoever holds this transcript."""
        best = None
        for entry in self.live_sessions():
            if entry["session"] != session_id:
                continue
            rank = (1 if entry["alive"] else 0, entry["updated"])
            if best is None or rank > best[0]:
                best = (rank, (entry["pid"], entry["updated"], entry["alive"]))
        return best[1] if best else None

    def lead_transcript_for(self, team):
        """(transcript, why) for the transcript that led this team, or (None, reason).

        Several transcripts can claim one team: a fork carries the history it was
        copied from, and a payload quoted verbatim into a conversation parses like
        one the harness wrote. Ranked corroboration decides between them, all of it
        already loaded: a live process running as this team, a roster naming the
        transcript as its lead, the payload names matching the roster's members, and
        the team-name block, which an implicit team takes from the session that
        minted it.

        Exactly one corroborated claimant is the answer. A sole claimant with no
        corroboration is still taken, because the ordinary dead-team case is exactly
        that and refusing would strand every legitimately orphaned lead; it says so
        in its provenance instead. Anything else refuses and names what it refused
        between: choosing without evidence buys a resumed stranger's conversation
        wearing this team's lead identity.
        """
        hits = self.led_teams().get(team) or []
        if not hits:
            return None, f"no transcript records spawning into {team}"

        # A roster with no leadSessionId is one that was forged without knowing who
        # led: either uncorroborated by us, or written before a lead was identified.
        # It cannot corroborate a claim about the lead, and skipping it is what stops
        # a roster derived from these payloads from vouching for them. The empty
        # field is the marker, in the harness's own vocabulary rather than ours.
        rosters = [e for e in self.roster_entries(team=team) if e.get("leadSessionId")]
        roster_members = {e["member"].get("name") for e in rosters}
        roster_leads = {e.get("leadSessionId") for e in rosters}
        live_here = {e.get("session") for e in self.live_sessions() if e.get("team") == team}
        block = re.fullmatch(r"session-([0-9a-f]{8})", team)

        def corroboration(path):
            if path.stem in live_here:
                return f"live process running as {team}"
            if path.stem in roster_leads:
                return "roster leadSessionId"
            spawned = {payload.get("name") for payload in self.members_spawned_into(path.stem, team)}
            if roster_members and spawned & roster_members:
                return "member names"
            # Members this claimant spawned that are running as this team now. A
            # process wearing an identity is the strongest evidence the tool has
            # anywhere, and a claimant whose children are alive under the team is
            # a lead of it in the only sense that acts on anything. Fork siblings
            # share their children, so this separates claimants with different
            # payloads and never breaks a tie between copies of one history.
            if spawned and any(self.wearers(f"{name}@{team}") for name in spawned):
                return "live members it spawned"
            if block and path.stem.startswith(block.group(1)):
                return "team-name block"
            return None

        backed = [(path, why) for _, path in hits if (why := corroboration(path))]
        if len(backed) == 1:
            return backed[0][0], f"spawn payloads naming {team}, corroborated by {backed[0][1]}"
        if len(hits) == 1:
            warn(f"resuming the only transcript claiming {team}; nothing corroborates it. "
                 f"If that is the wrong conversation, name the right one with --resume")
            return hits[0][1], f"sole payload claimant for {team}, uncorroborated"
        listed = ", ".join(path.stem[:8] for _, path in hits)
        if len(backed) > 1:
            return None, (f"{len(backed)} transcripts claim {team} with corroboration "
                          f"({listed}); name one with --resume")
        return None, (f"{len(hits)} transcripts claim {team} and nothing corroborates any of them "
                      f"({listed}); name one with --resume")


    def led_teams(self):
        """{team: [(last spawn ts, transcript path), ...]} for every team a lead ran as.

        A lead's own lines carry no stamps, so nothing in its transcript says who it
        is. What it does carry is a spawn payload for each teammate it created, and
        every payload names the team the lead was running as at the time. That makes
        the payload the only identity a lead leaves on disk.

        The roster sometimes stands in for it, and this rung is for when it cannot.
        A team minted on a fresh boot is named after its lead's transcript and
        records it, so that lead resolves at the roster rung. A lead already
        resumed when it minted the team breaks that: the team carries the internal
        session id of that later life, which has no file, and then nothing a user
        can type reaches the lead.

        Assume neither shape. A corpus cannot settle it: rosters are written by
        this tool, by hand-forged recipes, and by the harness alike, so counting
        them measures what has been done to a machine as much as what the harness
        does.

        Built from the scan self._spawn_by_agent() already performs: containing a spawn
        payload is what makes a transcript a lead's, so the same files answer both.
        """
        self._exercise(NEED.SPAWNS)
        if self._by_team is not None:
            return self._by_team
        self._by_team = {}
        leads = self._grep_files(SPAWN_MARKER, [self.projects_dir], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            newest = {}
            for stamp, payload in self._log(path.stem):
                team = payload.get("team_name")
                if team:
                    newest[team] = max(newest.get(team, 0), stamp or 0)
            for team, stamp in newest.items():
                self._by_team.setdefault(team, []).append((stamp, path))
        for team in self._by_team:
            self._by_team[team].sort(reverse=True)
        return self._by_team

    def live_agent_procs(self, agent_id, table):
        return self._claude_procs(f"--agent-id {agent_id}", table)

    def holders_of(self, session_uuid, table):
        """[(pid, transcript path or None)] for whoever holds this transcript.

        The transcript-shaped counterpart of wearer_transcripts: --stop can be
        pointed at a session rather than an agent, and that still must not make a
        caller resolve a path for itself.
        """
        path = self.transcript_path(session_uuid) if session_uuid else None
        strangers, _ours = self.transcript_holders(session_uuid, table)
        return [(pid, path) for pid, _ in strangers]

    def wearer_transcripts(self, agent_id, table=None):
        """[(pid, transcript path or None)] for every live process wearing this id.

        wearers() gives the session id from argv; this resolves it to a file, so
        a caller wanting to say what a process is working on never has to pick a
        transcript for itself.
        """
        return [(pid, self.transcript_path(held) if held else None)
                for pid, held in self.wearers(agent_id, table)]

    def wearers(self, agent_id, table=None):
        """(pid, transcript) for every live process wearing this agent-id.

        A running process is the agent now. Identity is frozen in argv at exec and
        a migration is kill-and-restart, so argv cannot be stale the way a roster
        entry or a transcript stamp can: those record what was true when written.
        The transcript is the process's own --resume value. A wearer without one
        carries no transcript evidence and is reported with None rather than
        dropped, so a caller can still see it is there.
        """
        out = []
        for pid, args in self.live_agent_procs(agent_id, table or self.ps_table()):
            held = next((pair.partition(" ")[2] for pair in self._argv_pairs(args)
                         if pair.startswith("--resume ")), None)
            out.append((pid, held))
        return out

    def live_sessions(self):
        """Every claude process and what it is: {pid, session, agent, team, ...}.

        Two inputs, one answer. sessions/<pid>.json covers unbound launches and
        remembers dead ones; a flag-bound launch (every teammate, and the lead
        masquerade) never writes there but carries the same facts in its argv:
        --resume names the transcript it holds, --agent-id the identity it wears.
        Callers ask this, never an input, or the answer depends on which input the
        caller happened to think of.
        """
        found = {}
        for data in self.session_registry():
            pid = data.get("pid")
            if not pid:
                continue
            found[pid] = {
                "pid": pid,
                "session": data.get("sessionId"),
                "agent": None,
                "team": None,
                "updated": data.get("updatedAt") or 0,
                "started": data.get("startedAt") or 0,
                "alive": self.pid_alive(pid, data.get("procStart")),
            }
        for pid, _, args in self.ps_table():
            if not self.is_claude(args):
                continue
            pairs = self._argv_pairs(args)
            held = next((v.split(" ", 1)[1] for v in pairs if v.startswith("--resume ")), None)
            agent = next((v.split(" ", 1)[1] for v in pairs if v.startswith("--agent-id ")), None)
            if not (held or agent):
                continue
            entry = found.setdefault(pid, {"pid": pid, "session": None, "agent": None,
                                           "team": None, "updated": 0, "started": 0, "alive": True})
            if not entry["alive"] and held:
                # The registry entry failed its procStart check, so this pid was
                # recycled: what argv says outranks what the registry remembers.
                entry["session"] = held
            entry["alive"] = True
            entry["session"] = entry["session"] or held
            if agent:
                entry["agent"] = agent
                entry["team"] = agent.split("@", 1)[1] if "@" in agent else None
        return list(found.values())

    def _log(self, stem):
        """This transcript's spawn entries, filled on demand.

        Reading the log unfilled returns an empty list, which is what a transcript
        that spawned nobody also returns, so a missed fill is a false negative
        shaped like an answer. Filling happens here, where the read happens.
        """
        self._spawn_records(stem)
        return self._spawn_log.get(stem) or []

    def _every_log(self):
        """{transcript stem: entries} for the whole tree, filled on demand."""
        self.led_teams()
        return dict(self._spawn_log)

    def roster_record(self, ctx, team=None):
        """Everything a roster writer needs: the entry, and where it is written.

        Writers take this rather than the assembled identity. The entry travels
        with its team because name, team and agentId are one fact in three
        spellings, and the triple is projected here and nowhere else.

        `team` names a destination: a rebind asks for the entry as it should be
        written in the team it is moving to, and the id is reprojected onto it.

        The keys are the roster's own names, not the engine's, so a writer copies
        them across without translating.
        """
        name = self.field(ctx, "agentName")
        team = team or self.field(ctx, "teamName")
        return {
            "name": name,
            "team": team,
            "agentId": (f"{name}@{team}" if name and team else self.field(ctx, "agentId") or ""),
            "parentSession": self.field(ctx, "parentSessionId") or "",
            "agentType": self.field(ctx, "agentType"),
            "planModeRequired": self.field(ctx, "permissionMode") == "plan",
            "cwd": self.agent_cwd(ctx),
            "color": self.field(ctx, "color"),
            "model": self.field(ctx, "model", prefer_specific=True),
        }

    def spawn_payloads(self):
        """Every spawn payload on this machine."""
        return [payload for entries in self._every_log().values() for _stamp, payload in entries]

    def members_spawned_into(self, lead_session, team):
        """The payloads for every teammate this lead spawned into this team.

        A team-membership question, like team_minted_by's, not the per-agent payload
        lookup spawn_payload owns: it asks who a roster should list, not what one
        known agent was created with. A lead resumed several times spawns into a
        fresh implicit team each life while appending to one transcript, so payloads
        naming another team are skipped rather than adopted.
        """
        latest = {}
        for _stamp, payload in self._log(lead_session):
            if payload.get("name") and payload.get("team_name") == team:
                latest[payload["name"]] = payload  # last spawn of that name into this team
        return list(latest.values())

    def name_rosters(self, name):
        """Teams whose roster carries this agent name. A name in more than one is
        not an identity: every team has a "team-lead"."""
        return {e["team"] for e in self.scan_teams() if e["member"].get("name") == name}

    def _pid_running_team(self, team):
        """The live process whose transcript records spawning into this team.

        Exact evidence for the case the registry cannot answer: an abandoned team
        whose leadSessionId is an internal id no file maps to a pid. The lead that
        spawned into it wrote that team name into each spawn payload.
        """
        if not team:
            return None
        matches = []
        for entry in self.live_sessions():
            if not (entry["alive"] and entry["session"]):
                continue
            # Any life's payload will do here: it is the same process either way.
            if any(item.get("team_name") == team for _, item in self._log(entry["session"])):
                matches.append((entry["updated"], entry["pid"]))
        return max(matches)[1] if matches else None

    def _pid_that_minted(self, team):
        """Which live process is running as this implicit team.

        The roster's leadSessionId is that boot uuid, so it matches no registry
        entry; without this, every agent of a resumed lead's team has an
        unresolvable socket.
        """
        return next((pid for name, pid, _ in self._boot_join() if name == team), None)

    def procs_on_transcript(self, session_uuid, table):
        """Whoever holds this transcript, under any identity. Two processes
        appending to one JSONL is the thing to never allow, and a rebind changes the
        agent-id, so identity is the wrong key here."""
        return self._claude_procs(f"--resume {session_uuid}", table)

    def _proc_stat(self, pid):
        """(state, starttime) from /proc/pid/stat, fields 3 and 22.

        The rawest read of the process realm, so it stays private: what a
        state letter means is pid_alive's and state_note's to say, and a
        caller left to interpret one for itself would be the second opinion
        this whole fence is against.
        """
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return None, None
        try:
            rest = stat[stat.rindex(")") + 2:].split()
            return rest[0], rest[19]
        except (ValueError, IndexError):
            return None, None

    def pid_alive(self, pid, procstart=None):
        """Is this process still running, and still the one that was meant?

        A zombie is not alive. A ctrl-z'd process is: it still owns its
        session and will pick up where it left off; callers nudge instead of
        stepping on it. `procstart` is what stops a recycled pid number from
        answering yes for a stranger.
        """
        state, st = self._proc_stat(pid)
        if st is None or state in ("Z", "X"):
            return False
        return procstart in (None, "", st)

    def state_note(self, pid):
        """Suffix for a pid we are reporting as alive, when it needs a nudge."""
        state = self._proc_stat(pid)[0]
        if state in ("T", "t"):
            return f", suspended; `kill -CONT {pid}` (or fg) to wake it"
        return ""

    def proc_env(self, pid, names):
        """The values this process was given for these environment variables.

        Env is fixed at exec, so this is what the process is actually running
        with rather than what anyone since has set. Nothing outside can read
        it and stay honest: /proc/<pid>/environ is the only source.
        """
        try:
            raw = Path(f"/proc/{pid}/environ").read_bytes()
        except OSError:
            return {}
        found = {}
        for item in raw.split(b"\0"):
            if b"=" not in item:
                continue
            key, value = item.split(b"=", 1)
            key = key.decode("utf-8", "replace")
            if key in names:
                found[key] = value.decode("utf-8", "replace")
        return found

    def _cmdline(self, pid):
        """One process's argv as a string, for a pid the process table did not
        carry. Private: the table is how everything else asks."""
        try:
            return Path(f"/proc/{pid}/cmdline").read_bytes().replace(
                b"\0", b" ").decode(errors="replace").strip()
        except OSError:
            return ""

    def ps_table(self, refresh=False):
        """[(pid, ppid, args)] for every process we can see, snapshotted once.

        One run judges liveness against one consistent picture, and a single
        resolve was spawning ps three times.
        """
        self._exercise(NEED.PROCS)
        if self._procs is not None and not refresh:
            return self._procs
        out = subprocess.run(
            ["ps", "-eo", "pid=,ppid=,args="], capture_output=True, text=True
        ).stdout
        rows = []
        for line in out.splitlines():
            parts = line.strip().split(None, 2)
            if len(parts) == 3 and parts[0].isdigit():
                rows.append((int(parts[0]), int(parts[1]), parts[2]))
        self._procs = rows
        return rows

    def known_teams(self):
        """{team: what proves it exists}, over every source that can prove one.

        A graceful lead exit removes the roster directory, which forge_team's own
        docstring calls the ordinary case, so a directory listing describes the
        teams that happen to be tidy rather than the teams that exist. The
        payloads and the stamps outlive the directory.

        Enumeration and the single-token question are the same answer, so one is
        implemented on the other: a team the selector will accept and rebuild
        cannot then be missing from the list of teams.
        """
        found = {}
        for _name, stamped in self.stamp_index().values():
            if stamped:
                found[stamped] = "a transcript stamped with it"
        for team in self.led_teams():
            found[team] = "spawn payloads naming it"
        for directory in self.team_dirs():
            # Only a directory holding a roster counts. One holding just inboxes
            # is scaffolding: it proves nothing about a team ever having existed,
            # and offering it as rebuildable said "rebuildable from an empty team
            # directory", which promises something nothing can deliver.
            if self.roster_path(directory.name).exists():
                found[directory.name] = "a roster on disk"
        return found

    def team_evidence(self, token):
        """Why this token is a team, or None."""
        return self.known_teams().get(token)

    def lead_session_for(self, team):
        """The session id of this team's lead, or None.

        A roster read, a payload lookup, and a glob over transcripts sharing
        the team name's block disagree exactly when it matters, so they are
        one ladder here, strongest first: what a roster records, what the payloads prove, and only then the
        block, which is a guess about a name rather than evidence about a session.
        """
        for entry in self.scan_teams():
            if entry["team"] == team and entry.get("leadSessionId"):
                if self.transcript_path(entry["leadSessionId"]):
                    return entry["leadSessionId"]
        path, _why = self.lead_transcript_for(team)
        if path:
            return path.stem
        block = re.fullmatch(r"session-([0-9a-f]{8})", team or "")
        if not block:
            return None
        hits = sorted(self.transcripts_starting(block.group(1)),
                      key=lambda p: p.stat().st_mtime, reverse=True)
        if len(hits) > 1:
            warn(f"{len(hits)} transcripts start with {block.group(1)}; assuming {hits[0].stem}")
        return hits[0].stem if hits else None

    def roster_path(self, team):
        """Where this team's roster lives. A path question, not a write: the class
        answers where things are so writers never have to know the layout."""
        return self.teams_dir / team / "config.json"

    def has_roster(self, team):
        """Is there a roster on disk for this team?

        The cheapest question about the team-config realm, and the one most
        callers actually have: a die() that wants to name a missing team, a
        membership write that has nowhere to land, a completion listing that
        should not offer a team twice. One stat, and no parse: whether the
        file reads as a roster is scaffolding_objection's question.
        """
        return bool(team) and self.roster_path(team).exists()

    def inbox_path(self, team, name):
        """Where this member's mailbox lives."""
        return self.teams_dir / team / "inboxes" / f"{name}.json"

    def inbox_seeded(self, team, name):
        """Does this member already have a mailbox file with something in it?

        Zero bytes is the state that matters: an empty file is a parse error
        that wedges both reader and writer, so it counts as no mailbox at all
        and the seeder writes `[]` over it.
        """
        try:
            path = self.inbox_path(team, name)
            return path.exists() and path.stat().st_size > 0
        except OSError:
            return False

    def inbox_state(self, team):
        """{name: (undelivered count, oldest timestamp)} for this team's mailboxes.

        Mail nobody has read is the symptom a severed team shows first, and it
        is on disk whether or not anything is running. An unparseable inbox
        answers (None, why) rather than vanishing: a torn file holding six
        real messages must not read as no mail waiting.
        """
        state = {}
        try:
            boxes = sorted((self.teams_dir / team / "inboxes").iterdir())
        except OSError:
            return state
        for box in boxes:
            if box.suffix != ".json" or not box.is_file():
                continue
            try:
                mail = json.loads(box.read_text() or "[]")
            except OSError:
                continue
            except ValueError:
                state[box.stem] = (None, "unreadable, possibly torn mid-write")
                continue
            if not isinstance(mail, list):
                state[box.stem] = (None, f"not a mailbox shape ({type(mail).__name__})")
                continue
            stamps = sorted(m.get("timestamp") or "" for m in mail if isinstance(m, dict))
            state[box.stem] = (len(mail), stamps[0] if stamps else None)
        return state

    def team_dirs(self):
        """Every team directory on disk, roster or not."""
        return [d for d in self.teams_dir.glob("*") if d.is_dir()]

    def made_moments_ago(self, team_dir):
        """Was this directory made too recently for its emptiness to mean anything?

        A team dir is created before the things that prove its session is
        alive: the registry entry, the first spawn payload, the masquerade's
        argv. Inside that window an empty team is a team being born, not a
        dead one.
        """
        try:
            return time.time() - team_dir.stat().st_mtime < TEAM_GRACE_S
        except OSError:
            return False

    def scaffolding_objection(self, team_dir):
        """What in this directory is NOT pure scaffolding, or None if nothing is.

        Both halves of what a team dir holds, answered together because the
        reaper needs one verdict: the roster arm (is there a config.json, and
        does it read as a roster) and the mailbox arm (is every inbox a real
        mailbox, and is every mailbox empty). Every entry must be something
        this tool or the harness is known to create, and known to be
        contentless. Anything unrecognised, anything nested, any symlink, and
        any inbox holding mail means the directory is spared.
        """
        known = {
            "config.json",
            "inboxes",
            f"config.json.bak-{TOOL}",
            f"config.json.tmp-{TOOL}",
            "config.json.lock",
        }
        try:
            entries = list(team_dir.iterdir())
        except OSError as exc:
            return f"unreadable ({exc})"

        for item in entries:
            if item.is_symlink():
                return f"{item.name} is a symlink"
            if item.name not in known:
                return f"unexpected entry {item.name!r}"
            if item.name != "inboxes":
                if not item.is_file():
                    return f"{item.name} is not a regular file"
                continue

            if not item.is_dir():
                return "inboxes is not a directory"
            for inbox in item.iterdir():
                if inbox.is_symlink():
                    return f"inboxes/{inbox.name} is a symlink"
                if not inbox.is_file():
                    return f"inboxes/{inbox.name} is not a regular file"
                if inbox.suffix != ".json":
                    return f"inboxes/{inbox.name} is not a .json file"
                try:
                    mail = json.loads(inbox.read_text() or "[]")
                except (OSError, ValueError) as exc:
                    return f"inboxes/{inbox.name} is unreadable or not JSON ({exc})"
                if not isinstance(mail, list):
                    return f"inboxes/{inbox.name} is not a message array"
                if mail:
                    return f"inboxes/{inbox.name} holds {len(mail)} undelivered message(s)"
            # This loop reads the files rather than reusing inbox_state's counts.
            # A deletion gate re-proves the structure itself: a count is not proof
            # that what it counted is a mailbox.

        config = team_dir / "config.json"
        if not config.is_file():
            return "no config.json"
        try:
            data = json.loads(config.read_text())
        except (OSError, ValueError) as exc:
            return f"config.json unreadable ({exc})"
        if not isinstance(data, dict) or not isinstance(data.get("members", []), list):
            return "config.json is not a roster"
        return None

    def transcripts_by_mtime(self):
        """Every transcript, newest first."""
        return sorted(self.projects_dir.glob("*/*.jsonl"),
                      key=lambda path: path.stat().st_mtime, reverse=True)

    def transcripts_starting(self, block):
        """Transcripts whose uuid opens with this block. A path question, so it
        belongs to whoever owns the tree rather than to a caller globbing it."""
        return list(self.projects_dir.glob(f"*/{block}-*.jsonl"))

    def resolve_transcript(self, session_uuid=None, lead_session=None, team=None, name=None,
                           is_lead=False, quick=False):
        """The only place a transcript is chosen. Evidence, strongest first:

        1. an exact session uuid, given by the user
        2. a live process wearing this agent id, whose --resume value says what it
           is working on now
        3. the roster's leadSessionId
        4. both stamps: agentName AND teamName written on the transcript's lines
        5. agentName alone, refused when that name is in more than one roster
        6. for a lead only: the transcript whose spawn payloads name this team

        Rungs are named rather than numbered below: prose that counts them stops
        being true the moment one is inserted.

        A lead writes no stamps, so neither stamp rung can reach one. The
        leadSessionId rung reaches it whenever that id is a real transcript, which
        is the case for a masqueraded lead and for a team minted on a fresh boot,
        since a first life's internal id is its transcript id. A lead that had
        already been resumed when it minted the team is the shape that rung cannot
        reach: the id belongs to that later life and has no file. The spawn-payload
        rung covers those: see self.led_teams(). Do not assume either shape.

        The bare-name rung is why "team-lead" can never be resolved by name: it
        lives in every team, so the name carries no identity and the engine returns
        nothing rather than adopting a stranger's conversation.

        The live-process rung outranks the roster and the stamps because argv is
        frozen at exec and a migration is kill-and-restart: those record what was
        true when written, argv records what is true.
        """
        if session_uuid:
            path = self.transcript_path(session_uuid)
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return Resolution(path, fields, last, via="session uuid", strength=EXACT)
            return Resolution(reason=f"no transcript file for session {session_uuid}")

        # A live process wearing this identity outranks anything recorded: argv is
        # frozen at exec and a migration is kill-and-restart, so a roster entry or a
        # stamp says what was true when it was written, while argv says what is true.
        if name and team:
            seen = self.wearers(f"{name}@{team}")
            held = {transcript for _, transcript in seen if transcript}
            if len(held) > 1:
                return Resolution(reason=(
                    f"{len(seen)} live processes wear {name}@{team} on different conversations "
                    f"({', '.join(f'pid {pid} on {t[:8]}' for pid, t in seen if t)}); "
                    "name the one you mean with --resume"))
            if held:
                path = self.transcript_path(held.pop())
                if path:
                    if len(seen) > 1:
                        warn(f"{len(seen)} live processes wear {name}@{team} on this one "
                             f"conversation (pids {', '.join(str(pid) for pid, _ in seen)})")
                    fields, last = ({}, 0) if quick else self._scan_transcript(path)
                    return Resolution(path, fields, last, strength=EXACT,
                                      via=f"live pid {seen[0][0]} wearing {name}@{team}")

        if lead_session or is_lead:
            path = self.transcript_path(lead_session) if lead_session else None
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return Resolution(path, fields, last, via="roster leadSessionId", strength=EXACT)
            path, why = self.lead_transcript_for(team) if team else (None, "no team was named")
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return Resolution(path, fields, last, via=why, strength=EXACT)
            named = (f"roster names lead session {lead_session}, which has no transcript, and "
                     if lead_session else "")
            return Resolution(reason=f"{named}{why}")

        if team and name:
            hits = self._stamped_candidates(name, team, verify=not quick)
            if hits:
                return Resolution(*hits[0], via="agentName+teamName stamps", strength=STAMPS, others=hits[1:])
            # A promoted member has no stamps until its first turn; its
            # conversion receipt names its transcript structurally.
            receipt = self.converted_members(team).get(name)
            if receipt:
                # The record sits in the transcript it describes, so the file
                # is the answer rather than a path field that could go stale.
                found = self.transcript_path(receipt["dest_stem"])
                if found:
                    fields, last = ({}, 0) if quick else self._scan_transcript(found)
                    return Resolution(found, fields, last, via="conversion receipt",
                                      strength=EXACT)

        if name:
            rosters = self.name_rosters(name)
            if len(rosters) > 1:
                return Resolution(reason=(
                    f"no transcript stamped team={team} for {name!r}, and the bare name is in "
                    f"{len(rosters)} rosters, so it identifies nobody"
                ))
            hits = self._stamped_candidates(name, None, verify=not quick)
            if hits:
                return Resolution(
                    *hits[0], via="agentName only (unique across rosters)", strength=NAME_ONLY, others=hits[1:]
                )
        return Resolution(reason=f"no transcript found for {name or '?'}@{team or '?'}")

    def _boot_join(self):
        """[(team, pid, createdAt)] pairing each implicit team with the live process
        that minted it, newest first.

        A boot mints its implicit team named after its internal session id, while
        sessions/<pid>.json keeps the *resumed transcript* id. The two diverge after
        a resume (before one they are the same id, which lead_pid exploits as an
        exact join), and nothing else records the post-resume internal id, so for
        those teams time is a join of last resort: a
        team dir is created a few hundred ms before the session file when a boot
        mints it eagerly (measured 281, 252 and 402ms), but it can instead be
        minted at the first spawn, minutes later, which this window does not cover.
        That is why the exact rungs above it are tried first.
        """
        live = [
            (data["pid"], data.get("startedAt") or 0)
            for data in self.session_registry()
            if self.pid_alive(data["pid"], data.get("procStart"))
        ]
        pairs = []
        for cfg, data, _mtime in self.rosters():
            created = data.get("createdAt") or 0
            for pid, started in live:
                if 0 <= started - created <= TEAM_MINT_WINDOW_MS:
                    pairs.append((data.get("name") or cfg.parent.name, pid, created))
        pairs.sort(key=lambda item: item[2], reverse=True)
        for team in {name for name, _, _ in pairs}:
            owners = {pid for name, pid, _ in pairs if name == team}
            if len(owners) > 1:
                warn(f"{team} pairs with {len(owners)} processes started within "
                     f"{TEAM_MINT_WINDOW_MS}ms ({', '.join(map(str, sorted(owners)))}); "
                     "the pick between them is arbitrary")
        return pairs

    def team_population(self, team):
        """{name: (in_roster, evidence)} for everyone this team has had.

        States: listed, unrecorded (running, in no roster), and former. A roster
        is the team as it stands, and the harness prunes a member from it when
        that member finishes, so former is the trace of a team that completed
        something rather than a fault. The stamps are every transcript that ever
        ran as part of it.
        Both are the team, so which one a run means is a choice and not a
        default. Built from the sources standing() consults, so a member it
        calls unlisted cannot be missing from here.
        """
        people = {}
        for member in (self.roster_of(team) or {}).get("members", []):
            name = member.get("name")
            if name:
                people[name] = ("listed", "listed in the roster")
        for _path, (name, stamped_team) in self.stamp_index().items():
            if stamped_team == team and name and name not in people:
                # Running and absent from the roster is not former: former is the
                # trace of work that finished, and this agent has not. The run
                # path drew that line already; this is the same word, one reader.
                people[name] = (("unrecorded", "running, and in no roster")
                                if self.wearers(f"{name}@{team}")
                                else ("former", "a transcript stamped with this team"))
        for name in self.converted_members(team):
            if name not in people:
                people[name] = ("converted",
                                "a conversion receipt; registers on first launch")
        return people

    def converted_members(self, team):
        """{name: receipt} for promoted members whose membership is a receipt.

        A promote records the spoken identity in the line the transcript
        carries, so the transcript's own existence is the evidence: a demote
        takes the file away, and there is nothing left to describe. That is
        read off the same pass as the stamps, which a promoted transcript has
        none of, and is why its membership has to be asked for separately.
        """
        return {r["name"]: r for path, r in sorted(self.carried_receipts().items())
                if r.get("team") == team and r.get("name") and path.exists()}

    def mail_ledger(self, team, to=None):
        """[{sender, to, summary, sent, state, detail}] for a team's authored mail.

        Conversational mail is double-recorded: every send sits verbatim in
        the sender's transcript as a SendMessage tool use, and every delivery
        lands in the recipient's as a teammate-message wrapper carrying the
        body unchanged. The join is pure evidence-reading, and an unmatched
        send has three honest states rather than one: still in the inbox
        file (queued), the recipient has not written since (pending a turn
        boundary), or the recipient has written and no delivery matches
        (unexplained - the drain-then-die window's visible shape).

        Harness-emitted traffic (idle notifications) has no send side, so it
        never appears here; protocol-object sends are counted, not joined.
        The transcript join is the ONLY durable record, two ways over:
        cleanup deletes inbox dirs wholesale, and normal delivery prunes the
        inbox on queueing (bundle-confirmed), so "in memory" is the one
        state any instrument can show while a loss window is open.

        `to` is the caller's declared need. A named recipient narrows the
        join to sends addressed to it, with identical states to the full
        ledger's rows for it: every transcript is still opened, because a
        send to it can originate anywhere, but only its own file pays the
        delivery side, and everyone else's parses only its send lines.
        """
        self._exercise(NEED.MAIL)
        people = {}
        for path, (name, stamped) in self.stamp_index().items():
            if stamped == team and name and name not in people:
                people[name] = path
        lead_session = self.team_lead_session(team)
        if lead_session and "team-lead" not in people:
            lead_path = self.transcript_path(lead_session)
            if lead_path:
                people["team-lead"] = lead_path

        sends, boxes, wrappers, last_write = [], {}, {}, {}
        wrapper_re = re.compile(
            r'<teammate-message teammate_id="([^"]+)"[^>]*>\n(.*?)\n</teammate-message>',
            re.DOTALL)
        for name, path in people.items():
            # The caller's declared need bounds the walk: sends to the named
            # recipient originate anywhere, so every transcript is opened, but
            # only the recipient's own file pays the delivery side (wrappers,
            # last write, inbox), and everyone else's parses only its sends.
            wants_delivery = to is None or name == to
            got_wrappers, newest = [], 0
            try:
                handle = path.open(errors="replace")
            except OSError:
                continue
            with handle:
                for line in handle:
                    if '"SendMessage"' not in line and not (
                            wants_delivery and ("<teammate-message" in line
                                                or '"timestamp"' in line)):
                        continue
                    try:
                        rec = json.loads(line)
                    except ValueError:
                        continue
                    if rec.get("isSidechain"):
                        continue
                    ts = iso_ms(rec.get("timestamp"))
                    if ts:
                        newest = max(newest, ts)
                    content = (rec.get("message") or {}).get("content")
                    if rec.get("type") == "assistant" and isinstance(content, list):
                        for block in content:
                            if (isinstance(block, dict) and block.get("type") == "tool_use"
                                    and block.get("name") == "SendMessage"):
                                spec = block.get("input") or {}
                                body = spec.get("message")
                                sends.append({
                                    "sender": name,
                                    "to": spec.get("to") or spec.get("recipient"),
                                    "summary": spec.get("summary") or "",
                                    "sent": ts,
                                    "body": body if isinstance(body, str) else None})
                    elif wants_delivery and rec.get("type") == "user":
                        text = content if isinstance(content, str) else "".join(
                            part.get("text", "") for part in content or []
                            if isinstance(part, dict))
                        if "<teammate-message" in text:
                            for who, body in wrapper_re.findall(text):
                                got_wrappers.append((who, body))
            wrappers[name] = got_wrappers
            if wants_delivery:
                last_write[name] = newest
                try:
                    inbox = json.loads(
                        (self.teams_dir / team / "inboxes" / f"{name}.json").read_text())
                    boxes[name] = [m.get("text") or str(m.get("message", ""))
                                   for m in inbox if isinstance(m, dict)]
                except (OSError, ValueError):
                    boxes[name] = []

        ledger = []
        for send in sorted(sends, key=lambda s: s["sent"] or 0):
            addressee = send["to"]
            if to is not None and addressee != to:
                continue
            entry = {k: send[k] for k in ("sender", "to", "summary", "sent")}
            if send["body"] is None:
                entry.update(state="protocol", detail="an object send; not joined")
            elif addressee not in people:
                entry.update(state="unknown recipient",
                             detail=f"{addressee!r} has no transcript stamped with this team")
            elif any(who == send["sender"] and body == send["body"]
                     for who, body in wrappers.get(addressee, [])):
                entry.update(state="delivered", detail="the body sits in the "
                             "recipient's transcript verbatim")
            elif any(send["body"] == text for text in boxes.get(addressee, [])):
                entry.update(state="queued", detail="still in the inbox file; "
                             "delivery is a turn-boundary event")
            elif (last_write.get(addressee) or 0) <= (send["sent"] or 0):
                entry.update(state="pending", detail="the recipient has not "
                             "written since the send")
            elif any(self.transcript_holders(people[addressee].stem, self.ps_table())):
                # Marked read on queueing, held in the recipient's RAM: the
                # drain-then-die window is open until its turn ends. Both
                # halves of the holder question, because the recipient may be
                # the very process asking.
                entry.update(state="in memory", detail="the recipient is live "
                             "mid-turn; delivery waits on its next boundary "
                             "and dies with its process")
            else:
                entry.update(state="unexplained", detail="the recipient has "
                             "written since, no delivery matches, and no live "
                             "process holds its transcript")
            ledger.append(entry)
        return ledger

    def reap_objections(self, team, table, archive_mail=False):
        """Why this team must not be reaped for a rebind, or [].

        The cleanup bar, asked before a rebind may retire the stamped team:
        nobody live runs as it (worn argv, a holder of any transcript stamped
        with it, or a restored life operating as it), and no mail waits
        unless the caller archives it. Moving a member out of a live team by
        deleting the team is a beheading with extra steps.
        """
        out = []
        for entry in self.live_sessions():
            if not entry.get("alive"):
                continue
            if entry.get("team") == team:
                out.append(f"pid {entry['pid']} wears it "
                           f"({entry.get('agent') or 'in argv'})")
            elif entry.get("session"):
                lived = self.transcript_path(entry["session"])
                if lived and self.restored_identity(lived) == (team, "restored"):
                    out.append(f"pid {entry['pid']} operates as it (restored)")
        for path, (name, stamped) in self.stamp_index().items():
            if stamped != team:
                continue
            strangers, ours = self.transcript_holders(path.stem, table)
            for pid, _t in strangers:
                out.append(f"pid {pid} holds {name}'s transcript")
            for pid in ours:
                out.append(f"this process (pid {pid}) holds {name}'s transcript")
        if not archive_mail:
            for name, (count, oldest) in self.inbox_state(team).items():
                if count is None:
                    out.append(f"{name}'s inbox is {oldest}")
                elif count:
                    out.append(f"{count} unread for {name}, oldest {said_when(oldest)}")
        return out

    def nameless_receipts(self):
        """Roots of materialized receipts with no recorded identity.

        Receipts written before the identity fields existed can never appear
        as converted members; re-promoting records the identity.
        """
        out = []
        try:
            paths = sorted(RECEIPTS_DIR.glob("*.json"))
        except OSError:
            return out
        for path in paths:
            try:
                receipt = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if receipt.get("state") == "materialized" and not (
                    receipt.get("name") and receipt.get("team")):
                out.append(path.stem)
        return out

    def live_teams(self):
        """Teams a live process is currently running as, from its own argv."""
        return {e["team"] for e in self.live_sessions() if e.get("team")}

    def worn_team(self, pid):
        """The team this live process names in its own argv, or None.

        Worn is not operative. A launch onto a transcript whose window-start
        carries stamps runs as the stamped team (line stamps, spawns, future
        resolution) while idle notifications still go to the worn team and
        both teams' inboxes are polled - measured on 2.1.220, all three
        carriers on one process. Argv remains the answer for holder matching
        and for where idles land; restored_identity answers the operative half.
        """
        return next((e.get("team") for e in self.live_sessions() if e["pid"] == pid), None)

    def window_start(self, path):
        """(agentName, teamName, uuid) of the entry restore reads, else None.

        The loader picks the timestamp-latest user or assistant record whose
        uuid any last-prompt line names (the set, not merely the final line),
        walks parentUuid to null - never logicalParentUuid - and adopts the
        stamps of the entry it stops at, when it carries BOTH. One walk, one
        implementation: the restored-identity rung and the launch guard both
        read here. Triple-witnessed against 2.1.220: stale source, bundle,
        live sandbox. Cautionary specimen: transcript 8f1a0dc1 on this box
        answers team-lead/session-b16311b4 from its pseudocompact boundary,
        which is the fact the session-id rung overclaimed past when it graded
        a redirect exact on 2026-08-05. A corrupt chain may restore through
        the harness's timestamp fallback instead of this walk; that is a
        caveat on the answer, not part of it.
        """
        records, leaves = {}, []
        try:
            handle = path.open(errors="replace")
        except OSError:
            return None
        with handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("type") == "last-prompt":
                    # Order kept so a wrong final-wins reading stays writable
                    # as a probe; the set-latest rule below is the loader's.
                    if rec.get("leafUuid") and rec["leafUuid"] not in leaves:
                        leaves.append(rec["leafUuid"])
                    continue
                if rec.get("uuid"):
                    records[rec["uuid"]] = (rec.get("parentUuid"),
                                            rec.get("agentName"), rec.get("teamName"),
                                            iso_ms(rec.get("timestamp")), rec.get("type"))
        candidates = [(ts, uuid) for uuid, (_p, _a, _t, ts, kind) in records.items()
                      if uuid in leaves and kind in ("user", "assistant")]
        if not candidates:
            return None
        cursor = max(candidates)[1]
        seen = set()
        while cursor in records and cursor not in seen:
            seen.add(cursor)
            parent = records[cursor][0]
            if parent is None:
                _p, name, team, _ts, _k = records[cursor]
                return (name, team, cursor) if name and team else None
            cursor = parent
        return None

    def restored_identity(self, path):
        """(team, state) for what a resume of this transcript will run as.

        states: "restored"  - stamped window-start naming a team whose roster
                              loads; overrides flags (line stamps, spawns,
                              future window-starts all follow it)
                "orphaned"  - stamped window-start naming a team with no
                              roster; argv survives if worn, otherwise the
                              session comes up as nobody and writes unstamped
                              lines until the team dir exists again
                None        - unstamped window-start; flags and the mint
                              behave as recorded
        """
        start = self.window_start(path)
        if not start:
            return None, None
        _name, team, _uuid = start
        try:
            loads = self.roster_path(team).exists()
        except OSError:
            loads = False
        return team, ("restored" if loads else "orphaned")

    def live_led(self, stem):
        """The teams this transcript led that have members running now.

        Answers the pair, never chooses: a holder, not a second placer.
        place() decides placement from it, and a demote refuses beheading
        from it.
        """
        return [t for t in self.teams_led_by(stem) if t in self.live_teams()]

    def demote_subject(self, selector):
        """(path, name, team) for the transcript a demote names.

        The engine picks the transcript and reads its identity; the verb only
        consumes the answer.
        """
        path = self.transcript_path(selector)
        if not path:
            return None, None, None
        fields, _ts = self._scan_transcript(path)
        return (path, fields.get("agentName", (None,))[0],
                fields.get("teamName", (None,))[0])

    def restamp_plan(self, path, team, name=None):
        """The two-field window-start restamp, proved before anyone writes.

        Forbidden by construction, so the line cannot creep: content bytes
        never, any field beyond teamName/agentName never, any line beyond
        the located window-start never. The inverse is rebuilt in memory and
        byte-compared before the plan may be applied.
        """
        start = self.window_start(path)
        if not start:
            return {"objections": ["this conversation carries no stamped identity "
                                   "record to rewrite"], "proved": False}
        old_name, old_team, uuid = start
        if old_team == team and (name is None or name == old_name):
            return {"objections": [f"its identity record already says {team}; "
                                   "nothing to rewrite"], "proved": False}
        try:
            raws = path.read_text(errors="strict").split("\n")
        except (OSError, UnicodeDecodeError) as err:
            return {"objections": [f"unreadable: {err}"], "proved": False}
        trailing = raws and raws[-1] == ""
        if trailing:
            raws.pop()
        # Same rule as the conversion record: while it is still the last line
        # it belongs to this tool, so a further restamp replaces it rather than
        # stacking. Once anything is written past it, it is history and stays.
        # What it carries forward is where this conversation started, not the
        # hop before: three moves leave one record of the net change, and a
        # move back to the origin leaves none.
        origin = None
        if raws:
            try:
                prior = json.loads(raws[-1])
                if prior.get("type") == RESTAMP_RECORD:
                    origin = (prior.get("restamp") or {}).get("old") or None
                    raws.pop()
            except (ValueError, AttributeError):
                pass
        for i, raw in enumerate(raws):
            if f'"{uuid}"' not in raw:
                continue
            loaded, why = self._codec_load(raw)
            if loaded is None:
                return {"objections": [f"its identity record {why}"],
                        "proved": False}
            rec, style = loaded
            if rec.get("uuid") != uuid:
                continue
            new = dict(rec)
            new["teamName"] = team
            if name:
                new["agentName"] = name
            allowed = {"teamName"} | ({"agentName"} if name else set())
            changed = {k for k in set(rec) | set(new)
                       if rec.get(k, _MISSING) != new.get(k, _MISSING)}
            if changed - allowed:
                return {"objections": [f"the edit set would need "
                                       f"{sorted(changed - allowed)[0]}"],
                        "proved": False}
            back = dict(new)
            back["teamName"] = old_team
            if name:
                back["agentName"] = old_name
            if self._codec_dump(back, style) != raw:
                return {"objections": ["the inverse does not restore the line"],
                        "proved": False}
            out = list(raws)
            out[i] = self._codec_dump(new, style)
            was = origin or {"teamName": old_team, "agentName": old_name}
            now = {"teamName": team, "agentName": name or old_name}
            receipt = {"kind": "restamp", "stem": path.stem, "uuid": uuid,
                       "old": was, "new": now, "at": int(time.time() * 1000)}
            # Back where it started is not a change to record, and the file
            # returns to the bytes it had before any of this.
            if now != was:
                out.append(json.dumps({"type": RESTAMP_RECORD, "restamp": receipt},
                                      separators=(",", ":"), ensure_ascii=False,
                                      sort_keys=True))
            return {"path": path, "lines": out, "receipt": receipt,
                    "objections": [], "proved": True}
        return {"objections": [f"identity record {uuid} not found as a line"],
                "proved": False}

    def rebind_fragility(self, stem, team):
        """The fragile sentence for a rebound transcript, or None.

        A transcript whose window-start names an absent team runs as its
        flags only for as long as that team stays absent; the reports say so
        with the remedy, so nobody reads a working rebind as a finished one.
        """
        path = self.transcript_path(stem) if stem else None
        stamped, state = (self.restored_identity(path) if path else (None, None))
        if state == "orphaned" and stamped and stamped != team:
            return (f"was moved from {stamped} and goes back if that team is "
                    f"recreated; run /compact in it to make {team} permanent. "
                    "Mail works either way")
        return None

    def operative_team(self, path, worn):
        """(team, exact, state) a resume of this transcript operates as.

        The five measured arms, one answer: a stamped window-start whose team
        loads overrides the flags; stamped for an absent team, the flags
        survive when worn and nobody answers when not; unstamped, the flags
        are the answer and the mint rungs keep their standing.
        """
        team, state = self.restored_identity(path) if path else (None, None)
        if state == "restored":
            return team, True, "restored"
        if state == "orphaned":
            if worn:
                return worn, True, "orphaned, argv stands"
            return None, False, "orphaned, runs as nobody"
        if worn:
            return worn, True, "worn"
        return None, None, None

    def teams_with_live_evidence(self):
        """Teams with a live lead, a live member, or mail nobody has read.

        What a diagnosis is for. Every other team on the machine is history
        until someone asks for it by name.
        """
        teams = {e["team"] for e in self.live_sessions() if e.get("team")}
        for team in self.known_teams():
            if team in teams:
                continue
            pid, alive, _how, _exact = self.lead_pid(None, team)
            if (pid and alive) or any(n is None or n
                                      for n, _o in self.inbox_state(team).values()):
                teams.add(team)
        return teams

    def minted_by_a_resumed_life(self, team):
        """Whether only a resumed life could have minted this team. From disk.

        A team is named after its minting boot's session id and records that
        id as leadSessionId. A fresh boot's id is also its transcript's
        filename, so its team's leadSessionId names a file. A resumed life's
        id is generated at that boot and names nothing. So a team whose
        leadSessionId has no transcript was minted by a resumed life, and one
        whose leadSessionId has a transcript belongs to that transcript's
        boot - whatever any timing window says. Measured here: 19 of 23 teams
        carry the fresh shape, 4 the resumed one.
        """
        data = self.roster_of(team) or {}
        lead_session = data.get("leadSessionId")
        if not lead_session:
            return None
        return self.transcript_path(lead_session) is None

    def mint_candidates(self, pid):
        """(teams this process could have minted, why) - structure, then time.

        Structure first: a fresh boot's team is derivable and confirmable, so
        it needs no window at all. A resumed life's is not, but the teams it
        could possibly have minted are still bounded by shape, which is what
        keeps a stranger's fresh-boot team out of the answer.
        """
        entry = next((e for e in self.live_sessions() if e["pid"] == pid), None)
        session = (entry or {}).get("session")
        if session:
            derived = f"session-{session[:8]}"
            data = self.roster_of(derived) or {}
            if data.get("leadSessionId") == session:
                # Its own id names the team and the roster agrees: a fresh
                # boot, answered from disk with nothing inferred.
                return [derived], "its own session id names this team"
        pool = [t for t in self.known_teams()
                if self.minted_by_a_resumed_life(t)]
        return pool, "the teams a resumed life could have minted"

    def sole_mint_pairing(self, pid):
        """The team only this process could have minted, or None if ambiguous.

        Unique in both directions. _boot_join warns when several processes fall
        in one team's window but returns them anyway, and it never asks whether
        one process falls inside several teams' windows, so neither direction is
        established by appearing in that list.
        """
        pool, _why = self.mint_candidates(pid)
        pairs = [p for p in self._boot_join() if p[0] in pool]
        mine = {team for team, owner, _ in pairs if owner == pid}
        if len(mine) != 1:
            return None
        team = mine.pop()
        return team if {owner for t, owner, _ in pairs if t == team} == {pid} else None

    def is_claude(self, args):
        """Whether this cmdline is a claude process. Public: pane bookkeeping asks
        it, and a caller reaching a private method for a fair question means the
        underscore has stopped meaning anything."""
        return self._looks_like_claude_impl(args)

    def _looks_like_claude_impl(self, args):
        """Match on argv[0] only. A tmux server's own cmdline embeds the whole
        spawn command, so searching the full args counts the server as an agent."""
        argv0 = args.split(None, 1)[0] if args.strip() else ""
        return bool(CLAUDE_PROC.search(argv0))

    def _argv_pairs(self, args):
        """{"--flag value"} for each flag/value pair in a cmdline, both spellings.

        Substring matching would let `--agent-id alpha@team` match a process running
        `--agent-id alpha@team2`, which for forged team names is a real collision.
        """
        tokens = args.split()
        pairs = set()
        for index, token in enumerate(tokens):
            if not token.startswith("-"):
                continue
            if "=" in token:
                flag, _, value = token.partition("=")
                pairs.add(f"{flag} {value}")
            elif index + 1 < len(tokens):
                pairs.add(f"{token} {tokens[index + 1]}")
        return pairs

    def _own_lineage(self, table):
        """Our own pid and ancestors, whose cmdlines quote the agent id we
        searched for. A transform over a table already in hand, not a second
        reading of the process realm."""
        parents = {p: pp for p, pp, _ in table}
        pid, chain = os.getpid(), set()
        while pid and pid not in chain:
            chain.add(pid)
            pid = parents.get(pid)
        return chain

    def _claude_procs(self, needle, table):
        """Live claude processes whose argv contains this exact flag/value pair,
        excluding our own lineage (whose cmdline quotes what we searched for)."""
        mine = self._own_lineage(table)
        return [
            (pid, args)
            for pid, _, args in table
            if needle in self._argv_pairs(args) and pid not in mine and self.is_claude(args)
        ]

    def team_souls(self, team, entries=None):
        """{name: Resolution} for everything in a team the resolver can still find.

        "Is there anything here to resurrect" is the engine's own question, so it
        is answered here once: the reaper uses it to decide what is cruft, and the
        completion labels use it to mark teams that cannot come back. Answering it
        anywhere else means a team could be advertised as revivable and deleted by
        the same run.
        """
        if entries is None:
            entries = self.roster_entries(team=team)
        souls = {}
        lead_session = entries[0]["leadSessionId"] if entries else None
        if lead_session:
            found = self.resolve_transcript(lead_session=lead_session, team=team, is_lead=True, quick=True)
            if found:
                souls["team-lead"] = found
        named = [entry["member"].get("name") for entry in entries]
        if not entries:
            # team_evidence proved a roster is not the only witness to a team, and the
            # reaper bets deletions on this answer, so a team with no roster left is
            # asked of the stamps rather than assumed empty.
            named = [stamped_name for stamped_name, stamped_team in self.stamp_index().values()
                     if stamped_team == team]
        for name in named:
            if name and name != "team-lead" and name not in souls:
                found = self.resolve_transcript(team=team, name=name, quick=True)
                if found:
                    souls[name] = found
        return souls

    class _Merged:
        """Field values from many sources; most recent wins."""

        def __init__(self):
            self.cands = defaultdict(list)

        def add(self, field, value, ts, source):
            if value in (None, ""):
                return
            self.cands[field].append((value, ts or 0, source))

        def pick(self, field, prefer_specific=False):
            cands = self.cands.get(field)
            if not cands:
                return None, None, None
            value, ts, source = max(cands, key=lambda c: c[1])
            if prefer_specific and isinstance(value, str):
                # e.g. jsonl records "claude-opus-5" but the team config kept
                # "claude-opus-5[1m]", same model, one is simply lossier.
                # Only a bracketed variant counts (claude-opus-5 -> claude-opus-5[1m]).
                # Any longer string would let a stale roster silently revert a model
                # the user changed mid-session.
                richer = [c for c in cands if isinstance(c[0], str) and c[0].startswith(value + "[")]
                if richer:
                    value, ts, source = max(richer, key=lambda c: len(c[0]))
                    source += " (more specific)"
            return value, ts, source

        def conflicts(self, field):
            return {c[0] for c in self.cands.get(field, [])}

    def place(self, res, typed_team, for_team=None, to_team=None, keep_team=False):
        """(team, why) for the agent this transcript holds. The only writer of it.

        An address locates an agent; it does not place one. Completion collapses
        an agent to a single entry, so a stale team can be the only spelling
        available to type, and honouring it puts an agent where its own evidence
        says it is not. Moving an agent is what --to-team says and rebuilding a
        named team is what for_team says: destinations are spoken. A team inside
        an agent id is not spoken, it is how the agent was found.

        Precedence: a spoken destination, then --keep-team, then the team whose
        members are running, then the team as addressed. Several running crews is
        a choice between live teams and not the engine's to make.
        """
        spoken = to_team or for_team
        if spoken:
            return spoken, "asked for"
        live_led = self.live_led(res.path.stem)
        if keep_team:
            if typed_team and live_led and typed_team not in live_led:
                warn(f"--keep-team: staying on {typed_team}, though this transcript's "
                     f"live members are on {', '.join(live_led)}; their mail goes "
                     f"unread while it runs as {typed_team}")
            return typed_team, "as typed"
        if len(live_led) > 1:
            die(f"this transcript leads {len(live_led)} teams with members running "
                f"({', '.join(live_led)}); name one with --team")
        if live_led and live_led[0] != typed_team:
            return live_led[0], (f"its live members are here; {typed_team} as addressed "
                                 f"has nobody running" if typed_team
                                 else "its live members are here")
        return typed_team, "as addressed"

    def identity(self, session_uuid=None, agent_id=None, for_team=None, to_team=None,
                 keep_team=False):
        merged = self._Merged()
        leads_team = None
        team_entry = None
        transcript = None
        session_uuid = session_uuid
        others = []

        if agent_id:
            matches = self.roster_entries(agent_id=agent_id)
            if matches:
                team_entry = matches[0]
                if len(matches) > 1:
                    warn(f"{len(matches)} team configs claim {agent_id}; using {team_entry['cfg']}")
            else:
                warn(f"no team config lists {agent_id}; falling back to name@team parsing")

        team = name = None
        if team_entry:
            team, name = team_entry["team"], team_entry["member"].get("name")
        elif agent_id and "@" in agent_id:
            name, team = agent_id.split("@", 1)

        worn_id = f"{name}@{team}" if name and team else None
        # The harness reserves the name, so a lead is a lead whether or not a roster
        # survives to say so; without this a reaped team's lead is refused as a name
        # that lives in several rosters.
        is_lead_member = ((bool(team_entry) and team_entry["member"].get("agentId") == team_entry.get("leadAgentId"))
                          or name == "team-lead")
        res = self.resolve_transcript(
            session_uuid=session_uuid,
            lead_session=(team_entry.get("leadSessionId")
                          if is_lead_member and team_entry else None),
            team=team,
            name=name,
            is_lead=is_lead_member,
        )
        if not res:
            die(
                f"{res.reason}; a truly in-process agent leaves only a sidechain under the lead's "
                "subagents/ dir, which no CLI can resume"
            )
        objections = self.objections(res, name, team)
        transcript = (res.path, res.fields, res.last_ts)
        others = [(p, f, t) for p, f, t in res.others]
        session_uuid = res.path.stem

        # Located; now placed. Clearing the entry when the team changes is what
        # keeps a stale roster from contributing the team it described a life ago:
        # its appearance still travels, through the payload record below.
        placed, placed_why = self.place(res, team, for_team, to_team, keep_team)
        redirected = bool(placed and placed != team)
        if redirected:
            team, team_entry = placed, None

        if not team_entry:  # a uuid or a stranger's id: adopt the roster the transcript names
            stamped_team, stamped_name = res.stamped("teamName"), res.stamped("agentName")
            # A lead that led several teams across its lives carries the stamps of
            # one of them. When the caller names a team this transcript is proved
            # to have led, that is the question being asked, and the stamps are an
            # earlier life answering a different one.
            asked = for_team or team
            leads_asked = bool(asked and asked != stamped_team
                               and asked in self.teams_led_by(session_uuid))
            if stamped_team and stamped_name and not leads_asked:
                matches = self.roster_entries(team=stamped_team, name=stamped_name)
                team_entry = matches[0] if matches else None
            elif not stamped_team or leads_asked:
                # No team stamp, so this is nobody's teammate: the harness stamps
                # both or neither on a teammate's lines. A name may still be there
                # without being teammate identity, from either of two causes: a
                # session that ran named but team-less, or a launch that carried
                # --agent-name with mismatched team flags. Both occur, so neither
                # can be assumed. Either way the
                # name is noise here and the payloads are the structural fact, so
                # the lead identity is derived rather than read off the stamp.
                #
                # Ask the payloads it wrote which team it was running as, and adopt
                # that team's lead entry. Without this the run falls through to the
                # member path and dies asking for a tmux socket, which is several
                # steps downstream of the real answer.
                # A lead that ran several teams across its lives adopts the one the
                # caller asked to rebuild, not whichever it ran as last.
                led_teams_here = self.teams_led_by(session_uuid)
                # Whichever way the caller named a team - as --team, or as the right
                # half of an agent id - that is the team being rebuilt, not whichever
                # this lead happened to run as last.
                wanted = for_team or team
                for led in ([wanted] if wanted in led_teams_here else led_teams_here):
                    matches = self.roster_entries(team=led, lead_only=True)
                    if matches:
                        team_entry = matches[0]
                        break
                    # The team dir is gone, so state the identity the payloads prove
                    # and let forge_team rebuild the roster around it.
                    #
                    # Recorded as a fact, not merged as a value. A session that ran
                    # under its own name and later spawned teammates is that team's
                    # lead, and a roster's lead entry is team-lead@<team> whatever
                    # the session calls itself. Competing on timestamps to say so
                    # does not work and should not have to: the transcript's own
                    # stamp can be newer than the activity the resolution recorded,
                    # and a structural fact that must win a race is one waiting to
                    # be lost.
                    leads_team = led
                    merged.add("teamName", led, res.last_ts, "spawn payloads in this transcript")
                    merged.add("agentName", "team-lead", res.last_ts, "spawn payloads in this transcript")
                    merged.add("agentId", f"team-lead@{led}", res.last_ts, "spawn payloads in this transcript")
                    break
                else:
                    # Nothing stamped it and it spawned nobody, so it is neither a
                    # teammate's transcript nor a lead's. Say that, rather than
                    # continuing down the member path to fail on a missing socket,
                    # which describes a pane this transcript was never going to get.
                    if not agent_id:
                        die(
                            f"{res.path.name} carries no agent stamps, so it is not a teammate's, "
                            "and records spawning no teammates, so it never led a team either. "
                            "There is no agent identity to restore here: resume it with plain "
                            "`claude --resume`, or pass --agent-id to give it one."
                        )

        # ---- team config contributions
        if team_entry:
            member, ts, src = team_entry["member"], team_entry["ts"], f"team:{team_entry['cfg']}"
            merged.add("agentId", member.get("agentId"), ts, src)
            merged.add("agentName", member.get("name"), ts, src)
            merged.add("teamName", team_entry["team"], ts, src)
            merged.add("color", member.get("color"), ts, src)
            merged.add("agentType", member.get("agentType"), ts, src)
            merged.add("model", member.get("model"), ts, src)
            merged.add("cwd", member.get("cwd"), ts, src)
            merged.add("tmuxPaneId", member.get("tmuxPaneId"), ts, src)
            merged.add("backendType", member.get("backendType"), ts, src)
            merged.add("parentSessionId", team_entry["leadSessionId"], ts, src)
            if member.get("planModeRequired"):
                merged.add("permissionMode", "plan", ts, src)

        # ---- transcript contributions
        path, fields, last_ts = transcript
        src = f"jsonl:{path.name}"
        for field, (value, ts) in fields.items():
            if not field.startswith("_"):
                merged.add(field, value, ts, src)
        if not merged.cands.get("agentId"):
            name = fields.get("agentName", (None,))[0]
            team = fields.get("teamName", (None,))[0]
            if name and team:
                merged.add("agentId", f"{name}@{team}", last_ts, src + " (derived)")

        # ---- a worn identity pins the identity triple
        # When a live process is what identified this transcript, that process is
        # wearing the identity now: its argv carries --agent-id and --team-name, so
        # this is evidence already held rather than a derivation. Stamps are older
        # lines on the same file and a rebind is exactly what puts them out of step,
        # so per-field most-recent-wins can otherwise take the id from one source and
        # the team from another, and emit a command wearing two different teams.
        # Non-identity fields keep normal merge semantics.
        if res.via.startswith("live pid ") and worn_id and "@" in worn_id:
            worn_name, _, worn_team = worn_id.partition("@")
            pinned = last_ts + 1  # outranks anything the transcript itself can say
            merged.add("agentId", worn_id, pinned, "live argv")
            merged.add("agentName", worn_name, pinned, "live argv")
            merged.add("teamName", worn_team, pinned, "live argv")

        # ---- last resort: the lead's record of spawning this member
        # Timestamp 0 so it loses every tie: it is a snapshot from spawn time, and
        # the roster or the transcript is newer whenever either has the field. Read
        # lazily, since the lead transcript can be megabytes.
        # Consulted unconditionally, not only when a field is missing: "present" is
        # not "good". A roster can hold claude-opus-5 where the spawn record holds
        # claude-opus-5[1m], and gating on absence would let that degraded value
        # stick forever. One cached read of the lead transcript per process.
        record = self.spawn_payload(merged.pick("agentId")[0], merged.pick("parentSessionId")[0])
        if record:
            for key, field in SPAWN_FIELDS.items():
                merged.add(field, record.get(key), 0, "lead transcript spawn record")
            if record.get("plan_mode_required"):
                merged.add("permissionMode", "plan", 0, "lead transcript spawn record")

        # A dead team dir takes leadSessionId with it. Asking the engine rather than
        # globbing here keeps one answer to "which session led this team": the glob is
        # the engine's weakest rung, below the roster and the payloads, and reaching
        # for it directly skipped both.
        if not merged.cands.get("parentSessionId"):
            lead = self.lead_session_for(merged.pick("teamName")[0] or "")
            if lead:
                merged.add("parentSessionId", lead, transcript[2], "engine: lead session for team")

        return {
            "merged": merged,
            "team_entry": team_entry,
            "transcript": transcript,
            "session_uuid": session_uuid,
            "other_transcripts": others,
            # A lead reached by rung 4 has no roster entry yet, so its own merged id
            # is the answer: the payloads that named its team also make it the lead.
            "lead_agent_id": (f"team-lead@{leads_team}" if leads_team
                              else team_entry["leadAgentId"] if team_entry
                              else (aid if (aid := merged.pick("agentId")[0])
                                    and merged.pick("agentName")[0] == "team-lead" else None)),
            "via": res.via,
            "objections": objections,
            "leads_team": leads_team,
            "placed": (placed, placed_why) if redirected else None,
            "resolution": res,
            "to_team": to_team,
        }

    def agent_cwd(self, ctx):
        """Working dir for the revived process, or None. Never a guess.

        /cd moves a session's cwd mid-life, so a transcript records several, and the
        newest is not automatically right: --resume looks the session up under the
        project dir, and that dir tracks only one of them (usually the first, but
        not always: of 20 transcripts here that moved, most match their first cwd
        and at least one matches its last). So prefer whichever recorded cwd
        actually flattens to this transcript's own project dir, newest first, and
        fall back to the newest with a warning.

        The dir name itself is not a source: flattening maps every non-alphanumeric
        to '-', so '_', '.', ' ', '-' and '/' all collapse together (verified across
        70 project dirs), which leaves it with no inverse.
        """
        merged, path = ctx["merged"], ctx["transcript"][0]
        trail = list(ctx["transcript"][1].get("_cwds", ([],))[0])
        roster_cwd = (ctx.get("team_entry") or {}).get("member", {}).get("cwd")
        candidates = trail + ([roster_cwd] if roster_cwd else [])
        project = path.parent.name

        consistent = [c for c in candidates if flatten_cwd(c) == project]
        if consistent:
            return consistent[-1]
        if candidates:
            if len(set(candidates)) > 1:
                warn(f"cwd moved during this session ({' -> '.join(dict.fromkeys(candidates))}); "
                     f"none flattens to project dir {project}, using the newest")
            return candidates[-1]
        fallback = merged.pick("cwd")[0]
        if not fallback:
            warn("no cwd recorded in roster or transcript; the agent starts in whatever "
                 "directory it inherits, and --resume looks a transcript up under the project "
                 "dir of that directory, so it may not find its own conversation")
        return fallback or None

    def field(self, ctx, name, prefer_specific=False):
        """One assembled field's value, or None.

        The accessor consumers use, so the merge stays an engine internal. Every
        caller reaching into it directly was a caller that could have assembled a
        different answer than the engine did.
        """
        return ctx["merged"].pick(name, prefer_specific=prefer_specific)[0]

    def provenance(self, ctx, name):
        """(value, timestamp, source) for a field, for --explain."""
        return ctx["merged"].pick(name)

    def objections(self, res, want_name, want_team):
        """Typed facts about what the chosen transcript contradicts, or an empty list.

        Judgement only. Whether an objection is fatal depends on --force and on
        whether a team change was asked for, and those are the caller's to weigh:
        this says what is true, enforce_identity says what to do about it.

        Splitting them is also what stops the check from being optional: a
        check a caller must remember to call runs at one site out of the
        several that resolve identities.
        """
        stamped_name, stamped_team = res.stamped("agentName"), res.stamped("teamName")
        objections = []

        if stamped_name is None:
            # Unstamped means a lead transcript. Only an exact rung may claim one.
            if res.strength < EXACT:
                objections.append(("unstamped_below_exact", None, None, res.via))
            return objections

        if want_name and stamped_name != want_name:
            # Never relaxed. A lead launched under a wrong name gets every
            # line stamped with it by the harness; a guard taught to accept
            # that converts corruption detection into permanent silence, and
            # the next identity-corrupting bug passes unremarked.
            #
            # What the roster and the payloads say is reported alongside, so the
            # refusal can name the remedy instead of only the contradiction.
            corroborated = (res.via == "roster leadSessionId"
                            or "payload claimant" in res.via
                            or res.via.startswith("spawn payloads naming"))
            objections.append(("name_mismatch", stamped_name, want_name,
                               f"{res.via}|corroborated" if corroborated else res.via))

        if want_team and stamped_team and stamped_team != want_team:
            # A rebind asks for the change; a unique name and a live process wearing
            # the identity both make the stamp the stale half rather than the wrong one.
            tolerated = (res.strength == NAME_ONLY or res.via.startswith("live pid "))
            why = "tolerated" if tolerated else res.via
            if not tolerated:
                # A transcript that was a teammate first and later led another team
                # carries stamps from the earlier life and payloads from the newer
                # one. Which came first decides what an override means, so the
                # relation is measured rather than left for the reader to guess.
                stamped_ts = res.fields.get("teamName", (None, 0))[1]
                claimed_ts = max((stamp for stamp, payload in self._log(res.path.stem)
                                  if payload.get("team_name") == want_team), default=0)
                if stamped_ts and claimed_ts > stamped_ts:
                    why += "|newer"
            objections.append(("team_mismatch", stamped_team, want_team, why))
        return objections

    def classify(self, token):
        """What kind of thing this token names: (kind, value, why).

        kind is one of uuid, agent_id, team, name, ambiguous, unknown. One
        classifier, because a selector deciding this for itself writes the
        same rule twice, a roster-name scan and a several-rosters refusal
        beside the engine's own, answering in two voices.

        The caller still does the talking: an ambiguous token comes back with its
        candidates so the refusal can annotate them with live state, which is
        presentation and not a decision.
        """
        if UUID_RE.match(token):
            return "uuid", token, "a session uuid"
        if "@" in token:
            return "agent_id", token, "a full agent id"
        team_why = self.team_evidence(token)
        if team_why:
            return "team", token, team_why
        if re.fullmatch(r"session-[0-9a-f]{8}", token):
            return ("unknown", None,
                    "is shaped like a team but is not one: no roster on disk, no spawn "
                    "payloads name it, and no transcript is stamped with it")
        matches = self.roster_entries(name=token)
        if len({entry["team"] for entry in matches}) > 1:
            return "ambiguous", matches, f"in {len({e['team'] for e in matches})} rosters"
        if matches:
            return "agent_id", matches[0]["member"].get("agentId"), "the only roster naming it"
        found = self.resolve_transcript(name=token)
        if found:
            return "name", found, f"matched by transcript ({found.via})"
        return "unknown", None, f"is in no roster: {found.reason}"

    def roster_entries(self, agent_id=None, name=None, team=None, lead_only=False):
        """Roster entries matching these criteria, newest first.

        The newest-wins tie-break between rosters claiming one agent was written
        out four times. It is a policy, not a filter: when several rosters claim
        one agent, which is believed decides whose conversation gets resumed, and
        four copies of that are four chances to answer it differently.
        """
        found = [
            entry for entry in self.scan_teams()
            if (agent_id is None or entry["member"].get("agentId") == agent_id)
            and (name is None or entry["member"].get("name") == name)
            and (team is None or entry["team"] == team)
            and (not lead_only or entry["member"].get("agentId") == entry.get("leadAgentId"))
        ]
        found.sort(key=lambda entry: entry["ts"], reverse=True)
        return found


    def rosters(self):
        """[(cfg path, parsed roster, mtime ms)] for every team config on disk.

        The one place a roster is read. Three callers were parsing configs for
        themselves, which is three chances to disagree about what a roster is and
        three places to fix when the shape changes.

        Deliberately uncached: a run can forge a roster partway through, and a
        cache would hide it from everything downstream of the forge.
        """
        out = []
        for cfg in (self.roster_path(d.name) for d in self.team_dirs()):
            try:
                data = json.loads(cfg.read_text())
            except (OSError, ValueError):
                continue
            try:
                mtime = int(cfg.stat().st_mtime * 1000)
            except OSError:
                mtime = 0
            out.append((cfg, data, mtime))
        return out

    def roster_of(self, team):
        """One team's parsed roster, or None."""
        return next((data for cfg, data, _ in self.rosters()
                     if (data.get("name") or cfg.parent.name) == team), None)

    def scan_teams(self):
        """Every member of every team config, newest-first metadata attached."""
        entries = []
        for cfg, data, mtime in self.rosters():
            for member in data.get("members", []):
                entries.append(
                    {
                        "cfg": cfg,
                        "team": data.get("name") or cfg.parent.name,
                        "leadSessionId": data.get("leadSessionId"),
                        "leadAgentId": data.get("leadAgentId"),
                        "member": member,
                        "ts": member.get("joinedAt") or data.get("createdAt") or mtime,
                    }
                )
        return entries

    def _scan_transcript(self, path):
        """(fields, last_activity_ms) from one session JSONL."""
        fields = {}
        try:
            mtime = int(path.stat().st_mtime * 1000)
        except OSError:
            return {}, 0  # the harness rewrites this tree while we read it
        last_ts = first_ts = 0
        headers = []
        cwds = []

        def put(key, value, ts):
            if value in (None, ""):
                return
            if key not in fields or ts >= fields[key][1]:
                fields[key] = (value, ts)

        try:
            handle = path.open(errors="replace")
        except OSError:
            return {}, mtime
        with handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                # A sidechain line is a subagent's record, not this conversation's evidence.
                if rec.get("isSidechain"):
                    continue
                ts = iso_ms(rec.get("timestamp"))
                if ts:
                    last_ts = max(last_ts, ts)
                    first_ts = first_ts or ts
                kind = rec.get("type")
                # header records carry no timestamp; stamp them with the first real one
                if kind == "agent-setting":
                    headers.append(("agentType", rec.get("agentSetting")))
                elif kind == "permission-mode":
                    headers.append(("permissionMode", rec.get("permissionMode")))
                elif kind == "mode":
                    headers.append(("mode", rec.get("mode")))
                for key in ("teamName", "agentName", "cwd", "version", "gitBranch", "effort"):
                    if rec.get(key) is None:
                        continue
                    if key == "agentName" and kind == "agent-name":
                        # The harness's label channel, not an identity stamp. Its
                        # value is a display name or a session title, and reading it
                        # as agentName is how a label reached --agent-name, got
                        # compared against rosters, and raised mismatch objections
                        # against agents that were never called that.
                        put("_label", rec[key], ts or mtime)
                        continue
                    put(key, rec[key], ts or mtime)
                if rec.get("cwd") and (not cwds or cwds[-1] != rec["cwd"]):
                    cwds.append(rec["cwd"])  # /cd moves it mid-session; keep the trail
                msg = rec.get("message")
                model = msg.get("model") if kind == "assistant" and isinstance(msg, dict) else None
                if model and not model.startswith("<"):
                    put("model", model, ts or mtime)  # skip "<synthetic>" error stubs

        for key, value in headers:
            put(key, value, first_ts or mtime)
        if cwds:
            fields["_cwds"] = (cwds, last_ts or mtime)  # underscore keys stay out of the merge
        return fields, (last_ts or mtime)

    def transcript_holders(self, session_uuid, table):
        """(others, ours): every live pid holding this conversation, split.

        Two halves of one question. procs_on_transcript excludes our own
        lineage so a search cannot match its own argv; self_holds_transcript
        is exactly that excluded remainder. Two consumers in one day
        consulted one half and misread the world, so the halves are no
        longer separately consultable: a caller takes both and visibly
        discards what it does not need.
        """
        return (self.procs_on_transcript(session_uuid, table),
                self.self_holds_transcript(session_uuid, table))

    def self_holds_transcript(self, session_uuid, table):
        """Are we ourselves the process holding this transcript?

        procs_on_transcript excludes our own lineage, because our argv quotes what
        we were asked to look for. That exclusion means an agent migrating itself
        never sees itself, so nothing is replaced and the launch becomes a second
        writer on one transcript, created by this tool.
        """
        mine = self._own_lineage(table)
        return [pid for pid, _, args in table
                if pid in mine and self.is_claude(args)
                and f"--resume {session_uuid}" in self._argv_pairs(args)]

    def session_registry(self):
        """Every ~/.claude/sessions/<pid>.json, parsed once. The registry is the
        only map from a transcript id to a live process, and two readers of it had
        already grown different ideas about liveness."""
        entries = []
        for path in SESSIONS_DIR.glob("*.json"):
            try:
                data = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if data.get("pid"):
                entries.append(data)
        return entries

    def configured_teammate_mode(self):
        """Which teammate backend ~/.claude/settings.json asks for, or None.

        The whole of the settings realm this tool reads. None covers both a
        file that says nothing and a file that cannot be read: neither is a
        substrate anybody has to be warned about, and a caller that had to
        tell them apart would be deciding from the settings file rather than
        from an answer about it.

        Writing the file is a different matter and stays outside: install_hook
        reads it, adds a hook and writes it back under its own rules.
        """
        try:
            return json.loads((CLAUDE_DIR / "settings.json").read_text()).get("teammateMode")
        except (OSError, ValueError):
            return None

    def socket_dir(self):
        """Where tmux keeps its socket files. A path question, like roster_path."""
        return Path(os.environ.get("TMUX_TMPDIR") or f"/tmp/tmux-{os.getuid()}")

    def socket_alive(self, socket):
        """Is a tmux server listening on this socket?

        One test, everywhere. A connect() answers it in microseconds; asking
        tmux costs a process spawn each time, and having two tests meant a
        socket could be 'dead' to the reaper and 'live' to the launcher.
        """
        path = socket if isinstance(socket, Path) else self.socket_dir() / socket
        probe = socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM)
        probe.settimeout(0.2)
        try:
            probe.connect(str(path))
            return True
        except (ConnectionRefusedError, FileNotFoundError):
            return False
        except OSError:
            return True  # ambiguous: assume live rather than reap or clobber
        finally:
            probe.close()

    def swarm_sockets(self):
        """Swarm socket files, newest first. The one place that directory is listed."""
        return sorted(self.socket_dir().glob(f"{SOCKET_PREFIX}*"),
                      key=lambda p: p.stat().st_mtime, reverse=True)

    def newest_live_socket(self):
        """The most recently touched swarm socket with a server behind it."""
        for path in self.swarm_sockets():
            if self.socket_alive(path):
                return path.name
        return None

    def dead_sockets(self):
        """Swarm socket files with no server behind them, and old enough to say so.

        A socket younger than the grace is not evidence of anything: a server
        mid-bind has a file and no listener yet, and reaping it takes the
        server's name out from under it. Age is the whole of the difference,
        so it is judged here rather than by whoever does the unlinking.
        """
        stale = []
        now = time.time()
        for path in self.swarm_sockets():
            try:
                if now - path.stat().st_mtime < SOCKET_GRACE_S:
                    continue
            except OSError:
                continue
            if not self.socket_alive(path):
                stale.append(path)
        return stale

    def swarm_session_live(self, socket):
        """Is the swarm session actually up on this socket? Server plus session:
        a live server with no claude-swarm session still needs one created."""
        return bool(socket) and self.socket_alive(socket) and tmux(
            socket, "has-session", "-t", TMUX_SESSION).returncode == 0

    def attached_clients(self, socket):
        """How many tmux clients are watching the swarm session on this socket."""
        result = tmux(socket, "list-clients", "-t", TMUX_SESSION)
        return len([line for line in result.stdout.splitlines() if line]) if result.returncode == 0 else 0

    def socket_state(self, socket):
        """What is actually true of this socket right now.

        The `how` label a caller carries only says where the name came from.
        Printed alone, a derived name reads as a running server that may
        already be gone.
        """
        if not socket:
            return "unresolved"
        # The state, not a promise: whether anything gets created is the
        # launch's to say, and a run that noops creates nothing.
        if not self.socket_alive(socket):
            return "no server"
        if not self.swarm_session_live(socket):
            return f"server up, no {TMUX_SESSION} session"
        clients = self.attached_clients(socket)
        return f"live, {clients} client{'' if clients == 1 else 's'} attached"

    def list_panes(self, socket):
        """Every pane on this server, as {session, window, pane, pid}.

        The one place tmux is asked what panes exist. A server that refuses
        the question has no panes to report, which is the same answer a
        server with none gives, and neither is a reason to guess.
        """
        res = tmux(socket, "list-panes", "-a", "-F",
                   "#{session_name}\t#{window_id}\t#{pane_id}\t#{pane_pid}")
        if res.returncode != 0:
            return []
        panes = []
        for line in res.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) == 4 and parts[3].isdigit():
                panes.append({"session": parts[0], "window": parts[1],
                              "pane": parts[2], "pid": int(parts[3])})
        return panes

    def pane_exists(self, socket, pane):
        """Is this pane id on this server right now?

        A pane id is per-server, so a remembered one means nothing until a
        server confirms it. Three callers had this same `any(...)` written
        out, which is three chances for one of them to answer differently.
        """
        return bool(pane) and any(p["pane"] == pane for p in self.list_panes(socket))

    def _descendants(self, root_pid, table):
        """Every pid under this one, from a table already in hand. A transform,
        not a reading: nothing here goes back to the process realm."""
        kids = defaultdict(list)
        for pid, ppid, _ in table:
            kids[ppid].append(pid)
        seen, stack = set(), [root_pid]
        while stack:
            pid = stack.pop()
            if pid in seen:
                continue
            seen.add(pid)
            stack.extend(kids.get(pid, []))
        return seen

    def pane_occupants(self, socket, pane_id, table):
        """(pane_exists, [(pid, args)] of claude processes running in it)."""
        by_pid = {pid: args for pid, _, args in table}
        for pane in self.list_panes(socket):
            if pane["pane"] != pane_id:
                continue
            procs = [(pid, by_pid.get(pid, "")) for pid in self._descendants(pane["pid"], table)]
            return True, [(pid, args) for pid, args in procs if self.is_claude(args)]
        return False, []

    def pane_of_pid(self, socket, pid, table):
        """Which pane on this server this process is sitting in, if any."""
        for pane in self.list_panes(socket):
            if pid in self._descendants(pane["pid"], table):
                return pane["pane"]
        return None

    def seat_note(self, recorded, socket):
        """(pane to aim at, pane line for the report), from a roster's memory.

        A pane id is per-server: a recorded one is a fact only while its server
        runs and still carries it. Anything else aims the launch at nothing and
        reads as a seat the agent does not have, so the report says what became
        of the record instead of echoing it. The two halves travel together for
        that reason: a caller handed only the id could print a seat nothing
        confirmed.
        """
        if self.pane_exists(socket, recorded):
            return recorded, recorded
        if recorded:
            return None, f"(none: recorded {recorded} is gone from {socket})"
        return None, "(none recorded)"

    def current_tmux(self):
        """(socket name, pane id) of the pane we are running in, or (None, None).

        $TMUX is "<socket path>,<server pid>,<session index>", so the socket we
        are inside is knowable without asking tmux anything.
        """
        inside = os.environ.get("TMUX")
        if not inside:
            return None, None
        return Path(inside.split(",")[0]).name, os.environ.get("TMUX_PANE")

    def inside_tmux(self):
        """Are we inside a tmux pane at all? The cheap half of current_tmux,
        for a caller that needs the yes or no and not the names."""
        return bool(os.environ.get("TMUX"))

    def _socket_from_pane_pid(self, pid, table):
        """A pane process's parent is the tmux server; its cmdline carries -L <socket>."""
        parents = {p: pp for p, pp, _ in table}
        ppid = parents.get(pid)
        if not ppid:
            return None
        match = re.search(r"-L\s+(\S+)", self._cmdline(ppid))
        return match.group(1) if match else None

    def crew_sockets(self, team, table):
        """{socket: [agent ids]} for every live server this team's crew sits on.

        Usually one. More than one is the split a revived lead produces by
        existing: a server is named after its lead's pid, so a lead that comes
        back with a new pid spawns onto a server its old crew is not on. The
        seat question wants the first (crew_socket); a report that claims one
        server while the crew is on two is the kind of half-answer this file
        keeps deleting, so it is asked and answered whole.
        """
        seats = {}
        for entry in sorted(self.live_sessions(), key=lambda e: e.get("agent") or ""):
            if entry.get("team") != team or not entry.get("agent"):
                continue
            sock, _why = self.socket_hosting([entry["agent"]], table)
            if sock:
                seats.setdefault(sock, []).append(entry["agent"])
        return seats

    def crew_socket(self, team, table):
        """(socket, why) for the server this team's crew is already sitting on.

        The crew is every agent wearing this team in argv, which is neither the
        roster's member list nor the resumed agent alone. A roster can miss a
        member that is running, and one agent is not a crew: asking only about
        itself sends a relaunched member to a server of its own while its
        siblings sit together, and asking only the roster misses whoever the
        roster never heard of.
        """
        if not team:
            return None, ""
        crew = sorted(e.get("agent") for e in self.live_sessions()
                      if e.get("team") == team and e.get("agent"))
        return self.socket_hosting(crew, table)

    def socket_hosting(self, agent_ids, table):
        """(socket, why) for the live server already hosting any of these agents.

        The one rung in the socket ladder backed by a running process instead of a
        name, which is why it comes first and why both callers have to be the same
        code. Answered separately, a team can be sent to a socket derived from its
        lead's pid while its members sit on another server entirely.
        """
        for agent_id in agent_ids:
            if not agent_id:
                continue
            for pid, _ in self.live_agent_procs(agent_id, table):
                sock = self._socket_from_pane_pid(pid, table)
                if sock and self.socket_alive(sock):
                    return sock, f"live pane of pid {pid}"
                if sock:
                    warn(f"pid {pid} looked like a pane on {sock}, but that server is gone")
        return None, None

    def _spawn_by_agent(self):
        """{"name@team": payload} for every teammate any lead ever spawned.

        A member's colour, agent type and full model live in the roster, and the
        roster dies with its team. The lead that spawned it recorded all three, so
        this is where they survive. Only the transcripts that mention a spawn are
        read, which is a fraction of the tree.
        """
        if self._by_agent is not None:
            return self._by_agent
        self._by_agent = {}
        leads = self._grep_files(SPAWN_MARKER, [self.projects_dir], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            for _, payload in self._log(path.stem):
                name, team = payload.get("name"), payload.get("team_name")
                if name and team:
                    self._by_agent[f"{name}@{team}"] = payload
        return self._by_agent

    def spawn_payload(self, agent_id, lead_session=None):
        """The harness's spawn record for an agent, wherever it survives.

        The single lookup for both the merge and the completion display, so an
        agent cannot be offered in one colour and launched in another. Cheap path
        first, the lead transcript the roster names; then the cross-file index,
        which is the only route once a team is named after a boot uuid whose
        transcript does not exist.
        """
        if not agent_id:
            return {}
        # Keyed on name and team together: a lead that respawns a name into a later
        # team holds a payload for each, and the name alone returns whichever came
        # last, which is the wrong life's colour and model.
        name, _, team = agent_id.partition("@")
        if lead_session and team:
            found = next((payload for payload in self.members_spawned_into(lead_session, team)
                          if payload.get("name") == name), None)
            if found:
                return found
        return self._spawn_by_agent().get(agent_id, {})

    def _spawn_records(self, lead_session):
        """{name: spawn payload} from the lead's transcript.

        Spawning a teammate writes the harness's whole payload into the lead's
        conversation: type, model with its [1m] suffix, color, pane id, prompt. That
        makes it the last-resort source for anything the roster would have held,
        and the only surviving one once a team dir is deleted, since no teammate
        transcript records its own color.
        """
        if not lead_session:
            return {}
        if lead_session in self._spawns:
            return self._spawns[lead_session]
        path = self.transcript_path(lead_session)
        self._ingest_spawn_lines([path] if path else [])
        return self._spawns.setdefault(lead_session, {})

    def stamp_index(self):
        """{path: (agentName, teamName)} for every stamped transcript, built once.

        Reads a bounded window of each file rather than grepping: every line carries
        the stamps, so the tail answers it, and the tail is also the *current* pair
        after a rebind. A file stamped only mid-history is missed here, which is why
        this powers path-only lookups and never resolution (verify=True greps whole
        files). Grep is the wrong tool for the index: -m1 exits early on stamped
        files but scans every byte of the unstamped ones, and this tree holds 2GB of
        those, which cost 1.7s per pass.

        `type: "agent-name"` lines are skipped. They carry a display label rather
        than an identity, and the label is free text: real ones on this machine
        include "resume agent dev old" and a whole sentence of task description.
        Matching bytes without regard to the record they sit in read those as the
        agent's name, so a transcript stamped team-lead on nine hundred lines
        answered with a title from one line at its tail, and everything downstream
        inherited it.
        """
        self._exercise(NEED.STAMPS)
        if self._stamps is not None:
            return self._stamps
        index, carried = {}, {}
        for path in self.projects_dir.glob("*/*.jsonl"):
            try:
                size = path.stat().st_size
                with path.open("rb") as handle:
                    tail_at = max(0, size - INDEX_CHUNK)
                    if tail_at:
                        handle.seek(tail_at)
                    tail = handle.read(INDEX_CHUNK)
                    stamps = _stamps_in(tail)
                    if not stamps and tail_at:  # a session stamped only after a resume
                        handle.seek(0)
                        stamps = _stamps_in(handle.read(INDEX_CHUNK))
            except OSError:
                continue
            # Off the same bytes, and recorded whether or not stamps were found:
            # a promoted transcript fabricates no stamps, which is precisely why
            # its membership needs asking for separately.
            found = self.carried_receipt(tail.decode("utf-8", "replace").splitlines())
            if found:
                carried[path] = found
            if stamps:
                index[path] = (
                    (stamps.get(b"agentName") or b"").decode("utf-8", "replace") or None,
                    (stamps.get(b"teamName") or b"").decode("utf-8", "replace") or None,
                )
        self._stamps, self._carried = index, carried
        return self._stamps

    def carried_receipts(self):
        """{path: receipt} for every transcript carrying its own conversion
        parameters. Built by the same pass and the same read as the stamps."""
        self.stamp_index()
        return self._carried

    def team_lead_session(self, team):
        """The session id a team names as its lead's, via the roster reader."""
        return next((e["leadSessionId"] for e in self.scan_teams() if e["team"] == team), None)

    def team_minted_by(self, pid):
        """(team, exact) for the implicit team this live process is running as.

        `exact` is False when only the mint-window join could answer, which is a
        heuristic and therefore never grounds for acting without being asked.

        Exact evidence first, because the mint timing is not one thing: a team is
        sometimes minted eagerly at boot (a few hundred ms before the session file)
        and sometimes at the first spawn, minutes later and outside the window in
        the wrong direction. Both shapes exist on this box, so the window join is
        only ever a last resort.
        """
        entry = next((e for e in self.live_sessions() if e["pid"] == pid), None)
        if entry:
            path = self.transcript_path(entry["session"]) if entry.get("session") else None
            team, exact, state = self.operative_team(path, entry.get("team"))
            if state == "restored":
                # Restore overrides flags: the stamped window-start is what
                # this life stamps, spawns into, and resolves as next time.
                # Idles still land on the worn team; worn_team answers that.
                return team, True
            if state == "orphaned, runs as nobody":
                # A mint record must not be read as the team an identity-less
                # session operates as.
                return None, False
        if entry and entry.get("team"):
            # A flag-bound lead states the team it runs as, in its own argv.
            return entry["team"], True
        if entry and entry.get("session"):
            # Every teammate this lead spawned wrote a payload naming the team it
            # was running as. Only payloads from THIS life count: a resumed lead
            # keeps appending to the same transcript, so an older life's payload
            # names a team this process no longer runs as, and rebinding onto it
            # would cause exactly the orphaning --to-team exists to prevent.
            started = entry.get("started")
            for stamp, payload in reversed(self._log(entry["session"])):
                # Without a start time there is no way to tell this life's payloads
                # from an earlier one's, so the rung declines rather than guessing.
                if payload.get("team_name") and started and stamp >= started:
                    return payload["team_name"], True
        # Structure before time. A fresh boot's team is derivable from its own
        # session id and confirmable against the roster, so it is exact. A
        # resumed life's minted id is generated at that boot and written
        # nowhere - not the transcript filename (that is the id it resumed
        # from), not the registry, not the roster - so its team is bounded by
        # shape and then, only within that bound, paired by boot timing. The
        # bound is what keeps a stranger's fresh-boot team out of the answer;
        # the residual is coverage, not ambiguity, since a team minted at the
        # first spawn falls outside any window centred on boot.
        pool, why = self.mint_candidates(pid)
        if why.startswith("its own"):
            return pool[0], True
        paired = self.sole_mint_pairing(pid)
        if paired:
            return paired, False
        return next((team for team, owner, _ in self._boot_join()
                     if owner == pid and team in pool), None), False

    def standing(self, agent_id, parent_session=None):
        """Where a member stands with its lead: parentage, liveness, team, mail.

        One composed answer, each part carrying the evidence it rests on. The
        parts existed already and every consumer composed them by hand, which is
        the same fault as two readers of one file: the engine answers, so the
        answers cannot disagree.

        Only structural records count as evidence of the team a session runs as.
        A team name appearing in a transcript's prose is this tool's own printed
        guess read back, and would corroborate itself.

        Parentage is not here: only the printed dossier renders it, so it is
        its own engine question (spawn_parent_of) that only --standing asks,
        and a caller consulting the verdict never buys the spawn corpus.
        """
        name, _, team = agent_id.partition("@")
        pid, alive, how, exact_lead = self.lead_pid(parent_session, team)
        lead_team, exact_team = self.team_minted_by(pid) if pid and alive else (None, False)
        roster = self.roster_of(lead_team) if lead_team else None
        members = [m for m in (roster or {}).get("members", []) if m.get("name") != "team-lead"]
        listed = any(m.get("agentId") == agent_id or m.get("name") == name for m in members)

        # A lead polls once it has members to poll for. A team holding only its
        # lead has no inboxes directory at all, so mail written there is read by
        # nobody however correctly it is addressed.
        # A lead polls from its own memory of the roster, and that memory is
        # updated by its own actions only: a roster written from outside never
        # reaches it. So a flag-bound lead is known to be reading, because it
        # read this file when it booted, and a plain one is not knowable from
        # here at all. Emptying its members stops the loop, and repopulating the
        # file does not start it again.
        worn = self.worn_team(pid)
        if not members:
            polls = (False, "the roster lists no members")
        elif worn:
            polls = (True, "its argv names the team, so it read this roster when it booted")
        else:
            polls = (None, "a plain lead reads its own memory of the roster, which a roster "
                           "written from outside does not reach")
        if not (pid and alive):
            reachable, why = False, f"no live lead for {team}"
            remedies = [("resume the lead", "starts a process")]
        elif lead_team and lead_team != team:
            reachable, why = False, (f"its lead is live but runs as {lead_team}, so mail sent "
                                     f"to {team} is read by nobody")
            remedies = [("--to-team live", "restarts this member, losing its in-flight turn")]
            if not exact_team:
                remedies.append(("ask before redirecting", "needs a terminal to ask at"))
        elif lead_team is None:
            reachable, why = False, ("its lead is live, but no structural record says which "
                                     "team it runs as, so where its mail is read is unknown")
            # Both ways to make a lead read, always together: a lead learns of
            # members only from its own spawns or a flag-bound boot, so writing
            # the roster from outside reaches nothing, and a remedy list naming
            # only the restart hides the fix that costs nothing.
            remedies = [("have the lead start any teammate",
                         "a spawn records the team it runs as and starts it "
                         "reading mail; immediate, costs nothing"),
                        ("resume the lead under its own identity",
                         "restarts it, and it then states its team in argv, at "
                         "the cost of its current turn")]
        elif not listed:
            reachable, why = False, (f"{lead_team} does not list it, so its lead has no record "
                                     "it exists")
            remedies = [("resume this member once", "a launch; it registers itself")]
            if polls[0] is False:
                why += "; that roster lists no members at all, so nothing is polled yet"
                remedies += [("have the lead start any teammate",
                              "it starts reading mail immediately; costs nothing"),
                             (f"resume the lead as team-lead@{lead_team}",
                              "restarts it with team flags; it reads the roster on "
                              "the way up and loses its current turn")]
        elif polls[0] is None:
            reachable, why = None, (f"listed in {lead_team}, but whether its lead is still "
                                    f"reading cannot be told from outside its process")
            remedies = [("have the lead start any teammate",
                         "it starts reading mail immediately; costs nothing"),
                        (f"resume the lead as team-lead@{lead_team}",
                         "restarts it with team flags; it reads this roster on "
                         "the way up and loses its current turn")]
        else:
            reachable, why = True, f"listed in {lead_team}, whose live lead polls it"
            remedies = []
        return {
            "agent_id": agent_id, "name": name, "team": team,
            "lead": (pid, alive, how, "exact" if exact_lead else "inferred"),
            "lead_team": (lead_team, "exact" if exact_team else
                          f"paired by a boot within {TEAM_MINT_WINDOW_MS}ms, not proven"),
            "polls": polls,
            "listed": listed,
            "reachable": (reachable, why),
            "remedies": remedies,
        }

    def spawn_parent_of(self, agent_id):
        """(stem, evidence) of the transcript whose spawn payload names this
        agent. The dossier's parentage line, asked only by the verb that
        prints it; the answer walks the spawn corpus, so it is a declared
        need of --standing and of nothing else."""
        parent = next((stem for stem, entries in self._every_log().items()
                       for _stamp, payload in entries
                       if payload.get("agent_id") == agent_id), None)
        return (parent, "spawn payload naming it" if parent
                else "no spawn payload names this agent")

    def teams_led_by(self, session_stem):
        """Teams this transcript led, newest first.

        A lead resumed several times mints a fresh implicit team each life and keeps
        appending to one transcript, so several teams can be named by one file. The
        newest is the one it was running as when it stopped.
        """
        led = self.led_teams()
        mine = [(stamp, team) for team, hits in led.items()
                for stamp, path in hits if path.stem == session_stem]
        mine.sort(reverse=True)
        return [team for _, team in mine]

    def transcript_path(self, session_uuid):
        hits = sorted(self.projects_dir.glob(f"*/{session_uuid}.jsonl"))
        if not hits:
            return None
        if len(hits) > 1:
            hits.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
            warn(f"{len(hits)} transcripts named {session_uuid}; using {hits[0]}")
        return hits[0]

    def transcript_title(self, session_uuid):
        """The displayable title of the transcript this id names, or None.

        The engine finds the file and reads its title in one answer, so a
        reporter renders sessions without ever touching the tree itself.
        """
        self._exercise(NEED.TITLES)
        path = self.transcript_path(session_uuid)
        return session_title(path, limit=90) if path else None

    def _walk_spawn_payloads(self, node, depth=0):
        """Yield genuine spawn payloads inside a parsed transcript line.

        Structure, never text. A payload the harness wrote is a dict in the
        record; the same JSON printed by a command or pasted into a message is a
        string, and parsing strings admits it as evidence. Measured on this
        machine: 199 payloads reached as dicts, and every string that parsed was
        one command's stdout quoting a payload back.
        """
        if depth > 10:  # deepest real payload seen is 5; leave room for another wrapper
            return
        if isinstance(node, dict):
            if node.get("status") == "teammate_spawned" and node.get("name"):
                yield node
            for value in node.values():
                yield from self._walk_spawn_payloads(value, depth + 1)
        elif isinstance(node, list):
            for value in node:
                yield from self._walk_spawn_payloads(value, depth + 1)

    def side_transcripts(self, parent=None):
        """Every side transcript on this machine, classified by its own bytes.

        A side transcript lives at <project>/<parent-session>/subagents/
        agent-<taskId>.jsonl, with an optional .meta.json beside it. The meta
        contributes a display name and an agent type and classifies nothing:
        this corpus holds a meta that says fork beside a file whose bytes are
        a rooted chain, and the file wins.

        Grammars, decided by the first record alone:
          pointer  line 1 is a fork-context-ref naming the parent, the leaf it
                   forked from, and a context length; history is by reference.
          rooted   the first record is a null-parent sidechain record with a
                   uuid; the chain carries its own history.
        Anything else is reported as what it is, never guessed at.
        """
        self._exercise(NEED.SIDES)
        out = self._side_listing(parent)
        for entry in out:
            entry["grammar"], entry["detail"], entry["root"] = \
                self._side_grammar(entry["path"])
        return out

    def _side_listing(self, parent=None):
        """The corpus by its cheap facts alone (path, parent, meta, mtime):
        side_transcripts without the classification, for the selector that
        narrows to a hit before anything reads bytes."""
        pattern = f"*/{parent or '*'}/subagents/agent-*.jsonl"
        out = []
        for path in sorted(self.projects_dir.glob(pattern)):
            try:
                mtime = int(path.stat().st_mtime * 1000)
            except OSError:
                continue
            entry = {"path": path, "parent": path.parent.parent.name,
                     "task_id": path.stem[len("agent-"):],
                     "name": None, "agent_type": None, "mtime": mtime}
            try:
                meta = json.loads(path.with_name(path.stem + ".meta.json").read_text())
                entry["name"] = meta.get("name")
                entry["agent_type"] = meta.get("agentType")
            except (OSError, ValueError):
                pass
            out.append(entry)
        return out

    def _side_grammar(self, path):
        """(grammar, detail, root) for one side transcript, from its first records.

        pointer -> the ref record itself; rooted -> the root uuid; either way
        `root` is the chain root's uuid (for a pointer fork, the null-parent
        record after the ref: 138 of 138 here carry one). unclassifiable ->
        a sentence naming what the first record actually is, root None.
        """
        self._exercise(NEED.SIDES)
        try:
            with path.open(errors="replace") as handle:
                first = handle.readline().strip()
                second = handle.readline().strip()
        except OSError as err:
            return "unclassifiable", f"unreadable ({err.__class__.__name__})", None
        if not first:
            return "unclassifiable", "the file is empty", None
        try:
            rec = json.loads(first)
        except ValueError:
            return "unclassifiable", "the first line is not JSON", None
        if rec.get("type") == "fork-context-ref":
            try:
                nxt = json.loads(second) if second else {}
            except ValueError:
                nxt = {}
            root = nxt.get("uuid") if nxt.get("parentUuid") is None else None
            return "pointer", rec, root
        if rec.get("parentUuid") is None and rec.get("isSidechain") is True and rec.get("uuid"):
            return "rooted", rec["uuid"], rec["uuid"]
        parent = "null" if rec.get("parentUuid") is None else "set"
        return "unclassifiable", (f"the first record is type={rec.get('type', '?')}, "
                                  f"parentUuid={parent}, isSidechain={rec.get('isSidechain')}"), None

    def side_transcript(self, selector):
        """One side transcript for a typed selector, or (None, why not).

        Accepted spellings: the task id, <parent-session-prefix>/<name>, a
        rooted file's root uuid, or a bare meta name that exactly one side
        transcript wears. Several matches are named and refused, never ranked.

        Classification is paid only where a spelling requires it: task ids
        and parent/name pairs match on the cheap facts and classify the hit
        alone; roots live in the bytes, so only that fallback (and the bare
        name behind it, to keep the spelling order exact) reads the corpus.
        """
        sides = self._side_listing()

        def classified(entry):
            entry = dict(entry)
            entry["grammar"], entry["detail"], entry["root"] = \
                self._side_grammar(entry["path"])
            return entry

        if "/" in selector:
            parent_part, _, name_part = selector.partition("/")
            hits = [e for e in sides if e["parent"].startswith(parent_part)
                    and name_part in (e["name"], e["task_id"])]
        else:
            hits = [e for e in sides if e["task_id"] == selector]
            if not hits:
                sides = [classified(e) for e in sides]
                hits = [e for e in sides if e["root"] == selector]
                hits = hits or [e for e in sides if e["name"] == selector]
        if not hits:
            return None, f"no side transcript matches {selector!r}"
        if len(hits) > 1:
            # A refusal names what it refused between, in spellings that can
            # actually be typed apart: when the pretty form collides, the
            # colliding candidates are named by task id instead.
            pretty = [f"{e['parent'][:8]}/{e['name'] or e['task_id']}" for e in hits]
            tallies = collections.Counter(pretty)
            named = [p if tallies[p] == 1 else f"{e['parent'][:8]}/{e['task_id']}"
                     for p, e in zip(pretty, hits)]
            shown = ", ".join(named[:6])
            more = f" and {len(hits) - 6} more" if len(hits) > 6 else ""
            return None, f"{len(hits)} side transcripts match {selector!r}: {shown}{more}"
        hit = hits[0]
        return (hit if "grammar" in hit else classified(hit)), ""

    # -- side transcript <-> teammate conversion: the engine plans, proves the
    #    inverse, and never writes; materialize/embed consume a proved plan.

    @staticmethod
    def _codec_load(raw):
        """(record, dump style) for one line, or (None, why).

        A line is convertible only when one dump form reproduces its bytes,
        because the round-trip proof is a byte comparison: a line the codec
        cannot reproduce untouched cannot be proved restored either.
        """
        try:
            rec = json.loads(raw)
        except ValueError:
            return None, "is not JSON"
        for style, kwargs in (("compact", {"separators": (",", ":")}), ("spaced", {})):
            if json.dumps(rec, ensure_ascii=False, **kwargs) == raw:
                return (rec, style), None
        return None, "has bytes no dump form reproduces"

    @staticmethod
    def _codec_dump(rec, style):
        kwargs = {"separators": (",", ":")} if style == "compact" else {}
        return json.dumps(rec, ensure_ascii=False, **kwargs)

    @staticmethod
    def _insert_after(rec, anchor, key, value):
        """The record with key set right after anchor, harness key order."""
        out = {}
        for k, v in rec.items():
            out[k] = v
            if k == anchor:
                out[key] = value
        if key not in out:
            out = {key: value, **rec}
        return out

    def _convert(self, raws, direction, receipt):
        """(out_lines, objections) - one edit set, applied forward or backward.

        `receipt` is both the record of a promote and the parameters of the
        demote that undoes it: the forward pass fills it, the backward pass
        consumes it, so the two directions cannot drift apart. The fields a
        conversion may touch are closed (sessionId, isSidechain, the root's
        logicalParentUuid, the ref line, last-prompt trailers, in that
        vocabulary and no other); a line whose transform would need any other
        field is an objection, not an edit.
        """
        objections, parsed = [], []
        for n, raw in enumerate(raws, 1):
            loaded, why = self._codec_load(raw)
            if loaded is None:
                objections.append(f"line {n} {why}")
                continue
            parsed.append((n, raw) + loaded)
        if objections:
            return None, objections

        parent, dest = receipt["parent"], receipt["dest_stem"]
        out = []
        if direction == "promote":
            root_uuid = receipt.get("root")
            inserted = set(receipt.get("inserted_sidechain") or [])
            for n, raw, rec, style in parsed:
                if rec.get("type") == RECEIPT_RECORD:
                    # A receipt left behind by an earlier cycle, which the
                    # growth rule kept. It is content now, not vocabulary.
                    out.append(raw)
                    continue
                if (n == 1 and receipt["grammar"] == "pointer"
                        and rec.get("type") == "fork-context-ref"):
                    receipt["ref"] = raw
                    continue
                new = dict(rec)
                extra = ()
                if new.get("sessionId") == parent:
                    new["sessionId"] = dest
                if new.get("uuid") in inserted and new.get("isSidechain") is True:
                    # The demote being undone put this field here; remove it
                    # rather than flip it, or the round trip grows a field.
                    new.pop("isSidechain")
                elif new.get("isSidechain") is True:
                    new["isSidechain"] = False
                if (receipt["grammar"] == "pointer" and receipt.get("ref")
                        and new.get("uuid") == root_uuid):
                    graft = json.loads(receipt["ref"])["parentLastUuid"]
                    new = self._insert_after(new, "parentUuid", "logicalParentUuid", graft)
                    receipt["graft"] = graft
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(f"line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            if receipt.get("stripped"):
                # Undoing a demote: the harness's own trailers come back
                # verbatim where they sat; a fresh one would forge history.
                for pos, raw in receipt["stripped"]:
                    out.insert(pos, raw)
            else:
                leaf = next((json.loads(line).get("uuid") for line in reversed(out)
                             if '"uuid"' in line and json.loads(line).get("uuid")), None)
                if leaf is None:
                    objections.append("no record carries a uuid, so there is no leaf")
                # The text the resume picker shows: the window's last user
                # message, as the harness itself would have recorded it.
                said = next((_prompt_text(rec) for _n, _raw, rec, _s in reversed(parsed)
                             if rec.get("type") == "user" and _prompt_text(rec)), "")
                trailer = {"type": "last-prompt", "lastPrompt": said,
                           "leafUuid": leaf, "sessionId": dest}
                out.append(json.dumps(trailer, separators=(",", ":"), ensure_ascii=False))
                receipt["trailer"] = out[-1]
            # Last, after the trailer the harness needs, so that a demote with
            # nothing in between finds it where it left it. Undoing a demote is
            # the exception: a file promoted before transcripts carried their
            # own parameters had no such line, and the inverse restores bytes
            # rather than improving on them.
            if receipt.get("in_file", True):
                out.append(receipt.get("carried_raw") or self._receipt_line(receipt))
        else:
            trailers, inserted = [], []
            last_n = parsed[-1][0] if parsed else None
            consumed = False
            for n, raw, rec, style in parsed:
                if rec.get("type") == RECEIPT_RECORD:
                    # Ours, and only consumed while it is still the file's last
                    # line. Anywhere else it is a line this conversion did not
                    # author, so it rides through untouched rather than being
                    # re-keyed or given a sidechain field it never had.
                    if n == last_n and receipt.get("undo", True):
                        # Only going back where it came from is an undo, and
                        # only an undo consumes the record. Kept verbatim
                        # rather than re-derived, the way the ref line and the
                        # trailers are, since rebuilding it from fields would
                        # rebuild it from ones this demote may have changed.
                        consumed, receipt["carried_raw"] = True, raw
                        continue
                    out.append(raw)
                    continue
                if rec.get("type") == "last-prompt":
                    # Positions count earlier trailers too, so the undo can
                    # reinsert sequentially and land every line where it sat.
                    trailers.append((len(out) + len(trailers), raw))
                    continue
                new = dict(rec)
                extra = ()
                if new.get("sessionId") == dest:
                    new["sessionId"] = parent
                if new.get("isSidechain") is False:
                    new["isSidechain"] = True
                elif "isSidechain" not in new:
                    anchor = ("logicalParentUuid" if "logicalParentUuid" in new
                              else "parentUuid")
                    new = self._insert_after(new, anchor, "isSidechain", True)
                    if new.get("uuid"):
                        inserted.append(new["uuid"])
                if receipt.get("graft") and new.get("logicalParentUuid") == receipt["graft"]:
                    new.pop("logicalParentUuid")
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(f"line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            if receipt.get("ref"):
                out.insert(0, receipt["ref"])
            receipt["stripped"] = trailers
            receipt["inserted_sidechain"] = inserted
            receipt["in_file"] = consumed
        return out, objections

    def _carries_uuid(self, stem, uuid):
        """Whether that session's transcript holds an entry with this uuid.

        The question a fork's by-reference prefix turns on, asked the cheap
        way: the loader needs the entry to exist before it can walk from it,
        and a substring hit is enough to know it does not.
        """
        path = self.transcript_path(stem) if stem else None
        if not path:
            return False
        try:
            return f'"{uuid}"' in path.read_text(errors="replace")
        except OSError:
            return False

    @staticmethod
    def _receipt_line(receipt):
        """The trailing record a promoted transcript carries about itself."""
        carried = {k: receipt[k] for k in RECEIPT_KEYS if receipt.get(k) is not None}
        return json.dumps({"type": RECEIPT_RECORD, "receipt": carried},
                          separators=(",", ":"), ensure_ascii=False, sort_keys=True)

    @staticmethod
    def carried_receipt(raws):
        """The transform parameters a promoted file carries, when they are still
        its last line, else None.

        Last means last. Once the harness has written anything past it the
        record is history rather than this file's undo, and the conversion
        treats it as any other line it did not author.
        """
        if not raws:
            return None
        try:
            rec = json.loads(raws[-1])
        except ValueError:
            return None
        if not isinstance(rec, dict) or rec.get("type") != RECEIPT_RECORD:
            return None
        carried = rec.get("receipt")
        return carried if isinstance(carried, dict) else None

    @staticmethod
    def _edit_closure(before, after, extra=()):
        """The first field outside the conversion vocabulary, or None.

        `extra` widens the vocabulary for one record when a conversion needs
        it, and nothing else ever does.
        """
        allowed = {"sessionId", "isSidechain", "logicalParentUuid", *extra}
        for key in set(before) | set(after):
            if key in allowed:
                continue
            if before.get(key, _MISSING) != after.get(key, _MISSING):
                return key
        return None

    def conversion_plan(self, source, direction, into=None, dest=None, stored=None,
                        identity=None):
        """The full plan for one conversion, proved before anyone acts on it.

        Answers only: edit set (as the rendered lines), receipt, objections,
        and the destination path. Every plan computes its own inverse in
        memory and byte-compares against the source; a plan whose inverse
        cannot be proved carries the objection and no writer may apply it.
        """
        source = Path(source)
        try:
            text = source.read_text(errors="strict")
        except (OSError, UnicodeDecodeError) as err:
            return {"objections": [f"unreadable source: {err}"], "proved": False}
        raws = text.split("\n")
        if raws and raws[-1] == "":
            raws.pop()

        if direction == "promote":
            grammar, detail, root = self._side_grammar(source)
            if grammar == "unclassifiable":
                return {"objections": [f"not convertible: {detail}"],
                        "proved": False}
            parent = source.parent.parent.name
            receipt = {"grammar": grammar, "parent": parent, "root": root,
                       "dest_stem": dest or root,
                       "task_id": source.stem[len("agent-"):]}
            if identity:
                # Before the line is rendered, not after: until a launch
                # registers this member the transcript is the only thing that
                # says who it is.
                receipt["name"], receipt["team"] = identity
            meta = source.with_name(source.stem + ".meta.json")
            try:
                receipt["meta"] = meta.read_text()
            except OSError:
                receipt["meta"] = None
            out, objections = self._convert(raws, "promote", receipt)
            dest_path = source.parent.parent.parent / f"{receipt['dest_stem']}.jsonl"
        else:
            # The file's own trailing record first: it describes these bytes,
            # travels with them, and answers even when the receipts directory
            # is gone. The stored one still answers for anything promoted
            # before transcripts carried their own.
            carried = self.carried_receipt(raws)
            stored = dict(stored or {})
            if carried is not None:
                # The file's own record is the whole truth about these fields,
                # not a set of defaults to fill gaps in. A stored receipt can
                # carry values the line never had, and rendering those back
                # would emit bytes the source never contained.
                for key in RECEIPT_KEYS:
                    stored.pop(key, None)
                stored.update(carried)
            into = into or stored.get("parent")
            # Going back where it came from is the undo, and undoes to the
            # original bytes. Anywhere else is a move, and the record of the
            # promote survives it, because a move is not an undo.
            undo = carried is None or into == carried.get("parent")
            # A fork inherits its prefix by reference, and the harness resolves
            # that reference against the session the ref names rather than the
            # directory the file sits in. Land it somewhere that does not carry
            # the referenced entry and it wakes with an empty prefix and a line
            # in a log nobody reads, so the same lookup happens here, before the
            # move, where it can still be refused.
            ref_raw = stored.get("ref")
            if ref_raw and not undo:
                try:
                    ref = json.loads(ref_raw)
                except ValueError:
                    ref = {}
                anchor, from_session = ref.get("parentLastUuid"), ref.get("parentSessionId")
                # Against the session the ref names, which a move does not
                # change, and never against the destination: where the file
                # sits is not an input to the loader. The move is safe while
                # that session still holds the entry, and the project
                # directory cannot change here, since a demote builds its
                # destination under the source's own.
                if anchor and not self._carries_uuid(from_session, anchor):
                    return {"objections": [
                        f"this fork inherits its context by reference from "
                        f"{from_session}, which no longer carries {anchor}; moving "
                        f"it would leave that prefix unresolvable"], "proved": False}
            if not into:
                return {"objections": ["demote needs the parent session (--into)"],
                        "proved": False}
            receipt = {"grammar": stored.get("grammar", "rooted"), "parent": into,
                       "dest_stem": source.stem,
                       "task_id": dest or stored.get("task_id") or source.stem,
                       "root": stored.get("root"), "meta": stored.get("meta"),
                       "undo": undo}
            for carried in ("ref", "graft", "inserted_sidechain", "name", "team"):
                if stored.get(carried):
                    receipt[carried] = stored[carried]
            out, objections = self._convert(raws, "demote", receipt)
            dest_path = (self.projects_dir / source.parent.name / into / "subagents"
                         / f"agent-{receipt['task_id']}.jsonl")

        proved = False
        if out is not None and not objections:
            back, back_obj = self._convert(
                list(out), "demote" if direction == "promote" else "promote",
                dict(receipt))
            if back_obj:
                objections.append(f"the inverse raises its own objections: {back_obj[0]}")
            else:
                proved = back == raws
                if not proved:
                    objections.append("the inverse does not restore the source bytes")

        return {"direction": direction, "source": source, "dest_path": dest_path,
                "lines": out, "receipt": receipt, "objections": objections,
                "proved": proved}




_MISSING = object()


RESOLVER = Resolver()




def hook_event():
    """The SessionStart payload on stdin, or None when there is nothing to read.

    A hook is handed its event on stdin; the same flag run by hand is not, and
    reading unconditionally would hang the janitor on a terminal.
    """
    if sys.stdin is None or sys.stdin.closed or sys.stdin.isatty():
        return None
    try:
        if not select.select([sys.stdin], [], [], 0.25)[0]:
            return None
        return json.loads(sys.stdin.read() or "null")
    except (OSError, ValueError):
        return None


# What a revived pane needs from the lead's environment. The harness's swarm
# server is started BY the leader, so its panes inherit these; a server we start
# does not, because tool subprocesses have the credentials scrubbed. A new
# server inherits them from us; topping up an existing one puts the value on a
# transient tmux client argv, which is why that path only runs for variables the
# server is actually missing.
AUTH_ENV = ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")
# The traffic variable's name reads like a preference, so it invites being
# dropped from this set as "not a credential". It belongs: when the credential
# arrives as an OAuth access token in the environment rather than from a normal
# login, it has to travel with the token, so the two move together or neither
# works. The report calls the whole set creds for that reason.
INHERIT_ENV = AUTH_ENV + ("CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",)




def inherit_credentials(ctx):
    """Adopt the lead's credentials into our own env, so a tmux server we spawn
    passes them to its panes exactly as a harness-spawned server would.

    The lead pid comes from the ~/.claude chain (roster -> leadSessionId ->
    session registry), not from our process ancestry."""
    pid, alive, _, _exact = RESOLVER.lead_pid(RESOLVER.field(ctx, "parentSessionId"), RESOLVER.field(ctx, "teamName"))
    if not (pid and alive):
        return []
    adopted = []
    for key, value in RESOLVER.proc_env(pid, INHERIT_ENV).items():
        if not os.environ.get(key):
            os.environ[key] = value
            adopted.append(key)
    # Only shout when the revived agent would have no way to authenticate at
    # all. The usual setup keeps credentials in a file, and the traffic flag is
    # optional, so warning about either on every run trains you to ignore a tool
    # that kills things.
    if not any(os.environ.get(key) for key in AUTH_ENV) and not (CLAUDE_DIR / ".credentials.json").exists():
        warn("no auth env var on this lead and no ~/.claude/.credentials.json; "
             "the revived agent will have nothing to authenticate with")
    return sorted(adopted)


# ---------------------------------------------------------------- disk scanners





TITLE_RE = re.compile(rb'"type":"(ai|custom)-title","(?:aiTitle|customTitle)":"((?:[^"\\]|\\.)*)"')
TAG_RE = re.compile(r"</?[a-zA-Z][a-zA-Z0-9_-]*[^>]*>")

# roster color -> ANSI SGR, for colorizing completion candidates
COLOR_ANSI = {
    "red": "31", "green": "32", "yellow": "33", "blue": "34", "purple": "35",
    "magenta": "35", "cyan": "36", "orange": "38;5;208", "pink": "38;5;205",
}

# The harness's titler sometimes echoes an agent name instead of titling,
# and repeats it down the file. Real ai titles are natural language, so
# any whitespace-free ai title is treated as absent; this set catches multiword
# junk. Custom titles are exempt: the user typed those deliberately.
JUNK_TITLES = {"new session"}


def _json_str(raw):
    try:
        return json.loads('"' + raw.decode("utf-8", "replace") + '"')
    except ValueError:
        return raw.decode("utf-8", "replace")


def _first_user_message(head_lines):
    for line in head_lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") != "user" or rec.get("isMeta"):
            continue
        content = (rec.get("message") or {}).get("content")
        if isinstance(content, list):
            content = next((c.get("text") for c in content if isinstance(c, dict) and c.get("type") == "text"), None)
        if not isinstance(content, str) or content.startswith("Caveat:"):
            continue
        if any(tag in content for tag in ("<command-name>", "<local-command-caveat>", "<local-command-stdout>")):
            continue  # slash-command records wear a user hat but title nothing
        text = TAG_RE.sub(" ", content).strip()  # unwrap teammate-message/command tags
        if text:
            return text
    return None


def session_title(path, limit=60):
    """Newest custom title, else newest ai title, else the first real user message.

    Titles are rewritten throughout the file, so the tail almost always holds
    the current one; only title-less files pay for a head read.
    """
    def pick(found):
        for kind in (b"custom", b"ai"):
            raw = found.get(kind)
            if not raw:
                continue
            text = " ".join(_json_str(raw).split())
            if not text:
                continue
            if kind == b"ai" and (" " not in text or text.lower() in JUNK_TITLES):
                continue  # name echo, not a title
            return text
        return None

    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            fh.seek(max(0, size - TITLE_TAIL_BYTES))
            found = {}
            for match in TITLE_RE.finditer(fh.read()):
                found[match.group(1)] = match.group(2)  # last of each kind wins
            title = pick(found)
            if not title:
                had_records = bool(found)
                fh.seek(0)
                head = fh.read(TITLE_HEAD_BYTES).decode("utf-8", "replace")
                if not had_records:  # a junk newest title makes older ones suspect too
                    for match in TITLE_RE.finditer(head.encode()):
                        found[match.group(1)] = match.group(2)
                    title = pick(found)
                if not title:
                    title = _first_user_message(head.splitlines())
    except OSError:
        return None
    if not title:
        return None
    title = " ".join(re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", title).split())
    return title[: limit - 3] + "..." if len(title) > limit else title


UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)




# ------------------------------------------------------- transcript resolution
#
# One engine. Every caller that needs "which transcript is this agent" goes
# through RESOLVER.resolve_transcript(); nothing else may pick a file. Each rung records
# how it concluded, and the strength of that evidence, so callers can report it
# and the identity gate can judge the conclusion without re-deriving it.

EXACT, STAMPS, NAME_ONLY = 3, 2, 1


class Resolution:
    """A chosen transcript plus how it was chosen. `path` None means no evidence."""

    def __init__(self, path=None, fields=None, last_ts=0, via="", strength=0, others=(), reason=""):
        self.path, self.fields, self.last_ts = path, fields or {}, last_ts
        self.via, self.strength, self.others, self.reason = via, strength, list(others), reason

    def __bool__(self):
        return self.path is not None

    def stamped(self, key):
        return self.fields.get(key, (None,))[0]


def lead_title(team_entries, team, limit=60):
    """Title for a team: its lead's session title, via the roster's leadSessionId."""
    for entry in team_entries:
        if entry["team"] == team and entry.get("leadSessionId"):
            res = RESOLVER.resolve_transcript(lead_session=entry["leadSessionId"], team=entry.get("team"),
                                     is_lead=True, quick=True)
            return session_title(res.path, limit) if res else None
    return None




def flatten_cwd(cwd):
    """A cwd's project dir name. Every non-alphanumeric becomes '-' (verified
    against 70 of this machine's project dirs). Lossy, so it has no inverse."""
    return re.sub(r"[^a-zA-Z0-9]", "-", cwd)














def enter_agent_cwd(ctx, prefix=""):
    """Move this process into the agent's directory before exec, and say so.

    Every path that execs rather than spawning a pane comes through here: the
    lead taking the foreground, and a member run in the pane you are already
    standing in. The pane paths carry the same answer as tmux's -c, so
    RESOLVER.agent_cwd() decides the directory once and only the mechanism differs.

    Unifying it is what keeps the two from drifting: they had different answers
    to entering failing, to announcing the move, and to there being no recorded
    directory at all, none of which is a property of the mechanism.
    """
    where = RESOLVER.agent_cwd(ctx)
    if not where or os.path.realpath(where) == os.path.realpath(os.getcwd()):
        return where
    print(f"{prefix}cd       {where}")
    try:
        os.chdir(where)
    except OSError as exc:
        die(f"cannot enter {where}: {exc}")
    return where








def build(args):
    """The identity for this run, and the one place that knows flags exist.

    The engine is handed facts, never args, so that who an agent is cannot come
    to depend on how the question was spelled. It judges but does not act: the
    objections come back with the answer, and a caller enforces them at the
    point it is about to act. Enforcing here would refuse launches that never
    happen, since the guards that turn a run into a noop sit further down.
    """
    return RESOLVER.identity(session_uuid=args.resume, agent_id=args.agent_id,
                             for_team=getattr(args, "for_team", None), to_team=args.to_team,
                             keep_team=getattr(args, "keep_team", False))


def enforce_ctx(ctx, args):
    """The identity gate, at the boundary where this run starts acting."""
    enforce_identity(ctx["resolution"], ctx["objections"],
                     allow_team_change=bool(args.to_team), force=args.force)
    enforce_restore(ctx, args)


def enforce_restore(ctx, args):
    """Refuse a rebind, and name a launch, that restore would override.

    A launch onto a transcript whose window-start stamps name a team with a
    loadable roster runs as that team whatever the flags say: lines and
    spawns follow the stamped team, idle notifications follow the worn one,
    and both teams' inboxes are polled. A --to-team rebind into that state
    undoes itself at every restart, and no appended entry can fix it: one
    with a null parent is what restore reads but truncates the window to
    itself (compact-style amnesia), one that chains preserves the window
    and is never read. Restore-visibility and window-preservation are
    mutually exclusive for appended entries, so the durable
    conversation-preserving rebind is upstream work, not a graft.
    """
    path = getattr(ctx["resolution"], "path", None)
    if not path:
        return
    stamped, state = RESOLVER.restored_identity(path)
    if state != "restored":
        return
    # The comparison is against the DESTINATION: the merged teamName echoes
    # the stamps for a stamped transcript, so comparing it to the restored
    # team compares the stamps to themselves.
    rebind = ctx.get("to_team") if ctx.get("to_team") not in (None, "live", "auto") else None
    dest = rebind or RESOLVER.field(ctx, "teamName")
    if not dest or stamped == dest:
        return
    if rebind and not args.force:
        die(f"this conversation comes back as {stamped} whatever the flags say, "
            f"so a rebind onto {dest} undoes itself at the next restart. "
            f"--force launches it anyway, split between the two teams")
    warn(f"this conversation comes back as {stamped} whatever the flags say, so "
         f"this launch runs split: it writes its history as {stamped}, sends "
         f"idle notifications and messages as {dest}, and reads both teams' mail")


def already_running(ctx, args, is_lead, agent_id=None, table=None, here=(), pane=None):
    """(why, report) for a run that must not act, or None. One step, both paths.

    A lead must not be exec'd and a member must not be spawned onto a
    conversation someone is already running: the acts differ, the precondition
    does not. The shared core is the registry's owner of this transcript,
    which is the only witness either way, since an in-process lead runs as
    bare `claude` with no --agent-id to match. A member extends it with the
    two questions only a seat raises: is it in the pane we meant to use, and
    is it running under this id somewhere else.

    `report` marks the benign case - an agent already sitting where it was
    asked to sit is the run working, so it is said in the report's grammar
    rather than warned about.

    One asymmetry, preserved rather than invented: an explicit --to-team
    exempts all three, because that path kills the holder deliberately, while
    a redirect chosen by the tool exempts only the owner and elsewhere pair.
    A redirect never runs when anything is alive, so the seat question keeps
    its say.
    """
    if args.force:
        return None
    migrating = bool(ctx.get("to_team")) and not ctx.get("auto_redirect")
    if not is_lead and here and not migrating:
        return (f"{agent_id} is already running in pane {pane} "
                f"(pid {here[0]}{RESOLVER.state_note(here[0])})", True)
    if not is_lead and ctx.get("to_team"):
        return None
    owner = RESOLVER.lead_pid_for(ctx["session_uuid"])
    if owner and owner[2]:
        # Where that process actually sits, asked of the process rather than
        # echoed from a roster: a member can be live outside tmux entirely.
        where = ""
        if not is_lead and agent_id and table is not None:
            sock, s_why = RESOLVER.socket_hosting([agent_id], table)
            where = f", in a {s_why} on {sock}" if sock else ", outside any tmux pane"
        return (f"session {ctx['session_uuid']} is live as pid {owner[0]}"
                f"{RESOLVER.state_note(owner[0])}{where}; pass --force to run a second copy", False)
    if not is_lead and agent_id:
        live = RESOLVER.live_agent_procs(agent_id, table)
        elsewhere = [pid for pid, _ in live if pid not in here]
        if elsewhere:
            return (f"{agent_id} is already running outside pane {pane or '?'} "
                    f"(pid {', '.join(map(str, elsewhere))}); pass --force to "
                    "start another instance", False)
    return None


def noop_outcome(ctx, args, prefix, why, socket=None, is_lead=False, pane=None,
                 report=False):
    """A run that stops without launching: say why, register, state, return.

    Every site that stops without launching comes through here. The parts
    are not optional and forgetting one is invisible: a noop that skips
    registration leaves a running member unrecorded while reading as though
    it will re-register. One spelling, so no site can arrive with a piece
    missing.
    """
    # An agent already sitting where it was asked to sit is the run working,
    # not a hazard, so that one says so in the report's own grammar.
    print(fill(f"{prefix}noop     {why}")) if report else warn(why)
    if not is_lead:
        record_membership(ctx, args, pane)
    note_identity(ctx, prefix)
    return Outcome("noop", socket, is_lead, None)


def note_identity(ctx, prefix=""):
    """State the objections without acting on them, for a run that stops here.

    A noop launches nothing, so there is nothing for the gate to protect and a
    refusal would be friction reported as a fact. The contradiction is still
    worth saying, because it is true and the reader may be looking at it.
    """
    for kind, stamped, wanted, _why in ctx.get("objections", ()):
        if kind == "team_mismatch":
            warn(f"{prefix}note: this transcript is stamped team={stamped}, not {wanted}; "
                 "it is live under that identity regardless")
        elif kind == "name_mismatch":
            warn(f"{prefix}note: this transcript is stamped agentName={stamped!r}, "
                 f"not {wanted!r}; it is live under that identity regardless")




def enforce_identity(res, objections, allow_team_change, force):
    """Act on what identity_objections found. Disposition, not judgement.

    A process launched with --agent-id X wearing Y's conversation is the worst
    outcome this tool can produce, so a contradiction stops the run unless the
    caller has said otherwise.
    """
    for kind, stamped, wanted, why in objections:
        if kind == "unstamped_below_exact":
            message = (f"{res.path.name} carries no agent stamps and was matched by {why}; "
                       "only an exact session id may claim an unstamped transcript")
            if not force:
                die(f"{message} (--force to override)")
            warn(f"--force: {message}")
        elif kind == "name_mismatch":
            why, _, corroborated = why.partition("|")
            message = (f"{res.path.name} is stamped agentName={stamped!r}, not {wanted!r} "
                       f"(matched by {why})")
            if corroborated:
                # The roster and the payloads agree on the identity being asked for,
                # so the stamp is the odd one out. Two shapes produce that and the
                # remedy is the same, but the diagnosis is not: a launch that carried
                # the wrong name, or a session that was a teammate first and was
                # later resumed into leading a team. The second has an honest past,
                # so naming only the first would accuse it of damage it does not
                # have. Both are stated and neither is assumed.
                message += (f"; the roster and the spawn payloads both say {wanted!r}, so the "
                            f"stamp is either a launch that carried the wrong name or this "
                            f"session's earlier life as a teammate")
            if not force:
                die(f"{message}. --force resumes it as {wanted!r}, and the lines it writes "
                    f"from then on are stamped correctly")
            warn(f"--force: {message}; resuming as {wanted!r}")
        elif kind == "team_mismatch":
            why, _, newer = why.partition("|")
            if allow_team_change or why == "tolerated":
                warn(f"{res.path.name} is stamped team={stamped}, resuming as {wanted}")
            elif not force:
                message = (f"{res.path.name} is stamped team={stamped}, not {wanted} "
                           f"(matched by {why})")
                if newer:
                    message += (f"; the payloads naming {wanted} were written after those "
                                f"stamps, so --force ratifies the newer evidence rather than "
                                f"overriding the older")
                die(f"{message}; --force to override")
            else:
                warn(f"--force: {res.path.name} is stamped team={stamped}, resuming as {wanted}")


def apply_selector(token, args, table):
    """Turn the bare argument into --resume, --agent-id or --team.

    The engine decides what the token is; this sets the flag and does the talking.
    An ambiguous name is refused here rather than in the engine because the
    refusal is worth annotating with who is running, which is presentation.
    """
    kind, value, why = RESOLVER.classify(token)

    if kind == "uuid":
        if args.resume and args.resume != token:
            die(f"conflicting sessions: {token} and --resume {args.resume}")
        args.resume = token
    elif kind == "agent_id":
        if args.agent_id and args.agent_id != value:
            die(f"conflicting agents: {token} and --agent-id {args.agent_id}")
        args.agent_id = value
    elif kind == "team":
        # Asked here because a bare token is only known to be a team once the
        # engine has classified it; asking earlier reads a flag nobody set.
        if getattr(args, "here", False):
            die(f"--here gives this terminal to one agent, and {token} covers "
                "every member of it; name the one agent to run here")
        if why != "a roster on disk":
            print(f"team     {token} has no roster on disk; rebuilding it from {why}")
        args.team = token
    elif kind == "name":
        warn(f"no team config lists {token!r}; {why}")
        args.resume = value.path.stem
    elif kind == "ambiguous":
        warn(f"{token!r} is {why}, so it names nobody; pick one:")
        for entry in value:
            agent_id = entry["member"].get("agentId")
            procs = RESOLVER.live_agent_procs(agent_id, table)
            state = f"running{RESOLVER.state_note(procs[0][0])}" if procs else "not running"
            warn(f"    {agent_id:<44} joined {ms_str(entry['ts'])}  [{state}]")
        die("pass one of those ids, or a session uuid")
    else:
        die(f"{token} {why}")










def resolve_to_team(args, ctx):
    """--to-team live -> the team this agent's own lead is currently running as.

    Pure ~/.claude hops, no process tree: the agent's roster names its lead
    session, the session registry maps that to a live pid, and that pid's boot
    timestamp identifies the team it minted.
    """
    if args.to_team not in ("live", "auto"):
        if not RESOLVER.has_roster(args.to_team):
            die(f"no team config at {RESOLVER.roster_path(args.to_team)}")
        return args.to_team

    source = RESOLVER.field(ctx, "teamName")
    pid, alive, how, _exact = RESOLVER.lead_pid(RESOLVER.field(ctx, "parentSessionId"), source)
    if not (pid and alive):
        die(f"no live lead for team {source}; pass --to-team <name> explicitly")
    dest, _ = RESOLVER.team_minted_by(pid)
    if not dest:
        die(f"cannot tell which team pid {pid} runs as; pass --to-team <name> explicitly")
    print(f"rebind   {how}, now running as team {dest}")
    return dest






























