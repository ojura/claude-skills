@unit(('holder-kill-one-site', 'a process is asked to stop in one place, and waited for there'))
def _check_holder_kill_one_site(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    callers_of = s.callers_of
    funcs = s.funcs
    lead_rebind = funcs["lead_rebind"]
    run_one = s.run_one_node

    def ends_a_process(node):
        """Whether this function hands `kill` a pid, however the argv is spelled."""
        for sub in ast.walk(node):
            if not (isinstance(sub, ast.Call) and sub.args
                    and isinstance(sub.args[0], ast.List) and sub.args[0].elts):
                continue
            first = sub.args[0].elts[0]
            if isinstance(first, ast.Constant) and first.value == "kill":
                return True
        return False

    # stopped() sends the signal and waits; end_holder is the one route a
    # move takes to it, through kill_holder for a migration and a lead move and
    # through settle_stops for a team run, and abort_agents is --stop, the verb
    # that does nothing but end processes, which asks its own question of a
    # list before it ends anything. Everything else reaches a process through
    # one of those.
    killers = {n for n, node in funcs.items() if ends_a_process(node)}
    reached = callers_of("kill_holder") - s.suite_fns
    ended_by = callers_of("end_holder") - s.suite_fns
    settled_by = callers_of("settle_stops") - s.suite_fns
    asked_to_stop = callers_of("stopped") - s.suite_fns
    sites = []
    if killers != {"stopped"}:
        sites.append("a process is ended in " + (", ".join(sorted(killers)) or "nowhere"))
    if asked_to_stop != {"abort_agents", "end_holder"}:
        sites.append("stopped is asked by " + (", ".join(sorted(asked_to_stop)) or "nobody"))
    if ended_by != {"kill_holder", "settle_stops"}:
        sites.append("end_holder is asked by " + (", ".join(sorted(ended_by)) or "nobody"))
    if reached != {"apply_member_migration", "clear_lead_holder"}:
        sites.append("reached from " + (", ".join(sorted(reached)) or "nowhere"))
    if settled_by != {"apply_team_redirect"}:
        sites.append("a team run's stops are settled from "
                     + (", ".join(sorted(settled_by)) or "nowhere"))
    run_calls = {part.func.id for part in ast.walk(run_one)
                 if isinstance(part, ast.Call) and isinstance(part.func, ast.Name)}
    lead_calls = {part.func.id for part in ast.walk(lead_rebind)
                  if isinstance(part, ast.Call) and isinstance(part.func, ast.Name)}
    if "apply_member_migration" not in run_calls:
        sites.append("the member migration does not reach the holder action")
    if "clear_lead_holder" not in lead_calls:
        sites.append("the lead move does not reach the holder action")
    check("holder-kill-one-site", "a process is asked to stop in one place, and waited for there",
          not sites, ", ".join(sites))
    return checked


