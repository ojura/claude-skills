    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    tempfile = s.tempfile

    with tempfile.TemporaryDirectory() as td:
        home, parent = Path(td) / "work", "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
        moved = "5ee5ee5e-e5ee-45ee-85ee-e5ee5ee5ee5e"
        proj = Path(td) / "projects" / flatten_cwd(str(home))
        proj.mkdir(parents=True)
        # The session it came from: it ran in the directory this project dir is
        # named after, and later somewhere else, so "newest that fits" is what
        # the answer has to be and not "the newest" or "the first".
        (proj / f"{parent}.jsonl").write_text("\n".join(fixture_line(rec) for rec in (
            {"type": "user", "uuid": "pa-1", "parentUuid": None, "sessionId": parent,
