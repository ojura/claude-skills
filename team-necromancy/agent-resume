@unit(('sweep-shared-remedy-once', 'the sweep states a shared remedy explanation once'))
def _check_sweep_shared_remedy_once(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    _Args = s._Args
    corpus_engine = s.corpus_engine

    def flat(text):
        return " ".join(text.split())
    doctor_team = "session-corpus-alpha"
    real_resolver = globals()["RESOLVER"]
    globals()["RESOLVER"] = eng = corpus_engine()
    eng._session_registry = lambda: []
    eng._process_table = lambda refresh=False: []
    try:
        wanted = collections.defaultdict(set)
        for team in sorted(eng._known_teams()):
            for _what, cost in diagnose_team(eng._team_diagnosis(team))[2]:
                wanted[cost].add(team)
        with capturing("out") as swept_doc:
            run_doctor(_Args(team=None, agent_id=None, all_members=True))
        with capturing("out") as named_doc:
            run_doctor(_Args(team=doctor_team, agent_id=None,
                             resume=None, all_members=False))
    finally:
        globals()["RESOLVER"] = real_resolver
    swept_flat, named_flat = flat(swept_doc.getvalue()), flat(named_doc.getvalue())
    twice = sorted(c for c in wanted if swept_flat.count(flat(c)) != 1)
    shared_remedy = {
        # Without this the rule passes over a fixture where nothing repeats,
        # which is the one case it is not about.
        "the fixture repeats the named team's act": any(
            len(who) > 1 and doctor_team in who for who in wanted.values()),
        "the sweep says each explanation once": not twice,
        "a named team still explains itself in full": any(
            f"({flat(cost)})" in named_flat
            for cost, who in wanted.items() if doctor_team in who),
    }
    wrong = sorted(k for k, ok in shared_remedy.items() if not ok)
    check("sweep-shared-remedy-once", "the sweep states a shared remedy explanation once",
          not wrong, ", ".join(wrong) + (f"; repeated: {twice}" if twice else ""))

    s.eng = eng
    s.flat = flat
    s.swept_doc = swept_doc
    s.team = team
    return checked


@unit(('sweep-remedy-tied-to-its-explanation', "each swept block's remedy says which shared explanation it means"))
def _check_sweep_remedy_tied_to_its_explanation(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    swept_doc = s.swept_doc

    joined = []
    for line in swept_doc.getvalue().splitlines():
        # fill() hangs a continuation under the label; nothing that starts a
        # line here is indented that far.
        if joined and line.startswith("     "):
            joined[-1] += " " + line.strip()
        else:
            joined.append(line)
    remedy_lines = [ln for ln in joined if ln.startswith("  remedy   ")]
    at = next((n for n, ln in enumerate(joined) if ln.startswith("remedies")), None)
    region = [ln for ln in joined[at + 1:] if ln.startswith("  ")] if at is not None else []
    letters = re.compile(r"^  ([A-Z]|S\d+)  \S")
    defined = {m.group(1) for m in map(letters.match, region) if m}
    used = {m.group(1) for m in
            (re.search(r"\(([A-Z]|S\d+)\)$", ln.rstrip()) for ln in remedy_lines) if m}
    tied = {
        # Two blocks asking the same act is what the letters are for, and a
        # fixture without one would pass this rule by never testing it.
        "the fixture shares a remedy": len(defined) > 0,
        "several shared explanations open with the same command": len(
            {ln.split("  ")[2] for ln in region if letters.match(ln)}) < len(defined),
        "every letter a block carries is defined below": used <= defined,
        "every letter defined below is carried by a block": defined <= used,
        "no remedy line is left without one or the other": all(
            ln.rstrip().endswith(")") for ln in remedy_lines),
    }
    wrong = sorted(k for k, ok in tied.items() if not ok)
    check("sweep-remedy-tied-to-its-explanation",
          "each swept block's remedy says which shared explanation it means",
          not wrong, ", ".join(wrong) + f"; defined {sorted(defined)}, used {sorted(used)}")
    return checked


@unit(('census-and-doctor-count-the-same-teams', "the census total and the sweep's population are the same set"))
