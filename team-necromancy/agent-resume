    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    def _row(said, *kinds, pid=None):
        return {"pid": pid, "kinds": frozenset(kinds), "said": said}

    def grouped(lines):
        """(bullets, headings, the heading each bullet arrived under)."""
        opened, opener = [], None
        for line in lines:
            if line.startswith("- "):
                opened.append(opener)
            else:
                opener = line
        return ([each for each in lines if each.startswith("- ")],
                [each for each in lines if not each.startswith("- ")], opened)

    real_reap_obj = RESOLVER._reap_objections
    RESOLVER._reap_objections = lambda team, table, archive_mail=False, census=None: (
        [_row(f"{n} unread for member{n}, oldest 2026-08-06 15:33:30", "mail")
         for n in range(1, 7)]
        + [_row(f"pid {PID_CEILING + 4242} runs as it (someone@somewhere)", "wears",
                pid=PID_CEILING + 4242),
           _row(f"pid {PID_CEILING + 4244} operates as it (fixture)", "operates",
                pid=PID_CEILING + 4244)])
    # A live process holding the conversation a forced rewrite would change.
    holding = ((PID_CEILING + 4246, 1, (FAKE_AGENT_BIN, "--resume", "transcript")),)
    try:
        plan = RESOLVER._rebind_plan(
            "session-blocked", "destination", Path("/nowhere/transcript.jsonl"),
            (), census=(), force=False)
        blocked = reap_blockers(plan)
        forced_plan = RESOLVER._rebind_plan(
            "session-blocked", "destination", Path("/nowhere/transcript.jsonl"),
            holding, census=(), force=True)
        forced = reap_blockers(forced_plan)
    finally:
        RESOLVER._reap_objections = real_reap_obj
    bullets, headings, opened = grouped(blocked)
    forced_bullets, forced_headings, forced_opened = grouped(forced)
    itemized = {
        "one objection per bullet": bullets and not any(
            "; " in each for each in bullets + forced_bullets),
        "every class keeps its way out": len(headings) == 2
            and any("--with-mail" in each for each in headings)
            and any("--force" in each for each in headings),
        "the way out is above its group": all(opened)
            and all("--with-mail" in (h or "") for h in opened[:5])
            and all("--force" in (h or "") for h in opened[5:]),
        # Holding is the strict remedy: --force rewrites a file in place, and
        # it cannot do that under a live writer.
        "a holder of the conversation is asked to be stopped": forced_plan["action"] == "blocked"
            and len(forced_headings) == 1 and "stop it first" in forced_headings[0]
            and any(str(PID_CEILING + 4246) in each for each in forced_bullets) and all(forced_opened),
        "a bounded list says what it dropped": any("and 2 more" in each for each in bullets),
        "nothing else rode along": len(blocked) == len(bullets) + len(headings)
            and len(forced) == len(forced_bullets) + len(forced_headings)
            and len(forced_bullets) == 1,
    }
    wrong = sorted(k for k, ok in itemized.items() if not ok)
    check("blockers-listed-with-remedy", "blockers arrive one per line, each group under its way out",
          not wrong, ", ".join(wrong))

    return checked


