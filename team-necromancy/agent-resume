@unit(("fixture-line-one-spelling", "a fixture transcript's records are written one way"))
def _check_fixture_line_one_spelling(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("fixture_line")
    if not owner:
        forked.append("fixture_line is gone, so nothing says how a fixture writes a record")
    else:
        # The record goes to fixture_line and comes back as the line a .jsonl
        # file holds: one record, no spaces, and nothing added.
        made = fixture_line({"type": "user", "uuid": "x"})
        if made != '{"type":"user","uuid":"x"}' or "\n" in made:
            forked.append(f"a record comes back as {made!r}")

    # A json.dumps carrying separators inside a unit is a unit spelling the
    # line itself. The product's three sites are outside the units and pass
    # ensure_ascii=False, which is a different call for a different job: a
    # conversion hands back the bytes it was given, and a fixture here has no
    # non-ASCII to hand back.
    units = [(node.lineno, node.end_lineno or node.lineno, node.name)
             for node in ast.walk(tree) if isinstance(node, ast.FunctionDef)
             and any(isinstance(dec, ast.Call) and getattr(dec.func, "id", None) == "unit"
                     for dec in node.decorator_list)]
    for node in ast.walk(tree):
        if not (isinstance(node, ast.Call) and getattr(node.func, "attr", None) == "dumps"
                and any(word.arg == "separators" for word in node.keywords)):
            continue
        inside = [name for first, last, name in units if first <= node.lineno <= last]
        if inside:
            forked.append(f"{inside[0]} spells a fixture line itself at line {node.lineno}")
    check("fixture-line-one-spelling", "a fixture transcript's records are written one way",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(("refusal-carries-its-reason", "a refusal is its own signal and says what it refused"))
def _check_refusal_carries_its_reason(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    if "Refusal" not in {node.name for node in ast.walk(tree)
                         if isinstance(node, ast.ClassDef)}:
        forked.append("Refusal is gone, so a refusal is somebody else's exception again")
    elif "die" not in funcs:
        forked.append("die is gone, so nothing raises one")
    else:
        # Put to die itself: what a refusal carries, and that it is not the
        # kind of exception a broad catch around a call is allowed to take.
        with capturing("err") as said:
            try:
                die("the reason", 3)
            except Refusal as refused:
                got = (refused.said, refused.code, said.getvalue().strip().endswith("the reason"))
            except BaseException as exc:
                got = f"{type(exc).__name__} instead"
        if got != ("the reason", 3, True):
            forked.append(f"die answers {got}, not its reason, its code and having said it")
        if issubclass(Refusal, Exception):
            forked.append("a refusal is an Exception, so a broad catch around a call swallows one")

        # A refusal is raised as one and caught as one. ran_unit is the
        # exception: it catches whatever ends a unit, and something that is not
        # a refusal is still worth naming there.
        for node in ast.walk(tree):
            if not (isinstance(node, ast.ExceptHandler) and node.type is not None):
                continue
            named = ([node.type.id] if isinstance(node.type, ast.Name)
                     else [getattr(part, "id", "") for part in node.type.elts]
                     if isinstance(node.type, ast.Tuple) else [])
            if "SystemExit" not in named:
                continue
            holder = sorted((fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                            for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)
                            and fn.lineno <= node.lineno <= (fn.end_lineno or fn.lineno))
            where = holder[-1][2] if holder else "<module>"
            if where != "ran_unit":
                forked.append(f"{where} catches SystemExit at line {node.lineno}, "
                              "where a refusal now arrives as a Refusal")

        # And the exit itself is one call, outside every function, so a refusal
        # cannot be turned into a code anywhere but at the end of the run.
        exits = [node.lineno for node in ast.walk(tree)
                 if isinstance(node, ast.Call)
                 and getattr(node.func, "attr", None) == "exit"
                 and getattr(node.func.value, "id", None) == "sys"]
        inside = [line for line in exits
                  if any(fn.lineno <= line <= (fn.end_lineno or fn.lineno)
                         for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef))]
        if len(exits) != 1 or inside:
            forked.append(f"sys.exit is called at {exits}, {len(inside)} of them inside a function")
    check("refusal-carries-its-reason", "a refusal is its own signal and says what it refused",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(
    ("output-taken-one-way", "this process's own output is taken in one place"),
    ("live-runner-takes-both-streams",
     "the live runner checks stdout and stderr for output between verdicts"),
    ("live-share-stderr-reported",
     "a split live run reports stderr from every worker"),
)
def _check_output_taken_one_way(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("capturing")
    # The redirects capturing reaches for, read off its own body, then looked
    # for everywhere else. A block that redirects a stream itself is a second
    # place deciding where this process's output goes.
    reaches = {node.attr for node in (ast.walk(owner) if owner else ())
               if isinstance(node, ast.Attribute) and node.attr.startswith("redirect_")}
    if not owner:
        forked.append("capturing is gone, so nothing owns where the output goes")
    elif not reaches:
        forked.append("capturing redirects nothing, so there is no spelling to hold")
    else:
        # Put to capturing itself: what it takes, what it hands back, what it
        # leaves alone, and that a stream it does not know is refused rather
        # than quietly captured nowhere.
        with capturing("out") as said:
            print("taken")
        with capturing("err") as grumbled:
            print("also taken", file=sys.stderr)
        kept = io.StringIO()
        with capturing("out", into=kept):
            print("into the caller's own")
        for asked, got, want in (("out", said.getvalue(), "taken\n"),
                                 ("err", grumbled.getvalue(), "also taken\n"),
                                 ("into", kept.getvalue(), "into the caller's own\n")):
            if got != want:
                forked.append(f"capturing {asked} gives {got!r}, not {want!r}")
        try:
            with capturing("stdout"):
                pass
        except ValueError:
            pass
        else:
            forked.append("a stream capturing does not know is taken anyway")

        spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                 for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
        for node in ast.walk(tree):
            if not (isinstance(node, ast.Attribute) and node.attr in reaches):
                continue
            if owner.lineno <= node.lineno <= (owner.end_lineno or owner.lineno):
                continue
            inside = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
            forked.append(f"{inside[-1][2] if inside else '<module>'} redirects a "
                          f"stream itself at line {node.lineno}")
    check("output-taken-one-way", "this process's own output is taken in one place",
          not forked, "; ".join(sorted(set(forked))[:3]))

    real_live_checks = globals()["live_checks"]

    def noisy_live_checks(_share=None, _child=None):
        rows, register = check_rows()
        print("stdout between verdicts")
        print("stderr between verdicts", file=sys.stderr)
        return rows, register

    report, leaked = io.StringIO(), io.StringIO()
    try:
        globals()["live_checks"] = noisy_live_checks
        with capturing("out", into=report), capturing("err", into=leaked):
            noise_code = run_selftest(live=True, failed_only=True)
    finally:
        globals()["live_checks"] = real_live_checks
    runner_took_both = (noise_code == 1 and not leaked.getvalue()
                        and "live-checks-say-nothing-mid-run" in report.getvalue()
                        and "2 line(s)" in report.getvalue())
    check("live-runner-takes-both-streams",
          "the live runner checks stdout and stderr for output between verdicts",
          runner_took_both,
          f"exit={noise_code}, leaked={leaked.getvalue()!r}, report={report.getvalue()!r}")

    parallel = funcs.get("_live_in_parallel")
    stderr_reported = bool(parallel and any(
        isinstance(call, ast.Call)
        and isinstance(call.func, ast.Attribute)
        and getattr(call.func.value, "id", None) == "short"
        and call.func.attr == "append"
        and any(isinstance(part, ast.Name) and part.id == "worker_err"
                and isinstance(part.ctx, ast.Load)
                for arg in call.args for part in ast.walk(arg))
        for call in ast.walk(parallel)))
    check("live-share-stderr-reported",
          "a split live run reports stderr from every worker",
          stderr_reported,
          "_live_in_parallel does not put worker stderr in its failure detail"
          if not stderr_reported else "")
    return checked


@unit(("context-handover-is-taken", "every name a suite context hands over is read by something"))
def _check_context_handover_is_taken(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    tree = s.tree

    # Every name put on the shared namespace against every name read back off
    # it. A context computes what the units need and a unit publishes back what
    # a later one takes, so a name stored and never loaded is a handover nobody
    # takes: the value is computed, carried and dropped, and no linter says so
    # because the store is an attribute on a live object and the name is bound.
    stored, read = {}, set()
    for node in ast.walk(tree):
        if not (isinstance(node, ast.Attribute)
                and isinstance(node.value, ast.Name) and node.value.id == "s"):
            continue
        if isinstance(node.ctx, ast.Store):
            stored.setdefault(node.attr, node.lineno)
        else:
            read.add(node.attr)
    dropped = [f"s.{attr} is handed over at line {line} and nothing reads it"
               for attr, line in sorted(stored.items(), key=lambda pair: pair[1])
               if attr not in read]

    # What the sweep above cannot see, and the arm that keeps it from narrowing
    # in silence. It matches s.<name> as written, so it is right only while
    # every read of the namespace is spelled that way. getattr(s, name),
    # vars(s) and s.__dict__ each read a name without writing one, and a name
    # reached by any of the three would be called dead here while it was in
    # use. None of the three is in this file; if one arrives, this says so and
    # whoever added it decides what the sweep should do about it, rather than
    # the sweep quietly answering for less than it says.
    blind = []
    for node in ast.walk(tree):
        if (isinstance(node, ast.Call)
                and getattr(node.func, "id", None) in ("getattr", "vars")
                and node.args and isinstance(node.args[0], ast.Name)
                and node.args[0].id == "s"):
            blind.append(f"{node.func.id}(s, ...) at line {node.lineno}, "
                         "which the sweep cannot follow")
        if (isinstance(node, ast.Attribute) and node.attr == "__dict__"
                and isinstance(node.value, ast.Name) and node.value.id == "s"):
            blind.append(f"s.__dict__ at line {node.lineno}, "
                         "which the sweep cannot follow")

    forked = blind + dropped
    check("context-handover-is-taken",
          "every name a suite context hands over is read by something",
          not forked, "; ".join(forked[:3]))
    return checked


@unit(("check-registration-one-owner", "registering a check means one thing in every tier"))
def _check_check_registration_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("check_rows")
    if not owner:
        forked.append("check_rows is gone, so nothing says what registering means")
    else:
        # check_rows is called here and given two rows, then the first id a
        # second time. What comes back in its list, and what it raises on the
        # repeat, is the answer.
        rows, register = check_rows()
        register("one", "the first", True, "")
        register("two", "the second", False, "why")
        if rows != [("one", "the first", True, ""), ("two", "the second", False, "why")]:
            forked.append(f"a registered row comes back as {rows}")
        try:
            register("one", "the first again", True, "")
        except RuntimeError:
            pass
        else:
            forked.append("one id registers twice and nothing is said")

        # refusal holds the message check_rows raises on a repeat, taken out of
        # the raise in its own body. Any string literal outside check_rows
        # containing that message is a second refusal.
        refusal = next((piece.value for node in ast.walk(owner)
                        if isinstance(node, ast.Raise)
                        for piece in ast.walk(node)
                        if isinstance(piece, ast.Constant)
                        and isinstance(piece.value, str) and piece.value.strip()), None)
        if not refusal:
            forked.append("check_rows refuses nothing, so there is no refusal to hold")
        else:
            spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                     for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
            for node in ast.walk(tree):
                if not (isinstance(node, ast.Constant) and isinstance(node.value, str)):
                    continue
                if refusal not in node.value:
                    continue
                if owner.lineno <= node.lineno <= (owner.end_lineno or owner.lineno):
                    continue
                inside = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
                forked.append(f"{inside[-1][2] if inside else '<module>'} refuses a "
                              f"duplicate itself at line {node.lineno}")

    # run_selftest, live_checks and _live_in_parallel each have to call
    # check_rows, and none of them may append to the list check_rows handed
    # back: a row put in that way was never registered and no id rule ever saw
    # it. run_selftest takes its rows from whichever of the other two ran, so a
    # call anywhere in the expression it assigns from counts.
    reaches = s.callers_of("check_rows")
    handers = ("check_rows", "live_checks", "_live_in_parallel")
    for named in ("run_selftest", "live_checks", "_live_in_parallel"):
        node = funcs.get(named)
        if not node:
            forked.append(f"{named} is gone, so a tier this holds together is not here")
            continue
        if named not in reaches:
            forked.append(f"{named} does not reach check_rows")
        held = {target.elts[0].id for sub in ast.walk(node)
                if isinstance(sub, ast.Assign)
                and any(isinstance(part, ast.Call)
                        and getattr(part.func, "id", None) in handers
                        for part in ast.walk(sub.value))
                for target in sub.targets
                if isinstance(target, ast.Tuple) and target.elts
                and isinstance(target.elts[0], ast.Name)}
        if not held:
            forked.append(f"{named} does not take a register back with its rows")
        for sub in ast.walk(node):
            if (isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
                    and sub.func.attr in ("append", "extend")
                    and getattr(sub.func.value, "id", None) in held):
                forked.append(f"{named} puts a row in without registering it, "
                              f"at line {sub.lineno}")
    check("check-registration-one-owner", "registering a check means one thing in every tier",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(("team-layout-one-owner", "what a team directory holds is named in one place"))
def _check_team_layout_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owners = ("team_dir", "roster_in", "inboxes_in")
    # named_parts collects whatever roster_in and inboxes_in each join onto the
    # directory they are given, which is "config.json" and "inboxes". Point one
    # of them at a different file and the search below moves to that one.
    named_parts = set()
    for named in owners:
        node = funcs.get(named)
        if not node:
            forked.append(f"{named} is gone, so nothing answers where that is")
            continue
        named_parts |= {sub.right.value for sub in ast.walk(node)
                        if isinstance(sub, ast.BinOp) and isinstance(sub.op, ast.Div)
                        and isinstance(sub.right, ast.Constant)
                        and isinstance(sub.right.value, str)}
    if funcs.get("roster_in") and funcs.get("inboxes_in") and len(named_parts) < 2:
        forked.append("the roster and the mailboxes are not named apart, so there "
                      "is nothing to hold the rest of the file to")

    if not forked:
        # Each row calls the engine twice and compares the two paths:
        # roster_path("crew") against roster_in(team_dir("crew")), and so on.
        # No path is spelled out here.
        eng = s.corpus_engine()
        for named, got, want in (
                ("roster_path", eng.roster_path("crew"), eng.roster_in(eng.team_dir("crew"))),
                ("inbox_path", eng.inbox_path("crew", "mate").parent,
                 eng.inboxes_in(eng.team_dir("crew"))),
                ("team_dir", eng.team_dir("crew").parent, eng.teams_dir)):
            if got != want:
                forked.append(f"{named} lands at {got}, not {want}")

    # Every other `something / "config.json"`, `something / "inboxes"` and
    # `teams_dir / something` in the file. The suite is left out: its fixtures
    # build the directories the engine then has to find, so they write the
    # layout out.
    spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
             for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
    tops = [(node.lineno, node.end_lineno or node.lineno, node.name) for node in tree.body
            if isinstance(node, (ast.FunctionDef, ast.ClassDef))]
    for node in ast.walk(tree):
        if not (isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div)):
            continue
        inner = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
        outer = [top for top in tops if top[0] <= node.lineno <= top[1]]
        where = inner[-1][2] if inner else "<module>"
        if (outer and outer[0][2] in s.suite_fns) or where in owners:
            continue
        if isinstance(node.right, ast.Constant) and node.right.value in named_parts:
            forked.append(f"{where} joins {node.right.value!r} onto a path at line {node.lineno}")
        elif isinstance(node.left, ast.Attribute) and node.left.attr == "teams_dir":
            forked.append(f"{where} builds a team's directory at line {node.lineno}")
    check("team-layout-one-owner", "what a team directory holds is named in one place",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(("implicit-team-shape-one-owner", "one place says what a lazily minted team is named after"))
def _check_implicit_team_shape_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("implicit_team_block")
    pattern = next((arg.value for node in (ast.walk(owner) if owner else ())
                    if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                    and getattr(node.func.value, "id", None) == "re"
                    for arg in node.args[:1]
                    if isinstance(arg, ast.Constant) and isinstance(arg.value, str)), None)
    if not owner:
        forked.append("implicit_team_block is gone, so nothing owns the shape")
    elif not pattern:
        forked.append("implicit_team_block matches nothing, so there is no shape to hold")
    else:
        # implicit_team_block is called on four team names and every answer
        # compared: one the harness minted, one that merely starts like a
        # minted one, one a --team-name flag gave, and no team at all.
        for asked, got, want in (
                ("a minted name", implicit_team_block("session-a52cb2af"), "a52cb2af"),
                ("a minted name with more after it",
                 implicit_team_block("session-a52cb2af-two"), None),
                ("a name a flag gave", implicit_team_block("crew"), None),
                ("no team at all", implicit_team_block(None), None)):
            if got != want:
                forked.append(f"{asked} answers {got!r}, not {want!r}")

        # pattern holds implicit_team_block's own regex, taken a few lines up
        # out of the re.fullmatch call in its body. Any other string literal in
        # this file containing that regex is a second copy of the rule.
        # Parentheses are dropped from both sides, so r"session-([0-9a-f]{8})"
        # and r"session-[0-9a-f]{8}" count as the same text.
        def bare(text):
            return "".join(ch for ch in text if ch not in "()")

        spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                 for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
        for node in ast.walk(tree):
            if not (isinstance(node, ast.Constant) and isinstance(node.value, str)):
                continue
            if bare(pattern) not in bare(node.value):
                continue
            inside = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
            where = inside[-1][2] if inside else "<module>"
            if where != owner.name:
                forked.append(f"{where} writes the shape again at line {node.lineno}")

        # Eight hex characters are not a session id, and what a match on them
        # is worth is one judgement. session_names_team makes it;
        # sessions_naming and registry_entries_naming carry it to the two
        # corpora a team name is looked for in, and classify wants the shape
        # and nothing else. Anybody else holding the raw block is matching
        # names to sessions on its own account.
        asks = s.callers_of("implicit_team_block") - s.suite_fns
        extra = asks - {"session_names_team", "sessions_naming",
                        "registry_entries_naming", "classify"}
        if extra:
            forked.append("the block is handed out to " + ", ".join(sorted(extra)))
        for named in ("session_names_team", "sessions_naming", "registry_entries_naming"):
            if named not in funcs:
                forked.append(f"{named} is gone, so a caller has to match names itself")
    check("implicit-team-shape-one-owner",
          "one place says what a lazily minted team is named after",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(("agent-id-spelled-one-way", "an agent id comes apart and goes together in one place"))
def _check_agent_id_spelled_one_way(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    owners = ("name_and_team", "agent_id_of")
    forked = [f"{named} is gone, so nothing owns how an id is spelled"
              for named in owners if named not in funcs]
    if not forked:
        # agent_id_of builds the id, name_and_team takes it apart again, and
        # the four rows compare what those two say against what they were
        # given. No spelling of "mate@session-1234abcd" is written out here.
        built = agent_id_of("mate", "session-1234abcd")
        for asked, got, want in (
                (f"{built} taken apart", name_and_team(built), ("mate", "session-1234abcd")),
                ("an id with no team", name_and_team("mate"), ("mate", None)),
                ("an id with no name", name_and_team("@crew"), (None, "crew")),
                ("no id at all", name_and_team(None), (None, None))):
            if got != want:
                forked.append(f"{asked} answers {got}, not {want}")

    # A second spelling anywhere else, in either direction: .split("@"),
    # .partition("@") and their r-forms, and any f-string whose text runs up to
    # an "@" and then substitutes, which is both f"{name}@{team}" and
    # f"team-lead@{team}". The suite is left out: its fixtures write the ids a
    # roster really holds and its assertions read the ids a launch really
    # emitted, so both spell them out.
    spread = []
    for node in tree.body:
        if not isinstance(node, (ast.FunctionDef, ast.ClassDef)):
            continue
        if node.name in s.suite_fns or node.name in owners:
            continue
        for sub in ast.walk(node):
            if (isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
                    and sub.func.attr in ("split", "rsplit", "partition", "rpartition")
                    and sub.args and isinstance(sub.args[0], ast.Constant)
                    and sub.args[0].value == "@"):
                spread.append(f"{node.name} cuts an id apart at line {sub.lineno}")
            if not isinstance(sub, ast.JoinedStr):
                continue
            for at, piece in enumerate(sub.values[:-1]):
                if (isinstance(piece, ast.Constant) and isinstance(piece.value, str)
                        and piece.value.endswith("@")
                        and isinstance(sub.values[at + 1], ast.FormattedValue)):
                    spread.append(f"{node.name} builds an id at line {sub.lineno}")
    forked += sorted(set(spread))
    check("agent-id-spelled-one-way", "an agent id comes apart and goes together in one place",
          not forked, "; ".join(forked[:3]))
    return checked


@unit(("check-line-one-owner", "a check reads the same way wherever it is printed"))
def _check_check_line_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # One place puts a check's id next to its name. Anything assembling both
    # fields itself is a second spelling, and the three renderings move
    # together only while there is one.
    ast = s.ast

    printers = set()
    for fnode in ast.walk(s.tree):
        if not isinstance(fnode, ast.FunctionDef) or fnode.name == "check_line":
            continue
        for piece in ast.walk(fnode):
            if not isinstance(piece, ast.JoinedStr):
                continue
            filled = {getattr(v.value, "id", None) for v in piece.values
                      if isinstance(v, ast.FormattedValue)}
            if {"cid", "name"} <= filled or {"cid", "said"} <= filled:
                printers.add(fnode.name)
    check("check-line-one-owner", "a check reads the same way wherever it is printed",
          not printers, ", ".join(sorted(printers)))
    return checked


def run_selftest(live=False, failed_only=False, list_only=False, jobs=1, share=None,
                 child=None):
    if list_only:
        # Both tiers are registered, so asking what exists reads the registry
        # and runs nothing.
        rows = [(cid, said)
                for _name, ids, _run, is_live in UNITS if live or not is_live
                for cid, said in ids]
        # One check belongs to the runner rather than to a unit: it watches
        # what the live tier printed while running, which only the caller of
        # the tier can see. It is listed here so the listing stays complete.
        rows += list(RUNNER_CHECKS) if live else []
        rows += list(SHARED_CHECKS) if live and jobs > 1 else []
        # Every run of either tier states whether it got to the end of its
        # units, so the row is here whichever tier is being listed.
        rows.append(UNIT_ENDED[bool(live)])
        column = max((len(cid) for cid, _said in rows), default=0)
        for cid, said in rows:
            print(check_line(cid, said, idwidth=column))
        return 0
    if live:
        # live_checks runs the read-only tier as a child, to read its stderr and
        # to take its verdicts. Running it here as well would answer every
        # read-only question twice in one invocation, which is what it did.
        # Both streams are captured: a fixture launch can write what it ran or
        # warned about between the verdicts, and inside --list where every line
        # is read as an id. Captured rather than silenced, so the check below can
        # say the tier was noisy instead of the output merely vanishing.
        said = io.StringIO()
        with capturing("out", into=said), capturing("err", into=said):
            results, register = (_live_in_parallel(jobs) if jobs > 1
                                 else live_checks(share, child))
        if jobs > 1:
            # The workers watched their own units print, and _live_in_parallel
            # has already folded what each of them saw into the one row.
            return _selftest_report(results, failed_only)
        loud = [line for line in said.getvalue().splitlines() if line.strip()]
        register(RUNNER_CHECKS[0][0], RUNNER_CHECKS[0][1], not loud,
                 f"{len(loud)} line(s), first: {loud[0].strip()[:60]!r}" if loud else "")
        return _selftest_report(results, failed_only)
    s = _suite_context()
    results, register = check_rows()
    misdeclared = []
    ended = ""
    for _name, ids, run, is_live in UNITS:
        if is_live:
            continue
        produced, stopped = ran_unit(run, s)
        if stopped:
            ended = f"{_name} ended the run with {stopped}"
            break
        for row in produced:
            register(*row)
        # The registry is a claim about what a unit does, and a claim this
        # suite makes about itself is checked like any other. Every unit that
        # gets it wrong goes into misdeclared and they come back as one
        # registry-declares-what-it-runs row, since that is one id and an id
        # registers once.
        said = sorted(cid for cid, _n, _o, _d in produced)
        if said != sorted(cid for cid, _s in ids):
            misdeclared.append(f"{_name} registered {sorted(c for c, _s in ids)}, "
                               f"produced {said}")
    if misdeclared:
        register("registry-declares-what-it-runs",
                 "a unit produces the ids it registered", False,
                 "; ".join(misdeclared))
    register(*UNIT_ENDED[False], not ended, ended)
    return _selftest_report(results, failed_only)


def completion_needs(topic):
    """Corpus work one completion topic may perform.

    Dynamic topics include the selected object after a colon. Ordinary selector
    completion deliberately excludes the conversion census: listing names,
    teams and leads must not search every main transcript for receipt-only
    members. The explicit demotion-parent topic may do that work because current
    team sessions are the value it was asked to list.
    """
    kind, _subject = completion_request(topic)
    table = {
        "flags": Needs(),
        "sockets": Needs(),
        "sessions": Needs(maybe={NEED.TITLES}),
        "sides": Needs(hard={NEED.SIDES}),
        "agent-ids": Needs(maybe={NEED.SPAWNS, NEED.CONVERSION_CENSUS}),
        "names": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                              NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "teams": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                              NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "leads": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                              NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "selector": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                                 NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "as-agent-name": Needs(hard={NEED.SIDES}),
        "as-agent": Needs(maybe={NEED.SIDES, NEED.PROCS, NEED.REGISTRY,
                                  NEED.STAMPS, NEED.SPAWNS, NEED.TITLES,
                                  NEED.CONVERSION_CENSUS}),
        "into-session": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS,
                                     NEED.SPAWNS, NEED.TITLES,
                                     NEED.CONVERSION_CENSUS}),
    }
    return table.get(kind, Needs())


def verb_needs(args, selector):
    """What each verb declares to the engine, mirroring main's dispatch.

    Hard where the verb's fixed path always computes it, conditional where
    a branch or the corpus decides. The end-of-run audit refuses a hard need
    nobody exercised, so nothing survives here just in case; the maps are
    tightened by running the verbs, not by guessing.
    """
    if args.complete:
        return completion_needs(args.complete)
    if args.selftest or args.cleanup:
        # the suite exercises by fixture; cleanup runs from the startup hook,
        # where a refused compute would fail silently behind its own output
        # redirection
        return Needs(maybe=set(NEED))
    if args.doctor:
        # A direct target prints member dossiers and therefore joins mail for
        # each one. The empty-hand sweep reads mailbox counts without that join.
        hard = {NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                NEED.STAMPS, NEED.SPAWNS, NEED.CONVERSION_CENSUS}
        maybe = {NEED.TITLES}
        if selector or args.agent_id or args.resume or args.team:
            hard.add(NEED.MAIL)
        else:
            maybe.add(NEED.MAIL)
        return Needs(hard=hard, maybe=maybe)
    if args.census:
        # the process table only where a count is about live agents
        return Needs(hard={NEED.STAMPS, NEED.SPAWNS, NEED.CONVERSION_CENSUS},
                     maybe={NEED.PROCS, NEED.REGISTRY, NEED.SEATS})
    if args.sides:
        # titles only when a listing has a session to title
        return Needs(hard={NEED.SIDES}, maybe={NEED.TITLES})
    if args.promote:
        # a promote resolves an identity only once it has one to place
        return Needs(hard={NEED.SIDES},
                     maybe={NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                            NEED.STAMPS, NEED.SPAWNS, NEED.TITLES,
                            NEED.CONVERSION_CENSUS})
    if args.demote:
        # Stamps and spawn payloads are consulted only when no receipt or
        # carried record says which parent the transcript came from.
        return Needs(hard={NEED.PROCS},
                     maybe={NEED.SIDES, NEED.STAMPS, NEED.SPAWNS,
                            NEED.CONVERSION_CENSUS})
    if args.mail_ledger:
        # liveness only for the rows a live holder would explain
        return Needs(hard={NEED.STAMPS, NEED.MAIL, NEED.CONVERSION_CENSUS},
                     maybe={NEED.PROCS, NEED.SPAWNS})
    if args.install or args.poison or args.unpoison:
        return Needs()
    if not (selector or args.agent_id or args.resume or args.team):
        return Needs()  # the help gate answers this run
    if args.stop:
        # the stamps only when a bare selector has to be found through them,
        # payloads only when a target has to be found by parentage; pointed at
        # --agent-id, --team or --resume a stop asks neither
        return Needs(hard={NEED.PROCS},
                     maybe={NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                            NEED.TITLES, NEED.CONVERSION_CENSUS})
    # The input decides which resolution rungs can run. A UUID resolves from
    # the filename without the stamp index. Once identity is known, live-runtime
    # mapping for a promoted lead may enumerate known teams and read that index.
    # A bare name or team always uses stamps. An agent ID reaches them only when
    # no live process already states that identity.
    by_uuid = bool(args.resume) or bool(selector and UUID_RE.match(selector))
    if args.agent_id or (selector and "@" in selector):
        # An agent ID conditionally reaches stamps through runtime mapping.
        return Needs(hard={NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                           NEED.SPAWNS, NEED.TITLES, NEED.CONVERSION_CENSUS},
                     maybe={NEED.STAMPS})
    if by_uuid and not args.team:
        # Exact lookup itself needs no stamps. Runtime mapping and rebind cleanup
        # can read them after the transcript resolves, depending on identity and
        # live process state.
        return Needs(hard={NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                           NEED.SPAWNS, NEED.TITLES, NEED.CONVERSION_CENSUS},
                     maybe={NEED.STAMPS})
    return Needs(hard={NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                       NEED.SPAWNS, NEED.STAMPS, NEED.TITLES,
                       NEED.CONVERSION_CENSUS})


def audited(entry):
    """Run the verb, then let the engine refuse a fat declaration.

    Only a completed verb is audited: a refusal mid-run proves nothing
    about what the whole verb would have used, and an exec never returns.

    That holds because nothing on the way out swallows a refusal: die() raises,
    the raise passes through here, and the audit below is never reached. The
    one place that catches one, run_one, hands it back to run_agents, which
    reports every member it managed and then ends the run in that refusal.
    """
    code = entry()
    RESOLVER.audit_needs()
    return code


def offers(action, row, completes=None):
    """What a completion needs about a flag and argparse has nowhere to hold.

    Two registers of prose, on purpose. help= is the help page, where a flag has
    room for a sentence. row= is the single line the completion menu gives it,
    where it has room for a phrase. --dry-run is "say what would happen and do
    none of it: nothing is launched, written or ended" on the page and "preview
    without launching" in the menu, and neither is a truncation of the other.

    row= is not optional and has no default. Falling back to the help would mean
    a flag added later put whatever its help page says into the menu because
    nobody chose, which is how a menu fills up with sentences nobody can scan.
    every-flag-declares-a-menu-row makes the omission a failed check rather than
    a listing that has quietly grown a paragraph in it.

    completes= names the emitter topic that fills the flag's value. Whether a
    flag takes a value at all argparse already knows, so that is read off the
    action rather than repeated here.
    """
    action.menu_row = row
    action.completer = completes
    return action


def build_parser():
    """Every flag this tool takes, declared once, in the groups it prints them in.

    Lifted out of main so the completion emitter can run the real parser instead
    of scraping this file for add_argument calls. Two flags interpolate a
    constant into their help, and a reader of the syntax tree sees an unresolved
    f-string exactly where the person at the prompt needs the resolved sentence.
    """
    parser = argparse.ArgumentParser(
        prog=TOOL, allow_abbrev=False, add_help=False,
        formatter_class=HelpLayout,
        # The generated usage was nine lines of forty-six flags in declaration
        # order, which said nothing a reader could act on. This is the one
        # spelling of how the tool is called; the groups below say the rest.
        usage=f"{TOOL} [<selector>] [options] [-- ...forwarded to claude]",
        description=SELECTOR_HELP,
    )
    # Grouped in the order a reader wants them: who comes back, the subordinate
    # placement choices, what to do instead of resuming it, what to check before
    # it acts, what it prints, the tmux server, and last the four that do nothing
    # without --selftest. In declaration order those four sat between --bare
    # and --all, where nothing said they were unusable on their own.
    picking = parser.add_argument_group("selecting who comes back")
    placing = parser.add_argument_group("where and as what it comes up")
    verbs = parser.add_argument_group("instead of resuming it")
    careful = parser.add_argument_group("before it acts")
    saying = parser.add_argument_group("what it prints")
    swarm = parser.add_argument_group("the swarm tmux server")
    suite = parser.add_argument_group("with --selftest only")
    offers(picking.add_argument("--agent-id", help="resume this agent (by its full id, name@team)"),
           completes='agent-ids',
           row='resume this agent by its full id, name@team')
    offers(picking.add_argument("--resume", metavar="SESSION_UUID",
                                help="resume this session transcript (by uuid)"),
           completes='sessions',
           row='resume this session transcript by uuid')
    offers(picking.add_argument("--team", metavar="TEAM",
                                help="resume this whole team by name: the members, then the lead"),
           completes='teams',
