def check_rows():
    """One place says what registering a check means.

    Returns (the rows registered so far, the function that registers one). A row
    is a check's id, the name it prints under, its verdict and its detail.

    An id registers once. Two rows under one id would let --failed name a check
    that also passed, so the second is dropped and its id written to
    register.collisions, which the tier's uniqueness row reports. Raising here
    would end the tier inside the loop that builds rows, with no rows, no tally
    and no failure line, and nothing left to report the collision.

    A verdict is True or False. check_line prints a row with the verdict None as
    a listing line with no marker while the tally counts it as failed, so a
    None, or any other object that is not a bool, would print a row with a
    marker and a count that disagree. Such a row is not made: its check id and
    the verdict's type go to register.rejected, and the tier's declaration row
    reports them with the rest of the rows it rejected. A check with no subject
    to answer about reports False and says so in its detail.

    Every producer of rows registers here: the read-only tier, a whole live
    tier, one share of one, and the merge of several shares. A merge folds the
    rows every share states about its own run before it registers them, so
    those are one row each and not collisions, while a check two shares both
    reported is one.
    """
    rows = []
    seen_ids = set()
    collisions = []
    rejected = []

    def register(cid, name, ok, detail=""):
        if cid in seen_ids:
            collisions.append(cid)
            return
        seen_ids.add(cid)
        if not isinstance(ok, bool):
            rejected.append(f"{cid!r} has a {type(ok).__name__} verdict, {ok!r:.60}, "
                            "where a verdict is True or False")
            return
        rows.append((cid, name, ok, detail))

    register.collisions = collisions
    register.rejected = rejected
    return rows, register


def _suite_functions():
    """Classify registered units and designated helpers when a context is built."""
    return ({run.__name__ for _n, _i, run, _l in UNITS}
            | {"_suite_context", "_live_context", "run_selftest", "live_checks", "unit", "resume_run",
