                            faults.append("batch discarded the first refusal")
        except Exception as exc:
            faults.append(f"raised {type(exc).__name__}: {exc}")
        checked.append(_check_verdict(cid, not faults, '; '.join(faults)))
    return checked


@unit(('rebuild-applied-is-complete-typed-evidence',
       'a finished rebuild reports what it did, typed, and completely'),
      ('rebuild-completion-verifies-applied-evidence',
       'completion checks the evidence handed to it, not the roster again'),
      ('rebuild-inbox-failure-restores-the-commit-snapshot',
       'a rebuild that cannot seed an inbox puts the roster back and says so'),
      ('rebuild-answers-are-deeply-immutable',
       'the rebuild plan, its evidence, and its completion hold nothing mutable'))
def _check_rebuild_evidence(s):
    """Rebuild effects retain exact file observations and restore the original on failure."""
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    TEAM = "session-t20-evidence"
    BROKEN = b'{"name": "session-t20-evid'
    MEMBERS = ("willow", "birch")

    def staged():
        base = Path(tempfile.mkdtemp(prefix=f"{TOOL}-t20-evidence-"))
        teams, projects = base / "teams", base / "projects"
        (projects / "p").mkdir(parents=True)
        (teams / TEAM / "inboxes").mkdir(parents=True)
        cfg = teams / TEAM / "config.json"
        cfg.write_bytes(BROKEN)
        cfg.chmod(0o640)
        stem = "lead-t20-evidence"
        rows = [fixture_line({
            "parentUuid": None, "type": "user", "uuid": f"{stem}-root",
            "sessionId": stem, "agentName": "team-lead", "teamName": TEAM,
            "timestamp": "2026-01-01T00:00:00Z"})]
        for who in MEMBERS:
            rows.append(fixture_line({
                "parentUuid": f"{stem}-root", "type": "user",
                "uuid": f"{stem}-{who}", "sessionId": stem,
                "agentName": "team-lead", "teamName": TEAM, "isSidechain": False,
                "timestamp": "2026-01-01T00:00:01Z",
                "message": {"role": "user", "content": []},
                "toolUseResult": {
                    "status": "teammate_spawned", "name": who,
                    "team_name": TEAM, "agent_id": agent_id_of(who, TEAM),
                    "agent_type": "general-purpose", "model": "claude-opus-5"}}))
        (projects / "p" / f"{stem}.jsonl").write_text("\n".join(rows) + "\n")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._teams_dir, eng._projects_dir = teams, projects
        eng._process_table = lambda refresh=False: ()
        return base, eng, cfg

    def rebuilding(break_seed_at=None):
        """One rebuild, the evidence it reported, and what was left behind."""
        base, eng, cfg = staged()
        seen = {}
        was_resolver, was_stdin = globals()["RESOLVER"], sys.stdin
        was_seed = globals()["seed_selected_inbox"]
        globals()["RESOLVER"] = eng
        sys.stdin = types.SimpleNamespace(isatty=lambda: False)
        seeded = []

        def seeding(inbox):
            seeded.append(inbox)
            if break_seed_at is not None and len(seeded) == break_seed_at:
                raise OSError(13, "permission denied")
            return was_seed(inbox)

        real_plan = eng.rebuild_plan

        def watched(*args, **kwargs):
            answer = real_plan(*args, **kwargs)
            if kwargs.get("applied") is not None:
                seen["applied"] = kwargs["applied"]
                seen["completed"] = answer
            return answer

        globals()["seed_selected_inbox"] = seeding
        failure = None
        try:
            with capturing("out"), capturing("err"):
                plan = eng.rebuild_plan(
                    team=TEAM, table=(), census=eng._roster_census())
                seen["plan"] = plan
                eng.rebuild_plan = watched
                try:
                    apply_rebuild_plan(plan, False)
                except Refusal as stopped:
                    failure = f"Refusal: {stopped}"
                except OSError as stopped:
                    failure = f"{type(stopped).__name__}: {stopped}"
        finally:
            eng.rebuild_plan = real_plan
            globals()["RESOLVER"] = was_resolver
            globals()["seed_selected_inbox"] = was_seed
            sys.stdin = was_stdin
            seen["failure"] = failure
            seen["after"] = cfg.read_bytes() if cfg.exists() else None
            seen["mode"] = (cfg.stat().st_mode & 0o777) if cfg.exists() else None
            seen["seeded"] = len(seeded)
            seen["engine"] = eng
            seen["base"] = base
        return seen

    done = rebuilding()
    applied, completed = done.get("applied"), done.get("completed")
    effects = applied.effects if isinstance(applied, Applied) else {}
    backup = (effects.get("backup") or {}).get("observation")
    written = (effects.get("written") or {}).get("observation")
    carries = {
        "typed Applied evidence": isinstance(applied, Applied),
        "exact backup bytes and mode": type(backup) is FileObservation
            and backup.raw == BROKEN and backup.mode == 0o640,
        "actual written observation": written == done["engine"]._file_observation(done["plan"]["cfg"]),
        "original observation": effects.get("original") is done["plan"]["original"],
        "retained rollback observation": effects.get("rollback") == done["plan"]["retained_original"],
        "one associated effect per selected inbox":
            len(effects.get("inboxes", ())) == done["seeded"] > 0
            and all(effect["selection"] is selected and type(effect["after"]) is FileObservation
                    for effect, selected in zip(effects.get("inboxes", ()), done["plan"]["inboxes"])),
    }
    faults = sorted(name for name, ok in carries.items() if not ok)
    check("rebuild-applied-is-complete-typed-evidence",
          "a finished rebuild reports what it did, typed, and completely",
          not faults, ", ".join(faults)
          + f"; reported {type(applied).__name__}, {done['seeded']} inbox(es) seeded")

    # Completion verifies retained observations without selecting another roster.
    reread, again = [], rebuilding()
    eng2 = again["engine"]
    real_snapshot = eng2._roster_snapshot

    def refusing_snapshot(*args, **kwargs):
        reread.append(args[:1])
        raise AssertionError("completion read the roster again")

    verified, why = None, ""
    try:
        eng2._roster_snapshot = refusing_snapshot
        with capturing("out"), capturing("err"):
            verified = eng2.rebuild_plan(
                again["plan"]["launch"], applied=again["applied"])
    except AssertionError as caught:
        why = str(caught)
    except Exception as caught:
        why = f"{type(caught).__name__}: {caught}"
    finally:
        eng2._roster_snapshot = real_snapshot
        shutil.rmtree(again["base"], ignore_errors=True)
    checking = {
        "completion answered without reading the roster again":
            verified is not None and not reread,
    }
    faults = sorted(name for name, ok in checking.items() if not ok)
    check("rebuild-completion-verifies-applied-evidence",
          "completion checks the evidence handed to it, not the roster again",
          not faults, ", ".join(faults) + (f"; {why}" if why else ""))

    # Seeding is what fails, after the roster has already been replaced.
    broke = rebuilding(break_seed_at=2)
    restored = {
        "it did not report a finished rebuild": broke["failure"] is not None,
        "and the roster is the one it started with": broke["after"] == BROKEN,
        "with the mode it started with": broke["mode"] == 0o640,
    }
    faults = sorted(name for name, ok in restored.items() if not ok)
    check("rebuild-inbox-failure-restores-the-commit-snapshot",
          "a rebuild that cannot seed an inbox puts the roster back and says so",
          not faults, ", ".join(faults)
          + f"; failure {broke['failure']!r}, roster restored {broke['after'] == BROKEN}")

    frozen = []
    for label, answer in (("plan", done.get("plan")), ("applied", applied),
                          ("completed", completed)):
        if answer is None:
            frozen.append(f"{label} missing")
            continue
        frozen.extend(f"{label}{spot[len('answer'):]}"
                      for spot in mutable_nodes(answer))
    check("rebuild-answers-are-deeply-immutable",
          "the rebuild plan, its evidence, and its completion hold nothing mutable",
          not frozen, ", ".join(frozen[:4]))
    for leftover in (done.get("base"), broke.get("base")):
        if leftover:
            shutil.rmtree(leftover, ignore_errors=True)
    return checked


@unit(('replace-invalid-asks-with-a-helpful-default',
       'replacing an unreadable roster asks, and Enter accepts'),
      ('replace-invalid-refusal-leaves-the-roster-alone',
       'answering no leaves the unreadable roster and writes no backup'),
      ('replace-invalid-without-a-terminal-takes-the-helpful-default',
       'with nothing to ask, replacing an unreadable roster still proceeds'),
      ('replace-invalid-dry-run-asks-nothing-and-writes-nothing',
       'a previewed replacement asks no question and touches no file'))
def _check_replace_invalid_confirmation(s):
    """Replacing a roster nobody can read, and what it asks first.

    The bytes going away are already unreadable, and an exact copy is kept
    beside the file either way, so yes is the helpful answer and Enter is how
    to give it. That is the opposite of what --stop asks, where the default has
    to be no because a conversation that has been ended does not come back. A
    run with no terminal takes the helpful answer rather than refusing, and
    --yes is not the price of it. A preview asks nothing, because nothing
    happens.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    TEAM = "session-t20-replace"
    BROKEN = b'{"name": "session-t20-repl'

    def staged():
        """An unreadable roster, and the lead transcript that can rebuild it."""
        base = Path(tempfile.mkdtemp(prefix=f"{TOOL}-t20-replace-"))
        teams, projects = base / "teams", base / "projects"
        (projects / "p").mkdir(parents=True)
        (teams / TEAM / "inboxes").mkdir(parents=True)
        (teams / TEAM / "config.json").write_bytes(BROKEN)
        stem = "lead-t20-replace"
        rows = [fixture_line({
            "parentUuid": None, "type": "user", "uuid": f"{stem}-root",
            "sessionId": stem, "agentName": "team-lead", "teamName": TEAM,
            "timestamp": "2026-01-01T00:00:00Z"})]
        for who in ("willow", "birch"):
            rows.append(fixture_line({
                "parentUuid": f"{stem}-root", "type": "user",
                "uuid": f"{stem}-{who}", "sessionId": stem,
                "agentName": "team-lead", "teamName": TEAM, "isSidechain": False,
                "timestamp": "2026-01-01T00:00:01Z",
                "message": {"role": "user", "content": []},
                "toolUseResult": {
                    "status": "teammate_spawned", "name": who,
                    "team_name": TEAM, "agent_id": agent_id_of(who, TEAM),
                    "agent_type": "general-purpose", "model": "claude-opus-5"}}))
        (projects / "p" / f"{stem}.jsonl").write_text("\n".join(rows) + "\n")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._teams_dir, eng._projects_dir = teams, projects
        eng._process_table = lambda refresh=False: ()
        return base, eng

    def replacing(answer="", tty=True, dry=False):
        """One replacement attempt, and everything it did on the way."""
        base, eng = staged()
        cfg = base / "teams" / TEAM / "config.json"
        backup = cfg.with_name(f"{cfg.name}.invalid-{TOOL}.bak")
        asked, refused = [], None
        was_resolver, was_stdin = globals()["RESOLVER"], sys.stdin
        globals()["RESOLVER"] = eng
        sys.stdin = types.SimpleNamespace(isatty=lambda: tty)
        globals()["input"] = lambda prompt="": (asked.append(prompt), answer)[1]
        try:
            with capturing("out"), capturing("err"):
                plan = eng.rebuild_plan(
                    team=TEAM, table=(), census=eng._roster_census())
                try:
                    apply_rebuild_plan(plan, dry)
                except Refusal as stopped:
                    refused = str(stopped)
        finally:
            globals()["RESOLVER"] = was_resolver
            sys.stdin = was_stdin
            globals().pop("input", None)
            after = cfg.read_bytes() if cfg.exists() else None
            made = backup.exists()
            shutil.rmtree(base, ignore_errors=True)
        return {"asked": asked, "refused": refused,
                "unchanged": after == BROKEN, "backup": made}

    entered = replacing(answer="")
    declined = replacing(answer="n")
    headless = replacing(tty=False)
    preview = replacing(dry=True)

    asking = {
        "it asked once": len(entered["asked"]) == 1,
        "with the helpful default spelled Y/n":
            any("[Y/n]" in prompt for prompt in entered["asked"]),
        "and Enter replaced the roster":
            not entered["unchanged"] and entered["refused"] is None,
        "keeping an exact copy of what it replaced": entered["backup"],
    }
    faults = sorted(name for name, ok in asking.items() if not ok)
    check("replace-invalid-asks-with-a-helpful-default",
          "replacing an unreadable roster asks, and Enter accepts", not faults,
          ", ".join(faults) + f"; asked {entered['asked']}")

    refusing = {
        "it asked": len(declined["asked"]) == 1,
        "no left the roster exactly as it was": declined["unchanged"],
        "and wrote no backup of bytes it did not replace": not declined["backup"],
    }
    faults = sorted(name for name, ok in refusing.items() if not ok)
    check("replace-invalid-refusal-leaves-the-roster-alone",
          "answering no leaves the unreadable roster and writes no backup",
          not faults, ", ".join(faults)
          + f"; asked {declined['asked']}, refused {declined['refused']!r}")

    # --yes is never passed here. Needing it would make the helpful default
    # reachable only by someone who already knew to ask for it.
    unattended = {
        "it asked nothing": not headless["asked"],
        "it did not refuse for want of a terminal": headless["refused"] is None,
        "and took the helpful answer": not headless["unchanged"],
        "keeping an exact copy": headless["backup"],
    }
    faults = sorted(name for name, ok in unattended.items() if not ok)
    check("replace-invalid-without-a-terminal-takes-the-helpful-default",
          "with nothing to ask, replacing an unreadable roster still proceeds",
          not faults, ", ".join(faults)
          + f"; refused {headless['refused']!r}, replaced {not headless['unchanged']}")

    previewing = {
        "it asked nothing": not preview["asked"],
        "the roster is untouched": preview["unchanged"],
        "and no backup was written": not preview["backup"],
    }
    faults = sorted(name for name, ok in previewing.items() if not ok)
    check("replace-invalid-dry-run-asks-nothing-and-writes-nothing",
          "a previewed replacement asks no question and touches no file",
          not faults, ", ".join(faults) + f"; asked {preview['asked']}")
    return checked


@unit(('team-delivery-consumes-explicit-roster-state',
       'delivery reads which roster state it has, not a blank stand-in'),
      ('scaffolding-objection-consumes-census-evidence',
       'the scaffolding objection reads census evidence, not the file again'))
def _check_operation_inputs_are_explicit(s):
    """Two operations that still reach past the evidence handed to them.

    A roster is parsed, unparsable, or not there. `_roster_of(...) or {}` folds
    the last two together, so a config truncated mid-write reports the same
    delivery answer as a team that was cleaned up, and the stand-in is a fresh
    writable dict besides. The scaffolding objection has the census in hand and
    opens config.json to parse it again, which is a second answer to a question
    already answered and a second place for the two to disagree.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast

    def blank_stand_ins(node):
        """`something or {}`: the spelling that turns three states into two."""
        spots = []
        for part in ast.walk(node):
            if isinstance(part, ast.BoolOp) and isinstance(part.op, ast.Or):
                for value in part.values[1:]:
                    if isinstance(value, ast.Dict) and not value.keys:
                        spots.append(ast.unparse(part)[:70])
        return spots

    blanks = blank_stand_ins(s.resolver_methods["_team_delivery_facts"])

    # One lead, one team, two ways for its roster to be unreadable: a write
    # that stopped halfway, and no file at all. A delivery answer that reads
    # the state tells them apart; one that takes a blank cannot.
    TEAM = "session-t20-delivery"
    wearing = {"pid": PID_CEILING + 424242, "alive": True, "exact": True,
               "runs_as": TEAM, "runs_as_exact": True, "worn_team": TEAM}
    base = Path(tempfile.mkdtemp(prefix=f"{TOOL}-t20-"))
    teams, projects = base / "teams", base / "projects"
    (projects / "p").mkdir(parents=True)
    (teams / TEAM / "inboxes").mkdir(parents=True)
    cfg = teams / TEAM / "config.json"
    said = {}
    try:
        for label, body in (("unparsable", '{"name": "session-t20-deliv'),
                            ("absent", None)):
            if body is None:
                cfg.unlink()
            else:
                cfg.write_text(body)
            eng = Resolver(needs=Needs(maybe=set(NEED)))
            eng._teams_dir, eng._projects_dir = teams, projects
            eng._process_table = lambda refresh=False: ()
            census = eng._roster_census()
            said[label] = eng._team_delivery_facts(
                TEAM, wearing, eng._roster_snapshot(TEAM, census).data,
                census=census)
    finally:
        shutil.rmtree(base, ignore_errors=True)

    explicit = {
        "delivery keeps no blank stand-in for a roster": not blanks,
        "an unparsable roster does not read as an absent one":
            said["unparsable"]["polls"] != said["absent"]["polls"],
    }
    faults = sorted(name for name, ok in explicit.items() if not ok)
    check("team-delivery-consumes-explicit-roster-state",
          "delivery reads which roster state it has, not a blank stand-in",
          not faults, ", ".join(faults)
          + (f"; {blanks[0]}" if blanks else "")
          + f"; both answer {said['absent']['polls']!r}")

    scaffolding = s.resolver_methods["_scaffolding_objection"]
    handed = [arg.arg for arg in scaffolding.args.args]
    # Names in this method that hold the roster path, so the check is about
    # reopening the roster and not about the inbox files beside it.
    roster_names = {
        target.id
        for part in ast.walk(scaffolding) if isinstance(part, ast.Assign)
        for target in part.targets if isinstance(target, ast.Name)
        if any(isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute)
               and call.func.attr == "_roster_in"
               for call in ast.walk(part.value))}
    reparsed = sorted({
        ast.unparse(part)[:60] for part in ast.walk(scaffolding)
        if isinstance(part, ast.Call) and isinstance(part.func, ast.Attribute)
        and part.func.attr == "loads"
        and any(isinstance(inner, ast.Attribute)
                and inner.attr in {"read_text", "read_bytes"}
                and isinstance(inner.value, ast.Name)
                and inner.value.id in roster_names
                for inner in ast.walk(part))})
    reading = {
        "it is handed the roster evidence":
            any(arg in {"census", "snapshot", "roster_snapshot"} for arg in handed),
        "and does not open the roster to parse it again": not reparsed,
    }
    faults = sorted(name for name, ok in reading.items() if not ok)
    check("scaffolding-objection-consumes-census-evidence",
          "the scaffolding objection reads census evidence, not the file again",
          not faults, ", ".join(faults) + f"; takes {handed}"
          + (f", reparses via {reparsed[0]}" if reparsed else ""))
    return checked


@unit(('team-described-one-way', 'a team reads the same with or without its roster'))
def _check_team_described_one_way(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    corpus_engine = s.corpus_engine

    eng = corpus_engine()
    answer = eng.completion_answer("teams")
    rostered = [t for t in eng._known_teams() if eng._roster_snapshot(t).state == "valid"]
    adrift = [t for t in eng._known_teams() if eng._roster_snapshot(t).state != "valid"]
    told = {
        entry["team"]: row.partition(":")[2]
        for entry, row in zip(answer["entries"], answer["rows"])
    }
    described = []
    if not rostered or not adrift:
        described.append(f"the corpus carries {len(rostered)} rostered and {len(adrift)} adrift "
                         "teams, so this cannot compare the two kinds")
    # The grammar every row shares: facts in brackets after a title, or the
    # facts alone when nothing titles it. A row that says only what evidence
    # found it is the shape this replaced.
    for team, line in told.items():
        if "rebuildable from" in line:
            described.append(f"{team} still describes itself by its evidence: {line}")
        elif line.count("[") != (1 if "]" in line else 0):
            described.append(f"{team} reads in another grammar: {line}")
    titled = [t for t in adrift if "[" in told[t]]
    if not titled:
        described.append("no team without a roster carries a title, which is what this is for")
    for t in titled:
        if "member" not in told[t]:
            described.append(f"{t} has a title but no member count: {told[t]}")
    # A rosterless team with no lead transcript reports that both sources are
    # absent before someone attempts reconstruction.
    hopeless = [t for t in adrift if not eng._lead_transcript_for(t)[0]]
    for t in hopeless:
        if "roster missing; lead transcript search is empty" not in told[t]:
            described.append(f"{t} does not name both missing sources: {told[t]}")
    check("team-described-one-way", "a team reads the same with or without its roster",
          not described, "; ".join(described[:3]))
    return checked


