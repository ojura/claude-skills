@unit(('suggest-a-prefix-before-a-near-miss', 'an unknown flag is suggested the one of ours it prefixes, or else the closest of either set'))
def _check_suggest_a_prefix_before_a_near_miss(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    _dies = s._dies

    class _Renamed:
        _actions = [type("a", (), {"option_strings": [
            "--as-agent", "--into-session", "--into-team", "--tmux-session",
            "--team"]})()]

    def _suggested(flag):
        """What a refusal of this flag offered, with the allowlist line dropped.

        Every refusal prints the whole claude allowlist, so a search of the
        message for a flag name would match that listing rather than the
        suggestion. Cut at the sentence that opens it rather than at a newline,
        because the line above it wraps to the terminal.
