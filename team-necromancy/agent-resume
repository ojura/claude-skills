def step(dry, would, did, indent="  "):
    """Report an action once, in whichever tense actually applies.

    Both strings sit at the call site, so a preview line always has a real
    counterpart and a real run prints the same set of steps a dry run promised.
    """
    print(f"{indent}{would if dry else did}")


def warn(msg):
    sys.stdout.flush()  # keep warnings in order with the report block when piped
    print(f"{TOOL}: {msg}", file=sys.stderr)
    sys.stderr.flush()


def die(msg, code=1):
    warn(msg)
    sys.exit(code)


def iso_ms(value):
    if not value:
        return 0
    try:
        return int(datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return 0


def ms_str(ts):
    if not ts:
        return "-"
    return datetime.fromtimestamp(ts / 1000).strftime("%Y-%m-%d %H:%M:%S")


# ---------------------------------------------------------------- process table

class Resolver:
    """Everything a resolution reads, loaded once per run and held together.

    One field per source, filled on first use by the loader that owns it. The
    point of collecting them is that the set becomes enumerable: an answer
    derived from anything not in here is reaching past the evidence, and that is
    visible rather than a matter of noticing.

    A run is one process, so these were already per-run state as module
    globals. What the object adds is a place for cache lifetime to be stated
    (`refresh_procs`) instead of implied by a keyword argument.
    """

    def __init__(self):
        self.procs = None       # pid -> row, from ps
        self.stamps = None      # transcript stem -> (agentName, teamName)
        self.spawns = {}        # transcript stem -> {name: last payload of that name}
        self.spawn_log = {}     # transcript stem -> [(stamp, payload)] in file order
        self.by_agent = None    # "name@team" -> payload, across every transcript
        self.by_team = None     # team -> [(stamp, path)] of transcripts that led it
        self.teams_dir = TEAMS_DIR   # overridable so a test engine can read a synthetic tree

    def refresh_procs(self):
        self.procs = None
    def _grep_files(self, needle, scope, recursive):
        """Files containing this literal."""
        result = subprocess.run(self._searcher("files", needle, scope, recursive), capture_output=True, text=True)
        if result.returncode > 1:
            warn(f"search failed ({result.stderr.strip() or 'unknown'}); falling back to a full scan")
            return None
        return [Path(p) for p in result.stdout.splitlines() if p]

    def _searcher(self, kind, needle, paths, recursive):
        """argv for a literal search, preferring ripgrep when installed.

        Same question either way; rg walks the tree in parallel, which is several
        times faster on a transcript tree this size.
        """
        files = [str(p) for p in paths]
        if shutil.which("rg"):
            argv = ["rg", "--no-ignore", "-F", needle]
            argv += ["-l"] if kind == "files" else ["-N", "-H"]
            if recursive:
                argv += ["--glob", "*.jsonl"]
            return argv + files
        argv = ["grep", "-F", needle, "-l" if kind == "files" else "-H"]
        if recursive:
            argv += ["-r", "--include=*.jsonl"]
        return argv + files

    def _stamped_candidates(self, name, team=None, verify=True):
        """Transcripts whose own lines carry these stamps, newest first.

        Narrow, then confirm. The stamp index narrows (one bounded read per file,
        shared across every lookup in the process); the survivors are parsed to
        check the stamps are *current*, since a rebound agent's file mentions two
        teams. `verify=False` returns the narrowing alone, for callers that need a
        path and nothing else.

        The index reads only each file's ends, so it cannot see stamps that appear
        solely mid-history. When it finds nothing, grep re-asks over whole files
        before the answer is allowed to be "no transcript".
        """
        files = [p for p, (n, t) in self.stamp_index().items() if n == name and (not team or t == team)]

        if not verify:
            # The index is cached for the process, so a file may be gone by now.
            stamped = []
            for path in files:
                try:
                    stamped.append((path, {}, int(path.stat().st_mtime * 1000)))
                except OSError:
                    continue
            stamped.sort(key=lambda item: item[2], reverse=True)
            return stamped


        def confirm(paths):
            out = []
            for path in paths:
                fields, last_ts = self._scan_transcript(path)
                if fields.get("agentName", (None,))[0] != name:
                    continue
                if team and fields.get("teamName", (None,))[0] != team:
                    continue
                out.append((path, fields, last_ts))
            out.sort(key=lambda item: item[2], reverse=True)
            return out

        found = confirm(files)
        if not found:
            # The index can both miss (stamps only mid-history) and mislead (a stamp
            # quoted inside message content). Either way the answer is not yet "no",
            # so re-ask over whole files before saying so.
            deep = self._grep_files(f'"agentName":"{name}"', [PROJECTS_DIR], True)
            if deep is None:  # grep unavailable
                deep = sorted(PROJECTS_DIR.glob("*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
            elif team and deep:
                deep = self._grep_files(f'"teamName":"{team}"', deep, False) or []
            seen = set(files)
            found = confirm(p for p in deep if p not in seen)
        return found

    def _ingest_spawn_lines(self, paths):
        """Parse the spawn payloads out of these transcripts into the caches.

        grep pulls out the handful of matching lines; only those are parsed. A
        payload is taken from the parsed structure, never from raw bytes, so a
        transcript that merely discusses spawning cannot contribute a quoted
        example as if it were real.
        """
        paths = [p for p in paths if p and p.stem not in self.spawns]
        for path in paths:
            self.spawns[path.stem], self.spawn_log[path.stem] = {}, []
        if not paths:
            return
        result = subprocess.run(self._searcher("lines", SPAWN_MARKER, paths, False), capture_output=True, text=True)
        if result.returncode > 1:
            warn(f"search failed reading spawn records ({result.stderr.strip() or 'unknown'})")
            return
        for line in result.stdout.splitlines():
            where, _, text = line.partition(":")
            stem = Path(where).stem
            if stem not in self.spawns:
                continue
            try:
                record = json.loads(text)
            except ValueError:
                continue
            stamp = iso_ms(record.get("timestamp"))
            for payload in self._walk_spawn_payloads(record):
                self.spawns[stem][payload["name"]] = payload  # last spawn of a name wins
                self.spawn_log[stem].append((stamp, payload))

    def lead_pid(self, parent_session=None, team=None):
        """(pid, alive, how, exact) for the live process this agent's lead runs as.

        The roster names that lead one of two ways, and only one of them is in the
        session registry: a forged or explicit team carries a transcript id, an
        implicit team's leadSessionId is a boot uuid that no registry entry records.
        Socket resolution and credential inheritance both need this exact answer, so
        they ask here rather than each handling half the cases.
        """
        if parent_session:
            entry = self.lead_pid_for(parent_session)
            if entry:
                pid, _, alive = entry
                return pid, alive, f"lead pid {pid}" + ("" if alive else " (dead)"), True
        if team:
            # A fresh lead's internal id IS its transcript id, so its implicit team
            # is named after a session the registry knows: an exact join, preferred
            # over the time window below. (16 of 37 team dirs here are that shape.)
            block = re.fullmatch(r"session-([0-9a-f]{8})", team)
            if block:
                for data in self.session_registry():
                    if str(data.get("sessionId", "")).startswith(block.group(1)):
                        if pid_alive(data["pid"], data.get("procStart")):
                            return data["pid"], True, f"pid {data['pid']}, whose session id names team {team}", True
            # A masqueraded lead writes no sessions/<pid>.json at all (the registry
            # is for unbound launches), so every rung above it is blind to one.
            # It does advertise its identity in argv, which is exact evidence.
            masquerade = next((e for e in self.live_sessions()
                               if e["alive"] and e["agent"] == f"team-lead@{team}"), None)
            if masquerade:
                return masquerade["pid"], True, f"pid {masquerade['pid']}, masquerading as {masquerade['agent']}", True

            pid = self._pid_running_team(team)
            if pid:
                return pid, True, f"pid {pid}, which spawned into team {team}", True
            pid = self._pid_that_minted(team)
            if pid:
                return pid, True, f"pid {pid}, which is running as team {team}", False
        return None, False, None, False

    def lead_pid_for(self, session_id):
        """(pid, updatedAt, alive) for whoever holds this transcript."""
        best = None
        for entry in self.live_sessions():
            if entry["session"] != session_id:
                continue
            rank = (1 if entry["alive"] else 0, entry["updated"])
            if best is None or rank > best[0]:
                best = (rank, (entry["pid"], entry["updated"], entry["alive"]))
        return best[1] if best else None

    def _lead_transcript_for(self, team):
        """(transcript, why) for the transcript that led this team, or (None, reason).

        Several transcripts can claim one team: a fork carries the history it was
        copied from, and a payload quoted verbatim into a conversation parses like
        one the harness wrote. Ranked corroboration decides between them, all of it
        already loaded: a live process running as this team, a roster naming the
        transcript as its lead, the payload names matching the roster's members, and
        the team-name block, which an implicit team takes from the session that
        minted it.

        Exactly one corroborated claimant is the answer. A sole claimant with no
        corroboration is still taken, because the ordinary dead-team case is exactly
        that and refusing would strand every legitimately orphaned lead; it says so
        in its provenance instead. Anything else refuses and names what it refused
        between: choosing without evidence buys a resumed stranger's conversation
        wearing this team's lead identity.
        """
        hits = self.led_teams().get(team) or []
        if not hits:
            return None, f"no transcript records spawning into {team}"

        rosters = [e for e in self.scan_teams() if e["team"] == team]
        roster_members = {e["member"].get("name") for e in rosters}
        roster_leads = {e.get("leadSessionId") for e in rosters}
        live_here = {e.get("session") for e in self.live_sessions() if e.get("team") == team}
        block = re.fullmatch(r"session-([0-9a-f]{8})", team)

        def corroboration(path):
            if path.stem in live_here:
                return f"live process running as {team}"
            if path.stem in roster_leads:
                return "roster leadSessionId"
            spawned = {payload.get("name") for payload in self.members_spawned_into(path.stem, team)}
            if roster_members and spawned & roster_members:
                return "member names"
            if block and path.stem.startswith(block.group(1)):
                return "team-name block"
            return None

        backed = [(path, why) for _, path in hits if (why := corroboration(path))]
        if len(backed) == 1:
            return backed[0][0], f"spawn payloads naming {team}, corroborated by {backed[0][1]}"
        if len(hits) == 1:
            warn(f"resuming the only transcript claiming {team}; nothing corroborates it. "
                 f"If that is the wrong conversation, name the right one with --resume")
            return hits[0][1], f"sole payload claimant for {team}, uncorroborated"
        listed = ", ".join(path.stem[:8] for _, path in hits)
        if len(backed) > 1:
            return None, (f"{len(backed)} transcripts claim {team} with corroboration "
                          f"({listed}); name one with --resume")
        return None, (f"{len(hits)} transcripts claim {team} and nothing corroborates any of them "
                      f"({listed}); name one with --resume")


    def led_teams(self):
        """{team: [(last spawn ts, transcript path), ...]} for every team a lead ran as.

        A lead's own lines carry no stamps, so nothing in its transcript says who it
        is. What it does carry is a spawn payload for each teammate it created, and
        every payload names the team the lead was running as at the time. That makes
        the payload the only identity a lead leaves on disk.

        The roster cannot stand in for it. `leadSessionId` is the lead's internal
        live session id, which is what the implicit team is named after; it is not a
        transcript filename and usually has no file at all, so it can never equal the
        uuid a user is able to supply. Without this index, a lead is reachable only
        while its team dir still records a leadSessionId that happens to be a real
        transcript, which is the masquerade case alone.

        Built from the scan self._spawn_by_agent() already performs: containing a spawn
        payload is what makes a transcript a lead's, so the same files answer both.
        """
        if self.by_team is not None:
            return self.by_team
        self.by_team = {}
        leads = self._grep_files(SPAWN_MARKER, [PROJECTS_DIR], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            newest = {}
            for stamp, payload in self.spawn_log.get(path.stem, []):
                team = payload.get("team_name")
                if team:
                    newest[team] = max(newest.get(team, 0), stamp or 0)
            for team, stamp in newest.items():
                self.by_team.setdefault(team, []).append((stamp, path))
        for team in self.by_team:
            self.by_team[team].sort(reverse=True)
        return self.by_team

    def live_agent_procs(self, agent_id, table):
        return claude_procs(f"--agent-id {agent_id}", table)

    def wearers(self, agent_id, table=None):
        """(pid, transcript) for every live process wearing this agent-id.

        A running process is the agent now. Identity is frozen in argv at exec and
        a migration is kill-and-restart, so argv cannot be stale the way a roster
        entry or a transcript stamp can: those record what was true when written.
        The transcript is the process's own --resume value. A wearer without one
        carries no transcript evidence and is reported with None rather than
        dropped, so a caller can still see it is there.
        """
        out = []
        for pid, args in self.live_agent_procs(agent_id, table or self.ps_table()):
            held = next((pair.partition(" ")[2] for pair in _argv_pairs(args)
                         if pair.startswith("--resume ")), None)
            out.append((pid, held))
        return out

    def live_sessions(self):
        """Every claude process and what it is: {pid, session, agent, team, ...}.

        Two inputs, one answer. sessions/<pid>.json covers unbound launches and
        remembers dead ones; a flag-bound launch (every teammate, and the lead
        masquerade) never writes there but carries the same facts in its argv:
        --resume names the transcript it holds, --agent-id the identity it wears.
        Callers ask this, never an input, or the answer depends on which input the
        caller happened to think of.
        """
        found = {}
        for data in self.session_registry():
            pid = data.get("pid")
            if not pid:
                continue
            found[pid] = {
                "pid": pid,
                "session": data.get("sessionId"),
                "agent": None,
                "team": None,
                "updated": data.get("updatedAt") or 0,
                "started": data.get("startedAt") or 0,
                "alive": pid_alive(pid, data.get("procStart")),
            }
        for pid, _, args in self.ps_table():
            if not looks_like_claude(args):
                continue
            pairs = _argv_pairs(args)
            held = next((v.split(" ", 1)[1] for v in pairs if v.startswith("--resume ")), None)
            agent = next((v.split(" ", 1)[1] for v in pairs if v.startswith("--agent-id ")), None)
            if not (held or agent):
                continue
            entry = found.setdefault(pid, {"pid": pid, "session": None, "agent": None,
                                           "team": None, "updated": 0, "started": 0, "alive": True})
            if not entry["alive"] and held:
                # The registry entry failed its procStart check, so this pid was
                # recycled: what argv says outranks what the registry remembers.
                entry["session"] = held
            entry["alive"] = True
            entry["session"] = entry["session"] or held
            if agent:
                entry["agent"] = agent
                entry["team"] = agent.split("@", 1)[1] if "@" in agent else None
        return list(found.values())

    def members_spawned_into(self, lead_session, team):
        """The payloads for every teammate this lead spawned into this team.

        A team-membership question, like team_minted_by's, not the per-agent payload
        lookup spawn_payload owns: it asks who a roster should list, not what one
        known agent was created with. A lead resumed several times spawns into a
        fresh implicit team each life while appending to one transcript, so payloads
        naming another team are skipped rather than adopted.
        """
        self._spawn_records(lead_session)  # fills the ordered log for this transcript
        latest = {}
        for _stamp, payload in self.spawn_log.get(lead_session) or []:
            if payload.get("name") and payload.get("team_name") == team:
                latest[payload["name"]] = payload  # last spawn of that name into this team
        return list(latest.values())

    def name_rosters(self, name):
        """Teams whose roster carries this agent name. A name in more than one is
        not an identity: every team has a "team-lead"."""
        return {e["team"] for e in self.scan_teams() if e["member"].get("name") == name}

    def _pid_running_team(self, team):
        """The live process whose transcript records spawning into this team.

        Exact evidence for the case the registry cannot answer: an abandoned team
        whose leadSessionId is an internal id no file maps to a pid. The lead that
        spawned into it wrote that team name into each spawn payload.
        """
        if not team:
            return None
        matches = []
        for entry in self.live_sessions():
            if not (entry["alive"] and entry["session"]):
                continue
            self._spawn_records(entry["session"])
            # Any life's payload will do here: it is the same process either way.
            if any(item.get("team_name") == team for _, item in self.spawn_log.get(entry["session"], [])):
                matches.append((entry["updated"], entry["pid"]))
        return max(matches)[1] if matches else None

    def _pid_that_minted(self, team):
        """Which live process is running as this implicit team.

        The roster's leadSessionId is that boot uuid, so it matches no registry
        entry; without this, every agent of a resumed lead's team has an
        unresolvable socket.
        """
        return next((pid for name, pid, _ in boot_join() if name == team), None)

    def procs_on_transcript(self, session_uuid, table):
        """Whoever holds this transcript, under any identity. Two processes
        appending to one JSONL is the thing to never allow, and a rebind changes the
        agent-id, so identity is the wrong key here."""
        return claude_procs(f"--resume {session_uuid}", table)

    def ps_table(self, refresh=False):
        """[(pid, ppid, args)] for every process we can see, snapshotted once.

        One run judges liveness against one consistent picture, and a single
        resolve was spawning ps three times.
        """
        if self.procs is not None and not refresh:
            return self.procs
        out = subprocess.run(
            ["ps", "-eo", "pid=,ppid=,args="], capture_output=True, text=True
        ).stdout
        rows = []
        for line in out.splitlines():
            parts = line.strip().split(None, 2)
            if len(parts) == 3 and parts[0].isdigit():
                rows.append((int(parts[0]), int(parts[1]), parts[2]))
        self.procs = rows
        return rows

    def lead_session_for(self, team):
        """The session id of this team's lead, or None.

        Three places used to answer this differently: a roster read, a payload
        lookup, and a glob over transcripts sharing the team name's block. They
        disagree exactly when it matters, so they are one ladder here, strongest
        first: what a roster records, what the payloads prove, and only then the
        block, which is a guess about a name rather than evidence about a session.
        """
        for entry in self.scan_teams():
            if entry["team"] == team and entry.get("leadSessionId"):
                if self.transcript_path(entry["leadSessionId"]):
                    return entry["leadSessionId"]
        path, _why = self._lead_transcript_for(team)
        if path:
            return path.stem
        block = re.fullmatch(r"session-([0-9a-f]{8})", team or "")
        if not block:
            return None
        hits = sorted(self.transcripts_starting(block.group(1)),
                      key=lambda p: p.stat().st_mtime, reverse=True)
        if len(hits) > 1:
            warn(f"{len(hits)} transcripts start with {block.group(1)}; assuming {hits[0].stem}")
        return hits[0].stem if hits else None

    def roster_path(self, team):
        """Where this team's roster lives. A path question, not a write: the class
        answers where things are so writers never have to know the layout."""
        return self.teams_dir / team / "config.json"

    def inbox_path(self, team, name):
        """Where this member's mailbox lives."""
        return self.teams_dir / team / "inboxes" / f"{name}.json"

    def team_dirs(self):
        """Every team directory on disk, roster or not."""
        return [d for d in self.teams_dir.glob("*") if d.is_dir()]

    def transcripts_by_mtime(self):
        """Every transcript, newest first."""
        return sorted(PROJECTS_DIR.glob("*/*.jsonl"),
                      key=lambda path: path.stat().st_mtime, reverse=True)

    def transcripts_starting(self, block):
        """Transcripts whose uuid opens with this block. A path question, so it
        belongs to whoever owns the tree rather than to a caller globbing it."""
        return list(PROJECTS_DIR.glob(f"*/{block}-*.jsonl"))

    def resolve_transcript(self, session_uuid=None, lead_session=None, team=None, name=None,
                           is_lead=False, quick=False):
        """The only place a transcript is chosen. Evidence, strongest first:

        1. an exact session uuid, given by the user or named by the roster as
           leadSessionId
        2. both stamps: agentName AND teamName written on the transcript's lines
        3. agentName alone, refused when that name is in more than one roster
        4. for a lead only: the transcript whose spawn payloads name this team

        A lead writes no stamps, so rungs 2 and 3 can never reach one. Rung 1
        reaches it only when leadSessionId happens to be a real transcript, which is
        true of a masqueraded lead and false of every natively created one, whose
        leadSessionId is an internal live id with no file. Rung 4 is what covers the
        rest: see self.led_teams().

        Rung 3 is why "team-lead" can never be resolved by name: it lives in every
        team, so the name carries no identity and the engine returns nothing rather
        than adopting a stranger's conversation.
        """
        if session_uuid:
            path = self.transcript_path(session_uuid)
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return Resolution(path, fields, last, via="session uuid", strength=EXACT)
            return Resolution(reason=f"no transcript file for session {session_uuid}")

        # A live process wearing this identity outranks anything recorded: argv is
        # frozen at exec and a migration is kill-and-restart, so a roster entry or a
        # stamp says what was true when it was written, while argv says what is true.
        if name and team:
            seen = self.wearers(f"{name}@{team}")
            held = {transcript for _, transcript in seen if transcript}
            if len(held) > 1:
                return Resolution(reason=(
                    f"{len(seen)} live processes wear {name}@{team} on different conversations "
                    f"({', '.join(f'pid {pid} on {t[:8]}' for pid, t in seen if t)}); "
                    "name the one you mean with --resume"))
            if held:
                path = self.transcript_path(held.pop())
                if path:
                    if len(seen) > 1:
                        warn(f"{len(seen)} live processes wear {name}@{team} on this one "
                             f"conversation (pids {', '.join(str(pid) for pid, _ in seen)})")
                    fields, last = ({}, 0) if quick else self._scan_transcript(path)
                    return Resolution(path, fields, last, strength=EXACT,
                                      via=f"live pid {seen[0][0]} wearing {name}@{team}")

        if lead_session or is_lead:
            path = self.transcript_path(lead_session) if lead_session else None
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return Resolution(path, fields, last, via="roster leadSessionId", strength=EXACT)
            path, why = self._lead_transcript_for(team) if team else (None, "no team was named")
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return Resolution(path, fields, last, via=why, strength=EXACT)
            named = (f"roster names lead session {lead_session}, which has no transcript, and "
                     if lead_session else "")
            return Resolution(reason=f"{named}{why}")

        if team and name:
            hits = self._stamped_candidates(name, team, verify=not quick)
            if hits:
                return Resolution(*hits[0], via="agentName+teamName stamps", strength=STAMPS, others=hits[1:])

        if name:
            rosters = self.name_rosters(name)
            if len(rosters) > 1:
                return Resolution(reason=(
                    f"no transcript stamped team={team} for {name!r}, and the bare name is in "
                    f"{len(rosters)} rosters, so it identifies nobody"
                ))
            hits = self._stamped_candidates(name, None, verify=not quick)
            if hits:
                return Resolution(
                    *hits[0], via="agentName only (unique across rosters)", strength=NAME_ONLY, others=hits[1:]
                )
        return Resolution(reason=f"no transcript found for {name or '?'}@{team or '?'}")

    def scan_teams(self):
        """Every member of every team config, newest-first metadata attached."""
        entries = []
        for cfg in (RESOLVER.roster_path(d.name) for d in RESOLVER.team_dirs()):
            try:
                data = json.loads(cfg.read_text())
            except (OSError, ValueError):
                continue
            mtime = int(cfg.stat().st_mtime * 1000)
            for member in data.get("members", []):
                entries.append(
                    {
                        "cfg": cfg,
                        "team": data.get("name") or cfg.parent.name,
                        "leadSessionId": data.get("leadSessionId"),
                        "leadAgentId": data.get("leadAgentId"),
                        "member": member,
                        "ts": member.get("joinedAt") or data.get("createdAt") or mtime,
                    }
                )
        return entries

    def _scan_transcript(self, path):
        """(fields, last_activity_ms) from one session JSONL."""
        fields = {}
        try:
            mtime = int(path.stat().st_mtime * 1000)
        except OSError:
            return {}, 0  # the harness rewrites this tree while we read it
        last_ts = first_ts = 0
        headers = []
        cwds = []

        def put(key, value, ts):
            if value in (None, ""):
                return
            if key not in fields or ts >= fields[key][1]:
                fields[key] = (value, ts)

        try:
            handle = path.open(errors="replace")
        except OSError:
            return {}, mtime
        with handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                ts = iso_ms(rec.get("timestamp"))
                if ts:
                    last_ts = max(last_ts, ts)
                    first_ts = first_ts or ts
                kind = rec.get("type")
                # header records carry no timestamp; stamp them with the first real one
                if kind == "agent-setting":
                    headers.append(("agentType", rec.get("agentSetting")))
                elif kind == "permission-mode":
                    headers.append(("permissionMode", rec.get("permissionMode")))
                elif kind == "mode":
                    headers.append(("mode", rec.get("mode")))
                for key in ("teamName", "agentName", "cwd", "version", "gitBranch", "effort"):
                    if rec.get(key) is not None:
                        put(key, rec[key], ts or mtime)
                if rec.get("cwd") and (not cwds or cwds[-1] != rec["cwd"]):
                    cwds.append(rec["cwd"])  # /cd moves it mid-session; keep the trail
                msg = rec.get("message")
                model = msg.get("model") if kind == "assistant" and isinstance(msg, dict) else None
                if model and not model.startswith("<"):
                    put("model", model, ts or mtime)  # skip "<synthetic>" error stubs

        for key, value in headers:
            put(key, value, first_ts or mtime)
        if cwds:
            fields["_cwds"] = (cwds, last_ts or mtime)  # underscore keys stay out of the merge
        return fields, (last_ts or mtime)

    def self_holds_transcript(self, session_uuid, table):
        """Are we ourselves the process holding this transcript?

        procs_on_transcript excludes our own lineage, because our argv quotes what
        we were asked to look for. That exclusion means an agent migrating itself
        never sees itself, so nothing is replaced and the launch becomes a second
        writer on one transcript, created by this tool.
        """
        mine = own_lineage(table)
        return [pid for pid, _, args in table
                if pid in mine and looks_like_claude(args)
                and f"--resume {session_uuid}" in _argv_pairs(args)]

    def session_registry(self):
        """Every ~/.claude/sessions/<pid>.json, parsed once. The registry is the
        only map from a transcript id to a live process, and two readers of it had
        already grown different ideas about liveness."""
        entries = []
        for path in SESSIONS_DIR.glob("*.json"):
            try:
                data = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if data.get("pid"):
                entries.append(data)
        return entries

    def _socket_from_pane_pid(self, pid, table):
        """A pane process's parent is the tmux server; its cmdline carries -L <socket>."""
        parents = {p: pp for p, pp, _ in table}
        ppid = parents.get(pid)
        if not ppid:
            return None
        match = re.search(r"-L\s+(\S+)", cmdline(ppid))
        return match.group(1) if match else None

    def socket_hosting(self, agent_ids, table):
        """(socket, why) for the live server already hosting any of these agents.

        The one rung in the socket ladder backed by a running process instead of a
        name, which is why it comes first and why both callers have to be the same
        code. Answered separately, a team can be sent to a socket derived from its
        lead's pid while its members sit on another server entirely.
        """
        for agent_id in agent_ids:
            if not agent_id:
                continue
            for pid, _ in self.live_agent_procs(agent_id, table):
                sock = self._socket_from_pane_pid(pid, table)
                if sock and socket_alive(sock):
                    return sock, f"live pane of pid {pid}"
                if sock:
                    warn(f"pid {pid} looked like a pane on {sock}, but that server is gone")
        return None, None

    def _spawn_by_agent(self):
        """{"name@team": payload} for every teammate any lead ever spawned.

        A member's colour, agent type and full model live in the roster, and the
        roster dies with its team. The lead that spawned it recorded all three, so
        this is where they survive. Only the transcripts that mention a spawn are
        read, which is a fraction of the tree.
        """
        if self.by_agent is not None:
            return self.by_agent
        self.by_agent = {}
        leads = self._grep_files(SPAWN_MARKER, [PROJECTS_DIR], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            for _, payload in self.spawn_log.get(path.stem, []):
                name, team = payload.get("name"), payload.get("team_name")
                if name and team:
                    self.by_agent[f"{name}@{team}"] = payload
        return self.by_agent

    def spawn_payload(self, agent_id, lead_session=None):
        """The harness's spawn record for an agent, wherever it survives.

        The single lookup for both the merge and the completion display, so an
        agent cannot be offered in one colour and launched in another. Cheap path
        first, the lead transcript the roster names; then the cross-file index,
        which is the only route once a team is named after a boot uuid whose
        transcript does not exist.
        """
        if not agent_id:
            return {}
        # Keyed on name and team together: a lead that respawns a name into a later
        # team holds a payload for each, and the name alone returns whichever came
        # last, which is the wrong life's colour and model.
        name, _, team = agent_id.partition("@")
        if lead_session and team:
            found = next((payload for payload in self.members_spawned_into(lead_session, team)
                          if payload.get("name") == name), None)
            if found:
                return found
        return self._spawn_by_agent().get(agent_id, {})

    def _spawn_records(self, lead_session):
        """{name: spawn payload} from the lead's transcript.

        Spawning a teammate writes the harness's whole payload into the lead's
        conversation: type, model with its [1m] suffix, color, pane id, prompt. That
        makes it the last-resort source for anything the roster would have held,
        and the only surviving one once a team dir is deleted, since no teammate
        transcript records its own color.
        """
        if not lead_session:
            return {}
        if lead_session in self.spawns:
            return self.spawns[lead_session]
        path = self.transcript_path(lead_session)
        self._ingest_spawn_lines([path] if path else [])
        return self.spawns.setdefault(lead_session, {})

    def stamp_index(self):
        """{path: (agentName, teamName)} for every stamped transcript, built once.

        Reads a bounded window of each file rather than grepping: every line carries
        the stamps, so the tail answers it, and the tail is also the *current* pair
        after a rebind. A file stamped only mid-history is missed here, which is why
        this powers path-only lookups and never resolution (verify=True greps whole
        files). Grep is the wrong tool for the index: -m1 exits early on stamped
        files but scans every byte of the unstamped ones, and this tree holds 2GB of
        those, which cost 1.7s per pass.
        """
        if self.stamps is not None:
            return self.stamps
        index = {}
        for path in PROJECTS_DIR.glob("*/*.jsonl"):
            try:
                size = path.stat().st_size
                with path.open("rb") as handle:
                    tail_at = max(0, size - INDEX_CHUNK)
                    if tail_at:
                        handle.seek(tail_at)
                    stamps = dict(STAMP_RE.findall(handle.read(INDEX_CHUNK)))
                    if not stamps and tail_at:  # a session stamped only after a resume
                        handle.seek(0)
                        stamps = dict(STAMP_RE.findall(handle.read(INDEX_CHUNK)))
            except OSError:
                continue
            if stamps:
                index[path] = (
                    (stamps.get(b"agentName") or b"").decode("utf-8", "replace") or None,
                    (stamps.get(b"teamName") or b"").decode("utf-8", "replace") or None,
                )
        self.stamps = index
        return self.stamps

    def team_lead_session(self, team):
        """The session id a team names as its lead's, via the roster reader."""
        return next((e["leadSessionId"] for e in self.scan_teams() if e["team"] == team), None)

    def team_minted_by(self, pid):
        """(team, exact) for the implicit team this live process is running as.

        `exact` is False when only the mint-window join could answer, which is a
        heuristic and therefore never grounds for acting without being asked.

        Exact evidence first, because the mint timing is not one thing: a team is
        sometimes minted eagerly at boot (a few hundred ms before the session file)
        and sometimes at the first spawn, minutes later and outside the window in
        the wrong direction. Both shapes exist on this box, so the window join is
        only ever a last resort.
        """
        entry = next((e for e in self.live_sessions() if e["pid"] == pid), None)
        if entry and entry.get("team"):
            # A flag-bound lead states the team it runs as, in its own argv.
            return entry["team"], True
        if entry and entry.get("session"):
            # Every teammate this lead spawned wrote a payload naming the team it
            # was running as. Only payloads from THIS life count: a resumed lead
            # keeps appending to the same transcript, so an older life's payload
            # names a team this process no longer runs as, and rebinding onto it
            # would cause exactly the orphaning --to-team exists to prevent.
            self._spawn_records(entry["session"])
            started = entry.get("started")
            for stamp, payload in reversed(self.spawn_log.get(entry["session"]) or []):
                # Without a start time there is no way to tell this life's payloads
                # from an earlier one's, so the rung declines rather than guessing.
                if payload.get("team_name") and started and stamp >= started:
                    return payload["team_name"], True
        return next((team for team, owner, _ in boot_join() if owner == pid), None), False

    def teams_led_by(self, session_stem):
        """Teams this transcript led, newest first.

        A lead resumed several times mints a fresh implicit team each life and keeps
        appending to one transcript, so several teams can be named by one file. The
        newest is the one it was running as when it stopped.
        """
        led = self.led_teams()
        mine = [(stamp, team) for team, hits in led.items()
                for stamp, path in hits if path.stem == session_stem]
        mine.sort(reverse=True)
        return [team for _, team in mine]

    def transcript_path(self, session_uuid):
        hits = sorted(PROJECTS_DIR.glob(f"*/{session_uuid}.jsonl"))
        if not hits:
            return None
        if len(hits) > 1:
            hits.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
            warn(f"{len(hits)} transcripts named {session_uuid}; using {hits[0]}")
        return hits[0]

    def _walk_spawn_payloads(self, node, depth=0):
        """Yield genuine spawn payloads inside a parsed transcript line.

        Structure, not text: a real payload is a dict the harness put there, so it
        is reached by walking the record. Strings are also parsed one level, since
        tool results carry their JSON as text, but prose that merely quotes a
        payload never becomes a dict and so never matches.
        """
        if depth > 10:  # deepest real payload seen is 5; leave room for another wrapper
            return
        if isinstance(node, dict):
            if node.get("status") == "teammate_spawned" and node.get("name"):
                yield node
            for value in node.values():
                yield from self._walk_spawn_payloads(value, depth + 1)
        elif isinstance(node, list):
            for value in node:
                yield from self._walk_spawn_payloads(value, depth + 1)
        elif isinstance(node, str) and SPAWN_MARKER in node and node.lstrip()[:1] in "{[":
            try:
                yield from self._walk_spawn_payloads(json.loads(node), depth + 1)
            except ValueError:
                return



RESOLVER = Resolver()




def proc_stat(pid):
    """(state, starttime) from /proc/pid/stat, fields 3 and 22."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None, None
    try:
        rest = stat[stat.rindex(")") + 2:].split()
        return rest[0], rest[19]
    except (ValueError, IndexError):
        return None, None


def pid_alive(pid, procstart=None):
    """A zombie is not alive. A ctrl-z'd process is: it still owns its session
    and will pick up where it left off; callers nudge instead of stepping on it."""
    state, st = proc_stat(pid)
    if st is None or state in ("Z", "X"):
        return False
    return procstart in (None, "", st)


def state_note(pid):
    """Suffix for a pid we are reporting as alive, when it needs a nudge."""
    state = proc_stat(pid)[0]
    if state in ("T", "t"):
        return f", suspended; `kill -CONT {pid}` (or fg) to wake it"
    return ""


# What a revived pane needs from the lead's environment. The harness's swarm
# server is started BY the leader, so its panes inherit these; a server we start
# does not, because tool subprocesses have the credentials scrubbed. A new
# server inherits them from us; topping up an existing one puts the value on a
# transient tmux client argv, which is why that path only runs for variables the
# server is actually missing.
AUTH_ENV = ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")
INHERIT_ENV = AUTH_ENV + ("CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",)


def proc_env(pid, names):
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return {}
    found = {}
    for item in raw.split(b"\0"):
        if b"=" not in item:
            continue
        key, value = item.split(b"=", 1)
        key = key.decode("utf-8", "replace")
        if key in names:
            found[key] = value.decode("utf-8", "replace")
    return found






def inherit_credentials(ctx):
    """Adopt the lead's credentials into our own env, so a tmux server we spawn
    passes them to its panes exactly as a harness-spawned server would.

    The lead pid comes from the ~/.claude chain (roster -> leadSessionId ->
    session registry), not from our process ancestry."""
    merged = ctx["merged"]
    pid, alive, _, _exact = RESOLVER.lead_pid(merged.pick("parentSessionId")[0], merged.pick("teamName")[0])
    if not (pid and alive):
        return []
    adopted = []
    for key, value in proc_env(pid, INHERIT_ENV).items():
        if not os.environ.get(key):
            os.environ[key] = value
            adopted.append(key)
    # Only shout when the revived agent would have no way to authenticate at
    # all. The usual setup keeps credentials in a file, and the traffic flag is
    # optional, so warning about either on every run trains you to ignore a tool
    # that kills things.
    if not any(os.environ.get(key) for key in AUTH_ENV) and not (CLAUDE_DIR / ".credentials.json").exists():
        warn("no auth env var on this lead and no ~/.claude/.credentials.json; "
             "the revived agent will have nothing to authenticate with")
    return sorted(adopted)


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
    except OSError:
        return ""


# ---------------------------------------------------------------- disk scanners





TITLE_RE = re.compile(rb'"type":"(ai|custom)-title","(?:aiTitle|customTitle)":"((?:[^"\\]|\\.)*)"')
TAG_RE = re.compile(r"</?[a-zA-Z][a-zA-Z0-9_-]*[^>]*>")

# roster color -> ANSI SGR, for colorizing completion candidates
COLOR_ANSI = {
    "red": "31", "green": "32", "yellow": "33", "blue": "34", "purple": "35",
    "magenta": "35", "cyan": "36", "orange": "38;5;208", "pink": "38;5;205",
}

# The harness's titler sometimes echoes a name instead of titling: a 559-line
# session titled "claude" six times, a 16728-line one titled
# "resume-background-agent" 1091 times. Real ai titles are natural language, so
# any whitespace-free ai title is treated as absent; this set catches multiword
# junk. Custom titles are exempt: the user typed those deliberately.
JUNK_TITLES = {"new session"}


def _json_str(raw):
    try:
        return json.loads('"' + raw.decode("utf-8", "replace") + '"')
    except ValueError:
        return raw.decode("utf-8", "replace")


def _first_user_message(head_lines):
    for line in head_lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") != "user" or rec.get("isMeta"):
            continue
        content = (rec.get("message") or {}).get("content")
        if isinstance(content, list):
            content = next((c.get("text") for c in content if isinstance(c, dict) and c.get("type") == "text"), None)
        if not isinstance(content, str) or content.startswith("Caveat:"):
            continue
        if any(tag in content for tag in ("<command-name>", "<local-command-caveat>", "<local-command-stdout>")):
            continue  # slash-command records wear a user hat but title nothing
        text = TAG_RE.sub(" ", content).strip()  # unwrap teammate-message/command tags
        if text:
            return text
    return None


def session_title(path, limit=60):
    """Newest custom title, else newest ai title, else the first real user message.

    Titles are rewritten throughout the file, so the tail almost always holds
    the current one; only title-less files pay for a head read.
    """
    def pick(found):
        for kind in (b"custom", b"ai"):
            raw = found.get(kind)
            if not raw:
                continue
            text = " ".join(_json_str(raw).split())
            if not text:
                continue
            if kind == b"ai" and (" " not in text or text.lower() in JUNK_TITLES):
                continue  # name echo, not a title
            return text
        return None

    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            fh.seek(max(0, size - TITLE_TAIL_BYTES))
            found = {}
            for match in TITLE_RE.finditer(fh.read()):
                found[match.group(1)] = match.group(2)  # last of each kind wins
            title = pick(found)
            if not title:
                had_records = bool(found)
                fh.seek(0)
                head = fh.read(TITLE_HEAD_BYTES).decode("utf-8", "replace")
                if not had_records:  # a junk newest title makes older ones suspect too
                    for match in TITLE_RE.finditer(head.encode()):
                        found[match.group(1)] = match.group(2)
                    title = pick(found)
                if not title:
                    title = _first_user_message(head.splitlines())
    except OSError:
        return None
    if not title:
        return None
    title = " ".join(re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", title).split())
    return title[: limit - 3] + "..." if len(title) > limit else title


UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)




# ------------------------------------------------------- transcript resolution
#
# One engine. Every caller that needs "which transcript is this agent" goes
# through RESOLVER.resolve_transcript(); nothing else may pick a file. Each rung records
# how it concluded, and the strength of that evidence, so callers can report it
# and verify_identity() can judge the conclusion without re-deriving it.

EXACT, STAMPS, NAME_ONLY = 3, 2, 1


class Resolution:
    """A chosen transcript plus how it was chosen. `path` None means no evidence."""

    def __init__(self, path=None, fields=None, last_ts=0, via="", strength=0, others=(), reason=""):
        self.path, self.fields, self.last_ts = path, fields or {}, last_ts
        self.via, self.strength, self.others, self.reason = via, strength, list(others), reason

    def __bool__(self):
        return self.path is not None

    def stamped(self, key):
        return self.fields.get(key, (None,))[0]


def lead_title(team_entries, team, limit=60):
    """Title for a team: its lead's session title, via the roster's leadSessionId."""
    for entry in team_entries:
        if entry["team"] == team and entry.get("leadSessionId"):
            res = RESOLVER.resolve_transcript(lead_session=entry["leadSessionId"], team=entry.get("team"),
                                     is_lead=True, quick=True)
            return session_title(res.path, limit) if res else None
    return None




def flatten_cwd(cwd):
    """A cwd's project dir name. Every non-alphanumeric becomes '-' (verified
    against 70 of this machine's project dirs). Lossy, so it has no inverse."""
    return re.sub(r"[^a-zA-Z0-9]", "-", cwd)














def agent_cwd(ctx):
    """Working dir for the revived process, or None. Never a guess.

    /cd moves a session's cwd mid-life, so a transcript records several, and the
    newest is not automatically right: --resume looks the session up under the
    project dir, and that dir tracks only one of them (usually the first, but
    not always: of 20 transcripts here that moved, most match their first cwd
    and at least one matches its last). So prefer whichever recorded cwd
    actually flattens to this transcript's own project dir, newest first, and
    fall back to the newest with a warning.

    The dir name itself is not a source: flattening maps every non-alphanumeric
    to '-', so '_', '.', ' ', '-' and '/' all collapse together (verified across
    70 project dirs), which leaves it with no inverse.
    """
    merged, path = ctx["merged"], ctx["transcript"][0]
    trail = list(ctx["transcript"][1].get("_cwds", ([],))[0])
    roster_cwd = (ctx.get("team_entry") or {}).get("member", {}).get("cwd")
    candidates = trail + ([roster_cwd] if roster_cwd else [])
    project = path.parent.name

    consistent = [c for c in candidates if flatten_cwd(c) == project]
    if consistent:
        return consistent[-1]
    if candidates:
        if len(set(candidates)) > 1:
            warn(f"cwd moved during this session ({' -> '.join(dict.fromkeys(candidates))}); "
                 f"none flattens to project dir {project}, using the newest")
        return candidates[-1]
    fallback = merged.pick("cwd")[0]
    if not fallback:
        warn("no cwd recorded in roster or transcript; launching without -c "
             "(the pane inherits the tmux server's cwd, which may break --resume lookup)")
    return fallback or None




def team_souls(team, entries=None):
    """{name: Resolution} for everything in a team the resolver can still find.

    "Is there anything here to resurrect" is the engine's own question, so it
    is answered here once: the reaper uses it to decide what is cruft, and the
    completion labels use it to mark teams that cannot come back. Answering it
    anywhere else means a team could be advertised as revivable and deleted by
    the same run.
    """
    if entries is None:
        entries = [e for e in RESOLVER.scan_teams() if e["team"] == team]
    souls = {}
    lead_session = entries[0]["leadSessionId"] if entries else None
    if lead_session:
        found = RESOLVER.resolve_transcript(lead_session=lead_session, team=team, is_lead=True, quick=True)
        if found:
            souls["team-lead"] = found
    for entry in entries:
        name = entry["member"].get("name")
        if name and name != "team-lead" and name not in souls:
            found = RESOLVER.resolve_transcript(team=team, name=name, quick=True)
            if found:
                souls[name] = found
    return souls


def verify_identity(res, want_name, want_team, allow_team_change, force):
    """Judge the conclusion, not the path that reached it.

    Whatever rung resolution used, the transcript we are about to resume must
    not belong to somebody else: a process launched with --agent-id X wearing
    Y's conversation is the worst outcome this tool can produce.
    """
    stamped_name, stamped_team = res.stamped("agentName"), res.stamped("teamName")

    if stamped_name is None:
        # Unstamped means a lead transcript. Only an exact rung may claim one.
        if res.strength < EXACT:
            message = (f"{res.path.name} carries no agent stamps and was matched by {res.via}; "
                       "only an exact session id may claim an unstamped transcript")
            if not force:
                die(f"{message} (--force to override)")
            warn(f"--force: {message}")
        return

    if want_name and stamped_name != want_name:
        message = (f"{res.path.name} is stamped agentName={stamped_name!r}, not {want_name!r} "
                   f"(matched by {res.via})")
        if not force:
            die(f"{message}; refusing to resume another agent's conversation (--force to override)")
        warn(f"--force: {message}; resuming another agent's conversation anyway")

    if want_team and stamped_team and stamped_team != want_team:
        # Legitimate when rebinding, when the name proved unique anyway, or when a
        # live process wearing this identity is what identified the transcript. In
        # that last case the stamps are the stale half by construction: they record
        # the team the agent was in when those lines were written, argv records the
        # team it is in now, and a rebind is exactly what puts the two out of step.
        # Dying here would refuse to resume an agent that is running in front of us.
        if allow_team_change or res.strength == NAME_ONLY or res.via.startswith("live pid "):
            warn(f"{res.path.name} is stamped team={stamped_team}, resuming as {want_team}")
        elif not force:
            die(f"{res.path.name} is stamped team={stamped_team}, not {want_team} "
                f"(matched by {res.via}); --force to override")
        else:
            warn(f"--force: {res.path.name} is stamped team={stamped_team}, resuming as {want_team}")


def apply_selector(token, args, table):
    """Turn the bare leading argument into --resume or --agent-id."""
    if UUID_RE.match(token):
        if args.resume and args.resume != token:
            die(f"conflicting sessions: {token} and --resume {args.resume}")
        args.resume = token
        return
    if "@" in token:
        if args.agent_id and args.agent_id != token:
            die(f"conflicting agents: {token} and --agent-id {args.agent_id}")
        args.agent_id = token
        return
    if RESOLVER.roster_path(token).exists():
        args.team = token
        return

    matches = [e for e in RESOLVER.scan_teams() if e["member"].get("name") == token]
    matches.sort(key=lambda e: e["ts"], reverse=True)
    if matches:
        if len({e["team"] for e in matches}) > 1:
            # Same rule the resolver applies: a name living in several rosters is
            # not an identity. Choosing "newest" here would silently decide whose
            # conversation gets resumed.
            warn(f"{token!r} is in {len(matches)} rosters, so it names nobody; pick one:")
            for entry in matches:
                agent_id = entry["member"].get("agentId")
                procs = RESOLVER.live_agent_procs(agent_id, table)
                state = f"running{state_note(procs[0][0])}" if procs else "not running"
                warn(f"    {agent_id:<44} joined {ms_str(entry['ts'])}  [{state}]")
            die("pass one of those ids, or a session uuid")
        args.agent_id = matches[0]["member"].get("agentId")
        return

    res = RESOLVER.resolve_transcript(name=token)
    if not res:
        die(f"no agent named {token!r} in any roster: {res.reason}")
    warn(f"no team config lists {token!r}; matched by transcript ({res.via})")
    if res.others:
        warn(f"{len(res.others) + 1} transcripts for {token!r}:")
        for path, fields, last_ts in [(res.path, res.fields, res.last_ts)] + res.others:
            warn(f"    {path.name}  team={fields.get('teamName', (None,))[0]}  last active {ms_str(last_ts)}")
        warn(f"  choosing the most recent: {res.path.name}")
    args.resume = res.path.stem
    if res.stamped("teamName"):
        args.agent_id = args.agent_id or f"{token}@{res.stamped('teamName')}"




def boot_join():
    """[(team, pid, createdAt)] pairing each implicit team with the live process
    that minted it, newest first.

    A boot mints its implicit team named after its internal session id, while
    sessions/<pid>.json keeps the *resumed transcript* id. The two diverge after
    a resume (before one they are the same id, which lead_pid exploits as an
    exact join), and nothing else records the post-resume internal id, so for
    those teams time is a join of last resort: a
    team dir is created a few hundred ms before the session file when a boot
    mints it eagerly (measured 281, 252 and 402ms), but it can instead be
    minted at the first spawn, minutes later, which this window does not cover.
    That is why the exact rungs above it are tried first.
    """
    live = [
        (data["pid"], data.get("startedAt") or 0)
        for data in RESOLVER.session_registry()
        if pid_alive(data["pid"], data.get("procStart"))
    ]
    pairs = []
    for cfg in (RESOLVER.roster_path(d.name) for d in RESOLVER.team_dirs()):
        try:
            data = json.loads(cfg.read_text())
        except (OSError, ValueError):
            continue
        created = data.get("createdAt") or 0
        for pid, started in live:
            if 0 <= started - created <= TEAM_MINT_WINDOW_MS:
                pairs.append((data.get("name") or cfg.parent.name, pid, created))
    pairs.sort(key=lambda item: item[2], reverse=True)
    for team in {name for name, _, _ in pairs}:
        owners = {pid for name, pid, _ in pairs if name == team}
        if len(owners) > 1:
            warn(f"{team} pairs with {len(owners)} processes started within "
                 f"{TEAM_MINT_WINDOW_MS}ms ({', '.join(map(str, sorted(owners)))}); "
                 "the pick between them is arbitrary")
    return pairs






def resolve_to_team(args, ctx):
    """--to-team live -> the team this agent's own lead is currently running as.

    Pure ~/.claude hops, no process tree: the agent's roster names its lead
    session, the session registry maps that to a live pid, and that pid's boot
    timestamp identifies the team it minted.
    """
    if args.to_team not in ("live", "auto"):
        cfg = RESOLVER.roster_path(args.to_team)
        if not cfg.exists():
            die(f"no team config at {cfg}")
        return args.to_team

    merged = ctx["merged"]
    source = merged.pick("teamName")[0]
    pid, alive, how, _exact = RESOLVER.lead_pid(merged.pick("parentSessionId")[0], source)
    if not (pid and alive):
        die(f"no live lead for team {source}; pass --to-team <name> explicitly")
    dest, _ = RESOLVER.team_minted_by(pid)
    if not dest:
        die(f"cannot tell which team pid {pid} runs as; pass --to-team <name> explicitly")
    print(f"rebind   {how}, now running as team {dest}")
    return dest






























# ---------------------------------------------------------------- tmux

def tmux(socket, *args):
    return subprocess.run(["tmux", "-L", socket, *args], capture_output=True, text=True)


def socket_dir():
    return Path(os.environ.get("TMUX_TMPDIR") or f"/tmp/tmux-{os.getuid()}")


def socket_alive(socket):
    """Is a tmux server listening on this socket?

    One test, everywhere. A connect() answers it in microseconds; asking tmux
    costs a process spawn each time, and having two tests meant a socket could
    be 'dead' to the reaper and 'live' to the launcher.
    """
    path = socket if isinstance(socket, Path) else socket_dir() / socket
    probe = socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM)
    probe.settimeout(0.2)
    try:
        probe.connect(str(path))
        return True
    except (ConnectionRefusedError, FileNotFoundError):
        return False
    except OSError:
        return True  # ambiguous: assume live rather than reap or clobber
    finally:
        probe.close()


def swarm_sockets():
    """Swarm socket files, newest first. The one place that directory is listed."""
    return sorted(socket_dir().glob(f"{SOCKET_PREFIX}*"), key=lambda p: p.stat().st_mtime, reverse=True)


def list_panes(socket):
    res = tmux(socket, "list-panes", "-a", "-F", "#{session_name}\t#{window_id}\t#{pane_id}\t#{pane_pid}")
    if res.returncode != 0:
        return []
    panes = []
    for line in res.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[3].isdigit():
            panes.append({"session": parts[0], "window": parts[1], "pane": parts[2], "pid": int(parts[3])})
    return panes


def descendants(root_pid, table):
    kids = defaultdict(list)
    for pid, ppid, _ in table:
        kids[ppid].append(pid)
    seen, stack = set(), [root_pid]
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        stack.extend(kids.get(pid, []))
    return seen


CLAUDE_PROC = re.compile(r"(^|/)claude$|/versions/[\d.]+$")


def looks_like_claude(args):
    """Match on argv[0] only. A tmux server's own cmdline embeds the whole
    spawn command, so searching the full args counts the server as an agent."""
    argv0 = args.split(None, 1)[0] if args.strip() else ""
    return bool(CLAUDE_PROC.search(argv0))


def pane_occupants(socket, pane_id, table):
    """(pane_exists, [(pid, args)] of claude processes running in it)."""
    by_pid = {pid: args for pid, _, args in table}
    for pane in list_panes(socket):
        if pane["pane"] != pane_id:
            continue
        procs = [(pid, by_pid.get(pid, "")) for pid in descendants(pane["pid"], table)]
        return True, [(pid, args) for pid, args in procs if looks_like_claude(args)]
    return False, []


def own_lineage(table):
    """Our own pid and ancestors, whose cmdlines quote the agent id we searched for."""
    parents = {p: pp for p, pp, _ in table}
    pid, chain = os.getpid(), set()
    while pid and pid not in chain:
        chain.add(pid)
        pid = parents.get(pid)
    return chain


def _argv_pairs(args):
    """{"--flag value"} for each flag/value pair in a cmdline, both spellings.

    Substring matching would let `--agent-id alpha@team` match a process running
    `--agent-id alpha@team2`, which for forged team names is a real collision.
    """
    tokens = args.split()
    pairs = set()
    for index, token in enumerate(tokens):
        if not token.startswith("-"):
            continue
        if "=" in token:
            flag, _, value = token.partition("=")
            pairs.add(f"{flag} {value}")
        elif index + 1 < len(tokens):
            pairs.add(f"{token} {tokens[index + 1]}")
    return pairs


def claude_procs(needle, table):
    """Live claude processes whose argv contains this exact flag/value pair,
    excluding our own lineage (whose cmdline quotes what we searched for)."""
    mine = own_lineage(table)
    return [
        (pid, args)
        for pid, _, args in table
        if needle in _argv_pairs(args) and pid not in mine and looks_like_claude(args)
    ]










# ---------------------------------------------------------------- resolution

class Merged:
    """Field values from many sources; most recent wins."""

    def __init__(self):
        self.cands = defaultdict(list)

    def add(self, field, value, ts, source):
        if value in (None, ""):
            return
        self.cands[field].append((value, ts or 0, source))

    def pick(self, field, prefer_specific=False):
        cands = self.cands.get(field)
        if not cands:
            return None, None, None
        value, ts, source = max(cands, key=lambda c: c[1])
        if prefer_specific and isinstance(value, str):
            # e.g. jsonl records "claude-opus-5" but the team config kept
            # "claude-opus-5[1m]", same model, one is simply lossier.
            # Only a bracketed variant counts (claude-opus-5 -> claude-opus-5[1m]).
            # Any longer string would let a stale roster silently revert a model
            # the user changed mid-session.
            richer = [c for c in cands if isinstance(c[0], str) and c[0].startswith(value + "[")]
            if richer:
                value, ts, source = max(richer, key=lambda c: len(c[0]))
                source += " (more specific)"
        return value, ts, source

    def conflicts(self, field):
        return {c[0] for c in self.cands.get(field, [])}


def build(args):
    merged = Merged()
    team_entry = None
    transcript = None
    session_uuid = args.resume
    others = []

    if args.agent_id:
        matches = [e for e in RESOLVER.scan_teams() if e["member"].get("agentId") == args.agent_id]
        if matches:
            matches.sort(key=lambda e: e["ts"], reverse=True)
            team_entry = matches[0]
            if len(matches) > 1:
                warn(f"{len(matches)} team configs claim {args.agent_id}; using {team_entry['cfg']}")
        else:
            warn(f"no team config lists {args.agent_id}; falling back to name@team parsing")

    team = name = None
    if team_entry:
        team, name = team_entry["team"], team_entry["member"].get("name")
    elif args.agent_id and "@" in args.agent_id:
        name, team = args.agent_id.split("@", 1)

    worn_id = f"{name}@{team}" if name and team else None
    is_lead_member = bool(team_entry) and team_entry["member"].get("agentId") == team_entry.get("leadAgentId")
    res = RESOLVER.resolve_transcript(
        session_uuid=session_uuid,
        lead_session=team_entry.get("leadSessionId") if is_lead_member else None,
        team=team,
        name=name,
        is_lead=is_lead_member,
    )
    if not res:
        die(
            f"{res.reason}; a truly in-process agent leaves only a sidechain under the lead's "
            "subagents/ dir, which no CLI can resume"
        )
    verify_identity(res, name, team, allow_team_change=bool(args.to_team), force=args.force)
    transcript = (res.path, res.fields, res.last_ts)
    others = [(p, f, t) for p, f, t in res.others]
    session_uuid = res.path.stem

    if not team_entry:  # a uuid or a stranger's id: adopt the roster the transcript names
        stamped_team, stamped_name = res.stamped("teamName"), res.stamped("agentName")
        if stamped_team and stamped_name:
            matches = [
                e for e in RESOLVER.scan_teams()
                if e["team"] == stamped_team and e["member"].get("name") == stamped_name
            ]
            matches.sort(key=lambda e: e["ts"], reverse=True)
            team_entry = matches[0] if matches else None
        elif not stamped_name and not stamped_team:
            # Nothing stamped this transcript, so it is not a teammate's: only a
            # lead writes an unstamped one. Ask the payloads it wrote which team
            # it was running as, and adopt that team's lead entry. Without this
            # the run falls through to the member path and dies asking for a
            # tmux socket, which is several steps downstream of the real answer.
            for led in RESOLVER.teams_led_by(session_uuid):
                matches = [
                    e for e in RESOLVER.scan_teams()
                    if e["team"] == led and e["member"].get("agentId") == e.get("leadAgentId")
                ]
                matches.sort(key=lambda e: e["ts"], reverse=True)
                if matches:
                    team_entry = matches[0]
                    break
                # The team dir is gone, so state the identity the payloads prove
                # and let forge_team rebuild the roster around it.
                merged.add("teamName", led, res.last_ts, "spawn payloads in this transcript")
                merged.add("agentName", "team-lead", res.last_ts, "spawn payloads in this transcript")
                merged.add("agentId", f"team-lead@{led}", res.last_ts, "spawn payloads in this transcript")
                break
            else:
                # Nothing stamped it and it spawned nobody, so it is neither a
                # teammate's transcript nor a lead's. Say that, rather than
                # continuing down the member path to fail on a missing socket,
                # which describes a pane this transcript was never going to get.
                if not args.agent_id:
                    die(
                        f"{res.path.name} carries no agent stamps, so it is not a teammate's, "
                        "and records spawning no teammates, so it never led a team either. "
                        "There is no agent identity to restore here: resume it with plain "
                        "`claude --resume`, or pass --agent-id to give it one."
                    )

    # ---- team config contributions
    if team_entry:
        member, ts, src = team_entry["member"], team_entry["ts"], f"team:{team_entry['cfg']}"
        merged.add("agentId", member.get("agentId"), ts, src)
        merged.add("agentName", member.get("name"), ts, src)
        merged.add("teamName", team_entry["team"], ts, src)
        merged.add("color", member.get("color"), ts, src)
        merged.add("agentType", member.get("agentType"), ts, src)
        merged.add("model", member.get("model"), ts, src)
        merged.add("cwd", member.get("cwd"), ts, src)
        merged.add("tmuxPaneId", member.get("tmuxPaneId"), ts, src)
        merged.add("backendType", member.get("backendType"), ts, src)
        merged.add("parentSessionId", team_entry["leadSessionId"], ts, src)
        if member.get("planModeRequired"):
            merged.add("permissionMode", "plan", ts, src)

    # ---- transcript contributions
    path, fields, last_ts = transcript
    src = f"jsonl:{path.name}"
    for field, (value, ts) in fields.items():
        if not field.startswith("_"):
            merged.add(field, value, ts, src)
    if not merged.cands.get("agentId"):
        name = fields.get("agentName", (None,))[0]
        team = fields.get("teamName", (None,))[0]
        if name and team:
            merged.add("agentId", f"{name}@{team}", last_ts, src + " (derived)")

    # ---- a worn identity pins the identity triple
    # When a live process is what identified this transcript, that process is
    # wearing the identity now: its argv carries --agent-id and --team-name, so
    # this is evidence already held rather than a derivation. Stamps are older
    # lines on the same file and a rebind is exactly what puts them out of step,
    # so per-field most-recent-wins can otherwise take the id from one source and
    # the team from another, and emit a command wearing two different teams.
    # Non-identity fields keep normal merge semantics.
    if res.via.startswith("live pid ") and worn_id and "@" in worn_id:
        worn_name, _, worn_team = worn_id.partition("@")
        pinned = last_ts + 1  # outranks anything the transcript itself can say
        merged.add("agentId", worn_id, pinned, "live argv")
        merged.add("agentName", worn_name, pinned, "live argv")
        merged.add("teamName", worn_team, pinned, "live argv")

    # ---- last resort: the lead's record of spawning this member
    # Timestamp 0 so it loses every tie: it is a snapshot from spawn time, and
    # the roster or the transcript is newer whenever either has the field. Read
    # lazily, since the lead transcript can be megabytes.
    # Consulted unconditionally, not only when a field is missing: "present" is
    # not "good". A roster can hold claude-opus-5 where the spawn record holds
    # claude-opus-5[1m], and gating on absence would let that degraded value
    # stick forever. One cached read of the lead transcript per process.
    record = RESOLVER.spawn_payload(merged.pick("agentId")[0], merged.pick("parentSessionId")[0])
    if record:
        for key, field in SPAWN_FIELDS.items():
            merged.add(field, record.get(key), 0, "lead transcript spawn record")
        if record.get("plan_mode_required"):
            merged.add("permissionMode", "plan", 0, "lead transcript spawn record")

    # A dead team dir takes leadSessionId with it. Asking the engine rather than
    # globbing here keeps one answer to "which session led this team": the glob is
    # the engine's weakest rung, below the roster and the payloads, and reaching
    # for it directly skipped both.
    if not merged.cands.get("parentSessionId"):
        lead = RESOLVER.lead_session_for(merged.pick("teamName")[0] or "")
        if lead:
            merged.add("parentSessionId", lead, transcript[2], "engine: lead session for team")

    return {
        "merged": merged,
        "team_entry": team_entry,
        "transcript": transcript,
        "session_uuid": session_uuid,
        "other_transcripts": others,
        # A lead reached by rung 4 has no roster entry yet, so its own merged id
        # is the answer: the payloads that named its team also make it the lead.
        "lead_agent_id": (team_entry["leadAgentId"] if team_entry
                          else (aid if (aid := merged.pick("agentId")[0])
                                and merged.pick("agentName")[0] == "team-lead" else None)),
        "via": res.via,
    }




def resolve_socket(ctx, args, table):
    """--socket > socket hosting a live process for this agent > lead pid > invent."""
    merged = ctx["merged"]
    agent_id = merged.pick("agentId")[0]

    if args.socket:
        return args.socket, getattr(args, "socket_reason", "--socket")

    sock, why = RESOLVER.socket_hosting([agent_id], table)
    if sock:
        return sock, why

    # When rebinding, the member is being placed on the DESTINATION lead's
    # server; asking about the source team fails outright when that team is dead,
    # which is the usual reason for rebinding in the first place.
    team = ctx.get("to_team") or merged.pick("teamName")[0]
    parent = ctx.get("to_lead") if ctx.get("to_team") else merged.pick("parentSessionId")[0]
    pid, alive, how, _exact = RESOLVER.lead_pid(parent, team)
    if pid and not alive:
        # A pid is only a socket name while its process exists. Pid numbers are
        # recycled, so a server named after a dead one is either absent or, worse,
        # a live stranger's, and members would silently join it. Fall through to
        # the team's own server, which is what the rung below stands the team up on.
        warn(f"the lead last ran as pid {pid}, which is gone; using the team's own server")
        pid = None
    if pid:
        if not ctx.get("to_team"):
            # The lead is up but has since minted a new implicit team. Reviving
            # into the old roster still works, but the lead's SendMessage
            # resolves against the team it runs as now, so mail to this member
            # would land in an inbox directory nobody reads.
            current, _ = RESOLVER.team_minted_by(pid)
            if current and team and current != team and not ctx.get("stale_team_warned"):
                warn(f"the lead is live but now runs as team {current}, not {team}; "
                     f"without --to-team live this member will be mailbox-orphaned")
        return f"{SOCKET_PREFIX}{pid}", how

    # The team's lead is gone, so stand its own server back up rather than
    # borrowing a live stranger's. The members keep their original identity, so
    # they belong together on their own server, not scattered onto whichever
    # session happens to be running. Named after the team, so every member of it
    # lands on the same server across invocations, exactly as if the lead were
    # still up and hosting them.
    if team:
        warn(f"no live lead for {team}; standing up that team's own server, as if its lead were up")
        return f"{SOCKET_PREFIX}{team}", f"resurrected server for {team}"
    return None, None


def current_tmux():
    """(socket name, pane id) of the pane we are running in, or (None, None).

    $TMUX is "<socket path>,<server pid>,<session index>", so the socket we are
    inside is knowable without asking tmux anything.
    """
    inside = os.environ.get("TMUX")
    if not inside:
        return None, None
    return Path(inside.split(",")[0]).name, os.environ.get("TMUX_PANE")


def swarm_session_live(socket):
    """Is the swarm session actually up on this socket? Server plus session:
    a live server with no claude-swarm session still needs one created."""
    return bool(socket) and socket_alive(socket) and tmux(socket, "has-session", "-t", TMUX_SESSION).returncode == 0


def socket_state(socket):
    """What is actually true of this socket right now.

    The `how` label only says where the name came from. Printing that alone
    invites reading a derived name as a running server, which is how a socket
    that had just been killed still read as live.
    """
    if not socket:
        return "unresolved"
    if not socket_alive(socket):
        return "no server, will be created"
    if not swarm_session_live(socket):
        return f"server up, no {TMUX_SESSION} session, will be created"
    clients = attached_clients(socket)
    return f"live, {clients} client{'' if clients == 1 else 's'} attached"


def attached_clients(socket):
    result = tmux(socket, "list-clients", "-t", TMUX_SESSION)
    return len([line for line in result.stdout.splitlines() if line]) if result.returncode == 0 else 0


def maybe_attach(args, socket):
    """Attach to the swarm unless something says not to, then say why not.

    Reviving an agent you cannot see is half a job, so a session nobody is
    watching gets attached. Three things veto it: CLAUDECODE, which means a
    tool is driving and would have its shell replaced by a tmux client; no tty
    to attach; and being inside tmux already, where attaching another server
    nests clients.
    """
    if not socket or args.no_attach:
        return
    if not socket_alive(socket):
        # Every veto below is about whether attaching is wanted. This one is
        # about whether there is anything to attach to, so it comes first and
        # suggests no command: a run where nothing launched leaves an empty
        # socket, and printing "attach with ..." for it sends you at a server
        # that was never stood up.
        print(f"nothing to attach to: no server on {socket}")
        return
    reason = None
    if os.environ.get("CLAUDECODE"):
        reason = "a Claude Code tool is driving"
    elif not sys.stdout.isatty():
        reason = "not a terminal"
    elif os.environ.get("TMUX"):
        reason = "already inside tmux"
    elif not args.attach and attached_clients(socket):
        reason = "someone is already watching it"

    if reason and not args.attach:
        print(f"attach with: tmux -L {socket} attach -t {TMUX_SESSION}   ({reason})")
        return
    if reason and args.attach:
        warn(f"--attach requested but {reason}; attach by hand: tmux -L {socket} attach -t {TMUX_SESSION}")
        return
    print(f"attaching to {socket}")
    os.execvp("tmux", ["tmux", "-L", socket, "attach", "-t", TMUX_SESSION])


# roster colour -> tmux colour, for the names where they differ (2.1.202 map)
TMUX_COLORS = {"purple": "magenta", "orange": "colour208", "pink": "colour205"}


LAUNCH_APPEAR_S = 10.0   # only ever waited out when nothing appears at all
LAUNCH_SETTLE_S = 1.5    # then confirm it did not exit immediately


def launch_present(socket, pane, agent_id):
    fresh = RESOLVER.ps_table(refresh=True)
    if agent_id and claude_procs(f"--agent-id {agent_id}", fresh):
        return True
    if pane:
        _, occupants = pane_occupants(socket, pane, fresh)
        if occupants:
            return True
    return False


def launch_survived(socket, pane, agent_id, transcript=None, since=None):
    """Did a claude come up and stay up? Asked before the roster is told it did.

    Two different failures, so two waits. Appearing is near-instant: the pane
    execs the binary and reads the transcript afterwards, so an 81MB session is
    visible in under a tenth of a second, and this timeout is only ever waited
    out when nothing appears at all. Dying immediately afterwards (bad auth, a
    transcript it cannot load) is the one that would otherwise be recorded as a
    live member, so a launch is also given a moment and re-checked.
    """
    deadline = time.monotonic() + LAUNCH_APPEAR_S
    while not launch_present(socket, pane, agent_id):
        if time.monotonic() > deadline:
            return False, f"nothing appeared in {LAUNCH_APPEAR_S:.0f}s"
        time.sleep(0.1)
    # A booting agent writes its own transcript within seconds, which says more
    # than "a process exists": it got far enough to load the session. Waiting
    # for that beats waiting out the settle, so take it as soon as it lands.
    settle_until = time.monotonic() + LAUNCH_SETTLE_S
    while time.monotonic() < settle_until:
        if transcript and since is not None:
            try:
                if transcript.stat().st_mtime > since:
                    return True, "wrote to its transcript"
            except OSError:
                pass
        time.sleep(0.1)
    if not launch_present(socket, pane, agent_id):
        return False, f"it started and exited within {LAUNCH_SETTLE_S:.1f}s"
    return True, "running, no transcript write yet"


def tint_pane(socket, pane, colour, name, dry):
    """Tint a pane the way the harness tints its own.

    A pane this tool creates gets no tint (only a real spawn applies one), so
    without this a revived agent is the one grey pane in a coloured swarm. It
    is three pane options plus the bold titled border, matching what the
    harness does, so revived and spawned members look alike.
    """
    if not (colour or name) or (not pane and not dry):
        return
    tint = TMUX_COLORS.get(colour, colour)
    actions = []
    if tint:
        actions += [
            ("set-option", "-p", "-t", pane, "window-style", f"bg=default,fg={tint}"),
            ("set-option", "-p", "-t", pane, "pane-border-style", f"fg={tint}"),
            ("set-option", "-p", "-t", pane, "pane-active-border-style", f"fg={tint}"),
        ]
    if name:
        actions.append(("select-pane", "-t", pane, "-T", name))
        actions.append(("set-option", "-p", "-t", pane, "pane-border-format",
                        f"#[fg={tint or 'default'},bold] #{{pane_title}} #[default]"))
    where = f"{pane or '<new pane>'} {tint or '(no colour)'}, titled {name}"
    if not dry:
        for action in actions:
            tmux(socket, *action)
    step(dry, f"would tint {where}", f"tinted {where}")


def pane_of_pid(socket, pid, table):
    for pane in list_panes(socket):
        if pid in descendants(pane["pid"], table):
            return pane["pane"]
    return None


def launch(socket, want_pane, cwd, command, dry, replace_pane=None):
    """Start the agent: reuse the socket/session if live, else rebuild it.

    Never reuses an occupied pane: the caller has already decided that whatever
    lives in the recorded pane is not this agent, so we always get our own pane.
    """
    session_live = swarm_session_live(socket)
    # -u ANTHROPIC_BASE_URL: a real resume must never inherit a poison left on
    # the server by an interrupted Recipe 1 run.
    quoted = (
        "exec env -u ANTHROPIC_BASE_URL "
        + " ".join(TEAM_ENV) + " "
        + " ".join(shlex.quote(c) for c in command)
    )

    if replace_pane and not session_live:
        # The caller decided a specific pane must die. If the session is gone we
        # cannot honor that, and silently downgrading would leave the old
        # process alive while the report claimed it was replaced.
        warn(f"cannot replace pane {replace_pane}: no live {TMUX_SESSION} session on {socket}")
        replace_pane = None

    if session_live and not dry:
        # An existing server has whatever env it was born with. Top up only
        # what is missing; a secret's value rides a transient client argv here,
        # so skip it whenever the server already has the variable.
        for key in INHERIT_ENV:
            if os.environ.get(key) and tmux(socket, "show-environment", "-g", key).returncode != 0:
                tmux(socket, "set-environment", "-g", key, os.environ[key])

    if replace_pane and session_live:
        # This pane holds a live process resuming the same transcript, so kill it
        # in place rather than leave two processes appending to one JSONL.
        argv = ["respawn-pane", "-k", "-t", replace_pane]
        action = "respawn"
    elif not session_live:
        if not socket_alive(socket):
            warn(f"socket {socket} is down, reestablishing")
        else:
            warn(f"session {TMUX_SESSION} missing on {socket}, recreating")
        argv = ["new-session", "-d", "-s", TMUX_SESSION, "-n", TMUX_WINDOW, "-P", "-F", "#{pane_id}"]
        action = "new-session"
    elif want_pane and any(p["pane"] == want_pane for p in list_panes(socket)):
        argv = ["split-window", "-t", want_pane, "-P", "-F", "#{pane_id}"]
        action = "split"
    else:
        if want_pane:
            warn(f"recorded pane {want_pane} no longer exists on {socket}")
        panes = [p for p in list_panes(socket) if p["session"] == TMUX_SESSION]
        if panes:
            argv = ["split-window", "-t", panes[0]["pane"], "-P", "-F", "#{pane_id}"]
            action = "split"
        else:
            argv = ["new-window", "-t", TMUX_SESSION, "-n", TMUX_WINDOW, "-P", "-F", "#{pane_id}"]
            action = "new-window"
    if cwd:
        argv += ["-c", cwd]
    argv.append(quoted)

    rendered = f"tmux -L {socket} {' '.join(shlex.quote(a) for a in argv)}"
    if dry:
        step(True, f"would run: {rendered}", "")
        return (replace_pane if action == "respawn" else None), action
    res = tmux(socket, *argv)
    if res.returncode != 0:
        die(f"tmux {argv[0]} failed: {res.stderr.strip()}")
    step(False, "", f"ran: {rendered}")
    # respawn-pane takes no -P/-F, so it prints nothing: the pane is the one we
    # aimed at. Everything else printed its new pane id.
    return (replace_pane if action == "respawn" else res.stdout.strip()), action


