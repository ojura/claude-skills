@unit(
    ('completion-answer-is-deeply-immutable',
     'the Resolver completion answer retains only immutable topic rows'),
    ('completion-consumes-one-complete-answer',
     'completion emits immutable Resolver rows without reading or explaining team evidence'),
)
def _check_completion_consumes_one_complete_answer(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    try:
        answer = s.corpus_engine().completion_answer("teams")
        answer_faults = mutable_nodes(answer)
        answer_ok = (not answer_faults and answer["topic"] == "teams"
                     and isinstance(answer["entries"], tuple))
    except BaseException as exc:
        answer_ok, answer_faults = False, [f"raised {type(exc).__name__}"]
    check("completion-answer-is-deeply-immutable",
          "the Resolver completion answer retains only immutable topic rows",
          answer_ok, ", ".join(answer_faults[:3]))

    ast = s.ast
    consumer = s.funcs["_complete"]
    questions = sorted(
        question for question, callers in s.resolver_calls.items()
        if "_complete" in callers)
    attributes = sorted(
        attribute for attribute, callers in s.resolver_attributes.items()
        if "_complete" in callers)

    def own_nodes(function):
        pending = list(reversed(function.body))
        while pending:
            node = pending.pop()
            yield node
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef,
                                 ast.ClassDef, ast.Lambda)):
                continue
            pending.extend(reversed(list(ast.iter_child_nodes(node))))

    nodes = tuple(own_nodes(consumer))
    raw_file_methods = {"open", "read", "read_bytes", "read_text", "stat",
                        "glob", "iterdir"}
    raw_file_reads = sorted(
        f"{node.func.attr} at line {node.lineno}"
        for node in nodes if isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr in raw_file_methods)
    sentence_values = {
        "agent_id", "candidate", "description", "entry", "evidence", "joined",
        "member", "name", "path", "team", "title",
    }
    semantic_sentences = []
    for node in nodes:
        if not isinstance(node, (ast.JoinedStr, ast.BinOp)):
            continue
        if isinstance(node, ast.BinOp) and not isinstance(node.op, ast.Add):
            continue
        names = {part.id for part in ast.walk(node) if isinstance(part, ast.Name)}
        if names & sentence_values:
            semantic_sentences.append(f"line {node.lineno}: {sorted(names & sentence_values)}")
    renderers = {
        "agent_colour", "agent_id_of", "bounded_title", "ms_str",
        "render_team_line", "render_transcript_row", "title_value",
    }
    semantic_calls = sorted(
        f"{getattr(node.func, 'id', getattr(node.func, 'attr', '?'))} at line {node.lineno}"
        for node in nodes if isinstance(node, ast.Call)
        and getattr(node.func, "id", getattr(node.func, "attr", None)) in renderers)
    faults = []
    if "completion_answer" not in s.resolver_public_methods:
        faults.append("Resolver lacks completion_answer")
    if questions != ["completion_answer"]:
        faults.append(f"Resolver calls {questions}")
    if attributes:
        faults.append(f"Resolver attributes {attributes}")
    if raw_file_reads:
        faults.append(f"raw reads {raw_file_reads}")
    if semantic_calls:
        faults.append(f"sentence helpers {semantic_calls}")
    if semantic_sentences:
        faults.append(f"sentence construction {semantic_sentences}")
    check("completion-consumes-one-complete-answer",
          "completion emits immutable Resolver rows without reading or explaining team evidence",
          not faults, "; ".join(faults))
    return checked


