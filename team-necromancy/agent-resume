@unit(('completion-names-rows-are-six-self-contained-fields',
       'every names row carries its own six fields'),
      ('completion-names-repeats-team-key-and-group',
       'every names row repeats its team key and group description'),
      ('completion-shares-canonical-members-with-doctor-and-runtime',
       'completion offers the doctor\'s own members, in the runtime\'s order'),
      ('completion-durable-assignment-offers-the-destination',
       'a moved member is offered under the team it belongs to now'))
def _check_completion_names_are_canonical(s):
    """What a completion row has to say for itself.

    A row that carries its group only when the group changes is a row that
    cannot be read alone: the shell has to remember what came before it, and
    anything that reorders, filters or caches the rows loses the association
    without noticing. The same goes for a team key that only exists inside a
    rendered description. So each row is asked to be complete on its own.

    The other half is where the rows come from. Completion builds its own
    member records out of transcript stamps and roster entries and then keeps
    one per display name, which is a different set of members from the one the
    team description and the doctor work with, chosen a different way.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    CREW = "session-t17-crew"
    SOURCE, DEST = "session-t17-source", "session-t17-dest"
    CROWD = ("alpha", "beta", "gamma")
    base = Path(tempfile.mkdtemp(prefix=f"{TOOL}-t17-"))
    teams, projects = base / "teams", base / "projects"
    (projects / "p").mkdir(parents=True)
    teams.mkdir()

    def roster(team, members):
        (teams / team / "inboxes").mkdir(parents=True)
        (teams / team / "config.json").write_text(json.dumps({
            "name": team, "leadAgentId": agent_id_of("team-lead", team),
            "leadSessionId": f"lead-{team}", "members": members, "createdAt": 1}))

    def transcript(stem, name, team, age):
        path = projects / "p" / f"{stem}.jsonl"
        path.write_text(fixture_line({
            "parentUuid": None, "type": "user", "uuid": f"{stem}-root",
            "sessionId": stem, "agentName": name, "teamName": team,
            "timestamp": "2026-01-01T00:00:00Z"}) + "\n")
        os.utime(path, (age, age))

    def restamped(stem, name, was, joins, age):
        """One conversation that moved teams, as a restamp leaves it.

        The window-start record says the team it is in now, and the receipt
        beside it keeps where it came from. Both are written the way
        _restamp_plan writes them, so the evidence here is the evidence
        production reads and not a shape invented for this check.
        """
        path = projects / "p" / f"{stem}.jsonl"
        uuid = f"{stem}-root"
        receipt = {"kind": "restamp", "stem": stem, "uuid": uuid,
                   "old": {"teamName": was, "agentName": name},
                   "new": {"teamName": joins, "agentName": name},
                   "at": (now + 900) * 1000}
        path.write_text(
            fixture_line({"parentUuid": None, "type": "user", "uuid": uuid,
                          "sessionId": stem, "agentName": name, "teamName": joins,
                          "timestamp": "2026-01-01T00:00:00Z"}) + "\n"
            + fixture_line({"type": RESTAMP_RECORD, "restamp": receipt})
            + "\n")
        os.utime(path, (age, age))

    now = 1_770_000_000
    roster(CREW, [{"agentId": agent_id_of("team-lead", CREW), "name": "team-lead"}]
           + [{"agentId": agent_id_of(who, CREW), "name": who, "joinedAt": now * 1000}
              for who in CROWD])
    transcript(f"lead-{CREW}", "team-lead", CREW, now)
    for at, who in enumerate(CROWD):
        transcript(f"s-{who}", who, CREW, now - at)

    # The durable case: one member, one conversation, moved once. Both teams
    # still list the mover and both say inactive, and the team it came from
    # carries the newer joinedAt and the newer roster file, so joinedAt says
    # source, isActive says nothing, and the only thing that says destination
    # is the move itself.
    for team, joined in ((SOURCE, now + 500), (DEST, now)):
        roster(team, [{"agentId": agent_id_of("team-lead", team), "name": "team-lead"},
                      {"agentId": agent_id_of("mover", team), "name": "mover",
                       "joinedAt": joined * 1000, "isActive": False}])
        transcript(f"lead-{team}", "team-lead", team, now - 50)
    restamped("s-mover", "mover", was=SOURCE, joins=DEST, age=now - 40)
    os.utime(teams / SOURCE / "config.json", (now + 500, now + 500))

    try:
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._teams_dir, eng._projects_dir = teams, projects
        eng._process_table = lambda refresh=False: []
        answer = eng.completion_answer("selector")
        rows = [row for row in answer["rows"] if row.startswith("names\t")]
        semantic = eng._completion_answer("names")
        runtime = eng._team_runtime(CREW, table=())
        doctored = eng._doctor_member_ids(CREW, runtime)
        landed = next((record for record in eng._durable_assignment_index()["records"]
                       if record["name"] == "mover"), None)
    finally:
        shutil.rmtree(base, ignore_errors=True)

    # names, team-key, group-description, agent-id, member-description, colour
    WIDTH = 6
    shapes = [row.split("\t") for row in rows]
    wrong_width = [len(shape) for shape in shapes if len(shape) != WIDTH]
    full = [shape for shape in shapes if len(shape) == WIDTH]
    blank = [shape[3] if len(shape) > 3 else "?"
             for shape in full if not shape[1].strip() or not shape[2].strip()]
    mismatched = [shape[3] for shape in full
                  if name_and_team(shape[3])[1] != shape[1]]
    self_contained = {
        "there are rows to read": bool(rows),
        "every row has six fields": not wrong_width,
        "every row names its team and its group": not blank,
        "every row's agent id belongs to the team it names": not mismatched,
    }
    faults = sorted(name for name, ok in self_contained.items() if not ok)
    check("completion-names-rows-are-six-self-contained-fields",
          "every names row carries its own six fields", not faults,
          ", ".join(faults) + f"; widths {sorted(set(len(x) for x in shapes))}"
          + (f", blank on {blank[:3]}" if blank else ""))

    # Grouped by the team key each row states, which is the point: a reader
    # that has to carry the last non-blank value forward is the thing being
    # ruled out, so this never carries anything forward.
    spoken = collections.defaultdict(set)
    for shape in full:
        spoken[shape[1]].add(shape[2])
    repeated = {
        "each team's rows agree on one group description":
            all(len(said) == 1 for said in spoken.values()),
        "the crew's three members are one group":
            len([shape for shape in full if shape[1] == CREW]) == len(CROWD),
        "no row leaves its group for the row above to supply":
            not any(shape[2] == "" for shape in full),
    }
    faults = sorted(name for name, ok in repeated.items() if not ok)
    check("completion-names-repeats-team-key-and-group",
          "every names row repeats its team key and group description",
          not faults, ", ".join(faults)
          + f"; groups {({k: sorted(v)[:2] for k, v in list(spoken.items())[:2]})}")

    # The runtime answer already resolves this team's members and states the
    # order they belong in, and the doctor reads that order rather than sorting
    # its own. Completion asking the stamp index and the roster again, and
    # keeping one record per display name, is a second answer to that question.
    crew_entries = [entry for entry in semantic["entries"]
                    if name_and_team(entry["agent_id"])[1] == CREW]
    wanted = [agent_id for agent_id in doctored
              if name_and_team(agent_id)[0] != "team-lead"]
    by_id = {agent_id_of(member.get("name"), CREW): member
             for member in runtime["roster"].get("members", ())}
    carried = [entry.get("member") for entry in crew_entries]
    shared = {
        "completion offers the members the runtime knows, in its order":
            [entry["agent_id"] for entry in crew_entries] == wanted,
        "each row carries the roster's own member record":
            bool(carried) and all(
                held is not None
                and dict(held) == dict(by_id.get(entry["agent_id"], {}))
                for held, entry in zip(carried, crew_entries)),
    }
    faults = sorted(name for name, ok in shared.items() if not ok)
    check("completion-shares-canonical-members-with-doctor-and-runtime",
          "completion offers the doctor's own members, in the runtime's order",
          not faults, ", ".join(faults)
          + f"; offered {[e['agent_id'] for e in crew_entries]}, wanted {wanted}"
          + f", carried {carried[:1]}")

    offered = {entry["agent_id"] for entry in semantic["entries"]}
    # The first two say the fixture is worth asking about: a move that does not
    # read as a move would let the last two pass on a corpus that never tested
    # anything. The last two are the question.
    moved = {
        "the fixture carries a move, and it reads as one":
            landed is not None and landed["source"] == "restamp receipt",
        "and it resolves to the team the receipt names":
            landed is not None and landed["team"] == DEST,
        "the team it belongs to now is offered": agent_id_of("mover", DEST) in offered,
        "the team it came from is not": agent_id_of("mover", SOURCE) not in offered,
    }
    faults = sorted(name for name, ok in moved.items() if not ok)
    check("completion-durable-assignment-offers-the-destination",
          "a moved member is offered under the team it belongs to now",
          not faults, ", ".join(faults)
          + f"; offered {sorted(a for a in offered if a.startswith('mover@'))}"
          + f", durable resolution says {landed and landed['team']!r}"
            f" from {landed and landed['source']!r}")
    return checked


@unit(('completion-parser-takes-only-six-field-rows',
       'the completion file reads six-field rows and drops everything else'),
      ('completion-cache-drops-rows-from-the-old-format',
       'a cache written in the old row format is not served'),
      ('completion-cache-path-style-is-honored',
       'with the cache-path style set, the completion keeps its cache there and writes '
       'nothing under the XDG_CACHE_HOME it inherited'),
      live=True)
def _check_completion_parser_is_strict(s):
    """The shell half of the same row format, in the shell.

    The completion file is sourced as it ships and its own selector function is
    called; only what the completion system would have supplied is stood in
    for, so what answers here is the parser that runs on a real TAB.

    A parser that takes whatever arrives is how a row format changes without
    anyone finding out. The rows below are the ways one can be wrong -- short,
    long, blank where the group belongs, an id that is not one, an id with a
    team that disagrees with the row's own team key -- and each is offered next
    to rows that are right, so a parser cannot pass by dropping the batch.
    """
    out = []
    IDS = (("completion-parser-takes-only-six-field-rows",
            "the completion file reads six-field rows and drops everything else"),
           ("completion-cache-drops-rows-from-the-old-format",
            "a cache written in the old row format is not served"),
           ("completion-cache-path-style-is-honored",
            "with the cache-path style set, the completion keeps its cache there and writes "
            "nothing under the XDG_CACHE_HOME it inherited"))
    zsh = shutil.which("zsh")
    if not zsh:
        return [(cid, name, False, "no zsh on this machine, and only zsh can answer this")
                for cid, name in IDS]

    TEAM, OTHER = "session-t17-crew", "session-t17-other"
    GROUP = "3 members, last active 2026-08-16 14:15"
    WANTED = tuple(f"{who}@{TEAM}" for who in ("alpha", "beta", "gamma"))
    good = [f"names\t{TEAM}\t{GROUP}\t{who}\tjoined 14:1{at}\t36"
            for at, who in enumerate(WANTED)]
    # One row per way of being wrong, each with the group it claims to be in.
    wrong = {
        "an old sparse row": f"names\t{TEAM}  2026-08-16 14:15\tsparse@{TEAM}\tjoined\t36",
        "a row with no group": f"names\t\t\tblank@{TEAM}\tjoined 14:20\t36",
        "a row a field short": f"names\t{TEAM}\t{GROUP}\tshort@{TEAM}\t36",
        "a row a field long":
            f"names\t{TEAM}\t{GROUP}\tlong@{TEAM}\tjoined 14:21\t36\tspare",
        "a row with an id that is not one": f"names\t{TEAM}\t{GROUP}\tnot-an-id\tjoined 14:22\t36",
        "a row with another team's id":
            f"names\t{TEAM}\t{GROUP}\tstray@{OTHER}\tjoined 14:23\t36",
    }
    # What a shell that cached before the format changed would hand back.
    stale = [f"names\t{TEAM}  2026-08-16 14:15\t{who}\tjoined\t36" for who in WANTED]

    PROBE = r"""
emulate -L zsh
zmodload zsh/stat
zmodload zsh/zutil
mode=$1 fpdir=$2 tool=$3 rowfile=$4 cachedir=$5 oldrows=$6
# A #compdef file ends in the _arguments call the completion system would be
# running it for, so sourcing it outside completion reaches that call. It is
# stood in for like the rest of what compsys supplies.
_arguments() { : }
source $fpdir/_$tool
service=$tool
if [[ $mode == parse ]]; then
  PREFIX=
  _ra_emit() { lines=( ${(f)"$(<$rowfile)"} ) }
  _ra_widths() { : }
  _ra_render() {
    local group=$2 row
    shift 3
    print -r -- "GROUP:$group"
    for row in "$@"; do print -r -- "ROW:$row"; done
    return 0
  }
  _agent_resume_selector
  print -r -- "PARSE_DONE"
  exit 0
fi
zstyle ":completion:*:*:${service}:*" cache-path $cachedir
# The stamp a shell wrote before the row format changed, reproduced here rather
# than asked for. That old algorithm was the corpus directory mtimes and their
# immediate children and nothing else, so seeding the cache under it is what a
# shell that cached before the change actually left on disk. Asking _ra_stamp
# for it instead would write the old rows under whatever the stamp says today,
# which is a state no version of this ever produced.
typeset claude=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
typeset -a st
zstat -A st +mtime $claude/teams(N) $claude/projects(N) \
      $claude/teams/*(N/) $claude/projects/*(N/) 2>/dev/null
(( $#st )) || { print -r -- "NOSTAMP"; exit 1 }
typeset legacy="corpus $#st ${(j: :)st}"
{ print -r -- "$legacy"; cat $oldrows } >! $cachedir/${service}-selector
typeset -a lines
typeset l
_ra_emit selector
for l in $lines; do print -r -- "EMIT:$l"; done
print -r -- "EMIT_DONE"
"""

    stage = Path(tempfile.mkdtemp(prefix=f"{TOOL}-t17-zsh-"))
    try:
        fpdir, binned, cachedir = stage / "fp", stage / "bin", stage / "cache"
        claude = stage / "claude"
        # The cache directory a completion that ignored the cache-path style
        # would use. It is the fixture's own, so such a completion writes here
        # and not into the cache of whoever runs the suite.
        inherited = stage / "inherited-cache"
        for path in (fpdir, binned, cachedir, claude / "teams", claude / "projects", inherited):
            path.mkdir(parents=True)
        shutil.copy2(Path(__file__).resolve().parent / f"_{TOOL}", fpdir / f"_{TOOL}")
        rowfile, oldrows = stage / "rows", stage / "oldrows"
        rowfile.write_text("\n".join(good + list(wrong.values())) + "\n")
        oldrows.write_text("\n".join(stale) + "\n")
        # The emitter a cache miss would reach. It answers with well-formed rows
        # only: the malformed ones belong to the parser question and would
        # otherwise come back through this door and read as a stale cache being
        # served. Parse mode never reaches this stub, it reads rows directly.
        goodrows = stage / "goodrows"
        goodrows.write_text("\n".join(good) + "\n")
        stub = binned / TOOL
        stub.write_text(f'#!/bin/sh\n[ "$1" = "--complete" ] && exec cat {goodrows}\nexit 0\n')
        stub.chmod(0o755)
        (stage / "probe.zsh").write_text(PROBE)

        def probing(mode):
            return subprocess.run(
                [zsh, "-f", str(stage / "probe.zsh"), mode, str(fpdir), TOOL,
                 str(rowfile), str(cachedir), str(oldrows)],
                capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=60,
                env=dict(os.environ, PATH=f"{binned}{os.pathsep}{os.environ['PATH']}",
                         CLAUDE_CONFIG_DIR=str(claude), XDG_CACHE_HOME=str(inherited),
                         NO_COLOR="1"))

        parsed, cached = probing("parse"), probing("cache")
        in_cache_path = sorted(path.name for path in cachedir.iterdir())
        strayed = sorted(str(path.relative_to(inherited)) for path in inherited.rglob("*"))
    finally:
        shutil.rmtree(stage, ignore_errors=True)

    groups, taken = [], []
    for line in parsed.stdout.splitlines():
        if line.startswith("GROUP:"):
            groups.append(line[len("GROUP:"):])
        elif line.startswith("ROW:"):
            taken.append(line[len("ROW:"):])
    offered = [row.split("\t")[0] for row in taken]
    reading = {
        "the parser ran": "PARSE_DONE" in parsed.stdout,
        "it offered the three rows that are right": tuple(offered) == WANTED,
        "it put them in one group": len(groups) == 1,
        "under the group description the rows carry": groups[:1] == [GROUP],
        "it made no group out of a blank field": "" not in groups,
    }
    faults = sorted(name for name, ok in reading.items() if not ok)
    kept = sorted(bad for bad, row in wrong.items()
                  if row.split("\t")[3] in offered or row.split("\t")[2] in offered)
    out.append((IDS[0][0], IDS[0][1], not faults and not kept,
                ", ".join(faults + [f"it kept {bad}" for bad in kept])
                + f"; offered {offered[:8]}, groups {groups[:4]}"
                + (f"\n{parsed.stderr.strip()[:200]}" if parsed.stderr.strip() else "")))

    served = [line[len("EMIT:"):] for line in cached.stdout.splitlines()
              if line.startswith("EMIT:")]
    short = [row for row in served if row.startswith("names\t") and row.count("\t") != 5]
    # Answering with nothing would satisfy the last condition without having
    # refused anything, so the emitter is asked to have answered at all.
    serving = {
        "the emitter ran": "EMIT_DONE" in cached.stdout,
        "it answered with rows": bool(served),
        "it did not hand back what the old format wrote": not short,
    }
    faults = sorted(name for name, ok in serving.items() if not ok)
    out.append((IDS[1][0], IDS[1][1], not faults, ", ".join(faults)
                + f"; {len(short)} of {len(served)} row(s) came back in the old shape"
                + (f", first {short[0]!r}" if short else "")
                + (f"\n{cached.stderr.strip()[:200]}" if cached.stderr.strip() else "")))
    # The emitter ran and its answer was cached; where it went is the question.
    out.append((IDS[2][0], IDS[2][1],
                "EMIT_DONE" in cached.stdout and in_cache_path == [f"{TOOL}-selector"]
                and not strayed,
                f"cache-path holds {in_cache_path}, the inherited XDG_CACHE_HOME holds {strayed}"))
    return out


@unit(('roster-census-tells-unreadable-from-absent',
       'a roster that cannot be parsed is not reported as one that is not there'),
      ('absent-roster-answers-carry-no-mutable-blank',
       'a team with no roster answers with nothing anyone can write to'),
      ('team-description-is-one-object-per-generation',
       'one roster and process generation give back one description object'),
      ('team-runtime-keeps-the-records-it-was-given',
       'the process table handed in comes back as the objects handed in'))
def _check_team_description_generations(s):
    """What a canonical description has to be keyed on, and what it may not lose.

    A roster is in one of three states, not two: parsed, present but
    unparsable, and not there at all. The census already keeps them apart in
    the generation it records -- ("absent",) against a five-element stat and
    bytes -- and every reader that asks `data is None` throws that apart away,
    so a file someone truncated mid-write reads as a team that was cleaned up.

    A description that is canonical is one object per generation, and the
    generation is both halves: the roster it was read from and the process
    table it was resolved against. Handing back a fresh object each time means
    two callers can hold two answers to the same question, which is the split
    this is meant to close. The table it was given comes back as the objects it
    was given, because a copy is a second version of the same evidence.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    LIVE, BROKEN, GONE = ("session-t17-live", "session-t17-broken",
                          "session-t17-gone")
    base = Path(tempfile.mkdtemp(prefix=f"{TOOL}-t17-gen-"))
    teams, projects = base / "teams", base / "projects"
    (projects / "p").mkdir(parents=True)
    for team in (LIVE, BROKEN, GONE):
        (teams / team / "inboxes").mkdir(parents=True)
    live_cfg = teams / LIVE / "config.json"
    live_cfg.write_text(json.dumps({
        "name": LIVE, "leadAgentId": agent_id_of("team-lead", LIVE),
        "leadSessionId": f"lead-{LIVE}", "createdAt": 1,
        "members": [{"agentId": agent_id_of("team-lead", LIVE), "name": "team-lead"},
                    {"agentId": agent_id_of("one", LIVE), "name": "one"}]}))
    # Present, and not parsable: a write that stopped halfway.
    (teams / BROKEN / "config.json").write_text('{"name": "session-t17-brok')
    # GONE keeps its directory and has no config at all.

    ROWS = ((PID_CEILING + 999001, 1, ("sleep", "60")), (PID_CEILING + 999002, 1, ("sleep", "61")))
    try:
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._teams_dir, eng._projects_dir = teams, projects
        eng._process_table = lambda refresh=False: ()
        census = eng._roster_census()
        gone = eng._roster_snapshot(GONE, census=census)
        broken = eng._roster_snapshot(BROKEN, census=census)
        said_gone = eng._team_description(GONE, table=(), census=census)
        again_gone = eng._team_description(GONE, table=(), census=census)
        said_broken = eng._team_description(BROKEN, table=(), census=census)
        blank = eng._team_runtime(GONE, table=(), census=census)["roster"]

        first = eng._team_description(LIVE, table=(), census=census)
        again = eng._team_description(LIVE, table=(), census=census)
        moved = eng._team_description(LIVE, table=ROWS, census=census)
        live_cfg.write_text(live_cfg.read_text().replace(
            '"createdAt": 1', '"createdAt": 2'))
        newer = eng._team_description(LIVE, table=(), census=eng._roster_census())

        runtime = eng._team_runtime(LIVE, table=ROWS, census=census)
    finally:
        shutil.rmtree(base, ignore_errors=True)

    told = {
        "the one that is not there says so": gone.generation == ("absent",),
        "the one that cannot be parsed does not":
            broken.generation != ("absent",),
        "and the two do not describe themselves the same way":
            said_broken["standing"] != said_gone["standing"],
        "the unparsable one is not called missing":
            "missing" not in (said_broken["standing"] or ""),
    }
    faults = sorted(name for name, ok in told.items() if not ok)
    check("roster-census-tells-unreadable-from-absent",
          "a roster that cannot be parsed is not reported as one that is not there",
          not faults, ", ".join(faults)
          + f"; unparsable says {said_broken['standing']!r}, "
            f"absent says {said_gone['standing']!r}")

    nothing = {
        "it answers with a mapping": isinstance(blank, Mapping),
        "and not one anyone can write to": not isinstance(blank, dict),
    }
    faults = sorted(name for name, ok in nothing.items() if not ok)
    check("absent-roster-answers-carry-no-mutable-blank",
          "a team with no roster answers with nothing anyone can write to",
          not faults, ", ".join(faults) + f"; it answered with {type(blank).__name__}")

    # Both generation shapes go through the same key: a five-element stat with
    # bytes for a roster that is there, and ("absent",) for one that is not.
    keyed = {
        "the same generations answer with the same object": first is again,
        "a different process generation answers with another": moved is not first,
        "a different roster generation answers with another": newer is not first,
        "an absent roster is keyed the same way": said_gone is again_gone,
    }
    faults = sorted(name for name, ok in keyed.items() if not ok)
    check("team-description-is-one-object-per-generation",
          "one roster and process generation give back one description object",
          not faults, ", ".join(faults)
          + f"; {len({id(first), id(again), id(moved), id(newer)})} object(s) "
            "for 2 roster and 2 process generations")

    held = {
        "the table itself comes back": runtime["table"] is ROWS,
        "and so does every row in it":
            len(runtime["table"]) == len(ROWS)
            and all(was is now for was, now in zip(ROWS, runtime["table"])),
    }
    faults = sorted(name for name, ok in held.items() if not ok)
    check("team-runtime-keeps-the-records-it-was-given",
          "the process table handed in comes back as the objects handed in",
          not faults, ", ".join(faults))
    return checked


@unit(('confirmation-taxonomy-classifies-every-question',
       'every question this tool asks belongs to one named kind'),
      ('confirmation-defaults-match-what-enter-does',
       'the default a prompt spells is the answer Enter gives'),
      ('confirmation-nested-kill-decides-on-its-own',
       'the kill inside a move is not answered by having said yes to the move'))
def _check_confirmation_taxonomy(s):
    """One table for every question, so a new one cannot invent its own manners.

    Two kinds ask. HELPFUL spells [Y/n] and only refuses when told no, because
    what it does can be undone or was already lost. NASTY spells [y/N] and only
    proceeds when told yes, because what it does cannot be undone. Two kinds do
    not ask: AUTO, where a flag or the absence of anything to decide has
    already settled it, and PREVIEW, where nothing happens so nothing is worth
    asking. DIRECT is a question put straight to the operator by the command
    they ran; SPECIAL is one that carries its own refusal wording rather than
    the shared one. A question that fits none of these is the finding.

    The spelled default and the answer test have to agree. `[Y/n]` next to a
    test that only proceeds on "y" is a prompt that lies about its default, and
    the person reading it finds out by pressing Enter.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    HELPFUL, NASTY = "[Y/n]", "[y/N]"

    def asking_sites(tree):
        """Every function that puts a question to a person, and how."""
        sites = {}
        for node in ast.walk(tree):
            if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                continue
            for part in ast.walk(node):
                if not (isinstance(part, ast.Call)
                        and isinstance(part.func, ast.Name)
                        and part.func.id == "input"):
                    continue
                spelled = {mark for mark in (HELPFUL, NASTY)
                           for text in ast.walk(part)
                           if isinstance(text, ast.Constant)
                           and isinstance(text.value, str) and mark in text.value}
                body = ast.unparse(node)
                # The three spellings this tool actually uses to read an
                # answer. A site written some fourth way is reported as one the
                # taxonomy does not recognise rather than as one that is wrong.
                refuses_on_n = "startswith('n')" in body
                proceeds_on_y = any(form in body for form in (
                    "startswith('y')", "answer != 'y'", "answer in ('y', 'yes')"))
                sites.setdefault(node.name, {
                    "spelled": spelled,
                    # An explicit branch, so it can say why it took the default.
                    # Letting input() raise EOFError reaches the same answer
                    # without ever saying a terminal was what was missing.
                    "says_why_without_a_terminal": "isatty" in body,
                    "refuses_on_n": refuses_on_n,
                    "proceeds_on_y": proceeds_on_y,
                    "reads_the_answer": refuses_on_n or proceeds_on_y,
                    "body": body,
                })
        return sites

    sites = asking_sites(s.tree)
    # The shared asker is the SPECIAL case: it takes its question as an
    # argument, so its own source carries no prompt of its own.
    shared = {"ask"}
    unclassified = sorted(
        name for name, site in sites.items()
        if name not in shared and len(site["spelled"]) != 1)
    unguarded = sorted(name for name, site in sites.items()
                       if not site["says_why_without_a_terminal"])
    unread = sorted(name for name, site in sites.items()
                    if not site["reads_the_answer"])
    classified = {
        "every question spells exactly one default": not unclassified,
        "every answer is read a way this table knows": not unread,
        "and every one of them says why when there is no terminal": not unguarded,
    }
    faults = sorted(name for name, ok in classified.items() if not ok)
    check("confirmation-taxonomy-classifies-every-question",
          "every question this tool asks belongs to one named kind", not faults,
          ", ".join(faults) + f"; {len(sites)} asking site(s)"
          + (f", unclassified {unclassified}" if unclassified else "")
          + (f", unguarded {unguarded}" if unguarded else ""))

    # A prompt spelling [Y/n] beside a test that only proceeds on "y" is a
    # prompt with a default other than the one it advertises.
    lying = []
    for name, site in sites.items():
        if name in shared or len(site["spelled"]) != 1:
            continue
        mark = next(iter(site["spelled"]))
        if mark == HELPFUL and not site["refuses_on_n"]:
            lying.append(f"{name} spells Y/n but does not refuse on n")
        if mark == NASTY and not site["proceeds_on_y"]:
            lying.append(f"{name} spells y/N but does not proceed on y")
        if mark == NASTY and site["refuses_on_n"] and not site["proceeds_on_y"]:
            lying.append(f"{name} spells y/N and takes anything but n")
    check("confirmation-defaults-match-what-enter-does",
          "the default a prompt spells is the answer Enter gives", not lying,
          "; ".join(sorted(lying)[:3]))

    # Ending a conversation is its own decision. Whatever settled the move it
    # happens inside must not also settle this, so the only things that skip it
    # are the ones the operator typed on this run. agree_to_end is the kill's
    # question, asked by both routes that end a process for a move.
    asker = s.funcs.get("agree_to_end")
    asked = ast.unparse(asker) if asker else ""
    guard = next((ast.unparse(part.test) for part in ast.walk(
                      asker or ast.Module(body=[], type_ignores=[]))
                  if isinstance(part, ast.If)
                  and any(isinstance(line, ast.Return) and isinstance(line.value, ast.Constant)
                          and line.value.value is True for line in part.body)), "")
    askers = s.callers_of("agree_to_end") - s.suite_fns
    independent = {
        "the kill has a question of its own": "input(" in asked,
        "skipped only by what this run was told":
            bool(guard) and "dry_run" in guard and "yes" in guard,
        "and never by the surrounding decision":
            "confirmation" not in guard and "confirmed" not in guard,
        "and every move that ends a process asks it":
            askers == {"kill_holder", "settle_stops"},
    }
    faults = sorted(name for name, ok in independent.items() if not ok)
    check("confirmation-nested-kill-decides-on-its-own",
          "the kill inside a move is not answered by having said yes to the move",
          not faults, ", ".join(faults) + f"; guard {guard[:80]!r}")
    return checked


def _check_verdict(cid, okay, detail=""):
    """Use the registered description so mutation reports recognize each result."""
    description = next(description for _name, ids, _run, _live in UNITS
                       for check_id, description in ids if check_id == cid)
    return cid, description, bool(okay), detail


def _fixture_tree_contents(root):
    """Retain directory entries as well as file bytes when testing read-only routes."""
    return {entry.relative_to(root): ('directory',) if entry.is_dir() else ('file', entry.read_bytes())
            for entry in root.rglob('*')}


@contextlib.contextmanager
def _roster_test_fixture():
    """Own synthetic team and transcript trees plus the command's fake runtime."""
    with tempfile.TemporaryDirectory(prefix=f"{TOOL}-owned-rosters-") as temp:
        root = Path(temp)
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._teams_dir, eng._projects_dir = root / "teams", root / "projects"
        eng._teams_dir.mkdir()
        project = eng._projects_dir / "fixture"
        project.mkdir(parents=True)

        def config(team, data, mode=0o640):
            cfg = eng._roster_path(team)
            cfg.parent.mkdir(parents=True, exist_ok=True)
            cfg.write_bytes(data if type(data) is bytes else
                            (json.dumps(data) + "\n").encode())
            cfg.chmod(mode)
            return cfg

        def transcript(session, name=None, team=None, extra=()):
            path = project / f"{session}.jsonl"
            row = {"type": "user", "uuid": f"{session}-root", "parentUuid": None,
                   "sessionId": session, "timestamp": "2026-01-01T00:00:00Z",
                   "message": {"role": "user", "content": "fixture"}}
            if name is not None:
                row["agentName"] = name
            if team is not None:
                row["teamName"] = team
            path.write_text("\n".join(fixture_line(item) for item in (row, *extra)) + "\n")
            return path

        fake = _FakeTmux(session_exists=False, sockets=[])
        backed_up = set(_BACKED_UP)
        receipts = globals()["RECEIPTS_DIR"]
        globals()["RECEIPTS_DIR"] = root / "receipts"
        _BACKED_UP.clear()
        try:
            with fake.installed(eng):
                yield types.SimpleNamespace(root=root, engine=eng, project=project,
                                            config=config, transcript=transcript, fake=fake)
        finally:
            globals()["RECEIPTS_DIR"] = receipts
            _BACKED_UP.clear()
            _BACKED_UP.update(backed_up)


@unit(
    ('roster-snapshot-owns-json', 'roster snapshots detach caller containers and preview generations'),
    ('roster-snapshot-validates-json', 'owned configs accept exactly the supported JSON value domain'),
    ('roster-observation-validates-facts', 'file and roster observations reject incompatible mutable facts'),
    ('roster-milliseconds-stay-integer', 'activity milliseconds do not round across a sub-millisecond boundary'),
    ('immutable-walker-checks-dataclasses', 'one immutability walker checks dataclass contents and mutable controls'),
)
def _check_owned_roster_values(s):
    checked = []

    def check(cid, ok, detail=""):
        checked.append(_check_verdict(cid, bool(ok), detail))

    roster_type = Resolver.RosterSnapshot
    path = Path('/synthetic/declared/config.json')
    nested = {"members": [{"name": "one", "subscriptions": ["initial"]}]}
    backing = {"name": "owned", "nested": types.MappingProxyType(nested)}
    preview = roster_type.preview(path, types.MappingProxyType(backing))
    physical_generation = (1, 2, 2, 1767225600999999999, b'{}')
    physical = roster_type(FileObservation(path, physical_generation, 0), {})
    backing["name"] = "changed"
    nested["members"][0]["subscriptions"].append("changed")
    nested["members"].append({"name": "two"})
    check('roster-snapshot-owns-json',
          preview.team == "owned" and preview.data["nested"]["members"][0]["subscriptions"] == ("initial",)
          and len(preview.data["nested"]["members"]) == 1
          and preview.generation[1] is preview.data and physical.generation is physical_generation
          and not mutable_nodes((preview, physical)))

    def rejects(make):
        try:
            make()
        except (TypeError, ValueError):
            return True
        return False

    @dataclasses.dataclass(frozen=True)
    class FrozenBad:
        child: object

    @dataclasses.dataclass
    class MutableBad:
        child: object

    shared = [1, True, None, "value", float('nan'), float('inf'), float('-inf')]
    accepted = roster_type.preview(path, {"a": shared, "b": shared, "tuple": (1, 2)})
    cyclic_dict, cyclic_list = {}, []
    cyclic_dict["self"] = cyclic_dict
    cyclic_list.append(cyclic_list)
    bad = [b'x', bytearray(b'x'), memoryview(b'x'), {1}, frozenset({1}),
           FrozenBad(1), MutableBad(1), object(), {1: "bad"}, cyclic_dict, cyclic_list]
    invalid = [type(value).__name__ for value in bad
               if not rejects(lambda value=value: roster_type.preview(path, {"nested": [value]}))]
    check('roster-snapshot-validates-json',
          not invalid and accepted.data["a"][4] != accepted.data["a"][4]
          and accepted.data["a"][5:] == (float('inf'), float('-inf'))
          and accepted.data["b"][:4] == (1, True, None, "value"), repr(invalid))
    observation = physical.observation
    absent = FileObservation(path, ("absent",), None)
    diagnostic = FileObservation(path, ('changed-during-read', (1, 2, 3, 4), (1, 5, 3, 4), b'{}'), 0o600)
    invalid_facts = [
        lambda: FileObservation(str(path), physical_generation, 0o600),
        lambda: FileObservation(path, list(physical_generation), 0o600),
        lambda: FileObservation(path, (True, 2, 2, 4, b'{}'), 0o600),
        lambda: FileObservation(path, (1, 2, 2, 4, bytearray(b'{}')), 0o600),
        lambda: FileObservation(path, physical_generation, True),
        lambda: FileObservation(path, physical_generation, None),
        lambda: FileObservation(path, physical_generation, 0o1000),
        lambda: FileObservation(path, ("absent",), 0),
        lambda: FileObservation(path, ("preview", {}), None),
        lambda: FileObservation(path, ('changed-during-read', [1, 2, 3, 4], (1, 2, 3, 4), b''), 0o600),
        lambda: roster_type(diagnostic, {}),
        lambda: roster_type(absent, {"name": "invalid"}),
        lambda: roster_type(absent, {}, "not parsed"),
        lambda: roster_type(observation, {}, bytearray(b'problem')),
        lambda: roster_type(observation, {"name": "invalid"}, "failed parse"),
        lambda: roster_type(observation, {}, preview_path=path),
        lambda: roster_type(None, {}),
        lambda: roster_type(None, {}, "failed", path),
    ]
    bad_facts = [index for index, make in enumerate(invalid_facts) if not rejects(make)]
    check('roster-observation-validates-facts',
          not bad_facts and physical.mode == 0 and physical.state == "valid"
          and roster_type(absent, {}).state == "absent", repr(bad_facts))
    check('roster-milliseconds-stay-integer',
          physical.mtime == 1767225600999 and observation.mtime == physical.mtime
          and int(physical_generation[3] / 1_000_000) == physical.mtime + 1)
    cycle = []
    cycle.append(cycle)
    controls = (FrozenBad([]), MutableBad(()), types.MappingProxyType({"bad": []}),
                FrozenBad(bytearray(b'x')), cycle)
    check('immutable-walker-checks-dataclasses',
          all(mutable_nodes(value) for value in controls)
          and not mutable_nodes((accepted, accepted, physical))
          and sum(isinstance(node, s.ast.FunctionDef) and node.name == "mutable_nodes"
                  for node in s.ast.walk(s.tree)) == 1)
    return checked


@unit(
    ('roster-readers-produce-complete-records', 'all disk parse outcomes become complete typed roster records'),
    ('roster-unstable-read-refuses', 'an unstable census read refuses while generation callers retain the diagnostic'),
    ('roster-interpretation-has-one-owner', 'the census, the member scan and the match of each implicit team to the process that created it use the snapshot team interpretation'),
    ('roster-census-updates-by-path', 'census updates preserve unrelated paths, order and object identities'),
)
def _check_roster_producers_and_census(s):
    from unittest import mock
    checked = []

    def check(cid, ok, detail=""):
        checked.append(_check_verdict(cid, bool(ok), detail))

    with _roster_test_fixture() as f:
        eng = f.engine
        cases = {
            "empty": (b'{}', "valid"), "broken": (b'{', "invalid"),
            "encoding": (b'\xff', "invalid"), "array": (b'[]', "invalid"),
            "mismatch": ({"name": "declared", "createdAt": 1000,
                          "members": [{"name": "mover", "agentId": "mover@declared"}]}, "valid"),
            "blank": ({"name": "", "createdAt": 900}, "valid"),
        }
        paths = {name: f.config(name, raw) for name, (raw, _state) in cases.items()}
        census = eng._roster_census()
        by_path = {record.path: record for record in census}
        absent = eng._roster_snapshot("not-there", census)
        check('roster-readers-produce-complete-records',
              all(type(by_path[paths[name]]) is Resolver.RosterSnapshot
                  and by_path[paths[name]].state == state
                  and by_path[paths[name]].raw == paths[name].read_bytes()
                  and by_path[paths[name]].mode == 0o640
                  for name, (_raw, state) in cases.items())
              and absent.state == "absent" and absent.raw is None and absent.mode is None
              and eng._roster_snapshot("declared", census) is by_path[paths["mismatch"]]
              and not mutable_nodes(census))
        roster = by_path[paths["mismatch"]]
        entries = eng._scan_teams(census)
        registry_pid = PID_CEILING + 77
        pairs = eng._boot_join(immutable({"registry": [{"pid": registry_pid, "alive": True, "started": 1500}]}), census)
        snapshot_node = next(node for node in s.ast.walk(s.engine_node)
                             if isinstance(node, s.ast.ClassDef) and node.name == "RosterSnapshot")
        duplicate_interpretations = []
        for node in s.ast.walk(s.engine_node):
            if not isinstance(node, s.ast.BoolOp) or not isinstance(node.op, s.ast.Or):
                continue
            source = s.src_of(node)
            if ('get("name")' in source or "get('name')" in source) and '.parent.name' in source:
                if not snapshot_node.lineno <= node.lineno <= snapshot_node.end_lineno:
                    duplicate_interpretations.append(node.lineno)
        check('roster-interpretation-has-one-owner',
              roster.team == "declared" and by_path[paths["blank"]].team == "blank"
              and by_path[paths["empty"]].team == "empty"
              and any(entry["team"] == "declared" and entry["cfg"] == paths["mismatch"] for entry in entries)
              and ("declared", registry_pid, 1000) in pairs and ("blank", registry_pid, 900) in pairs
              and not duplicate_interpretations, repr(duplicate_interpretations))

        real_stat = Path.stat
        target = paths["empty"]

        def changed_stat(path, *args, **kwargs):
            facts = real_stat(path, *args, **kwargs)
            if path == target:
                return types.SimpleNamespace(st_dev=facts.st_dev, st_ino=facts.st_ino + 1,
                                             st_size=facts.st_size, st_mtime_ns=facts.st_mtime_ns)
            return facts

        with mock.patch.object(Path, "stat", changed_stat):
            generation = eng._file_generation(target)
            try:
                with capturing("err"):
                    eng._roster_census()
                refused = False
            except Refusal:
                refused = True
        real_open = Path.open

        def unreadable(path, *args, **kwargs):
            if path == target:
                raise PermissionError("synthetic unreadable config")
            return real_open(path, *args, **kwargs)

        with mock.patch.object(Path, "open", unreadable):
            skipped = eng._roster_census()
            unavailable = eng._file_generation(target)
        check('roster-unstable-read-refuses',
              refused and generation[0] == "changed-during-read"
              and unavailable == ("absent",) and all(item.path != target for item in skipped))
        other = Resolver.RosterSnapshot.preview(f.root / "other" / "config.json", {"name": "declared"})
        replacement = Resolver.RosterSnapshot.preview(roster.path, {"name": "declared", "updated": True})
        held = (other, roster)
        replaced = eng._update_census(held, roster.path, replacement)
        removed = eng._update_census(held, roster.path)
        inserted = eng._update_census((other,), roster.path, roster)
        check('roster-census-updates-by-path',
              replaced[0] is other and replaced[1] is replacement and removed == (other,)
              and removed[0] is other and inserted[0] is other and inserted[1] is roster
              and eng._update_census((), roster.path, roster) == (roster,)
              and eng._update_census(held, roster.path, roster) is held
              and eng._update_census(held, f.root / "missing") is held
              and held == (other, roster))
    return checked


@unit(
