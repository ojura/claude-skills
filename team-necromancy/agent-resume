@unit(('lock-refused-leaves-the-roster-alone', 'a roster whose lock cannot be taken is left byte for byte'),
      ('lock-without-an-owner-is-never-taken', 'a lock carrying no owner record is waited for, never taken'),
      ('lock-left-by-a-dead-run-is-taken', 'a lock whose recorded owner is gone is taken, and the run says so'),
      ('lock-of-a-live-owner-is-kept', 'a lock whose recorded owner is still running is left alone'),
      ('stale-lock-that-will-not-come-away-refuses', 'a stale lock this run cannot remove ends at the deadline, not in a spin'),
      ('lock-replaced-mid-verdict-is-not-taken', "a dead owner's lock replaced by a live one before the removal is left alone"),
      ('release-leaves-a-replacement-lock-alone', 'a lock that replaced ours while we held it is not removed on the way out'))
def _check_team_lock_fails_closed(s):
    import threading

    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    tempfile = s.tempfile

    # Long enough that a loaded machine finishing a hundredth-of-a-second wait
    # never trips it, short enough that a wait which never ends is reported
    # rather than sat through.
    WRITE_DEADLINE = 5.0
    lock_base = Path(tempfile.mkdtemp())
    real_teams_dir = RESOLVER.teams_dir
    real_lock = globals()["team_lock"]
    try:
        RESOLVER.teams_dir = lock_base
        lteam = "session-lockcheck"
        (lock_base / lteam / "inboxes").mkdir(parents=True)
        lcfg = RESOLVER.roster_path(lteam)
        lcfg.write_text(json.dumps({
            "name": lteam, "leadAgentId": f"team-lead@{lteam}", "leadSessionId": "x",
            "members": [{"agentId": f"team-lead@{lteam}", "name": "team-lead"}]}))
        untouched = lcfg.read_bytes()
        lock = lcfg.with_name("config.json.lock")

        stragglers = []

        def add_a_member(data):
            data["members"].append({"agentId": f"late@{lteam}", "name": "late"})
            return data

        def write_against(shape, aged=False, exists=False, meanwhile=None):
            """One roster write against a lock of this shape.

            Returns what it refused with or None, and everything it said. A
            tenth of a second stands in for the ten a real run waits: which
            locks it will take is the question here, not how long it waits
            before saying it could not take one. `exists` is for a lock the
            caller has already put in place, because the directory it sits in
            is no longer writable by the time this runs.

            The write runs in a thread with a deadline of its own, because one
            of the cases below exists to catch a wait that never reaches its
            own deadline. Left in this thread, that regression hangs the whole
            suite: nothing is reported, the probe reads no verdict at all
            rather than a failure, and somebody has to kill the run by hand. A
            write that outlives the deadline answers "did not finish", which
            fails whichever check it belongs to. Daemon, so a thread still
            spinning cannot hold the interpreter open, and the capture stays in
            this thread so a stuck writer cannot leave stdout swapped for the
            rest of the suite.

            `meanwhile` runs after the engine has answered what is at the lock
            and before anything acts on that answer, which is where another run
            can take a dead owner's lock away and put its own there.
            """
            if exists:
                pass
            elif shape is None:
                lock.mkdir()   # the shape the harness's own lock helper makes
            else:
                lock.write_bytes(shape)
            if aged:
                old = time.time() - 3600
                os.utime(lock, (old, old))
            globals()["team_lock"] = lambda held, timeout=0.1: real_lock(held, timeout)
            real_holder = RESOLVER.lock_holder
            if meanwhile:
                def racing(path):
                    answer = real_holder(path)
                    meanwhile()
                    return answer
                RESOLVER.lock_holder = racing
            got = []

            def attempt():
                try:
                    edit_team_config(lcfg, add_a_member, "wrote")
                    got.append(None)
                except Refusal as refusal:
                    got.append(refusal.said)

            writer = threading.Thread(target=attempt, daemon=True)
            try:
                with capturing("out") as out, capturing("err") as err:
                    writer.start()
                    writer.join(WRITE_DEADLINE)
            finally:
                RESOLVER.lock_holder = real_holder
            said = out.getvalue() + err.getvalue()
            if not got:
                stragglers.append(writer)
                return f"did not finish in {WRITE_DEADLINE:g}s", said
            return got[0], said

        def clear_lock():
            if lock.is_dir():
                lock.rmdir()
            elif lock.exists():
                lock.unlink()

        # Our own pid and start time: a live owner, and the record a run really
        # writes. Only the start time differs in the dead case, so what answers
        # there is the recycled-pid guard rather than the pid being absent.
        live_owner = json.dumps({"tool": TOOL, "pid": os.getpid(),
                                 "procStart": RESOLVER.proc_start(os.getpid())}).encode()
        dead_owner = json.dumps({"tool": TOOL, "pid": os.getpid(),
                                 "procStart": "1"}).encode()

        live_said, live_out = write_against(live_owner)
        live_roster, live_there = lcfg.read_bytes() == untouched, lock.is_file()
        clear_lock()

        empty_said, empty_out = write_against(b"", aged=True)
        empty_kept = lock.is_file() and "taking it over" not in empty_out
        clear_lock()

        dir_said, dir_out = write_against(None, aged=True)
        dir_kept = lock.is_dir() and "taking it over" not in dir_out
        clear_lock()

        # A lock this run judges stale and then cannot remove: the parent
        # directory is read-only, so the create still answers EEXIST and the
        # unlink answers EACCES. An earlier draft looped on that pair without
        # ever reaching its deadline. It runs last of all, at the bottom of this
        # block: the regression it catches is a write that never returns, and
        # the thread carrying it is still spinning on this same lockfile when
        # the deadline hands the run back. Anything staged after it would be
        # answering against a fixture that thread is still writing to.

        # A second run takes a dead owner's lock over in the gap between this
        # run reading that record and acting on it. What sits at the name by
        # then is a live lock with its owner inside, and an unlink by name would
        # take it away. A real takeover leaves a different inode carrying a live
        # record, which is what this puts there.
        lock.write_bytes(dead_owner)
        swapped = []

        def swap_in_a_live_lock():
            if swapped:
                return   # once: the wait below reads the replacement each pass
            swapped.append(True)
            lock.unlink()
            lock.write_bytes(live_owner)

        raced_said, raced_out = write_against(dead_owner, exists=True,
                                              meanwhile=swap_in_a_live_lock)
        raced_kept = lock.is_file() and lock.read_bytes() == live_owner
        clear_lock()

        # Somebody else takes the name while we are inside the lock. What sits
        # there at the end is theirs, and a release that removed it would hand
        # the lock out while two writers were in it. A regular file rather than
        # a directory on purpose: unlink really would take this one away, so
        # what keeps it is the guard and not a removal that happens to fail.
        stranger = b'{"tool": "somebody else"}'
        with real_lock(lcfg, 0.1):
            lock.unlink()
            lock.write_bytes(stranger)
        replacement_kept = lock.is_file() and lock.read_bytes() == stranger
        clear_lock()

        taken_said, taken_out = write_against(dead_owner)
        taken_listed = [m.get("name") for m in
                        json.loads(lcfg.read_text()).get("members", [])]
        taken_gone = not lock.exists()
        lcfg.write_bytes(untouched)
        clear_lock()

        # A lock this run judges stale and then cannot remove: the parent
        # directory is read-only, so the create still answers EEXIST and the
        # unlink answers EACCES. Root ignores those bits, so on a run as root
        # the removal succeeds and this case reports a failure rather than a
        # hang, which is the safe way round.
        lock.write_bytes(dead_owner)
        os.chmod(lock.parent, 0o500)
        try:
            stuck_said, stuck_out = write_against(dead_owner, exists=True)
        finally:
            os.chmod(lock.parent, 0o700)
        stuck_kept = lock.is_file() and lcfg.read_bytes() == untouched

        # A write that missed its deadline is still going. Whatever it says when
        # it does land would otherwise arrive on the real stdout in the middle
        # of the suite's own report, where a reader, and the probe reading this
        # suite's failures, take it for a verdict. Give it the fixture's last
        # moments with the capture still up; one that never finishes at all is a
        # daemon thread and ends with the interpreter.
        with capturing("out"), capturing("err"):
            for straggler in stragglers:
                straggler.join(WRITE_DEADLINE)
    finally:
        os.chmod(lock_base / lteam, 0o700)
        globals()["team_lock"] = real_lock
        RESOLVER.teams_dir = real_teams_dir
        shutil.rmtree(lock_base, ignore_errors=True)

    check("lock-refused-leaves-the-roster-alone",
          "a roster whose lock cannot be taken is left byte for byte",
          bool(live_said) and live_roster,
          f"refused with {live_said!r}, roster unchanged {live_roster}")
    check("lock-without-an-owner-is-never-taken",
          "a lock carrying no owner record is waited for, never taken",
          empty_kept and dir_kept,
          f"empty: kept {empty_kept}, said {empty_said!r}; "
          f"directory: kept {dir_kept}, said {dir_said!r}")
    check("lock-left-by-a-dead-run-is-taken",
          "a lock whose recorded owner exited is removed, and the run says so",
          taken_said is None and "late" in taken_listed and taken_gone
          and f"exited pid {os.getpid()}" in taken_out
          and "removing the stale lock" in taken_out,
          f"refused {taken_said!r}, roster lists {taken_listed}, "
          f"said {taken_out.strip()!r}")
    check("lock-of-a-live-owner-is-kept",
          "a lock whose recorded owner is still running is left alone",
          live_there and "removing the stale lock" not in live_out,
          f"lock still there {live_there}, said {live_out.strip()!r}")
    check("stale-lock-that-will-not-come-away-refuses",
          "a stale lock this run cannot remove ends at the deadline, not in a spin",
          bool(stuck_said) and stuck_kept and "removal failed" in (stuck_said or "")
          and "removing the stale lock" not in stuck_out,
          f"refused {stuck_said!r}, lock and roster untouched {stuck_kept}")
    check("lock-replaced-mid-verdict-is-not-taken",
          "a dead owner's lock replaced by a live one before removal is left alone",
          raced_kept and bool(raced_said) and "removing the stale lock" not in raced_out,
          f"replacement still there {raced_kept}, refused {raced_said!r}, "
          f"said {raced_out.strip()!r}")
    check("release-leaves-a-replacement-lock-alone",
          "a lock that replaced ours while we held it is not removed on the way out",
          replacement_kept, f"replacement still there {replacement_kept}")
    return checked


@unit(('refused-release-says-what-stays-claimed', 'a claim that cannot be given back is reported, not raised'),
      ('refused-rollback-keeps-the-exec-error', 'a failed exec is still the reason a run ends, even when the roster refuses too'),
      ('become-the-agent-one-place', 'one function turns a run into the agent, and a launch that dies there unwinds what it wrote'))
def _check_refused_teardown_reports(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tempfile = s.tempfile

    give_base = Path(tempfile.mkdtemp())
    real_teams_dir = RESOLVER.teams_dir
    real_lock = globals()["team_lock"]
    try:
        RESOLVER.teams_dir = give_base
        gteam = "session-givebackcheck"
        (give_base / gteam / "inboxes").mkdir(parents=True)
        gcfg = RESOLVER.roster_path(gteam)
        gcfg.write_text(json.dumps({
            "name": gteam, "leadAgentId": f"team-lead@{gteam}", "leadSessionId": "x",
            "members": [{"agentId": f"team-lead@{gteam}", "name": "team-lead"},
                        {"agentId": f"claimant@{gteam}", "name": "claimant"}]}))
        # An empty lock is one this tool will never take, so the release below
        # meets a refusal it cannot get around, which is the case being asked
        # about. A tenth of a second stands in for the ten a real run waits.
        glock = gcfg.with_name("config.json.lock")
        glock.write_bytes(b"")
        gbefore = gcfg.read_bytes()
        globals()["team_lock"] = lambda held, timeout=0.1: real_lock(held, timeout)
        with capturing("out") as gout, capturing("err") as gerr:
            try:
                release_membership({"agentId": f"claimant@{gteam}", "name": "claimant",
                                    "team": gteam},
                                   types.SimpleNamespace(dry_run=False))
                gave_up = None
            except Refusal as refusal:
                gave_up = refusal.said
        gsaid = gout.getvalue() + gerr.getvalue()
        # The bytes, not a name read back out of them: a roster that still
        # happens to mention the claimant is not the same fact as one nothing
        # wrote to. And what was said has to name the entry and the file it is
        # in, or the reader is told a claim leaked without being told which.
        gkept = gcfg.read_bytes() == gbefore and glock.is_file()
        gnamed = f"claimant@{gteam}" in gsaid and str(gcfg) in gsaid
    finally:
        globals()["team_lock"] = real_lock
        RESOLVER.teams_dir = real_teams_dir
        shutil.rmtree(give_base, ignore_errors=True)

    check("refused-release-says-what-stays-claimed",
          "a claim that cannot be given back is reported, not raised",
          gave_up is None and gkept and gnamed,
          f"raised {gave_up!r}, roster and lock untouched {gkept}, "
          f"named the entry and its file {gnamed}, said {gsaid.strip()!r}")

    # The other teardown, read out of the tree rather than driven: an exec that
    # does not fail replaces this process, so there is no run left to observe.
    # Read rather than grepped, because a substring matches a comment as well as
    # code. It is still a statement about what the file says and not about what
    # runs: code no branch reaches has the same syntax as code every branch
    # does, so this proves the rollback is written where a failure lands, and
    # the two behavioural checks below prove what the rollback then does.
    def says(call, text):
        for arg in call.args:
            parts = arg.values if isinstance(arg, ast.JoinedStr) else [arg]
            if any(isinstance(part, ast.Constant) and isinstance(part.value, str)
                   and text in part.value for part in parts):
                return True
        return False

    def calling(node, name):
        return [sub for sub in ast.walk(node) if isinstance(sub, ast.Call)
                and getattr(sub.func, "id", None) == name]

    # One place puts the roster back, and this is its shape: the rollback sits
    # inside a try, a roster that refuses it is said out loud and not re-raised
    # over the reason the launch failed, and the exec error is what ends the run
    # afterwards.
    wrong = []
    putter = funcs.get("unwind_launch")
    ender = funcs.get("exec_failed")
    if putter is None:
        wrong.append("unwind_launch is gone, so nothing says how the roster goes back")
    else:
        guards = [sub for sub in ast.walk(putter)
                  if isinstance(sub, ast.Try) and calling(sub, "restore_member")]
        if not guards:
            wrong.append("the rollback is not guarded against a roster that refuses it")
        else:
            caught = [arm for arm in guards[0].handlers
                      if isinstance(arm.type, ast.Name) and arm.type.id == "Refusal"]
            if not caught:
                wrong.append("a refusal from the rollback is not caught")
            elif not all(calling(arm, "warn") for arm in caught):
                wrong.append("a caught refusal is swallowed without a word")
            elif any(isinstance(sub, ast.Raise) for arm in caught for sub in ast.walk(arm)):
                wrong.append("a caught refusal is re-raised over the reason the run ends")
    puts_back = s.callers_of("restore_member") - s.suite_fns
    if puts_back != {"unwind_launch"}:
        wrong.append(f"the roster is put back from {sorted(puts_back)}, not from one place")
    if ender is None:
        wrong.append("exec_failed is gone, so nothing says what a failed exec does")
    else:
        dies = [call for call in calling(ender, "die") if says(call, "cannot exec")]
        unwinds = calling(ender, "unwind_launch")
        if not dies:
            wrong.append("nothing in it ends the run in the exec error")
        if not unwinds:
            wrong.append("a failed exec does not put the roster back")
        if dies and unwinds and max(c.lineno for c in dies) <= min(c.lineno for c in unwinds):
            wrong.append("the exec error is not the last thing that happens")
    check("refused-rollback-keeps-the-exec-error",
          "a failed exec is still the reason a run ends, even when the roster refuses too",
          not wrong, "; ".join(wrong))

    # And the way a run becomes the agent has one owner. become_agent holds the
    # environment, the cwd move and the exec; the three routes through run_one
    # ask it rather than keeping copies, because the copies had drifted twice
    # over - a rollback aimed at a roster the run had not written, and two of
    # three execs booting bare, inheriting whatever the shell exported, which
    # silently sheds the identity anywhere the teams var is not exported. The
    # execs allowed outside it boot something other than the resolved agent:
    # maybe_attach execs tmux, and run_promote execs this tool, whose child
    # run prepares its own launch.
    told = []
    becomer = funcs.get("become_agent")
    if becomer is None:
        told.append("become_agent is gone, so becoming the agent has no owner")
    else:
        homes = {}
        for fn in funcs.values():
            for sub in ast.walk(fn):
                if (isinstance(sub, ast.Call)
                        and getattr(sub.func, "attr", "") in ("execvp", "execvpe")):
                    homes.setdefault(fn.name, []).append(sub.func.attr)
        booting = {name: kinds for name, kinds in homes.items()
                   if name not in s.suite_fns}
        if booting != {"become_agent": ["execvpe"], "maybe_attach": ["execvp"],
                       "run_promote": ["execvp"]}:
            told.append(f"execs live at {booting}")

        def guarded(inner, rollback, kind):
            """Handler linenos that reach the rollback / that do not, for tries
            holding a call of inner inside become_agent."""
            held, bare = [], []
            for node in ast.walk(becomer):
                if not isinstance(node, ast.Try):
                    continue
                if not any(isinstance(sub, ast.Call)
                           and getattr(sub.func, kind, "") in inner
                           for stmt in node.body for sub in ast.walk(stmt)):
                    continue
                for arm in node.handlers:
                    reached = {getattr(sub.func, "id", None)
                               for sub in ast.walk(arm) if isinstance(sub, ast.Call)}
                    (held if rollback in reached else bare).append(arm.lineno)
            return held, bare

        unwound, straight = guarded({"execvpe"}, "exec_failed", "attr")
        if not unwound or straight:
            told.append("the exec is not guarded by exec_failed alone")
        cwd_unwound, cwd_straight = guarded({"enter_agent_cwd"}, "unwind_launch", "id")
        refusals = [node for node in ast.walk(becomer)
                    if isinstance(node, ast.ExceptHandler)
                    and getattr(node.type, "id", None) == "Refusal"]
        if not cwd_unwound or cwd_straight:
            told.append("the cwd move does not unwind the roster write")
        elif not any(isinstance(sub, ast.Raise) and sub.exc is None
                     for arm in refusals for sub in ast.walk(arm)):
            told.append("a refused cwd move is not re-raised as it stands")
        names = {getattr(sub, "id", None) for sub in ast.walk(becomer)}
        if "TEAM_ENV" not in names:
            told.append("the exec environment does not carry TEAM_ENV")
        if "poison_said" not in {getattr(sub.func, "id", None)
                                 for sub in ast.walk(becomer)
                                 if isinstance(sub, ast.Call)}:
            told.append("the poison is not asked about where the strip is loud")

        callers = [sub for sub in ast.walk(funcs["run_one"])
                   if isinstance(sub, ast.Call)
                   and getattr(sub.func, "id", "") == "become_agent"]
        carrying = [c for c in callers
                    if any(kw.arg == "undo" for kw in c.keywords)]
        if len(callers) != 3 or len(carrying) != 2:
            told.append(f"run_one reaches it {len(callers)} time(s), "
                        f"{len(carrying)} with a roster write to take back; "
                        "the routes are two members with an undo and a lead without")
        outside = s.callers_of("enter_agent_cwd") - s.suite_fns
        if outside != {"become_agent"}:
            told.append(f"the cwd move is made from {sorted(outside)}, not one place")
    # A handler that writes a roster instead of taking one back is the bug this
    # whole unit came from, in the one place it would be invisible.
    still_writing = [node.lineno
                     for fn in (funcs["run_one"],) + ((becomer,) if becomer else ())
                     for node in ast.walk(fn)
                     if isinstance(node, ast.ExceptHandler)
                     for sub in ast.walk(node)
                     if isinstance(sub, ast.Call) and getattr(sub.func, "id", "") in
                     {"retire_member", "register_member", "update_team_config",
                      "record_membership"}]
    if still_writing:
        told.append(f"wrote a roster from a handler at {still_writing}")
    check("become-the-agent-one-place",
          "one function turns a run into the agent, and a launch that dies there unwinds what it wrote",
          not told, "; ".join(told))
    return checked


@unit(('failed-exec-takes-back-the-entry-it-wrote',
       'a launch that never happened leaves no entry this run inserted, in the roster it wrote'),
      ('failed-exec-restores-an-entry-it-found',
       'an entry that predates the run goes back to the values it had'),
      ('failed-exec-leaves-the-source-retired',
       'the team a rebind left keeps saying the member is not running there'))
def _check_failed_exec_puts_the_roster_back(s):
    """What the rollback does, driven rather than read.

    The bug this holds shut was a rollback aimed at the wrong file: it undid the
    source of a rebind, which the write above it had already retired, while the
    destination kept the entry it had just been given for a process that never
    started. So both halves are asked here, and about both rosters.

    roster_record and field are answered by hand. Everything else runs
    unmodified: record_membership does its own routing, and the writes and the
    rollback go through edit_team_config and the real lock. Assembling a whole
    ctx would mean a transcript, a merge and a cwd resolution, none of which
    this asks anything about.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    tempfile = s.tempfile

    back_base = Path(tempfile.mkdtemp())
    real_teams_dir = RESOLVER.teams_dir
    real_record, real_field = RESOLVER.roster_record, RESOLVER.field
    steam, dteam = "session-rollback-src", "session-rollback-dest"
    try:
        RESOLVER.teams_dir = back_base

        def stage(team, members):
            (back_base / team / "inboxes").mkdir(parents=True)
            cfg = RESOLVER.roster_path(team)
            cfg.write_text(json.dumps({
                "name": team, "leadAgentId": agent_id_of("team-lead", team),
                "leadSessionId": "x", "members": members}, indent=2))
            return cfg

        def entry_for(team, cfg):
            return next((m for m in json.loads(cfg.read_text()).get("members", [])
                         if m.get("agentId") == agent_id_of("mover", team)), None)

        RESOLVER.roster_record = lambda ctx: {
            "name": "mover", "team": dteam,
            "agentId": agent_id_of("mover", dteam),
            "parentSession": "", "agentType": "general-purpose",
            "planModeRequired": False, "cwd": "/tmp",
            "color": "blue", "model": "claude-opus-5"}
        RESOLVER.field = lambda ctx, name: {"teamName": dteam, "agentName": "mover"}.get(name)
        running = types.SimpleNamespace(bare=False, dry_run=False, no_update_config=False)

        # A rebind onto a team this member is not in yet: the entry the run
        # writes there is one nothing had before it.
        scfg = stage(steam, [{"agentId": agent_id_of("team-lead", steam), "name": "team-lead"},
                             {"agentId": agent_id_of("mover", steam), "name": "mover",
                              "tmuxPaneId": "%1", "backendType": "tmux", "isActive": True}])
        dcfg = stage(dteam, [{"agentId": agent_id_of("team-lead", dteam), "name": "team-lead"}])
        ctx = {"to_team": dteam,
               "team_entry": {"cfg": scfg, "member": {"agentId": agent_id_of("mover", steam)}}}
        with capturing("out"), capturing("err"):
            fresh = record_membership(ctx, running, "%7")
        wrote_dest = entry_for(dteam, dcfg)
        retired_source = entry_for(steam, scfg)
        source_after_write = scfg.read_bytes()
        with capturing("out"), capturing("err"):
            restore_member(fresh)
        dest_after = entry_for(dteam, dcfg)
        source_after = scfg.read_bytes()

        # And the same rebind onto a team that already carries this member, from
        # a life before this run. That entry is somebody else's writing.
        shutil.rmtree(back_base / dteam)
        was = {"agentId": agent_id_of("mover", dteam), "name": "mover",
               "joinedAt": 17, "subscriptions": [], "agentType": "general-purpose",
               "tmuxPaneId": "%9", "backendType": "tmux", "isActive": False,
               "color": "red", "model": "claude-sonnet-4"}
        dcfg = stage(dteam, [{"agentId": agent_id_of("team-lead", dteam), "name": "team-lead"},
                             copy.deepcopy(was)])
        with capturing("out"), capturing("err"):
            older = record_membership(ctx, running, "%7")
        changed = entry_for(dteam, dcfg)
        with capturing("out"), capturing("err"):
            restore_member(older)
        put_back = entry_for(dteam, dcfg)
    finally:
        RESOLVER.roster_record, RESOLVER.field = real_record, real_field
        RESOLVER.teams_dir = real_teams_dir
        shutil.rmtree(back_base, ignore_errors=True)

    check("failed-exec-takes-back-the-entry-it-wrote",
          "a launch that never happened leaves no entry this run inserted, "
          "in the roster it wrote",
          bool(wrote_dest) and wrote_dest.get("isActive") is True and dest_after is None,
          f"written as {wrote_dest}, left as {dest_after}")
    check("failed-exec-restores-an-entry-it-found",
          "an entry that predates the run goes back to the values it had",
          changed != was and put_back == was,
          f"written as {changed}, put back as {put_back}, was {was}")
    # The retirement is not undone, and this says why rather than only that.
    # After a failed exec nothing is running as this member anywhere, which is
    # what the source now records; putting isActive back would leave the team it
    # left claiming a live member for a process that does not exist.
    check("failed-exec-leaves-the-source-retired",
          "the team a rebind left keeps saying the member is not running there",
          bool(retired_source) and retired_source.get("isActive") is False
          and source_after == source_after_write,
          f"source entry {retired_source}, untouched by the rollback "
          f"{source_after == source_after_write}")
    return checked


@unit(('exec-environment-is-prepared-not-inherited',
       'the process an exec becomes finds the team vars set and the poison gone'))
def _check_exec_environment(s):
    """become_agent driven with the exec replaced, asserting on the environment
    it hands over rather than on the code that builds it.

    The claim under test is the boot condition: the binary binds the identity
    flags only when teams are enabled in the environment it wakes in, so an
    exec that inherits its environment silently sheds the identity anywhere
    the var is not exported (see TEAM_ENV). The poison is the other direction,
    a var that must not survive, and its strip must be said. The parent's own
    environment is asserted unchanged, because a launch that cleans its shell
    rather than its child would look identical from inside the child.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    seen = {}

    def taken(_prog, _argv, env):
        seen["env"] = env
        raise OSError(8, "Exec format error")

    real_exec = os.execvpe
    had = os.environ.get("ANTHROPIC_BASE_URL")
    # The suite itself runs where these vars are exported (a Claude Code tool
    # shell carries all three), so leaving them in the parent would let an
    # exec that merely inherits pass this check - the exact failure it
    # exists to catch. Absent from the parent, present at the exec, is the
    # only arrangement that proves preparation.
    worn = {name: os.environ.pop(name, None)
            for name in (pair.split("=", 1)[0] for pair in TEAM_ENV)}
    os.execvpe = taken
    os.environ["ANTHROPIC_BASE_URL"] = POISON_URL
    said = io.StringIO()
    outcome, parent_after = "", None
    try:
        with capturing("out", into=said), capturing("err", into=said):
            try:
                become_agent(
                    {"target": fixture_target("exec-env", cwd=None)},
                    [f"{TOOL}-selftest-absent", "--resume", "u"], "")
            except Refusal as refused:
                outcome = str(refused)
        parent_after = os.environ.get("ANTHROPIC_BASE_URL")
    finally:
        os.execvpe = real_exec
        if had is None:
            os.environ.pop("ANTHROPIC_BASE_URL", None)
        else:
            os.environ["ANTHROPIC_BASE_URL"] = had
        for name, value in worn.items():
            if value is not None:
                os.environ[name] = value

    env = seen.get("env") or {}
    wanted = dict(pair.split("=", 1) for pair in TEAM_ENV)
    arrived = {name: env.get(name) for name in wanted}
    stated = []
    if not seen:
        stated.append("the exec was never reached")
    if arrived != wanted:
        stated.append(f"the team vars arrived as {arrived}")
    if "ANTHROPIC_BASE_URL" in env:
        stated.append("the poison survived into the exec environment")
    if "poison" not in said.getvalue():
        stated.append("the strip was silent")
    if parent_after != POISON_URL:
        stated.append("the parent environment was mutated")
    if "cannot exec" not in outcome:
        stated.append(f"the run ended in {outcome!r}, not the exec error")
    check("exec-environment-is-prepared-not-inherited",
          "the process an exec becomes finds the team vars set and the poison gone",
          not stated, "; ".join(stated))
    return checked


