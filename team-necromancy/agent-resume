    try:
        with s.tempfile.TemporaryDirectory() as td:
            root = Path(td)
            eng = Resolver(needs=Needs(maybe=set(NEED)))
            eng._projects_dir, eng._teams_dir = root / "projects", root / "teams"
            source, destination = "session-lead-fixture-source", "session-lead-fixture-destination"
            lead_id = agent_id_of("team-lead", source)

            def transcript(project, session, team, stamped=True):
