@unit(('reap-cut-before-the-staged-read', 'the reap reads the staged copy after the cut and folds it into the receipt'))
def _check_reap_cut_before_the_staged_read(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs

    reap_node = funcs["reap_team"]
    revalidations = {}
    receipt_from_caught = False
    for sub in ast.walk(reap_node):
        if not isinstance(sub, ast.Assign) or len(sub.targets) != 1:
            continue
        target, value = sub.targets[0], sub.value
        if not isinstance(target, ast.Name) or not isinstance(value, ast.Call):
            continue
        if (isinstance(value.func, ast.Attribute)
                and value.func.attr == "revalidate_reap"):
            revalidations[target.id] = (sub.lineno, {key.arg for key in value.keywords})
        if (target.id == "receipt" and getattr(value.func, "id", None) == "prepared"
                and value.args and isinstance(value.args[0], ast.Subscript)
                and getattr(value.args[0].value, "id", None) == "caught"):
            receipt_from_caught = True
    cuts = [sub.lineno for sub in ast.walk(reap_node)
            if isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
            and sub.func.attr == "rename"
            and [getattr(a, "id", None) for a in sub.args] == ["team_dir", "staged"]]
    out_of_order = []
    before_cut = revalidations.get("checked")
    caught = revalidations.get("caught")
    stable = revalidations.get("stable")
    if not cuts:
        out_of_order.append("nothing renames team_dir aside")
    elif not before_cut or not caught or not stable:
        out_of_order.append(f"revalidations={sorted(revalidations)}")
    else:
        cut = min(cuts)
        if not (before_cut[0] < cut < caught[0] < stable[0]):
            out_of_order.append("the selected reap is not revalidated before and after the cut")
        if "staged" not in caught[1] or not {"staged", "expected_generation"} <= stable[1]:
            out_of_order.append("the post-cut revalidations do not retain the staged generation")
        if not receipt_from_caught:
            out_of_order.append("the receipt is not prepared from the post-cut revalidation")
    check("reap-cut-before-the-staged-read",
          "the reap reads the staged copy after the cut and folds it into the receipt",
          not out_of_order, "; ".join(out_of_order))
    return checked


