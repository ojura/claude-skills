            old_state = eng._roster_snapshot(old, census).state
        finally:
            sys.stdin = real_stdin
            if real_input is not None:
                globals()["input"] = real_input
            else:
                globals().pop("input", None)
        launched = [row for row in f.fake.processes if row[0] >= 4309700]
    told = " ".join(without_wrap_arrows(out.getvalue()).split())
    worn = sorted(argv[-1] for _pid, _ppid, argv in launched)
    facts = {
        "the run ends cleanly": code == 0,
        "it asks nothing": not prompts,
        "it retires OLDHOME once": told.count(f"reaped {old} (roster archived") == 1,
        "no step rebuilds it": "rebuild" not in told and old_state == "absent",
        "m is left running where it is": f"m already runs as {agent_id_of('m', new)}" in told
            and m_pid in {row[0] for row in f.fake.processes},
        "x is left running where it is": "x noop" in told
            and x_pid in {row[0] for row in f.fake.processes},
        "a and b start on NEWHOME": worn == [agent_id_of("a", new), agent_id_of("b", new)],
        "a and b come back as their argv team, not OLDHOME": restored.get("a") is None
            and restored.get("b") is None and restored.get("m") == new
            and restored.get("x") == other,
    }
    wrong = sorted(fact for fact, ok in facts.items() if not ok)
    return not wrong, (", ".join(wrong) + f"; code {code}, prompts {prompts}, started {worn}, "
                       f"come back as {restored}, OLDHOME {old_state}, said {told[-900:]}")


@unit(
