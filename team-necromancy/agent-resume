def operating_iso(start, offset_ms):
    """The transcript timestamp `offset_ms` after `start`, both epoch ms."""
    at = start + offset_ms
    return (time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(at // 1000))
            + f".{at % 1000:03d}Z")


def operating_conversation(f, start, session, name=None, root_team=None, later=(),
                           spawns=()):
    """Write one conversation for the operating-team fixtures and return its path.

    Times are offsets from `start`, when the fixture's processes started. The
    window root carries (name, root_team) when given and is written half an
    hour before that. `later` adds lines stamped (name, team) at their offsets,
    and `spawns` adds spawn payloads into a team at theirs; a last-prompt names
    the final line, so the restore walk reaches the root.
    """
    rows = [{"type": "user", "uuid": f"{session}-0", "parentUuid": None,
             "sessionId": session, "timestamp": operating_iso(start, -1_800_000),
             "message": {"role": "user", "content": "start"},
             **({"agentName": name, "teamName": root_team} if root_team else {})}]
    for team, offset in later:
        rows.append({"type": "assistant", "uuid": f"{session}-{len(rows)}",
                     "parentUuid": rows[-1]["uuid"], "sessionId": session,
                     "timestamp": operating_iso(start, offset), "agentName": name,
                     "teamName": team,
                     "message": {"role": "assistant", "content": "work"}})
    for team, offset in spawns:
        spawned = f"spawned{len(rows)}"
        rows.append({"type": "user", "uuid": f"{session}-{len(rows)}",
                     "parentUuid": rows[-1]["uuid"], "sessionId": session,
                     "isSidechain": False, "timestamp": operating_iso(start, offset),
                     "message": {"role": "user", "content": []},
                     "toolUseResult": {"status": "teammate_spawned", "name": spawned,
                                       "team_name": team,
                                       "agent_id": agent_id_of(spawned, team)}})
    rows.append({"type": "last-prompt", "leafUuid": rows[-1]["uuid"],
                 "sessionId": session})
    path = f.project / f"{session}.jsonl"
    path.write_text("".join(fixture_line(row) + "\n" for row in rows))
    return path


