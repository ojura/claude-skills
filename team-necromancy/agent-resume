@unit(('no-launch-onto-live-conversation', "a lead is not exec'd, nor a member spawned, onto a live conversation"))
def _check_no_launch_onto_live_conversation(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # The guarantee itself, not merely its address: every answer below carries
    # the exact process snapshot and runtime that already_running consumes.
    def role_ctx(session, role, agent_id, owner=None, elsewhere=(), route=None):
        name, team = name_and_team(agent_id)
        snapshot = immutable({
            "best_by_session": ({session: owner} if owner is not None else {}),
            "by_pid": ({owner["pid"]: {"pid": owner["pid"], "state_note": ""}}
                       if owner is not None else {}),
        })
        records = tuple(immutable({"pid": pid, "seat": None}) for pid in elsewhere)
        runtime = immutable({
            "records": records, "external": records, "lineage": (),
            "seats": (), "seat_state": "outside tmux" if records else "stopped",
        })
        return fixture_target(
            session, identity={"agentId": agent_id, "agentName": name,
                               "teamName": team, "role": role},
            process={"snapshot": snapshot, "runtime": runtime}, route=route)

    live_owner = immutable({"pid": PID_CEILING + 4242, "updated": "x", "alive": True,
                            "session": "live-uuid"})
    dead_owner = immutable({**live_owner, "alive": False})
    live_member = role_ctx("live-uuid", "member", "a@t", live_owner)
    live_lead = role_ctx("live-uuid", "lead", "team-lead@t", live_owner)
    member = role_ctx("u", "member", "a@t", elsewhere=(PID_CEILING + 99,))
    lead = role_ctx("u", "lead", "team-lead@t", elsewhere=(PID_CEILING + 99,))
    moved_member = role_ctx(
        "live-uuid", "member", "a@t", live_owner,
        route={"to_team": "t", "automatic": False})
    moved_lead = role_ctx(
        "live-uuid", "lead", "team-lead@t", live_owner,
        route={"to_team": "t", "automatic": False})
    redirected = role_ctx(
        "u", "member", "a@t", elsewhere=(PID_CEILING + 99,),
        route={"to_team": "t", "automatic": True})

    class _NoForce:
        force = False

    class _Forced:
        force = True

    def why_of(ctx_, args_, **kw):
        answer = already_running(ctx_, args_, **kw)
        return answer[0] if answer else ""

    stops = {
        "a live conversation stops an exec": bool(already_running(live_lead, _NoForce)),
        "a live conversation stops a spawn": bool(already_running(live_member, _NoForce)),
        "and both name the session and the pid": all(
            "live-uuid" in why_of(ctx, _NoForce)
            and str(PID_CEILING + 4242) in why_of(ctx, _NoForce)
            for ctx in (live_lead, live_member)),
        "--force releases the exec": already_running(live_lead, _Forced) is None,
        "--force releases the spawn": already_running(live_member, _Forced) is None,
        "a member's rebind is exempt": already_running(moved_member, _NoForce) is None,
        "a lead's rebind is not exempt here": bool(already_running(moved_lead, _NoForce)),
        "a member already in the pane stops the spawn":
            already_running(member, _NoForce, here=[PID_CEILING + 77], pane="%3")
            == (f"a@t is already running in pane %3 (pid {PID_CEILING + 77})", True),
        "an explicit rebind may take that pane":
            already_running(role_ctx(
                "u", "member", "a@t", elsewhere=(PID_CEILING + 99,),
                route={"to_team": "t", "automatic": False}),
                _NoForce, here=[PID_CEILING + 77], pane="%3") is None,
        "a redirect chosen by the tool may not":
            already_running(redirected, _NoForce, here=[PID_CEILING + 77], pane="%3") is not None,
        "a lead asks no seat question":
            "pane" not in why_of(live_lead, _NoForce, here=[PID_CEILING + 77], pane="%3"),
        "the same id running elsewhere stops the spawn":
            "outside pane %3" in why_of(member, _NoForce, pane="%3"),
        "and a lead never asks it": already_running(lead, _NoForce, pane="%3") is None,
        "its own pane is not elsewhere": (already_running(
            member, _NoForce, here=[PID_CEILING + 99], pane="%3") or (None, None))[1] is True,
        "a dead owner stops nothing": all(
            already_running(role_ctx("live-uuid", role, agent_id, dead_owner),
                            _NoForce) is None
            for role, agent_id in (("lead", "team-lead@t"), ("member", "a@t"))),
        "and neither does no owner at all": all(
            already_running(role_ctx("live-uuid", role, agent_id), _NoForce) is None
            for role, agent_id in (("lead", "team-lead@t"), ("member", "a@t"))),
    }
    wrong = sorted(k for k, good in stops.items() if not good)
    check("no-launch-onto-live-conversation", "a lead is not exec'd, nor a member spawned, onto a live conversation",
          not wrong, ", ".join(wrong))
    return checked


