                (corpus / "teams" / name / "config.json").read_text())
        moved = corpus / "projects" / "corpus" / f"{source_lead}.jsonl"
        after["stamp"] = stamped_team(moved)
        after["receipts"] = restamp_receipts(moved)

    # A second process wearing the source team and holding nothing. --force may
    # set a wearer aside; it may never set aside one holding a stamped
    # transcript, which is why this row carries no --resume.
    wearing_source = ((PID_CEILING + 919191, 1,
                       (FAKE_AGENT_BIN, "--agent-id", f"observer@{source}")),)

    status, _entry, _fake, said = resume_run(
        f"team-lead@{source}", table=wearing_source, prepare=prepare,
        inspect=inspect, to_team=dest, force=True, with_mail=True, yes=True,
        no_attach=True)

