    globals()["RESOLVER"] = counting = corpus_engine()
    counting._session_registry = lambda: []
    counting._process_table = lambda refresh=False: []
    try:
        with capturing("out") as census_out, \
                capturing("err"):
            run_census()
        # Both sweeps: under --all the two numbers coincide, so only the bare
        # one says whether the second is the whole population or a repeat of
        # the first.
        with capturing("out") as pop_out:
            run_doctor(_Args(team=None, agent_id=None, all_members=True))
        with capturing("out") as some_out:
            run_doctor(_Args(team=None, agent_id=None, all_members=False))
    finally:
        globals()["RESOLVER"] = real_resolver

    def said(text):
        return re.search(r"(\d+) of (\d+) teams examined", flat(text))
    total = re.search(r"(\d+) teams in all", flat(census_out.getvalue()))
    swept_pop, some_pop = said(pop_out.getvalue()), said(some_out.getvalue())
    printed_blocks = len([ln for ln in pop_out.getvalue().splitlines()
                          if ln[:1].isalpha() and ln.split()[:1]
                          and ln.split()[0].isupper()])
    counts = {
        "the census says how many teams in all": bool(total),
        "the sweep says how many of how many it examined": bool(swept_pop),
        "the two reports count one set": bool(total and swept_pop)
            and total.group(1) == swept_pop.group(2),
        "and it is the set the engine knows":
            bool(total) and int(total.group(1)) == len(counting._known_teams()),
        "the sweep examined as many teams as it printed":
            bool(swept_pop) and int(swept_pop.group(1)) == printed_blocks,
        "a bare sweep counts against that same population":
            bool(some_pop) and some_pop.group(2) == swept_pop.group(2),
        "and against it, not against what it examined":
            bool(some_pop) and int(some_pop.group(1)) < int(some_pop.group(2)),
    }
    wrong = sorted(k for k, ok in counts.items() if not ok)
    check("census-and-doctor-count-the-same-teams",
          "the census total and the sweep's population are the same set",
          not wrong, ", ".join(wrong + [
              f"census {total and total.group(1)}, "
              f"sweep {swept_pop and swept_pop.group(0)}"]))
    return checked


