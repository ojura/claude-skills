class RoomRefused(Exception):
    """A split run's worker directories cannot be used, so no worker was started."""


def owner_record(directory):
    """Write down, inside a directory a run made, which run made it.

    The run's socket root and its shares' room are named by one letter and
    mkdtemp's eight characters, with no pid, because a socket path has no
    bytes to spare at the depth a split inside a share reaches. A directory a
    killed run left behind names that run through this file instead: the
    pid, its start time and the command. Returns what it wrote.
    """
    said = {"pid": os.getpid(),
            "started": Resolver(needs=Needs(maybe=set(NEED)))._proc_start(os.getpid()),
            "command": list(sys.argv)}
    (Path(directory) / "owner").write_text(json.dumps(said) + "\n")
    return said


def owned_directory(prefix):
    """A directory of this run's own under TMPDIR, already holding its owner record.

    Named by prefix and mkdtemp's eight characters. The run's socket root and
    its shares' room are both made here, so a directory of either kind holds
    the record from the moment it exists; a record that cannot be written
    takes the directory away with it.
    """
    made = Path(tempfile.mkdtemp(prefix=prefix))
    try:
        owner_record(made)
    except BaseException:
        shutil.rmtree(made, ignore_errors=True)
        raise
    return made


def worker_room_faults(room, roots):
    """What is wrong with the TMPDIRs a split run would give its workers, as sentences.

    roots holds each worker's TMPDIR in start order, None for a worker given
    none. Each has to be a directory of its own inside room, the one directory
    the run removes, and short enough that the socket root a worker makes in
    it leaves room for the suite's longest socket name. No sentences means the
    directories can be used.
    """
    faults, seen = [], {}
    for at, root in enumerate(roots):
        if not root:
            faults.append(f"worker {at} has no TMPDIR")
            continue
        root = Path(root)
        if Path(room) not in root.parents:
            faults.append(f"worker {at}'s TMPDIR {root} is not inside the room {room}")
        if root in seen:
            faults.append(f"workers {seen[root]} and {at} share the TMPDIR {root}")
        seen.setdefault(root, at)
        if socket_room_fault(root / WORKER_SOCKET_ROOT):
            used = len(os.fsencode(str(root / WORKER_SOCKET_ROOT))) + 1
            faults.append(f"worker {at}'s TMPDIR {root} leaves {SOCKET_PATH_LIMIT - 1 - used} "
                          f"bytes for a socket name in the socket root a worker makes there, "
                          f"where the suite builds names of up to {SOCKET_NAME_ROOM}")
    return faults


# The units declared with rooms=True, by function name: each makes a room of
# worker directories under the TMPDIR of the process it runs in, each worker's
# socket root a level below that process's own, by running run_shares or by
# splitting a copy of this tool with --jobs (unit()).
ROOM_MAKING_UNITS = set()


def deepest_socket_root(base, live, jobs, share=None, units=None):
    """The deepest socket root a run under base makes, mkdtemp's characters shown as x.

    A run's own socket root is base/s and mkdtemp's eight characters. A split
    live run gives each worker room/<at> as its TMPDIR, a level of rooms with
    the room named by one letter and mkdtemp's characters, and the worker
    makes its socket root there. A unit declared with rooms=True makes one more
    level below the process it runs in: a read-only run runs the read-only
    units, and a live run that does not split and each share run the live
    ones, and a split run's shares make theirs a level below the run. units
    is UNITS unless given, so the fault fixture's copy, which runs units of
    its own and none of these, counts no level for them. Checking this path
    against the byte budget once, before anything is made, refuses a TMPDIR
    the run cannot use instead of failing at the depth that first runs out of
    bytes.
    """
    makes_rooms = any(entry[0] in ROOM_MAKING_UNITS and bool(entry[3]) == bool(live)
                      for entry in (UNITS if units is None else units))
    levels = int(live and jobs > 1 and share is None) + int(makes_rooms)
    at = str(max(jobs, 2) - 1)
    path = Path(base)
    for _level in range(levels):
        path = path / ("w" + "x" * 8) / at
    return path / WORKER_SOCKET_ROOT


def socket_room_fault(root):
    """Why socket paths under this root could be too long, or None when they fit.

    Asked before a run puts any socket question to the root, with the root's
    actual path, mkdtemp suffix included, and the room the suite's longest
    socket name needs.
    """
    used = len(os.fsencode(str(root))) + 1
    if used + SOCKET_NAME_ROOM < SOCKET_PATH_LIMIT:
        return None
    return (f"the socket root {root} takes {used} bytes of every socket path, which leaves "
            f"{SOCKET_PATH_LIMIT - 1 - used} for a name where the suite builds names of up to "
            f"{SOCKET_NAME_ROOM}")


def never_signalled(pid):
    """Why this run must never signal pid, whatever else is true of it, or None.

    pid 1, this process and every process it descends from, read up from its
    parent by _ProcessFence.ancestors: the user's service manager adopts
    orphans and ends the whole desktop session on SIGTERM, and this run's
    ancestors are what started it.
    """
    if pid == 1:
        return "pid 1"
    if pid == os.getpid():
        return "this run itself"
    if pid in _ProcessFence.ancestors():
        return "an ancestor of this run"
    return None


def owned_group_refusal(pid, started, bound, name=None):
    """Why this run must not signal pid, or None.

    never_signalled's reasons first, then any process named systemd, which is
    never signalled either. Anything else is signalled only if it started in a
    later clock tick than this run, bound, since start times count ticks and
    everything this run starts begins after it does. name is the command name
    pid's stat file gives; when the caller has not read it, it is read here,
    which _ProcessFence.identity does only for a process under this run.
    """
    guard = never_signalled(pid)
    if guard:
        return guard
    if name is None:
        identity = _ProcessFence.identity(pid)
        if identity is None:
            return "not a process running under this run"
        name = identity[3]
    if name == "systemd":
        return "a systemd process"
    if not (str(started).isdigit() and str(bound).isdigit()) or int(started) <= int(bound):
        return "it did not start after this run"
    return None


def ready_to_read(fd, wait=0.0):
    """Whether fd can be read without blocking, waiting up to wait seconds.

    A pidfd turns ready when its process exits, and a pipe when its last write
    end is closed. poll, because select.select refuses a descriptor numbered
    1024 or more.
    """
    import select
    poller = select.poll()
    poller.register(fd, select.POLLIN)
    return bool(poller.poll(max(0, int(wait * 1000))))


def _pidfd_for(pid, started):
    """An open pidfd for pid while it is still the process that started at started, else None.

    Opened first and compared after: a pidfd names one process for as long as
    it is open, so once the start time still matches, no signal sent through
    it can reach a process the kernel later gives the same pid.
    """
    try:
        fd = os.pidfd_open(pid)
    except OSError:
        return None
    if not _ProcessFence.running(pid, started):
        os.close(fd)
        return None
    return fd


def end_processes(chosen, grace=3.0, rounds=20):
    """End what chosen picks, round after round; returns (ended, left running, refused).

    chosen is handed, each round, the processes under this run as they are
    then, as _ProcessFence.run_processes reads them, and returns the
    identities of the processes to end, by pid. A process
    is signalled only through a pidfd opened while its start time was the one
    picked, and only when owned_group_refusal has no reason against it; each
    is asked to stop, then made to. The next round reads the processes again,
    so what a process started while the last round waited is found, and the
    rounds stop when one finds nothing left to end. A process still running
    after SIGKILL is not signalled again. ended and left are sorted pids. left
    is what chosen still picks after the last round, from a read of its own:
    a refused process, one that outlived SIGKILL and one for which no pidfd
    could be opened are all named there. refused holds one sentence per refusal.
    """
    import signal

    gone = ready_to_read

    bound = _ProcessFence.start_time(os.getpid())
    ended, refused, refused_at, given_up = set(), [], set(), set()
    for _round in range(rounds):
        targets = {}
        for pid, (_parent, _group, started, name) in chosen(_ProcessFence.run_processes()).items():
            if (pid, started) in given_up or (pid, started) in refused_at:
                continue
            reason = owned_group_refusal(pid, started, bound, name)
            if reason:
                refused_at.add((pid, started))
                refused.append(f"pid {pid} is {reason}")
                continue
            fd = _pidfd_for(pid, started)
            if fd is not None:
                targets[pid] = (started, fd)
        if not targets:
            break
        try:
            for number in (signal.SIGTERM, signal.SIGKILL):
                for _started, fd in targets.values():
                    with contextlib.suppress(OSError):
                        signal.pidfd_send_signal(fd, number)
                deadline = time.monotonic() + grace
                while time.monotonic() < deadline and not all(
                        gone(fd) for _started, fd in targets.values()):
                    time.sleep(0.02)
                if all(gone(fd) for _started, fd in targets.values()):
                    break
            for pid, (started, fd) in targets.items():
                if gone(fd):
                    ended.add(pid)
                else:
                    given_up.add((pid, started))
        finally:
            for _started, fd in targets.values():
                os.close(fd)
    left = sorted(chosen(_ProcessFence.run_processes()))
    return sorted(ended), left, refused


def end_process_tree(pid, started, grace=3.0):
    """End pid, while it is the process that started at started, with what it started; returns the pids still running.

    What it started is everything under it and every member of its process
    group, read again each round, because a process stays in its group when its
    parent ends first, though it no longer descends from pid; this run adopts
    such a process, so it is among the processes under the run. A process
    found once is followed into the next round by what it starts in turn.
    Everything here is read from the processes under this run, so pid has to
    be one of them.
    """
    if not _ProcessFence.running(pid, started):
        return []
    found = {pid: started}

    def chosen(processes):
        picked = {}
        for root, born in list(found.items()):
            identity = processes.get(root)
            if not identity or identity[2] != born:
                continue
            picked[root] = identity
            picked.update({member: processes[member]
                           for member in _ProcessFence.subtree(root, processes)})
        picked.update({member: identity for member, identity in processes.items()
                       if identity[1] == pid})
        found.update({member: identity[2] for member, identity in picked.items()})
        return picked

    return end_processes(chosen, grace)[1]


def end_run_descendants(grace=3.0):
    """End everything under this run; returns (ended, left running, refused) as end_processes does."""
    return end_processes(lambda processes: processes, grace)


def adopt_orphans(adopting=True):
    """Make this process the subreaper of what is under it, or stop it being one; returns what it was.

    A run that is one keeps every process its fixtures start under it however
    the processes in between end, so finish_run ends them and nothing the run
    started outlives it unseen. Returns the setting it replaced, or None where
    the kernel offers none: the run then adopts nothing, and its tier's
    TIER_ADOPTS row fails and says so.
    """
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    was = ctypes.c_int(0)
    if libc.prctl(PR_GET_CHILD_SUBREAPER, ctypes.byref(was), 0, 0, 0) != 0:
        return None
    if libc.prctl(PR_SET_CHILD_SUBREAPER, int(adopting), 0, 0, 0) != 0:
        return None
    return bool(was.value)


def wait_for_command_line(pid, bound=10.0):
    """Wait until pid's command line is set, up to bound seconds; returns whether it is.

    Popen returns once the child's exec has begun, and until the exec has set
    the child's arguments its command line reads empty, so a process table
    taken then leaves the child out. Read from /proc itself rather than through
    the engine's reader, so the wait tells the run's fence nothing: a check
    that asks the fence about the process next finds it as it would have
    without the wait. A wait that reaches its bound only lets the caller go on
    as it would have before it waited, so no check loses an arm to it.
    """
    deadline = time.monotonic() + bound
    while True:
        with contextlib.suppress(OSError):
            if Path(f"/proc/{pid}/cmdline").read_bytes():
                return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.01)


def orphan_adopted(bound=10):
    """Make an orphan on purpose and say whether this process adopted it.

    Returns (adopted, its pid, whether it ended). setsid --fork starts a child
    that starts the sleeper and exits at once, with this process's setting
    left as it is, so the sleeper's parent has exited before anyone asks about
    it and the kernel has given it to the nearest process that adopts orphans.
    The sleeper says its pid in a file, as start_stray's does, and waits for
    end of file on a pipe that only this process can write to. Whether its
    parent is this process is read off this process's own children files
    (_ProcessFence.children), which reads nothing outside the run. Then this
    process closes its write end of that pipe, and the sleeper ends by itself
    wherever it went, with no signal sent; its end is waited for, up to bound
    seconds, on a second pipe that only the sleeper can write to. An adopted
    one stays a zombie under this run, which nothing counts; one that was not
    adopted is outside the run, where nothing of the run's would reach it. pid
    is 0 when it never said it.
    """
    room = Path(tempfile.mkdtemp(prefix="o"))
    told = room / "pid"
    hold, release = os.pipe()
    life, line = os.pipe()
    adopted, pid, ended = False, 0, False
    try:
        try:
            subprocess.Popen(["setsid", "--fork", sys.executable, "-c",
                              "import os, sys; open(sys.argv[1], 'w').write(str(os.getpid())); "
                              "os.read(0, 1)", str(told)],
                             stdin=hold, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             pass_fds=(line,)).wait()
        finally:
            os.close(hold)
            os.close(line)
        deadline = time.monotonic() + bound
        while not pid and time.monotonic() < deadline:
            with contextlib.suppress(OSError, ValueError):
                pid = int(told.read_text().strip() or 0)
            if not pid:
                time.sleep(0.02)
        adopted = bool(pid) and pid in _ProcessFence.children(os.getpid())
    finally:
        os.close(release)
        try:
            ended = ready_to_read(life, bound)
        finally:
            os.close(life)
            shutil.rmtree(room, ignore_errors=True)
    return adopted, pid, ended


@contextlib.contextmanager
def orphans_go_elsewhere():
    """A block in which a process orphaned under this run is not adopted by it.

    For a fixture that has to place a process outside this run's lineage, as
    another run's would be: it goes to whichever process above this run adopts
    orphans. The run's own setting is put back after.
    """
    was = adopt_orphans(False)
    try:
        yield
    finally:
        if was is not None:
            adopt_orphans(was)


def finish_run(diagnostics=None):
    """End whatever still runs under this run, and say so; returns (ended, left running, refused).

    A run's units end what they start, so anything found here is a leak: it is
    ended and named on the diagnostic stream, with whatever could not be ended
    or was refused. The outermost run_selftest call also states what this
    returned in its tier's TIER_LEFT row.
    """
    ended, left, refused = end_run_descendants()
    if ended:
        write_diagnostic("the run ended processes it had started and left running: "
                         + ", ".join(map(str, ended)), diagnostics)
    if left or refused:
        write_diagnostic("the run could not end everything it had started: " + "; ".join(
            [*refused, *(f"pid {pid} is still running" for pid in left)]), diagnostics)
    return ended, left, refused


def start_copy_run(argv, env):
    """Start a copy of a selftest run in a session of its own, its output piped to the caller.

    The fault fixture's copies, the copy without a corpus and the run given a
    TMPDIR too long for its sockets all start this way and are waited for
    inside owned_group. A session of its own keeps a terminal's signals off it;
    its parent is this run, so it stays under the run.
    """
    return subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            stdin=subprocess.DEVNULL, text=True, start_new_session=True, env=env)


def start_wrapped(argv):
    """Start a parent that starts argv and waits on it, in a session of its own, as a pane's root.

    The seat fixture's agent is a real child of a real process this way. Should
    the parent end first, the agent is this run's to adopt.
    """
    wrapping = ("import subprocess, sys\n"
                "subprocess.Popen(sys.argv[1:], executable=sys.executable).wait()\n")
    return subprocess.Popen([sys.executable, "-c", wrapping, *argv], start_new_session=True,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def start_stray(told, *argv, wait=60, program=None):
    """Start a sleeper outside this run's lineage, as another run's would be; returns (pid, life line).

    setsid --fork starts it from a child that exits at once, and this run
    adopts nothing meanwhile, so the process above this run that adopts
    orphans takes it and its parent chain never reaches this run. It writes
    its pid to told, which is read rather than waited for on a clock, up to
    wait seconds. It holds none of this run's streams, so a reader of them
    never waits on it. Nothing under this run ends it, and _ProcessFence's
    readers do not read it, since it is not under this run: the caller ends
    it with end_stray, by its pid and the life line: the read end of a pipe
    that only the sleeper can write to. pid is 0 when it never said it.

    program, when given, is the argv[0] the sleeper wears: the interpreter
    setsid starts executes itself again under that name before the sleeper
    says its pid, as the suite's fake agents wear FAKE_AGENT_BIN, so a check
    can place a process that reads as an agent outside the run.

    Any exception while it is made or while its pid is waited for, Terminated
    included, ends it through end_stray, by the pid it said by then, and closes
    the life line, since nothing else ends a stray outside the run.
    """
    life, line = os.pipe()
    sleeper = ["-c", "import os, sys, time;"
                     "open(sys.argv[1], 'w').write(str(os.getpid()));"
                     "time.sleep(30)", str(told), *argv]
    named = (["-c", "import os, sys; os.execv(sys.executable, sys.argv[1:])", program]
             if program else [])

    def said():
        with contextlib.suppress(OSError, ValueError):
            return int(Path(told).read_text().strip() or 0)
        return 0

    try:
        try:
            with orphans_go_elsewhere():
                subprocess.Popen(["setsid", "--fork", sys.executable, *named, *sleeper],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, pass_fds=(line,)).wait()
        finally:
            os.close(line)
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if pid := said():
                return pid, life
            time.sleep(0.02)
        return 0, life
    except BaseException:
        end_stray(said(), life)
        raise


def end_stray(pid, life, grace=3.0):
    """End the sleeper start_stray made, by its pid and life line; returns whether it has ended.

    Nothing is ever written to the life line, so it reads as ready only once
    the sleeper has exited and the pipe's last write end with it. A pidfd is
    opened for pid first and the line asked after: if the sleeper has not
    exited by then, the pidfd names it, and no signal sent through it can
    reach a process the kernel later gives the same pid. The sleeper is asked
    to stop, then made to. never_signalled still holds; the sleeper itself is
    never read. The life line is closed either way.
    """
    import signal

    def ended():
        return ready_to_read(life)

    try:
        if not pid or ended() or never_signalled(pid):
            return ended()
        try:
            fd = os.pidfd_open(pid)
        except OSError:
            return ended()
        try:
            if ended():
                return True
            for number in (signal.SIGTERM, signal.SIGKILL):
                with contextlib.suppress(OSError):
                    signal.pidfd_send_signal(fd, number)
                deadline = time.monotonic() + grace
                while time.monotonic() < deadline and not ended():
                    time.sleep(0.02)
                if ended():
                    return True
            return False
        finally:
            os.close(fd)
    finally:
        os.close(life)


class Terminated(BaseException):
    """The run was sent SIGTERM, raised where it was so its cleanup runs.

    BaseException, as Refusal is, so a unit's except Exception does not take
    it for a fault of its own and carry on.
    """


# The signal a run that called raise_on_sigterm was sent, once it was sent: a
# unit that catches every exception can swallow the first Terminated, and the
# runner raises it again at the next unit's edge.
TERMINATION = {"signal": None}


def raise_on_sigterm():
    """Make a SIGTERM raise Terminated instead of ending the process; returns the undo.

    A run's owner asks it to stop with SIGTERM, and a process that dies of the
    signal runs no finally: what it started and the directories it made would
    stay behind until whatever adopted them ended them. Raised instead, the signal unwinds
    the run through every owned_group and finally on the way out. Only the main
    thread can take a signal handler, so in any other thread this changes
    nothing and the undo does nothing.
    """
    import signal

    def raise_terminated(number, _frame):
        TERMINATION["signal"] = number
        raise Terminated(f"sent signal {number}")

    TERMINATION["signal"] = None
    try:
        was = signal.signal(signal.SIGTERM, raise_terminated)
    except ValueError:
        return lambda: None
    return lambda: signal.signal(signal.SIGTERM, was)


@contextlib.contextmanager
def owned_group(process):
    """A process started in a session of its own, ended with what it started when the block is left.

    The exit ends it whatever left the block, a normal return, a timeout, an
    interruption or a failure around it. The block is given the function that
    ends it, for a wait to call instead of killing the leader alone: its
    terminal children are found through the leader, so they are ended while
    it still runs or not at all. Should this run end first, what it started is
    still under the run, for finish_run to end, or under whatever adopted the
    run's orphans above it.
    """
    started = _ProcessFence.start_time(process.pid)

    def stop():
        return end_process_tree(process.pid, started)

    try:
        yield stop
    finally:
        stop()


def diagnostic_stream():
    """Where the runner writes text an operator has to be able to read whole.

    The stream the process started with, past any capture. A live tier runs
    with sys.stdout and sys.stderr taken into a buffer, and what its mid-run row
    keeps of that buffer is a line count and the first line, so a traceback
    written there would reach nobody past "Traceback (most recent call last):". In
    the read-only child and in a share this is the pipe the parent reads; at
    the top it is wherever the operator sent stderr. sys.__stderr__ is None in
    a process with no stderr at all, which is no reason to fail on top of the
    failure being reported.
    """
    return sys.__stderr__ or sys.stderr


def write_diagnostic(text, stream=None):
    """Write text whole to stream, the diagnostic stream unless a caller hands in its own."""
    stream = stream or diagnostic_stream()
    stream.write(text if text.endswith("\n") else text + "\n")
    stream.flush()


def ran_unit(run, s, diagnostics=None):
    """One unit's rows, and what ended the run when the unit did not report.

    For the unit's length this process's fence knows which unit runs and
    whether it is declared with machine=True, and FENCE_UNIT_VAR hands the
    same to every tool run the unit starts, so the engine's /proc readers here
    and there read processes by one rule (_ProcessFence). A refused read does
    not end the run: the fence writes it down, the tier's TIER_PROCS row names
    the unit, the reader and the pid, and every later unit still runs.
    RESOLVER's process caches are dropped as the unit starts and again in the
    finally, so a table a declared unit read of the whole machine reaches no
    other unit through RESOLVER, whatever ended the unit.

    Returns (rows, None) from a unit that reported, and ([], what ended it)
    from one that exited or raised. The tier stops there rather than running
    what is left: a unit patches RESOLVER, tmux, sys.stdin and globals and
    restores them on its way out, so a unit after one that never got there
    would be answering against whatever was left set.

    KeyboardInterrupt is not caught. answered() turns a Ctrl-C into a
    sentence about what is still running, and a catch here would take that
    away. Terminated is not caught either, and is raised again at the unit's
    edge when the unit swallowed it: a run that was sent SIGTERM stops, through
    its cleanup, instead of going on to the next unit.

    A raising unit's traceback is printed here, because catching the exception
    is what stops Python printing it, whole, to diagnostics: the diagnostic
    stream unless the caller hands in its own. The ended row carries the
    exception's type and message; the file, line and frames are in the
    traceback and nowhere else. A refusal has no traceback to print and needs
    none: it carries what it refused with, so the row names the reason even
    when die() wrote it into a buffer the unit discarded. SystemExit is still
    caught beside it, for a unit ended by something that is not a refusal.
    """
    fence = _process_fence()
    engine = globals()["RESOLVER"]
    engine._invalidate("process")
    handed = os.environ.get(FENCE_UNIT_VAR)
    fence.enter(run.__name__, run.__name__ in MACHINE_UNITS)
    os.environ[FENCE_UNIT_VAR] = fence.handed_down()
    try:
        if TERMINATION["signal"] is not None:
            raise Terminated(f"sent signal {TERMINATION['signal']}")
        produced, stopped = run(s), None
        if TERMINATION["signal"] is not None:
            raise Terminated(f"sent signal {TERMINATION['signal']}")
    except (KeyboardInterrupt, Terminated):
        raise
    except Refusal as refused:
        produced, stopped = [], f"refused: {refused.said}"
    except SystemExit as exc:
        produced, stopped = [], f"SystemExit: {exc.code}"
    except BaseException as exc:
        traceback.print_exc(file=diagnostics or diagnostic_stream())
        produced, stopped = [], f"{type(exc).__name__}: {exc}"
    finally:
        fence.leave()
        if handed is None:
            os.environ.pop(FENCE_UNIT_VAR, None)
        else:
            os.environ[FENCE_UNIT_VAR] = handed
        engine._invalidate("process")
    return produced, stopped


# The variable an audit sets to the file it wants the refusals in. Derived from
# the tool's name so a copy under another name keeps its own. A run that finds
# it unset sets it to a file of its own, so each refusal, in a selftest process
# or in a tool run one of its units started, is written to one file, which the
# tier's TIER_PROCS row reads.
FENCE_RECORD_VAR = f"{TOOL.upper().replace('-', '_')}_SELFTEST_FENCE"

# The variable ran_unit sets for one unit's length, so that every tool run the
# unit starts reads processes by that unit's rule: the root's pid, the root's
# start time, the fence's token, 1 for a unit declared with machine=True or 0,
# and the unit's name, separated by spaces. Derived from the tool's name as the
# record's variable is.
FENCE_UNIT_VAR = f"{TOOL.upper().replace('-', '_')}_SELFTEST_UNIT"


def _whole_pid(pid):
    """pid as an int when it is a number a process can hold, else None.

    An int above zero, or the decimal digits /proc names one by. A bool, a
    float, a string such as "self" or "1/task/1", and anything else names no
    process, or names one by a path the fence never judged.
    """
    if type(pid) is int:
        return pid if pid > 0 else None
    if type(pid) is str and pid.isascii() and pid.isdigit() and pid == str(int(pid)):
        return int(pid) or None
    return None


class _ProcessFence:
    """Which processes the engine's /proc readers may read while the selftest runs.

    A fixture can name any pid, and a real process may hold that number: the
    engine would then read a stranger's command line, state or environment,
    and what a check concluded would depend on what happened to run on the
    machine. So while the selftest runs, each reader asks here first, in the
    selftest process and in every tool run one of its units starts.

    The root is the selftest process that runs the units: a read-only run, a
    serial live run, one share of a split run, or the read-only child a live
    run starts. Each of them is the subreaper of what it starts, so whatever
    its units orphan stays under it. The declaration machine=True (unit())
    decides what the engine's process inputs, _FakeTmux.PROCESS_INPUTS,
    answer. A unit not declared with it sees through them the root and the
    processes under it now, and nothing else: the process table lists only
    those (listing), the session registry is empty (sees_registry), and a
    reader refuses every other pid. A declared unit reads the real machine on
    purpose: its table lists every process, its session registry is the real
    one, and a reader may also read a pid either of them named while that
    pid's start time is still the one read when it was named, or while no
    process holds it. In both worlds a reader may read a pid the run knows,
    because Popen started it here or a walk found it under the root, while its
    start time is still the one read when the run first learned of it, or once
    no process holds its number, where the read finds nothing; and any pid from
    PID_CEILING up, which no process can hold and from which the fixtures number
    the processes they invent. Outside any unit the undeclared rule holds.

    A refused pid is answered as a process that does not exist, and note
    writes the refusal down. Nothing of it is read, except the start time admit
    compares for a pid a declared unit's listing named or one the run knows. A
    value that is not a whole number above zero names no process and is refused
    the same way.

    A tool run a unit starts installs its fence from what the unit handed down
    in FENCE_UNIT_VAR (adopt_inherited_fence), so its root is the selftest
    process that runs the unit, not the tool run itself, and its unit,
    declaration and token are that unit's. It checks the root's start time
    before it walks the root's children, so a root that has gone leaves it no
    process at all, though another process may hold the root's pid by now. Its
    refusals go to the file FENCE_RECORD_VAR names, which the root's row
    reads once the tool run has exited.

    Popen tells the fence about every process it starts, so a child that
    exited before anyone asked about it is still one the run knows. What a
    fence learns it also writes, under its token, to a file beside the record
    (known_record), and a fence that meets a pid it has not learned reads what
    the run's other fences wrote there first: the selftest process and every
    tool run of its units keep one record of known pids between them. The
    processes under the root are found by walking /proc/<pid>/task/*/children
    down from it, which reads only those processes. A pass reads those files
    one after another, so when a process's parent exits meanwhile, the process
    can move to a subreaper inside the run between two of them and be in
    neither. So after each pass the walk (_walk_down) rereads every children
    file the pass read, and passes again, up to four passes, while a reread
    lists a pid the pass did not find. The same walk and a
    reader of one process's stat file are how the selftest ends what it
    started, in end_processes and the functions that use it.
    """

    def __init__(self, record=None, root=None, root_start=None, token=None, unit=None,
                 machine=False):
        self.root = os.getpid() if root is None else root
        self.root_start = self._start_of(self.root) if root is None else root_start
        self.token = token or os.urandom(6).hex()
        self.record = record
        self.known = {}
        self.known_read = 0
        self.unit, self.machine = unit, machine
        self.named, self.refused, self.unwritten, self.entered = {}, [], [], []

    def enter(self, name, machine):
        """Begin one unit: the pids it may read by name and its refusals start empty."""
        self.entered.append((self.unit, self.machine, self.named, self.refused))
        self.unit, self.machine = name, machine
        self.named, self.refused = {}, []

    def leave(self):
        """End the unit and go back to what held before it; returns the unit's refusals."""
        refused = self.refused
        self.unit, self.machine, self.named, self.refused = (
            self.entered.pop() if self.entered else (None, False, {}, []))
        return refused

    def handed_down(self):
        """What FENCE_UNIT_VAR holds for a tool run that the unit running now starts."""
        return f"{self.root} {self.root_start} {self.token} {int(self.machine)} {self.unit}"

    def spawned(self, pid):
        """Popen started this process here: the run knows it, with its start time now."""
        if pid not in self.known:
            self.learn(pid, self._start_of(pid))

    def known_record(self):
        """The file every fence of this run keeps the pids it learned in, beside the record."""
        return f"{self.record}.known" if self.record else None

    def learn(self, pid, started):
        """The run knows pid from now on with this start time, unless it already did.

        Written to known_record as well, so the run's other fences, the
        selftest process's and those of the tool runs its units start, find it
        there (catch_up).
        """
        if pid in self.known:
            return
        self.known[pid] = started
        shared = self.known_record()
        if shared:
            with contextlib.suppress(OSError):
                with open(shared, "a") as out:
                    out.write(json.dumps({"fence": self.token, "pid": pid,
                                          "start": started}) + "\n")

    def catch_up(self):
        """Take in what the run's other fences learned since this one last read known_record.

        A pid keeps the first start time this fence learned for it, its own or
        another fence's. Only whole lines are read, so a line another fence is
        still writing is read next time.
        """
        shared = self.known_record()
        if not shared:
            return
        try:
            with open(shared, "rb") as source:
                source.seek(self.known_read)
                added = source.read()
        except OSError:
            return
        complete = added[:added.rfind(b"\n") + 1]
        self.known_read += len(complete)
        for line in complete.splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            number = _whole_pid(row.get("pid")) if isinstance(row, dict) else None
            if number is not None and row.get("fence") == self.token:
                self.known.setdefault(number, row.get("start"))

    def sees_registry(self):
        """Whether the session registry is read: only by a unit declared to read the machine."""
        return self.machine

    def listing(self, pids):
        """Which of pids, a real /proc listing, the process table may read.

        For a declared unit every one, each named with its start time now.
        Otherwise the root and the processes under it, found before any of
        them is read, and pids from PID_CEILING up, which no process can hold,
        so a fixture that hands the table an invented pid still gets its row.
        A pid left out is never read and so never refused: a unit is refused
        only a pid it asked about.
        """
        if self.machine:
            self.name(pids)
            return list(pids)
        tree = self._tree()
        return [pid for pid in pids if pid in tree or pid >= PID_CEILING]

    def name(self, pids):
        """A real listing or session registry named these pids: keep each one's start time now."""
        for pid in pids:
            number = _whole_pid(pid)
            if number is not None:
                self.named[number] = self._start_of(number)

    def admit(self, pid, reader):
        """Whether reader may read pid; a refusal is written down by note.

        A pid from PID_CEILING up is admitted. Every other pid the run admits,
        whether a declared unit's listing or registry named it, Popen started
        it or a walk found it, is under one rule: it is read while its start
        time is the one recorded when the run learned of it, or once no process
        holds its number, and refused while another process holds it. A pid
        this fence has not learned is looked up in what the run's other fences
        learned (catch_up) before it counts as unknown. One under the root now
        is admitted, and the walk that finds it is how the run learns it. The
        pid's start time is read only for a named or known pid, the two cases
        that compare it, so a pid outside the run that neither covers is
        refused without anything of it being read.
        """
        number = _whole_pid(pid)
        if number is not None:
            if number >= PID_CEILING:
                return True
            named = self.machine and number in self.named
            if not named and number not in self.known:
                self.catch_up()
            if named or number in self.known:
                now = self._start_of(number)
                if named and now in (None, self.named[number]):
                    return True
                if number in self.known and now in (None, self.known[number]):
                    return True
            if number in self._tree():
                return True
        self.note(reader, pid)
        return False

    def note(self, reader, pid):
        """Write down one refused read, in this fence's list for the unit and in the record.

        Each record line holds the fence's token, the root, the process that
        was refused, the unit (None outside any unit), the reader, and the pid,
        or the repr of a value that is no pid. A line the record cannot take is
        kept here for the row in the root's own process. A tool run has no row
        of its own, so there it ends the run through die, which names the line
        on stderr and exits nonzero, for the unit that started the run to see.
        """
        number = _whole_pid(pid)
        shown = number if number is not None else repr(pid)
        self.refused.append((self.unit, reader, shown))
        line = json.dumps({"fence": self.token, "root": self.root, "process": os.getpid(),
                           "unit": self.unit, "reader": reader, "pid": shown})
        try:
            if not self.record:
                raise OSError("no record file is named")
            with open(self.record, "a") as out:
                out.write(line + "\n")
        except OSError as unwritable:
            if os.getpid() == self.root:
                self.unwritten.append(line)
            else:
                die(f"selftest: a refused read the record could not take ({unwritable}): "
                    f"{line}")

    def refusals_in_run(self):
        """Every refusal under this fence, as (unit, reader, pid, process), in the order written.

        Read from the record by this fence's token, which picks out this
        process's own refusals and those of every tool run its units started,
        and from the lines the record could not take.
        """
        try:
            lines = Path(self.record).read_text().splitlines() if self.record else []
        except OSError:
            lines = []
        found = []
        for line in [*lines, *self.unwritten]:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and row.get("fence") == self.token:
                found.append((row.get("unit"), row.get("reader"), row.get("pid"),
                              row.get("process")))
        return found

    def _tree(self):
        """The root and every process under it now; none once the root's start time has changed.

        The run learns each pid a walk finds, with its start time, the first
        time a walk finds it, and keeps it for the run's length (admit).
        """
        if self.root_start is None or self._start_of(self.root) != self.root_start:
            return set()
        tree = {self.root} | self._walk_down(self.root)
        for pid in tree:
            if pid not in self.known:
                self.learn(pid, self._start_of(pid))
        return tree

    # How the selftest ends what it started, and checks that it did. These
    # readers do not ask admit; what they can reach is limited by how they
    # find it instead. run_processes reads the children files of this process
    # and of every process found under it, each of them once more after the
    # pass that read it (_walk_down), and the stat file of each process found
    # that way. identity reads one pid's stat file only when that pid is this
    # process or the same walk finds it under this process now.
    # ancestors reads the stat files up the chain of parents from this
    # process's own parent, for never_signalled never to signal one of them.
    # Any other pid reads as no running process and is not read. A refused pid
    # that a process holds, and a value that is no pid, are written down by
    # note as the reader "cleanup stat", the way admit writes its refusals, so
    # the tier's row names them and an audit counts them. A process that left
    # the run's tree and still runs holds its pid, so it is written down as
    # refused, where one that has ended is not, and it does not pass for
    # ended.

    @classmethod
    def children(cls, pid):
        """The pids with pid as their parent now, by its threads' children files."""
        return set().union(*cls._task_children(pid).values())

    @staticmethod
    def _task_children(pid):
        """Each thread of pid, as its /proc task directory, with the pids its children file lists now.

        None at all when pid had gone before its threads could be listed.
        """
        listed = {}
        try:
            tasks = list(Path(f"/proc/{pid}/task").iterdir())
        except OSError:
            return listed
        for task in tasks:
            try:
                listed[task] = set(map(int, (task / "children").read_text().split()))
            except OSError:
                continue
        return listed

    @classmethod
    def _walk_once(cls, root):
        """One pass down from root: (every pid it found, root left out; the tasks with a children file it read)."""
        found, frontier, read = set(), [root], []
        while frontier:
            for task, listed in cls._task_children(frontier.pop()).items():
                read.append(task)
                for child in listed:
                    if child not in found:
                        found.add(child)
                        frontier.append(child)
        return found, read

    @staticmethod
    def _gained(read, found):
        """Whether a children file in read lists a pid now that is not in found."""
        for task in read:
            try:
                listed = set(map(int, (task / "children").read_text().split()))
            except OSError:
                continue
            if listed - found:
                return True
        return False

    @classmethod
    def _walk_down(cls, root):
        """Every pid under root now, root left out, by its threads' children files.

        A pass reads one children file after another, so when a process's
        parent exits while the pass is between two of them, the process is
        handed to a subreaper inside the run and can be in neither file: the
        subreaper, which is root or under it, had its file read before the
        process got there. Once there, the process stays in that file, so after
        each pass the walk reads every children file the pass read once more.
        One that lists a pid the pass did not find means a process moved, or
        started, while the pass ran, and the walk passes again, up to four
        passes. run_processes, identity and admit, through _tree, all walk this
        way.
        """
        for _pass in range(4):
            found, read = cls._walk_once(root)
            if not cls._gained(read, found):
                return found
        return found

    @staticmethod
    def _start_of(pid):
        """pid's start time from its stat file, field 22, or None when no process holds pid.

        The fence reads it for the root, for each process Popen starts or a walk
        finds under the root, for each pid a declared unit's listing or registry
        names, and, as admit judges a pid, for one the run knows or such a
        listing named. A zombie keeps its start time until it is reaped. Read as
        bytes, so a command name that is not UTF-8 does not hide the process.
        """
        try:
            stat = Path(f"/proc/{pid}/stat").read_bytes()
            return stat[stat.rindex(b")") + 2:].split()[19].decode()
        except (OSError, ValueError, IndexError):
            return None

    @staticmethod
    def _stat(pid):
        """(parent pid, process group, start time, command name) from pid's stat file, or None.

        It reads whatever pid it is given, so only the readers below call it,
        each with a pid its own walk found. The start time is the kernel's,
        field 22, as the string the engine's _proc_start gives, so a pid the
        kernel has since handed to another process reads with another start
        time. The command name is the stat file's own, decoded so that a name
        that is not UTF-8 still reads. A zombie has ended and reads as None, as
        a pid no process holds does.
        """
        try:
            stat = Path(f"/proc/{pid}/stat").read_bytes()
            name = stat[stat.index(b"(") + 1:stat.rindex(b")")].decode("utf-8", "replace")
            rest = stat[stat.rindex(b")") + 2:].split()
            state, parent, group, started = (rest[0].decode(), int(rest[1]), int(rest[2]),
                                             rest[19].decode())
        except (OSError, ValueError, IndexError):
            return None
        return None if state in ("Z", "X") else (parent, group, started, name)

    @classmethod
    def run_processes(cls):
        """{pid: identity} of every running process under this process now, each as _stat reads it."""
        return {pid: identity for pid in cls._walk_down(os.getpid())
                if (identity := cls._stat(pid))}

    @staticmethod
    def subtree(root, processes):
        """The pids in processes, a run_processes answer, with a chain of parents up to root."""
        children = {}
        for pid, identity in processes.items():
            children.setdefault(identity[0], []).append(pid)
        found, frontier = set(), [root]
        while frontier:
            for child in children.get(frontier.pop(), ()):
                if child not in found:
                    found.add(child)
                    frontier.append(child)
        return found

    @classmethod
    def identity(cls, pid):
        """pid's identity as _stat reads it when pid is this process or runs under it now, else None."""
        number = _whole_pid(pid)
        fence = PROCESS_FENCE
        if number is None:
            # Names no process, so there is nothing to read; written down as
            # admit writes a value that is no pid.
            if fence is not None:
                fence.note("cleanup stat", pid)
            return None
        if number == os.getpid() or number in cls._walk_down(os.getpid()):
            return cls._stat(number)
        if fence is not None:
            held, unknown = cls._held(number)
            if held:
                fence.note("cleanup stat", number)
            elif held is None:
                fence.note(f"cleanup stat, of a pid pidfd_open could not judge ({unknown})",
                           number)
        return None

    @staticmethod
    def _held(pid):
        """Whether a process holds pid, by opening a pidfd for it, which neither reads nor signals it.

        Returns (True, "") when one does and (False, "") on ESRCH, when none
        does. Any other error says nothing about pid, so it returns (None, the
        error's name), and the caller names that where a refusal would go and
        reads pid neither as held nor as gone.
        """
        try:
            os.close(os.pidfd_open(pid))
        except ProcessLookupError:
            return False, ""
        except OSError as unknown:
            import errno
            return None, errno.errorcode.get(unknown.errno, str(unknown.errno))
        return True, ""

    @classmethod
    def start_time(cls, pid):
        """pid's start time as identity reads it, or "" when it reads nothing."""
        identity = cls.identity(pid)
        return identity[2] if identity else ""

    @classmethod
    def running(cls, pid, started):
        """Whether pid runs under this process now as the process that started at started."""
        return bool(started) and cls.start_time(pid) == started

    @classmethod
    def ancestors(cls):
        """This process's ancestors, its parent first and pid 1 left out, each found by the one before."""
        found, ancestor = [], os.getppid()
        while ancestor > 1 and ancestor not in found and len(found) < 4096:
            found.append(ancestor)
            identity = cls._stat(ancestor)
            ancestor = identity[0] if identity else 0
        return found


def install_process_fence(fence):
    """Make fence this process's, and have Popen tell whichever fence is installed what it starts.

    Returns fence. Popen is changed once per process, and what it tells goes
    to the fence installed when it starts a process, so a check that installs
    a fence of its own for a moment hears about what it starts meanwhile.
    """
    global PROCESS_FENCE
    if not getattr(subprocess.Popen.__init__, "tells_the_fence", False):
        started = subprocess.Popen.__init__

        def telling(popen, *args, **kwargs):
            started(popen, *args, **kwargs)
            if PROCESS_FENCE is not None:
                PROCESS_FENCE.spawned(popen.pid)

        telling.tells_the_fence = True
        subprocess.Popen.__init__ = telling
    PROCESS_FENCE = fence
    return fence


def _process_fence():
    """This process's fence, installing one rooted here when none is.

    run_selftest installs its own before anything else; this one is for a
    caller that runs units without it, such as a probe's unit runner.
    """
    if PROCESS_FENCE is None:
        install_process_fence(_ProcessFence(os.environ.get(FENCE_RECORD_VAR) or None))
    return PROCESS_FENCE


def adopt_inherited_fence():
    """Install the fence a selftest unit handed down to this tool run, when one did.

    FENCE_UNIT_VAR, which ran_unit sets for a unit's length, names the
    selftest process that runs the unit, its start time, the fence's token,
    the unit's declaration and its name. The fence installed here reads
    processes by that unit's rule and writes its refusals to the file
    FENCE_RECORD_VAR names, under the same token, so they reach the root's
    row. main calls this first, before any engine exists. Without the
    variable this run is no unit's, and nothing is installed; a run that is a
    selftest itself puts a fence of its own in place of this one as it
    starts. A value that does not parse ends the run, since a run that cannot
    tell which processes it may read is not to read any. Returns the fence
    installed, or None.
    """
    handed = os.environ.get(FENCE_UNIT_VAR)
    if handed is None:
        return None
    parts = handed.split(" ", 4)
    if (len(parts) != 5 or _whole_pid(parts[0]) is None or not parts[1].isdigit()
            or not parts[2] or parts[3] not in ("0", "1") or not parts[4]):
        die(f"{FENCE_UNIT_VAR} is {handed!r}: expected the root's pid, its start time, "
            "the fence's token, 0 or 1, and a unit's name")
    root, root_start, token, machine, unit = parts
    return install_process_fence(_ProcessFence(
        os.environ.get(FENCE_RECORD_VAR) or None, root=int(root), root_start=root_start,
        token=token, unit=unit, machine=machine == "1"))


def refusal_lines(refused, root):
    """Each refusal a fence wrote down, (unit, reader, pid, process), as its tier's row says it."""
    return [(f"unit {unit}" if unit else "outside any unit")
            + (f", in tool run {process}" if process != root else "")
            + f": {reader} of pid {pid}"
            for unit, reader, pid, process in refused]


def register_procs_row(register, live, fence):
    """The tier's verdict on the reads its fence refused: its units', their tool runs' and its own."""
    said = refusal_lines(fence.refusals_in_run(), fence.root)
    register(*TIER_PROCS[live], not said,
             f"{len(said)} refused read(s): " + "; ".join(said) if said else "")


def declared_unit_rows(unit_name, ids, produced):
    """One unit's rows checked against the ids it registered.

    unit_name is the unit and ids its own (id, description) pairs from the registry.
    Returns (rows to keep, reasons for the rows rejected, registered ids it
    never produced). A row with an id the unit registered is kept under the
    registry's description, which makes the registry the one owner of what a
    check is called: the wording a check passed for its own row is not
    consulted, so it cannot drift from the listing. A row that is not four
    fields, or that has an id the unit did not register, is rejected with the
    reason.

    A unit that gets one row wrong keeps every valid row it produced, passes
    and failures alike. Those verdicts ran and are evidence; the rejections are
    reported through the tier's declaration row instead of erasing them.
    """
    declared = dict(ids)
    if not isinstance(produced, (list, tuple)):
        return [], [f"{unit_name} returned a {type(produced).__name__}, not a list of rows"], list(declared)
    kept, rejected, reached = [], [], set()
    for row in produced:
        if not isinstance(row, (list, tuple)) or len(row) != 4:
            rejected.append(f"{unit_name} produced a row that is not (id, description, "
                            f"verdict, detail): {row!r:.120}")
            continue
        cid, _said, ok, detail = row
        if not isinstance(cid, str) or cid not in declared:
            rejected.append(f"{unit_name} produced unregistered {cid!r}")
            continue
        reached.add(cid)
        kept.append((cid, declared[cid], ok, detail))
    return kept, rejected, [cid for cid in declared if cid not in reached]


def tier_rows(units, s, register, live, diagnostics=None):
    """Run units in order against one context and register what they report.

    units are registry entries, (name, ids, run, is_live), of one tier or one
    share of it; s is the context they share and register is where their rows
    go, each through declared_unit_rows. A unit that raises or exits ends the
    loop, because the units after it share a context it may have left changed:
    they do not run. The ended row names the stopping unit's own ids, which ran
    and have no verdict, and apart from them the ids of every unit that did not
    run; none of them is given a verdict. The declaration row
    and the ended row are registered here, after the loop, so every tier and
    every share states them the same way. diagnostics is where a raising
    unit's traceback goes.
    """
    rejected, silent, ended = [], [], ""
    for at, (unit_name, ids, run, _is_live) in enumerate(units):
        produced, stopped = ran_unit(run, s, diagnostics)
        if stopped:
            own = [cid for cid, _said in ids]
            never = [cid for _name, later, _run, _live in units[at + 1:] for cid, _said in later]
            ended = (f"{unit_name} ended the run with {stopped}; its own {len(own)} id(s) have "
                     f"no verdict: {', '.join(own)}"
                     + (f"; {len(never)} id(s) after it did not run: {', '.join(never)}"
                        if never else ""))
            break
        kept, refused, unproduced = declared_unit_rows(unit_name, ids, produced)
        rejected += refused
        silent += [f"{cid} ({unit_name})" for cid in unproduced]
        for row in kept:
            register(*row)
    # The verdicts register itself refused, by check name, are rows rejected too.
    rejected += register.rejected
    faults = ([f"{len(rejected)} row(s) rejected: " + "; ".join(rejected)] if rejected else [])
    faults += ([f"{len(silent)} registered id(s) never produced: " + ", ".join(silent)]
               if silent else [])
    register(*UNIT_DECLARED[live], not faults, "; ".join(faults))
    register(*UNIT_ENDED[live], not ended, ended)


def unit(*ids, live=False, machine=False, rooms=False):
    """Register one unit of the suite under the ids it produces.

    machine=True declares a unit with engines, or tool runs it starts, that
    must read on purpose, through the engine's process inputs
    (_FakeTmux.PROCESS_INPUTS), processes outside the tree of the selftest
    process that runs it, or the real session registry. The declaration
    decides what those inputs answer, through the fence ran_unit enters for
    the unit, and admit's rule for the pids a real listing named, and nothing
    else: the selftest's own process readers on _ProcessFence read the same
    whether a unit is declared or not, so a unit that reads processes only
    through them needs no declaration. Each declaration says beside it why
    the unit needs one.

    rooms=True declares a unit that makes a room of worker directories under
    the TMPDIR of the process it runs in, by running run_shares or by
    splitting a copy of this tool with --jobs. deepest_socket_root counts a
    level of rooms for it, so a run refuses a TMPDIR too long for the room
    before anything is made.
    """
    def take(run):
        UNITS.append((run.__name__, ids, run, live))
        if machine:
            MACHINE_UNITS.add(run.__name__)
        if rooms:
            ROOM_MAKING_UNITS.add(run.__name__)
        return run
    return take


def fixture_line(record, spaced=False):
    """One record of a fixture transcript, as the line a .jsonl file holds.

    Every fixture in this suite that stands up a transcript writes its records
    through here. The compact form is what the harness writes; `spaced=True`
    supplies the second byte-stable form accepted by the conversion codec.

    Deliberately not the writer under test. _codec_dump is what the product
    spells a line with; a fixture that asked it could not see it go wrong.
    Both use ensure_ascii=False because real transcript text is Unicode.
    """
    kwargs = {} if spaced else {"separators": (",", ":")}
    return json.dumps(record, ensure_ascii=False, **kwargs)


