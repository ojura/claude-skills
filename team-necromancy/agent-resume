            f.fake.started.update({pid: start for pid, _ppid, _argv in f.fake.processes})
            eng._pid_alive = lambda _pid, procstart=None: True
            seen[case] = (doctor_against_planner(eng, source, eng._roster_census(),
                                                 tuple(f.fake.processes)), expected)
    return seen


