        before = len(fence.refused)
        told["a pid from PID_CEILING up, which no process can hold, reads as nothing, unrefused"] = (
            (eng._proc_stat(invented), eng._cmdline(invented),
             eng._proc_env(invented, ("PATH",))) == ((None, None, None), (), {})
            and len(fence.refused) == before)
        eng._pid_alive(stranger)
        eng._proc_start(stranger)
        told["liveness and start time refuse a running process outside the run, through stat"] = (
            [(reader, pid) for _unit, reader, pid in fence.refused[before:]]
            == [("stat", stranger), ("stat", stranger)])
        before = len(fence.refused)
        no_pids = ("1/task/1", "self", True, 1.0, 0, -1, "007", None)
