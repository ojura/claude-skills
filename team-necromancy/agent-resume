    "--dangerously-skip-permissions": Flag(MANY, BOOL),
    "--allowed": Flag(MANY, VALUE), "--disallowed": Flag(MANY, VALUE),
    "--tools": Flag(MANY, VALUE), "--add-dir": Flag(MANY, VALUE),
    # configuration the resumed session reads
    "--settings": Flag(MANY, VALUE), "--setting-sources": Flag(MANY, VALUE),
    "--mcp-config": Flag(MANY, VALUE), "--strict-mcp-config": Flag(MANY, BOOL),
    "--append-system-prompt": Flag(MANY, VALUE), "--system-prompt": Flag(MANY, VALUE),
