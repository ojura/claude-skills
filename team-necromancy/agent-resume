    try:
        with capturing("err"):
            ctx = eng._identity(session_uuid=session, agent_id=requested)
        emit = s._Emit(requested)
        emit.force = True
        emit.bare = False
        emit.no_update_config = False
        with capturing("err") as warned:
            enforce_identity(ctx, ctx["objections"], False, True)
        command = build_command(ctx, emit, [])
        flags = dict(zip(command, command[1:]))
        record = ctx["roster"]["record"]
        with capturing("out") as explained:
            explain(ctx)
        told = explained.getvalue()
        effective = ctx["identity"]

        persistence = eng.membership_plan(ctx, "record", pane="%9", alive=True)
        with capturing("out"), capturing("err"):
            apply_membership(persistence)
        persisted = json.loads(cfg.read_text()).get("members", [])
        inbox = eng._inbox_path("session-corpus-alpha", "forced-name")

        matches = {
            "effective id": effective["agentId"] == requested,
            "effective name": effective["agentName"] == "forced-name",
            "effective team": effective["teamName"] == "session-corpus-alpha",
            "member role": effective["role"] == "member",
            "command id": flags.get("--agent-id") == requested,
            "command name": flags.get("--agent-name") == "forced-name",
            "command team": flags.get("--team-name") == "session-corpus-alpha",
            "roster id": record.get("agentId") == requested,
            "roster name": record.get("name") == "forced-name",
            "roster team": record.get("team") == "session-corpus-alpha",
            "persisted roster": any(member.get("agentId") == requested
                                    for member in persisted),
            "persisted inbox": inbox.is_file(),
            "warning name": "resuming as 'forced-name'" in warned.getvalue(),
            "explain id": re.search(r"^  agentId +forced-name@session-corpus-alpha +", told,
                                    re.MULTILINE) is not None,
            "explain name": re.search(r"^  agentName +forced-name +", told,
                                      re.MULTILINE) is not None,
            "explain team": re.search(r"^  teamName +session-corpus-alpha +", told,
                                      re.MULTILINE) is not None,
        }
        wrong = sorted(name for name, ok in matches.items() if not ok)
        foreign_launch_facts = {
            "model": record.get("model"),
            "color": record.get("color"),
            "cwd": record.get("cwd"),
        }
        coupled = (foreign_launch_facts == {"model": None, "color": None, "cwd": None}
                   and spawn_lookups == [requested])

        refused = False
        with capturing("err"):
            try:
                build_command(ctx, emit, ["--agent-name", "other"])
            except Refusal:
                refused = True
    finally:
        globals()["RESOLVER"] = real_resolver
        scratch.cleanup()

    check("forced-identity-is-one-value",
          "--force uses the requested identity in validation, command, roster, report, and role",
          not wrong, ", ".join(wrong))
    check("identity-passthrough-cannot-diverge",
          "a passthrough flag cannot replace identity after resolution", refused)
    check("assigned-identity-excludes-other-roster-facts",
          "an assigned identity does not inherit another roster member's launch fields",
          coupled, f"fields={foreign_launch_facts!r}, spawn lookups={spawn_lookups!r}")

    protected = {"build_command", "record_membership", "report_launch", "run_one",
                 "ensure_inbox", "rebuild_team"}
    offenders = []
    for name in sorted(protected):
        node = s.funcs.get(name)
        if node and any(isinstance(part, s.ast.Subscript)
                        and isinstance(part.value, s.ast.Name)
                        and part.value.id == "ctx"
                        and isinstance(part.slice, s.ast.Constant)
                        and part.slice.value == "merged"
                        for part in s.ast.walk(node)):
            offenders.append(name)
    build_src = s.src_of(s.funcs["build_command"]) or ""
    roster_src = s.src_of(s.resolver_methods["_launch_roster_record"]) or ""
    if "agent_id_of(" in build_src or "name_and_team(" in build_src:
        offenders.append("build_command reconstructs identity")
    if "agent_id_of(" in roster_src or 'identity["agentId"]' not in roster_src:
        offenders.append("roster_record reconstructs identity")
    target_consumers = {
        "already_running": (["ctx", "args", "here", "pane"], 'ctx["identity"]'),
        "become_agent": (["ctx", "command", "prefix", "undo"], 'ctx["identity"]'),
        # A redirect question names its member through redirect_subject.
        "decline_unreachable": (["plan", "args", "prefix"], "redirect_subject(plan)"),
        "redirect_subject": (["plan"], 'ctx["identity"]'),
        "noop_outcome": (["ctx", "args", "prefix", "why", "socket", "pane", "report"],
                         'ctx["identity"]'),
        # restore is Resolver's restore answer for this same launch, not an identity.
        "report_launch": (["ctx", "command", "prefix", "extra", "restore"],
                          'ctx["identity"]'),
    }
    for name, (expected, identity_read) in target_consumers.items():
        node = s.funcs[name]
        args = [arg.arg for arg in node.args.args]
        source = s.src_of(node) or ""
        if args != expected or identity_read not in source:
            offenders.append(f"{name} accepts a second identity or role")
    setters = s.callers_of("_set_effective_identity") - s.suite_fns
    if setters != {"_identity", "_retarget_launch", "member_redirect_plan"}:
        offenders.append("effective identity set by " + ", ".join(sorted(setters)))
    check("identity-consumers-do-not-read-the-merge",
          "launch and persistence consumers cannot bypass effective identity",
          not offenders, ", ".join(offenders))
    return checked


