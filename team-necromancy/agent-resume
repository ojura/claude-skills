@unit(('runtime-api-has-no-legacy-wearers',
       'the runtime API exposes no wearer or lead-pid compatibility path'),
      ('team-runtime-owns-population',
       'team population has no runtime-free compatibility projection'),
      ('process-command-read-stays-in-realm',
       'raw process commands are read only inside process and tmux evidence readers, '
       "the suite's own functions apart"),
      ('runtime-provenance-does-not-branch-on-prose',
       'runtime decisions do not parse resolution provenance prose'),
      ('doctor-consumes-team-runtime',
       'one doctor builder resolves canonical members before pure rendering'),
      ('doctor-renderers-read-no-evidence',
       'doctor renderers make no Resolver or evidence queries'),
      ('doctor-has-one-member-model',
       'doctor keeps no parallel member projections or old call signatures'),
      ('doctor-builder-is-complete-engine-question',
       'the public doctor answer owns the complete member evidence question'),
      ('doctor-conclusions-belong-to-engine',
       'Resolver derives doctor sharing, verdicts, and remedies before rendering'))
def _check_runtime_api_has_no_legacy_wearers(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast, tree = s.ast, s.tree
    funcs, callers_of = s.funcs, s.callers_of
    legacy = sorted(name for name in funcs if name in ("wearers", "lead_pid"))
    lead_owners = callers_of("_lead_process")
    check("runtime-api-has-no-legacy-wearers",
          "the runtime API exposes no wearer or lead-pid compatibility path",
          not legacy and lead_owners == {"_agent_runtime"},
          f"legacy functions={legacy}, private callers={sorted(lead_owners)}")

    population_projection = "team_population" in funcs or callers_of("team_population")
    check("team-runtime-owns-population",
          "team population has no runtime-free compatibility projection",
          not population_projection,
          f"function={('team_population' in funcs)}, "
          f"callers={sorted(callers_of('team_population'))}")

    # The suite's units read a command line to test the readers themselves, the
    # fence's check among them; the realm is the tool's own code.
    raw_readers = callers_of("_cmdline") - s.suite_fns
    check("process-command-read-stays-in-realm",
          "raw process commands are read only inside process and tmux evidence readers, "
          "the suite's own functions apart",
          raw_readers == {"_process_table", "_tmux_server_fact"},
          ", ".join(sorted(raw_readers)))

    def is_prose_fact(node):
        return ((isinstance(node, ast.Attribute)
                 and node.attr in ("via", "why", "how", "detail"))
                or (isinstance(node, ast.Subscript)
                    and isinstance(node.slice, ast.Constant)
                    and node.slice.value in ("via", "why", "how", "detail")))

    prose_branches = []
    for fn in ast.walk(tree):
        if not isinstance(fn, ast.FunctionDef) or fn.lineno in s.selftest_lines:
            continue
        for node in ast.walk(fn):
            if (isinstance(node, ast.Compare)
                    and any(is_prose_fact(part) for part in ast.walk(node))):
                prose_branches.append(f"{fn.name}:{node.lineno}")
            if (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                    and node.func.attr in ("startswith", "endswith")
                    and is_prose_fact(node.func.value)):
                prose_branches.append(f"{fn.name}:{node.lineno}")
    check("runtime-provenance-does-not-branch-on-prose",
          "runtime decisions do not parse resolution provenance prose",
          not prose_branches, ", ".join(sorted(set(prose_branches))))

    doctor_calls = callers_of("_team_runtime")
    report_functions = {
        "diagnose_team", "doctor_member_lines", "doctor_member_labels",
        "run_agent_dossier", "render_doctor_identity",
        "undelivered_mail_lines",
    }
    evidence_queries = (
        "agent_runtime", "_lead_process", "resolve_transcript", "transcript_fact",
        "roster_of", "team_lead_session", "_spawn_parent_of", "mail_ledger",
        "inbox_state", "_rebind_fragility", "team_runtime", "agent_diagnosis",
        "_team_delivery_facts", "_shared_doctor_facts", "_team_conclusion",
        "_doctor_member_ids", "agent_colour", "stamp_index", "converted_members",
    )
    direct = sorted({caller for query in evidence_queries
                     for caller in callers_of(query)} & report_functions)
    renderer_resolver_edges = sorted(
        f"{caller}->{question}"
        for question, callers in s.resolver_calls.items()
        for caller in callers if caller in report_functions) + sorted(
        f"{caller}->{attribute}"
        for attribute, callers in s.resolver_attributes.items()
        for caller in callers if caller in report_functions)
    builder_source = s.src_of(s.resolver_methods["_team_diagnosis"]) or ""
    helper_source = s.src_of(funcs["doctor_member_lines"]) or ""
    diagnosis_source = s.src_of(funcs["diagnose_team"]) or ""
    runner_source = s.src_of(funcs["run_doctor"]) or ""
    runtime_source = s.src_of(s.resolver_methods["_team_runtime"]) or ""
    check("doctor-consumes-team-runtime",
          "one doctor builder resolves canonical members before pure rendering",
          "_team_diagnosis" in doctor_calls and not direct
          and 'member["resolution"].transcript' in helper_source
          and "member_rows" not in builder_source
          and "member_colours" not in builder_source,
          f"team_runtime callers={sorted(doctor_calls)}, direct={direct}")
    check("doctor-renderers-read-no-evidence",
          "doctor renderers make no Resolver or evidence queries",
          not direct and not renderer_resolver_edges,
          f"queries={direct}, Resolver edges={renderer_resolver_edges}")

    def parameters(name):
        node = (s.resolver_methods[name] if name.startswith("_") or name == "doctor_answer"
                else funcs[name])
        return ([arg.arg for arg in node.args.args], node.args.vararg,
                node.args.kwarg, node.args.kwonlyargs)

    wanted_parameters = {
        "_team_diagnosis": ["self", "team", "requested", "deep", "table",
                            "census", "mailbox_generation"],
        "doctor_answer": ["self", "request"],
        "diagnose_team": ["state"],
        "doctor_member_lines": ["members"],
        "run_agent_dossier": ["member", "shared"],
    }
    signature_faults = []
    for name, wanted in wanted_parameters.items():
        actual, vararg, kwarg, kwonly = parameters(name)
        if actual != wanted or vararg or kwarg or kwonly:
            signature_faults.append(f"{name}{actual}")
    parallel_names = (
        "member_rows", "member_colours", "orders",
        "dossier_resolutions", "dossier_transcripts", "team_state=",
    )
    projection_faults = [
        token for token in parallel_names
        if token in builder_source + runtime_source + runner_source
    ]
    projection_faults.extend(
        token for token in (
            '"names_by_membership":', '"live": live', '"doubled":',
            '"seating":', '"seat_sockets":', '"split":', '"unseated":',
        ) if token in runtime_source)
    check("doctor-has-one-member-model",
          "doctor keeps no parallel member projections or old call signatures",
          not signature_faults and not projection_faults
          and 'for state in answer["diagnoses"]' in runner_source,
          f"signatures={signature_faults}, projections={projection_faults}")

    complete_queries = (
        "self._team_description(", "self._team_runtime(", "self._resolve_transcript(",
        "self._spawn_parent_of(", "self._transcript_fact(",
        "self._rebind_fragility(", "self._mail_ledger(",
        "self._inbox_state(", "self._team_delivery_facts(", "agent_colour(",
        "self._doctor_member_ids(", "self._shared_doctor_facts(",
        "self._team_conclusion(",
    )
    missing_queries = [query for query in complete_queries
                       if query not in builder_source]
    runner_direct = sorted(
        query for query in evidence_queries
        if "run_doctor" in s.resolver_calls.get(query, set()))
    answer_source = s.src_of(s.resolver_methods["doctor_answer"]) or ""
    doctor_callers = s.resolver_calls.get("doctor_answer", set())
    complete = (
        not missing_queries and not runner_direct
        and doctor_callers == {"run_doctor"}
        and answer_source.count("self._team_diagnosis(") == 1
        and 'description["lead_resolution"] if is_lead else' in builder_source
        and builder_source.count('"description": description') == 1
        and builder_source.count('"members": members') == 1
        and builder_source.count('"by_agent": types.MappingProxyType') == 1
        and builder_source.count("types.MappingProxyType({") >= 3
    )
    check("doctor-builder-is-complete-engine-question",
          "the public doctor answer owns the complete member evidence question",
          complete,
          f"missing={missing_queries}, runner direct={runner_direct}")
    inference_tokens = (
        "collections.defaultdict", "verdict =", "remedies.append(",
        "reads =", 'state["inbox"]',
    )
    renderer_inference = [token for token in inference_tokens
                          if token in diagnosis_source]
    if "doctor_shared_facts(" in runner_source:
        renderer_inference.append("doctor_shared_facts(")
    conclusion_owned = (
        not renderer_inference
        and 'conclusion = state["conclusion"]' in diagnosis_source
        and 'return conclusion["verdict"], lines, conclusion["remedies"]'
        in diagnosis_source
        and '"shared": shared' in builder_source
        and '"conclusion": conclusion' in builder_source
    )
    check("doctor-conclusions-belong-to-engine",
          "Resolver derives doctor sharing, verdicts, and remedies before rendering",
          conclusion_owned,
          f"renderer inference={renderer_inference}")
    return checked


