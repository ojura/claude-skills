            (proj / f"{stem}.jsonl").write_text("\n".join(
                [fixture_line({"parentUuid": None, "type": "user", "uuid": f"{stem}-root",
                       "timestamp": "2026-01-01T00:00:01Z", **stamps}), *extra]) + "\n")
            return proj / f"{stem}.jsonl"

        spawned = demote_fixture("MATE", "mate")
        lonely = demote_fixture("LONE", "lone")
        unstamped = demote_fixture("PLAIN", None)
        # A promoted file's own conversion record, carrying everything but a parent.
        receipted = demote_fixture("CARRIED", "borne", extra=[fixture_line(
            {"type": RECEIPT_RECORD, "receipt": {"grammar": SIDE_GRAMMAR_REGULAR, "root": "x"}})])
        # The lead whose spawn payload names one of them.
        (proj / "LEADER.jsonl").write_text(fixture_line(
            {"parentUuid": None, "type": "assistant", "uuid": "lead-root",
             "timestamp": "2026-01-01T00:00:00Z",
             "message": {"content": [{"type": "tool_result", "content": [
                 {"status": "teammate_spawned", "name": "mate",
                  "team_name": "TEAMX", "agent_id": "mate@TEAMX"}]}]}}) + "\n")

        def refused(path):
            """What this demote refuses with, or "" when it refuses nothing.

            Never indexed blind: a demote that stopped objecting at all would
            end the whole suite in an IndexError, and a crash reads as silence
            rather than as this check failing.
            """
            said = eng_demote.rewriter.conversion_plan(path, "demote", into=None)["objections"]
            return " ".join(said[0].split()) if said else ""

        with_payload = refused(spawned)
        without = refused(lonely)
        nameless = refused(unstamped)
        borne = refused(receipted)
        told_why = {
            "ordinary parent refusals still name the flag": all(
                "--into-session" in said for said in (
                    with_payload, without, nameless)),
            "a candidate is named when one exists":
                "LEADER" in with_payload and "mate@TEAMX" in with_payload,
            "no candidate is said plainly":
                "no spawn payload names lone@TEAMX" in without,
            "an unstamped file says it cannot look":
                "no agent stamps" in nameless,
            "an incomplete carried record is rejected as an invalid schema":
                "conversion receipt is missing" in borne,
            "the four refusals read differently":
                len({with_payload, without, nameless, borne}) == 4,
        }
    wrong = sorted(k for k, ok in told_why.items() if not ok)
    check("demote-parent-refusal-says-why", "a demote with no parent says why it could not find one",
          not wrong, ", ".join(wrong))
