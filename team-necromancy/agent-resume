    ),
}


def _human_wrapper_text(content):
    """(wrapper version, inner text) for an exact known human wrapper."""
    if not isinstance(content, str):
        return None
    for version, (prefix, suffix) in HUMAN_MESSAGE_WRAPPERS.items():
        if content.startswith(prefix) and content.endswith(suffix):
            return version, content[len(prefix):-len(suffix)]
    return None


def _human_wrapper_content(version, inner):
    """Rebuild one exact known wrapper around its human text."""
    prefix, suffix = HUMAN_MESSAGE_WRAPPERS[version]
    return f"{prefix}{inner}{suffix}"


def _human_message_matches(rec, content, is_meta):
    """Whether one record is a human message in the requested stored state."""
    message = rec.get("message") or {}
    origin = rec.get("origin") or {}
    return (rec.get("type") == "user" and rec.get("isMeta") is is_meta
            and bool(rec.get("uuid")) and message.get("role") == "user"
            and isinstance(origin, dict) and origin.get("kind") == "human"
            and message.get("content") == content)


def _wrapped_human_message(rec):
    """A known persistent human wrapper, excluding other meta-message kinds."""
    content = (rec.get("message") or {}).get("content")
    wrapped = _human_wrapper_text(content)
    return wrapped if wrapped and _human_message_matches(rec, content, True) else None


def _picker_prompt_text(rec):
    """A human prompt for last-prompt, with known persistence wrappers removed."""
    wrapped = _wrapped_human_message(rec)
    if wrapped is not None:
        return wrapped[1].strip()
    if rec.get("type") != "user" or rec.get("isMeta") is True:
        return ""
    if "origin" in rec:
        origin = rec.get("origin")
        if not isinstance(origin, dict) or origin.get("kind") != "human":
            return ""
    return _prompt_text(rec)


def _identity_stamp(record):
    """Top-level identity fields carried by one authored transcript record."""
    if (not isinstance(record, dict) or record.get("isSidechain")
            or record.get("type") == "agent-name"):
        return {}
    return {
        field: value for field in ("agentName", "teamName")
        if isinstance((value := record.get(field)), str) and value
    }


def _record_uuid(record):
    """The top-level UUID of one transcript record, or None."""
    if not isinstance(record, dict):
        return None
    uuid = record.get("uuid")
    return uuid if isinstance(uuid, str) and uuid else None


def _parse_teammate_envelope(text):
    """Sender/body events from one complete harness teammate envelope."""
    if text.startswith(TEAMMATE_MESSAGE_PREFIX):
        if not text.endswith(TEAMMATE_MESSAGE_SUFFIX):
            return ()
        text = text[len(TEAMMATE_MESSAGE_PREFIX):-len(TEAMMATE_MESSAGE_SUFFIX)]
    elif not text.startswith("<teammate-message "):
        return ()

    events, cursor = [], 0
    while cursor < len(text):
        opened = TEAMMATE_MESSAGE_OPEN_RE.match(text, cursor)
        if not opened:
            return ()
        body_at = opened.end()
        search_at = body_at
        while True:
            closed = text.find(TEAMMATE_MESSAGE_CLOSE, search_at)
            if closed < 0:
                return ()
            after = closed + len(TEAMMATE_MESSAGE_CLOSE)
            next_at = after
            while next_at < len(text) and text[next_at].isspace():
                next_at += 1
            if (next_at == len(text)
                    or TEAMMATE_MESSAGE_OPEN_RE.match(text, next_at)):
                break
            search_at = closed + 1
        body = text[body_at:closed]
        if not body.endswith("\n"):
            return ()
        body = TEAMMATE_PROTECTED_TAG_RE.sub("<", body[:-1])
        events.append((html.unescape(opened.group(1)), body))
        cursor = next_at
    return tuple(events)


def _delivery_events(record):
    """Peer deliveries carried by one recognized persisted user channel."""
    if (not isinstance(record, dict) or record.get("type") != "user"
            or record.get("isSidechain")
            or record.get("userType") != "external"):
        return ()
    message = record.get("message")
    if not isinstance(message, dict) or message.get("role") != "user":
        return ()
    origin = record.get("origin")
    if origin is not None and (
            not isinstance(origin, dict)
            or origin.get("kind") not in ("peer", "coordinator")):
        return ()
    content = message.get("content")
    return _parse_teammate_envelope(content) if isinstance(content, str) else ()


def _spawn_event(record):
    """The direct harness teammate-spawn payload carried by one user record."""
    if (not isinstance(record, dict) or record.get("type") != "user"
            or record.get("isSidechain") is not False):
        return None
    message = record.get("message")
    if not isinstance(message, dict) or message.get("role") != "user":
        return None
    payload = record.get("toolUseResult")
    if not isinstance(payload, dict) or payload.get("status") != "teammate_spawned":
        return None
    name, team, agent_id = (payload.get("name"), payload.get("team_name"),
                            payload.get("agent_id"))
    if not all(isinstance(value, str) and value for value in (name, team, agent_id)):
        return None
    if agent_id != agent_id_of(name, team):
        return None
    return payload


def _complete_tail_window(handle, size, span):
    """At least `span` bytes from EOF, extended to a complete first JSONL line."""
    start = max(0, size - span)
    while start:
        before = max(0, start - span)
        handle.seek(before)
        chunk = handle.read(start - before)
        newline = chunk.rfind(b"\n")
        if newline >= 0:
            start = before + newline + 1
            break
        start = before
    handle.seek(start)
    return handle.read(size - start)


def _complete_head_window(handle, size, span):
    """At least `span` bytes from BOF, extended to a complete final JSONL line."""
    handle.seek(0)
    chunk = handle.read(min(size, span))
    if len(chunk) < size and not chunk.endswith(b"\n"):
        chunk += handle.readline()
    return chunk


def _stamps_in(chunk):
    """Top-level identity fields from complete JSONL records in one byte window.

    The first or last line of a bounded window may be partial and is skipped by
    JSON parsing. Candidate narrowing is allowed to be incomplete; field values
    always come from `_identity_stamp`, never from serialized nested content.
    """
    stamps = {}
    for line in reversed(chunk.split(b"\n")):
        if b'"agentName"' not in line and b'"teamName"' not in line:
            continue
        try:
            record = json.loads(line)
        except (ValueError, UnicodeDecodeError):
            continue
        for field, value in _identity_stamp(record).items():
            stamps.setdefault(field, value)
        if len(stamps) == 2:
            break
    return stamps


