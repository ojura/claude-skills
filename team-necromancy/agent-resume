             "cwd": str(home), "timestamp": "2026-05-01T00:01:00Z",
             "message": {"role": "user", "content": "b"}},
            {"type": "user", "uuid": "pa-3", "parentUuid": "pa-2", "sessionId": parent,
             "cwd": str(home / "other"), "timestamp": "2026-05-01T00:02:00Z",
             "message": {"role": "user", "content": "c"}})) + "\n")
        # The promoted conversation: it only ever ran under a directory of its
        # own, which is the whole problem.
        own = str(Path(td) / "elsewhere")
        (proj / f"{moved}.jsonl").write_text("\n".join([fixture_line(
            {"type": "user", "uuid": "mv-1", "parentUuid": None, "sessionId": moved,
             "cwd": own, "timestamp": "2026-05-01T01:00:00Z",
             "message": {"role": "user", "content": "d"}}),
            fixture_line({"type": RECEIPT_RECORD, "receipt": fixture_receipt(
                dest_stem=moved, grammar=SIDE_GRAMMAR_FORK_REFERENCE, name="wanderer",
                parent=parent, root=moved, task_id="awanderer",
                team="session-corpus-alpha")})]) + "\n")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir = Path(td) / "projects"
        eng.teams_dir = Path(td) / "teams"
        eng.process_table = lambda refresh=False: []
        eng._session_registry = lambda: []
        with capturing("err") as quiet:
            resolved = eng.identity(session_uuid=moved)
            where = resolved["target"]["cwd"]
        real_resolver = globals()["RESOLVER"]
        globals()["RESOLVER"] = eng
        try:
            with capturing("out") as explained:
                explain(resolved)
        finally:
            globals()["RESOLVER"] = real_resolver
        cwd_rows = [line for line in explained.getvalue().splitlines()
                    if re.match(r"^  cwd +", line)]
        explained_cwd = bool(cwd_rows and str(home) in cwd_rows[0]
                             and own not in cwd_rows[0])
        silent = quiet.getvalue().strip() == ""
        # With that session's file gone there is nothing left that fits, and the
        # run says so instead of starting somewhere and hoping.
        (proj / f"{parent}.jsonl").unlink()
        stale = Resolver(needs=Needs(maybe=set(NEED)))
        stale.projects_dir, stale.teams_dir = eng.projects_dir, eng.teams_dir
        stale.process_table = lambda refresh=False: []
        stale._session_registry = lambda: []
        with capturing("err") as loud:
            fallback_ctx = stale.identity(session_uuid=moved)
            fell_back = fallback_ctx["target"]["cwd"]
            note_cwd(fallback_ctx)
        told = " ".join(loud.getvalue().split())
        starts = {
            "it starts where its own file can be found": where == str(home),
            "which is not the directory the conversation last ran in": where != own,
            "and nothing is said, because nothing can go wrong": silent,
            "with no such directory it starts where the conversation ran":
                fell_back == own,
            "and names that directory": own in told,
            "and says the resume may not find the conversation":
                "may not find it" in told,
            "and says none of it in this tool's own vocabulary":
                not any(word in told for word in ("flatten", "project dir")),
        }
        wrong = sorted(k for k, ok in starts.items() if not ok)
        check("promoted-starts-where-its-file-is",
              "a promoted agent starts in a directory its own conversation can be found from",
              not wrong, ", ".join(wrong) or f"chose {where}")
        check("explain-cwd-is-launch-cwd",
              "--explain reports the cwd stored in the immutable launch target",
              explained_cwd, repr(cwd_rows))

    s.eng = eng
    return checked


@unit(('session-row-is-a-uuid-not-a-path', 'the session row names the conversation and prints no transcript path'))
def _check_session_row_is_a_uuid_not_a_path(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    started_said = s.started_said

    report = started_said.splitlines()
    block_at = next((i for i, each in enumerate(report) if each.startswith("agent ")), None)
    block = []
    for line in report[block_at:] if block_at is not None else []:
        if not line.strip():
            break
        block.append(line)
    row_at = next((i for i, each in enumerate(block) if each.startswith("session ")), None)
    row = []
    for line in block[row_at:] if row_at is not None else []:
        if row and not line.startswith(" "):
            break
        row.append(line)
    resumed = re.search(r"--resume (\S+)", "\n".join(block))
    stated = []
    if row_at is None:
        stated.append("the launch report printed no session row")
    elif not resumed:
        stated.append("the launch report printed no command resuming anything")
    elif resumed.group(1) not in row[0]:
        stated.append(f"the row does not name what the command resumes: {row[0].strip()!r}")
    pathed = [each for each in row if "/" in each]
    if pathed:
        stated.append(f"a path is printed with it: {pathed[0].strip()[:70]!r}")
    check("session-row-is-a-uuid-not-a-path",
          "the session row names the conversation and prints no transcript path",
          not stated, "; ".join(stated))
    return checked


@unit(('lead-rebind-crew-report', 'a lead move names the crew it leaves behind'), ('lead-rebind-guards', "a live-membered team still blocks a lead's reap"), ('lead-rebind-kill-gate', 'a lead move ends the holder only after it is agreed to'), ('lead-address-spelling-moves-nothing', 'a team named inside an agent id addresses a lead without moving it'))
def _check_lead_rebind_crew_report(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    corpus_engine = s.corpus_engine
    resume_run = s.resume_run
    tempfile = s.tempfile

    GHOST = 999999999
    STRANGER = "d00fd00f-d00f-4d0f-8d0f-d00fd00fd00f"
    LEAD_STAMPED = "1e5701ed-1fe5-4701-8ed1-e5701ed1fe57"

    def stamped_stranger(root):
        """A member of session-corpus-alpha the roster does not list, with mail
        waiting for it, so neither report line can be answered from the roster.
        Planted per run rather than in the shared corpus, which every other
        check counts."""
        (root / "projects" / "corpus" / f"{STRANGER}.jsonl").write_text("\n".join(
            fixture_line(rec) for rec in (
                {"type": "user", "uuid": "dr-root", "parentUuid": None,
                 "timestamp": "2026-04-01T00:00:00Z", "sessionId": STRANGER,
                 "agentName": "drift", "teamName": "session-corpus-alpha",
                 "message": {"role": "user", "content": "hi"}},
                {"type": "last-prompt", "leafUuid": "dr-root", "sessionId": STRANGER,
                 "lastPrompt": "hi"})) + "\n")
        (root / "teams" / "session-corpus-alpha" / "inboxes" / "drift.json").write_text(
            json.dumps([{"id": "m1", "from": "team-lead", "text": "still there?",
                         "timestamp": "2026-04-02T00:00:00Z"}]))

    real_receipts = RECEIPTS_DIR
    lead_receipts = Path(tempfile.mkdtemp())
    globals()["RECEIPTS_DIR"] = lead_receipts
    real_stdin, real_input = sys.stdin, globals().get("input")
    try:
        moved, _entry, _srv, moved_said = resume_run(
            "team-lead@session-corpus-alpha", to_team="session-corpus-crew",
            prepare=stamped_stranger)
        # Everyone the engine says session-corpus-alpha has, plus the member
        # this run planted into the copy. The lead is the one that moves, so it
        # is the one name that must not be listed as staying.
        expected = (set(corpus_engine().team_runtime("session-corpus-alpha")["population"])
                    | {"drift"}) - {"team-lead"}
        crew_line = next((each for each in moved_said.splitlines() if each.startswith("crew ")), "")
        missing = sorted(n for n in expected if n not in crew_line)
        told = " ".join(moved_said.split())
        if moved != "manual":
            missing.append(f"the move did not reach its launch ({moved})")
        if "team-lead" in crew_line:
            missing.append("the lead itself is listed as staying behind")
        if "1 waiting for drift" not in told:
            missing.append("the mail waiting on the old team is not named")
        if "--into-team live on each member" not in told:
            missing.append("the way to move one is not named")
        check("lead-rebind-crew-report", "a lead move names the crew it leaves behind",
              not missing, ", ".join(missing[:3]))

        # The guards, unchanged, reached through the lead path: one live member
        # of the team the stamps name, and the reap it would need refuses.
        alive_member = [(4242, 1, f"{FAKE_AGENT_BIN} --agent-id willow@session-corpus-alpha")]
        try:
            blocked, _e, _s, blocked_said = resume_run(
                "team-lead@session-corpus-alpha", resume=LEAD_STAMPED,
                to_team="session-corpus-crew", table=alive_member)
        except OSError as err:
            # A reap that happened anyway takes the roster the harness reads
            # back; say so as a failure rather than as a traceback.
            blocked, blocked_said = f"crashed: {err.__class__.__name__}", ""
        told = " ".join(blocked_said.split())
        held = []
        if blocked != "refused":
            held.append(f"a live-membered team did not block the move ({blocked})")
        for owed in ("pid 4242 runs as it", "--force instead rewrites"):
            if owed not in told:
                held.append(f"the refusal does not say {owed!r}")
        if (lead_receipts / "session-corpus-alpha.json").exists():
            held.append("the team was retired anyway")
        check("lead-rebind-guards", "a live-membered team still blocks a lead's reap",
              not held, ", ".join(held[:3]))

        # The kill gate: a live holder of the lead's own conversation, and the
        # three answers it can get. None of them kills.
        holder = [(GHOST, 1, f"{FAKE_AGENT_BIN} --resume {LEAD_STAMPED}")]

        def moved_onto_holder(**over):
            _st, _e, _s, out = resume_run(
                "team-lead@session-corpus-alpha", resume=LEAD_STAMPED,
                to_team="session-corpus-crew", table=holder, **over)
            return " ".join(out.split())

        gate = []
        sys.stdin = types.SimpleNamespace(isatty=lambda: True)
        globals()["input"] = lambda prompt="": "n"
        answered_no = moved_onto_holder()
        globals()["input"] = lambda prompt="": "y"
        previewed = moved_onto_holder(dry_run=True)
        sys.stdin = types.SimpleNamespace(isatty=lambda: False)
        globals().pop("input", None)
        unasked = moved_onto_holder()
        if f"would kill pid {GHOST}" not in previewed:
            gate.append("a dry run does not say what it would kill")
        if "dry run ends nothing" not in previewed:
            gate.append("a dry run does not say the rest is measured with it alive")
        if f"killing pid {GHOST}" in answered_no or "left alone" not in answered_no:
            gate.append("no did not stop it")
        if f"killing pid {GHOST}" in unasked or "pass --yes" not in unasked:
            gate.append("with nothing to ask at, it killed anyway")
        check("lead-rebind-kill-gate", "a lead move ends the holder only after it is agreed to",
              not gate, ", ".join(gate[:3]))

        # The other spelling. A team named inside an agent id says which agent
        # this is, not where to put it, so the run refuses the contradiction,
        # names the flag that would move it, and touches neither the team the
        # stamps name nor whoever is holding the conversation.
        #
        # The destination roster is dated after this conversation's last line,
        # which is what a team created later looks like. Every roster in the
        # shared corpus is dated 1, and at that date the stamps win the merge
        # and the launch resolves back onto the team it came from, which is a
        # different case: there is nothing for the two to disagree about.
        def dated_crew(root):
            cfg = root / "teams" / "session-corpus-crew" / "config.json"
            data = json.loads(cfg.read_text())
            data["createdAt"] = 1780000000000
            for member in data["members"]:
                member["joinedAt"] = 1780000000000
            cfg.write_text(json.dumps(data))

        addressed, _e, _s, addressed_said = resume_run(
            "team-lead@session-corpus-crew", resume=LEAD_STAMPED, prepare=dated_crew)
        told = " ".join(addressed_said.split())
        # The same launch with something holding the conversation, because the
        # kill gate is the first thing a move reaches and this is the only run
        # where a kill would have anything to end. The pid it names is read off
        # the table after the point a move would have killed it, so the guard
        # saying it is live is this fixture's witness that the row survived.
        _held, _e, _s, held_said = resume_run(
            "team-lead@session-corpus-crew", resume=LEAD_STAMPED, table=holder,
            dry_run=True, yes=True, prepare=dated_crew)
        held = " ".join(held_said.split())
        addresses = []
        if addressed != "refused":
            addresses.append(f"the address spelling was not refused ({addressed})")
        if "--into-team session-corpus-crew" not in told:
            addresses.append("the refusal does not name --into-team as the move")
        if (lead_receipts / "session-corpus-alpha.json").exists():
            addresses.append("the team the stamps name was retired anyway")
        if f"kill pid {GHOST}" in held:
            addresses.append("the holder was ended for a launch that moves nothing")
        if f"is live as pid {GHOST}" not in held:
            addresses.append(f"the guard no longer reads pid {GHOST} off the table")
        check("lead-address-spelling-moves-nothing",
              "a team named inside an agent id addresses a lead without moving it",
              not addresses, ", ".join(addresses[:3]))
    finally:
        globals()["RECEIPTS_DIR"] = real_receipts
        sys.stdin = real_stdin
        if real_input is not None:
            globals()["input"] = real_input
        else:
            globals().pop("input", None)
        shutil.rmtree(lead_receipts, ignore_errors=True)
    return checked


@unit(('member-rebind-preview-launches', "a member's move previews the launch it would make, and a launch that did not move is still refused"))
def _check_member_rebind_preview_launches(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    _FakeTmux = s._FakeTmux
    resume_run = s.resume_run
    tempfile = s.tempfile

    MEMBER_STAMPED = "22222222-2222-4222-8222-222222222222"

    def closed_member(root):
        """willow's conversation, closed by a last-prompt trailer so its window
        start resolves and reads session-corpus-alpha. Unclosed it restores as
        nobody, and then a rebind onto another team has nothing to contradict.
        Planted per run rather than in the shared corpus, which every other
        check reads."""
        held = root / "projects" / "corpus" / f"{MEMBER_STAMPED}.jsonl"
        held.write_text(held.read_text() + fixture_line(
            {"type": "last-prompt", "leafUuid": "an-2", "sessionId": MEMBER_STAMPED,
             "lastPrompt": "go"}) + "\n")

    def member_move(**over):
        return resume_run("willow@session-corpus-alpha", to_team="session-corpus-crew",
                          prepare=closed_member, **over)

    real_receipts = RECEIPTS_DIR
    member_receipts = Path(tempfile.mkdtemp())
    globals()["RECEIPTS_DIR"] = member_receipts
    real_reap = globals()["rebind_reap"]
    retired = member_receipts / "session-corpus-alpha.json"
    previews = []
    try:
        drawn, _e, _s, drawn_said = member_move(dry_run=True)
        told = " ".join(drawn_said.split())
        if drawn != "launched":
            previews.append(f"the preview did not reach its launch ({drawn})")
        for owed in ("would reap session-corpus-alpha", "would run in pane"):
            if owed not in told:
                previews.append(f"the preview does not say {owed!r}")
        if "undoes itself" in told:
            previews.append("the preview refused the move it had just previewed")
        if retired.exists():
            previews.append("the dry run retired the team anyway")

        # Blocked, and the run stops where it always did: a live process runs
        # under the source-team identity, and --force was not requested.
        source_process = [(4242, 1, f"{FAKE_AGENT_BIN} --agent-id echo@session-corpus-alpha")]
        for tense, over in (("preview", {"dry_run": True}), ("run", {})):
            stopped, _e, _s, stopped_said = member_move(table=source_process, **over)
            blocked_told = " ".join(stopped_said.split())
            if stopped != "refused":
                previews.append(f"a blocked {tense} was not refused ({stopped})")
            if "pid 4242 runs as it" not in blocked_told:
                previews.append(f"a blocked {tense} does not name the running process")
            if retired.exists():
                previews.append(f"a blocked {tense} retired the team anyway")

        # A move that did not happen, and the gate that catches it. The member
        # path stops the run on a blocker rather than carrying on, so the only
        # way to reach the gate with the move untaken is to hand the run a
        # rebind that declines: the launch must then meet the refusal, which is
        # also what makes this check fail if the gate's body ever goes.
        globals()["rebind_reap"] = lambda *a, **k: False
        try:
            ungated, _e, _s, ungated_said = member_move(dry_run=True)
        finally:
            globals()["rebind_reap"] = real_reap
        if ungated != "refused":
            previews.append(f"a launch that never moved was not refused ({ungated})")
        if "undoes itself" not in " ".join(without_wrap_arrows(ungated_said).split()):
            previews.append("a launch that never moved lost the refusal")

        # And the real run, unchanged: it retires the team and reaches its
        # spawn. The roster the harness reads back afterwards is the one the
        # reap took, so the server it spawned on is what answers here.
        server = _FakeTmux()
        try:
            ran = member_move(server=server)[0]
        except OSError:
            ran = "launched"  # the roster is gone, which is the reap working
        if ran != "launched":
            previews.append(f"the real move did not reach its launch ({ran})")
        if not any(a[0] in ("split-window", "new-window", "new-session")
                   for a in server.ran):
            previews.append("the real move never reached tmux")
        if not retired.exists():
            previews.append("the real move retired nothing")
    finally:
        globals()["RECEIPTS_DIR"] = real_receipts
        globals()["rebind_reap"] = real_reap
        shutil.rmtree(member_receipts, ignore_errors=True)
    check("member-rebind-preview-launches",
          "a member's move previews the launch it would make, and a launch that "
          "did not move is still refused",
          not previews, ", ".join(previews[:3]))
    return checked


