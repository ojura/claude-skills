@unit(('abort-stops-listed', 'an abort stops what it listed'), ('abort-listing-describes', 'the abort listing says what each process is doing'), live=True)
def _check_abort_stops_listed(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    with stop_fixture(2) as (engine, ident, victims, near):
        plan = stop_targets(types.SimpleNamespace(
            team=None, agent_id=ident, resume=None))
        with capturing("out") as said:
            killed = abort_agents(plan, assume_yes=True)
        listed = said.getvalue()
        gone = [not engine._pid_alive(victim.pid) for victim in victims]
        spared = [engine._pid_alive(miss.pid) for miss in near]

    titles = [target["title"] for target in plan["targets"]]
    planned = {target["process"]["pid"] for target in plan["targets"]}
    stopping = {
        "the plan selected both processes": len(plan["targets"]) == 2,
        "and neither near miss": not planned & {miss.pid for miss in near},
        "it reported stopping both": killed == 2,
        "and both are gone": all(gone),
        "while both near misses still run": len(spared) == 2 and all(spared),
        "it said so": f"aborted 2 of {len(plan['targets'])}" in listed,
    }
    wrong = sorted(k for k, ok in stopping.items() if not ok)
    check("abort-stops-listed", "an abort stops what it listed",
          not wrong, ", ".join(wrong) + f"; killed {killed}, gone {gone}")

    # The title comes off the transcript the process named, so the listing is
    # only describing anything if the plan had a real one to describe. A
    # corpus that lost its title would otherwise leave both sides agreeing on
    # the "(no title)" placeholder and the check still green.
    described = {
        "the plan carried a real title for each process":
            len(titles) == 2 and all(title and title != "(no title)" for title in titles),
        "the listing shows each process's title": all(title in listed for title in titles),
        "and the id they wear": ident in listed,
        "with a row for each pid":
            all(str(victim.pid) in listed for victim in victims),
    }
    wrong = sorted(k for k, ok in described.items() if not ok)
    check("abort-listing-describes", "the abort listing says what each process is doing",
          not wrong, ", ".join(wrong) + f"; titles {titles}")
    return checked


@unit(('abort-refusal-spares', 'answering no leaves the process alone'),
      ('abort-without-terminal-asks-nothing',
       'with no terminal on stdin an abort asks nothing, stops nothing and says it left the '
       'process alone'),
      live=True)
def _check_abort_refusal_spares(s):
    """An abort refused at its prompt, and an abort with no terminal to prompt on.

    abort_agents asks only when stdin is a terminal, so a check that left stdin
    alone would test the prompt under a harness with a pty and the other branch
    under one with /dev/null, passing in one and failing in the other. Each arm
    sets stdin itself, for the prompt a stand-in that says it is a terminal,
    as _check_team_run_decides_once gives its prompt, and /dev/null for the
    other, and puts the caller's stdin back.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    real_input = globals()["input"] if "input" in globals() else None
    real_stdin = sys.stdin

    def abort_with(stdin):
        """abort_agents on one owned target, with stdin as given and every question answered no.

        Returns (plan, whether it planned only that target, killed, spared,
        prompts asked, what it printed).
        """
        # The prompt goes to input(), not to stdout, so a stand-in that dropped
        # it would leave nothing anywhere saying the question was ever put.
        # Keeping it is what tells a refusal apart from a run that skipped the
        # asking.
        asked = []
        with stop_fixture(1) as (engine, ident, victims, _near):
            plan = stop_targets(types.SimpleNamespace(
                team=None, agent_id=ident, resume=None))
            try:
                globals()["input"] = lambda prompt="": (asked.append(prompt), "n")[1]
                sys.stdin = stdin
                with capturing("out") as said:
                    killed = abort_agents(plan)
            finally:
                sys.stdin = real_stdin
                if real_input is None:
                    globals().pop("input", None)
                else:
                    globals()["input"] = real_input
            # Read before the fixture ends it, which is the next thing that happens.
            spared = engine._pid_alive(victims[0].pid)
        only = {target["process"]["pid"] for target in plan["targets"]} == {victims[0].pid}
        return plan, only, killed, spared, asked, said.getvalue()

    plan, only, killed, spared, asked, answered = abort_with(
        types.SimpleNamespace(isatty=lambda: True))
    sparing = {
        "there was something to stop": len(plan["targets"]) == 1,
        "and only the process wearing its id": only,
        "nothing was stopped": killed == 0,
        "the process is still running": spared,
        "it asked before stopping anything":
            len(asked) == 1 and "abort these?" in asked[0],
        "and said it left it alone": "left alone" in answered,
        "the caller's stdin is back": sys.stdin is real_stdin,
    }
    wrong = sorted(k for k, ok in sparing.items() if not ok)
    check("abort-refusal-spares", "answering no leaves the process alone",
          not wrong, ", ".join(wrong))

    with open(os.devnull) as nothing:
        plan, only, killed, spared, asked, answered = abort_with(nothing)
    untouched = {
        "there was something to stop": len(plan["targets"]) == 1,
        "and only the process wearing its id": only,
        "it asked nothing": not asked,
        "nothing was stopped": killed == 0,
        "the process is still running": spared,
        "it said there was no terminal and it left it alone":
            "no terminal" in answered and "left alone" in answered,
        "the caller's stdin is back": sys.stdin is real_stdin,
    }
    wrong = sorted(k for k, ok in untouched.items() if not ok)
    check("abort-without-terminal-asks-nothing",
          "with no terminal on stdin an abort asks nothing, stops nothing and says it left the "
          "process alone",
          not wrong, ", ".join(wrong) + (f"; asked {asked}, said {answered!r}" if wrong else ""))
    return checked


# Not declared to read the machine. A declaration stays where a mutation fails
# one of the unit's arms declared and not undeclared, and a mutation counts for
# an arm only where it produces what the arm looks for in every run. The
# commands this unit types meet a pid that is gone by the time it is read only
# when some process on the machine ends between a table's listing and its read,
# which happens by chance, so a gone-pid mutation that fails it declared counts
# for nothing here. process-reads-are-fenced reads a pid no process holds on
# purpose, in both worlds, and fails every time either gone-pid branch of
# _proc_stat or _cmdline goes.
@unit(('smoke-typed-commands', 'the commands a person types end in a message, not a traceback'),
      live=True)
def _check_smoke_typed_commands(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sp = s.sp

    here_uuid = "22222222-2222-4222-8222-222222222222"
    gone_uuid = "00000000-0000-4000-8000-000000000000"
    shapes = [
        # a name, spelled the ways people spell one
        ("runs", ["willow", "--dry-run"]),
        ("refuses", ["nosuchname", "--dry-run"]),
        ("runs", ["willow@session-corpus-alpha", "--dry-run"]),
        ("refuses", ["nosuchagent@session-corpus-alpha", "--dry-run"]),
        ("refuses", ["nosuch@nosuchteam", "--dry-run"]),
        ("refuses", ["@session-corpus-alpha", "--dry-run"]),       # nothing before the @
        ("refuses", ["WILLOW@session-corpus-alpha", "--dry-run"]),  # a case the roster does not carry
        ("runs", ["willow@", "--dry-run"]),                        # a trailing @ is a bare name
        ("runs", ["willow@team@extra", "--dry-run"]),              # two @, warned about
        # a session uuid, held and not held
        ("runs", [here_uuid, "--dry-run"]),
        ("refuses", [gone_uuid, "--dry-run"]),
        # a team, bare and behind the flag. Either way round: whether a team
        # comes up depends on its lead being live, which is this machine's
        # business rather than the fixture's.
        ("either", ["session-corpus-alpha", "--dry-run"]),
        ("refuses", ["nosuchteam", "--dry-run"]),
        ("either", ["--team", "session-corpus-alpha", "--dry-run"]),
        ("refuses", ["--team", "nosuchteam", "--dry-run"]),
        # --doctor uses those same selectors rather than classifying them again.
        ("runs", ["willow", "--doctor"]),
        ("refuses", ["nosuchname", "--doctor"]),
        ("runs", ["willow@session-corpus-alpha", "--doctor"]),
        ("refuses", ["nosuchagent@session-corpus-alpha", "--doctor"]),
        ("runs", [here_uuid, "--doctor"]),
        ("refuses", [gone_uuid, "--doctor"]),
        ("runs", ["session-corpus-alpha", "--doctor"]),
        ("refuses", ["nosuchteam", "--doctor"]),
        ("refuses", ["willow", "--standing"]),
        # the other verbs, pointed at what they cannot find.
        ("refuses", ["--doctor", "nosuchteam"]),
        ("refuses", ["--demote", gone_uuid]),
        ("refuses", ["--promote", "nosuchside"]),
        # nothing wears this id, so the stop finds nothing and asks nobody
        ("refuses", ["--agent-id", "ghost@session-corpus-alpha", "--stop"]),
        ("refuses", ["--frobnicate", "willow"]),
    ]

    # A copy of the fixture, so a shape that writes writes here and the corpus
    # every other check reads stays as it is.
    smoke_home = Path(tempfile.mkdtemp(prefix=f"{TOOL}-smoke-"))
    smoke_cfg = smoke_home / "claude"
    shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", smoke_cfg)
    smoke_env = dict(os.environ, CLAUDE_CONFIG_DIR=str(smoke_cfg), NO_COLOR="1")
    crashed, misbehaved, codes = [], [], set()
    # A process of this run's own with a command name that is not UTF-8, running
    # while the commands run, so every typed command that reads the process
    # table meets it and reads its stat file through the branch that answers
    # for a name it cannot decode. A unit that sees only the processes under
    # its run meets no other process's name by chance. It exits when its
    # stdin closes, so it cannot outlive this unit.
    oddly_named = sp.Popen([sys.executable, "-c",
                            "import ctypes, sys\n"
                            "ctypes.CDLL(None).prctl(15, b'\\xff\\xfeselftest', 0, 0, 0)\n"
                            "print('named', flush=True)\n"
                            "sys.stdin.read()\n"],
                           stdin=sp.PIPE, stdout=sp.PIPE)
    named = oddly_named.stdout.readline().strip() == b"named"
    with contextlib.suppress(OSError):
        named = named and b"(\xff\xfeselftest)" in Path(
            f"/proc/{oddly_named.pid}/stat").read_bytes()
    if not named:
        misbehaved.append("the process meant to carry a command name that is not UTF-8 "
                          "never carried it")
    was_up = started_here()
    try:
        for expect, argv in shapes:
            typed = f"{TOOL} {' '.join(argv)}"
            try:
                # stdin closed: a prompt nobody can answer must not hang the
                # suite, and no shape here is meant to reach one.
                run = sp.run([sys.executable, str(Path(__file__).resolve()), *argv],
                             capture_output=True, text=True, env=smoke_env,
                             stdin=sp.DEVNULL, timeout=60)
            except sp.TimeoutExpired:
                crashed.append(f"{typed}: still running after 60s")
                continue
            codes.add(run.returncode)
            if "Traceback (most recent call last)" in run.stderr:
                died_of = next((line for line in reversed(run.stderr.splitlines())
                                if re.match(r"[A-Za-z_.]+(Error|Exception):", line)),
                               "no exception line")
                crashed.append(f"{typed}: {died_of.strip()[:110]}")
            elif expect == "runs" and run.returncode != 0:
                misbehaved.append(f"{typed}: exit {run.returncode}, expected it to go through")
            elif expect == "refuses" and run.returncode == 0:
                misbehaved.append(f"{typed}: exit 0, expected a refusal")
            elif expect == "refuses" and not run.stderr.strip():
                misbehaved.append(f"{typed}: exit {run.returncode} and said nothing")
    finally:
        shutil.rmtree(smoke_home, ignore_errors=True)
        oddly_named.stdin.close()
        try:
            oddly_named.wait(timeout=10)
        except sp.TimeoutExpired:
            oddly_named.kill()
            oddly_named.wait()
    left_behind = sorted(started_here() - was_up)
    if left_behind:
        misbehaved.append(f"started something and left it: {', '.join(left_behind)}")
        # Ended here, so that it is in no later unit's view.
        still = end_left_behind(left_behind)
        if still:
            misbehaved.append(f"and could not end {still}")
    if 0 not in codes or not codes - {0}:
        misbehaved.append(f"a run and a refusal must both be covered, "
                          f"and the exit codes seen were {sorted(codes)}")
    told = crashed + misbehaved
    # Three whole entries and then a count, rather than a run of them cut off
    # mid-command: the detail is one line, and half a command name is no lead.
    shown = told[:3] + ([f"and {len(told) - 3} more"] if len(told) > 3 else [])
    check("smoke-typed-commands", "the commands a person types end in a message, not a traceback",
          not told, "; ".join(shown))
    return checked


@unit(('stop-preview-ends-nothing', 'a --stop preview ends nothing and says what it would end'), live=True)
def _check_stop_preview_ends_nothing(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sp = s.sp

    stop_home = Path(tempfile.mkdtemp())
    (stop_home / "projects").mkdir()
    (stop_home / "teams").mkdir()
    ident = own("preview@selftest-stop")

    def stop_arm(*flags):
        """(what a --stop printed, its exit code, whether the fixture survived)."""
        # argv[0] is what decides whether a process is a claude, and the
        # binary that actually runs is python; the id in argv is what --stop
        # matches on. No --resume, so it holds no transcript to resolve.
        victim = sp.Popen([FAKE_AGENT_BIN, "-c", '__import__("time").sleep(60)',
                           "--agent-id", ident], executable=sys.executable)
        try:
            wait_for_command_line(victim.pid)
            run = sp.run([sys.executable, str(Path(__file__).resolve()),
                          "--agent-id", ident, "--stop", *flags],
                         capture_output=True, text=True, timeout=300,
                         stdin=sp.DEVNULL,   # no terminal, so no prompt can be answered
                         env=dict(os.environ, CLAUDE_CONFIG_DIR=str(stop_home),
                                  NO_COLOR="1"))
            time.sleep(0.3)
            return run.stdout, run.returncode, victim.poll() is None
        finally:
            victim.kill()
            victim.wait()

    try:
        said, code, survived = stop_arm("--dry-run")
        yes_said, yes_code, yes_survived = stop_arm("--dry-run", "--yes")
        real_said, real_code, real_survived = stop_arm("--yes")
    finally:
        shutil.rmtree(stop_home, ignore_errors=True)
    preview = {
        "the preview leaves it running": survived,
        "the preview says what it would end":
            "would abort" in said and ident in said,
        # On a pipe the prompt reads EOF and spares the process anyway, so
        # survival alone proves nothing here; asking at all is the fault.
        "the preview asks nothing": "abort these?" not in said,
        "the preview exits 0": code == 0,
        # The arm that matters: --yes skips the question, so a preview here
        # stays a preview with nothing asked.
        "--yes leaves the preview a preview": yes_survived and "would abort" in yes_said,
        "--dry-run --yes exits 0": yes_code == 0,
        # Without --dry-run the same command line still ends it, so a preview
        # that ends nothing is not a --stop that ends nothing.
        "a real stop still ends it": not real_survived
            and "aborted 1 of 1" in real_said and real_code == 0,
    }
    wrong = sorted(k for k, ok in preview.items() if not ok)
    check("stop-preview-ends-nothing", "a --stop preview ends nothing and says what it would end",
          not wrong, ", ".join(wrong))
    return checked


@unit(('process-table-width-independent', 'the process table is the same at a narrow and a wide terminal for every process with a start time, parent and command line that did not change between the two reads'), ('liveness-width-independent', 'an agent that is running is seen as running at either terminal width'), live=True)
def _check_process_table_width_independent(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sp = s.sp

    width_id = own("widths@selftest-columns")
    padded = sp.Popen([FAKE_AGENT_BIN, "-c", '__import__("time").sleep(60)',
                       "--pad", "p" * 400, "--agent-id", width_id],
                      executable=sys.executable)

    # The process table is what this unit measures, so it is the one input
    # that stays real. Everything else comes from a world with no tmux in it:
    # asking the engine a liveness question walks the swarm sockets looking
    # for a seat, and left real that reads every swarm server running on the
    # machine, this team's own included. What that found never changed the
    # answer here, but it made the answer depend on who else was running.
    tmuxless = _FakeTmux(sockets=[])

    def engine_at(columns):
        """A fresh engine with its snapshot taken at this terminal width.

        The engine caches its table, so the width is restored before anything
        is asked of it: what is under test is the snapshot the width produced,
        not the width the question is asked at.
        """
        was = os.environ.get("COLUMNS")
        os.environ["COLUMNS"] = columns
        try:
            eng = Resolver(needs=Needs(maybe=set(NEED)))
            real_table = eng._process_table
            tmuxless.attach(eng)
            eng._process_table = real_table
            eng._process_table(refresh=True)
            return eng
        finally:
            if was is None:
                os.environ.pop("COLUMNS", None)
            else:
                os.environ["COLUMNS"] = was

    def identities():
        """Each listed pid's identity now: its start time, its parent and its command line.

        Read by an engine of this check's own, apart from the two snapshots
        under test and at other moments than they were taken, so whether a
        process changed between them is decided by independent evidence rather
        than by the two rows being compared. Its listing names the pids, and
        the start time and parent come from each process's stat file, all
        through the engine's readers, which the process fence judges as it
        judges every other read in this unit.
        """
        found = {}
        for pid, _ppid, argv in reader._process_table(refresh=True):
            _state, parent, started = reader._proc_stat(pid)
            if started is not None:
                found[pid] = (started, parent, argv)
        return found

    # A fixture that runs exec between the two snapshots: the same pid with a
    # new command line, which is churn the comparison must leave out, not a row
    # that moved because of the width.
    churner = sp.Popen([sys.executable, "-c",
                        "import os, sys\n"
                        "sys.stdin.readline()\n"
                        "os.execv(sys.executable, [sys.executable, '-c', "
                        "'import time; time.sleep(60)', 'churned-by-exec'])"],
                       stdin=sp.PIPE)
    reader = Resolver(needs=Needs(maybe=set(NEED)))
    try:
        wait_for_command_line(padded.pid)
        wait_for_command_line(churner.pid)
        before = identities()
        narrow = engine_at("100")
        churner.stdin.write(b"\n")
        churner.stdin.flush()
        # Until its exec, the churner's command line is the one it started
        # with, and the code in it also contains "churned-by-exec"; after the
        # exec, "churned-by-exec" is its last argument.
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            with contextlib.suppress(OSError):
                argv = Path(f"/proc/{churner.pid}/cmdline").read_bytes().split(b"\0")
                if argv[-2:] == [b"churned-by-exec", b""]:
                    break
            time.sleep(0.05)
        wide = engine_at("1000")
        after = identities()
        narrow_rows = {pid: (ppid, args) for pid, ppid, args in narrow._process_table()}
        wide_rows = {pid: (ppid, args) for pid, ppid, args in wide._process_table()}
        # This machine starts, ends, execs and reparents processes while the
        # suite runs. A pid with a start time, parent or command line that
        # changed between the read before the narrow snapshot and the read
        # after the wide one changed for its own reasons, so it is left out and
        # counted. A pid with an identity that held and two rows that still
        # differ is the fault: the width changed what the table says about it.
        shared = set(narrow_rows) & set(wide_rows)
        churned = sorted(pid for pid in shared if before.get(pid) != after.get(pid))
        moved = sorted(str(pid) for pid in shared - set(churned)
                       if narrow_rows[pid] != wide_rows[pid])
        expected_argv_tail = ("--agent-id", width_id)
        widths = {
            "the fixture is in both snapshots":
                padded.pid in narrow_rows and padded.pid in wide_rows,
            "with its exact argv tuple in both":
                narrow_rows.get(padded.pid, (0, ()))[1][-2:] == expected_argv_tail
                and wide_rows.get(padded.pid, (0, ()))[1][-2:] == expected_argv_tail,
            "the fixture that ran exec between them is left out as churn":
                churner.pid in churned and str(churner.pid) not in moved
                and wide_rows.get(churner.pid, (0, ()))[1][-1:] == ("churned-by-exec",),
            "and no row with an identity that held says two different things": not moved,
        }
        wrong = sorted(k for k, ok in widths.items() if not ok)
        check("process-table-width-independent",
              "the process table is the same at a narrow and a wide terminal for every "
              "process with a start time, parent and command line that did not change between "
              "the two reads",
              not wrong, "; ".join(wrong + [f"{len(churned)} pid(s) changed identity between "
                                            "the snapshots and were left out"])
              + (f"; rows that moved: {', '.join(moved[:3])}" if moved else ""))

        # The half that decides anything. A table nobody could tell apart is
        # worth having only because the answers built on it come out the same,
        # so this asks the engine's own liveness question rather than reading
        # the table again, and it wants a yes at both widths: two snapshots
        # that agree that nothing is running would satisfy a check that only
        # compared them.
        narrow_runtime = narrow._agent_runtime(width_id)
        wide_runtime = wide._agent_runtime(width_id)
        narrow_seen = [row["pid"] for row in narrow_runtime["external"]]
        wide_seen = [row["pid"] for row in wide_runtime["external"]]
        narrow_ours, wide_ours = narrow_runtime["lineage"], wide_runtime["lineage"]
        check("liveness-width-independent",
              "an agent that is running is seen as running at either terminal width",
              narrow_seen == wide_seen == [padded.pid]
              # A process we spawned is a child, never an ancestor, so it is a
              # stranger to us and both widths must say so. A fixture that
              # landed in our own lineage would be excluded from the strangers
              # half for a reason that has nothing to do with width.
              and not narrow_ours and not wide_ours,
              f"pid {padded.pid} is running; at 100 columns the engine saw "
              f"{narrow_seen or 'nothing'}, at 1000 it saw {wide_seen or 'nothing'}"
              + (f"; and it read as our own lineage: {narrow_ours or wide_ours}"
                 if narrow_ours or wide_ours else ""))
    finally:
        for fixture in (padded, churner):
            fixture.kill()
            fixture.wait()
    return checked


@unit(('install-preview-writes-nothing', 'an --install preview writes nothing and says what it would do'), live=True)
def _check_install_preview_writes_nothing(s):
