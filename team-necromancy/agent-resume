            fence.enter("learns", False)
            learned = bool(grandchild) and eng._proc_stat(grandchild)[0] is not None
            everything += fence.leave()
            parent.stdin.write("\n")
            parent.stdin.flush()
            reaped = parent.stdout.readline().strip() == "reaped"
            fence.enter("asks after", False)
            later = eng._proc_stat(grandchild)
            asked_after = fence.leave()
            everything += asked_after
        finally:
            parent.stdin.close()
            parent.wait(timeout=30)
        told["a grandchild the run learned in one unit reads as gone in the next once its "
             "parent reaped it, unrefused"] = (
            learned and reaped and later == (None, None, None) and not asked_after)
        # A tool run of this fence's unit asks about a process this fence
        # learned, and which has gone since, through the run's record of known
        # pids: the tool run never saw it, and reads it as gone, unrefused.
        fence.enter("hands down", False)
        gone = subprocess.Popen(["true"], stdin=subprocess.DEVNULL)
        gone.wait()
        asking = subprocess.run(
            [sys.executable, "-c",
             "import importlib.machinery, importlib.util, sys\n"
             "loader = importlib.machinery.SourceFileLoader('known_record_child', sys.argv[1])\n"
             "tool = importlib.util.module_from_spec(importlib.util.spec_from_loader("
             "loader.name, loader))\n"
             "tool.__file__ = sys.argv[1]\n"
             "loader.exec_module(tool)\n"
             "fence = tool.adopt_inherited_fence()\n"
             "read = tool.Resolver(needs=tool.Needs(maybe=set(tool.NEED)))._proc_stat("
             "int(sys.argv[2]))\n"
             "print(read == (None, None, None), len(fence.refused))\n",
             str(Path(__file__).resolve()), str(gone.pid)],
            capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL,
            env=dict(os.environ, **{FENCE_UNIT_VAR: fence.handed_down(),
                                    FENCE_RECORD_VAR: fence.record}))
        everything += fence.leave()
        told["a tool run reads a pid this process learned and that has gone since as gone, "
             "unrefused, from the run's record of known pids"] = (
            asking.returncode == 0 and asking.stdout.split() == ["True", "0"])
        fence.enter("declared", True)
        fence.name([stranger])
        told["a unit declared to read the machine reads a pid a real listing named"] = (
            eng._proc_stat(stranger)[0] is not None and not fence.refused)
        fence.named[stranger] = "a start time it never had"
        eng._proc_stat(stranger)
        told["but not once that pid's start time is another than the one named"] = (
            [(reader, pid) for _unit, reader, pid in fence.refused] == [("stat", stranger)])
        before = len(fence.refused)
        eng._proc_stat(os.getppid())
        told["nor a running pid no listing named"] = (
            [(reader, pid) for _unit, reader, pid in fence.refused[before:]]
            == [("stat", os.getppid())])
        before = len(fence.refused)
        fence.named[ended.pid] = "1234"
        told["a named pid no process holds any more reads as gone, unrefused"] = (
            eng._proc_stat(ended.pid) == (None, None, None) and len(fence.refused) == before)
        everything += fence.leave()
