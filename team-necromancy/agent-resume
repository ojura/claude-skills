    dest = "session-corpus-leadmove-destination"
    source_lead = "0a1a1a1a-1a1a-41a1-8a1a-1a1a1a1a1a1a"
    dest_lead = "0b2b2b2b-2b2b-42b2-8b2b-2b2b2b2b2b2b"

    def team(corpus, name, lead_session):
        """A team with its own lead, its transcript, and a cursor to rewrite."""
        home = corpus / "teams" / name
        (home / "inboxes").mkdir(parents=True)
        (home / "config.json").write_text(json.dumps({
            "name": name, "leadAgentId": f"team-lead@{name}",
            "leadSessionId": lead_session, "createdAt": 1,
            "members": [{"agentId": f"team-lead@{name}", "name": "team-lead"}],
        }))
        (corpus / "projects" / "corpus" / f"{lead_session}.jsonl").write_text(
            fixture_line({"parentUuid": None, "type": "user", "uuid": lead_session,
                          "sessionId": lead_session, "agentName": "team-lead",
                          "teamName": name,
                          "timestamp": "2026-01-01T00:00:00Z"}) + "\n"
            + fixture_line({"type": "last-prompt", "leafUuid": lead_session,
                            "sessionId": lead_session}) + "\n")

    def prepare(corpus):
        """Both teams are built here: neither belongs in the shared corpus,
        because a lead that migrates away changes what every other reader of
        that corpus would see."""
        team(corpus, source, source_lead)
        team(corpus, dest, dest_lead)

    after = {}

    def inspect(corpus):
        for name in (source, dest):
