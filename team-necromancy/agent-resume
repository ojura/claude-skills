          not forked, "; ".join(sorted(set(forked))[:3]) if forked else
          f"rows handed on to: {', '.join(sorted(set(reached)))}")
    return checked


@unit(("registry-description-replaces-caller-wording",
       "a registered row is reported under its registry description whatever wording its "
       "check passed"),
      ("partly-invalid-unit-keeps-valid-rows",
       "a unit's valid pass and fail rows report while each invalid row it produced is "
       "rejected by name"),
      ("raising-unit-stops-its-context",
       "a unit that changes shared state and raises stops its context, its whole traceback reaches "
       "the diagnostic stream, and every id left without a verdict is named"),
      ("repeated-id-recorded-and-reported",
       "a check id registered twice keeps its first row, and the run finishes and names the id"))
def _check_tier_rows_on_controlled_units(s):
    """The tier loop and its registration rules, on units built here.

    Each set of controlled units goes through tier_rows, the loop both tiers
    and every share run, into a register of its own, so what comes back is what
    a real tier would report for those units: the rows kept and under which
    description, the declaration and ended rows, and the uniqueness row stated
    from what that register recorded. A raising unit's traceback goes to a
    buffer handed in as the diagnostic stream, where this check reads it and no
    operator sees it.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    def tier(units):
        rows, register = check_rows()
        diagnostics = io.StringIO()
        context = types.SimpleNamespace(changed=False)
        tier_rows(units, context, register, False, diagnostics)
        register_ids_unique_row(register, False)
        return ({row[0]: row for row in rows}, rows, register, diagnostics.getvalue(),
                context)

    absent = ("", "", None, "")
    declared_id, ended_id, unique_id = (UNIT_DECLARED[False][0], UNIT_ENDED[False][0],
                                        IDS_UNIQUE[False][0])

    # The wording a check passes for its own row is not what the run reports.
    def worded(_context):
        return [("ctl-worded", "the words the check passed", True, "")]

    by_id, _rows, _register, _said, _context = tier(
        [("worded", (("ctl-worded", "the registry's words"),), worded, False)])
    check("registry-description-replaces-caller-wording",
          "a registered row is reported under its registry description whatever wording its "
          "check passed",
          by_id.get("ctl-worded") == ("ctl-worded", "the registry's words", True, "")
          and by_id.get(declared_id, absent)[2] is True,
          repr(by_id.get("ctl-worded")))

    # One unit producing two valid rows and three invalid ones, and leaving one
    # registered id unproduced. Its valid rows pass the wording their ids
    # registered, so this control does not rest on the registry replacing a
    # check's own wording; the control above tests that alone.
    def mixed(_context):
        return [("ctl-pass", "a valid pass", True, ""),
                ("ctl-fail", "a valid failure", False, "the reason it failed"),
                ("ctl-none", "", None, ""),
                ("ctl-stray", "", True, ""),
                ("ctl-short", "too few fields")]

    by_id, _rows, _register, _said, _context = tier([(
        "mixed", (("ctl-pass", "a valid pass"), ("ctl-fail", "a valid failure"),
                  ("ctl-none", "a verdict that is None"), ("ctl-silent", "an id never produced")),
        mixed, False)])
    declared = by_id.get(declared_id, absent)
    kept = {
        "the valid pass is kept": by_id.get("ctl-pass") == ("ctl-pass", "a valid pass", True, ""),
        "the valid failure is kept": by_id.get("ctl-fail") == (
            "ctl-fail", "a valid failure", False, "the reason it failed"),
        "no rejected row is reported": not {"ctl-none", "ctl-stray", "ctl-short"} & set(by_id),
        "the declaration row fails": declared[2] is False,
        "it counts the three rows rejected": "3 row(s) rejected" in declared[3],
        "it refuses the None verdict by its check's name":
            "'ctl-none' has a NoneType verdict" in declared[3],
        "it names the unregistered id": "mixed produced unregistered 'ctl-stray'" in declared[3],
        "it names the row of the wrong length":
            "mixed produced a row that is not (id, description, verdict, detail)" in declared[3],
        "it names the registered id never produced":
            "1 registered id(s) never produced: ctl-silent (mixed)" in declared[3],
        "the tier still reached its end": by_id.get(ended_id, absent)[2] is True,
    }
    wrong = sorted(claim for claim, ok in kept.items() if not ok)
    check("partly-invalid-unit-keeps-valid-rows",
          "a unit's valid pass and fail rows report while each invalid row it produced is "
          "rejected by name",
          not wrong, ", ".join(wrong) + (f"; declaration row: {declared[3]!r}" if wrong else ""))

    # A unit that changes what the units share and raises, between two others.
    ran = []

    # The row kept from before the raise passes its registered wording, for
    # the same reason as mixed above.
    def first(_context):
        ran.append("first")
        return [("ctl-first", "the unit before", True, "")]

    def raising(context):
        ran.append("raising")
        context.changed = True

        def deep_in_the_raising_unit():
            raise LookupError("the raising unit's own message")

        deep_in_the_raising_unit()

    def after(context):
        ran.append("after")
        return [("ctl-after", "", not context.changed, "")]

    by_id, _rows, _register, said, context = tier([
        ("first", (("ctl-first", "the unit before"),), first, False),
        ("raising", (("ctl-raising", "the unit that raises"),), raising, False),
        ("after", (("ctl-after", "the unit after it"),), after, False)])
    ended = by_id.get(ended_id, absent)
    stopped = {
        "the unit after the raise did not run": ran == ["first", "raising"],
        "the raising unit did change the shared state": context.changed is True,
        "the ended row fails": ended[2] is False,
        "it names the unit, the exception's type and its message":
            "raising ended the run with LookupError: the raising unit's own message" in ended[3],
        "it names the raising unit's ids apart from the ids that did not run": ended[3].endswith(
            "its own 1 id(s) have no verdict: ctl-raising; 1 id(s) after it did not run: ctl-after"),
        "the raising unit's id and the id after it have no verdict":
            not {"ctl-raising", "ctl-after"} & set(by_id),
        "the verdict before the raise is kept": by_id.get("ctl-first") == (
            "ctl-first", "the unit before", True, ""),
        "ids left without a verdict are not called misdeclared":
            by_id.get(declared_id, absent)[2] is True,
        "the traceback is written whole, inner frame and message included":
            "deep_in_the_raising_unit" in said
            and "LookupError: the raising unit's own message" in said,
    }
    # The same raise from the last unit of its context: there is nothing after
    # it, so the ended row names its own ids and no unit as not having run.
    last, _rows, _register, _said, _context = tier([
        ("first", (("ctl-first", "the unit before"),), first, False),
        ("raising", (("ctl-raising", "the unit that raises"),), raising, False)])
    stopped["a raising unit with none after it names only its own ids"] = (
        last.get(ended_id, absent)[3].endswith("its own 1 id(s) have no verdict: ctl-raising"))
    wrong = sorted(claim for claim, ok in stopped.items() if not ok)
    check("raising-unit-stops-its-context",
          "a unit that changes shared state and raises stops its context, its whole traceback "
          "reaches the diagnostic stream, and every id left without a verdict is named",
          not wrong, ", ".join(wrong) + (f"; ended row: {ended[3]!r}" if wrong else ""))

    # One id produced twice by one unit, and one id declared and produced by two.
    def twice(_context):
        return [("ctl-twice", "", True, "the first emission"),
                ("ctl-twice", "", False, "the second emission")]

    def one_owner(_context):
        return [("ctl-shared", "", True, "from the first unit")]

    def other_owner(_context):
        return [("ctl-shared", "", False, "from the second unit")]

    def later(_context):
        return [("ctl-later", "", True, "")]

    by_id, rows, register, _said, _context = tier([
        ("twice", (("ctl-twice", "an id one unit emits twice"),), twice, False),
        ("one_owner", (("ctl-shared", "an id two units declare"),), one_owner, False),
        ("other_owner", (("ctl-shared", "an id two units declare"),), other_owner, False),
        ("later", (("ctl-later", "a unit after both"),), later, False)])
    unique = by_id.get(unique_id, absent)
    recorded = {
        "the first row of each id is kept":
            by_id.get("ctl-twice", absent)[3] == "the first emission"
            and by_id.get("ctl-shared", absent)[3] == "from the first unit",
        "one row per id": len(rows) == len(by_id),
        "both repeats are recorded": sorted(register.collisions) == ["ctl-shared", "ctl-twice"],
        "the tier went on past them": "ctl-later" in by_id,
        "the uniqueness row fails and names both ids":
            unique[2] is False and "ctl-shared" in unique[3] and "ctl-twice" in unique[3],
        "a repeat is not called a misdeclaration": by_id.get(declared_id, absent)[2] is True,
    }

    # The rows a run states last, through the function the run states them
    # with: on a register where another row already took the catalog row's id,
    # the catalog row's own registration is the repeat, and the uniqueness row
    # after it names that id. On a clean register the uniqueness row passes,
    # so it is not one that fails whatever it is given.
    catalog_id, unique_said = CATALOG_REPORTED[False][0], IDS_UNIQUE[False][1]
    listing = [CATALOG_REPORTED[False], IDS_UNIQUE[False]]
    taken_rows, taken_register = check_rows()
    taken_register(catalog_id, CATALOG_REPORTED[False][1], True, "a row that took the id first")
    register_closing_rows(taken_register, taken_rows, False, listing)
    taken = {row[0]: row for row in taken_rows}
    clean_rows, clean_register = check_rows()
    register_closing_rows(clean_register, clean_rows, False, listing)
    clean = {row[0]: row for row in clean_rows}
    recorded.update({
        "a row holding the catalog row's id is named by the uniqueness row after it":
            taken.get(unique_id, absent)[2] is False and catalog_id in taken[unique_id][3]
            and taken[catalog_id][3] == "a row that took the id first",
        "the uniqueness row passes when no row holds the catalog row's id":
            clean.get(unique_id, absent) == (unique_id, unique_said, True, ""),
    })
    wrong = sorted(claim for claim, ok in recorded.items() if not ok)
    check("repeated-id-recorded-and-reported",
          "a check id registered twice keeps its first row, and the run finishes and names the id",
          not wrong, ", ".join(wrong) + (f"; uniqueness row: {unique[3]!r}" if wrong else ""))
    return checked


@unit(("child-report-judged-whole",
       "a child's or share's report counts only when its rows, tally and exit status agree, "
       "and a broken one is named rather than raised"))
def _check_child_report_judged_whole(s):
    """report_of on reports the real printer made, then broken one way at a time.

    report_of is what a live run reads its read-only child and every share
    through. Each case below differs from a whole report in one respect, so the
    problems that come back are the ones that respect causes and nothing else,
    and none of them may raise: a parser exception in the parent would end the
    run with nothing reported at all.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    results = [("ctl-a", "the first check", True, ""),
               ("ctl-b", "the second check", False, "why it failed"),
               ("ctl-c", "the third check", True, "line one\nline two")]
    passing = [row for row in results if row[2]]
    printed = "\n".join(check_report(results)) + "\n"
    clean = "\n".join(check_report(passing)) + "\n"
    untallied = "\n".join(check_report(results)[:-2]) + "\n"

    def tallied(tally, extra=()):
        lines = check_report(results)
        return "\n".join([*lines[:-2], *extra, "", tally]) + "\n"

    bound = SELFTEST_CHILD_BOUND
    cases = (
        ("a whole failing report that exits 1", printed, 1, []),
        ("a whole passing report that exits 0", clean, 0, []),
        ("passing rows with exit 3", clean, 3, ["exited 3 where its verdicts call for 0"]),
        ("a failing row with exit 0", printed, 0, ["exited 0 where its verdicts call for 1"]),
        ("no tally", untallied, 1, ["no summary line, so the report is incomplete", "exited 1"]),
        ("a malformed tally", tallied("2/x checks passed"), 1,
         ["malformed summary '2/x checks passed'", "exited 1"]),
        ("a tally that disagrees with the rows", tallied("9/9 checks passed"), 1,
         ["the summary counts 9/9 but 3 row(s) were read, 2 passed"]),
        ("a verdict line without an id and description",
         tallied("2/3 checks passed", ("  PASS  lonely",)), 1,
         ["a verdict line without an id and description: 'PASS  lonely'"]),
        ("a signal after a whole report", printed, -9, ["was ended by signal 9"]),
        ("a run stopped at its bound", untallied, None,
         ["no summary line, so the report is incomplete",
          f"did not finish within {bound}s and was stopped"]),
        ("text that is no report at all", "\x00\x01 neither rows nor a tally\n", 0,
         ["no summary line, so the report is incomplete", "exited 0"]),
    )
    wrong = []
    for named, text, code, problems in cases:
        try:
            report = report_of(text, code, bound)
        except Exception as exc:
            wrong.append(f"{named}: raised {type(exc).__name__}: {exc}")
            continue
        if list(report.problems) != problems:
            wrong.append(f"{named}: {list(report.problems)}")
    whole = report_of(printed, 1, bound)
    if list(whole.rows) != results:
        wrong.append(f"the rows of a whole report, a two-line detail among them, read back as "
                     f"{whole.rows}")
    if whole.summary != "2/3 checks passed":
        wrong.append(f"the tally reads back as {whole.summary!r}")
    check("child-report-judged-whole",
          "a child's or share's report counts only when its rows, tally and exit status agree, "
          "and a broken one is named rather than raised",
          not wrong, "; ".join(wrong))
    return checked


@unit(("shares-fold-into-one-run",
       "a split run states each share's own summary rows once, keeps collisions between shares, "
       "and names every share that did not report whole, wrote to stderr or never started"))
def _check_shares_fold_into_one_run(s):
    """fold_shares on share reports the real printer made.

    A share reports its own checks and the rows every share states about its
    own run. The merge has to register the first kind as they came, so a check
    two shares both reported is a collision, and fold the second kind into one
    row each, so the repeats across shares are not. Each case is a list of
    finished shares as collected returns them.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # What a share states about its own run: the mid-run row, and the live
    # member of every tier row but the catalog one, which only the run that
    # merged the shares states, a share having no catalog of its own. Taken
    # from TIER_ROWS rather than from SHARE_SUMMARY_ROWS, so a tier row left
    # out of that list shows up as the collision it would be.
    own_rows = (RUNNER_CHECKS[0], *(pair[True] for pair in TIER_ROWS
                                    if pair is not CATALOG_REPORTED))

    def summary(**failing):
        rows = {cid: (cid, said, True, "") for cid, said in own_rows}
        for cid, why in failing.items():
            rows[cid] = (cid, rows[cid][1], False, why)
        return rows

    def share(rows, own_rows, returncode=None, stderr=""):
        results = [*rows, *own_rows]
        code = ((0 if all(row[2] for row in results) else 1) if returncode is None
                else returncode)
        return subprocess.CompletedProcess(["share"], code,
                                           "\n".join(check_report(results)) + "\n", stderr)

    def merged(finished, jobs=2):
        rows, register = check_rows()
        faults = fold_shares(finished, jobs, register)
        register_ids_unique_row(register, True, faults)
        return {row[0]: row for row in rows}, rows, register

    absent = ("", "", None, "")
    folded = [cid for cid, _said in own_rows]
    shared_id, unique_id = SHARED_CHECKS[0][0], IDS_UNIQUE[True][0]
    noise_id, ended_id, tmux_id = RUNNER_CHECKS[0][0], UNIT_ENDED[True][0], TIER_TMUX[True][0]

    by_id, rows, register = merged([
        share([("ctl-a", "a", True, "")], summary().values()),
        share([("ctl-b", "b", True, "")], summary().values())])
    whole = {
        "every folded row and the share row pass": all(
            by_id.get(cid, absent)[2] is True for cid in (*folded, shared_id)),
        "each folded row is stated once": len(rows) == len(by_id),
        "the shares' checks are registered": {"ctl-a", "ctl-b"} <= set(by_id),
        "a summary row repeated by every share is not a collision": not register.collisions,
    }

    traceback_text = ("Traceback (most recent call last):\n"
                      "  File \"a share\", line 1, in a unit\n"
                      "LookupError: the whole text a share wrote")
    first = share([("ctl-a", "a", True, ""), ("ctl-shared", "s", True, ""),
                   (noise_id, RUNNER_CHECKS[0][1], True, "")],
                  summary().values(), returncode=3)
    second_rows = summary(**{ended_id: "a unit ended this share",
                             unique_id: "this share's own repeat"})
    del second_rows[tmux_id]
    second = share([("ctl-b", "b", True, ""), ("ctl-shared", "s", True, "")],
                   second_rows.values(), stderr=traceback_text + "\n")
    by_id, rows, register = merged([first, second])
    shares = by_id.get(shared_id, absent)
    faulty = {
        "the share row fails": shares[2] is False,
        "it names the status that disagrees":
            "share 0/2: exited 3 where its verdicts call for 0" in shares[3],
        "it carries a share's stderr whole": f"share 1/2 stderr:\n{traceback_text}" in shares[3],
        "a summary row reported twice by one share is named":
            "share 0/2 reported it 2 time(s)" in by_id.get(noise_id, absent)[3],
        "a summary row a share never reported is named":
            "share 1/2 reported it 0 time(s)" in by_id.get(tmux_id, absent)[3],
        "a failing summary row names its share":
            by_id.get(ended_id, absent)[3] == "share 1/2: a unit ended this share",
        "a check two shares both reported is a collision": register.collisions == ["ctl-shared"],
        "the one uniqueness row carries that collision and the share's own":
            by_id.get(unique_id, absent)[2] is False
            and "ctl-shared" in by_id.get(unique_id, absent)[3]
            and "share 1/2: this share's own repeat" in by_id.get(unique_id, absent)[3],
        "the first report of the shared check is kept": by_id.get("ctl-shared", absent)[2] is True,
    }

    by_id, _rows, _register = merged([share([], summary().values())])
    missing = {
        "a share that never started fails the share row":
            "share 1/2 never started" in by_id.get(shared_id, absent)[3],
        "and every folded row": all(
            "share 1/2 reported it 0 time(s)" in by_id.get(cid, absent)[3]
            for cid in folded if cid != unique_id)
        and "share 1/2 reported it 0 time(s)" in by_id.get(unique_id, absent)[3],
    }
    wrong = sorted(claim for claim, ok in {**whole, **faulty, **missing}.items() if not ok)
    check("shares-fold-into-one-run",
          "a split run states each share's own summary rows once, keeps collisions between shares, "
          "and names every share that did not report whole, wrote to stderr or never started",
          not wrong, ", ".join(wrong))
    return checked


@unit(("catalog-lists-every-reported-row",
       "each tier and jobs value's catalog holds exactly its declared unit and runner rows, once "
       "each, the inherited runner rows and its own row included, and --list prints it"),
      ("catalog-row-compares-ids-and-descriptions",
       "the catalog row fails on a missing, an unlisted or a reworded row and passes on an "
       "exact report"))
def _check_catalog_names_its_rows(s):
    """What the catalog holds, what --list prints, and how the catalog row compares.

    The rows a run of each tier and jobs value reports are written out here
    from the rules rather than read back from selftest_catalog: every unit of
    the tier, both tiers' units for a live run, the runner's own rows of the
    tier and, for a live run, the read-only ones it inherits, the mid-run row
    for a live run and the share row for a split one. The catalog row is then
    put to a controlled catalog, so each way a report can differ from its
    listing is shown to fail it and an exact report to pass it.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    def listed(live, jobs):
        said = io.StringIO()
        with capturing("out", into=said):
            run_selftest(live=live, list_only=True, jobs=jobs)
        return [tuple(part.strip() for part in line.strip().partition("  ")[::2])
                for line in said.getvalue().splitlines()]

    units = {tier: {(cid, said) for _n, ids, _r, is_live in UNITS if is_live == tier
                    for cid, said in ids}
             for tier in (False, True)}
    wrong = []
    for live, jobs in ((False, 1), (True, 1), (True, 2), (True, 4)):
        where = f"{'live' if live else 'read-only'} jobs {jobs}"
        catalog = selftest_catalog(live, jobs)
        wanted = set(units[False]) | {pair[live] for pair in TIER_ROWS}
        if live:
            wanted |= units[True] | set(RUNNER_CHECKS) | {pair[False] for pair in TIER_ROWS}
        if live and jobs > 1:
            wanted |= set(SHARED_CHECKS)
        if set(catalog) != wanted:
            wrong.append(f"{where}: missing {sorted(wanted - set(catalog))[:3]}, "
                         f"extra {sorted(set(catalog) - wanted)[:3]}")
        if CATALOG_REPORTED[live] not in catalog:
            wrong.append(f"{where}: the catalog row does not list itself")
        if len(catalog) != len({pair[0] for pair in catalog}):
            wrong.append(f"{where}: an id is listed twice")
        if listed(live, jobs) != catalog:
            wrong.append(f"{where}: --list prints something other than the catalog")
    check("catalog-lists-every-reported-row",
          "each tier and jobs value's catalog holds exactly its declared unit and runner rows, "
          "once each, the inherited runner rows and its own row included, and --list prints it",
          not wrong, "; ".join(wrong))

    controlled = [("ctl-a", "the first"), ("ctl-b", "the second"), CATALOG_REPORTED[False]]

    def judged(results, following=()):
        rows, register = check_rows()
        for row in results:
            register(*row)
        register_catalog_row(register, rows, False, controlled, following)
        return rows[-1]

    exact = judged([("ctl-a", "the first", True, ""), ("ctl-b", "the second", False, "why")])
    short = judged([("ctl-a", "the first", True, "")])
    extra = judged([("ctl-a", "the first", True, ""), ("ctl-b", "the second", True, ""),
                    ("ctl-c", "never listed", True, "")])
    reworded = judged([("ctl-a", "other words", True, ""), ("ctl-b", "the second", True, "")])
    # ctl-b comes after the catalog row, as the uniqueness row does in a run.
    later = judged([("ctl-a", "the first", True, "")], following=(("ctl-b", "the second"),))
    comparing = {
        "an exact report passes, a failing row and the catalog row itself included":
            exact == (*CATALOG_REPORTED[False], True, ""),
        "a missing row is named": short[2:] == (False, "listed but never reported: ctl-b"),
        "an unlisted row is named": extra[2:] == (False, "reported but never listed: ctl-c"),
        "a reworded row is named":
            reworded[2:] == (False, "reported under another description: ctl-a"),
        "a row registered after it and named as following counts as reported":
            later == (*CATALOG_REPORTED[False], True, ""),
    }
    wrong = sorted(claim for claim, ok in comparing.items() if not ok)
    check("catalog-row-compares-ids-and-descriptions",
          "the catalog row fails on a missing, an unlisted or a reworded row and passes on an "
          "exact report",
          not wrong, ", ".join(wrong) + (f"; rows {exact}, {short}, {extra}, {reworded}, "
                                         f"{later}" if wrong else ""))
    return checked


@unit(("team-layout-one-owner", "what a team directory holds is named in one place"))
def _check_team_layout_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    tree = s.tree

    forked = []
    owners = ("_team_dir", "_roster_in", "_inboxes_in")
    # named_parts collects whatever roster_in and inboxes_in each join onto the
    # directory they are given, which is "config.json" and "inboxes". Point one
    # of them at a different file and the search below moves to that one.
    named_parts = set()
    for named in owners:
        node = s.resolver_methods.get(named)
        if not node:
            forked.append(f"{named} is gone, so nothing answers where that is")
            continue
        named_parts |= {sub.right.value for sub in ast.walk(node)
                        if isinstance(sub, ast.BinOp) and isinstance(sub.op, ast.Div)
                        and isinstance(sub.right, ast.Constant)
                        and isinstance(sub.right.value, str)}
    if (s.resolver_methods.get("_roster_in") and s.resolver_methods.get("_inboxes_in")
            and len(named_parts) < 2):
        forked.append("the roster and the mailboxes are not named apart, so there "
                      "is nothing to hold the rest of the file to")

    if not forked:
        # Each row calls the engine twice and compares the two paths:
        # roster_path("crew") against roster_in(team_dir("crew")), and so on.
        # No path is spelled out here.
        eng = s.corpus_engine()
        for named, got, want in (
                ("roster_path", eng._roster_path("crew"), eng._roster_in(eng._team_dir("crew"))),
                ("inbox_path", eng._inbox_path("crew", "mate").parent,
                 eng._inboxes_in(eng._team_dir("crew"))),
                ("team_dir", eng._team_dir("crew").parent, eng._teams_dir)):
            if got != want:
                forked.append(f"{named} lands at {got}, not {want}")

    # Every other `something / "config.json"`, `something / "inboxes"` and
    # `teams_dir / something` in the file. The suite is left out: its fixtures
    # build the directories the engine then has to find, so they write the
    # layout out.
    spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
             for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
    tops = [(node.lineno, node.end_lineno or node.lineno, node.name) for node in tree.body
            if isinstance(node, (ast.FunctionDef, ast.ClassDef))]
    for node in ast.walk(tree):
        if not (isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div)):
            continue
        inner = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
        outer = [top for top in tops if top[0] <= node.lineno <= top[1]]
        where = inner[-1][2] if inner else "<module>"
        if ((outer and outer[0][2] in s.suite_fns)
                or where in set(owners) | {"reap_team", "remove_cleanup_action"}):
            continue
        if isinstance(node.right, ast.Constant) and node.right.value in named_parts:
            forked.append(f"{where} joins {node.right.value!r} onto a path at line {node.lineno}")
        elif isinstance(node.left, ast.Attribute) and node.left.attr == "teams_dir":
            forked.append(f"{where} builds a team's directory at line {node.lineno}")
    check("team-layout-one-owner", "what a team directory holds is named in one place",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(("implicit-team-shape-one-owner", "one place says what an implicit team is named after"))
def _check_implicit_team_shape_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("implicit_team_block")
    pattern = next((arg.value for node in (ast.walk(owner) if owner else ())
                    if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                    and getattr(node.func.value, "id", None) == "re"
                    for arg in node.args[:1]
                    if isinstance(arg, ast.Constant) and isinstance(arg.value, str)), None)
    if not owner:
        forked.append("implicit_team_block is gone, so nothing owns the shape")
    elif not pattern:
        forked.append("implicit_team_block matches nothing, so there is no shape to hold")
    else:
        # implicit_team_block is called on four team names and every answer
        # compared: one the harness created, one that merely starts like an
        # implicit one, one a --team-name flag gave, and no team at all.
        for asked, got, want in (
                ("an implicit team's name", implicit_team_block("session-a52cb2af"), "a52cb2af"),
                ("an implicit team's name with more after it",
                 implicit_team_block("session-a52cb2af-two"), None),
                ("a name a flag gave", implicit_team_block("crew"), None),
                ("no team at all", implicit_team_block(None), None)):
            if got != want:
                forked.append(f"{asked} answers {got!r}, not {want!r}")

        # pattern holds implicit_team_block's own regex, taken a few lines up
        # out of the re.fullmatch call in its body. Any other string literal in
        # this file containing that regex is a second copy of the rule.
        # Parentheses are dropped from both sides, so r"session-([0-9a-f]{8})"
        # and r"session-[0-9a-f]{8}" count as the same text.
        def bare(text):
            return "".join(ch for ch in text if ch not in "()")

        spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                 for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
        for node in ast.walk(tree):
            if not (isinstance(node, ast.Constant) and isinstance(node.value, str)):
                continue
            if bare(pattern) not in bare(node.value):
                continue
            inside = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
            where = inside[-1][2] if inside else "<module>"
            if where != owner.name:
                forked.append(f"{where} writes the shape again at line {node.lineno}")

        # Eight hex characters are not a session id, and what a match on them
        # is worth is one judgement. session_names_team makes it;
        # sessions_naming and registry_entries_naming carry it to the two
        # corpora a team name is looked for in, and classify wants the shape
        # and nothing else. Anybody else holding the raw block is matching
        # names to sessions on its own account.
        asks = s.callers_of("implicit_team_block") - s.suite_fns
        extra = asks - {"_session_names_team", "_sessions_naming",
                        "_registry_entries_naming", "_classify"}
        if extra:
            forked.append("the block is handed out to " + ", ".join(sorted(extra)))
    check("implicit-team-shape-one-owner",
          "one place says what an implicit team is named after",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(("agent-id-spelled-one-way", "an agent id comes apart and goes together in one place"))
def _check_agent_id_spelled_one_way(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    owners = ("name_and_team", "agent_id_of")
    forked = [f"{named} is gone, so nothing owns how an id is spelled"
              for named in owners if named not in funcs]
    if not forked:
        # agent_id_of builds the id, name_and_team takes it apart again, and
        # the four rows compare what those two say against what they were
        # given. No spelling of "mate@session-1234abcd" is written out here.
        built = agent_id_of("mate", "session-1234abcd")
        for asked, got, want in (
                (f"{built} taken apart", name_and_team(built), ("mate", "session-1234abcd")),
                ("an id with no team", name_and_team("mate"), ("mate", None)),
                ("an id with no name", name_and_team("@crew"), (None, "crew")),
                ("no id at all", name_and_team(None), (None, None))):
            if got != want:
                forked.append(f"{asked} answers {got}, not {want}")

    # A second spelling anywhere else, in either direction: .split("@"),
    # .partition("@") and their r-forms, and any f-string with text that runs up
    # to an "@" and then substitutes, which is both f"{name}@{team}" and
    # f"team-lead@{team}". The suite is left out: its fixtures write the ids a
    # roster really holds and its assertions read the ids a launch really
    # emitted, so both spell them out.
    spread = []
    for node in tree.body:
        if not isinstance(node, (ast.FunctionDef, ast.ClassDef)):
            continue
        if node.name in s.suite_fns or node.name in owners:
            continue
        for sub in ast.walk(node):
            if (isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
                    and sub.func.attr in ("split", "rsplit", "partition", "rpartition")
                    and sub.args and isinstance(sub.args[0], ast.Constant)
                    and sub.args[0].value == "@"):
                spread.append(f"{node.name} cuts an id apart at line {sub.lineno}")
            if not isinstance(sub, ast.JoinedStr):
                continue
            for at, piece in enumerate(sub.values[:-1]):
                if (isinstance(piece, ast.Constant) and isinstance(piece.value, str)
                        and piece.value.endswith("@")
                        and isinstance(sub.values[at + 1], ast.FormattedValue)):
                    spread.append(f"{node.name} builds an id at line {sub.lineno}")
    forked += sorted(set(spread))
    check("agent-id-spelled-one-way", "an agent id comes apart and goes together in one place",
          not forked, "; ".join(forked[:3]))
    return checked


@unit(("check-line-one-owner", "a check reads the same way wherever it is printed"))
def _check_check_line_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # One place puts a check's id next to its name. Anything assembling both
    # fields itself is a second spelling, and the three renderings move
    # together only while there is one.
    ast = s.ast

    printers = set()
    for fnode in ast.walk(s.tree):
        if not isinstance(fnode, ast.FunctionDef) or fnode.name == "check_line":
            continue
        for piece in ast.walk(fnode):
            if not isinstance(piece, ast.JoinedStr):
                continue
            filled = {getattr(v.value, "id", None) for v in piece.values
                      if isinstance(v, ast.FormattedValue)}
            if {"cid", "name"} <= filled or {"cid", "said"} <= filled:
                printers.add(fnode.name)
    check("check-line-one-owner", "a check reads the same way wherever it is printed",
          not printers, ", ".join(sorted(printers)))
    return checked


def description_drift(tree, ast):
    """Every literal row description in tree that differs from the one its id registered.

    The registry is every (id, description) pair of string literals in a @unit
    declaration. A pair of literals counts as a row's id and description where
    the suite builds rows, in three ways: the first two arguments of a check()
    or register() call; the first two elements of a four-element tuple handed
    to append(), as a unit collecting the rows it returns builds them; and a
    pair in the literal iterable of a loop or comprehension that unpacks two
    names and builds a row from them in one of those ways, as a branch that
    fails every id of a unit at once does. A pair anywhere else is not a row
    and is not compared: a declaration, a runner row's tier_row, a table of
    reasons, details or fixture text.

    Returns (drifted, compared, computed, unreached): each drift as "<id> at
    line <n>", in line order; how many rows were compared; how many rows are
    built where they are counted, a check() or register() call or a four-element
    append(), but not from two literals, so they cannot be compared; and the
    registered ids no compared row names.
    """
    def text(node):
        return node.value if isinstance(node, ast.Constant) and isinstance(node.value, str) else None

    registry = {}
    for fnode in ast.walk(tree):
        for decorator in getattr(fnode, "decorator_list", ()):
            if (isinstance(decorator, ast.Call) and isinstance(decorator.func, ast.Name)
                    and decorator.func.id == "unit"):
                for pair in decorator.args:
                    if isinstance(pair, ast.Tuple) and len(pair.elts) == 2:
                        cid, said = text(pair.elts[0]), text(pair.elts[1])
                        if cid is not None and said is not None:
                            registry[cid] = said

    def head(node):
        """The id and description nodes of the row node builds, or None."""
        if not isinstance(node, ast.Call):
            return None
        if getattr(node.func, "id", None) in ("check", "register") and len(node.args) >= 2:
            return node.args[0], node.args[1]
        if (isinstance(node.func, ast.Attribute) and node.func.attr == "append"
                and len(node.args) == 1 and isinstance(node.args[0], ast.Tuple)
                and len(node.args[0].elts) == 4):
            return node.args[0].elts[0], node.args[0].elts[1]
        return None

    pairs, computed = [], 0
    for node in ast.walk(tree):
        built = head(node)
        if built is None:
            continue
        cid, said = text(built[0]), text(built[1])
        if cid is not None and said is not None:
            pairs.append((cid, said, node.lineno))
        else:
            computed += 1

    # A loop or comprehension turns each literal pair in its literal iterable
    # into a row when its target unpacks two names and its body builds a row
    # from exactly those two.
    for node in ast.walk(tree):
        if isinstance(node, ast.For):
            loops = [(node.target, node.iter, [sub for stmt in node.body for sub in ast.walk(stmt)])]
        elif isinstance(node, (ast.ListComp, ast.GeneratorExp, ast.SetComp)):
            loops = [(made.target, made.iter, list(ast.walk(node.elt))) for made in node.generators]
        else:
            continue
        for target, iterable, body in loops:
            if not (isinstance(target, ast.Tuple) and len(target.elts) >= 2
                    and all(isinstance(name, ast.Name) for name in target.elts[:2])
                    and isinstance(iterable, (ast.Tuple, ast.List))):
                continue
            names = tuple(name.id for name in target.elts[:2])
            heads = [head(sub) for sub in body] + [
                tuple(sub.elts[:2]) for sub in body if isinstance(sub, ast.Tuple) and len(sub.elts) == 4]
            if not any(built and tuple(getattr(part, "id", None) for part in built) == names
                       for built in heads):
                continue
            for item in iterable.elts:
                if isinstance(item, (ast.Tuple, ast.List)) and len(item.elts) >= 2:
                    cid, said = text(item.elts[0]), text(item.elts[1])
                    if cid is not None and said is not None:
                        pairs.append((cid, said, item.lineno))

    drifted = [f"{cid} at line {line}" for cid, said, line in sorted(pairs, key=lambda pair: pair[2])
               if cid in registry and said != registry[cid]]
    unreached = set(registry) - {cid for cid, _said, _line in pairs}
    return drifted, len(pairs), computed, unreached


@unit(("check-description-matches-registry",
       "every literal check description in the source equals the one its id registered"))
def _check_check_description_matches_registry(s):
    """description_drift on the tool's source, and on a source written here with one of each.

    The registry decides the description a row is reported under, so a row
    that carries other wording changes nothing a run prints. It is still a
    second statement of what the check is, which a reader takes for the first
    and which drifts unseen. The control source has other wording beside a
    registered id in each of the three places a row is built, and twice where
    no row is built, in a table of reasons and in a loop that builds none: the
    three are found and the other two are not.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    drifted, compared, computed, unreached = description_drift(s.tree, ast)
    control = ast.parse("\n".join([
        '@unit(("ctl-registered", "the registered words"))',
        "def ctl_unit(s):",
        '    reasons = (("ctl-registered", "a reason beside the id, which is no row"),)',
        '    check("ctl-registered", "other words in a call", True)',
        '    out.append(("ctl-registered", "other words in an appended row", True, ""))',
        '    for cid, said in (("ctl-registered", "other words in a looped pair"),):',
        '        out.append((cid, said, False, ""))',
        '    for cid, why in (("ctl-registered", "a reason in a loop that builds no row"),):',
        '        notes.append(why)',
    ]))
    found = description_drift(control, ast)[0]
    wanted = [f"ctl-registered at line {line}" for line in (4, 5, 6)]
    check("check-description-matches-registry",
          "every literal check description in the source equals the one its id registered",
          not drifted and found == wanted,
          "; ".join(drifted + ([f"the control source gave {found}, not {wanted}"]
                               if found != wanted else []))
          or f"{compared} rows compared, {computed} rows built without two literals "
             f"(check(), register() or append()), {len(unreached)} registered ids named by no "
             f"literal row")
    return checked


def selftest_catalog(live=False, jobs=1):
    """Exactly the (id, description) rows a run of this tier and jobs value reports.

    One owner for the question, read by --list and by the run's own catalog
    row, so "the listing named it" and "the run reported it" are one claim
    rather than two assemblies that agree until one of them changes. Both
    tiers are registered, so asking what exists reads the registry and runs
    nothing.
    """
    rows = [(cid, said)
            for _name, ids, _run, is_live in UNITS if live or not is_live
            for cid, said in ids]
    # The runner's own rows about a live tier: what it printed mid-run, and,
    # when it splits, whether every share reported in full.
    rows += list(RUNNER_CHECKS) if live else []
    rows += list(SHARED_CHECKS) if live and jobs > 1 else []
    # Every runner row the tier states for itself. A live run also inherits
    # the read-only tier's whole table from its child, runner rows included,
    # so its listing names those too: listing only the live members described
    # a run nobody performs.
    rows += [pair[bool(live)] for pair in TIER_ROWS]
    rows += [pair[False] for pair in TIER_ROWS] if live else []
    return rows


def register_catalog_row(register, results, live, catalog, following=()):
    """The tier's verdict on whether it reported exactly the rows its listing named.

    catalog is the listing for this run's tier and jobs value, as
    selftest_catalog gives it. The comparison is of (id, description) pairs
    taken from the rows themselves: an id listed and never reported, one
    reported and never listed, and one reported under another description are
    each named in full. The row counts itself, since the listing names it, and
    each (id, description) in following, the rows its caller registers after
    it. A row already reported under one of those ids is compared as it was
    reported, so a row that took one of them under other words is named.
    """
    listed = dict(catalog)
    reported = {cid: name for cid, name, _ok, _detail in results}
    own_id, own_description = CATALOG_REPORTED[live]
    for cid, name in ((own_id, own_description), *following):
        reported.setdefault(cid, name)
    missing = [cid for cid in listed if cid not in reported]
    unlisted = [cid for cid in reported if cid not in listed]
    reworded = [cid for cid in listed if cid in reported and reported[cid] != listed[cid]]
    faults = ([f"listed but never reported: {', '.join(missing)}"] if missing else [])
    faults += ([f"reported but never listed: {', '.join(unlisted)}"] if unlisted else [])
    faults += ([f"reported under another description: {', '.join(reworded)}"]
               if reworded else [])
    register(own_id, own_description, not faults, "; ".join(faults))


def register_closing_rows(register, results, live, catalog=None, share_faults=()):
    """The two rows a run states last, about its own registrations.

    catalog is the listing the run is held to, or None for a share, which runs
    part of the tier and has no catalog of its own; the run that merged the
    shares states that row. The catalog row comes first and counts the
    uniqueness row as reported. The uniqueness row comes last, so a collision
    on any id registered before it, the catalog row's own included, is one it
    reads. A collision on its own id is the one it cannot state, since its own
    registration is the row dropped; a unit can produce that id only by
    declaring it, which lists the id twice and fails
    catalog-lists-every-reported-row.
    """
    if catalog is not None:
        register_catalog_row(register, results, live, catalog, following=(IDS_UNIQUE[live],))
    register_ids_unique_row(register, live, share_faults)


def register_ids_unique_row(register, live, share_faults=()):
    """The tier's verdict on whether any check id was registered twice.

    Read off the register that made the rows, so the subject is what this run
    registered rather than what the source declares. share_faults is what the
    shares of a split run said about their own registrations, so one row per
    live run carries both those and the collisions the merge itself recorded,
    between two shares or between a share and an inherited row. Registered
    after every row it judges, the catalog row included; register_closing_rows
    keeps that order.

    The one collision this row cannot state is on its own id: its own
    registration is then the row dropped, and the row reported under its id is
    the other one. A unit produces that id only by declaring it, and a
    declaration lists the id twice, which catalog-lists-every-reported-row
    fails on.
    """
    repeated = sorted(set(register.collisions))
    faults = ([f"registered more than once: {', '.join(repeated)}"] if repeated else [])
    faults += list(share_faults)
    register(*IDS_UNIQUE[live], not faults, "; ".join(faults))


# The run_selftest call in progress in this process, set by the outermost call
# for its length and None between runs. A call made while it is set is nested,
# as a unit's fixture makes one, and leaves the run's cleanup to that call.
SELFTEST_IN_PROGRESS = {"call": None}


def run_selftest(live=False, failed_only=False, list_only=False, jobs=1, share=None,
                 child=None, diagnostics=None):
    if list_only:
        rows = selftest_catalog(live, jobs)
        column = max((len(cid) for cid, _said in rows), default=0)
        for cid, said in rows:
            print(check_line(cid, said, idwidth=column))
        return 0
    # The corpus every fixture copies lives beside this file. Without it the
    # units do not fail with anything useful: each dies on a FileNotFoundError
    # from its own copytree, in whatever order the tier runs them, and the
    # summary at the end counts a suite that never ran. Asked once here, the
    # answer is one sentence naming the missing directory and a nonzero exit,
    # with no partial tally to read as a result. Not before --list, which
    # reads the registry and needs no fixtures.
    corpus = Path(__file__).resolve().parent / "test" / "corpus"
    if not corpus.is_dir():
        warn(f"no selftest corpus at {corpus}; the suite needs it beside "
             f"{TOOL} and cannot run a single check without it")
        return 2

    # The root's name is one letter and mkdtemp's eight characters, with no
    # pid in it: every socket path a fixture probes is this root and a name, a
    # share's root sits two levels inside its parent's room, and inside a
    # share the fault fixture splits once more. With a pid in each name the
    # suite's longest socket name does not fit in 108 bytes at that depth.
    # Which run made the root is written inside it instead, for a root a
    # killed run leaves behind. Whether the longest name fits is asked once,
    # before anything is made, of the deepest socket root the run will make,
    # since a root that fits here can still be too long two levels down.
    too_long = socket_room_fault(deepest_socket_root(tempfile.gettempdir(), live, jobs, share))
    if too_long:
        warn(f"{too_long}. That is the deepest socket root this run makes, mkdtemp's "
             "characters shown as x; run the suite with a shorter TMPDIR")
        return 2
    # Everything below changes this process, and the finally undoes each change
    # this call made, whatever ends the run. SIGTERM raises Terminated from here
    # on, before the first change, so a run sent it while it is still setting up
    # unwinds through the same finally.
    restore_sigterm = raise_on_sigterm()
    # The outermost run_selftest call in a process owns the run's cleanup: it
    # makes the process adopt orphans, ends and names what is left, and puts
    # the setting back. A call made while it is in progress, as a unit's
    # fixture makes one, does none of the three. Which call is the outermost is
    # this record, set by that call for its length; the subreaper setting reads
    # the same in both where the kernel offers none.
    outermost = SELFTEST_IN_PROGRESS["call"] is None
    was_fence, was_handed = PROCESS_FENCE, os.environ.get(FENCE_UNIT_VAR)
    was_record = os.environ.get(FENCE_RECORD_VAR)
    was_tmpdir, was_path = os.environ.get("TMUX_TMPDIR"), os.environ.get("PATH")
    probe_socket = Resolver._socket_alive
    record_room = sockets = canary = adopted = None
    try:
        if outermost:
            SELFTEST_IN_PROGRESS["call"] = object()
        # This run's fence, rooted at this process whatever a unit that
        # started it handed down, so the units it runs read the processes
        # under it (_ProcessFence). Its refusals go to the record an audit
        # named, or else to a file of this run's own, where the tool runs its
        # units start write theirs too, and TIER_PROCS reads them back.
        os.environ.pop(FENCE_UNIT_VAR, None)
        fence = install_process_fence(_ProcessFence(was_record or None))
        if fence.record is None:
            record_room = owned_directory("f")
            fence.record = str(record_room / "refused.jsonl")
            os.environ[FENCE_RECORD_VAR] = fence.record
        # Every socket question in a run lands where TMUX_TMPDIR points: the
        # engine's directory answer, anything the suite starts that inherits
        # this environment, and the leak check in started_here. Pointed at an
        # empty directory nothing else writes to, every socket in it is one
        # this run made. Put back exactly, including having been unset.
        sockets = owned_directory("s")
        os.environ["TMUX_TMPDIR"] = str(sockets)

        # A tmux of this run's own, first on PATH, that records what it is
        # asked and fails. Every unit and every process they start inherits
        # it, so what it wrote down at the end is the whole tier's answer
        # rather than a sample of it, and a check that reached production tmux
        # is caught here even if it swallowed the failure this returns. Nested
        # runs, a worker or the read-only child, make their own and report
        # their own, which is what puts a recording next to the units that
        # caused it.
        canary = Path(tempfile.mkdtemp(prefix=own(f"{TOOL}-selftest-pathcanary")))
        asked_for = canary / "asked"
        decoy = canary / "tmux"
        decoy.write_text("#!/bin/sh\n"
                         f'printf "%s\\n" "$*" >> {asked_for}\n'
                         "exit 1\n")
        decoy.chmod(0o755)
        # A claude of this run's own beside it, for the same reason: a unit, or
        # a tool run one starts, that launches an agent reaches this instead of
        # the claude on the machine, and what it wrote down is the tier's
        # answer.
        claude_asked = canary / "claude-asked"
        claude_decoy = canary / "claude"
        claude_decoy.write_text("#!/bin/sh\n"
                                f'printf "%s\\n" "$*" >> {claude_asked}\n'
                                "exit 1\n")
        claude_decoy.chmod(0o755)
        os.environ["PATH"] = (f"{canary}{os.pathsep}{was_path}" if was_path
                              else str(canary))

        def recorded():
            return asked_for.read_text().splitlines() if asked_for.exists() else []

        def claude_recorded():
            return claude_asked.read_text().splitlines() if claude_asked.exists() else []

        # Everything this run starts stays under it, however the processes in
        # between end: the outermost call makes this process the subreaper of
        # what is under it, and finish_run ends what is still running when the
        # run finishes. A share is a run of its own too, and what a share
        # leaves when it dies is adopted by its parent.
        if outermost:
            adopted = adopt_orphans()

        # Fired on purpose before anything runs, so an empty recording at the
        # end is evidence and not an absence of wiring. By the path the lookup
        # returned, since naming tmux as a program to run is what this bans.
        resolved = shutil.which("tmux")
        if resolved:
            subprocess.run([resolved, "-V"], capture_output=True)
        control = recorded()
        asked_for.unlink(missing_ok=True)
        claude_resolved = shutil.which("claude")
        if claude_resolved:
            subprocess.run([claude_resolved, "--version"], capture_output=True)
        claude_control = claude_recorded()
        claude_asked.unlink(missing_ok=True)

        # Every socket name a check asks the probe about, recorded for the
        # whole run on the class every engine is an instance of, and put back
        # after. Asked once on purpose before anything runs, so a recording
        # that holds every other name is evidence and not an absence of wiring.
        asked_sockets = []

        def recorded_socket_alive(self, socket):
            asked_sockets.append(socket.name if isinstance(socket, Path) else str(socket))
            return probe_socket(self, socket)

        Resolver._socket_alive = recorded_socket_alive
        socket_control = f"{SOCKET_PREFIX}recorder-armed"
        Resolver(needs=Needs(maybe=set(NEED)))._socket_alive(socket_control)

        def register_sockets_row(register, tier):
            """The tier's verdict on the socket names its checks asked about."""
            names = sorted(set(asked_sockets) - {socket_control},
                           key=lambda name: len(os.fsencode(name)))
            longest = len(os.fsencode(names[-1])) if names else 0
            armed = socket_control in asked_sockets
            register(*TIER_SOCKETS[tier], armed and longest <= SOCKET_NAME_ROOM,
                     (f"{len(names)} name(s) asked, the longest {names[-1]!r} at {longest} of "
                      f"{SOCKET_NAME_ROOM} bytes" if names else "no check asked about a socket")
                     if armed else
                     "the recording was not armed: a deliberate probe was not recorded")

        def register_tmux_row(register, tier):
            """The tier's verdict on the decoy, stated before PATH goes back."""
            asked = recorded()
            armed = resolved == str(decoy) and control == ["-V"]
            register(*TIER_TMUX[tier], armed and not asked,
                     f"{len(asked)} call(s): {asked[:3]}" if asked else
                     "" if armed else
                     f"the decoy was not armed: tmux resolved to {resolved}, "
                     f"a deliberate call recorded {control}")

        def register_claude_row(register, tier):
            """The tier's verdict on the claude decoy, stated before PATH goes back."""
            asked = claude_recorded()
            armed = claude_resolved == str(claude_decoy) and claude_control == ["--version"]
            register(*TIER_CLAUDE[tier], armed and not asked,
                     f"{len(asked)} call(s): {asked[:3]}" if asked else
                     "" if armed else
                     f"the decoy was not armed: claude resolved to {claude_resolved}, "
                     f"a deliberate call recorded {claude_control}")

        def adoption_said():
            """What is wrong with this run's adoption, as sentences, from an orphan made before its first unit and one made now."""
            said = []
            for when, (taken, pid, ended) in (("before the first unit", adopted_before),
                                              ("after the last unit", orphan_adopted())):
                if not taken:
                    said.append(f"the orphan made {when} was not this run's"
                                + (f" (pid {pid})" if pid else ", and never said its pid"))
                if not ended:
                    said.append(f"the orphan made {when} had not ended 10 seconds after "
                                "its line was closed")
            if outermost and adopted is None:
                said.insert(0, "adopt_orphans could not make this process a subreaper")
            return said

        def register_adoption_row(register, tier):
            """The tier's verdict on adoption, from adoption_said."""
            said = adoption_said()
            register(*TIER_ADOPTS[tier], not said, "; ".join(said))

        def left_running():
            """What this run's units left running, as sentences.

            finish_run's result for the outermost call; for a nested call, what
            appeared under this process after it began and still runs, which the
            outermost call ends.
            """
            if outermost:
                ended, left, refused = finish_run(diagnostics)
                return ([f"ended {', '.join(map(str, ended))}"] if ended else []) \
                    + ([f"could not end {', '.join(map(str, left))}"] if left else []) \
                    + refused
            left = sorted(pid for pid, identity in _ProcessFence.run_processes().items()
                          if (pid, identity[2]) not in running_before)
            return ([f"still running, for the run this one is inside to end: "
                     f"{', '.join(map(str, left))}"] if left else [])

        def register_left_row(register, tier):
            """The tier's verdict on what its units left running, stated after the adoption row."""
            said = left_running()
            register(*TIER_LEFT[tier], not said, "; ".join(said))

        def settle():
            """What the merging run of a split live tier found about itself, by summary row id."""
            adoption = adoption_said()
            left = left_running()
            refused = refusal_lines(fence.refusals_in_run(), fence.root)
            return {TIER_ADOPTS[True][0]: [f"the merging run: {line}" for line in adoption],
                    TIER_LEFT[True][0]: [f"the merging run: {line}" for line in left],
                    TIER_PROCS[True][0]: [f"the merging run: {line}" for line in refused]}

        # What runs under this process as a nested call begins: it names only
        # what started after that.
        running_before = ({(pid, identity[2])
                           for pid, identity in _ProcessFence.run_processes().items()}
                          if not outermost else set())
        # The first orphan made on purpose, before any unit.
        adopted_before = orphan_adopted()
        share_faults = ()
        if live:
            # live_checks runs the read-only tier as a child, to read its stderr
            # and to take its verdicts. Running it here as well would answer
            # every read-only question twice in one invocation, which is what it
            # did. Both streams are captured: a fixture launch can write what it
            # ran or warned about between the verdicts, and inside --list where
            # every line is read as an id. Captured rather than silenced, so the
            # check below can say the tier was noisy instead of the output
            # merely vanishing.
            said = io.StringIO()
            with capturing("out", into=said), capturing("err", into=said):
                if jobs > 1:
                    results, register, share_faults = _live_in_parallel(jobs, diagnostics,
                                                                         settle)
                else:
                    results, register = live_checks(share, child, diagnostics)
            loud = [line for line in said.getvalue().splitlines() if line.strip()]
            # The mid-run row keeps a count and the first line, so the text
            # itself goes to the operator whole.
            if loud:
                write_diagnostic("the live tier wrote between its verdicts:\n"
                                 + said.getvalue().rstrip(), diagnostics)
            # A split run's shares watched their own units print and each ran
            # under its own decoy, and _live_in_parallel has folded what each of
            # them saw into one row each. Nothing ran under this process's
            # decoy, so it states neither row itself.
            if jobs == 1:
                register(RUNNER_CHECKS[0][0], RUNNER_CHECKS[0][1], not loud,
                         f"{len(loud)} line(s), first: {loud[0].strip()[:60]!r}"
                         if loud else "")
                register_tmux_row(register, True)
                register_sockets_row(register, True)
                register_claude_row(register, True)
                register_adoption_row(register, True)
                register_left_row(register, True)
                register_procs_row(register, True, fence)
        else:
            s = _suite_context()
            results, register = check_rows()
            tier_rows([entry for entry in UNITS if not entry[3]], s, register, False, diagnostics)
            register_tmux_row(register, False)
            register_sockets_row(register, False)
            register_claude_row(register, False)
            register_adoption_row(register, False)
            register_left_row(register, False)
            register_procs_row(register, False, fence)
        register_closing_rows(register, results, live,
                              None if share else selftest_catalog(live, jobs), share_faults)
        return _selftest_report(results, failed_only)
    except Terminated as stopped:
        # Every owned_group and finally between the signal and here has run;
        # whatever is still under this run is ended below.
        write_diagnostic(f"the run was {stopped} and stopped, ending what it had started",
                         diagnostics)
        return 143
    finally:
        restore_sigterm()
        Resolver._socket_alive = probe_socket
        if outermost:
            finish_run(diagnostics)
            if adopted is not None:
                adopt_orphans(adopted)
        if was_tmpdir is None:
            os.environ.pop("TMUX_TMPDIR", None)
        else:
            os.environ["TMUX_TMPDIR"] = was_tmpdir
        if was_path is None:
            os.environ.pop("PATH", None)
        else:
            os.environ["PATH"] = was_path
        for made in (sockets, canary, record_room):
            if made is not None:
                shutil.rmtree(made, ignore_errors=True)
        if was_record is None:
            os.environ.pop(FENCE_RECORD_VAR, None)
        else:
            os.environ[FENCE_RECORD_VAR] = was_record
        globals()["PROCESS_FENCE"] = was_fence
        if was_handed is None:
            os.environ.pop(FENCE_UNIT_VAR, None)
        else:
            os.environ[FENCE_UNIT_VAR] = was_handed
        if outermost:
            SELFTEST_IN_PROGRESS["call"] = None


def completion_needs(topic):
    """Corpus work one completion topic may perform.

    Dynamic topics include the selected object after a colon. Ordinary selector
    completion deliberately excludes the conversion census: listing names,
    teams and leads must not search every main transcript for receipt-only
    members. The explicit demotion-parent topic may do that work because current
    team sessions are the value it was asked to list.
    """
    kind, _subject = completion_request(topic)
    table = {
        "flags": Needs(),
        "sockets": Needs(),
        "sessions": Needs(maybe={NEED.TITLES}),
        "sides": Needs(hard={NEED.SIDES}),
        "agent-ids": Needs(maybe={NEED.SPAWNS, NEED.CONVERSION_CENSUS}),
        "names": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                              NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "teams": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                              NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "leads": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                              NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "selector": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                                 NEED.TITLES, NEED.CONVERSION_CENSUS}),
        "as-agent-name": Needs(hard={NEED.SIDES}),
        "as-agent": Needs(maybe={NEED.SIDES, NEED.PROCS, NEED.REGISTRY,
                                  NEED.STAMPS, NEED.SPAWNS, NEED.TITLES,
                                  NEED.CONVERSION_CENSUS}),
        "into-session": Needs(maybe={NEED.PROCS, NEED.REGISTRY, NEED.STAMPS,
                                     NEED.SPAWNS, NEED.TITLES,
                                     NEED.CONVERSION_CENSUS}),
    }
    return table.get(kind, Needs())


def verb_needs(args, selector):
    """What each verb declares to the engine, mirroring main's dispatch.

    Hard where the verb's fixed path always computes it, conditional where
    a branch or the corpus decides. The end-of-run audit refuses a hard need
    nobody exercised, so nothing survives here just in case; the maps are
    tightened by running the verbs, not by guessing.
    """
    if args.complete:
        return completion_needs(args.complete)
    if args.selftest or args.cleanup:
        # the suite exercises by fixture; cleanup runs from the startup hook,
        # where a refused compute would fail silently behind its own output
        # redirection
        return Needs(maybe=set(NEED))
    if args.doctor:
        # A direct target prints member dossiers and therefore joins mail for
        # each one. The empty-hand sweep reads mailbox counts without that join.
        hard = {NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                NEED.STAMPS, NEED.SPAWNS, NEED.CONVERSION_CENSUS}
        maybe = {NEED.TITLES}
        if selector or args.agent_id or args.resume or args.team:
            hard.add(NEED.MAIL)
        else:
            maybe.add(NEED.MAIL)
        return Needs(hard=hard, maybe=maybe)
    if args.census:
        # the process table only where a count is about live agents
        return Needs(hard={NEED.STAMPS, NEED.SPAWNS, NEED.CONVERSION_CENSUS},
                     maybe={NEED.PROCS, NEED.REGISTRY, NEED.SEATS})
    if args.sides:
        # titles only when a listing has a session to title
        return Needs(hard={NEED.SIDES}, maybe={NEED.TITLES})
    if args.promote:
        # a promote resolves an identity only once it has one to place
        return Needs(hard={NEED.SIDES},
                     maybe={NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                            NEED.STAMPS, NEED.SPAWNS, NEED.TITLES,
                            NEED.CONVERSION_CENSUS})
    if args.demote:
        # Stamps and spawn payloads are consulted only when no receipt or
        # carried record says which parent the transcript came from.
        return Needs(hard={NEED.PROCS},
                     maybe={NEED.SIDES, NEED.STAMPS, NEED.SPAWNS,
                            NEED.CONVERSION_CENSUS})
    if args.mail_ledger:
        # liveness only for the rows a live holder would explain
        return Needs(hard={NEED.STAMPS, NEED.MAIL, NEED.CONVERSION_CENSUS},
                     maybe={NEED.PROCS, NEED.SPAWNS})
    if args.install or args.poison or args.unpoison:
        return Needs()
    if not (selector or args.agent_id or args.resume or args.team):
        return Needs()  # the help gate answers this run
    if args.stop:
        # the stamps only when a bare selector has to be found through them,
        # payloads only when a target has to be found by parentage; pointed at
        # --agent-id, --team or --resume a stop asks neither
        return Needs(hard={NEED.PROCS},
                     maybe={NEED.REGISTRY, NEED.STAMPS, NEED.SPAWNS,
                            NEED.TITLES, NEED.CONVERSION_CENSUS})
    common_needs = {NEED.PROCS, NEED.REGISTRY, NEED.SEATS,
                    NEED.SPAWNS, NEED.CONVERSION_CENSUS}
    target_needs = {NEED.TITLES, NEED.PLACEMENT}

    # The input decides which resolution rungs can run. A UUID resolves from
    # the filename without the stamp index. Once identity is known, live-runtime
    # mapping for a promoted lead may enumerate known teams and read that index.
    # A bare name or team always uses stamps. An agent ID reaches them only when
    # no live process already states that identity.
    by_uuid = bool(args.resume) or bool(selector and UUID_RE.match(selector))
    if (args.agent_id or (selector and "@" in selector)
            or (by_uuid and not args.team)):
        # Exact agent and session inputs always resolve one launch target. Their
        # stamp lookup remains conditional on runtime mapping.
        return Needs(hard=common_needs | target_needs,
                     maybe={NEED.STAMPS})

    # An explicit team or a bare selector can reach the team runner. --no-lead
    # can leave a valid team run with only a skipped lead. The team plan still
    # runs, while titles and launch placement require another selected member.
    conditional_target_needs = (
        target_needs if getattr(args, "no_lead", False) else set())
    return Needs(
        hard=common_needs | {NEED.STAMPS}
        | (target_needs - conditional_target_needs),
        maybe=conditional_target_needs)


def audited(entry):
    """Run the verb, then let the engine refuse a fat declaration.

    Only a completed verb is audited: a refusal mid-run proves nothing
    about what the whole verb would have used, and an exec never returns.

    That holds because nothing on the way out swallows a refusal: die() raises,
    the raise passes through here, and the audit below is never reached. The
    one place that catches one, run_one, hands it back to run_agents, which
    reports every member it managed and then ends the run in that refusal.
    """
    code = entry()
    audit = RESOLVER.audit_answer()
    if audit["missing"]:
        named = ", ".join(audit["missing"])
        computed = ", ".join(audit["exercised"]) or "nothing"
        raise RuntimeError(
            f"declared and never computed: {named}; this run computed {computed}. "
            "Read this verb's paths, work out which declarations they reach, and "
            "declare what they do.")
    if audit["unexpected"]:
        raise RuntimeError(
            "computed undeclared evidence: " + ", ".join(audit["unexpected"]))
    return code


def offers(action, row, completes=None):
    """What a completion needs about a flag and argparse has nowhere to hold.

    Two registers of prose, on purpose. help= is the help page, where a flag has
    room for a sentence. row= is the single line the completion menu gives it,
    where it has room for a phrase. --dry-run is "say what would happen and do
    none of it: nothing is launched, written or ended" on the page and "preview
    without launching" in the menu, and neither is a truncation of the other.

    row= is not optional and has no default. Falling back to the help would mean
    a flag added later put whatever its help page says into the menu because
    nobody chose, which is how a menu fills up with sentences nobody can scan.
    every-flag-declares-a-menu-row makes the omission a failed check rather than
    a listing that has quietly grown a paragraph in it.

    completes= names the emitter topic that fills the flag's value. Whether a
    flag takes a value at all argparse already knows, so that is read off the
    action rather than repeated here.
    """
    action.menu_row = row
    action.completer = completes
    return action


def build_parser():
    """Every flag this tool takes, declared once, in the groups it prints them in.

    Lifted out of main so the completion emitter can run the real parser instead
    of scraping this file for add_argument calls. Two flags interpolate a
    constant into their help, and a reader of the syntax tree sees an unresolved
    f-string exactly where the person at the prompt needs the resolved sentence.
    """
    parser = argparse.ArgumentParser(
        prog=TOOL, allow_abbrev=False, add_help=False,
        formatter_class=HelpLayout,
        # The generated usage was nine lines of forty-six flags in declaration
        # order, which said nothing a reader could act on. This is the one
        # spelling of how the tool is called; the groups below say the rest.
        usage=f"{TOOL} [<selector>] [options] [-- ...forwarded to claude]",
        description=SELECTOR_HELP,
    )
    # Grouped in the order a reader wants them: who comes back, the subordinate
    # placement choices, what to do instead of resuming it, what to check before
    # it acts, what it prints, the tmux server, and last the four that do nothing
    # without --selftest. In declaration order those four sat between --bare
    # and --all, where nothing said they were unusable on their own.
    picking = parser.add_argument_group("selecting who comes back")
    placing = parser.add_argument_group("where and as what it comes up")
    verbs = parser.add_argument_group("instead of resuming it")
    careful = parser.add_argument_group("before it acts")
    saying = parser.add_argument_group("what it prints")
    swarm = parser.add_argument_group("the swarm tmux server")
    suite = parser.add_argument_group("with --selftest only")
    offers(picking.add_argument("--agent-id", help="resume this agent (by its full id, name@team)"),
           completes='agent-ids',
           row='resume this agent by its full id, name@team')
    offers(picking.add_argument("--resume", metavar="SESSION_UUID",
                                help="resume this session transcript (by uuid)"),
           completes='sessions',
           row='resume this session transcript by uuid')
    offers(picking.add_argument("--team", metavar="TEAM",
                                help="resume this whole team by name: the members, then the lead"),
           completes='teams',
           row='resume a whole team: its members, then its lead')
    offers(picking.add_argument("--all", dest="all_members", action="store_true",
                                help="with a team, also resume members the roster no longer lists "
                                     "when their transcripts are stamped with it"),
           row='with a team, also resume members the roster no longer lists')
    offers(picking.add_argument("--no-lead", action="store_true",
                                help="skip the lead when bringing up the whole team"),
           row='with --team, leave the lead down')
    offers(verbs.add_argument("--doctor", action="store_true",
                              help="diagnose a team and its agents; with no selector, summarize "
                                   "every team that has something live or waiting"),
           row="diagnose a team and its agents, or summarize all active teams")
    offers(verbs.add_argument("--census", action="store_true",
                              help="count what this machine's ~/.claude contains, through the "
                                   "same readers the tool resolves with"),
           row="count what ~/.claude contains, through the tool's own readers")
    offers(verbs.add_argument("--sides", action="store_true",
                              help="list side transcripts (subagent conversations), each "
                                   "classified by its own bytes; reports only"),
           row='list subagent side transcripts, each classified; reports only')
    offers(verbs.add_argument("--mail-ledger", action="store_true",
                              help="join a team's sends against its deliveries: "
                                   "delivered, queued, pending, or unexplained"),
           row="join a team's sends against its deliveries")
    offers(verbs.add_argument("--stop", "--terminate", action="store_true", dest="stop",
                              help="stop the agent, session or team instead of resuming it"),
           row='stop what was named instead of resuming it')
    offers(verbs.add_argument("--promote", metavar="SIDE",
                              help="convert a side transcript into a resumable teammate "
                                   "(moves it; its in-file receipt holds the way back)"),
           row='convert a subagent side transcript into a resumable teammate', completes='sides')
    # dest pinned here and on --into-session and --into-team: the option string
    # is what a person types, the attribute is what the rest of the file reads,
    # and renaming one must not rename the other. as_ started out as a way
    # around "as" being a Python keyword; --as-agent would derive a usable
    # as_agent, so the explicit dest is now only here to keep args.as_ the same
    # while the option string changes.
    offers(verbs.add_argument("--as-agent", dest="as_", metavar="NAME@TEAM",
                              help="override the name and/or deduced parent team a promoted "
                                   "teammate joins as"),
           completes='_agent_resume_as_agent',
           row='with --promote, override the deduced identity (name@team)')
    offers(verbs.add_argument("--unwrap", action="store_true",
                              help="with --promote, show historical human messages as their "
                                   "inner text instead of keeping Claude Code's wrapper"),
           row='with --promote, show historical human messages without their wrapper')
    offers(verbs.add_argument("--no-launch", action="store_true",
                              help="promote writes files and prints the launch line "
                                   "instead of launching"),
           row='with --promote, write the files and print the launch line')
    offers(verbs.add_argument("--demote", metavar="SESSION",
                              help="convert a teammate transcript back into a side "
                                   "transcript under its parent's subagents/"),
           row='convert a teammate transcript back into a side transcript', completes='sessions')
    offers(verbs.add_argument("--into-session", dest="into", metavar="SESSION",
                              help="override the promotion receipt's parent session for a demote"),
           completes='_agent_resume_into_session',
           row="with --demote, override the promotion receipt's parent session")
    offers(verbs.add_argument("--with-mail", action="store_true",
                              help="demote preserves unread inbox mail in a separate archive "
                                   "instead of refusing"),
           row='preserve unread inbox mail in a separate archive instead of refusing')
    offers(verbs.add_argument("--cleanup", "--cleanup-sockets", dest="cleanup", action="store_true",
                              help="clean up dead swarm tmux sockets and team dirs with nothing "
                                   "left to resume; the installed Claude Code startup hook runs this"),
           row='remove dead swarm sockets and teams with nothing left to resume')
    offers(verbs.add_argument("--install", action="store_true",
                              help="symlink into ~/.local/bin, install zsh tab completion, and "
                                   "add the Claude Code startup hook that runs --cleanup"),
