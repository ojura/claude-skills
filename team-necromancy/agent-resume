       "an owner record names the pid, start time and command of the run that wrote it, and "
       "the functions that make the run's socket root and its shares' room each write one"))
def _check_run_directories_record_their_owner(s):
    """The owner record, read back from directories its maker makes and from this run's socket root.

    owned_directory makes a directory here, and the record in it is read back
    against this process. The socket root of the run executing this unit is
    read too: TMUX_TMPDIR names it for the whole run, so its record has to name
    this process as well. The shares' room is made by the same maker, which is
    read from _live_in_parallel, since making it for real means running a split
    live tier.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    engine = Resolver(needs=Needs(maybe=set(NEED)))
    me = {"pid": os.getpid(), "started": engine._proc_start(os.getpid()),
          "command": list(sys.argv)}

    def record_in(directory):
        try:
            return json.loads((Path(directory) / "owner").read_text())
        except (OSError, ValueError):
            return None

    where = owned_directory("w")
    try:
        made = record_in(where)
    finally:
        shutil.rmtree(where, ignore_errors=True)
    root = os.environ.get("TMUX_TMPDIR")
    rooted = record_in(root) if root else None

    def made_by_the_maker(named, prefix):
        """named gets its directory of this kind from owned_directory and makes none itself."""
        calls = [node for node in ast.walk(s.funcs[named]) if isinstance(node, ast.Call)]
        own_mkdtemp = any(
            getattr(node.func, "attr", None) == "mkdtemp"
            and any(keyword.arg == "prefix" and getattr(keyword.value, "value", None) == prefix
                    for keyword in node.keywords)
            for node in calls)
        return not own_mkdtemp and any(
            getattr(node.func, "id", None) == "owned_directory" and node.args
            and getattr(node.args[0], "value", None) == prefix for node in calls)

    claims = {
        "a directory the maker made holds a record naming this process":
            made == me and bool(me["started"]),
        "this run's socket root holds a record naming this run": rooted == me,
        "the socket root comes from the maker that writes the record":
            made_by_the_maker("run_selftest", "s"),
        "the shares' room comes from the maker that writes the record":
            made_by_the_maker("_live_in_parallel", "w"),
    }
    wrong = sorted(claim for claim, ok in claims.items() if not ok)
    check("run-directories-record-their-owner",
          "an owner record names the pid, start time and command of the run that wrote it, "
          "and the functions that make the run's socket root and its shares' room each write "
          "one",
          not wrong, ", ".join(wrong) + (f"; made {made}, socket root {rooted}" if wrong else ""))
    return checked


