    ('membership-backup-history-is-retained', 'the first write replaces an older backup and later writes preserve it'),
    ('membership-cross-team-modes-are-distinct', 'a move preserves each roster mode and backup independently'),
    ('membership-refuses-mode-before-effects', 'initial mode-only changes refuse every selected roster before effects'),
    ('membership-refuses-mode-under-lock', 'mode changes during lock acquisition refuse and release the owned lock'),
)
def _check_membership_selected_writes(s):
    from unittest import mock
    checked, write_faults, backup_faults, cross_faults, initial_faults, lock_faults = [], [], [], [], [], []

    def setup(f, cross=False):
        f.transcript("membership-member", "member", "A")
        source = f.config("A", {"name": "A", "leadAgentId": "team-lead@A", "members":
            [{"name": "member", "agentId": "member@A", "isActive": True}] if cross else []}, 0o640)
        if cross:
            f.transcript("membership-lead", "team-lead", "B")
            f.config("B", {"name": "B", "leadAgentId": "team-lead@B",
                           "leadSessionId": "membership-lead", "members": []}, 0o604)
        with capturing("err"):
            launch = f.engine.launch_plan(agent_id="member@A", table=())
            if cross:
                redirect = f.engine.member_redirect_plan(launch, MemberRedirectRequest("explicit", "B", force=True))
                launch = redirect["redirected_launch"]
        return launch, source

    def apply_exact(plan):
        real_dumps = json.dumps

        def dumps(value, *args, **kwargs):
            if isinstance(value, Mapping) and "members" in value:
                raise AssertionError("roster serialized after selection")
            return real_dumps(value, *args, **kwargs)

        writes = tuple(immutable({**write, "bytes": b' \n' + write["bytes"] + b'\n '}) for write in plan["writes"])
        selected = immutable({**plan, "writes": writes})
        previous_umask = os.umask(0o077)
        error = None
        try:
            with mock.patch.object(json, "dumps", dumps), capturing("out"), capturing("err"):
                result = apply_membership(selected)
        except (AssertionError, Refusal, OSError) as exc:
            error = exc
            result = selected["claim"] if selected["operation"] == "reserve" else selected["rollback"]
        finally:
            os.umask(previous_umask)
        correct = error is None and bool(writes) and all(write["path"].read_bytes() == write["bytes"]
                    and write["path"].stat().st_mode & 0o777 == write["mode"]
                    and not write["lock"].exists() for write in writes)
        return selected, result, correct

    with _roster_test_fixture() as f:
        launch, cfg = setup(f)
        original = f.engine._file_observation(cfg)
        backup = cfg.with_suffix(f".json.bak-{TOOL}")
        backup.write_bytes(b'older invocation')
        backup.chmod(0o600)
        reserve = f.engine.membership_plan(launch, "reserve", backed_up=frozenset(_BACKED_UP))
        reserved, claim, okay = apply_exact(reserve)
        if not okay or claim is not reserve["claim"]:
            write_faults.append("reserve")
        captured_backup = f.engine._file_observation(backup)
        if captured_backup.raw != original.raw or captured_backup.mode != original.mode or cfg not in _BACKED_UP:
            backup_faults.append("first backup")
        release = f.engine.membership_plan(launch, "release", claim=claim, backed_up=frozenset(_BACKED_UP))
        released, result, okay = apply_exact(release)
        if not okay or result is not release["rollback"] or any(w["backup"] for w in released["writes"]):
            write_faults.append("release")
        record = f.engine.membership_plan(launch, "record", pane="%1", backed_up=frozenset(_BACKED_UP))
        recorded, undo, okay = apply_exact(record)
        if not okay or undo is not record["rollback"]:
            write_faults.append("record")
        restore = f.engine.membership_plan(launch, "restore", undo=undo, backed_up=frozenset(_BACKED_UP))
        restored, result, okay = apply_exact(restore)
        if not okay or result is not restore["rollback"]:
            write_faults.append("restore")
        if f.engine._file_observation(backup) != captured_backup or any(w["backup"] for p in (released, recorded, restored) for w in p["writes"]):
            backup_faults.append("later writes changed backup")
        if any('.tmp' in p.name or '.lock' in p.name for p in cfg.parent.iterdir()):
            write_faults.append("temporary file or lock remains")
    with _roster_test_fixture() as f:
        launch, source = setup(f, cross=True)
        plan = f.engine.membership_plan(launch, "record", pane="%2")
        selected, undo, okay = apply_exact(plan)
        if not okay or len(selected["writes"]) != 2 or {w["mode"] for w in selected["writes"]} != {0o640, 0o604}:
            cross_faults.append("distinct selected modes")
        for write in selected["writes"]:
            backup = write["backup"]
            if (not backup["path"].exists() or backup["path"].read_bytes() != write["original"].raw
                    or backup["path"].stat().st_mode & 0o777 != write["mode"]):
                cross_faults.append(write["team"])
        if json.loads(source.read_text())["members"][0]["isActive"]:
            cross_faults.append("source remains active")
    for under_lock in (False, True):
        for selected_index in (0, 1):
            faults = lock_faults if under_lock else initial_faults
            with _roster_test_fixture() as f:
                launch, _source = setup(f, cross=True)
                inbox = f.engine._roster_path("B").parent / "inboxes" / "member.json"
                inbox.parent.mkdir(parents=True)
                inbox.write_bytes(b'[]')
                plan = f.engine.membership_plan(launch, "record", pane="%2")
                write = plan["writes"][selected_index]
                before = f.engine._file_observation(write["path"])
                real_lock = team_lock

                @contextlib.contextmanager
                def changed_lock(selected, current, **kwargs):
                    with real_lock(selected, current, **kwargs):
                        if current is write:
                            current["path"].chmod(0o600)
                        yield

                if not under_lock:
                    write["path"].chmod(0o600)
                with mock.patch.dict(globals(), team_lock=changed_lock if under_lock else real_lock):
                    try:
                        with capturing("out"), capturing("err"):
                            apply_membership(plan)
                        refused = False
                    except Refusal:
                        refused = True
                after = f.engine._file_observation(write["path"])
                okay = (refused and before.generation == after.generation and before.mode != after.mode
                        and not write["lock"].exists() and not write["backup"]["path"].exists())
                if not under_lock:
                    okay = okay and all(w["path"].read_bytes() == w["original"].raw and not w["backup"]["path"].exists()
                                         for w in plan["writes"])
                if under_lock and selected_index == 1:
                    # The first write is intentionally not rolled back by a late refusal.
                    earlier = plan["writes"][0]
                    okay = okay and earlier["path"].read_bytes() == earlier["bytes"]
                if not okay:
                    faults.append(f"index={selected_index}, refused={refused}, after={after}")
    for cid, faults in (("membership-all-writes-keep-selected-mode", write_faults),
                        ("membership-backup-history-is-retained", backup_faults),
                        ("membership-cross-team-modes-are-distinct", cross_faults),
                        ("membership-refuses-mode-before-effects", initial_faults),
                        ("membership-refuses-mode-under-lock", lock_faults)):
        checked.append(_check_verdict(cid, not faults, '; '.join(faults)))
    return checked


def _restamp_test_plan(f, lead=False, reap=False, alias=False):
    """Select a real migration with one stamped window start and an inactive row."""
    name = "team-lead" if lead else "mover"
    path = f.transcript("moving", name, "A", (
        {"type": "last-prompt", "leafUuid": "moving-root", "sessionId": "moving"},))
    os.utime(path, ns=(1000000000, 1000000000))
    f.transcript("destination-lead", "team-lead", "B")
    f.config("A", {"name": "A", "leadAgentId": "team-lead@A",
                   "leadSessionId": "moving" if lead else "missing-lead",
                   "members": [{"name": name, "agentId": agent_id_of(name, "A"), "isActive": False}]})
    f.config("B", {"name": "B", "leadAgentId": "team-lead@B", "leadSessionId": "destination-lead",
                   "members": [{"name": "team-lead", "agentId": "team-lead@B"}]})
    f.fake.processes = ([] if reap else [(PID_CEILING + 771234, 1, (FAKE_AGENT_BIN, "--agent-id", "keeper@A"))])
    eng = f.engine
    eng._pid_alive = lambda *_args: True
    eng._proc_stat = lambda _pid: ("S", 1, "stable-start")
    eng._own_lineage = lambda _table: set()
    census = eng._roster_census()
    if alias:
        duplicate = Resolver.RosterSnapshot.preview(f.root / "duplicate" / "config.json", {"name": "A"})
        census = eng._update_census(census, duplicate.path, duplicate)
    launch = eng.launch_plan(agent_id=agent_id_of(name, "A"), table=tuple(f.fake.processes),
                             census=census, terminal=TerminalContext())
    plan = (eng.lead_migration_plan(launch, LeadMigrationRequest("B", force=True)) if lead else
            eng.member_redirect_plan(launch, MemberRedirectRequest("explicit", "B", force=True)))
    return plan, path


def _roster_cold_engine(f):
    """Read the same synthetic world with empty caches."""
    eng = Resolver(needs=Needs(maybe=set(NEED)))
    eng._teams_dir, eng._projects_dir = f.engine._teams_dir, f.engine._projects_dir
    f.fake.attach(eng)
    eng._pid_alive = lambda *_args: True
    eng._proc_stat = lambda _pid: ("S", 1, "stable-start")
    eng._own_lineage = lambda _table: set()
    return eng


def _retained_transcript_answers(eng, path, table, census):
    """Warm the actual discovery readers with results a migration changes."""
    stamps = eng._stamp_index()
    assignments = eng._durable_assignment_index()
    fact = eng._transcript_fact(path.stem)
    members = {team: eng._team_members(team, table, census=census, enrich=True) for team in ("A", "B")}
    missing = [(team, member["name"]) for team, answer in members.items()
               for member in answer["members"] if member["resolution"] is None]
    if missing:
        raise AssertionError(f"enriched members have no Resolution: {missing}")
    descriptions = {team: eng._team_description(team, table, census=census) for team in ("A", "B")}
    return {"stamps": stamps, "assignments": assignments, "fact": fact,
            "members": members, "descriptions": descriptions}


