class NEED(enum.Enum):
    """The corpus-scale computes a run may ask the engine for, by name.

    Declared to the constructor, never passed to a method: a verb states up
    front what it consumes, the engine refuses to compute anything else, and
    the end-of-run audit refuses a declaration a smaller set would have
    satisfied. The default is nothing, so every caller must say what it needs.
    The values are the plain words the refusal prints.
    """
    PROCS = "the process table and normalized runtime"
    REGISTRY = "the session registry"
    SEATS = "live tmux process placement"
    STAMPS = "transcript identity stamps"
    SPAWNS = "the spawn payload corpus"
    SIDES = "side transcript classification"
    MAIL = "the send-vs-delivery mail join"
    TITLES = "transcript titles"
    CONVERSION_CENSUS = "the promoted-member conversion receipt corpus"


class DECLARED(enum.Enum):
    """How firmly a verb declared one need. Absence is an answer, not a gap."""
    HARD = "declared"            # always computed; unexercised is a fault
    MAYBE = "declared if used"   # a runtime branch decides; unexercised is fine
    ABSENT = "not declared"      # computing it at all is a fault


class Needs:
    """What one verb may compute, and how firmly it said so.

    A declaration is two buckets rather than a bag of mixed elements, so an
    author writing one has to place every need in exactly one of them. The
    conditional bucket is for a runtime branch (liveness, corpus content)
    deciding, never for an author who has not worked out what the input
    implies; each entry carries a comment naming what decides it.

    Asking is one operation, needs[X], which distinguishes all three states.
    A wrapper object could not: it carried no equality, so membership tests
    answered no both for a conditional declaration and for none at all, and
    a check written that way passed with its subject deleted.
    """

    def __init__(self, hard=(), maybe=()):
        self._hard = frozenset(hard)
        self._maybe = frozenset(maybe) - self._hard   # hard wins; nothing is both

    def __getitem__(self, need):
        if need in self._hard:
            return DECLARED.HARD
        if need in self._maybe:
            return DECLARED.MAYBE
        return DECLARED.ABSENT

    @property
    def hard(self):
        """The needs whose absence from a run is a fat declaration."""
        return self._hard

    @property
    def reachable(self):
        """Every need this run may compute, however firmly declared."""
        return self._hard | self._maybe

    def __eq__(self, other):
        return (isinstance(other, Needs)
                and (self._hard, self._maybe) == (other._hard, other._maybe))

    def __hash__(self):
        return hash((self._hard, self._maybe))

    def __repr__(self):
        return (f"Needs(hard={sorted(n.name for n in self._hard)}, "
                f"maybe={sorted(n.name for n in self._maybe)})")


# What a team directory holds that this tool or the harness wrote. One list,
# because two questions are asked of it and they must not drift: the sweep asks
# whether a directory holds anything else before removing it, and the reap asks
# which entries it may delete. A reap that recognised a name the sweep does not
# would delete a file the sweep was written to spare.
SCAFFOLDING = frozenset({
    "config.json",
    "inboxes",              # holding .json mailboxes and nothing else
    f"config.json.bak-{TOOL}",
    f"config.json.tmp-{TOOL}",
    "config.json.lock",
})


class Cache:
    """One of the engine's held answers, and its own entry in the list of them.

    The fence that keeps callers out of the engine's storage needs to know what
    that storage is called. Declaring a cache is what registers it here, so the
    list of names is the set of caches themselves and says exactly what the
    class holds.

    `empty` is what the cache holds before anything fills it, called per engine
    when it is a factory, so two engines never share one dict.
    """

    names = set()

    def __init__(self, empty=None):
        self.empty = empty

    def __set_name__(self, owner, name):
        self.name, self.slot = name, f"__cache_{name}"
        Cache.names.add(name)

    def __get__(self, engine, owner=None):
        if engine is None:
            return self
        if self.slot not in engine.__dict__:
            engine.__dict__[self.slot] = self.empty() if callable(self.empty) else self.empty
        return engine.__dict__[self.slot]

    def __set__(self, engine, value):
        engine.__dict__[self.slot] = value


class Resolver:
    """Own evidence reads, cache lifetime, and structured resolution answers.

    Each source has one lazy loader, making the complete evidence set enumerable.
    `refresh_procs` states the process-cache lifetime explicitly. Launch, tmux,
    roster, and cleanup actions consume Resolver answers through functions such
    as `roster_record`.

    `needs` declares corpus-scale computations at construction. Loaders accept
    declared work, and `audit_needs` requires every hard declaration to be used.
    Conditional work belongs in the Maybe bucket.
    """

    # Declared here rather than assigned in __init__, because declaring one is
    # what puts it in Cache.names, and that is what the fence reads.
    _procs = Cache()             # [(pid, ppid, args)], read from /proc
    _stamps = Cache()            # transcript stem -> (agentName, teamName)
    _carried = Cache()           # complete path -> receipt conversion census
    _receipts = Cache(dict)      # path -> its one parsed receipt or None
    _spawns = Cache(dict)        # transcript stem -> {name: last payload of that name}
    _spawn_log = Cache(dict)     # transcript stem -> [(stamp, payload)] in file order
    _by_agent = Cache()          # "name@team" -> payload, across every transcript
    _by_team = Cache()           # team -> [(stamp, path)] of transcripts that led it
    _seat_table = Cache()        # exact process-table object indexed by _seats
    _seats = Cache()             # pid -> (socket, pane) for _seat_table
    _runtime_table = Cache()     # exact process-table object indexed below
    _runtime_snapshot = Cache()  # canonical records and indexes for that table
    _registry = Cache()          # normalized session-registry observations
    _transcript_facts = Cache(dict)  # path -> immutable transcript fact
    _copied_prefixes = Cache(dict)   # path -> UUIDs copied from a promoted parent

    def __init__(self, needs=None):
        self.needs = needs if needs is not None else Needs()
        self.exercised = set()
        self.teams_dir = TEAMS_DIR   # overridable so a test resolver can read a synthetic tree
        self.projects_dir = PROJECTS_DIR  # same, for the transcript tree
        self.rewriter = TranscriptRewriter(self)

    def _exercise(self, need):
        """Record one declared compute happening, or refuse an undeclared one."""
        if self.needs[need] is DECLARED.ABSENT:
            raise RuntimeError(
                f"this run declared no need for {need.value}; the engine "
                f"computes only what its constructor was told, so declare "
                f"NEED.{need.name} where the verb states its needs, in the "
                f"maybe bucket if only some runs of that verb reach it")
        self.exercised.add(need)

    def audit_needs(self):
        """Require every hard computation declaration to be exercised.

        The verb calls this explicitly because Python discards exceptions raised
        by `__del__`. Conditional declarations may remain unused. The error lists
        declared and computed work so the caller can classify each path from the
        code.
        """
        fat = self.needs.hard - self.exercised
        if fat:
            named = ", ".join(sorted(n.name for n in fat))
            computed = ", ".join(sorted(n.name for n in self.exercised)) or "nothing"
            raise RuntimeError(
                f"declared and never computed: {named}; this run computed "
                f"{computed}. Read this verb's paths, work out which of them "
                f"reach {named}, and declare what they do.")

    def refresh_procs(self):
        self._procs = None
        self._seat_table = None
        self._seats = None
        self._runtime_table = None
        self._runtime_snapshot = None
        self._registry = None

    def _grep_files(self, needle, scope, recursive):
        """Files containing this literal."""
        result = self._search("files", needle, scope, recursive)
        if result.returncode > 1:
            warn(f"search failed ({result.stderr.strip() or 'unknown'}); falling back to a full scan")
            return None
        return [Path(p) for p in result.stdout.splitlines() if p]

    def _search(self, kind, needle, paths, recursive):
        """Run a literal search with command-owned options.

        Removing RIPGREP_CONFIG_PATH keeps user options such as
        `--max-filesize=1` and `--max-depth=0` from narrowing the transcript
        corpus. The grep fallback uses the same explicit search bounds.
        """
        env = {name: value for name, value in os.environ.items()
               if name != "RIPGREP_CONFIG_PATH"}
        return subprocess.run(self._searcher(kind, needle, paths, recursive),
                              capture_output=True, text=True, env=env)

    def _searcher(self, kind, needle, paths, recursive):
        """Build literal-search argv, preferring ripgrep for parallel traversal."""
        files = [str(p) for p in paths]
        # subagents/ holds sidechain transcripts, which are never evidence
        # candidates, so a recursive sweep does not descend into them.
        if shutil.which("rg"):
            argv = ["rg", "--no-ignore", "-F", needle]
            argv += ["-l"] if kind == "files" else ["-N", "-H"]
            if recursive:
                argv += ["--glob", "*.jsonl", "--glob", "!**/subagents/**"]
            return argv + files
        argv = ["grep", "-F", needle, "-l" if kind == "files" else "-H"]
        if recursive:
            argv += ["-r", "--include=*.jsonl", "--exclude-dir=subagents"]
        return argv + files

    def _stamped_candidates(self, name, team=None, verify=True):
        """Return newest transcripts whose current lines carry these stamps.

        The shared stamp index performs bounded end reads. Verification parses
        candidates because a rebound transcript can mention several teams.
        `verify=False` returns the indexed paths. An empty index result triggers a
        whole-file literal search to cover stamps located only in mid-history.
        """
        self._exercise(NEED.STAMPS)  # the grep fallback is stamps work too
        files = [p for p, (n, t) in self.stamp_index().items() if n == name and (not team or t == team)]

        if not verify:
            # The index is cached for the process, so a file may be gone by now.
            stamped = []
            for path in files:
                try:
                    stamped.append((path, {}, int(path.stat().st_mtime * 1000)))
                except OSError:
                    continue
            stamped.sort(key=lambda item: item[2], reverse=True)
            return stamped

        def confirm(paths):
            out = []
            for path in paths:
                fields, last_ts = self._scan_transcript(path)
                if fields.get("agentName", (None,))[0] != name:
                    continue
                if team and fields.get("teamName", (None,))[0] != team:
                    continue
                out.append((path, fields, last_ts))
            out.sort(key=lambda item: item[2], reverse=True)
            return out

        found = confirm(files)
        if not found:
            # The index can both miss (stamps only mid-history) and mislead (a stamp
            # quoted inside message content). Either way the answer is not yet "no",
            # so re-ask over whole files before saying so.
            deep = self._grep_files(f'"agentName":"{name}"', [self.projects_dir], True)
            if deep is None:  # grep unavailable
                deep = sorted(self.projects_dir.glob("*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
            elif team and deep:
                deep = self._grep_files(f'"teamName":"{team}"', deep, False) or []
            seen = set(files)
            found = confirm(p for p in deep if p not in seen)
        return found

    def _ingest_spawn_lines(self, paths):
        """Parse the spawn payloads out of these transcripts into the caches.

        grep pulls out the handful of matching lines; only those are parsed. A
        payload is taken from the parsed structure, never from raw bytes, so a
        transcript that merely discusses spawning cannot contribute a quoted
        example as if it were real.
        """
        self._exercise(NEED.SPAWNS)
        paths = [p for p in paths if p and p.stem not in self._spawns]
        for path in paths:
            self._spawns[path.stem], self._spawn_log[path.stem] = {}, []
        if not paths:
            return
        result = self._search("lines", SPAWN_MARKER, paths, False)
        if result.returncode > 1:
            warn(f"search failed reading spawn records ({result.stderr.strip() or 'unknown'})")
            return
        for line in result.stdout.splitlines():
            where, _, text = line.partition(":")
            stem = Path(where).stem
            if stem not in self._spawns:
                continue
            try:
                record = json.loads(text)
            except ValueError:
                continue
            # A sidechain line belongs to a subagent. A materialized promotion
            # prefix belongs to the parent conversation. Both remain context, but
            # neither is an action authored by this transcript.
            if record.get("isSidechain") or not self.authored_here(Path(where), record):
                continue
            stamp = iso_ms(record.get("timestamp"))
            for payload in self._walk_spawn_payloads(record):
                self._spawns[stem][payload["name"]] = payload  # last spawn of a name wins
                self._spawn_log[stem].append((stamp, payload))

    def session_names_team(self, session_id, team):
        """Does this session id name this team?

        True when the team's name was minted and this id opens with the eight
        hex it was minted from. A team named by a --team-name flag was minted
        by nobody, so it answers False for every id.

        The one place a session is matched to a team name. A caller holding a
        registry entry, a transcript stem or a candidate path asks here instead
        of taking the name apart and comparing prefixes for itself, because
        eight hex is not a session id: a match narrows the field and settles
        nothing, and that is one judgement, not four.
        """
        block = implicit_team_block(team)
        return bool(block and str(session_id or "").startswith(block))

    def sessions_naming(self, team):
        """Every transcript whose session id names this team, newest first.

        More than one is an ordinary answer, since eight hex is not a session
        id, and all of them come back: which of several conversations to
        believe is the caller's judgement and it needs to see that there were
        several.

        transcripts_starting narrows the tree to the block and
        session_names_team decides, so the match is made in one place.
        """
        block = implicit_team_block(team)
        if not block:
            return []
        return sorted((path for path in self.transcripts_starting(block)
                       if self.session_names_team(path.stem, team)),
                      key=lambda path: path.stat().st_mtime, reverse=True)

    def registry_entries_naming(self, team, snapshot):
        """Every session registry entry whose session id names this team.

        The registry is read only for a name a session could have minted: a
        flag-named team is nobody's session id, so there is nothing in there to
        find and the whole of ~/.claude/sessions is left unparsed. The caller
        supplies the runtime snapshot so one resolution cannot mix observations.
        """
        if not implicit_team_block(team):
            return []
        return [row for row in snapshot["registry"]
                if self.session_names_team(row.get("session"), team)]

    def _lead_process(self, snapshot, parent_session=None, team=None):
        """Return structured process evidence for a team lead.

        `agent_runtime` exposes this private process read to public callers. A
        fresh implicit team carries an ID that also names the lead transcript,
        allowing an exact registry join. A resumed lead's implicit team carries a
        process-life ID, so current spawn or argv evidence identifies it. Socket
        resolution and credential inheritance both consume this answer.
        """
        def process(pid=None, alive=False, how=None, detail=None, exact=False, kind=None):
            return {"pid": pid, "alive": alive, "how": how, "detail": detail,
                    "exact": exact, "kind": kind}

        if parent_session:
            entry = snapshot["best_by_session"].get(parent_session)
            if entry:
                pid, alive = entry["pid"], entry["alive"]
                return process(
                    pid, alive, f"lead pid {pid}" + ("" if alive else " (dead)"),
                    f"session {parent_session}", True, "session",
                )
        if team:
            # A fresh lead shares its internal and transcript IDs, giving its
            # implicit team an exact registry join. The measured corpus contains
            # this relation in 16 of 37 team directories.
            for data in self.registry_entries_naming(team, snapshot):
                if data["alive"]:
                    # The registry records the resumed transcript ID. Window-start
                    # stamps determine restored team identity, so verify them before
                    # assigning this PID to the implicit team name.
                    joined = self.transcript_path(str(data.get("session", "")))
                    if joined:
                        rteam, state = self.restored_identity(joined)
                        if state == "restored" and rteam != team:
                            continue
                    return process(
                        data["pid"], True,
                        f"pid {data['pid']}, whose session id names team {team}",
                        f"whose session id names team {team}", True, "session-team",
                    )
            # A flag-bound lead advertises exact identity in argv. The session
            # registry contains plain launches, so argv supplies this process row.
            masquerade = next((e for e in snapshot["live_sessions"]
                               if e["alive"] and e["agent_id"] == agent_id_of("team-lead", team)), None)
            if masquerade:
                return process(
                    masquerade["pid"], True,
                    f"pid {masquerade['pid']}, running as {masquerade['agent_id']}",
                    f"running as {masquerade['agent_id']}", True, "argv",
                )

            pid = self._pid_running_team(team, snapshot)
            if pid:
                return process(
                    pid, True, f"pid {pid}, which spawned into team {team}",
                    f"which spawned into team {team}", True, "spawn",
                )
            pid = self._pid_that_minted(team, snapshot)
            if pid:
                # Timing explains candidate selection. Window-start stamps and
                # argv answer current team identity in team_minted_by and the
                # separate “runs as” report line.
                return process(
                    pid, True, f"pid {pid}, whose boot pairs with this team's creation",
                    "whose boot pairs with this team's creation", False, "mint-time",
                )
        return process()

    def lead_transcript_for(self, team):
        """Return the transcript and evidence claim for a team's lead.

        Forked history and quoted spawn payloads can create several claimants.
        Corroboration uses a live team process, roster `leadSessionId`, member names
        shared by roster and spawn records, live spawned members, or the implicit
        team-name prefix. One corroborated claimant wins. A sole claimant remains
        usable for dead-team recovery and is marked uncorroborated. Multiple
        unresolved claimants produce an ambiguity result.
        """
        def claim(kind, why, corroborated=False, **facts):
            return {"kind": kind, "why": why, "corroborated": corroborated,
                    **facts}

        hits = self.led_teams().get(team) or []
        if not hits:
            return None, claim("none", f"no transcript records spawning into {team}")

        # A populated leadSessionId provides roster corroboration. Reconstructed
        # rosters leave it empty for uncorroborated leads, preventing spawn records
        # from corroborating themselves through a roster derived from those records.
        rosters = [e for e in self.roster_entries(team=team) if e.get("leadSessionId")]
        roster_members = {e["member"].get("name") for e in rosters}
        roster_leads = {e.get("leadSessionId") for e in rosters}
        live_here = {e.get("session") for e in self.runtime()["live_sessions"] if e.get("team") == team}

        def any_child_running(names):
            """Is any of these members of this team running right now?

            Both halves: a member whose process is this command's own ancestor
            is running as plainly as any other, and dropping it would leave a
            claimant uncorroborated exactly when the asker is its own child.
            """
            for name in names:
                if self.agent_runtime(agent_id_of(name, team))["processes"]:
                    return True
            return False

        def corroboration(path):
            if path.stem in live_here:
                return f"live process running as {team}"
            if path.stem in roster_leads:
                return "roster leadSessionId"
            spawned = {payload.get("name") for payload in self.members_spawned_into(path.stem, team)}
            if roster_members and spawned & roster_members:
                return "member names"
            # Live members spawned by this claimant provide current process
            # evidence. Fork siblings share child history, so this distinguishes
            # different payload sets while leaving copied histories tied.
            if spawned and any_child_running(name for name in spawned if name):
                return "live members it spawned"
            if self.session_names_team(path.stem, team):
                return "team-name block"
            return None

        backed = [(path, why) for _, path in hits if (why := corroboration(path))]
        if len(backed) == 1:
            return backed[0][0], claim(
                "corroborated",
                f"spawn payloads naming {team}, corroborated by {backed[0][1]}",
                True, basis=backed[0][1],
            )
        if len(hits) == 1:
            # The answer says it is uncorroborated; it does not warn about it.
            # Reports ask this question too, and a listing that said "resuming"
            # would describe an act nobody asked for. Whoever resumes says so,
            # from this provenance.
            return hits[0][1], claim(
                "sole", f"sole payload claimant for {team}, uncorroborated")
        listed = ", ".join(path.stem[:8] for _, path in hits)
        if len(backed) > 1:
            return None, claim(
                "ambiguous-corroborated",
                f"{len(backed)} transcripts claim {team} with corroboration "
                f"({listed}); name one with --resume",
            )
        return None, claim(
            "ambiguous",
            f"{len(hits)} transcripts claim {team}; corroboration is empty "
            f"({listed}); name one with --resume",
        )

    def led_teams(self):
        """Map each team to lead transcripts ordered by latest spawn timestamp.

        Lead transcript lines carry session identity. Their teammate spawn records
        add team identity and therefore identify teams led by the transcript. A
        fresh implicit team also records the transcript ID in the roster. A resumed
        lead uses a process-life internal ID, making spawn records the durable link.

        Roster provenance varies between Claude Code, this tool, and manual recipes,
        so resolution evaluates each record instead of inferring provenance from
        corpus counts. This method reuses the spawn-record scan.
        """
        self._exercise(NEED.SPAWNS)
        if self._by_team is not None:
            return self._by_team
        self._by_team = {}
        leads = self._grep_files(SPAWN_MARKER, [self.projects_dir], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            newest = {}
            for stamp, payload in self._log(path.stem):
                team = payload.get("team_name")
                if team:
                    newest[team] = max(newest.get(team, 0), stamp or 0)
            for team, stamp in newest.items():
                self._by_team.setdefault(team, []).append((stamp, path))
        for team in self._by_team:
            self._by_team[team].sort(reverse=True)
        return self._by_team

    def agent_runtime(self, agent_id, table=None, parent_session=None):
        """The live process answer for any agent identity.

        Members state identity in argv. A plain lead does not: the session
        registry and the team evidence identify its process instead. This method
        accepts both sources, deduplicates by pid, keeps the transcript each
        process holds, records which evidence established each pid, and marks
        the processes in this command's ancestry.

        The lead-only fields carry the same engine evidence diagnose_team needs
        for its verdict. A report consumes this answer; it does not call
        _lead_process or team_minted_by separately and assemble another runtime
        model of its own.
        """
        table = self.process_table() if table is None else table
        snapshot = self.runtime(table)
        pairs = {}
        evidence = {}

        def add(rows, kind, how):
            for pid, held in rows:
                if pid not in pairs or (held and not pairs[pid]):
                    pairs[pid] = held
                evidence[pid] = {
                    "kind": kind,
                    "how": how(pid),
                    "states_identity": kind == "argv",
                }

        argv_records = snapshot["by_agent"].get(agent_id, [])
        add([(row["pid"], row["session"]) for row in argv_records],
            "argv", lambda pid: f"live pid {pid} running as {agent_id}")

        name, team = name_and_team(agent_id)
        lead_pid = None
        lead_alive = False
        lead_how = None
        lead_detail = None
        lead_exact = False
        runs_as = team if pairs else None
        runs_as_exact = bool(pairs)
        worn = team if pairs else None
        if name == "team-lead" and team:
            lead_process = self._lead_process(snapshot, parent_session, team)
            lead_pid = lead_process["pid"]
            lead_alive = lead_process["alive"]
            lead_how = lead_process["how"]
            lead_detail = lead_process["detail"]
            lead_exact = lead_process["exact"]
            if lead_pid and lead_alive:
                held = (snapshot["by_pid"].get(lead_pid) or {}).get("session")
                if lead_pid not in evidence:
                    add([(lead_pid, held)], lead_process["kind"], lambda _pid: lead_how)
                elif held and not pairs[lead_pid]:
                    pairs[lead_pid] = held
                runs_as, runs_as_exact = self.team_minted_by(lead_pid, snapshot)
                worn = (snapshot["by_pid"].get(lead_pid) or {}).get("team")

        ordered = sorted(pairs.items())
        process_index = snapshot["by_pid"]
        process_rows = [process_index[pid] for pid, _held in ordered
                        if pid in process_index]
        other_rows = [row for row in process_rows if not row["ours"]]
        our_rows = [row for row in process_rows if row["ours"]]
        others = [(pid, held) for pid, held in ordered
                  if not process_index.get(pid, {}).get("ours")]
        ours = [(pid, held) for pid, held in ordered
                if process_index.get(pid, {}).get("ours")]
        seated = next((row for row in process_rows if row["socket"]), None)
        seat_state = "seated" if seated else "unseated" if ordered else "not running"
        pid = lead_pid if name == "team-lead" else (ordered[0][0] if len(ordered) == 1 else None)
        alive = lead_alive if name == "team-lead" else bool(ordered)
        how = lead_how if name == "team-lead" else (
            f"pid {pid}, running as {agent_id}" if pid else None)
        exact = lead_exact if name == "team-lead" else bool(pid)
        detail = lead_detail if name == "team-lead" else (
            f"running as {agent_id}" if pid else None)
        return {"agent_id": agent_id, "pid": pid, "alive": alive,
                "how": how, "detail": detail, "exact": exact, "processes": ordered,
                "process_rows": process_rows, "other_processes": other_rows,
                "our_processes": our_rows, "seat_state": seat_state,
                "socket": seated["socket"] if seated else None,
                "pane": seated["pane"] if seated else None,
                "evidence": evidence, "others": others, "ours": ours,
                "runs_as": runs_as, "runs_as_exact": runs_as_exact,
                "worn_team": worn}

    def _log(self, stem):
        """Load and return this transcript's spawn entries.

        Loading at the read point distinguishes an actual empty result from an
        uninitialized cache.
        """
        self._spawn_records(stem)
        return self._spawn_log.get(stem) or []

    def _every_log(self):
        """{transcript stem: entries} for the whole tree, filled on demand."""
        self.led_teams()
        return dict(self._spawn_log)

    def roster_record(self, ctx):
        """Return the complete roster entry for the effective identity."""
        name = self.field(ctx, "agentName")
        team = self.field(ctx, "teamName")
        return {
            "name": name,
            "team": team,
            "agentId": self.field(ctx, "agentId") or "",
            "parentSession": self.field(ctx, "parentSessionId") or "",
            "agentType": self.field(ctx, "agentType"),
            "planModeRequired": self.field(ctx, "permissionMode") == "plan",
            "cwd": ctx["target"]["cwd"],
            "color": self.field(ctx, "color"),
            "model": self.field(ctx, "model"),
        }

    def spawn_payloads(self):
        """Every spawn payload on this machine."""
        return [payload for entries in self._every_log().values() for _stamp, payload in entries]

    def members_spawned_into(self, lead_session, team):
        """The payloads for every teammate this lead spawned into this team.

        A team-membership question, like team_minted_by's, not the per-agent payload
        lookup spawn_payload owns: it asks who a roster should list, not what one
        known agent was created with. A lead resumed several times spawns into a
        fresh implicit team each life while appending to one transcript, so payloads
        naming another team are skipped rather than adopted.
        """
        latest = {}
        for _stamp, payload in self._log(lead_session):
            if payload.get("name") and payload.get("team_name") == team:
                latest[payload["name"]] = payload  # last spawn of that name into this team
        return list(latest.values())

    def name_rosters(self, name):
        """Teams whose roster carries this agent name. A name in more than one is
        not an identity: every team has a "team-lead"."""
        return {e["team"] for e in self.scan_teams() if e["member"].get("name") == name}

    def same_name_other_case(self, name, team=None):
        """Return roster agent IDs that match this name case-insensitively.

        Refusals use these candidates to distinguish an unknown name from a case
        mismatch. The existing roster scan supplies the candidate set.
        """
        if not name:
            return []
        near = set()
        for entry in self.scan_teams():
            theirs = entry["member"].get("name")
            if not theirs or theirs == name:
                continue
            if team and entry["team"].lower() != team.lower():
                continue
            if theirs.lower() == name.lower():
                near.add(agent_id_of(theirs, entry["team"]))
        return sorted(near)

    def _pid_running_team(self, team, snapshot):
        """Return the live process whose transcript records spawning into this team.

        This supplies exact evidence when `leadSessionId` contains a process-life
        internal ID. The lead's spawn records connect its transcript to the team.
        """
        if not team:
            return None
        matches = []
        for entry in snapshot["live_sessions"]:
            if not (entry["alive"] and entry["session"]):
                continue
            # Any life's payload will do here: it is the same process either way.
            if any(item.get("team_name") == team for _, item in self._log(entry["session"])):
                matches.append((entry["updated"], entry["pid"]))
        return max(matches)[1] if matches else None

    def _pid_that_minted(self, team, snapshot):
        """Return the live process corroborated with this implicit team by timing.

        Resumed leads put their process-life internal ID in `leadSessionId`, so
        `_boot_join` supplies the team-to-process candidate used for socket lookup.
        """
        return next((pid for name, pid, _ in self._boot_join(snapshot)
                     if name == team), None)

    def _proc_stat(self, pid):
        """Return state, parent PID, and start time from `/proc/<pid>/stat`.

        Resolver keeps this parser private and exposes interpreted answers through
        `pid_alive` and `state_note`. Field 2 can contain spaces and parentheses,
        so parsing starts after the final closing parenthesis.
        """
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except (OSError, ValueError):
            # ValueError catches a comm that is not valid utf-8. The table
            # now reads this for every process on the machine, other users'
            # included, so a name we cannot decode has to answer "unknown"
            # rather than end the whole snapshot.
            return None, None, None
        try:
            rest = stat[stat.rindex(")") + 2:].split()
            return rest[0], int(rest[1]), rest[19]
        except (ValueError, IndexError):
            return None, None, None

    def pid_alive(self, pid, procstart=None):
        """Is this process still running, and still the one that was meant?

        A zombie is not alive. A ctrl-z'd process is: it still owns its
        session and will pick up where it left off; callers nudge instead of
        stepping on it. `procstart` is what stops a recycled pid number from
        answering yes for a stranger.
        """
        state, _ppid, st = self._proc_stat(pid)
        if st is None or state in ("Z", "X"):
            return False
        return procstart in (None, "", st)

    def proc_start(self, pid):
        """The start time the kernel records for this pid, or "" for one we
        cannot read.

        The other half of the identity pid_alive checks: anything writing a pid
        down for a later run to test asks here for the value to write beside it,
        so both sides of that test come from one parser.
        """
        return self._proc_stat(pid)[2] or ""

    def state_note(self, pid):
        """Suffix for a pid we are reporting as alive, when it needs a nudge."""
        state = self._proc_stat(pid)[0]
        if state in ("T", "t"):
            return f", suspended; `kill -CONT {pid}` (or fg) to wake it"
        return ""

    def proc_env(self, pid, names):
        """The values this process was given for these environment variables.

        Env is fixed at exec, so this is what the process is actually running
        with rather than what anyone since has set. Nothing outside can read
        it and stay honest: /proc/<pid>/environ is the only source.
        """
        try:
            raw = Path(f"/proc/{pid}/environ").read_bytes()
        except OSError:
            return {}
        found = {}
        for item in raw.split(b"\0"):
            if b"=" not in item:
                continue
            key, value = item.split(b"=", 1)
            key = key.decode("utf-8", "replace")
            if key in names:
                found[key] = value.decode("utf-8", "replace")
        return found

    def _cmdline(self, pid):
        """One process's argv as a string. Private: the table is how everything
        else asks, and the table is built out of this one pid at a time."""
        try:
            return Path(f"/proc/{pid}/cmdline").read_bytes().replace(
                b"\0", b" ").decode(errors="replace").strip()
        except OSError:
            return ""

    def process_table(self, refresh=False):
        """Return one PID-sorted snapshot of process parentage and full argv.

        `/proc` supplies complete command lines independent of terminal width and
        locale. Rows require a command line, which selects user processes and
        excludes kernel threads and zombies. Exiting processes reparent their
        children, preserving the ancestry walks. In the measured sample, 402 of
        403 commandless PIDs were kernel threads and one was a zombie.
        """
        self._exercise(NEED.PROCS)
        if refresh:
            self._seat_table = self._seats = None
            self._runtime_table = self._runtime_snapshot = None
            self._registry = None
        if self._procs is not None and not refresh:
            return self._procs
        rows = []
        for entry in Path("/proc").iterdir():
            if not entry.name.isdigit():
                continue
            pid = int(entry.name)
            args = self._cmdline(pid)
            if not args:
                continue
            _state, ppid, _started = self._proc_stat(pid)
            if ppid is None:
                # It exited between the listing and the read. A row with no
                # parent would sit outside every chain anyway.
                continue
            rows.append((pid, ppid, args))
        rows.sort()
        self._procs = rows
        return rows

    def known_teams(self):
        """Map every known team to its strongest existence evidence.

        Transcript stamps and spawn records survive graceful team-directory
        cleanup. A roster directory adds current disk evidence. Selection and
        completion consume this shared enumeration.
        """
        found = {}
        for _name, stamped in self.stamp_index().values():
            if stamped:
                found[stamped] = "a transcript stamped with it"
        for team in self.led_teams():
            found[team] = "spawn payloads naming it"
        for directory in self.team_dirs():
            # A roster makes the directory evidence of a team. Inbox-only
            # directories contain runtime files without an identity record.
            if self.roster_path(directory.name).exists():
                found[directory.name] = "a roster on disk"
        return found

    def team_evidence(self, token):
        """Why this token is a team, or None."""
        return self.known_teams().get(token)

    def lead_session_for(self, team):
        """Return the lead session using roster, spawn, then name-prefix evidence."""
        for entry in self.scan_teams():
            if entry["team"] == team and entry.get("leadSessionId"):
                if self.transcript_path(entry["leadSessionId"]):
                    return entry["leadSessionId"]
        path, _why = self.lead_transcript_for(team)
        if path:
            return path.stem
        hits = self.sessions_naming(team)
        if len(hits) > 1:
            warn(f"{len(hits)} transcripts name team {team}; assuming {hits[0].stem}")
        return hits[0].stem if hits else None

    def team_dir(self, team):
        """This team's directory. Everything the team owns is inside it, and
        every path answer below is this one plus a name."""
        return self.teams_dir / team

    def roster_in(self, team_dir):
        """The roster inside a team directory.

        By directory rather than by team name, because a reap reads one team
        twice, once where it lives and once at the staged path it was renamed
        to, and that path is nobody's team name.
        """
        return team_dir / "config.json"

    def inboxes_in(self, team_dir):
        """The mailbox directory inside a team directory, for the same reason
        roster_in takes a directory."""
        return team_dir / "inboxes"

    def roster_path(self, team):
        """Where this team's roster lives. A path question, not a write: the class
        answers where things are so writers never have to know the layout."""
        return self.roster_in(self.team_dir(team))

    def has_roster(self, team):
        """Return whether the team has a roster path on disk.

        Callers use this one-stat check before errors, membership writes, and
        completion. `scaffolding_objection` performs content validation.
        """
        return bool(team) and self.roster_path(team).exists()

    def lock_for(self, cfg):
        """Where the lock for this roster lives.

        By roster path rather than by team name: both callers already hold the
        roster whose lock they are about to take or clear, and the layout is
        answered here so neither has to spell the filename.
        """
        return cfg.with_name("config.json.lock")

    def lock_holder(self, lock):
        """Return owner record, owner-exited state, and bytes read from a lock.

        A recognized owner record is regular-file JSON written by this tool with
        PID and process start time. Directories, empty files, malformed JSON, and
        incomplete process identity return an unrecognized owner. PID plus start
        time handles PID reuse.

        Callers compare the returned bytes immediately before unlinking. A new
        owner's replacement changes the comparison and preserves the file. Byte
        comparison is required because the filesystem can reuse an inode after
        replacement.
        """
        try:
            raw = lock.read_bytes()
        except OSError:
            return None, False, None
        try:
            owner = json.loads(raw)
        except ValueError:
            return None, False, raw
        if not isinstance(owner, dict) or owner.get("tool") != TOOL:
            return None, False, raw
        if not isinstance(owner.get("pid"), int) or not isinstance(owner.get("procStart"), str):
            return None, False, raw
        if not owner["procStart"]:
            return None, False, raw
        return owner, not self.pid_alive(owner["pid"], owner["procStart"]), raw

    def lock_objection(self, lock):
        """Return the reason a roster lock preserves its team directory.

        A `proper-lockfile` directory belongs to Claude Code. A recognized record
        with a live owner belongs to an active `team_lock` writer. An unreadable or
        empty regular file may belong to a writer between exclusive creation and
        ownership-record publication. Each case preserves the directory.

        A recognized record whose owner has exited permits cleanup because
        `sweep_dead_lock` can remove that exact regular file. `lock_holder` supplies
        the shared ownership decision used by roster writes and cleanup.
        """
        if lock.is_dir():
            return f"{lock.name} is a directory, which is the harness's own lock on this roster"
        owner, gone, seen = self.lock_holder(lock)
        if seen is not None:
            if owner:
                return None if gone else f"{lock.name} is held by pid {owner['pid']}, which is running"
            return (f"{lock.name} carries no owner record, so a run of this tool is either "
                    "inside it or was killed inside it")
        # A missing path permits removal. Sockets, FIFOs, and inaccessible paths
        # preserve the directory as unexpected entries.
        return None if not lock.exists() else f"{lock.name} is not a regular file"

    def inbox_path(self, team, name):
        """Where this member's mailbox lives."""
        return self.inboxes_in(self.team_dir(team)) / f"{name}.json"

    def inbox_seeded(self, team, name):
        """Does this member already have a mailbox file with something in it?

        Zero bytes is the state that matters: an empty file is a parse error
        that wedges both reader and writer, so it counts as no mailbox at all
        and the seeder writes `[]` over it.
        """
        try:
            path = self.inbox_path(team, name)
            return path.exists() and path.stat().st_size > 0
        except OSError:
            return False

    def inbox_state(self, team):
        """Return undelivered count and oldest timestamp for each mailbox.

        Parse failures return `(None, reason)` so reports distinguish unreadable
        storage from an empty mailbox.
        """
        state = {}
        try:
            boxes = sorted(self.inboxes_in(self.team_dir(team)).iterdir())
        except OSError:
            return state
        for box in boxes:
            if box.suffix != ".json" or not box.is_file():
                continue
            try:
                mail = json.loads(box.read_text() or "[]")
            except OSError:
                continue
            except ValueError:
                state[box.stem] = (None, "unreadable, possibly torn mid-write")
                continue
            if not isinstance(mail, list):
                state[box.stem] = (None, f"mailbox value is {type(mail).__name__}, expected array")
                continue
            stamps = sorted(m.get("timestamp") or "" for m in mail if isinstance(m, dict))
            state[box.stem] = (len(mail), stamps[0] if stamps else None)
        return state

    def team_dirs(self):
        """Every team directory on disk, roster or not."""
        return [d for d in self.teams_dir.glob("*") if d.is_dir()]

    def made_moments_ago(self, team_dir):
        """Return whether the team directory is inside the creation grace period.

        Team-directory creation precedes registry, spawn, and process evidence.
        The grace period preserves a team while those records appear.
        """
        try:
            return time.time() - team_dir.stat().st_mtime < TEAM_GRACE_S
        except OSError:
            return False

    def scaffolding_objection(self, team_dir):
        """Return the first reason this team directory must be preserved.

        Validate the roster, inbox arrays, roster lock, and the tool-owned names
        in `SCAFFOLDING`. Symlinks, nested or unexpected entries, undelivered mail,
        unreadable data, and active or uncertain locks each preserve the
        directory. Lock validation protects a concurrent roster writer even when
        transcript evidence classifies the team as finished.
        """
        known = SCAFFOLDING
        lock = self.lock_for(self.roster_in(team_dir))
        try:
            entries = list(team_dir.iterdir())
        except OSError as exc:
            return f"unreadable ({exc})"

        for item in entries:
            if item.is_symlink():
                return f"{item.name} is a symlink"
            if item.name not in known:
                return f"unexpected entry {item.name!r}"
            if item.name == lock.name:
                held = self.lock_objection(item)
                if held:
                    return held
                continue
            if item.name != "inboxes":
                if not item.is_file():
                    return f"{item.name} is not a regular file"
                continue

            if not item.is_dir():
                return "inboxes is not a directory"
            for inbox in item.iterdir():
                if inbox.is_symlink():
                    return f"inboxes/{inbox.name} is a symlink"
                if not inbox.is_file():
                    return f"inboxes/{inbox.name} is not a regular file"
                if inbox.suffix != ".json":
                    return f"inboxes/{inbox.name} is not a .json file"
                try:
                    mail = json.loads(inbox.read_text() or "[]")
                except (OSError, ValueError) as exc:
                    return f"inboxes/{inbox.name} is unreadable or not JSON ({exc})"
                if not isinstance(mail, list):
                    return f"inboxes/{inbox.name} is not a message array"
                if mail:
                    return f"inboxes/{inbox.name} holds {len(mail)} undelivered message(s)"
            # The final removal check parses each file again because removal
            # requires the current entry to remain a mailbox array.

        config = self.roster_in(team_dir)
        if not config.is_file():
            return "no config.json"
        try:
            data = json.loads(config.read_text())
        except (OSError, ValueError) as exc:
            return f"config.json unreadable ({exc})"
        if not isinstance(data, dict) or not isinstance(data.get("members", []), list):
            return "config.json is not a roster"
        return None

    def scaffolding_and_strays(self, team_dir):
        """Return tool-owned paths and retained relative entry names.

        Top-level ownership uses `SCAFFOLDING`. Inside `inboxes`, ownership covers
        regular `.json` files. Symlinks, directories in file positions, and other
        names enter the retained list. Callers complete this read before deleting
        any returned path.
        """
        mine, strays = [], []
        try:
            entries = sorted(team_dir.iterdir())
        except OSError as exc:
            return [], [f"unreadable ({exc})"]
        for item in entries:
            if item.name not in SCAFFOLDING or item.is_symlink():
                strays.append(item.name)
            elif item.name == "inboxes":
                try:
                    boxes = sorted(item.iterdir())
                except OSError as exc:
                    strays.append(f"inboxes ({exc})")
                    continue
                for box in boxes:
                    if box.is_symlink() or not box.is_file() or box.suffix != ".json":
                        strays.append(f"inboxes/{box.name}")
                    else:
                        mine.append(box)
            elif not item.is_file():
                strays.append(item.name)
            else:
                mine.append(item)
        return mine, strays

    def receipt_contents(self, team_dir, only=None):
        """Return receipt-ready roster and mailbox contents from a team directory.

        Each entry includes decoded text plus size, nanosecond mtime, and inode
        from the descriptor used for the read. Normalized keys remove staging
        suffixes so pre-stage and post-stage reads align. A directory argument
        supports both live and staged locations; `only` narrows the read to one
        mailbox. Read failures retain the entry with a reason. Reap and archive
        callers perform the later rename, write, and delete actions.
        """
        if only is not None:
            wanted = [self.inboxes_in(team_dir) / only]
        else:
            wanted = [self.roster_in(team_dir)]
            try:
                wanted += sorted(self.inboxes_in(team_dir).glob("*.json"))
            except OSError:
                pass
        reads = {}
        for path in wanted:
            key = ("config.json" if path.parent == team_dir
                   else f"inboxes/{unstaged(path.name)}")
            try:
                with open(path, "rb") as handle:
                    raw = handle.read()
                    facts = os.fstat(handle.fileno())
            except OSError as exc:
                reads[key] = {"text": None, "why": str(exc),
                              "size": None, "mtime_ns": None, "ino": None}
                continue
            try:
                text, why = raw.decode(), None
            except UnicodeDecodeError as exc:
                text, why = None, f"not text ({exc})"
            reads[key] = {"text": text, "why": why, "size": facts.st_size,
                          "mtime_ns": facts.st_mtime_ns, "ino": facts.st_ino}
        return reads

    def transcripts_by_mtime(self):
        """Every transcript, newest first."""
        return sorted(self.projects_dir.glob("*/*.jsonl"),
                      key=lambda path: path.stat().st_mtime, reverse=True)

    def transcripts_starting(self, block):
        """Transcripts whose uuid opens with this block. A path question, so it
        belongs to whoever owns the tree rather than to a caller globbing it."""
        return list(self.projects_dir.glob(f"*/{block}-*.jsonl"))

    def _resolution(self, *args, **kwargs):
        """Build one transcript resolution with its canonical transcript fact."""
        result = Resolution(*args, **kwargs)
        if result.path:
            result.transcript = self.transcript_fact(path=result.path)
        return result

    def resolve_transcript(self, session_uuid=None, lead_session=None, team=None, name=None,
                           is_lead=False, quick=False, runtime=None):
        """Choose one transcript by ordered evidence.

        Priority is explicit session UUID, live runtime, roster `leadSessionId`,
        combined agent and team stamps, unique agent-name stamps, then lead spawn
        records. Live argv describes current flag-bound identity and therefore
        outranks recorded identity. Plain leads use session and team process
        evidence.

        Lead lines carry session identity, so fresh leads resolve through
        `leadSessionId` and resumed leads can resolve through spawn records. Bare
        names shared across several transcript conversations produce ambiguity.
        """
        if session_uuid:
            paths = self._transcript_paths(session_uuid)
            if len(paths) > 1:
                return self._resolution(
                    reason=(f"{len(paths)} transcript files carry session {session_uuid}; "
                            "the UUID cannot choose between them, so resolve the duplicate "
                            "files before resuming"),
                    answered=True,
                    evidence={"kind": "session-ambiguity", "paths": paths},
                )
            if paths:
                path = paths[0]
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return self._resolution(path, fields, last, via="session uuid", strength=EXACT)
            return self._resolution(reason=f"no transcript file for session {session_uuid}")

        # Live runtime outranks recorded identity. Members and flag-bound leads
        # state identity in argv; plain leads join through session and team
        # process evidence.
        if name and team:
            # Both halves: argv is the strongest evidence this tool has, and our
            # own lineage carries the same argv as anyone else's process. A plain
            # lead can reach the same answer through its session runtime instead;
            # agent_runtime records which process evidence actually answered.
            runtime = (self.agent_runtime(agent_id_of(name, team))
                       if runtime is None else runtime)
            seen = runtime["processes"]
            held = {transcript for _, transcript in seen if transcript}
            if len(held) > 1:
                return self._resolution(reason=(
                    f"{len(seen)} live processes run {agent_id_of(name, team)} on different conversations "
                    f"({', '.join(f'pid {pid} on {t[:8]}' for pid, t in seen if t)}); "
                    "name the one you mean with --resume"))
            if held:
                held_session = held.pop()
                path = self.transcript_path(held_session)
                if path:
                    if len(seen) > 1:
                        warn(f"{len(seen)} live processes run {agent_id_of(name, team)} on this one "
                             f"conversation (pids {', '.join(str(pid) for pid, _ in seen)})")
                    matching = [pid for pid, transcript in seen
                                if transcript == held_session]
                    proof = next(
                        (runtime["evidence"].get(pid) for pid in matching
                         if runtime["evidence"].get(pid, {}).get("states_identity")),
                        None,
                    ) or next(
                        (runtime["evidence"].get(pid) for pid in matching
                         if runtime["evidence"].get(pid)),
                        None,
                    )
                    fields, last = ({}, 0) if quick else self._scan_transcript(path)
                    return self._resolution(
                        path, fields, last, strength=EXACT,
                        via=proof["how"] if proof else "live process runtime",
                        runtime=runtime,
                    )

        if lead_session or is_lead:
            path = self.transcript_path(lead_session) if lead_session else None
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return self._resolution(
                    path, fields, last, via="roster leadSessionId", strength=EXACT,
                    evidence={"kind": "roster-lead", "corroborated": True},
                )
            path, claim = (self.lead_transcript_for(team) if team else
                           (None, {"kind": "none", "why": "no team was named",
                                   "corroborated": False}))
            if path:
                fields, last = ({}, 0) if quick else self._scan_transcript(path)
                return self._resolution(
                    path, fields, last, via=claim["why"], strength=EXACT,
                    evidence=claim,
                )
            named = (f"roster names lead session {lead_session}, which has no transcript, and "
                     if lead_session else "")
            return self._resolution(reason=f"{named}{claim['why']}")

        if team and name:
            # Promotion is an intentional identity assignment. Ordinary stamps
            # written later describe what a process wore; they do not silently
            # transfer this conversation to another address. An explicitly typed
            # different address still reaches its own roster or stamp evidence.
            promoted = [(path, receipt)
                        for path, receipt in self.carried_receipts().items()
                        if receipt.get("team") == team and receipt.get("name") == name]
            if len(promoted) > 1:
                return self._resolution(
                    reason=(f"{len(promoted)} promotion receipts assign "
                            f"{agent_id_of(name, team)} to different conversations; "
                            "choose one with --resume"),
                    answered=True,
                    evidence={"kind": "promoted-ambiguity",
                              "paths": tuple(path for path, _receipt in promoted)},
                )
            if promoted:
                # The record sits in the transcript it describes, so the carrier
                # path is the answer rather than dest_stem copied out of the receipt.
                found, _receipt = promoted[0]
                fields, last = ({}, 0) if quick else self._scan_transcript(found)
                return self._resolution(found, fields, last, via="conversion receipt",
                                        strength=EXACT)
            hits = self._stamped_candidates(name, team, verify=not quick)
            if hits:
                return self._resolution(*hits[0], via="agentName+teamName stamps",
                                        strength=STAMPS, others=hits[1:])

        if name:
            rosters = self.name_rosters(name)
            hits = self._stamped_candidates(name, None, verify=not quick)
            if len(rosters) > 1:
                # Roster entries are addresses. Rebinding can leave source and
                # destination addresses for one conversation. Transcript evidence
                # determines whether the name identifies one or several agents.
                paths = {path for path, _fields, _last in hits}
                if len(paths) == 1:
                    return self._resolution(
                        *hits[0], via=f"agentName on one transcript across {len(rosters)} rosters",
                        strength=NAME_ONLY)
                return self._resolution(reason=(
                    f"transcript search for {name!r} on team={team} returned empty; the bare name spans "
                    f"{len(rosters)} rosters and {len(paths)} transcripts, so qualify it with name@team or --resume"
                ))
            if hits:
                return self._resolution(
                    *hits[0], via="agentName only (unique across rosters)", strength=NAME_ONLY,
                    others=hits[1:])
        label = agent_id_of(name or "?", team or "?")
        # Every rung is spent. If a roster carries this word under different
        # capitals, saying so is the whole difference between a dead end and a
        # typo, and it costs one pass over rosters already read.
        near = self.same_name_other_case(name, team)
        if near:
            return self._resolution(answered=True, reason=(
                f"no transcript found for {label}; {some_of(near)} "
                f"{'differs' if len(near) == 1 else 'differ'} from it only in case"
            ))
        return self._resolution(reason=f"no transcript found for {label}")

    def _boot_join(self, snapshot):
        """[(team, pid, createdAt)] pairing each implicit team with the live process
        that minted it, newest first.

        A boot mints its implicit team named after its internal session id, while
        sessions/<pid>.json keeps the *resumed transcript* id. The two diverge after
        a resume (before one they are the same id, which _lead_process exploits as an
        exact join), and nothing else records the post-resume internal id, so for
        those teams time is a join of last resort: a
        team dir is created a few hundred ms before the session file when a boot
        mints it eagerly (measured 281, 252 and 402ms), but it can instead be
        minted at the first spawn, minutes later, which this window does not cover.
        That is why the exact rungs above it are tried first.
        """
        live = [(row["pid"], row["started"])
                for row in snapshot["registry"] if row["alive"]]
        pairs = []
        for cfg, data, _mtime in self.rosters():
            created = data.get("createdAt") or 0
            for pid, started in live:
                if 0 <= started - created <= TEAM_MINT_WINDOW_MS:
                    pairs.append((data.get("name") or cfg.parent.name, pid, created))
        pairs.sort(key=lambda item: item[2], reverse=True)
        for team in {name for name, _, _ in pairs}:
            owners = {pid for name, pid, _ in pairs if name == team}
            if len(owners) > 1:
                warn(f"{team} pairs with {len(owners)} processes started within "
                     f"{TEAM_MINT_WINDOW_MS}ms ({', '.join(map(str, sorted(owners)))}); "
                     "the pick between them is arbitrary")
        return pairs

    def team_runtime(self, team, table=None):
        """Population and live process facts for one team, resolved together.

        States are listed, unrecorded (running, in no roster), former and
        converted. The roster describes current membership; stamped transcripts
        retain former members; a live process changes an unlisted stamped member
        to unrecorded. The process answer used for that classification is retained
        in `runtimes` rather than asked again. A live lead omitted by a damaged or
        absent roster is likewise added as unrecorded. Member titles and fallback
        colours are added only when NEED.TITLES was declared; verbs that consume
        population and liveness do not pay for report descriptions.
        """
        table = self.process_table() if table is None else table
        roster = self.roster_of(team) or {}
        population = {}
        roster_order = []
        runtimes = {}
        for member in roster.get("members", []):
            name = member.get("name")
            if name:
                if name not in population:
                    roster_order.append(name)
                population[name] = ("listed", "listed in the roster")
        for _path, (name, stamped_team) in self.stamp_index().items():
            if stamped_team != team or not name or name in population:
                continue
            facts = self.agent_runtime(agent_id_of(name, team), table)
            runtimes[name] = facts
            population[name] = (("unrecorded", "running, and in no roster")
                                if facts["processes"]
                                else ("former", "a transcript stamped with this team"))
        for name in self.converted_members(team):
            if name not in population or population[name][0] == "former":
                population[name] = (
                    "converted", "a conversion receipt; registers on first launch")
        for name in population:
            if name not in runtimes:
                runtimes[name] = self.agent_runtime(agent_id_of(name, team), table)
        lead_id = agent_id_of("team-lead", team)
        if "team-lead" not in runtimes:
            runtimes["team-lead"] = self.agent_runtime(lead_id, table)
        lead = runtimes["team-lead"]
        if lead["processes"] and "team-lead" not in population:
            population["team-lead"] = (
                "unrecorded", "the live lead process is absent from the roster",
            )

        roster_members = {member.get("name"): member
                          for member in roster.get("members", [])}
        lead_session = roster.get("leadSessionId")
        describe_members = self.needs[NEED.TITLES] is not DECLARED.ABSENT
        roster_names = set(roster_order)
        member_order = roster_order + sorted(
            name for name in population if name not in roster_names)
        dossier_order = list(member_order)
        if "team-lead" not in dossier_order:
            dossier_order.append("team-lead")
        member_rows = []
        for name in member_order:
            facts = runtimes[name]
            agent_id = agent_id_of(name, team)
            member = roster_members.get(name) or {}
            colour = (member.get("color") or self.spawn_payload(agent_id).get("color") or ""
                      if describe_members else "")
            resolved = None

            def fallback_session():
                nonlocal resolved
                if resolved is None:
                    resolved = self.resolve_transcript(
                        lead_session=lead_session if name == "team-lead" else None,
                        team=team,
                        name=name,
                        is_lead=name == "team-lead",
                        quick=True,
                        runtime=facts,
                    )
                return resolved.path.stem if resolved else None

            processes = facts["processes"]
            if processes:
                rows = [(pid, held or (fallback_session() if describe_members else None))
                        for pid, held in processes]
            else:
                rows = [(None, fallback_session() if describe_members else None)]
            for pid, session in rows:
                member_rows.append({
                    "name": name,
                    "agent_id": agent_id,
                    "membership": population[name][0],
                    "pid": pid,
                    "session": session,
                    "title": (bounded_title(
                        (self.transcript_fact(session) or {}).get("title"), ABORT_TITLE)
                              if describe_members and session else None),
                    "color": colour,
                })
        live = {name: facts["processes"] for name, facts in runtimes.items()
                if facts["processes"]}
        seating = {
            name: (runtimes[name]["seat_state"], runtimes[name]["socket"],
                   runtimes[name]["pane"])
            for name in live if name != "team-lead"
        }
        names_by_membership = collections.defaultdict(list)
        for name, (state, _why) in population.items():
            names_by_membership[state].append(name)
        names_by_membership = {state: sorted(names)
                               for state, names in names_by_membership.items()}
        doubled = sorted(name for name, processes in live.items()
                         if len({pid for pid, _held in processes}) > 1)
        seat_sockets = {socket for _state, socket, _pane in seating.values() if socket}
        unseated = sorted(name for name, (state, _socket, _pane) in seating.items()
                          if state == "unseated")
        return {
            "team": team,
            "population": population,
            "names_by_membership": names_by_membership,
            "runtimes": runtimes,
            "lead": lead,
            "live": live,
            "doubled": doubled,
            "member_order": tuple(member_order),
            "dossier_order": tuple(dossier_order),
            "member_rows": member_rows,
            "seating": seating,
            "seat_sockets": seat_sockets,
            "split": len(seat_sockets) > 1,
            "unseated": unseated,
        }

    def converted_members(self, team):
        """{name: receipt} for promoted members whose membership is a receipt.

        A promote records the spoken identity in the line the transcript
        carries, so the transcript's own existence is the evidence: a demote
        takes the file away, and there is nothing left to describe. That is
        read off the same pass as the stamps, which a promoted transcript has
        none of, and is why its membership has to be asked for separately.
        """
        return {r["name"]: r for path, r in sorted(self.carried_receipts().items())
                if r.get("team") == team and r.get("name") and path.exists()}

    def mail_ledger(self, team, to=None):
        """[{sender, to, summary, sent, state, detail}] for a team's authored mail.

        Conversational mail is double-recorded: every send sits verbatim in
        the sender's transcript as a SendMessage tool use, and every delivery
        lands in the recipient's as a teammate-message wrapper carrying the
        body unchanged. The join is pure evidence-reading, and an unmatched
        send has four honest states rather than one: still in the inbox
        file (queued), the recipient has not written since (pending a turn
        boundary), taken into a live recipient's memory (in memory - the
        drain-then-die window while it stands open), or the recipient has
        written and no delivery matches (unexplained - what that window
        leaves behind when it closes on a loss). Seven states in all, with
        delivered, protocol and unknown recipient.

        Harness-emitted traffic (idle notifications) has no send side, so it
        never appears here; protocol-object sends are counted, not joined.
        The transcript join is the ONLY durable record, two ways over:
        cleanup deletes inbox dirs wholesale, and normal delivery prunes the
        inbox on queueing (bundle-confirmed), so "in memory" is the one
        state any instrument can show while a loss window is open.

        `to` is the caller's declared need. A named recipient narrows the
        join to sends addressed to it, with identical states to the full
        ledger's rows for it: every transcript is still opened, because a
        send to it can originate anywhere, but only its own file pays the
        delivery side, and everyone else's parses only its send lines.
        """
        self._exercise(NEED.MAIL)
        people = {}
        for path, (name, stamped) in self.stamp_index().items():
            if stamped == team and name and name not in people:
                people[name] = path
        lead_session = self.team_lead_session(team)
        if lead_session and "team-lead" not in people:
            lead_path = self.transcript_path(lead_session)
            if lead_path:
                people["team-lead"] = lead_path

        sends, boxes, wrappers, last_write = [], {}, {}, {}
        wrapper_re = re.compile(
            r'<teammate-message teammate_id="([^"]+)"[^>]*>\n(.*?)\n</teammate-message>',
            re.DOTALL)
        for name, path in people.items():
            # The caller's declared need bounds the walk: sends to the named
            # recipient originate anywhere, so every transcript is opened, but
            # only the recipient's own file pays the delivery side (wrappers,
            # last write, inbox), and everyone else's parses only its sends.
            wants_delivery = to is None or name == to
            got_wrappers, newest = [], 0
            try:
                handle = path.open(errors="replace")
            except OSError:
                continue
            with handle:
                for line in handle:
                    if '"SendMessage"' not in line and not (
                            wants_delivery and ("<teammate-message" in line
                                                or '"timestamp"' in line)):
                        continue
                    try:
                        rec = json.loads(line)
                    except ValueError:
                        continue
                    if rec.get("isSidechain"):
                        continue
                    ts = iso_ms(rec.get("timestamp"))
                    if ts:
                        newest = max(newest, ts)
                    content = (rec.get("message") or {}).get("content")
                    if rec.get("type") == "assistant" and isinstance(content, list):
                        for block in content:
                            if (isinstance(block, dict) and block.get("type") == "tool_use"
                                    and block.get("name") == "SendMessage"):
                                spec = block.get("input") or {}
                                body = spec.get("message")
                                sends.append({
                                    "sender": name,
                                    "to": spec.get("to") or spec.get("recipient"),
                                    "summary": spec.get("summary") or "",
                                    "sent": ts,
                                    "body": body if isinstance(body, str) else None})
                    elif wants_delivery and rec.get("type") == "user":
                        text = content if isinstance(content, str) else "".join(
                            part.get("text", "") for part in content or []
                            if isinstance(part, dict))
                        if "<teammate-message" in text:
                            for who, body in wrapper_re.findall(text):
                                got_wrappers.append((who, body))
            wrappers[name] = got_wrappers
            if wants_delivery:
                last_write[name] = newest
                try:
                    inbox = json.loads(self.inbox_path(team, name).read_text())
                    boxes[name] = [m.get("text") or str(m.get("message", ""))
                                   for m in inbox if isinstance(m, dict)]
                except (OSError, ValueError):
                    boxes[name] = []

        ledger = []
        for send in sorted(sends, key=lambda s: s["sent"] or 0):
            addressee = send["to"]
            if to is not None and addressee != to:
                continue
            entry = {k: send[k] for k in ("sender", "to", "summary", "sent")}
            if send["body"] is None:
                entry.update(state="protocol", detail="an object send; not joined")
            elif addressee not in people:
                entry.update(state="unknown recipient",
                             detail=f"{addressee!r} has no transcript stamped with this team")
            elif any(who == send["sender"] and body == send["body"]
                     for who, body in wrappers.get(addressee, [])):
                entry.update(state="delivered", detail="the body sits in the "
                             "recipient's transcript verbatim")
            elif any(send["body"] == text for text in boxes.get(addressee, [])):
                entry.update(state="queued", detail="still in the inbox file; "
                             "delivery is a turn-boundary event")
            elif (last_write.get(addressee) or 0) <= (send["sent"] or 0):
                entry.update(state="pending", detail="the recipient has not "
                             "written since the send")
            elif self.runtime()["by_transcript"].get(people[addressee].stem):
                # Marked read on queueing, held in the recipient's RAM: the
                # drain-then-die window is open until its turn ends. Both
                # halves of the holder question, because the recipient may be
                # the very process asking.
                entry.update(state="in memory", detail="the recipient is live "
                             "mid-turn; delivery waits on its next boundary "
                             "and dies with its process")
            else:
                entry.update(state="unexplained", detail="the recipient has "
                             "written since, no delivery matches, and no live "
                             "process holds its transcript")
            ledger.append(entry)
        return ledger

    @staticmethod
    def _objector_said(row):
        """Render one process's complete rebind objection as one sentence.

        Process identity, restored identity, and transcript ownership merge into
        one row so reports count each PID once.
        """
        parts = []
        if "wears" in row["kinds"]:
            parts.append(f"runs as it ({row['worn']})")
        if "operates" in row["kinds"]:
            parts.append("operates as it (restored)")
        if row["holds"]:
            names = sorted(set(row["holds"]))
            parts.append(f"holds {names[0]}'s transcript" if len(names) == 1
                         else f"holds the transcripts of {some_of(names)}")
        running = row["kinds"] & {"wears", "operates"}
        who = f"this process (pid {row['pid']})" if row["ours"] and not running \
            else f"pid {row['pid']}"
        tail = "; that pid is this process" if row["ours"] and running else ""
        return f"{who} {' and '.join(parts)}{tail}"

    def reap_objections(self, team, table, archive_mail=False):
        """Return one structured rebind objection per process or mailbox.

        Team retirement requires zero live processes using its argv identity,
        restored identity, or stamped transcripts. Waiting mail also preserves
        the team unless the caller archives it. Typed rows let callers group
        remedies by evidence kind while counting each PID once.
        """
        procs = {}
        snapshot = self.runtime(table)

        def process_row(pid):
            return procs.setdefault(pid, {"pid": pid, "kinds": set(), "worn": None,
                                          "holds": [], "ours": False})

        for entry in snapshot["live_sessions"]:
            if not entry.get("alive"):
                continue
            if entry.get("team") == team:
                row = process_row(entry["pid"])
                row["kinds"].add("wears")
                row["worn"] = entry.get("agent_id") or "in argv"
            elif entry.get("session"):
                lived = self.transcript_path(entry["session"])
                if lived and self.restored_identity(lived) == (team, "restored"):
                    process_row(entry["pid"])["kinds"].add("operates")
        for path, (name, stamped) in self.stamp_index().items():
            if stamped != team:
                continue
            holders = snapshot["transcripts"].get(path.stem, {})
            for holder in holders.get("others", []):
                row = process_row(holder["pid"])
                row["kinds"].add("holds")
                row["holds"].append(name)
            for holder in holders.get("ours", []):
                row = process_row(holder["pid"])
                row["kinds"].add("holds")
                row["holds"].append(name)
                row["ours"] = True
        out = [{"pid": row["pid"], "kinds": frozenset(row["kinds"]),
                "said": self._objector_said(row)} for row in procs.values()]
        if not archive_mail:
            for name, (count, oldest) in self.inbox_state(team).items():
                if count is None:
                    out.append({"pid": None, "kinds": frozenset({"mail"}),
                                "said": f"{name}'s inbox is {oldest}"})
                elif count:
                    out.append({"pid": None, "kinds": frozenset({"mail"}),
                                "said": f"{count} unread for {name}, "
                                        f"oldest {said_when(oldest)}"})
        return out

    def nameless_receipts(self):
        """Promoted transcript roots whose last in-file receipt has no identity."""
        return [path.stem for path, receipt in self.carried_receipts().items()
                if not (receipt.get("name") and receipt.get("team"))]

    def live_teams(self):
        """Teams a live process is currently running as, from its own argv."""
        return {e["team"] for e in self.runtime()["live_sessions"] if e.get("team")}

    def window_start(self, path):
        """Return agentName, teamName, and UUID from the restored window root.

        Claude Code 2.1.220 selects the timestamp-latest user or assistant leaf
        named by any `last-prompt` record, walks `parentUuid` to the root, and
        adopts the root's complete identity pair. Restored identity and launch
        validation share this walk. A corrupt chain can trigger Claude Code's
        timestamp fallback, which lies outside this reconstruction.
        """
        records, leaves = {}, []
        try:
            handle = path.open(errors="replace")
        except OSError:
            return None
        with handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(rec, dict):
                    # The parent walk consumes object records with type, UUID, and
                    # parentUuid fields. Arrays, strings, and numbers stay outside
                    # that record set.
                    continue
                if rec.get("type") == "last-prompt":
                    # Preserve file order for the probe that distinguishes
                    # final-record selection from the loader's set-latest rule.
                    if rec.get("leafUuid") and rec["leafUuid"] not in leaves:
                        leaves.append(rec["leafUuid"])
                    continue
                if rec.get("uuid"):
                    records[rec["uuid"]] = (rec.get("parentUuid"),
                                            rec.get("agentName"), rec.get("teamName"),
                                            iso_ms(rec.get("timestamp")), rec.get("type"))
        candidates = [(ts, uuid) for uuid, (_p, _a, _t, ts, kind) in records.items()
                      if uuid in leaves and kind in ("user", "assistant")]
        if not candidates:
            return None
        cursor = max(candidates)[1]
        seen = set()
        while cursor in records and cursor not in seen:
            seen.add(cursor)
            parent = records[cursor][0]
            if parent is None:
                _p, name, team, _ts, _k = records[cursor]
                return (name, team, cursor) if name and team else None
            cursor = parent
        return None

    def restored_identity(self, path):
        """Return the window-start team and its restore state.

        `restored` means the stamped team roster loads and controls line stamps,
        spawns, and future restore. `stamped-team-missing` means the window-start
        team lacks a roster; launch argv can supply identity for that process life.
        None means the window start carries no complete identity pair.
        """
        start = self.window_start(path)
        if not start:
            return None, None
        _name, team, _uuid = start
        try:
            loads = self.roster_path(team).exists()
        except OSError:
            loads = False
        return team, ("restored" if loads else "stamped-team-missing")

    def live_led(self, stem):
        """Return teams led by this transcript that have live members.

        Placement consumes the complete list, and demotion uses it to preserve
        live team members.
        """
        return [t for t in self.teams_led_by(stem) if t in self.live_teams()]

    def demote_subject(self, selector):
        """(path, name, team) for the transcript a demote names.

        The engine picks the transcript and reads its identity; the verb only
        consumes the answer.
        """
        path = self.transcript_path(selector)
        if not path:
            return None, None, None
        fields, _ts = self._scan_transcript(path)
        return (path, fields.get("agentName", (None,))[0],
                fields.get("teamName", (None,))[0])

    def rebind_fragility(self, stem, team):
        """Return the compaction remedy for a temporary argv-based rebind.

        Recreating the stamped team would make window-start identity active again.
        Compaction under the destination team makes that identity durable.
        """
        path = self.transcript_path(stem) if stem else None
        stamped, state = (self.restored_identity(path) if path else (None, None))
        if state == "stamped-team-missing" and stamped and stamped != team:
            return (f"this conversation still restores with stamps naming {stamped}; "
                    f"recreating that team reactivates them. Run /compact under {team} "
                    "to make the destination identity durable. Mail works during the "
                    "current process life")
        return None

    def operative_team(self, path, worn):
        """Return operative team, certainty, and identity source for a resume.

        A loadable stamped team outranks argv. A missing stamped team lets argv
        supply identity. An unstamped window also uses argv when present.
        """
        team, state = self.restored_identity(path) if path else (None, None)
        if state == "restored":
            return team, True, "restored"
        if state == "stamped-team-missing":
            if worn:
                return worn, True, "stamped team missing; argv identity active"
            return None, False, "stamped team missing; plain session identity"
        if worn:
            return worn, True, "argv identity"
        return None, None, None

    def teams_with_live_evidence(self):
        """Return teams with a live process or undelivered mailbox state.

        Doctor uses this set for its default report; explicit selectors can still
        request other teams.
        """
        teams = {e["team"] for e in self.runtime()["live_sessions"] if e.get("team")}
        for team in self.known_teams():
            if team in teams:
                continue
            lead = self.agent_runtime(agent_id_of("team-lead", team))
            if lead["alive"] or any(n is None or n
                                      for n, _o in self.inbox_state(team).values()):
                teams.add(team)
        return teams

    def minted_by_a_resumed_life(self, team):
        """Return whether disk evidence identifies a resumed-process team.

        A fresh process records a `leadSessionId` that resolves to its transcript.
        A resumed process records its new internal ID, yielding an empty transcript
        lookup. The measured corpus contains 19 fresh-process relations and four
        resumed-process relations among 23 teams.
        """
        data = self.roster_of(team) or {}
        lead_session = data.get("leadSessionId")
        if not lead_session:
            return None
        return self.transcript_path(lead_session) is None

    def mint_candidates(self, pid, snapshot):
        """Return teams this process could have created.

        A fresh process derives its implicit team exactly from its session ID and
        roster. A resumed process draws candidates from teams whose leadSessionId
        carries a process-life ID.
        """
        entry = next((e for e in snapshot["live_sessions"] if e["pid"] == pid), None)
        session = (entry or {}).get("session")
        if session:
            derived = f"session-{session[:8]}"
            data = self.roster_of(derived) or {}
            if data.get("leadSessionId") == session:
                # The session ID and roster agree on the fresh implicit team.
                return {"teams": [derived], "kind": "own-session",
                        "why": "its own session id names this team"}
        pool = [t for t in self.known_teams()
                if self.minted_by_a_resumed_life(t)]
        return {"teams": pool, "kind": "resumed-life",
                "why": "the teams a resumed life could have minted"}

    def sole_mint_pairing(self, pid, snapshot):
        """The team only this process could have minted, or None if ambiguous.

        Unique in both directions. _boot_join warns when several processes fall
        in one team's window but returns them anyway, and it never asks whether
        one process falls inside several teams' windows, so neither direction is
        established by appearing in that list.
        """
        candidates = self.mint_candidates(pid, snapshot)
        pairs = [p for p in self._boot_join(snapshot)
                 if p[0] in candidates["teams"]]
        mine = {team for team, owner, _ in pairs if owner == pid}
        if len(mine) != 1:
            return None
        team = mine.pop()
        return team if {owner for t, owner, _ in pairs if t == team} == {pid} else None

    def is_claude(self, args):
        """Return whether argv starts with the configured Claude executable pattern."""
        return self._looks_like_claude_impl(args)

    def _looks_like_claude_impl(self, args):
        """Match on argv[0] only. A tmux server's own cmdline embeds the whole
        spawn command, so searching the full args counts the server as an agent."""
        argv0 = args.split(None, 1)[0] if args.strip() else ""
        return bool(CLAUDE_PROC.search(argv0))

    def _argv_pairs(self, args):
        """{"--flag value"} for each flag/value pair in a cmdline, both spellings.

        Exact pairs distinguish `--agent-id alpha@team` from
        `--agent-id alpha@team2`.
        """
        tokens = args.split()
        pairs = set()
        for index, token in enumerate(tokens):
            if not token.startswith("-"):
                continue
            if "=" in token:
                flag, _, value = token.partition("=")
                pairs.add(f"{flag} {value}")
            elif index + 1 < len(tokens):
                pairs.add(f"{token} {tokens[index + 1]}")
        return pairs

    def _own_lineage(self, table):
        """Return the caller PID and ancestors from the existing process table."""
        parents = {p: pp for p, pp, _ in table}
        pid, chain = os.getpid(), set()
        while pid and pid not in chain:
            chain.add(pid)
            pid = parents.get(pid)
        return chain

    def team_souls(self, team, entries=None):
        """Map team member names to resumable transcript resolutions.

        Cleanup and completion consume this shared answer so both classify the
        team from the same transcript search.
        """
        if entries is None:
            entries = self.roster_entries(team=team)
        souls = {}
        lead_session = entries[0]["leadSessionId"] if entries else None
        if lead_session:
            found = self.resolve_transcript(lead_session=lead_session, team=team, is_lead=True, quick=True)
            if found:
                souls["team-lead"] = found
        named = [entry["member"].get("name") for entry in entries]
        if not entries:
            # Transcript stamps preserve member identity after roster cleanup, so
            # rosterless teams still receive a member search.
            named = [stamped_name for stamped_name, stamped_team in self.stamp_index().values()
                     if stamped_team == team]
        for name in named:
            if name and name != "team-lead" and name not in souls:
                found = self.resolve_transcript(team=team, name=name, quick=True)
                if found:
                    souls[name] = found
        return souls

    class _Merged:
        """Field values from many sources; most recent wins."""

        def __init__(self):
            self.cands = defaultdict(list)

        def add(self, field, value, ts, source):
            if value in (None, ""):
                return
            self.cands[field].append((value, ts or 0, source))

        def pick(self, field):
            """Choose the newest candidate and preserve its bracketed variant.

            Recency selects the base value. A candidate beginning with that value
            plus `[` is a more specific spelling, such as `claude-opus-5[1m]`, so
            the longest such variant wins. Other longer strings remain distinct
            values. Merged non-model fields use plain tokens, and cwd reaches this
            fallback only when transcript and roster values are unavailable.
            """
            cands = self.cands.get(field)
            if not cands:
                return None, None, None
            value, ts, source = max(cands, key=lambda c: c[1])
            richer = ([c for c in cands if isinstance(c[0], str) and c[0].startswith(value + "[")]
                      if isinstance(value, str) else [])
            if richer:
                # Preserve the superseded base value in provenance so --explain
                # can render the Resolver decision directly.
                plainer = value
                value, ts, source = max(richer, key=lambda c: len(c[0]))
                source += f" (more specific than {plainer})"
            return value, ts, source

        def conflicts(self, field):
            return {c[0] for c in self.cands.get(field, [])}

    def place(self, res, typed_team, for_team=None, to_team=None, keep_team=False):
        """Return the launch team and placement reason.

        `to_team` and `for_team` are explicit destinations. `keep_team` preserves
        the addressed team. Otherwise a single team with live members wins over
        the addressed team. Several live teams require an explicit selection.
        """
        spoken = to_team or for_team
        if spoken:
            return spoken, "asked for"
        live_led = self.live_led(res.path.stem)
        if keep_team:
            if typed_team and live_led and typed_team not in live_led:
                warn(f"--keep-team: staying on {typed_team}, though this transcript's "
                     f"live members are on {', '.join(live_led)}; their mail goes "
                     f"unread while it runs as {typed_team}")
            return typed_team, "as typed"
        if len(live_led) > 1:
            die(f"this transcript leads {len(live_led)} teams with members running "
                f"({', '.join(live_led)}); name one with --team")
        if live_led and live_led[0] != typed_team:
            return live_led[0], (f"its live members are here; {typed_team} as addressed "
                                 f"has nobody running" if typed_team
                                 else "its live members are here")
        return typed_team, "as addressed"

    def identity(self, session_uuid=None, agent_id=None, for_team=None, to_team=None,
                 keep_team=False):
        """Resolve one transcript and merge its launch identity.

        Sources are roster entries, transcript fields, live argv, promotion
        receipts, lead spawn records, and lead-session lookup. Dated observations
        use newest-first precedence. An explicit complete identity or promotion
        receipt assigns the effective identity independently of those observations;
        spawn and roster launch fields are then selected for that assigned identity.

        Live argv sets agentId, agentName, and teamName together one millisecond
        after transcript activity because it describes the current process. Model
        selection preserves the longest bracketed variant of the winning base
        value. `place` selects the destination before the merge and removes source
        roster evidence after a team change. Lead spawn records provide structural
        team identity through `leads_team` and `lead_agent_id`.

        Callers consume `field`, `provenance`, `conflicts`, and judged objections.
        `enforce_ctx` applies those objections at the action boundary.
        """
        merged = self._Merged()
        leads_team = None
        team_entry = None
        source_team_entry = None
        transcript = None
        session_uuid = session_uuid
        others = []

        if agent_id:
            matches = self.roster_entries(agent_id=agent_id)
            if matches:
                team_entry = matches[0]
                if len(matches) > 1:
                    warn(f"{len(matches)} team configs claim {agent_id}; using {team_entry['cfg']}")
            else:
                warn(f"no team config lists {agent_id}; falling back to name@team parsing")

        team = name = None
        if team_entry:
            team, name = team_entry["team"], team_entry["member"].get("name")
        elif agent_id:
            name, team = name_and_team(agent_id)

        worn_id = agent_id_of(name, team) if name and team else None
        requested_name, requested_team = name_and_team(agent_id)
        explicit_identity = bool(requested_name and requested_team)
        # The harness reserves the name, so a lead is a lead whether or not a roster
        # survives to say so; without this a reaped team's lead is refused as a name
        # that lives in several rosters.
        is_lead_member = ((bool(team_entry) and team_entry["member"].get("agentId") == team_entry.get("leadAgentId"))
                          or name == "team-lead")
        res = self.resolve_transcript(
            session_uuid=session_uuid,
            lead_session=(team_entry.get("leadSessionId")
                          if is_lead_member and team_entry else None),
            team=team,
            name=name,
            is_lead=is_lead_member,
        )
        if not res:
            reason = res.reason
            if res.evidence.get("kind") in {
                    "promoted-ambiguity", "session-ambiguity"}:
                rows = [render_transcript_row(
                    path.stem, self.transcript_fact(path=path), limit=ABORT_TITLE)
                    for path in res.evidence["paths"]]
                reason += "\n" + "\n".join(f"  {row}" for row in rows)
            die(reason if res.answered else
                f"{reason}; a truly in-process agent leaves only a sidechain under the lead's "
                "subagents/ dir, which no CLI can resume")
        objections = self.objections(res, name, team)
        transcript = (res.path, res.fields, res.last_ts)
        others = [(p, f, t) for p, f, t in res.others]
        session_uuid = res.path.stem

        # What a promote wrote into this file when it made it. Read here, where
        # the file is known, so both the refusal below and the merge further
        # down work off one answer. Only the pair counts: half an identity places
        # nobody, and the receipt writes both halves or neither.
        receipt = self.receipt_carried_by(res.path)
        promoted_as = ((receipt.get("name"), receipt.get("team"))
                       if receipt and receipt.get("name")
                       and receipt.get("team") else None)

        # Placement precedes merging. A team change clears source-roster identity
        # while the spawn record still contributes appearance fields.
        placed, placed_why = self.place(res, team, for_team, to_team, keep_team)
        redirected = bool(placed and placed != team)
        if redirected:
            team, source_team_entry, team_entry = placed, team_entry, None

        assigned_agent_id = (agent_id if explicit_identity else
                             agent_id_of(*promoted_as) if promoted_as else None)
        if redirected and assigned_agent_id:
            assigned_name, _assigned_team = name_and_team(assigned_agent_id)
            assigned_agent_id = agent_id_of(assigned_name, team)

        # An explicit assignment or promotion receipt decides which roster may
        # contribute launch fields. A roster inferred from later transcript stamps
        # can still describe the conversation's former identity, but its model,
        # color, cwd, and parent do not belong to the assigned agent.
        if assigned_agent_id:
            entry_id = ((team_entry or {}).get("member") or {}).get("agentId")
            if entry_id and entry_id != assigned_agent_id:
                source_team_entry, team_entry = team_entry, None
            if not team_entry and not redirected:
                matches = self.roster_entries(agent_id=assigned_agent_id)
                team_entry = matches[0] if matches else None

        if not team_entry and not assigned_agent_id:
            # A uuid or a stranger's id adopts the roster the transcript names.
            stamped_team, stamped_name = res.stamped("teamName"), res.stamped("agentName")
            # A lead transcript can contain stamps from one team and spawn records
            # for several. An explicitly requested led team selects the relevant
            # spawn-record identity.
            asked = for_team or team
            leads_asked = bool(asked and asked != stamped_team
                               and asked in self.teams_led_by(session_uuid))
            if stamped_team and stamped_name and not leads_asked:
                matches = self.roster_entries(team=stamped_team, name=stamped_name)
                team_entry = matches[0] if matches else None
            elif not stamped_team or leads_asked:
                # Teammate identity requires both agent and team stamps. A lone name
                # can come from a named plain session or mismatched launch flags.
                # Spawn records provide structural lead identity and select the team
                # requested by the caller.
                led_teams_here = self.teams_led_by(session_uuid)
                # `--team` and the team component of an agent ID both identify the
                # team being reconstructed.
                wanted = for_team or team
                for led in ([wanted] if wanted in led_teams_here else led_teams_here):
                    matches = self.roster_entries(team=led, lead_only=True)
                    if matches:
                        team_entry = matches[0]
                        break
                    # Spawn records establish this transcript as the team lead even
                    # when the roster directory is absent. Store that structural fact
                    # in `leads_team`; roster reconstruction then writes
                    # team-lead@<team> independently of the session's display name.
                    leads_team = led
                    merged.add("teamName", led, res.last_ts, "spawn payloads in this transcript")
                    merged.add("agentName", "team-lead", res.last_ts, "spawn payloads in this transcript")
                    merged.add("agentId", agent_id_of("team-lead", led), res.last_ts, "spawn payloads in this transcript")
                    break
                else:
                    # Promotion receipts provide identity before the first launch.
                    # Other transcripts reaching this point have an empty complete-
                    # stamp result and zero spawn records, which identifies plain
                    # session history.
                    if not agent_id and not promoted_as:
                        die(
                            f"{res.path.name} contains plain session history: complete agent "
                            "stamps and teammate spawn records both resolve empty. Resume it "
                            "with plain `claude --resume`, or pass --agent-id to assign identity."
                        )

        # ---- team config contributions
        # Provenance names teams by team name and transcripts by session ID, matching
        # the object labels rendered by --explain.
        if team_entry:
            member, ts, src = (team_entry["member"], team_entry["ts"],
                               f"roster of {team_entry['team']}")
            merged.add("agentId", member.get("agentId"), ts, src)
            merged.add("agentName", member.get("name"), ts, src)
            merged.add("teamName", team_entry["team"], ts, src)
            merged.add("color", member.get("color"), ts, src)
            merged.add("agentType", member.get("agentType"), ts, src)
            merged.add("model", member.get("model"), ts, src)
            merged.add("cwd", member.get("cwd"), ts, src)
            merged.add("tmuxPaneId", member.get("tmuxPaneId"), ts, src)
            merged.add("backendType", member.get("backendType"), ts, src)
            merged.add("parentSessionId", team_entry["leadSessionId"], ts, src)
            if member.get("planModeRequired"):
                merged.add("permissionMode", "plan", ts, src)

        # ---- transcript contributions
        path, fields, last_ts = transcript
        src = f"transcript {path.stem}"
        for field, (value, ts) in fields.items():
            if not field.startswith("_"):
                merged.add(field, value, ts, src)
        if not merged.cands.get("agentId"):
            name = fields.get("agentName", (None,))[0]
            team = fields.get("teamName", (None,))[0]
            if name and team:
                merged.add("agentId", agent_id_of(name, team), last_ts, src + " (derived)")

        # ---- live argv sets the identity triple
        # A process that identifies this transcript supplies current --agent-id and
        # --team-name values. Add agentId, agentName, and teamName at one timestamp so
        # the launch cannot combine components from different sources. Other fields
        # retain ordinary merge precedence.
        if res.identity_from_argv() and worn_id:
            worn_name, worn_team = name_and_team(worn_id)
            argv_ts = last_ts + 1  # current process identity outranks transcript records
            merged.add("agentId", worn_id, argv_ts, "live argv")
            merged.add("agentName", worn_name, argv_ts, "live argv")
            merged.add("teamName", worn_team, argv_ts, "live argv")

        # ---- promotion receipt identity
        # Keep the receipt among merge candidates for explanations and conflicts.
        # The effective target separately treats its identity assignment as
        # authoritative, regardless of newer observations in this list.
        if promoted_as:
            merged.add("agentName", promoted_as[0], 0, "promote receipt")
            merged.add("teamName", promoted_as[1], 0, "promote receipt")
            merged.add("agentId", agent_id_of(*promoted_as), 0, "promote receipt")

        # ---- lead spawn record
        # Timestamp 0 places dated roster and transcript fields above the spawn
        # snapshot. The lookup uses an explicit or promoted identity when one was
        # assigned, so a conflicting later stamp cannot import another agent's
        # model, color, or parent.
        lookup_agent_id = assigned_agent_id or merged.pick("agentId")[0]
        record = self.spawn_payload(lookup_agent_id, merged.pick("parentSessionId")[0])
        if record:
            for key, field in SPAWN_FIELDS.items():
                merged.add(field, record.get(key), 0, "lead transcript spawn record")
            if record.get("plan_mode_required"):
                merged.add("permissionMode", "plan", 0, "lead transcript spawn record")

        # Team-directory cleanup removes leadSessionId. Resolver restores the parent
        # through its ordered roster, spawn-record, and name-prefix evidence.
        if not merged.cands.get("parentSessionId"):
            parent_team = (name_and_team(assigned_agent_id)[1] if assigned_agent_id
                           else merged.pick("teamName")[0])
            lead = self.lead_session_for(parent_team or "")
            if lead:
                merged.add("parentSessionId", lead, transcript[2], "engine: lead session for team")

        resolved_agent_id = merged.pick("agentId")[0]
        effective_agent_id = assigned_agent_id or resolved_agent_id
        effective_name = name_and_team(effective_agent_id)[0]
        table = self.process_table()
        runtime = (self.agent_runtime(
            effective_agent_id, table,
            parent_session=merged.pick("parentSessionId")[0])
            if effective_agent_id else None)
        holders = self.runtime(table)["transcripts"].get(
            session_uuid, {"session": session_uuid, "processes": [],
                           "others": [], "ours": []})
        if runtime and runtime["pid"]:
            merged.add("pid", runtime["pid"], int(time.time() * 1000), "process runtime")

        lead_agent_id = (agent_id_of("team-lead", leads_team) if leads_team
                         else team_entry["leadAgentId"] if team_entry
                         else effective_agent_id if effective_name == "team-lead" else None)
        ctx = {
            "merged": merged,
            "team_entry": team_entry,
            "other_transcripts": others,
            # A lead reached by rung 4 has no roster entry yet, so its own merged id
            # is the answer: the payloads that named its team also make it the lead.
            "lead_agent_id": lead_agent_id,
            "leads_team": leads_team,
            "placed": (placed, placed_why) if redirected else None,
            "runtime": runtime,
            "holders": holders,
            "seat": ({"state": runtime["seat_state"], "socket": runtime["socket"],
                      "pane": runtime["pane"]} if runtime else
                     {"state": "not running", "socket": None, "pane": None}),
            "pid": runtime["pid"] if runtime else None,
            "processes": runtime["processes"] if runtime else [],
            "to_team": to_team,
            # Carried out rather than looked up again: cwd resolution needs the
            # session this file was promoted out of, and a second read could
            # answer differently from the one the identity was built on.
            "receipt": receipt,
        }
        if source_team_entry:
            ctx["source_team_entry"] = source_team_entry
        identity_source = ("explicit --agent-id" if explicit_identity else
                           "promote receipt" if promoted_as else
                           merged.pick("agentId")[2])
        if redirected:
            identity_source = f"placement: {placed_why}"
        self.set_effective_identity(
            ctx, agent_id=effective_agent_id,
            parent=merged.pick("parentSessionId")[0], source=identity_source,
            transcript=res.transcript, fields=transcript[1], via=res.via,
            objections=objections)
        return ctx

    def _resolved_agent_cwd(self, ctx, path, fields):
        """Resolve cwd and any launch-only warning for the selected transcript.

        `/cd` can add several cwd values. Prefer the newest recorded cwd whose
        flattened path matches the transcript's project directory. Promotion keeps
        the main transcript beside its parent session, so the promotion receipt can
        supply a matching cwd from that parent transcript. A remaining candidate is
        used with a warning.

        Flattening maps all non-alphanumeric characters to `-`, making the project
        directory name non-invertible. In the measured corpus, 767 of 771
        transcripts with cwd records contain a matching value.
        """
        merged = ctx["merged"]
        trail = list(fields.get("_cwds", ([],))[0])
        roster_cwd = (ctx.get("team_entry") or {}).get("member", {}).get("cwd")
        candidates = trail + ([roster_cwd] if roster_cwd else [])
        project = path.parent.name

        consistent = [c for c in candidates if flatten_cwd(c) == project]
        if consistent:
            return consistent[-1], None
        inherited = self.promoted_from_cwds(ctx, path)
        if inherited:
            return inherited[-1], None
        if candidates:
            # The target carries the warning to the action boundary. A doctor uses
            # the same identity resolver but starts nothing, so it must not make a
            # launch claim merely by selecting a conversation.
            warning = (f"starting in {candidates[-1]}, the last directory this conversation "
                       f"ran in. Claude looks for a conversation only among the ones kept "
                       f"for the directory it starts in, and this conversation is kept "
                       f"under a different one, so the resume may not find it")
            return candidates[-1], warning
        fallback = merged.pick("cwd")[0]
        warning = (None if fallback else
                   "cwd evidence is empty, so the agent starts in the directory this command "
                   "was run from. Claude looks for a conversation only among the ones kept "
                   "for the directory it starts in, so the resume may not find it")
        return fallback or None, warning

    def promoted_from_cwds(self, ctx, path):
        """Return parent-session cwd values matching a promoted file's project dir.

        The promotion receipt identifies the parent transcript. Matching its cwd
        trail also verifies that the receipt and promoted file share a project
        directory.
        """
        parent = (ctx.get("receipt") or {}).get("parent")
        source = self.transcript_path(parent) if parent else None
        if not source:
            return []
        project = path.parent.name
        fields, _last = self._scan_transcript(source)
        return [c for c in fields.get("_cwds", ([],))[0] if flatten_cwd(c) == project]

    def set_effective_identity(self, ctx, agent_id=None, team=None, parent=None,
                               source="resolved identity", transcript=None,
                               fields=None, via=None, objections=None):
        """Set the one identity consumed by every launch and persistence path."""
        current = ((ctx.get("target") or {}).get("identity") or {})
        agent_id = agent_id or current.get("agentId") or ctx["merged"].pick("agentId")[0]
        name, current_team = name_and_team(agent_id)
        team = team or current_team
        if name and team:
            agent_id = agent_id_of(name, team)
        parent = (parent if parent is not None else current.get("parentSessionId")
                  or ctx["merged"].pick("parentSessionId")[0])
        stamp = max((candidate[1] or 0 for values in ctx["merged"].cands.values()
                     for candidate in values), default=0) + 1
        old_provenance = current.get("provenance", {})
        values = {
            "agentId": agent_id,
            "agentName": name,
            "teamName": team,
            "parentSessionId": parent,
        }
        provenance = {}
        for field, value in values.items():
            prior = (old_provenance.get(field) if current
                     else ctx["merged"].pick(field))
            authoritative = source.startswith("explicit") or source == "promote receipt"
            provenance[field] = (prior if prior[0] == value and not authoritative
                                 else (value, stamp, source))
        lead_id = ctx.get("lead_agent_id")
        identity = types.MappingProxyType({
            "agentId": agent_id, "agentName": name, "teamName": team,
            "parentSessionId": parent,
            "role": "lead" if name == "team-lead" or agent_id == lead_id else "member",
            "source": source,
            "provenance": types.MappingProxyType(provenance),
        })
        current_target = ctx.get("target") or {}
        fact = transcript or current_target.get("transcript")
        if fields is not None:
            cwd, cwd_warning = self._resolved_agent_cwd(ctx, fact["path"], fields)
            merged_cwd = ctx["merged"].pick("cwd")
            cwd_provenance = (merged_cwd if merged_cwd[0] == cwd else
                              (cwd, stamp, f"resolved cwd for transcript {fact['session']}"))
        else:
            cwd = current_target.get("cwd")
            cwd_warning = current_target.get("cwd_warning")
            cwd_provenance = current_target.get(
                "cwd_provenance", (cwd, stamp, "resolved cwd"))
        ctx["target"] = types.MappingProxyType({
            "session": fact["session"],
            "transcript": fact,
            "cwd": cwd,
            "cwd_warning": cwd_warning,
            "cwd_provenance": cwd_provenance,
            "identity": identity,
            "via": via if via is not None else current_target.get("via"),
            "objections": (tuple(objections) if objections is not None
                           else current_target.get("objections", ())),
        })
        entry = ctx.get("team_entry")
        entry_id = ((entry or {}).get("member") or {}).get("agentId")
        if entry_id and entry_id != agent_id:
            ctx.setdefault("source_team_entry", entry)
            ctx["team_entry"] = None
        return identity

    def field(self, ctx, name):
        """Return one target field while keeping merge precedence private."""
        target = ctx.get("target") or {}
        identity = target.get("identity")
        if identity and name in IDENTITY_FIELDS:
            return identity.get(name)
        if name == "cwd" and "cwd" in target:
            return target["cwd"]
        return ctx["merged"].pick(name)[0]

    def provenance(self, ctx, name):
        """Return the effective value, timestamp, and source for --explain."""
        target = ctx.get("target") or {}
        identity = target.get("identity")
        if identity and name in IDENTITY_FIELDS:
            return identity["provenance"][name]
        if name == "cwd" and "cwd_provenance" in target:
            return target["cwd_provenance"]
        return ctx["merged"].pick(name)

    def objections(self, res, want_name, want_team):
        """Return typed contradictions between transcript and requested identity.

        `enforce_identity` applies `--force` and rebind rules to these facts at the
        action boundary.
        """
        stamped_name, stamped_team = res.stamped("agentName"), res.stamped("teamName")
        objections = []

        if stamped_name is None:
            # Unstamped means a lead transcript. Only an exact rung may claim one.
            if res.strength < EXACT:
                objections.append(("unstamped_below_exact", None, None, res.via))
            return objections

        if want_name and stamped_name != want_name:
            # Name mismatch always remains an objection because Claude Code stamps
            # the launch name onto every later line. Corroboration is included so
            # the refusal can name the appropriate remedy.
            corroborated = bool(res.evidence.get("corroborated"))
            objections.append(("name_mismatch", stamped_name, want_name,
                               f"{res.via}|corroborated" if corroborated else res.via))

        if want_team and stamped_team and stamped_team != want_team:
            # Rebinding can tolerate a stale team stamp when a unique name or live
            # argv identifies the requested agent.
            tolerated = (res.strength == NAME_ONLY or res.identity_from_argv())
            why = "tolerated" if tolerated else res.via
            if not tolerated:
                # A transcript that was a teammate first and later led another team
                # carries stamps from the earlier life and payloads from the newer
                # one. Which came first decides what an override means, so the
                # relation is measured rather than left for the reader to guess.
                stamped_ts = res.fields.get("teamName", (None, 0))[1]
                claimed_ts = max((stamp for stamp, payload in self._log(res.path.stem)
                                  if payload.get("team_name") == want_team), default=0)
                if stamped_ts and claimed_ts > stamped_ts:
                    why += "|newer"
            objections.append(("team_mismatch", stamped_team, want_team, why))
        return objections

    def classify(self, token):
        """Classify a selector as UUID, agent ID, team, name, ambiguity, or unknown.

        Ambiguous results include candidates so callers can render live state while
        Resolver retains the classification decision.
        """
        if UUID_RE.match(token):
            return "uuid", token, "a session uuid"
        if "@" in token:
            return "agent_id", token, "a full agent id"
        team_why = self.team_evidence(token)
        if team_why:
            return "team", token, team_why
        if implicit_team_block(token):
            return ("unknown", None,
                    "matches implicit-team syntax; roster, spawn-record, and transcript-stamp "
                    "searches all returned empty")
        matches = self.roster_entries(name=token)
        teams = {entry["team"] for entry in matches}
        if len(teams) > 1:
            found = self.resolve_transcript(name=token)
            if found:
                return "name", found, (f"carried by {len(teams)} rosters but matched by one "
                                        f"transcript ({found.via})")
            return "ambiguous", matches, f"in {len(teams)} rosters"
        if matches:
            return "agent_id", matches[0]["member"].get("agentId"), "the only roster naming it"
        found = self.resolve_transcript(name=token)
        if found:
            return "name", found, f"matched by transcript ({found.via})"
        return "unknown", None, f"roster search returned empty: {found.reason}"

    def roster_entries(self, agent_id=None, name=None, team=None, lead_only=False):
        """Return matching roster entries in newest-first evidence order."""
        found = [
            entry for entry in self.scan_teams()
            if (agent_id is None or entry["member"].get("agentId") == agent_id)
            and (name is None or entry["member"].get("name") == name)
            and (team is None or entry["team"] == team)
            and (not lead_only or entry["member"].get("agentId") == entry.get("leadAgentId"))
        ]
        found.sort(key=lambda entry: entry["ts"], reverse=True)
        return found

    def rosters(self):
        """Return parsed team configs with path and millisecond mtime.

        This is the shared roster parser. Reads stay uncached because roster
        reconstruction can occur during the run and later resolution must observe
        the new file.
        """
        out = []
        for cfg in (self.roster_path(d.name) for d in self.team_dirs()):
            try:
                data = json.loads(cfg.read_text())
            except (OSError, ValueError):
                continue
            try:
                mtime = int(cfg.stat().st_mtime * 1000)
            except OSError:
                mtime = 0
            out.append((cfg, data, mtime))
        return out

    def roster_of(self, team):
        """One team's parsed roster, or None."""
        return next((data for cfg, data, _ in self.rosters()
                     if (data.get("name") or cfg.parent.name) == team), None)

    def scan_teams(self):
        """Every member of every team config, newest-first metadata attached."""
        entries = []
        for cfg, data, mtime in self.rosters():
            for member in data.get("members", []):
                entries.append(
                    {
                        "cfg": cfg,
                        "team": data.get("name") or cfg.parent.name,
                        "leadSessionId": data.get("leadSessionId"),
                        "leadAgentId": data.get("leadAgentId"),
                        "member": member,
                        "ts": member.get("joinedAt") or data.get("createdAt") or mtime,
                    }
                )
        return entries

    def _scan_transcript(self, path):
        """(fields, last_activity_ms) from one session JSONL."""
        fields = {}
        try:
            mtime = int(path.stat().st_mtime * 1000)
        except OSError:
            return {}, 0  # the harness rewrites this tree while we read it
        last_ts = first_ts = 0
        headers = []
        cwds = []

        def put(key, value, ts):
            if value in (None, ""):
                return
            if key not in fields or ts >= fields[key][1]:
                fields[key] = (value, ts)

        try:
            handle = path.open(errors="replace")
        except OSError:
            return {}, mtime
        with handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                # Sidechain and materialized-parent records remain model context,
                # but neither contributes actions or identity to this transcript.
                if rec.get("isSidechain") or not self.authored_here(path, rec):
                    continue
                ts = iso_ms(rec.get("timestamp"))
                if ts:
                    last_ts = max(last_ts, ts)
                    first_ts = first_ts or ts
                kind = rec.get("type")
                # header records carry no timestamp; stamp them with the first real one
                if kind == "agent-setting":
                    headers.append(("agentType", rec.get("agentSetting")))
                elif kind == "permission-mode":
                    headers.append(("permissionMode", rec.get("permissionMode")))
                elif kind == "mode":
                    headers.append(("mode", rec.get("mode")))
                for key in ("teamName", "agentName", "cwd", "version", "gitBranch", "effort"):
                    if rec.get(key) is None:
                        continue
                    if key == "agentName" and kind == "agent-name":
                        # The harness's label channel, not an identity stamp. Its
                        # value is a display name or a session title, and reading it
                        # as agentName is how a label reached --agent-name, got
                        # compared against rosters, and raised mismatch objections
                        # against agents that were never called that.
                        put("_label", rec[key], ts or mtime)
                        continue
                    put(key, rec[key], ts or mtime)
                if rec.get("cwd") and (not cwds or cwds[-1] != rec["cwd"]):
                    cwds.append(rec["cwd"])  # /cd moves it mid-session; keep the trail
                msg = rec.get("message")
                model = msg.get("model") if kind == "assistant" and isinstance(msg, dict) else None
                if model and not model.startswith("<"):
                    put("model", model, ts or mtime)  # skip "<synthetic>" error stubs

        for key, value in headers:
            put(key, value, first_ts or mtime)
        if cwds:
            fields["_cwds"] = (cwds, last_ts or mtime)  # underscore keys stay out of the merge
        return fields, (last_ts or mtime)

    def lead_holders(self, session_uuid, table):
        """Return external and caller-lineage holders of a lead transcript.

        Flag-bound leads appear through `--resume` argv. Plain leads resumed from
        the picker appear through the session registry. This method merges both and
        applies the caller-lineage split to registry rows.
        """
        holders = self.runtime(table)["transcripts"].get(
            session_uuid, {"session": session_uuid, "processes": [],
                           "others": [], "ours": []})
        others = [row["pid"] for row in holders["others"]]
        ours = [row["pid"] for row in holders["ours"]]
        owner = self.runtime(table)["best_by_session"].get(session_uuid)
        if owner and owner["alive"] and owner["pid"] not in others and owner["pid"] not in ours:
            (ours if owner.get("ours") else others).append(owner["pid"])
        return others, ours

    def _session_registry(self):
        """Raw session observations, read once by the runtime snapshot."""
        if self._registry is not None:
            return self._registry
        entries = []
        for path in SESSIONS_DIR.glob("*.json"):
            try:
                data = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if data.get("pid"):
                entries.append(dict(data))
        self._registry = entries
        return entries

    def configured_teammate_mode(self):
        """Return `teammateMode` from settings, or None for unavailable input.

        `install_hook` owns settings edits; runtime callers consume this parsed
        answer.
        """
        try:
            return json.loads((CLAUDE_DIR / "settings.json").read_text()).get("teammateMode")
        except (OSError, ValueError):
            return None

    def socket_dir(self):
        """Where tmux keeps its socket files. A path question, like roster_path."""
        return Path(os.environ.get("TMUX_TMPDIR") or f"/tmp/tmux-{os.getuid()}")

    def socket_alive(self, socket):
        """Return whether a tmux server accepts a connection on this socket.

        The AF_UNIX probe takes microseconds and supplies one liveness answer to
        cleanup and launch code.
        """
        path = socket if isinstance(socket, Path) else self.socket_dir() / socket
        probe = socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM)
        probe.settimeout(0.2)
        try:
            probe.connect(str(path))
            return True
        except (ConnectionRefusedError, FileNotFoundError):
            return False
        except OSError:
            return True  # ambiguous: assume live rather than reap or clobber
        finally:
            probe.close()

    def swarm_sockets(self):
        """Swarm socket files, newest first. The one place that directory is listed."""
        return sorted(self.socket_dir().glob(f"{SOCKET_PREFIX}*"),
                      key=lambda p: p.stat().st_mtime, reverse=True)

    def newest_live_socket(self):
        """The most recently touched swarm socket with a server behind it."""
        for path in self.swarm_sockets():
            if self.socket_alive(path):
                return path.name
        return None

    def dead_sockets(self):
        """Swarm socket files with no server behind them, and old enough to say so.

        A socket younger than the grace is not evidence of anything: a server
        mid-bind has a file and no listener yet, and reaping it takes the
        server's name out from under it. Age is the whole of the difference,
        so it is judged here rather than by whoever does the unlinking.
        """
        stale = []
        now = time.time()
        for path in self.swarm_sockets():
            try:
                if now - path.stat().st_mtime < SOCKET_GRACE_S:
                    continue
            except OSError:
                continue
            if not self.socket_alive(path):
                stale.append(path)
        return stale

    def swarm_session_live(self, socket):
        """Is the swarm session actually up on this socket? Server plus session:
        a live server with no claude-swarm session still needs one created."""
        return bool(socket) and self.socket_alive(socket) and tmux(
            socket, "has-session", "-t", TMUX_SESSION).returncode == 0

    def attached_clients(self, socket):
        """How many tmux clients are watching the swarm session on this socket."""
        result = tmux(socket, "list-clients", "-t", TMUX_SESSION)
        return len([line for line in result.stdout.splitlines() if line]) if result.returncode == 0 else 0

    def socket_state(self, socket):
        """What is actually true of this socket right now.

        The `how` label a caller carries only says where the name came from.
        Printed alone, a derived name reads as a running server that may
        already be gone.
        """
        if not socket:
            return "unresolved"
        # The state, not a promise: whether anything gets created is the
        # launch's to say, and a run that noops creates nothing.
        if not self.socket_alive(socket):
            return "no server"
        if not self.swarm_session_live(socket):
            return f"server up, no {TMUX_SESSION} session"
        clients = self.attached_clients(socket)
        return f"live, {clients} client{'' if clients == 1 else 's'} attached"

    def list_panes(self, socket):
        """Return tmux pane rows as session, window, pane, and PID fields.

        A failed tmux query returns an empty pane result.
        """
        res = tmux(socket, "list-panes", "-a", "-F",
                   "#{session_name}\t#{window_id}\t#{pane_id}\t#{pane_pid}")
        if res.returncode != 0:
            return []
        panes = []
        for line in res.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) == 4 and parts[3].isdigit():
                panes.append({"session": parts[0], "window": parts[1],
                              "pane": parts[2], "pid": int(parts[3])})
        return panes

    def pane_exists(self, socket, pane):
        """Return whether this server currently lists the pane ID."""
        return bool(pane) and any(p["pane"] == pane for p in self.list_panes(socket))

    def descendants_of(self, root_pid, table=None):
        """Every live pid under this one, as a question rather than a transform.

        A caller asking what it started asks this, so what counts as under a
        process is decided in one place. The suite asks it to tell the
        processes a run made from the ones the machine was already running.
        """
        return self._descendants(root_pid, self.process_table() if table is None else table)

    def _descendants(self, root_pid, table):
        """Return descendant PIDs from an existing process-table snapshot."""
        kids = defaultdict(list)
        for pid, ppid, _ in table:
            kids[ppid].append(pid)
        seen, stack = set(), [root_pid]
        while stack:
            pid = stack.pop()
            if pid in seen:
                continue
            seen.add(pid)
            stack.extend(kids.get(pid, []))
        return seen

    def _seat_index(self, table):
        """{pid: (socket, pane)} for one process-table snapshot.

        Tmux supplies each pane's root PID. Every process below that root belongs
        to the pane, regardless of intervening shells or launch wrappers. Socket
        and pane are recorded together. The index is computed once for the exact
        process-table object shared by one resolution pass.
        """
        if table is self._seat_table and self._seats is not None:
            return self._seats
        seats = {}
        for path in self.swarm_sockets():
            socket = path.name if isinstance(path, Path) else Path(path).name
            if not self.socket_alive(socket):
                continue
            for pane in self.list_panes(socket):
                for pid in self._descendants(pane["pid"], table):
                    seats.setdefault(pid, (socket, pane["pane"]))
        self._seat_table = table
        self._seats = seats
        return seats

    def runtime(self, table=None):
        """One canonical runtime snapshot, limited to the declared evidence."""
        table = self.process_table() if table is None else table
        if table is self._runtime_table and self._runtime_snapshot is not None:
            return self._runtime_snapshot
        want_registry = self.needs[NEED.REGISTRY] is not DECLARED.ABSENT
        want_seats = self.needs[NEED.SEATS] is not DECLARED.ABSENT
        seats = self._seat_index(table) if want_seats else {}
        if want_seats:
            self._exercise(NEED.SEATS)
        lineage = self._own_lineage(table)
        by_pid = {}
        for pid, ppid, args in table:
            socket, pane = seats.get(pid, (None, None))
            pairs = self._argv_pairs(args) if self.is_claude(args) else ()
            session = next((pair.partition(" ")[2] for pair in pairs
                            if pair.startswith("--resume ")), None)
            agent_id = next((pair.partition(" ")[2] for pair in pairs
                             if pair.startswith("--agent-id ")), None)
            by_pid[pid] = {"pid": pid, "ppid": ppid, "args": args,
                           "alive": True, "ours": pid in lineage,
                           "agent_id": agent_id, "session": session,
                           "team": name_and_team(agent_id)[1] if agent_id else None,
                           "socket": socket, "pane": pane, "registry": [],
                           "updated": 0, "started": 0}

        observations = []
        if want_registry:
            self._exercise(NEED.REGISTRY)
            for data in self._session_registry():
                alive = self.pid_alive(data["pid"], data.get("procStart"))
                observation = types.MappingProxyType({
                    "pid": data["pid"], "session": data.get("sessionId"),
                    "updated": data.get("updatedAt") or 0,
                    "started": data.get("startedAt") or 0, "alive": alive})
                observations.append(observation)
                record = by_pid.get(data["pid"])
                if alive and record is None:
                    record = by_pid[data["pid"]] = {
                        "pid": data["pid"], "ppid": None, "args": "",
                        "alive": True, "ours": data["pid"] in lineage,
                        "agent_id": None, "session": None, "team": None,
                        "socket": None, "pane": None, "registry": [],
                        "updated": 0, "started": 0}
                if alive:
                    record["registry"].append(observation)
                    record["session"] = record["session"] or observation["session"]
                    record["updated"] = max(record["updated"], observation["updated"])
                    record["started"] = max(record["started"], observation["started"])

        for record in by_pid.values():
            record["transcript"] = (self.transcript_fact(record["session"])
                                    if record["session"] else None)
        by_pid = {pid: types.MappingProxyType(
            {**record, "registry": tuple(record["registry"])})
            for pid, record in by_pid.items()}
        by_agent = defaultdict(list)
        by_transcript = defaultdict(list)
        by_pane = defaultdict(list)
        by_session = defaultdict(list)
        live_session_records = []
        for record in by_pid.values():
            if record["agent_id"]:
                by_agent[record["agent_id"]].append(record)
            if record["session"]:
                by_transcript[record["session"]].append(record)
                by_session[record["session"]].append(record)
            if record["socket"] and record["pane"]:
                by_pane[(record["socket"], record["pane"])].append(record)
            if record["session"] or record["agent_id"] or record["registry"]:
                live_session_records.append(record)
        for observation in observations:
            if observation["session"]:
                by_session[observation["session"]].append(observation)
        best_by_session = {}
        for session, rows in by_session.items():
            best_by_session[session] = max(
                rows, key=lambda row: (1 if row["alive"] else 0,
                                       row.get("updated") or 0))

        transcripts = {
            session: types.MappingProxyType(
                {"session": session,
                 "fact": next((row["transcript"] for row in rows
                               if row["transcript"]), None),
                 "processes": tuple(rows),
                 "others": tuple(row for row in rows if not row["ours"]),
                 "ours": tuple(row for row in rows if row["ours"])})
            for session, rows in by_transcript.items()}
        snapshot = types.MappingProxyType({
            "records": tuple(by_pid.values()),
            "by_pid": types.MappingProxyType(by_pid),
            "by_agent": types.MappingProxyType(
                {key: tuple(rows) for key, rows in by_agent.items()}),
            "by_transcript": types.MappingProxyType(
                {key: tuple(rows) for key, rows in by_transcript.items()}),
            "transcripts": types.MappingProxyType(transcripts),
            "by_session": types.MappingProxyType(
                {key: tuple(rows) for key, rows in by_session.items()}),
            "best_by_session": types.MappingProxyType(best_by_session),
            "by_pane": types.MappingProxyType(
                {key: tuple(rows) for key, rows in by_pane.items()}),
            "registry": tuple(observations),
            "live_sessions": tuple(live_session_records),
        })
        self._runtime_table = table
        self._runtime_snapshot = snapshot
        return snapshot

    def seat_note(self, recorded, socket):
        """(pane to aim at, pane line for the report), from a roster's memory.

        A pane id is per-server: a recorded one is a fact only while its server
        runs and still carries it. Anything else aims the launch at nothing and
        reads as a seat the agent does not have, so the report says what became
        of the record instead of echoing it. The two halves travel together for
        that reason: a caller handed only the id could print a seat nothing
        confirmed.
        """
        if self.pane_exists(socket, recorded):
            return recorded, recorded
        if recorded:
            return None, f"(none: recorded {recorded} is gone from {socket})"
        return None, "(none recorded)"

    def current_tmux(self):
        """(socket name, pane id) of the pane we are running in, or (None, None).

        $TMUX is "<socket path>,<server pid>,<session index>", so the socket we
        are inside is knowable without asking tmux anything.
        """
        inside = os.environ.get("TMUX")
        if not inside:
            return None, None
        return Path(inside.split(",")[0]).name, os.environ.get("TMUX_PANE")

    def current_terminal_note(self):
        """Describe the terminal that an in-place launch will replace."""
        socket, pane = self.current_tmux()
        if socket and pane:
            return f"in this terminal, tmux pane {pane} on {socket}"
        if socket:
            return f"in this terminal, inside tmux on {socket} (pane id unavailable)"
        return "in this terminal, outside tmux"

    def inside_tmux(self):
        """Are we inside a tmux pane at all? The cheap half of current_tmux,
        for a caller that needs the yes or no and not the names."""
        return bool(os.environ.get("TMUX"))

    def crew_sockets(self, team, table):
        """{socket: [agent ids]} for every live server this team's crew sits on.

        Usually one. More than one is the split a revived lead produces by
        existing: a server is named after its lead's pid, so a lead that comes
        back with a new pid spawns onto a server its old crew is not on. The
        seat question wants the first (crew_socket); a report that claims one
        server while the crew is on two is the kind of half-answer this file
        keeps deleting, so it is asked and answered whole.
        """
        seats = {}
        for entry in sorted(self.runtime(table)["live_sessions"],
                            key=lambda e: e.get("agent_id") or ""):
            if entry.get("team") != team or not entry.get("agent_id"):
                continue
            sock, _why = self.socket_hosting([entry["agent_id"]], table)
            if sock:
                seats.setdefault(sock, []).append(entry["agent_id"])
        return seats

    def crew_socket(self, team, table):
        """(socket, why) for the server this team's crew is already sitting on.

        The crew is every agent wearing this team in argv, which is neither the
        roster's member list nor the resumed agent alone. A roster can miss a
        member that is running, and one agent is not a crew: asking only about
        itself sends a relaunched member to a server of its own while its
        siblings sit together, and asking only the roster misses whoever the
        roster never heard of.
        """
        if not team:
            return None, ""
        crew = sorted(e.get("agent_id")
                      for e in self.runtime(table)["live_sessions"]
                      if e.get("team") == team and e.get("agent_id"))
        return self.socket_hosting(crew, table)

    def socket_hosting(self, agent_ids, table):
        """Return the live tmux socket already hosting any selected agent.

        Agent runtime owns process placement. This selection only chooses the
        first externally running agent that runtime resolved into a pane.
        """
        for agent_id in agent_ids:
            if not agent_id:
                continue
            for process in self.agent_runtime(agent_id, table)["other_processes"]:
                if process["socket"]:
                    return (process["socket"],
                            f"live pane {process['pane']} of pid {process['pid']}")
        return None, None

    def _spawn_by_agent(self):
        """{"name@team": payload} for every teammate any lead ever spawned.

        A member's colour, agent type and full model live in the roster, and the
        roster dies with its team. The lead that spawned it recorded all three, so
        this is where they survive. Only the transcripts that mention a spawn are
        read, which is a fraction of the tree.
        """
        if self._by_agent is not None:
            return self._by_agent
        self._by_agent = {}
        leads = self._grep_files(SPAWN_MARKER, [self.projects_dir], True) or []
        self._ingest_spawn_lines(leads)
        for path in leads:
            for _, payload in self._log(path.stem):
                name, team = payload.get("name"), payload.get("team_name")
                if name and team:
                    self._by_agent[agent_id_of(name, team)] = payload
        return self._by_agent

    def spawn_payload(self, agent_id, lead_session=None):
        """The harness's spawn record for an agent, wherever it survives.

        The single lookup for both the merge and the completion display, so an
        agent cannot be offered in one colour and launched in another. Cheap path
        first, the lead transcript the roster names; then the cross-file index,
        which is the only route once a team is named after a boot uuid whose
        transcript does not exist.
        """
        if not agent_id:
            return {}
        # Keyed on name and team together: a lead that respawns a name into a later
        # team holds a payload for each, and the name alone returns whichever came
        # last, which is the wrong life's colour and model.
        name, team = name_and_team(agent_id)
        if lead_session and team:
            found = next((payload for payload in self.members_spawned_into(lead_session, team)
                          if payload.get("name") == name), None)
            if found:
                return found
        return self._spawn_by_agent().get(agent_id, {})

    def _spawn_records(self, lead_session):
        """{name: spawn payload} from the lead's transcript.

        Spawning a teammate writes the harness's whole payload into the lead's
        conversation: type, model with its [1m] suffix, color, pane id, prompt. That
        makes it the last-resort source for anything the roster would have held,
        and the only surviving one once a team dir is deleted, since no teammate
        transcript records its own color.
        """
        if not lead_session:
            return {}
        if lead_session in self._spawns:
            return self._spawns[lead_session]
        path = self.transcript_path(lead_session)
        self._ingest_spawn_lines([path] if path else [])
        return self._spawns.setdefault(lead_session, {})

    def stamp_index(self):
        """{path: (agentName, teamName)} for every stamped transcript, built once.

        Reads a bounded window of each file rather than grepping: every line carries
        the stamps, so the tail answers it, and the tail is also the *current* pair
        after a rebind. A file stamped only mid-history is missed here, which is why
        this powers path-only lookups and never resolution (verify=True greps whole
        files). Grep is the wrong tool for the index: -m1 exits early on stamped
        files but scans every byte of the unstamped ones, and this tree holds 2GB of
        those, which cost 1.7s per pass.

        `type: "agent-name"` lines are skipped. They carry a display label rather
        than an identity, and the label is free text: real ones on this machine
        include "resume agent dev old" and a whole sentence of task description.
        Matching bytes without regard to the record they sit in read those as the
        agent's name, so a transcript stamped team-lead on nine hundred lines
        answered with a title from one line at its tail, and everything downstream
        inherited it.
        """
        self._exercise(NEED.STAMPS)
        if self._stamps is not None:
            return self._stamps
        index = {}
        carried = self.carried_receipts()
        for path in self.projects_dir.glob("*/*.jsonl"):
            copied = frozenset((carried.get(path) or {}).get("prefix_uuids") or ())
            if copied:
                fields, _last = self._scan_transcript(path)
                name = fields.get("agentName", (None,))[0]
                team = fields.get("teamName", (None,))[0]
                if name or team:
                    index[path] = (name, team)
                continue
            try:
                size = path.stat().st_size
                with path.open("rb") as handle:
                    tail_at = max(0, size - INDEX_CHUNK)
                    if tail_at:
                        handle.seek(tail_at)
                    tail = handle.read(INDEX_CHUNK)
                    stamps = _stamps_in(tail)
                    if not stamps and tail_at:  # a session stamped only after a resume
                        handle.seek(0)
                        stamps = _stamps_in(handle.read(INDEX_CHUNK))
            except OSError:
                continue
            if stamps:
                index[path] = (
                    (stamps.get(b"agentName") or b"").decode("utf-8", "replace") or None,
                    (stamps.get(b"teamName") or b"").decode("utf-8", "replace") or None,
                )
        self._stamps = index
        return self._stamps

    def carried_receipts(self):
        """{path: last in-file receipt} for promoted main transcripts.

        This is the corpus-wide conversion census. A literal search narrows the
        main transcript tree first; only matching files are parsed backward to
        validate the record and select the last receipt. Search failure keeps the
        old full scan as the correctness fallback, while zero matches means zero.
        """
        self._exercise(NEED.CONVERSION_CENSUS)
        if self._carried is None:
            marker = f'"type":"{RECEIPT_RECORD}"'
            candidates = self._grep_files(marker, [self.projects_dir], True)
            if candidates is None:
                candidates = list(self.projects_dir.glob("*/*.jsonl"))
            found = {}
            for path in candidates:
                receipt = self.receipt_carried_by(path)
                if receipt:
                    found[path] = receipt
            self._carried = found
        return self._carried

    def receipt_carried_by(self, path):
        """The canonical parsed conversion receipt for one transcript, or None."""
        path = Path(path)
        if path not in self._receipts:
            known = self._carried.get(path) if self._carried is not None else None
            self._receipts[path] = known or self.rewriter.receipt_in_file(path)
        return self._receipts[path]

    def copied_prefix_uuids(self, path):
        """UUIDs copied from a parent into this promoted transcript."""
        self._exercise(NEED.CONVERSION_CENSUS)
        path = Path(path)
        if path not in self._copied_prefixes:
            receipt = self.receipt_carried_by(path)
            prefix = receipt.get("prefix_uuids") if receipt else None
            self._copied_prefixes[path] = frozenset(prefix or ())
        return self._copied_prefixes[path]

    def authored_here(self, path, record):
        """Whether this record is an action authored by this transcript."""
        uuid = record.get("uuid")
        return not uuid or uuid not in self.copied_prefix_uuids(path)

    def team_for_parent_session(self, session):
        """(team, evidence) for the team a side transcript's current parent led.

        The directory containing a side transcript says who owns it now. That
        parent can differ from the fork-context-ref's history source after a
        demote, so promotion asks this session rather than the reference record.
        A live parent answers from the identity it operates as. Otherwise the
        newest spawn payload says which team it led when it last created a
        teammate; restored window-start stamps are the remaining exact record.
        """
        snapshot = self.runtime()
        live = snapshot["best_by_session"].get(session)
        if live and live["alive"]:
            team, exact = self.team_minted_by(live["pid"], snapshot)
            if team and exact:
                return team, f"live parent pid {live['pid']}"
        led = self.teams_led_by(session)
        if led:
            return led[0], "the parent's newest teammate spawn"
        path = self.transcript_path(session)
        if path:
            team, state = self.restored_identity(path)
            if team and state == "restored":
                return team, "the parent's restored identity"
        return None, "no live identity, teammate spawn, or restored identity names its team"

    def team_lead_transcript(self, team):
        """(path, evidence) for the main transcript that leads this team."""
        path, why = self.lead_transcript_for(team)
        return (path, why) if path else (None, why)

    def team_lead_session(self, team):
        """The session id a team names as its lead's, via the roster reader."""
        return next((e["leadSessionId"] for e in self.scan_teams() if e["team"] == team), None)

    def team_minted_by(self, pid, snapshot):
        """Return operative team and evidence certainty for a live process.

        Exact evidence comes from restored identity, argv, current-life spawn
        records, or a fresh session-to-roster relation. A unique boot-time pairing
        supplies corroborated evidence. Team creation may occur at boot or at first
        spawn, so timing remains advisory.
        """
        entry = next((e for e in snapshot["live_sessions"] if e["pid"] == pid), None)
        if entry:
            path = self.transcript_path(entry["session"]) if entry.get("session") else None
            team, exact, state = self.operative_team(path, entry.get("team"))
            if state == "restored":
                # Restored window-start identity controls line stamps, spawns, and
                # future restore. The process record separately carries argv routing.
                return team, True
            if state == "stamped team missing; plain session identity":
                # A mint record must not be read as the team an identity-less
                # session operates as.
                return None, False
        if entry and entry.get("team"):
            # A flag-bound lead states the team it runs as, in its own argv.
            return entry["team"], True
        if entry and entry.get("session"):
            # Spawn records written after process start identify the current team.
            # Earlier process lives in the same transcript can name previous teams.
            started = entry.get("started")
            for stamp, payload in reversed(self._log(entry["session"])):
                # Process start time separates current-life spawn records from
                # earlier records in the same transcript.
                if payload.get("team_name") and started and stamp >= started:
                    return payload["team_name"], True
        # Fresh session and roster identity precede timing. Resumed-process
        # candidates come from process-life leadSessionId relations, then require a
        # unique boot-time pairing. Teams created at first spawn can fall outside the
        # timing interval and therefore return an unknown result.
        candidates = self.mint_candidates(pid, snapshot)
        if candidates["kind"] == "own-session":
            return candidates["teams"][0], True
        paired = self.sole_mint_pairing(pid, snapshot)
        if paired:
            return paired, False
        return next((team for team, owner, _ in self._boot_join(snapshot)
                     if owner == pid and team in candidates["teams"]), None), False

    def agent_diagnosis(self, agent_id, parent_session=None, team_state=None):
        """Return composed lead, member, team, and mailbox status.

        Team identity uses structural roster, transcript, spawn, and process
        records. `spawn_parent_of` remains a separate question used by the printed
        dossier, keeping ordinary verdicts independent of the full spawn corpus.
        A doctor passes its canonical team runtime so every dossier uses the exact
        member and lead process answers already printed in the team report.
        """
        name, team = name_and_team(agent_id)
        if team_state is not None:
            member_runtime = (team_state["runtimes"].get(name)
                              or self.agent_runtime(agent_id))
            lead = team_state["lead"]
        else:
            member_runtime = self.agent_runtime(
                agent_id, parent_session=parent_session if name == "team-lead" else None)
            lead = (member_runtime if name == "team-lead" else self.agent_runtime(
                agent_id_of("team-lead", team), parent_session=parent_session))
        pid, alive, exact_lead = lead["pid"], lead["alive"], lead["exact"]
        lead_team, exact_team = lead["runs_as"], lead["runs_as_exact"]
        addressed_roster = self.roster_of(team) or {}
        addressed_members = addressed_roster.get("members", [])
        listed = (any(member.get("agentId") == agent_id
                      or member.get("name") == name
                      for member in addressed_members)
                  or (name == "team-lead"
                      and addressed_roster.get("leadAgentId") == agent_id))
        runtime_roster = (self.roster_of(lead_team) if lead_team else addressed_roster) or {}
        runtime_members = [member for member in runtime_roster.get("members", [])
                           if member.get("name") != "team-lead"]

        # Mail polling starts when the live lead has members in its runtime team
        # state. Flag-bound startup reads the roster. Plain leads update runtime
        # members through their own spawns, while external roster edits remain
        # disk-only.
        worn = lead["worn_team"]
        if not (pid and alive):
            polls = (False, "the lead is stopped")
        elif not runtime_members:
            polls = (False, "the roster lists no members")
        elif worn:
            polls = (True, "its argv names the team, so it read this roster when it booted")
        else:
            polls = (None, "a plain lead reads its own memory of the roster, which a roster "
                           "written from outside does not reach")
        if not (pid and alive):
            reachable, why = False, f"lead process for {team} is stopped"
            remedies = [("resume the lead", "starts a process")]
        elif lead_team and lead_team != team:
            reachable, why = False, (f"its lead is live but runs as {lead_team}, so mail sent "
                                     f"to {team} remains unpolled")
            remedies = [("--into-team live", "restarts this member, losing its in-flight turn")]
            if not exact_team:
                remedies.append(("ask before redirecting", "needs a terminal to ask at"))
        elif lead_team is None:
            reachable, why = False, ("its lead is live and structural team resolution returned "
                                     "unknown, so mailbox polling cannot be located")
            # Both ways to make a lead read, always together: a lead learns of
            # members only from its own spawns or a flag-bound boot, so writing
            # the roster from outside reaches nothing, and a remedy list naming
            # only the restart hides the fix that costs nothing.
            remedies = [("have the lead start any teammate",
                         "a spawn records the team it runs as and starts it "
                         "reading mail; immediate, costs nothing"),
                        ("resume the lead under its own identity",
                         "restarts it, and it then states its team in argv, at "
                         "the cost of its current turn")]
        elif not listed:
            reachable, why = False, (f"{lead_team} roster member search returned empty, so the "
                                     "lead has no runtime registration for it")
            remedies = [("resume this member once", "a launch; it registers itself")]
            if polls[0] is False:
                why += "; that roster lists no members at all, so nothing is polled yet"
                remedies += [("have the lead start any teammate",
                              "it starts reading mail immediately; costs nothing"),
                             (f"resume the lead as {agent_id_of('team-lead', lead_team)}",
                              "restarts it with team flags; it reads the roster on "
                              "the way up and loses its current turn")]
        elif polls[0] is None:
            reachable, why = None, (f"listed in {lead_team}, but whether its lead is still "
                                    f"reading cannot be told from outside its process")
            remedies = [("have the lead start any teammate",
                         "it starts reading mail immediately; costs nothing"),
                        (f"resume the lead as {agent_id_of('team-lead', lead_team)}",
                         "restarts it with team flags; it reads this roster on "
                         "the way up and loses its current turn")]
        else:
            reachable, why = True, f"listed in {lead_team}, whose live lead polls it"
            remedies = []
        return {
            "agent_id": agent_id, "name": name, "team": team,
            "runtime": member_runtime,
            "lead": {**lead, "grade": "exact" if exact_lead else "inferred"},
            "lead_team": (lead_team, "exact" if exact_team else
                          f"paired by a boot within {TEAM_MINT_WINDOW_MS}ms, not proven"),
            "polls": polls,
            "listed": listed,
            "reachable": (reachable, why),
            "remedies": remedies,
        }

    def spawn_parent_of(self, agent_id):
        """(stem, evidence) of the transcript whose spawn payload names this
        agent. The agent dossier's parentage line asks this separately; the
        answer walks the spawn corpus, so the doctor declares that work when
        it is pointed at an agent."""
        parent = next((stem for stem, entries in self._every_log().items()
                       for _stamp, payload in entries
                       if payload.get("agent_id") == agent_id), None)
        return (parent, "spawn payload naming it" if parent
                else "no spawn payload names this agent")

    def teams_led_by(self, session_stem):
        """Teams this transcript led, newest first.

        A lead resumed several times mints a fresh implicit team each life and keeps
        appending to one transcript, so several teams can be named by one file. The
        newest is the one it was running as when it stopped.
        """
        led = self.led_teams()
        mine = [(stamp, team) for team, hits in led.items()
                for stamp, path in hits if path.stem == session_stem]
        mine.sort(reverse=True)
        return [team for _, team in mine]

    def _transcript_paths(self, session_uuid):
        """Every file carrying one session UUID, in stable path order."""
        return tuple(sorted(self.projects_dir.glob(f"*/{session_uuid}.jsonl")))

    def transcript_path(self, session_uuid):
        """The sole file carrying one session UUID, or None when not unique."""
        hits = self._transcript_paths(session_uuid)
        return hits[0] if len(hits) == 1 else None

    def transcript_carries_uuid(self, stem, uuid, project=None):
        """Whether that session in this project holds an entry with this uuid."""
        path = project / f"{stem}.jsonl" if project and stem else \
            self.transcript_path(stem) if stem else None
        if not path:
            return False
        try:
            return f'"{uuid}"' in path.read_text(errors="replace")
        except OSError:
            return False

    def transcript_fact(self, session_uuid=None, path=None):
        """Immutable path, title, and activity time for one transcript."""
        path = Path(path) if path else self.transcript_path(session_uuid)
        if not path:
            return None
        if path in self._transcript_facts:
            return self._transcript_facts[path]
        title = None
        if self.needs[NEED.TITLES] is not DECLARED.ABSENT:
            self._exercise(NEED.TITLES)
            title = _session_title(path)
        try:
            mtime = int(path.stat().st_mtime * 1000)
        except OSError:
            mtime = None
        fact = types.MappingProxyType({"session": path.stem, "path": path,
                                       "title": title, "mtime": mtime})
        self._transcript_facts[path] = fact
        return fact

    def _walk_spawn_payloads(self, node, depth=0):
        """Yield genuine spawn payloads inside a parsed transcript line.

        Structure, never text. A payload the harness wrote is a dict in the
        record; the same JSON printed by a command or pasted into a message is a
        string, and parsing strings admits it as evidence. Measured on this
        machine: 199 payloads reached as dicts, and every string that parsed was
        one command's stdout quoting a payload back.
        """
        if depth > 10:  # deepest real payload seen is 5; leave room for another wrapper
            return
        if isinstance(node, dict):
            if node.get("status") == "teammate_spawned" and node.get("name"):
                yield node
            for value in node.values():
                yield from self._walk_spawn_payloads(value, depth + 1)
        elif isinstance(node, list):
            for value in node:
                yield from self._walk_spawn_payloads(value, depth + 1)

    def side_transcripts(self, parent=None):
        """Every side transcript on this machine, classified by its own bytes.

        A side transcript lives at <project>/<parent-session>/subagents/
        agent-<taskId>.jsonl, with an optional .meta.json beside it. The meta
        contributes a display name and an agent type and classifies nothing:
        this corpus holds a meta that says fork beside a file whose bytes are
        a regular chain, and the file wins.

        Grammars, decided by the first record alone:
          fork-reference  line 1 is a fork-context-ref naming the parent, the leaf it
                          forked from, and a context length; history is by reference.
          regular         the first record is a null-parent sidechain record with a
                          uuid; the chain carries its own history.
        Anything else is reported as what it is, never guessed at.
        """
        self._exercise(NEED.SIDES)
        out = self._side_listing(parent)
        for entry in out:
            entry["grammar"], entry["detail"], entry["root"] = \
                self._side_grammar(entry["path"])
        return out

    def _side_listing(self, parent=None):
        """The corpus by its cheap facts alone (path, parent, meta, mtime):
        side_transcripts without the classification, for the selector that
        narrows to a hit before anything reads bytes."""
        pattern = f"*/{parent or '*'}/subagents/agent-*.jsonl"
        out = []
        for path in sorted(self.projects_dir.glob(pattern)):
            try:
                mtime = int(path.stat().st_mtime * 1000)
            except OSError:
                continue
            entry = {"path": path, "parent": path.parent.parent.name,
                     "task_id": path.stem[len("agent-"):],
                     "name": None, "agent_type": None, "mtime": mtime}
            try:
                meta = json.loads(path.with_name(path.stem + ".meta.json").read_text())
                entry["name"] = meta.get("name")
                entry["agent_type"] = meta.get("agentType")
            except (OSError, ValueError):
                pass
            out.append(entry)
        return out

    def _side_grammar(self, path):
        """(grammar, detail, root) for one side transcript, from its first records.

        fork-reference -> the ref record itself; regular -> the root uuid; either way
        `root` is the chain root's uuid (for a fork-reference transcript, the null-parent
        record after the ref: 138 of 138 here carry one). unclassifiable ->
        a sentence naming what the first record actually is, root None.
        """
        self._exercise(NEED.SIDES)
        try:
            with path.open(errors="replace") as handle:
                first = handle.readline().strip()
                second = handle.readline().strip()
        except OSError as err:
            return SIDE_CLASS_UNCLASSIFIABLE, f"unreadable ({err.__class__.__name__})", None
        if not first:
            return SIDE_CLASS_UNCLASSIFIABLE, "the file is empty", None
        try:
            rec = json.loads(first)
        except ValueError:
            return SIDE_CLASS_UNCLASSIFIABLE, "the first line is not JSON", None
        if rec.get("type") == "fork-context-ref":
            try:
                nxt = json.loads(second) if second else {}
            except ValueError:
                nxt = {}
            root = nxt.get("uuid") if nxt.get("parentUuid") is None else None
            return SIDE_GRAMMAR_FORK_REFERENCE, rec, root
        if rec.get("parentUuid") is None and rec.get("isSidechain") is True and rec.get("uuid"):
            return SIDE_GRAMMAR_REGULAR, rec["uuid"], rec["uuid"]
        parent = "null" if rec.get("parentUuid") is None else "set"
        return SIDE_CLASS_UNCLASSIFIABLE, (f"the first record is type={rec.get('type', '?')}, "
                                  f"parentUuid={parent}, isSidechain={rec.get('isSidechain')}"), None

    def side_transcript(self, selector):
        """One side transcript for a typed selector, or (None, why not).

        Accepted spellings are task ID, `<parent-session-prefix>/<name>`, regular
        sidechain root UUID, or a meta name carried by one side transcript. Multiple
        matches return a candidate list.

        Classification is paid only where a spelling requires it: task ids
        and parent/name pairs match on the cheap facts and classify the hit
        alone; roots live in the bytes, so only that fallback (and the bare
        name behind it, to keep the spelling order exact) reads the corpus.
        """
        sides = self._side_listing()

        def classified(entry):
            entry = dict(entry)
            entry["grammar"], entry["detail"], entry["root"] = \
                self._side_grammar(entry["path"])
            return entry

        if "/" in selector:
            parent_part, _, name_part = selector.partition("/")
            hits = [e for e in sides if e["parent"].startswith(parent_part)
                    and name_part in (e["name"], e["task_id"])]
        else:
            hits = [e for e in sides if e["task_id"] == selector]
            if not hits:
                sides = [classified(e) for e in sides]
                hits = [e for e in sides if e["root"] == selector]
                hits = hits or [e for e in sides if e["name"] == selector]
        if not hits:
            # The file is agent-<task id>.jsonl, so a listing shows the one
            # spelling this does not take, and a person reads it off the
            # listing and types it. When dropping the prefix (and the suffix,
            # for a name copied whole) lands on a real task id, say that id
            # rather than a flat no-match against a name that plainly exists.
            bare = selector.removesuffix(".jsonl").removeprefix("agent-")
            if bare != selector and any(e["task_id"] == bare for e in sides):
                return None, (f"{selector!r} is the file's name; this takes the "
                              f"task id inside it, so type {bare}")
            return None, f"no side transcript matches {selector!r}"
        if len(hits) > 1:
            # A refusal names what it refused between, in spellings that can
            # actually be typed apart: when the pretty form collides, the
            # colliding candidates are named by task id instead.
            pretty = [f"{e['parent'][:8]}/{e['name'] or e['task_id']}" for e in hits]
            tallies = collections.Counter(pretty)
            named = [p if tallies[p] == 1 else f"{e['parent'][:8]}/{e['task_id']}"
                     for p, e in zip(pretty, hits)]
            shown = ", ".join(named[:6])
            more = f" and {len(hits) - 6} more" if len(hits) > 6 else ""
            return None, f"{len(hits)} side transcripts match {selector!r}: {shown}{more}"
        hit = hits[0]
        return (hit if "grammar" in hit else classified(hit)), ""


class TranscriptRewriter:
    """Plan transcript rewrites and verify each round trip in memory before writing."""

    def __init__(self, resolver):
        self.resolver = resolver

    @staticmethod
    def _last_record_at(raws, record_type, field):
        """(payload, one-based line) for the last matching JSONL record."""
        for index in range(len(raws) - 1, -1, -1):
            try:
                rec = json.loads(raws[index])
            except (ValueError, UnicodeDecodeError):
                continue
            if not isinstance(rec, dict) or rec.get("type") != record_type:
                continue
            payload = rec.get(field)
            if isinstance(payload, dict):
                return payload, index + 1
        return None, None

    @classmethod
    def _consume_last_record(cls, raws, record_type, field):
        """Last payload, raw line, position, and lines without that record."""
        payload, line = cls._last_record_at(raws, record_type, field)
        if line is None:
            return None, None, None, list(raws)
        remaining = list(raws)
        raw = remaining.pop(line - 1)
        return payload, raw, line - 1, remaining

    def restamp_plan(self, path, team, name=None):
        """Plan a window-start identity restamp and verify its memory round trip.

        The edit set is limited to teamName and optional agentName on the located
        window-start record. Applying the reverse must reproduce the original line
        bytes before the plan becomes writable.
        """
        start = self.resolver.window_start(path)
        if not start:
            return {"objections": ["this conversation carries no stamped identity "
                                   "record to rewrite"], "proved": False}
        old_name, old_team, uuid = start
        if old_team == team and (name is None or name == old_name):
            return {"objections": [f"its identity record already says {team}; "
                                   "nothing to rewrite"], "proved": False}
        try:
            raws = path.read_text(errors="strict").split("\n")
        except (OSError, UnicodeDecodeError) as err:
            return {"objections": [f"unreadable: {err}"], "proved": False}
        trailing = raws and raws[-1] == ""
        if trailing:
            raws.pop()
        # The latest restamp remains active after later Claude Code records. Its
        # `old` value keeps the origin, so repeated restamps record one net change
        # and a return to origin removes the receipt.
        prior, _prior_raw, prior_position, raws = self._consume_last_record(
            raws, RESTAMP_RECORD, "restamp")
        origin = (prior or {}).get("old") or None
        for i, raw in enumerate(raws):
            if f'"{uuid}"' not in raw:
                continue
            loaded, why = self._codec_load(raw)
            if loaded is None:
                return {"objections": [f"its identity record {why}"],
                        "proved": False}
            rec, style = loaded
            # Byte round-trip accepts any JSON value. Restamping requires an object
            # record with a UUID, so other JSON types produce an objection before
            # record selection or editing.
            if not isinstance(rec, dict):
                return {"objections": [f"line {i + 1} carries {uuid} but is a "
                                       f"{type(rec).__name__}, not a record"],
                        "proved": False}
            if rec.get("uuid") != uuid:
                continue
            new = dict(rec)
            new["teamName"] = team
            if name:
                new["agentName"] = name
            allowed = {"teamName"} | ({"agentName"} if name else set())
            changed = {k for k in set(rec) | set(new)
                       if rec.get(k, _MISSING) != new.get(k, _MISSING)}
            if changed - allowed:
                return {"objections": [f"the edit set would need "
                                       f"{sorted(changed - allowed)[0]}"],
                        "proved": False}
            back = dict(new)
            back["teamName"] = old_team
            if name:
                back["agentName"] = old_name
            if self._codec_dump(back, style) != raw:
                return {"objections": ["the inverse does not restore the line"],
                        "proved": False}
            out = list(raws)
            out[i] = self._codec_dump(new, style)
            was = origin or {"teamName": old_team, "agentName": old_name}
            now = {"teamName": team, "agentName": name or old_name}
            receipt = {"kind": "restamp", "stem": path.stem, "uuid": uuid,
                       "old": was, "new": now, "at": int(time.time() * 1000)}
            # When the new identity equals the origin, omit the receipt and restore
            # the original transcript bytes.
            if now != was:
                rendered = json.dumps({"type": RESTAMP_RECORD, "restamp": receipt},
                                      separators=(",", ":"), ensure_ascii=False,
                                      sort_keys=True)
                if prior_position is None:
                    out.append(rendered)
                else:
                    out.insert(prior_position, rendered)
            return {"path": path, "lines": out, "receipt": receipt,
                    "objections": [], "proved": True}
        return {"objections": [f"identity record {uuid} not found as a line"],
                "proved": False}

    @classmethod
    def _last_record_in_file(cls, path, record_type, field):
        """The payload from the last matching record in a JSONL, read backward."""
        marker = record_type.encode()
        try:
            size = path.stat().st_size
            handle = path.open("rb")
        except OSError:
            return None
        carry, at = b"", size
        with handle:
            while at:
                take = min(INDEX_CHUNK, at)
                at -= take
                handle.seek(at)
                block = handle.read(take) + carry
                lines = block.split(b"\n")
                carry = lines.pop(0) if at else b""
                candidates = [raw for raw in lines if marker in raw]
                payload, _line = cls._last_record_at(candidates, record_type, field)
                if payload is not None:
                    return payload
            if carry and marker in carry:
                payload, _line = cls._last_record_at([carry], record_type, field)
                return payload
        return None

    @staticmethod
    def receipt_objection(receipt):
        """Return why a conversion receipt is not the current complete schema."""
        if not isinstance(receipt, dict):
            return "the conversion receipt is not an object"
        missing = sorted(RECEIPT_REQUIRED - set(receipt))
        if missing:
            return "the conversion receipt is missing " + ", ".join(missing)
        unknown = sorted(set(receipt) - set(RECEIPT_KEYS))
        if unknown:
            return "the conversion receipt has unknown fields " + ", ".join(unknown)
        null_optional = sorted(field for field in set(receipt) - RECEIPT_REQUIRED
                               if receipt[field] is None)
        if null_optional:
            return ("the conversion receipt must omit empty optional fields "
                    + ", ".join(null_optional))
        if type(receipt["schema_version"]) is not int:
            return "the conversion receipt has invalid schema_version value"
        if receipt["schema_version"] != 1:
            return (f"unsupported conversion receipt schema_version "
                    f"{receipt['schema_version']!r}; expected 1")
        for field in ("dest_stem", "parent", "task_id"):
            if not isinstance(receipt[field], str) or not receipt[field]:
                return f"the conversion receipt has invalid {field} value"
        if (receipt["root"] is not None
                and (not isinstance(receipt["root"], str) or not receipt["root"])):
            return "the conversion receipt has invalid root value"
        if receipt["direction"] == "promote" and not receipt["root"]:
            return "a promotion receipt has no root"
        if (not isinstance(receipt["direction"], str)
                or receipt["direction"] not in ("promote", "demote")):
            return f"the conversion receipt has invalid direction {receipt['direction']!r}"
        if (not isinstance(receipt["grammar"], str)
                or receipt["grammar"] not in SIDE_GRAMMARS):
            return (f"unsupported conversion grammar {receipt['grammar']!r}; expected "
                    f"{SIDE_GRAMMAR_OPTIONS}")
        fork_fields = (receipt.get("graft"), receipt.get("ref"),
                       receipt.get("prefix_uuids"))
        if receipt["grammar"] == SIDE_GRAMMAR_FORK_REFERENCE:
            if (not all(fork_fields[:2]) or not isinstance(fork_fields[2], list)
                    or not fork_fields[2]):
                return "a fork-reference receipt is missing its copied-prefix fields"
        elif any(value is not None for value in fork_fields):
            return "a regular receipt carries fork-reference fields"
        if not isinstance(receipt["unwrapped"], bool):
            return "the conversion receipt has invalid unwrapped value"
        edits = receipt["visible_human_wrapper_edits"]
        if not isinstance(edits, dict) or set(edits) != {"original_payloads", "intervals"}:
            return "the conversion receipt has invalid visible_human_wrapper_edits value"
        payloads, intervals = edits["original_payloads"], edits["intervals"]
        if (not isinstance(payloads, list)
                or not all(isinstance(item, list) and len(item) == 2
                           and isinstance(item[0], str)
                           and item[0] in HUMAN_MESSAGE_WRAPPERS
                           and isinstance(item[1], str) for item in payloads)):
            return "the conversion receipt has invalid original_payloads value"
        if (not isinstance(intervals, list)
                or not all(isinstance(item, list) and len(item) == 3
                           and isinstance(item[0], str) and item[0]
                           and isinstance(item[1], str) and item[1]
                           and isinstance(item[2], list)
                           and all(type(ref) is int and 0 <= ref < len(payloads)
                                   for ref in item[2]) for item in intervals)):
            return "the conversion receipt has invalid wrapper edit intervals value"
        refs = [ref for _first, _last, interval_refs in intervals
                for ref in interval_refs]
        if not receipt["unwrapped"] and (payloads or refs):
            return "a wrapped conversion receipt carries unneeded original payloads"
        if receipt["unwrapped"] and (
                any(not interval_refs for _first, _last, interval_refs in intervals)
                or len(refs) != len(set(refs))
                or set(refs) != set(range(len(payloads)))):
            return "an unwrapped conversion receipt has inconsistent payload references"
        if not _valid_newline(receipt["source_newline"]):
            return "the conversion receipt has invalid source_newline metadata"
        if bool(receipt.get("name")) != bool(receipt.get("team")):
            return "the conversion receipt must carry both name and team or neither"
        for field in ("name", "team"):
            if field in receipt and (not isinstance(receipt[field], str)
                                     or not receipt[field]):
                return f"the conversion receipt has invalid {field} value"
        for field in ("graft", "previous_record", "ref"):
            if (field in receipt
                    and (not isinstance(receipt[field], str) or not receipt[field])):
                return f"the conversion receipt has invalid {field} value"
        if ("side_meta_b64" in receipt) != ("side_meta_mode" in receipt):
            return "the conversion receipt must pair side_meta_b64 and side_meta_mode"
        if "side_meta_b64" in receipt:
            encoded = receipt["side_meta_b64"]
            mode = receipt["side_meta_mode"]
            if not isinstance(encoded, str):
                return "the conversion receipt has invalid side_meta_b64 value"
            if type(mode) is not int or not 0 <= mode <= 0o777:
                return "the conversion receipt has invalid side_meta_mode value"
            try:
                decoded = base64.b64decode(encoded, validate=True)
            except (binascii.Error, ValueError):
                return "the conversion receipt has invalid side_meta_b64 value"
            if base64.b64encode(decoded).decode("ascii") != encoded:
                return "the conversion receipt has non-canonical side_meta_b64 value"
        for field in ("inserted_sidechain", "prefix_uuids"):
            value = receipt.get(field)
            if value is not None and (not isinstance(value, list) or not value
                                      or not all(isinstance(item, str) and item
                                                 for item in value)
                                      or len(value) != len(set(value))):
                return f"the conversion receipt has invalid {field} value"
        if bool(receipt.get("previous_record") is not None) != bool(
                receipt.get("previous_position") is not None):
            return "the conversion receipt must pair previous_record and previous_position"
        if (receipt.get("previous_position") is not None
                and (type(receipt["previous_position"]) is not int
                     or receipt["previous_position"] < 0)):
            return "the conversion receipt has invalid previous_position value"
        stripped = receipt.get("stripped")
        if stripped is not None and (not isinstance(stripped, list) or not stripped
                                     or not all(isinstance(item, list) and len(item) == 2
                                                and type(item[0]) is int and item[0] >= 0
                                                and isinstance(item[1], str) and item[1]
                                                for item in stripped)):
            return "the conversion receipt has invalid stripped value"
        root_stamps = receipt.get("root_stamps")
        member_identity = bool(receipt.get("name") and receipt.get("team")
                               and receipt.get("name") != "team-lead")
        if member_identity and root_stamps is None:
            return "a member conversion receipt must carry root_stamps"
        if not member_identity and root_stamps is not None:
            return "a non-member conversion receipt must not carry root_stamps"
        if root_stamps is not None and not (
                isinstance(root_stamps, dict)
                and set(root_stamps) == {"agentName", "teamName"}
                and all(isinstance(root_stamps[field], list)
                        and len(root_stamps[field]) == 2
                        and isinstance(root_stamps[field][0], bool)
                        and (root_stamps[field][0]
                             or root_stamps[field][1] is None)
                        for field in ("agentName", "teamName"))):
            return "the conversion receipt has invalid root_stamps"
        return None

    @classmethod
    def receipt_in_file(cls, path):
        """The last valid current-schema conversion receipt in one JSONL."""
        receipt = cls._last_record_in_file(path, RECEIPT_RECORD, "receipt")
        return receipt if receipt and not cls.receipt_objection(receipt) else None

    @classmethod
    def terminal_receipt_in_file(cls, path):
        """Return a conversion receipt when it occupies the final nonempty line.

        Embedded receipts supply demotion defaults. A final receipt additionally
        represents the immediately reversible conversion.
        """
        try:
            raws = Path(path).read_text(errors="strict").splitlines()
        except (OSError, UnicodeDecodeError):
            return None
        if not raws:
            return None
        try:
            rec = json.loads(raws[-1])
        except ValueError:
            return None
        if not isinstance(rec, dict) or rec.get("type") != RECEIPT_RECORD:
            return None
        receipt = rec.get("receipt")
        return (receipt if receipt and not cls.receipt_objection(receipt)
                else None)

    # -- side transcript <-> teammate conversion: this rewriter plans, proves
    #    the inverse, and never writes; materialize/embed consume a proved plan.

    @staticmethod
    def _codec_load(raw):
        """(record, dump style) for one line, or (None, why).

        A line is convertible only when one dump form reproduces its bytes,
        because the round-trip proof is a byte comparison: a line the codec
        cannot reproduce untouched cannot be proved restored either.
        """
        try:
            rec = json.loads(raw)
        except ValueError:
            return None, "is not JSON"
        for style, kwargs in (("compact", {"separators": (",", ":")}), ("spaced", {})):
            if json.dumps(rec, ensure_ascii=False, **kwargs) == raw:
                return (rec, style), None
        return None, "has bytes no dump form reproduces"

    @staticmethod
    def _codec_dump(rec, style):
        kwargs = {"separators": (",", ":")} if style == "compact" else {}
        return json.dumps(rec, ensure_ascii=False, **kwargs)

    @staticmethod
    def _insert_after(rec, anchor, key, value):
        """The record with key set right after anchor, harness key order."""
        out = {}
        for k, v in rec.items():
            out[k] = v
            if k == anchor:
                out[key] = value
        if key not in out:
            out = {key: value, **rec}
        return out

    @staticmethod
    def _is_tool_result_user(rec):
        """Whether this user record carries a tool result."""
        content = (rec.get("message") or {}).get("content")
        return isinstance(content, list) and any(
            isinstance(block, dict) and block.get("type") == "tool_result"
            for block in content)

    def _transcript_chain(self, path, leaf_uuid):
        """The message chain Claude Code can reach from leaf_uuid in one file.

        Progress records are aliases for their nearest non-progress parent. A
        missing parent gets the same five-second, same-sidechain timestamp
        fallback as 2.1.220. Parallel assistant fragments and their tool results
        are inserted after the chain assistant whose message id they share.
        """
        messages, progress = {}, {}
        try:
            handle = path.open(errors="strict")
        except OSError as err:
            return None, f"the referenced parent transcript is unreadable ({err})"
        with handle:
            for line in handle:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(rec, dict) or not rec.get("uuid"):
                    continue
                if rec.get("type") == "progress":
                    parent = rec.get("parentUuid")
                    progress[rec["uuid"]] = progress.get(parent, parent)
                    continue
                if rec.get("type") not in ("user", "assistant", "attachment", "system"):
                    continue
                rec = dict(rec)
                if rec.get("parentUuid") in progress:
                    rec["parentUuid"] = progress[rec["parentUuid"]]
                messages[rec["uuid"]] = rec
        cursor = messages.get(leaf_uuid)
        if cursor is None:
            return None, f"the referenced parent transcript does not carry {leaf_uuid}"
        reverse, seen = [], set()
        while cursor is not None:
            if cursor["uuid"] in seen:
                return None, f"the referenced parent chain cycles at {cursor['uuid']}"
            seen.add(cursor["uuid"])
            reverse.append(cursor)
            parent = cursor.get("parentUuid")
            if parent is None:
                break
            found = messages.get(parent)
            if found is None:
                now, nearest, distance = iso_ms(cursor.get("timestamp")), None, 5001
                if now:
                    for candidate in messages.values():
                        if candidate["uuid"] in seen or \
                                candidate.get("isSidechain") != cursor.get("isSidechain"):
                            continue
                        then = iso_ms(candidate.get("timestamp"))
                        gap = now - then
                        if then and 0 <= gap <= 5000 and gap < distance:
                            nearest, distance = candidate, gap
                found = nearest
            if found is None:
                return None, (f"the referenced parent chain breaks at {cursor['uuid']}: "
                              f"parent {parent} is absent")
            cursor = found
        chain = list(reversed(reverse))

        assistants = [rec for rec in chain if rec.get("type") == "assistant"]
        by_message, tool_results = {}, {}
        for rec in messages.values():
            if rec.get("type") == "assistant" and (rec.get("message") or {}).get("id"):
                by_message.setdefault(rec["message"]["id"], []).append(rec)
            elif rec.get("type") == "user" and rec.get("parentUuid") and \
                    self._is_tool_result_user(rec):
                tool_results.setdefault(rec["parentUuid"], []).append(rec)
        inserted, recovered, handled = {}, set(seen), set()
        for rec in assistants:
            message_id = (rec.get("message") or {}).get("id")
            if not message_id or message_id in handled:
                continue
            handled.add(message_id)
            variants = by_message.get(message_id, [rec])
            fragments = sorted((item for item in variants if item["uuid"] not in recovered),
                               key=lambda item: item.get("timestamp") or "")
            results = []
            for item in variants:
                results.extend(result for result in tool_results.get(item["uuid"], [])
                               if result["uuid"] not in recovered)
            results.sort(key=lambda item: item.get("timestamp") or "")
            extras = fragments + results
            if extras:
                inserted[rec["uuid"]] = extras
                recovered.update(item["uuid"] for item in extras)
        if inserted:
            expanded = []
            for rec in chain:
                expanded.append(rec)
                expanded.extend(inserted.get(rec["uuid"], ()))
            chain = expanded
        return [rec for rec in chain if not rec.get("isSidechain")], None

    def _materialized_prefix(self, source, ref, dest_stem, own_uuids):
        """Copy a fork-reference transcript's inherited parent chain into a main transcript."""
        parent, leaf = ref.get("parentSessionId"), ref.get("parentLastUuid")
        if not parent or not leaf:
            return None, None, None, "the fork-context-ref names no parent session or leaf"
        parent_path = source.parent.parent.parent / f"{parent}.jsonl"
        chain, why = self._transcript_chain(parent_path, leaf)
        if chain is None:
            return None, None, None, why
        lines, uuids, previous = [], [], None
        known = set(own_uuids)
        for rec in chain:
            uuid = rec.get("uuid")
            if not uuid:
                continue
            if uuid in known:
                return None, None, None, (f"the referenced parent prefix reuses uuid {uuid} "
                                          "inside the side transcript")
            known.add(uuid)
            copied = dict(rec)
            copied["parentUuid"] = previous
            copied["isSidechain"] = False
            copied["sessionId"] = dest_stem
            for field in ("logicalParentUuid", "agentName", "teamName", "sessionKind",
                          "slug", "sourceToolAssistantUUID"):
                copied.pop(field, None)
            lines.append(json.dumps(copied, separators=(",", ":"), ensure_ascii=False))
            uuids.append(uuid)
            previous = uuid
        if previous is None:
            return (None, None, None,
                    "the referenced parent prefix contains no main-session records")
        return lines, uuids, previous, None

    def _convert(self, raws, direction, receipt, rescan_visible_humans=False):
        """(out_lines, objections) - one edit set, applied forward or backward.

        `receipt` is both the record of a promote and the parameters of the
        demote that undoes it: the forward pass fills it, the backward pass
        consumes it, so the two directions cannot drift apart. The fields a
        conversion may touch are closed (sessionId, isSidechain, the fork-reference
        root's parentUuid, known human wrappers' isMeta and optional message content,
        the ref line, its materialized prefix, and last-prompt trailers, in that
        vocabulary and no other); a line whose transform would need any other field
        is an objection, not an edit.
        """
        objections, parsed = [], []
        for n, raw in enumerate(raws, 1):
            loaded, why = self._codec_load(raw)
            if loaded is None:
                objections.append(f"line {n} {why}")
                continue
            parsed.append((n, raw) + loaded)
        prefix_lines = receipt.get("_prefix_lines") or [] if direction == "promote" else []
        prefix_parsed = []
        for n, raw in enumerate(prefix_lines, 1):
            loaded, why = self._codec_load(raw)
            if loaded is None:
                objections.append(f"materialized prefix line {n} {why}")
                continue
            prefix_parsed.append((n, raw) + loaded)
        if objections:
            return None, objections

        parent, dest = receipt["parent"], receipt["dest_stem"]
        out = []

        edits = receipt["visible_human_wrapper_edits"]
        original_payloads = list(edits["original_payloads"])
        interval_specs = edits["intervals"]
        visible_order, visible_by_uuid, payload_ref = [], {}, {}
        candidates = prefix_parsed + parsed
        positions = {rec.get("uuid"): at for at, (_n, _raw, rec, _style)
                     in enumerate(candidates) if rec.get("uuid")}

        def complete_wrapper(rec):
            content = (rec.get("message") or {}).get("content")
            wrapped = _human_wrapper_text(content)
            return (wrapped if wrapped and (
                _human_message_matches(rec, content, True)
                or _human_message_matches(rec, content, False)) else None)

        for first, last, refs in interval_specs:
            if first not in positions or last not in positions or positions[first] > positions[last]:
                objections.append(
                    f"the conversion receipt has an unresolved visible human interval {first}..{last}")
                continue
            rows = [row for row in candidates[positions[first]:positions[last] + 1]
                    if row[2].get("uuid")]
            if refs and len(refs) != len(rows):
                objections.append(
                    f"visible human interval {first}..{last} has the wrong payload count "
                    f"({len(refs)} for {[rec.get('uuid') for _n, _raw, rec, _style in rows]})")
                continue
            for offset, (_n, _raw, rec, _style) in enumerate(rows):
                uuid = rec.get("uuid")
                if uuid in visible_by_uuid:
                    objections.append(
                        f"visible human intervals repeat uuid {uuid}")
                    continue
                if refs:
                    ref = refs[offset]
                    visible_by_uuid[uuid] = tuple(original_payloads[ref])
                    payload_ref[uuid] = ref
                else:
                    wrapped = complete_wrapper(rec)
                    if wrapped is None:
                        objections.append(
                            f"visible human interval {first}..{last} contains non-human {uuid}")
                        continue
                    visible_by_uuid[uuid] = wrapped
                visible_order.append(uuid)

        unwrapped = receipt["unwrapped"]
        discover_visible = direction == "promote" and rescan_visible_humans
        if discover_visible:
            selected = {positions[uuid] for uuid in visible_order if uuid in positions}
            for at, (_n, _raw, rec, _style) in enumerate(candidates):
                wrapped = _wrapped_human_message(rec)
                uuid = rec.get("uuid")
                if wrapped is None or not uuid:
                    continue
                selected.add(at)
                if uuid not in visible_by_uuid:
                    visible_order.append(uuid)
                    visible_by_uuid[uuid] = wrapped
                    if unwrapped:
                        payload_ref[uuid] = len(original_payloads)
                        original_payloads.append([wrapped[0], wrapped[1]])
            intervals = []
            for at in sorted(selected):
                uuid = candidates[at][2].get("uuid")
                ref = payload_ref.get(uuid)
                separated = (intervals and any(
                    candidates[pos][2].get("uuid")
                    for pos in range(intervals[-1][3] + 1, at)))
                if not intervals or separated:
                    intervals.append([uuid, uuid, [] if ref is None else [ref], at])
                else:
                    intervals[-1][1], intervals[-1][3] = uuid, at
                    if ref is not None:
                        intervals[-1][2].append(ref)
            interval_specs = [[first, last, refs]
                              for first, last, refs, _at in intervals]
        receipt["visible_human_wrapper_edits"] = {
            "original_payloads": original_payloads,
            "intervals": interval_specs,
        }
        seen_visible = set()
        root_stamps = receipt.get("root_stamps")
        stamp_member_root = bool(receipt.get("name") and receipt.get("team")
                                 and receipt.get("name") != "team-lead")

        def visibility_edit(n, rec, new, where="line"):
            """Apply one recorded human edit and return its per-record vocabulary."""
            uuid = new.get("uuid")
            if uuid not in visible_by_uuid:
                return new, ()
            if uuid in seen_visible:
                objections.append(f"{where} {n}: visible human uuid {uuid} is repeated")
            seen_visible.add(uuid)
            version, inner = visible_by_uuid[uuid]
            if direction == "promote":
                if _wrapped_human_message(rec) != (version, inner):
                    objections.append(
                        f"{where} {n}: visible human {uuid} no longer matches its receipt")
                    return new, ()
                new["isMeta"] = False
                extra = ("isMeta",)
                if unwrapped:
                    message = dict(new["message"])
                    message["content"] = inner
                    new["message"] = message
                    extra += ("message",)
                return new, extra

            wrapped = _human_wrapper_content(version, inner)
            expected = inner if unwrapped else wrapped
            if not _human_message_matches(rec, expected, False):
                objections.append(
                    f"{where} {n}: visible human {uuid} no longer matches its receipt")
                return new, ()
            new["isMeta"] = True
            extra = ("isMeta",)
            if unwrapped:
                restored = dict(new["message"])
                restored["content"] = wrapped
                new["message"] = restored
                extra += ("message",)
            return new, extra

        if direction == "promote":
            for n, _raw, rec, style in prefix_parsed:
                new, extra = visibility_edit(n, rec, dict(rec), "materialized prefix line")
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(
                        f"materialized prefix line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            root_uuid = receipt.get("root")
            inserted = set(receipt.get("inserted_sidechain") or [])
            for n, raw, rec, style in parsed:
                if (n == 1 and receipt["grammar"] == SIDE_GRAMMAR_FORK_REFERENCE
                        and rec.get("type") == "fork-context-ref"):
                    receipt["ref"] = raw
                    continue
                new = dict(rec)
                extra = ()
                if new.get("sessionId") == parent:
                    new["sessionId"] = dest
                if new.get("uuid") in inserted and new.get("isSidechain") is True:
                    # The demote being undone put this field here; remove it
                    # rather than flip it, or the round trip grows a field.
                    new.pop("isSidechain")
                elif new.get("isSidechain") is True:
                    new["isSidechain"] = False
                new, visibility_extra = visibility_edit(n, rec, new)
                extra += visibility_extra
                if (receipt["grammar"] == SIDE_GRAMMAR_FORK_REFERENCE and receipt.get("ref")
                        and new.get("uuid") == root_uuid):
                    graft = receipt.get("graft")
                    if not graft:
                        objections.append("the fork-reference promotion has no materialized parent leaf")
                    else:
                        new["parentUuid"] = graft
                        new.pop("logicalParentUuid", None)
                        extra += ("parentUuid",)
                if new.get("uuid") == root_uuid and stamp_member_root:
                    if root_stamps is None:
                        root_stamps = {
                            field: [field in rec, rec.get(field)]
                            for field in ("agentName", "teamName")
                        }
                        receipt["root_stamps"] = root_stamps
                    else:
                        for field in ("agentName", "teamName"):
                            present, value = root_stamps[field]
                            if (field in rec) != present or (present and rec.get(field) != value):
                                objections.append(
                                    f"line {n}: promoted member root {field} no longer matches its receipt")
                    new["agentName"] = receipt["name"]
                    new["teamName"] = receipt["team"]
                    extra += ("agentName", "teamName")
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(f"line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            if receipt.get("stripped"):
                # Undoing a demote restores the original trailer bytes and
                # positions. Generating a new trailer would invent transcript history.
                # Their positions are relative to the side transcript, which
                # does not contain a fork-reference promotion's copied prefix.
                offset = len(prefix_lines)
                for pos, raw in receipt["stripped"]:
                    out.insert(offset + pos, raw)
            else:
                leaf = next((json.loads(line).get("uuid") for line in reversed(out)
                             if '"uuid"' in line and json.loads(line).get("uuid")), None)
                if leaf is None:
                    objections.append("no record carries a uuid, so there is no leaf")
                # The text the resume picker shows: the last human prompt. A
                # persistent mid-turn wrapper is storage syntax, not its title.
                prompt_records = prefix_parsed + parsed
                said = next((text for _n, _raw, rec, _s in reversed(prompt_records)
                             for text in [_picker_prompt_text(rec)] if text), "")
                trailer = {"type": "last-prompt", "lastPrompt": said,
                           "leafUuid": leaf, "sessionId": dest}
                out.append(json.dumps(trailer, separators=(",", ":"), ensure_ascii=False))
                receipt["trailer"] = out[-1]
        else:
            trailers, inserted = [], []
            prefix_uuids = receipt.get("prefix_uuids") or []
            prefix_set, removed_prefix = set(prefix_uuids), []
            root_seen = False
            for n, raw, rec, style in parsed:
                if rec.get("uuid") in prefix_set:
                    restored, extra = visibility_edit(
                        n, rec, dict(rec), "materialized prefix line")
                    bad = self._edit_closure(rec, restored, extra)
                    if bad:
                        objections.append(
                            f"materialized prefix line {n}: the edit set would need {bad}")
                    removed_prefix.append((rec["uuid"], self._codec_dump(restored, style)))
                    continue
                if rec.get("type") == "last-prompt":
                    # Positions count earlier trailers too, so the undo can
                    # reinsert sequentially and land every line where it sat.
                    trailers.append((len(out) + len(trailers), raw))
                    continue
                new = dict(rec)
                extra = ()
                if new.get("sessionId") == dest:
                    new["sessionId"] = parent
                if new.get("isSidechain") is False:
                    new["isSidechain"] = True
                elif "isSidechain" not in new and new.get("uuid"):
                    # A post-promotion message can lack this field. Demotion adds
                    # it and records the UUID so promotion removes it again.
                    # UUID-less harness records can carry sessionId, but they do
                    # not belong to either message chain and stay without it.
                    anchor = ("logicalParentUuid" if "logicalParentUuid" in new
                              else "parentUuid")
                    new = self._insert_after(new, anchor, "isSidechain", True)
                    inserted.append(new["uuid"])
                new, visibility_extra = visibility_edit(n, rec, new)
                extra += visibility_extra
                if new.get("uuid") == receipt.get("root"):
                    root_seen = True
                    graft = receipt.get("graft")
                    if prefix_uuids:
                        if new.get("parentUuid") != graft:
                            objections.append(f"line {n}: the promoted root no longer points to "
                                              "its materialized parent leaf")
                        else:
                            new["parentUuid"] = None
                            extra += ("parentUuid",)
                    if root_stamps is not None:
                        for field in ("agentName", "teamName"):
                            expected = receipt.get("name" if field == "agentName" else "team")
                            if rec.get(field) != expected:
                                objections.append(
                                    f"line {n}: promoted member root {field} no longer matches its receipt")
                                continue
                            present, value = root_stamps[field]
                            if present:
                                new[field] = value
                            else:
                                new.pop(field, None)
                        extra += ("agentName", "teamName")
                bad = self._edit_closure(rec, new, extra)
                if bad:
                    objections.append(f"line {n}: the edit set would need {bad}")
                out.append(self._codec_dump(new, style))
            if prefix_uuids:
                removed_uuids = [uuid for uuid, _raw in removed_prefix]
                if removed_uuids != prefix_uuids:
                    objections.append("the materialized parent prefix is incomplete or reordered")
                if not root_seen:
                    objections.append("the promoted root is absent, so its parent link cannot be restored")
                receipt["_prefix_lines"] = [raw for _uuid, raw in removed_prefix]
            if receipt.get("ref"):
                out.insert(0, receipt["ref"])
            if trailers:
                receipt["stripped"] = trailers
            else:
                receipt.pop("stripped", None)
            if inserted:
                receipt["inserted_sidechain"] = inserted
            else:
                receipt.pop("inserted_sidechain", None)
        missing_visible = [uuid for uuid in visible_order if uuid not in seen_visible]
        if missing_visible:
            objections.append(f"the transcript is missing visible human {missing_visible[0]}")
        return out, objections

    @staticmethod
    def _receipt_line(receipt):
        """The in-file record one converted transcript carries for its inverse."""
        carried = {k: receipt[k] for k in RECEIPT_KEYS
                   if k in RECEIPT_REQUIRED or receipt.get(k) is not None}
        return json.dumps({"type": RECEIPT_RECORD, "receipt": carried},
                          separators=(",", ":"), ensure_ascii=False, sort_keys=True)

    @staticmethod
    def _carried_receipt_at(raws):
        """(receipt, one-based line) for the last conversion receipt."""
        return TranscriptRewriter._last_record_at(raws, RECEIPT_RECORD, "receipt")

    @classmethod
    def carried_receipt(cls, raws):
        """The last valid current-schema receipt in these JSONL lines."""
        receipt = cls._carried_receipt_at(raws)[0]
        return receipt if receipt and not cls.receipt_objection(receipt) else None

    @staticmethod
    def _edit_closure(before, after, extra=()):
        """The first field outside the conversion vocabulary, or None.

        `extra` widens the vocabulary for one record when a conversion needs
        it, and nothing else ever does.
        """
        allowed = {"sessionId", "isSidechain", "logicalParentUuid", *extra}
        for key in set(before) | set(after):
            if key in allowed:
                continue
            if before.get(key, _MISSING) != after.get(key, _MISSING):
                return key
        return None

    def _demote_parent_objection(self, source, carried):
        """Why this demote could not default its parent, and what could serve.

        "demote needs the parent session (--into-session)" was the whole
        refusal, which left the reader to guess whether the tool had looked
        anywhere. Two halves are said instead: which record was missing or
        silent, and whether anything on disk offers a candidate. The spawn
        corpus is walked only here, on the way out, and only when the
        transcript carries stamps to look an agent up by.
        """
        if carried is not None:
            why = "the last conversion record it carries names no parent session"
        else:
            why = "it carries no conversion record, so nothing in the transcript says where it came from"
        name, team = self.resolver.stamp_index().get(Path(source)) or (None, None)
        if not (name and team):
            return (f"demote needs the parent session (--into-session): {why}, and it "
                    "carries no agent stamps to look a spawn payload up by")
        agent_id = agent_id_of(name, team)
        parent, _how = self.resolver.spawn_parent_of(agent_id)
        if parent:
            return (f"demote needs the parent session (--into-session): {why}. The spawn "
                    f"payload naming {agent_id} is in {parent}, so that is the "
                    "likely --into-session")
        return (f"demote needs the parent session (--into-session): {why}, and no spawn "
                f"payload names {agent_id}")

    def conversion_plan(self, source, direction, into=None, dest=None, identity=None,
                        unwrap=None):
        """Plan one conversion and byte-prove the opposite conversion restores it."""
        source = Path(source)
        try:
            text = source.read_bytes().decode("utf-8", "strict")
        except (OSError, UnicodeDecodeError) as err:
            return {"objections": [f"unreadable source: {err}"], "proved": False}
        raws, source_newline, newline_objection = _split_jsonl_text(text)
        if newline_objection:
            return {"objections": [newline_objection], "proved": False}

        carried, carried_raw, carried_position, without_carried = \
            self._consume_last_record(raws, RECEIPT_RECORD, "receipt")
        receipt_objection = self.receipt_objection(carried) if carried is not None else None
        if receipt_objection:
            return {"objections": [receipt_objection], "proved": False}
        carried_direction = carried["direction"] if carried is not None else None
        consumes = carried is not None and carried_direction != direction
        body = without_carried if consumes else list(raws)
        prior = dict(carried) if consumes else {}
        output_newline = (prior.get("source_newline", source_newline)
                          if consumes else source_newline)
        exact_inverse = False
        rescan_visible_humans = False

        if direction == "promote":
            grammar, detail, root = self.resolver._side_grammar(source)
            if grammar == SIDE_CLASS_UNCLASSIFIABLE:
                return {"objections": [f"not convertible: {detail}"],
                        "proved": False}
            parent = source.parent.parent.name
            expected_dest = prior.get("dest_stem") if consumes else root
            destination = dest or expected_dest
            expected_identity = (prior.get("name"), prior.get("team"))
            prior_unwrapped = prior["unwrapped"] if consumes else False
            selected_unwrapped = (prior_unwrapped if consumes and unwrap is None
                                  else unwrap is True)
            changes_visibility_mode = (consumes and unwrap is not None
                                       and selected_unwrapped != prior_unwrapped)
            exact_inverse = (consumes and destination == expected_dest
                             and (identity is None or identity == expected_identity)
                             and not changes_visibility_mode)
            receipt = dict(prior)
            if not consumes:
                receipt["visible_human_wrapper_edits"] = {
                    "original_payloads": [], "intervals": []}
                rescan_visible_humans = True
            elif changes_visibility_mode:
                receipt["visible_human_wrapper_edits"] = {
                    "original_payloads": [], "intervals": []}
                rescan_visible_humans = True
            elif not exact_inverse:
                # A new promotion keeps the carried edits and takes ownership of
                # any eligible wrappers added since that receipt was written.
                rescan_visible_humans = True
            receipt.update({"schema_version": 1, "direction": "promote",
                            "grammar": grammar,
                            "parent": parent, "root": root or prior.get("root"),
                            "dest_stem": destination,
                            "task_id": prior.get("task_id") or
                                       source.stem[len("agent-"):],
                            "unwrapped": selected_unwrapped})
            if identity:
                receipt["name"], receipt["team"] = identity
            if receipt.get("name") == "team-lead":
                receipt.pop("root_stamps", None)
            meta = source.with_name(source.stem + ".meta.json")
            if not consumes:
                try:
                    with meta.open("rb") as handle:
                        receipt["side_meta_b64"] = base64.b64encode(
                            handle.read()).decode("ascii")
                        receipt["side_meta_mode"] = os.fstat(
                            handle.fileno()).st_mode & 0o777
                except OSError:
                    receipt.pop("side_meta_b64", None)
                    receipt.pop("side_meta_mode", None)
            objections = []
            if grammar == SIDE_GRAMMAR_FORK_REFERENCE:
                own_uuids = set()
                for raw in body[1:]:
                    try:
                        rec = json.loads(raw)
                    except ValueError:
                        continue
                    if isinstance(rec, dict) and rec.get("uuid"):
                        own_uuids.add(rec["uuid"])
                prefix, prefix_uuids, graft, why = self._materialized_prefix(
                    source, detail, destination, own_uuids)
                if why:
                    objections.append(why)
                    out = None
                else:
                    if prior.get("prefix_uuids") and prior["prefix_uuids"] != prefix_uuids:
                        objections.append("the referenced parent prefix no longer has the recorded UUIDs")
                    receipt["_prefix_lines"] = prefix
                    receipt["prefix_uuids"] = prefix_uuids
                    receipt["graft"] = graft
                    out, objections = self._convert(
                        body, "promote", receipt,
                        rescan_visible_humans=rescan_visible_humans)
            else:
                out, objections = self._convert(
                    body, "promote", receipt,
                    rescan_visible_humans=rescan_visible_humans)
            dest_path = source.parent.parent.parent / f"{destination}.jsonl"
        else:
            expected_parent = prior.get("parent") if consumes else None
            into = into or expected_parent
            exact_inverse = consumes and into == expected_parent
            if not into:
                return {"objections": [self._demote_parent_objection(
                    source, carried or None)], "proved": False}
            ref_raw = prior.get("ref")
            if ref_raw and not exact_inverse:
                try:
                    ref = json.loads(ref_raw)
                except ValueError:
                    ref = {}
                anchor, from_session = ref.get("parentLastUuid"), ref.get("parentSessionId")
                if anchor and not self.resolver.transcript_carries_uuid(
                        from_session, anchor, source.parent):
                    return {"objections": [
                        f"this fork inherits its context by reference from "
                        f"{from_session}, which no longer carries {anchor}; moving "
                        f"it would leave that prefix unresolvable"], "proved": False}
            receipt = dict(prior)
            receipt.update({"schema_version": 1, "direction": "demote",
                            "grammar": prior["grammar"] if consumes else SIDE_GRAMMAR_REGULAR,
                            "parent": into, "dest_stem": source.stem,
                            "task_id": dest or prior.get("task_id") or source.stem,
                            "root": prior.get("root")})
            if not consumes:
                receipt["unwrapped"] = False
                receipt["visible_human_wrapper_edits"] = {
                    "original_payloads": [], "intervals": []}
            out, objections = self._convert(body, "demote", receipt)
            dest_path = (self.resolver.projects_dir / source.parent.name / into / "subagents"
                         / f"agent-{receipt['task_id']}.jsonl")

        # A receipt records both record separators and the final terminator so
        # its inverse writer restores LF, CRLF, or no final terminator exactly.
        receipt["source_newline"] = source_newline
        emits = not exact_inverse
        output_record_raw = None
        if out is not None and not objections:
            if emits:
                if consumes:
                    receipt["previous_record"] = carried_raw
                    receipt["previous_position"] = carried_position
                else:
                    receipt.pop("previous_record", None)
                    receipt.pop("previous_position", None)
                output_record_raw = self._receipt_line(receipt)
                out.append(output_record_raw)
            elif prior.get("previous_record") is not None:
                output_record_raw = prior["previous_record"]
                out.insert(prior["previous_position"], output_record_raw)
        if out is not None and len(out) > 1 and output_newline["line"] == "none":
            # A one-record input has no separator to preserve. Once conversion
            # adds records, LF separates them while the absent final terminator
            # remains absent and the receipt retains the source's `none` state.
            output_newline = {"line": "lf", "final": "none"}

        proved = False
        if out is not None and not objections:
            inverse_body = list(out)
            if output_record_raw is not None:
                _output, output_raw, _output_position, inverse_body = \
                    self._consume_last_record(inverse_body, RECEIPT_RECORD, "receipt")
                if output_raw != output_record_raw:
                    objections.append("the output conversion receipt is not the last one selected")
            if not objections:
                back, back_obj = self._convert(
                    inverse_body, "demote" if direction == "promote" else "promote",
                    dict(receipt))
                if back_obj:
                    objections.append(f"the inverse raises its own objections: {back_obj[0]}")
                else:
                    if consumes:
                        back.insert(carried_position, carried_raw)
                    proved = _jsonl_text(back, source_newline) == text
                    if not proved:
                        objections.append("the inverse does not restore the source bytes")

        receipt["_consumed"] = consumes
        receipt["_emitted"] = emits
        return {"direction": direction, "source": source, "dest_path": dest_path,
                "lines": out, "newline": output_newline,
                "receipt": receipt, "objections": objections, "proved": proved}


_MISSING = object()


RESOLVER = Resolver()


# What a revived pane needs from the lead's environment. The harness's swarm
# server is started BY the leader, so its panes inherit these; a server we start
# does not, because tool subprocesses have the credentials scrubbed. A new
# server inherits them from us; topping up an existing one puts the value on a
# transient tmux client argv, which is why that path only runs for variables the
# server is actually missing.
AUTH_ENV = ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")
# The traffic variable's name reads like a preference, so it invites being
# dropped from this set as "not a credential". It belongs: when the credential
# arrives as an OAuth access token in the environment rather than from a normal
# login, it has to travel with the token, so the two move together or neither
# works. The report calls the whole set creds for that reason.
INHERIT_ENV = AUTH_ENV + ("CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",)


def inherit_credentials(ctx):
    """Adopt the lead's credentials into our own env, so a tmux server we spawn
    passes them to its panes exactly as a harness-spawned server would.

    The lead pid comes from the ~/.claude chain (roster -> leadSessionId ->
    session registry), not from our process ancestry."""
    lead = RESOLVER.agent_runtime(
        agent_id_of("team-lead", RESOLVER.field(ctx, "teamName")),
        parent_session=RESOLVER.field(ctx, "parentSessionId"))
    pid = lead["pid"]
    if not (pid and lead["alive"]):
        return []
    adopted = []
    for key, value in RESOLVER.proc_env(pid, INHERIT_ENV).items():
        if not os.environ.get(key):
            os.environ[key] = value
            adopted.append(key)
    # Only shout when the revived agent would have no way to authenticate at
    # all. The usual setup keeps credentials in a file, and the traffic flag is
    # optional, so warning about either on every run trains you to ignore a tool
    # that kills things.
    if not any(os.environ.get(key) for key in AUTH_ENV) and not (CLAUDE_DIR / ".credentials.json").exists():
        warn("no auth env var on this lead and no ~/.claude/.credentials.json; "
             "the revived agent will have nothing to authenticate with")
    return sorted(adopted)


# ---------------------------------------------------------------- disk scanners

TITLE_RE = re.compile(rb'"type":"(ai|custom)-title","(?:aiTitle|customTitle)":"((?:[^"\\]|\\.)*)"')
TAG_RE = re.compile(r"</?[a-zA-Z][a-zA-Z0-9_-]*[^>]*>")

# roster color -> ANSI SGR, for colorizing completion candidates
COLOR_ANSI = {
    "red": "31", "green": "32", "yellow": "33", "blue": "34", "purple": "35",
    "magenta": "35", "cyan": "36", "orange": "38;5;208", "pink": "38;5;205",
}

# The harness's titler sometimes echoes an agent name instead of titling,
# and repeats it down the file. Real ai titles are natural language, so
# any whitespace-free ai title is treated as absent; this set catches multiword
# junk. A custom title gets the benefit of the doubt on its wording, since a
# person may have typed it, but not on its authorship: see _harness_wrote.
JUNK_TITLES = {"new session"}

# What the harness wraps around its own records. A slash command, its output,
# and the caveat prepended to a local command all arrive wearing a user's hat.
HARNESS_TAGS = ("<command-name>", "<command-message>", "<command-args>",
                "<local-command-caveat>", "<local-command-stdout>",
                "<local-command-stderr>", "<system-reminder>")


def _harness_wrote(text):
    """Is this text the machinery talking rather than the person?

    Asked in one place because both paths to a title need the same answer and
    only one of them had it: the title records the harness writes, and the
    first user message read when there are none. The filtered path was the
    rarely taken one, so a conversation whose opening prompt was a slash
    command was titled with the caveat wrapped around it, which describes the
    tool the person was running rather than the work they were doing.
    """
    text = text.lstrip()
    return text.startswith("Caveat:") or any(tag in text for tag in HARNESS_TAGS)


def _json_str(raw):
    try:
        return json.loads('"' + raw.decode("utf-8", "replace") + '"')
    except ValueError:
        return raw.decode("utf-8", "replace")


def _first_user_message(head_lines):
    for line in head_lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") != "user" or rec.get("isMeta"):
            continue
        content = (rec.get("message") or {}).get("content")
        if isinstance(content, list):
            content = next((c.get("text") for c in content if isinstance(c, dict) and c.get("type") == "text"), None)
        if not isinstance(content, str) or _harness_wrote(content):
            continue  # exclude harness-generated user-role records from titles
        text = TAG_RE.sub(" ", content).strip()  # unwrap teammate-message/command tags
        if text:
            return text
    return None


def _session_title(path):
    """Newest custom title, else newest ai title, else the first real user message.

    Titles are rewritten throughout the file, so the tail almost always holds
    the current one; only title-less files pay for a head read.
    """
    def pick(found):
        for kind in (b"custom", b"ai"):
            raw = found.get(kind)
            if not raw:
                continue
            text = " ".join(_json_str(raw).split())
            if not text:
                continue
            if _harness_wrote(text):
                continue  # exclude harness-generated title text
            if kind == b"ai" and (" " not in text or text.lower() in JUNK_TITLES):
                continue  # name echo, not a title
            return text
        return None

    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            fh.seek(max(0, size - TITLE_TAIL_BYTES))
            found = {}
            for match in TITLE_RE.finditer(fh.read()):
                found[match.group(1)] = match.group(2)  # last of each kind wins
            title = pick(found)
            if not title:
                had_records = bool(found)
                fh.seek(0)
                head = fh.read(TITLE_HEAD_BYTES).decode("utf-8", "replace")
                if not had_records:  # a junk newest title makes older ones suspect too
                    for match in TITLE_RE.finditer(head.encode()):
                        found[match.group(1)] = match.group(2)
                    title = pick(found)
                if not title:
                    title = _first_user_message(head.splitlines())
    except OSError:
        return None
    if not title:
        return None
    title = " ".join(re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", title).split())
    return title


def bounded_title(title, limit):
    """Bound an already-resolved transcript title for one display."""
    if not title:
        return None
    return title[:limit - 3] + "..." if len(title) > limit else title


UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)


# ------------------------------------------------------- transcript resolution
#
# Resolver selects every agent transcript through resolve_transcript(). Each
# result carries its evidence source and strength for reporting and identity
# validation.

EXACT, STAMPS, NAME_ONLY = 3, 2, 1


class Resolution:
    """A chosen transcript plus how it was chosen. `path` None means no evidence."""

    def __init__(self, path=None, fields=None, last_ts=0, via="", strength=0, others=(),
                 reason="", answered=False, runtime=None, evidence=None, transcript=None):
        self.path, self.fields, self.last_ts = path, fields or {}, last_ts
        self.via, self.strength, self.others, self.reason = via, strength, list(others), reason
        self.runtime = runtime
        self.transcript = transcript
        self.evidence = evidence or {}
        # `answered` marks a reason that already includes a specific remedy, so
        # callers omit their generic resolution explanation.
        self.answered = answered

    def __bool__(self):
        return self.path is not None

    def stamped(self, key):
        return self.fields.get(key, (None,))[0]

    def identity_from_argv(self):
        """Whether argv identified this transcript as the requested agent."""
        if not self.runtime or not self.path:
            return False
        return any(
            held == self.path.stem
            and self.runtime["evidence"].get(pid, {}).get("states_identity")
            for pid, held in self.runtime["processes"]
        )


def lead_title(team_entries, team, limit=60):
    """Title for a team: its lead's session title, via the roster's leadSessionId."""
    for entry in team_entries:
        if entry["team"] == team and entry.get("leadSessionId"):
            res = RESOLVER.resolve_transcript(lead_session=entry["leadSessionId"], team=entry.get("team"),
                                     is_lead=True, quick=True)
            return bounded_title((res.transcript or {}).get("title"), limit) if res else None
    return None


def team_facts(team, entries, limit=60):
    """Return title, member count, activity time, and resume status for a team.

    Roster entries provide current team facts. When cleanup has removed the
    roster, the lead transcript supplies title, activity, and spawned members.
    """
    listed = [e for e in entries if e["team"] == team]
    if listed:
        # This team's own rows, not the whole listing: team_souls reads the
        # lead session out of the first entry it is handed, so the global list
        # would answer about whichever team happened to sort first.
        return (lead_title(entries, team, limit), len(listed),
                ms_str(listed[0]["ts"]),
                None if RESOLVER.team_souls(team, listed) else "resumable transcript search is empty")
    # No directory. The lead's transcript is the roster that outlived it: the
    # payloads in it name the members, and it carries the title and the clock.
    path, _why = RESOLVER.lead_transcript_for(team)
    if not path:
        # Offered and then refused is worse than a shorter list, so the row
        # says now what the run would say later.
        return None, 0, None, "roster missing; lead transcript search is empty"
    return (bounded_title((RESOLVER.transcript_fact(path=path) or {}).get("title"), limit),
            len(RESOLVER.members_spawned_into(path.stem, team)),
            ms_str(int(path.stat().st_mtime * 1000)),
            "roster missing")


def team_line(team, entries, limit=60):
    """One team as one line of a listing. The only place that sentence exists."""
    title, count, when, standing = team_facts(team, entries, limit)
    return render_team_line(title, count, when, standing)


def render_team_line(title, count, when, standing=None):
    """Render already-decided team facts without deciding how complete they are."""
    plural = "member" if count == 1 else "members"
    said = [standing] if standing else []
    if when:
        said.append(f"{count} {plural}")
        said.append(when)
    facts = ", ".join(said)
    return f"{title}  [{facts}]" if title else facts


def completion_team_line(team, entries, limit=60):
    """A bounded team description for TAB completion.

    A roster supplies member count and time. A resolvable leadSessionId supplies
    the title without a full member scan. Rosterless teams use lead spawn records,
    which also provide the evidence required for reconstruction.
    """
    listed = [entry for entry in entries if entry["team"] == team]
    if listed:
        lead = listed[0].get("leadSessionId")
        fact = RESOLVER.transcript_fact(lead)
        title = bounded_title((fact or {}).get("title"), limit)
        return render_team_line(title, len(listed), ms_str(listed[0]["ts"]))
    path, _why = RESOLVER.lead_transcript_for(team)
    if not path:
        return render_team_line(None, 0, None, "roster missing; lead transcript search is empty")
    return render_team_line(
        bounded_title((RESOLVER.transcript_fact(path=path) or {}).get("title"), limit),
        len(RESOLVER.members_spawned_into(path.stem, team)),
        ms_str(int(path.stat().st_mtime * 1000)), "roster missing")


def flatten_cwd(cwd):
    """A cwd's project dir name. Every non-alphanumeric becomes '-' (verified
    against 70 of this machine's project dirs). Lossy, so it has no inverse."""
    return re.sub(r"[^a-zA-Z0-9]", "-", cwd)


def note_cwd(ctx):
    """Print a resolved cwd warning only for a run that may launch the target."""
    warning = ctx["target"].get("cwd_warning")
    if warning:
        warn(warning)


def enter_agent_cwd(ctx, prefix=""):
    """Enter the resolved agent cwd before replacing the current process.

    Foreground lead and in-pane member launches use this path. New-pane launches
    pass the Resolver answer to tmux `-c`, keeping cwd selection consistent across
    launch modes.
    """
    where = ctx["target"]["cwd"]
    if not where or os.path.realpath(where) == os.path.realpath(os.getcwd()):
        return where
    print(f"{prefix}cd       {where}")
    try:
        os.chdir(where)
    except OSError as exc:
        die(f"cannot enter {where}: {exc}")
    return where


def build(args):
    """Translate parsed flags into a resolved identity and judged objections.

    Callers enforce objections after no-op detection, at the point where a launch
    or write begins.
    """
    return RESOLVER.identity(session_uuid=args.resume, agent_id=args.agent_id,
                             for_team=getattr(args, "for_team", None),
                             keep_team=getattr(args, "keep_team", False))


def enforce_ctx(ctx, args):
    """Validate identity and restore behavior before the first action."""
    # Lead migration explicitly requests a team change, so its expected stamp
    # mismatch is allowed after the rebind step records `lead_moving`.
    enforce_identity(ctx["target"], ctx["target"]["objections"],
                     allow_team_change=bool(args.to_team) or bool(ctx.get("lead_moving")),
                     force=args.force)
    enforce_restore(ctx, args)


def enforce_restore(ctx, args):
    """Validate that window-start restore will preserve the requested team.

    A loadable stamped team controls line stamps, spawns, and future restore;
    argv controls idle and message routing for the current split process. A
    null-parent appended record becomes the window root and truncates earlier
    context, while a chained record stays outside restore lookup. Durable rebind
    therefore requires retiring or restamping the source team before launch.
    """
    path = ctx["target"]["transcript"]["path"]
    if not path:
        return
    # A move has already been through the rebind step, which retired the team
    # the stamps name or rewrote them. Asking again here would re-refuse a move
    # this run has just made, and in a dry run, where neither has happened yet,
    # would refuse the preview of it. Both paths record it, and both record it
    # only once the rebind came back with the route it took: a blocked one
    # records nothing, so a launch that never moved still meets the refusal.
    if ctx.get("lead_moving") or ctx.get("member_moving"):
        return
    stamped, state = RESOLVER.restored_identity(path)
    if state != "restored":
        return
    # The comparison is against the DESTINATION: the merged teamName echoes
    # the stamps for a stamped transcript, so comparing it to the restored
    # team compares the stamps to themselves.
    rebind = ctx.get("to_team") if ctx.get("to_team") not in (None, "live", "auto") else None
    dest = rebind or RESOLVER.field(ctx, "teamName")
    if not dest or stamped == dest:
        return
    if rebind and not args.force:
        die(f"this conversation comes back as {stamped} whatever the flags say, "
            f"so a rebind onto {dest} undoes itself at the next restart. "
            f"--force launches it anyway, split between the two teams")
    warn(f"this conversation comes back as {stamped} whatever the flags say, so "
         f"this launch runs split: it writes its history as {stamped}, sends "
         f"idle notifications and messages as {dest}, and reads both teams' mail")


def already_running(ctx, args, table=None, here=(), pane=None):
    """Return a no-op reason when the transcript already has a live holder.

    Leads use session-registry ownership. Members add target-pane and matching
    agent-ID checks. `report=True` marks an agent already in the requested pane as
    a successful existing state. Explicit migration proceeds because its action
    stops the holder first; automatic redirect applies only to stopped members.
    """
    identity = ctx["target"]["identity"]
    is_lead = identity["role"] == "lead"
    agent_id = identity["agentId"]
    if args.force:
        return None
    migrating = bool(ctx.get("to_team")) and not ctx.get("auto_redirect")
    if not is_lead and here and not migrating:
        return (f"{agent_id} is already running in pane {pane} "
                f"(pid {here[0]}{RESOLVER.state_note(here[0])})", True)
    if not is_lead and ctx.get("to_team"):
        return None
    owner = RESOLVER.runtime(table)["best_by_session"].get(ctx["target"]["session"])
    if owner and owner["alive"]:
        # Where that process actually sits, asked of the process rather than
        # echoed from a roster: a member can be live outside tmux entirely.
        where = ""
        if not is_lead and agent_id and table is not None:
            processes = (ctx.get("runtime") or {}).get("process_rows", [])
            holder = next((row for row in processes if row["pid"] == owner["pid"]), None)
            holder = holder or next((row for row in processes if row["socket"]), None)
            where = (f", in pane {holder['pane']} on {holder['socket']}"
                     if holder and holder["socket"] else ", outside any tmux pane")
        return (f"session {ctx['target']['session']} is live as pid {owner['pid']}"
                f"{RESOLVER.state_note(owner['pid'])}{where}; pass --force to run a second copy", False)
    if not is_lead and agent_id:
        # The strangers half only: this decides whether to launch, and a launch
        # that counted the process it is running inside could never spawn past
        # itself. Running this transcript ourselves is refused in run_one.
        runtime = RESOLVER.agent_runtime(agent_id, table)
        elsewhere = [pid for pid, _ in runtime["others"] if pid not in here]
        if elsewhere:
            return (f"{agent_id} is already running outside pane {pane or '?'} "
                    f"(pid {', '.join(map(str, elsewhere))}); pass --force to "
                    "start another instance", False)
    return None


def noop_outcome(ctx, args, prefix, why, socket=None, pane=None, report=False):
    """Report a no-op, record membership, note identity, and return its outcome."""
    # An agent already sitting where it was asked to sit is the run working,
    # not a hazard, so that one says so in the report's own grammar.
    is_lead = ctx["target"]["identity"]["role"] == "lead"
    print(fill(f"{prefix}noop     {why}")) if report else warn(why)
    if not is_lead:
        record_membership(ctx, args, pane)
    note_identity(ctx, prefix)
    return Outcome("noop", socket, is_lead, None)


def note_identity(ctx, prefix=""):
    """Report identity contradictions for a no-op outcome."""
    for kind, stamped, wanted, _why in ctx["target"]["objections"]:
        if kind == "team_mismatch":
            warn(f"{prefix}note: this transcript is stamped team={stamped}, not {wanted}; "
                 "it is live under that identity regardless")
        elif kind == "name_mismatch":
            warn(f"{prefix}note: this transcript is stamped agentName={stamped!r}, "
                 f"not {wanted!r}; it is live under that identity regardless")


def enforce_identity(target, objections, allow_team_change, force):
    """Apply force and team-change rules to resolved identity contradictions.

    Name mismatches stop launch by default because they would bind one agent ID to
    another agent's transcript.
    """
    for kind, stamped, wanted, why in objections:
        if kind == "unstamped_below_exact":
            message = (f"{target['transcript']['path'].name} carries no agent stamps and was matched by {why}; "
                       "only an exact session id may claim an unstamped transcript")
            if not force:
                die(f"{message} (--force to override)")
            warn(f"--force: {message}")
        elif kind == "name_mismatch":
            why, _, corroborated = why.partition("|")
            message = (f"{target['transcript']['path'].name} is stamped agentName={stamped!r}, not {wanted!r} "
                       f"(matched by {why})")
            if corroborated:
                # The roster and the payloads agree on the identity being asked for,
                # so the stamp is the odd one out. Two shapes produce that and the
                # remedy is the same, but the diagnosis is not: a launch that carried
                # the wrong name, or a session that was a teammate first and was
                # later resumed into leading a team. The second has an honest past,
                # so naming only the first would accuse it of damage it does not
                # have. Both are stated and neither is assumed.
                message += (f"; the roster and the spawn payloads both say {wanted!r}, so the "
                            f"stamp is either a launch that carried the wrong name or this "
                            f"session's earlier life as a teammate")
            if not force:
                die(f"{message}. --force resumes it as {wanted!r}, and the lines it writes "
                    f"from then on are stamped correctly")
            warn(f"--force: {message}; resuming as {wanted!r}")
        elif kind == "team_mismatch":
            why, _, newer = why.partition("|")
            if allow_team_change or why == "tolerated":
                warn(f"{target['transcript']['path'].name} is stamped team={stamped}, resuming as {wanted}")
            elif not force:
                message = (f"{target['transcript']['path'].name} is stamped team={stamped}, not {wanted} "
                           f"(matched by {why})")
                if newer:
                    message += (f"; the payloads naming {wanted} were written after those "
                                f"stamps, so --force ratifies the newer evidence rather than "
                                f"overriding the older")
                # The team in an agent id says which agent this is, not where to
                # send it, so a reader who wanted the move has to be told the
                # flag that performs one. --force only lets this launch past the
                # contradiction; the stamps still bring it back as they were.
                die(f"{message}. --into-team {wanted} moves it there instead, retiring "
                    f"{stamped} so the move is still there after the next restart; "
                    f"--force to override")
            else:
                warn(f"--force: {target['transcript']['path'].name} is stamped team={stamped}, resuming as {wanted}")


def apply_selector(token, args, table):
    """Turn the bare argument into --resume, --agent-id or --team.

    The engine decides what the token is; this sets the flag and does the talking.
    An ambiguous name is refused here rather than in the engine because the
    refusal is worth annotating with who is running, which is presentation.
    """
    kind, value, why = RESOLVER.classify(token)

    if kind == "uuid":
        if args.resume and args.resume != token:
            die(f"conflicting sessions: {token} and --resume {args.resume}")
        args.resume = token
    elif kind == "agent_id":
        if args.agent_id and args.agent_id != value:
            die(f"conflicting agents: {token} and --agent-id {args.agent_id}")
        args.agent_id = value
    elif kind == "team":
        # Asked here because a bare token is only known to be a team once the
        # engine has classified it; asking earlier reads a flag nobody set.
        if getattr(args, "here", False):
            die(f"--here gives this terminal to one agent, and {token} covers "
                "every member of it; name the one agent to run here")
        if why != "a roster on disk":
            print(f"team     {token} has no roster on disk; rebuilding it from {why}")
        args.team = token
    elif kind == "name":
        if RESOLVER.name_rosters(token):
            warn(f"{token!r} is {why}")
        else:
            warn(f"no team config lists {token!r}; {why}")
        args.resume = value.path.stem
    elif kind == "ambiguous":
        warn(f"{token!r} is {why}, so it names nobody; pick one:")
        for entry in value:
            agent_id = entry["member"].get("agentId")
            # Both halves: this line states whether a candidate is running and
            # then the run stops, so a candidate we are sitting inside must not
            # be offered as the dead one.
            procs = RESOLVER.agent_runtime(agent_id, table)["processes"]
            state = f"running{RESOLVER.state_note(procs[0][0])}" if procs else "not running"
            warn(f"    {agent_id:<44} joined {ms_str(entry['ts'])}  [{state}]")
        die("pass one of those ids, or a session uuid")
    else:
        die(f"{token} {why}")


def resolve_to_team(args, ctx):
    """--into-team live -> the team this agent's own lead is currently running as.

    Pure ~/.claude hops, no process tree: the agent's roster names its lead
    session, the session registry maps that to a live pid, and that pid's boot
    timestamp identifies the team it minted.
    """
    if args.to_team not in ("live", "auto"):
        if not RESOLVER.has_roster(args.to_team):
            die(f"no team config at {RESOLVER.roster_path(args.to_team)}")
        return args.to_team

    source = RESOLVER.field(ctx, "teamName")
    lead = RESOLVER.agent_runtime(
        agent_id_of("team-lead", source),
        parent_session=RESOLVER.field(ctx, "parentSessionId"))
    pid, how, dest = lead["pid"], lead["how"], lead["runs_as"]
    if not (pid and lead["alive"]):
        die(f"no live lead for team {source}; pass --into-team <name> explicitly")
    if not dest:
        die(f"cannot tell which team pid {pid} runs as; pass --into-team <name> explicitly")
    print(f"rebind   {how}, now running as team {dest}")
    return dest

# ---------------------------------------------------------------- tmux


def tmux(socket, *args):
    return subprocess.run(["tmux", "-L", socket, *args], capture_output=True, text=True)


CLAUDE_PROC = re.compile(r"(^|/)claude$|/versions/[\d.]+$")

# The binary the suite's fake process table claims to be running. It matches
# CLAUDE_PROC through the versioned-path branch, so the checks exercise the real
# matcher, while naming itself loudly enough that a row escaping the fixture
# could never be read as a live agent or mistaken for an install on this box.
FAKE_AGENT_BIN = f"/nonexistent/{TOOL}-selftest/versions/0.0.0"


# ---------------------------------------------------------------- resolution


def resolve_socket(ctx, args, table):
    """--socket > socket hosting a live process for this agent > lead pid > invent."""
    agent_id = RESOLVER.field(ctx, "agentId")

    if args.socket:
        return args.socket, getattr(args, "socket_reason", "--socket")

    # The team placement chose, so a redirected member seats with the crew it was
    # placed into rather than with whatever its address named.
    sock, why = RESOLVER.crew_socket(RESOLVER.field(ctx, "teamName"), table)
    if not sock:
        for process in (ctx.get("runtime") or {}).get("other_processes", []):
            if process["socket"]:
                sock, why = (process["socket"],
                             f"live pane {process['pane']} of pid {process['pid']}")
                break
    if sock:
        return sock, why

    # When rebinding, the member is being placed on the DESTINATION lead's
    # server; asking about the source team fails outright when that team is dead,
    # which is the usual reason for rebinding in the first place.
    team = ctx.get("to_team") or RESOLVER.field(ctx, "teamName")
    parent = ctx.get("to_lead") if ctx.get("to_team") else RESOLVER.field(ctx, "parentSessionId")
    lead = RESOLVER.agent_runtime(
        agent_id_of("team-lead", team), table, parent_session=parent)
    pid, alive, how = lead["pid"], lead["alive"], lead["how"]
    if pid and not alive:
        # A pid is only a socket name while its process exists. Pid numbers are
        # recycled, so a server named after a dead one is either absent or, worse,
        # a live stranger's, and members would silently join it. Fall through to
        # the team's own server, which is what the rung below stands the team up on.
        warn(f"the lead last ran as pid {pid}, which is gone; using the team's own server")
        pid = None
    if pid:
        if not ctx.get("to_team"):
            # The lead is up but has since minted a new implicit team. Reviving
            # into the old roster still works, but the lead's SendMessage
            # resolves against the team it runs as now, so mail to this member
            # would land in an inbox directory nobody reads.
            agent_id = RESOLVER.field(ctx, "agentId")
            if agent_id and not ctx.get("stale_team_warned"):
                diagnosis = RESOLVER.agent_diagnosis(agent_id, parent)
                reachable, why = diagnosis["reachable"]
                if reachable is False:
                    fix = "; ".join(f"{what} ({cost})" for what, cost in diagnosis["remedies"])
                    warn(f"{why}{'. ' + fix if fix else ''}")
        return f"{SOCKET_PREFIX}{pid}", how

    # The team's lead is gone, so stand its own server back up rather than
    # borrowing a live stranger's. The members keep their original identity, so
    # they belong together on their own server, not scattered onto whichever
    # session happens to be running. Named after the team, so every member of it
    # lands on the same server across invocations, exactly as if the lead were
    # still up and hosting them.
    if team:
        warn(f"no live lead for {team}; standing up that team's own server, as if its lead were up")
        return f"{SOCKET_PREFIX}{team}", f"resurrected server for {team}"
    return None, None


def maybe_attach(args, socket):
    """Attach to the swarm unless something says not to, then say why not.

    Reviving an agent you cannot see is half a job, so a session nobody is
    watching gets attached. Three things veto it: CLAUDECODE, which means a
    tool is driving and would have its shell replaced by a tmux client; no tty
    to attach; and being inside tmux already, where attaching another server
    nests clients.
    """
    if not socket or args.no_attach:
        return
    if not RESOLVER.socket_alive(socket):
        # Every veto below is about whether attaching is wanted. This one is
        # about whether there is anything to attach to, so it comes first and
        # suggests no command: a run where nothing launched leaves an empty
        # socket, and printing "attach with ..." for it sends you at a server
        # that was never stood up.
        print(f"nothing to attach to: no server on {socket}")
        return
    reason = None
    if os.environ.get("CLAUDECODE"):
        reason = "a Claude Code tool is driving"
    elif not sys.stdout.isatty():
        reason = "not a terminal"
    elif RESOLVER.inside_tmux():
        reason = "already inside tmux"
    elif not args.attach and RESOLVER.attached_clients(socket):
        reason = "someone is already watching it"

    if reason and not args.attach:
        print(f"attach with: tmux -L {socket} attach -t {TMUX_SESSION}   ({reason})")
        return
    if reason and args.attach:
        warn(f"--attach requested but {reason}; attach by hand: tmux -L {socket} attach -t {TMUX_SESSION}")
        return
    print(f"attaching to {socket}")
    os.execvp("tmux", ["tmux", "-L", socket, "attach", "-t", TMUX_SESSION])


# roster colour -> tmux colour, for the names where they differ (2.1.202 map)
TMUX_COLORS = {"purple": "magenta", "orange": "colour208", "pink": "colour205"}


LAUNCH_APPEAR_S = 10.0   # only ever waited out when nothing appears at all
LAUNCH_SETTLE_S = 1.5    # then confirm it did not exit immediately
LAUNCH_WRITE_S = 45.0    # a large session takes tens of seconds to load and write


def launch_present(socket, pane, agent_id):
    fresh = RESOLVER.process_table(refresh=True)
    # The strangers half only: our own lineage was in place before this
    # launch, so counting it would call every launch a success.
    appeared = (RESOLVER.agent_runtime(agent_id, fresh)["others"]
                if agent_id else [])
    if appeared:
        return True
    if pane:
        occupants = RESOLVER.runtime(fresh)["by_pane"].get((socket, pane), [])
        if any(RESOLVER.is_claude(row["args"]) for row in occupants):
            return True
    return False


def launch_survived(socket, pane, agent_id, transcript=None, since=None):
    """Did a claude come up and stay up? Asked before the roster is told it did.

    Two different failures, so two waits. Appearing is near-instant: the pane
    execs the binary and reads the transcript afterwards, so an 81MB session is
    visible in under a tenth of a second, and this timeout is only ever waited
    out when nothing appears at all. Dying immediately afterwards (bad auth, a
    transcript it cannot load) is the one that would otherwise be recorded as a
    live member, so a launch is also given a moment and re-checked.
    """
    deadline = time.monotonic() + LAUNCH_APPEAR_S
    while not launch_present(socket, pane, agent_id):
        if time.monotonic() > deadline:
            return False, f"nothing appeared in {LAUNCH_APPEAR_S:.0f}s"
        time.sleep(0.1)
    # A booting agent writes its own transcript within seconds, which says more
    # than "a process exists": it got far enough to load the session. Waiting
    # for that beats waiting out the settle, so take it as soon as it lands.
    settle_until = time.monotonic() + LAUNCH_SETTLE_S
    while time.monotonic() < settle_until:
        if transcript and since is not None:
            try:
                if transcript.stat().st_mtime > since:
                    return True, "wrote to its transcript"
            except OSError:
                pass
        time.sleep(0.1)
    if not launch_present(socket, pane, agent_id):
        return False, f"it started and exited within {LAUNCH_SETTLE_S:.1f}s"
    return True, "running, no transcript write yet"


def tint_pane(socket, pane, colour, name, dry):
    """Tint a pane the way the harness tints its own.

    A pane this tool creates gets no tint (only a real spawn applies one), so
    without this a revived agent is the one grey pane in a coloured swarm. It
    is three pane options plus the bold titled border, matching what the
    harness does, so revived and spawned members look alike.
    """
    if not (colour or name) or (not pane and not dry):
        return
    tint = TMUX_COLORS.get(colour, colour)
    actions = []
    if tint:
        actions += [
            ("set-option", "-p", "-t", pane, "window-style", f"bg=default,fg={tint}"),
            ("set-option", "-p", "-t", pane, "pane-border-style", f"fg={tint}"),
            ("set-option", "-p", "-t", pane, "pane-active-border-style", f"fg={tint}"),
        ]
    if name:
        actions.append(("select-pane", "-t", pane, "-T", name))
        actions.append(("set-option", "-p", "-t", pane, "pane-border-format",
                        f"#[fg={tint or 'default'},bold] #{{pane_title}} #[default]"))
    where = f"{pane or '<new pane>'} {tint or '(no colour)'}, titled {name}"
    if not dry:
        for action in actions:
            tmux(socket, *action)
    step(dry, f"would tint {where}", f"tinted {where}")


class LaunchFailed(Exception):
    """tmux refused to place this agent. One member's problem, not the run's."""


def launch(socket, want_pane, cwd, command, dry, replace_pane=None):
    """Start the agent: reuse the socket/session if live, else rebuild it.

    Never reuses an occupied pane: the caller has already decided that whatever
    lives in the recorded pane is not this agent, so we always get our own pane.
    """
    session_live = RESOLVER.swarm_session_live(socket)
    # A poison left on the server by an interrupted Recipe 1 run must not be
    # inherited by a real resume. Anything else set there is the operator's and
    # is passed through: the swarm's own agents are running with it.
    # Two routes carry a base url into the pane, and exactly one of them is live
    # for any given launch. A server already running hands the pane its own
    # global environment; a server this run creates inherits ours, which tmux
    # then seeds that global environment from. Asking the wrong one is a fault in
    # either direction: ask only the server and a poison arrives by descent
    # moments later, ask both and a launch from inside a poisoned pane strips the
    # legitimate url a live server was about to give the agent.
    if RESOLVER.socket_alive(socket):
        server_url = tmux(socket, "show-environment", "-g", "ANTHROPIC_BASE_URL")
        value = server_url.stdout.strip().partition("=")[2] if server_url.returncode == 0 else ""
        carrier = socket
    else:
        value, carrier = os.environ.get("ANTHROPIC_BASE_URL", ""), "this shell"
    scrub = "-u ANTHROPIC_BASE_URL " if poison_said(value, carrier) else ""
    quoted = (
        "exec env " + scrub
        + " ".join(TEAM_ENV) + " "
        + " ".join(shlex.quote(c) for c in command)
    )

    if replace_pane and not session_live:
        # The caller decided a specific pane must die. If the session is gone we
        # cannot honor that, and silently downgrading would leave the old
        # process alive while the report claimed it was replaced.
        warn(f"cannot replace pane {replace_pane}: no live {TMUX_SESSION} session on {socket}")
        replace_pane = None

    if session_live and not dry:
        # An existing server has whatever env it was born with. Top up only
        # what is missing; a secret's value rides a transient client argv here,
        # so skip it whenever the server already has the variable.
        for key in INHERIT_ENV:
            if os.environ.get(key) and tmux(socket, "show-environment", "-g", key).returncode != 0:
                tmux(socket, "set-environment", "-g", key, os.environ[key])

    if replace_pane and session_live:
        # This pane holds a live process resuming the same transcript, so kill it
        # in place rather than leave two processes appending to one JSONL.
        argv = ["respawn-pane", "-k", "-t", replace_pane]
        action = "respawn"
    elif not session_live:
        if not RESOLVER.socket_alive(socket):
            warn(f"socket {socket} is down, reestablishing")
        else:
            warn(f"session {TMUX_SESSION} missing on {socket}, recreating")
        # A detached server takes tmux's 80x24 default. A resurrected swarm gets
        # the room the harness's own spawner has.
        argv = ["new-session", "-d", "-s", TMUX_SESSION, "-n", TMUX_WINDOW,
                "-x", str(SWARM_COLS), "-y", str(SWARM_ROWS), "-P", "-F", "#{pane_id}"]
        action = "new-session"
    elif want_pane and RESOLVER.pane_exists(socket, want_pane):
        argv = ["split-window", "-t", want_pane, "-P", "-F", "#{pane_id}"]
        action = "split"
    else:
        if want_pane:
            warn(f"recorded pane {want_pane} no longer exists on {socket}")
        panes = [p for p in RESOLVER.list_panes(socket) if p["session"] == TMUX_SESSION]
        if panes:
            argv = ["split-window", "-t", panes[0]["pane"], "-P", "-F", "#{pane_id}"]
            action = "split"
        else:
            argv = ["new-window", "-t", TMUX_SESSION, "-n", TMUX_WINDOW, "-P", "-F", "#{pane_id}"]
            action = "new-window"
    if cwd:
        argv += ["-c", cwd]
    argv.append(quoted)

    # A record, not a paste form: it wraps at spaces even inside the quoted
    # exec argument, and rejoining continuation lines with one space restores
    # the exact string tmux was handed.
    rendered = f"tmux -L {socket} {' '.join(shlex.quote(a) for a in argv)}"
    if dry:
        step(True, wrap_command(rendered, "  would run: ", "    "), "", indent="")
        return (replace_pane if action == "respawn" else None), action
    res = tmux(socket, *argv)
    if res.returncode != 0:
        raise LaunchFailed(f"tmux {argv[0]} failed: {res.stderr.strip()}")
    if action in ("split", "new-window"):
        # Panes are placed the way the harness's own spawner places them. Tiling
        # reclaims the whole window, so what fits is a property of the window
        # rather than of how many splits preceded it.
        tmux(socket, "select-layout", "-t", TMUX_SESSION, "tiled")
    step(False, "", wrap_command(rendered, "  ran: ", "    "), indent="")
    # respawn-pane takes no -P/-F, so it prints nothing: the pane is the one we
    # aimed at. Everything else printed its new pane id.
    return (replace_pane if action == "respawn" else res.stdout.strip()), action


SPAWN_MARKER = "teammate_spawned"

