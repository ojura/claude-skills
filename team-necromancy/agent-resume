            return eng7._rewriter.restamp_plan(
                path, team, name=name, start=eng7._window_start(path))
        try:
            # locate + two-field closure, name-optional
            plan = restamp(target, "NEW")
            if plan["objections"] or not plan["proved"]:
                stray.append(f"no-rename plan: {plan['objections'] or 'unproved'}")
            else:
                loaded = json.loads(plan["lines"][0])
                if loaded.get("teamName") != "NEW":
                    stray.append("a no-rename restamp did not set teamName")
                if loaded.get("agentName") != "mate":
                    stray.append("a no-rename restamp touched agentName")
                if plan["lines"][1] != fixture_line(rows[1]):
                    stray.append("the tail line changed under a window-start edit")
            # renaming touches both fields
            rplan = restamp(target, "NEW", name="newmate")
            if not rplan.get("proved"):
                stray.append(f"rename plan: {rplan['objections']}")
            else:
                r0 = json.loads(rplan["lines"][0])
                if r0.get("teamName") != "NEW" or r0.get("agentName") != "newmate":
                    stray.append("a rename restamp did not touch both fields")
            # already-agreeing is a no-op refusal
            noop = restamp(target, "OLD")
            if noop["proved"] or not noop["objections"]:
                stray.append("an already-agreeing restamp did not refuse")

            # Last means last when old files contain more than one trace. The
            # newer trace remains active even with a settings record after it.
            multi = proj / "RSMULTI.jsonl"
            multi_rows = [dict(row) for row in rows]
            multi_rows[0]["teamName"] = "NEW"
            multi.write_text("".join(fixture_line(row) + "\n" for row in multi_rows) +
                fixture_line({"type": RESTAMP_RECORD, "restamp": {
                    "old": {"teamName": "ANCIENT", "agentName": "mate"},
                    "new": {"teamName": "MID", "agentName": "mate"}}}) + "\n" +
                fixture_line({"type": RESTAMP_RECORD, "restamp": {
                    "old": {"teamName": "OLD", "agentName": "mate"},
                    "new": {"teamName": "NEW", "agentName": "mate"}}}) + "\n" +
                fixture_line({"type": "mode", "mode": "plan"}) + "\n")
            multi_plan = restamp(multi, "FAR")
            multi_last = TranscriptRewriter._last_record_at(
                multi_plan.get("lines") or [], RESTAMP_RECORD, "restamp")[0]
            if not multi_plan.get("proved") or (multi_last or {}).get("old", {}).get(
                    "teamName") != "OLD" or (multi_last or {}).get("new", {}).get(
                    "teamName") != "FAR":
                stray.append("the restamp did not consume the last of several traces")

            def provable(made, what):
                """Whether this plan may be applied, recording why when not.

                apply_restamp raises on an unproved plan, and a traceback
                ends the whole suite instead of failing this check, so a
                probe against either of restamp_plan's guards would prove
                nothing here. Every step below needs the write before it, so
                a plan that cannot be applied stops the sequence rather than
                leaving the next step to read a file nobody wrote.
                """
                if made["objections"] or not made["proved"]:
                    stray.append(f"{what}: {made['objections'] or 'unproved'}")
                    return False
                return True

            # The only receipt is in the JSONL. Records appended after it do not
            # retire it: the reverse scan still selects and consumes it.
            if provable(plan, "the first restamp did not apply"):
                apply_restamp(plan)
                stored = eng7._rewriter._last_record_in_file(
                    target, RESTAMP_RECORD, "restamp")
                if (stored or {}).get("old", {}).get("teamName") != "OLD":
                    stray.append("the in-file receipt did not record the old value")
                if list(Path(td).rglob("*.restamp.json")):
                    stray.append("the restamp wrote a receipt outside the transcript")
                if target.stat().st_mode & 0o777 != 0o600:
                    stray.append("the restamp did not preserve file mode")
                appended = [
                    fixture_line({"type": "mode", "mode": "acceptEdits"}),
                    fixture_line({"type": "permission-mode", "mode": "default"}),
                ]
                with target.open("a") as handle:
                    handle.write("\n".join(appended) + "\n")
                back = restamp(target, "OLD")
                if provable(back, "the restamped file does not restamp back"):
                    apply_restamp(back)
                    # Returning to the origin consumes the middle receipt while
                    # retaining everything Claude Code appended after it.
                    was = "".join(fixture_line(r) + "\n" for r in rows) + \
                        "\n".join(appended) + "\n"
                    if target.read_text() != was:
                        stray.append("the round trip did not restore the bytes around the receipt")
                    # Three moves leave one record of the net change. The final
                    # move must find the receipt before an appended ordinary row.
                    hopped = True
                    for team, which in (("MID", "the second hop"), ("FAR", "the third hop")):
                        hop = restamp(target, team)
                        if not provable(hop, f"{which} did not apply"):
                            hopped = False
                            break
                        apply_restamp(hop)
                        if team == "MID":
                            with target.open("a") as handle:
                                handle.write(fixture_line({"type": "assistant",
                                    "uuid": "after-restamp", "parentUuid": "rs-tail"}) + "\n")
                    if hopped:
                        lines = target.read_text().splitlines()
                        traces = [json.loads(each)["restamp"] for each in lines
                                  if RESTAMP_RECORD in each]
                        if len(traces) != 1:
                            stray.append(f"three moves left {len(traces)} traces")
                        elif (traces[0]["old"]["teamName"], traces[0]["new"]["teamName"]) != ("OLD", "FAR"):
                            stray.append(f"the trace forgot the origin: {traces[0]['old']} "
                                         f"-> {traces[0]['new']}")
        finally:
            pass
        # The live-holder guard: the composed question sees a lineage pid,
        # and the writer is unreachable without it being asked first.
        me = os.getpid()
        alive_table = [(me, 0,
                        ("claude", "--resume", target.stem, "--agent-id", "mate@OLD"))]
        if not RESOLVER._runtime(alive_table)["transcripts"].get(
                target.stem, {}).get("ours"):
            stray.append("the holder question misses a live restamp target")
        rebind_node = s.resolver_methods["_rebind_plan"]
        reap_calls = [call for call in s.ast.walk(rebind_node)
                      if isinstance(call, s.ast.Call)
                      and isinstance(call.func, s.ast.Attribute)
                      and call.func.attr == "_reap_objections"]
        restamp_calls = [call for call in s.ast.walk(rebind_node)
                         if isinstance(call, s.ast.Call)
                         and isinstance(call.func, s.ast.Attribute)
                         and call.func.attr == "restamp_plan"]
        if (len(reap_calls) != 1 or len(restamp_calls) != 1
                or reap_calls[0].lineno >= restamp_calls[0].lineno):
            stray.append("the rebind plan does not classify holders before restamp planning")
        # A redirect makes its own move durable: nothing objecting means the
        # team is retired without asking, and anything objecting is reported
        # with its remedy while the agent stays where its conversation says.
        quiet_dir = Path(td) / "quiet"
        (quiet_dir / "OLD").mkdir(parents=True)
        eng7._roster_path = lambda t: quiet_dir / t / "config.json"
        (quiet_dir / "OLD" / "config.json").write_text('{"name": "OLD", "members": []}')
        real_teams2, real_objs = RESOLVER._teams_dir, RESOLVER._reap_objections
        RESOLVER._teams_dir = quiet_dir
        try:
            class _Quiet:
                force, dry_run, with_mail = False, True, False
            RESOLVER._reap_objections = lambda *a, **k: []
            quiet_plan = RESOLVER._rebind_plan(
                "OLD", "NEW", target, (), census=(), force=False)
            with capturing("out") as out:
