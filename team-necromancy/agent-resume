@unit(('poison-preview-changes-nothing', 'a --poison preview changes no server environment'))
def _check_poison_preview_changes_nothing(s):
    """--poison and --unpoison each change one variable on a running server,
    so a preview of either has exactly one thing it must not do.

    Read off the server, not off the report. A preview that printed the old
    value and set the new one anyway would satisfy any check that only read
    the printed line, so the evidence here is the environment the fixture
    holds afterwards and the commands it recorded getting there. Both
    directions are run for real as well: a preview that changes nothing says
    nothing on its own unless the same command line without --dry-run does
    change something.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sock = f"{SOCKET_PREFIX}selftest-poison"
    engine = Resolver(needs=Needs(maybe=set(NEED)))
    server = _FakeTmux(sockets=[sock])
    # Start on a working gateway rather than unset: the promise is that a
    # preview leaves whatever was there, and an environment that starts empty
    # cannot tell leaving it alone apart from clearing it.
    was = "https://api.anthropic.com"
    server.env["ANTHROPIC_BASE_URL"] = was
    # What run_poison may ask a server while previewing. Written as the
    # commands that read rather than as a list of the ones that write, so a
    # command added later has to be named a read here before a preview may
    # run it, instead of passing because nobody thought to ban it.
    READS = {"has-session", "list-clients", "show-environment"}

    def poisoning(**flags):
        """One run_poison call: what it printed, what it returned, what it
        left behind, and which tmux commands it took to get there."""
        args = types.SimpleNamespace(socket=sock, poison=False, dry_run=False)
        args.__dict__.update(flags)
        before, mark = dict(server.env), len(server.ran)
        said = io.StringIO()
        with capturing("out", into=said):
            code = run_poison(args)
        return types.SimpleNamespace(
            said=said.getvalue(), code=code, before=before,
            after=dict(server.env), ran={cmd[0] for cmd in server.ran[mark:]})

    with server.installed(engine):
        set_preview = poisoning(poison=True, dry_run=True)
        poisoned = poisoning(poison=True)
        clear_preview = poisoning(dry_run=True)
        cleared = poisoning()

    previewing = {
        # The whole environment, not the one variable: a preview that
        # preserved ANTHROPIC_BASE_URL and set something else beside it is
        # still a preview that changed the server.
        "the poison preview leaves the environment exactly as it found it":
            set_preview.after == set_preview.before,
        "it runs nothing that could have changed one": set_preview.ran <= READS,
        "it names the socket and the url it would set":
            "would poison" in set_preview.said and sock in set_preview.said
            and POISON_URL in set_preview.said,
