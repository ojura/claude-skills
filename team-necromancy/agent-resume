    if "agent_id_of(" in roster_src or 'self.field(ctx, "agentId")' not in roster_src:
        offenders.append("roster_record reconstructs identity")
    target_consumers = {
        "already_running": ["ctx", "args", "table", "here", "pane"],
        "become_agent": ["ctx", "command", "prefix", "undo"],
        "decline_unreachable": ["ctx", "args", "source", "dest", "prefix"],
        "noop_outcome": ["ctx", "args", "prefix", "why", "socket", "pane", "report"],
        "report_launch": ["ctx", "command", "prefix", "extra"],
    }
    for name, expected in target_consumers.items():
        node = s.funcs[name]
        args = [arg.arg for arg in node.args.args]
        source = s.src_of(node) or ""
        if args != expected or 'ctx["target"]["identity"]' not in source:
            offenders.append(f"{name} accepts a second identity or role")
    setters = s.callers_of("set_effective_identity") - s.suite_fns
    if setters != {"identity", "auto_redirect", "run_one"}:
        offenders.append("effective identity set by " + ", ".join(sorted(setters)))
    check("identity-consumers-do-not-read-the-merge",
          "launch and persistence consumers cannot bypass effective identity",
          not offenders, ", ".join(offenders))
    return checked


