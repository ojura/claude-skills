                    and isinstance(call.func, ast.Attribute)
                    and isinstance(call.func.value, ast.Name)
                    and call.func.value.id == "self"
                    and call.func.attr == "runtime"
                    and not call.args and not call.keywords):
                rereads.append(f"{fn.name}:{call.lineno}")
    check("runtime-consumers-do-not-reread",
          "a runtime consumer does not replace its supplied table or snapshot",
          not rereads, ", ".join(sorted(set(rereads))))
    return checked


@unit(("live-fixtures-are-this-run's", "a live fixture name belongs to the run that made it"))
def _check_live_fixtures_are_own(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    # A socket or an agent id is machine-global, so a name fixed in the source
    # is a name every concurrent run answers to. Two live tiers then stand up
    # one server between them and each run's --stop ends the other's fixture.
    # own() is what makes a name this run's; a literal here is a name shared.
    # What the machine shares is a tmux socket, named for this tool, and an
    # agent id, worn by a real process. A team directory named in a fixture
    # lives under that run's own config dir and collides with nobody.
    shared = []
    for fnode in ast.walk(s.tree):
        if not (isinstance(fnode, ast.FunctionDef) and fnode.name in s.suite_fns):
            continue
        for node in ast.walk(fnode):
            if not isinstance(node, ast.Assign):
                continue
            machine_wide = False
            for piece in ast.walk(node.value):
                if isinstance(piece, ast.Constant) and isinstance(piece.value, str):
                    if "@selftest" in piece.value:
                        machine_wide = True
                elif isinstance(piece, ast.JoinedStr):
                    spelled = ast.dump(piece)
                    if "'TOOL'" in spelled and "selftest" in spelled:
                        machine_wide = True
            if not machine_wide:
                continue
            owned = any(isinstance(p, ast.Call) and getattr(p.func, "id", None) == "own"
                        for p in ast.walk(node.value))
            if not owned:
                where = [t.id for t in node.targets if isinstance(t, ast.Name)]
                shared.append(f"{fnode.name}: {where[0] if where else '?'}")
    check("live-fixtures-are-this-run's", "a live fixture name belongs to the run that made it",
          not shared, ", ".join(sorted(set(shared))))
    return checked


@unit(('shares-cover-the-tier-once',
       'splitting the live tier any number of ways runs each check exactly once'))
def _check_shares_cover_the_tier_once(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    live_units = [name for name, _ids, _run, is_live in UNITS if is_live]
    # in_share is what the runner splits by, so it is asked here rather than
    # the split being worked out again: a check doing its own arithmetic would
    # agree with itself while the runner disagreed with both of them. A share
    # that dropped a unit would otherwise read as a smaller tier passing, and a
    # share that took one twice as a duplicate id nobody looked for.
    over = len(live_units) + 3      # more shares than units: the empty ones count too
    wrong = sorted(jobs for jobs in (1, 2, 3, 4, 7, 16, over)
                   if sorted(at for which in range(jobs)
                             for at in in_share(len(live_units), (which, jobs)))
                   != list(range(len(live_units))))
    check("shares-cover-the-tier-once",
          "splitting the live tier any number of ways runs each check exactly once",
          not wrong and in_share(len(live_units), None) == list(range(len(live_units))),
          f"wrong at {wrong} share(s)" if wrong
          else f"{len(live_units)} unit(s), split every way up to {over}")
    return checked


# Declared to read the machine: its subject is a process wearing a fixture
# identity outside the tree of the selftest process that runs it, which
# start_stray puts there with this run's adoption switched off, and only the
# machine's process table lists such a process.
@unit(("smoke-counts-only-what-it-started",
       "the smoke tier counts processes it started, not the machine's"), live=True,
      machine=True)
def _check_smoke_counts_only_what_it_started(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # A process wearing a fixture identity that this run did not start is
    # another run's, or a person's. The tier asks what it started, so it must
    # not see one. Demonstrated with a process put outside this lineage on
    # purpose by start_stray: started by a child that exits while this run
    # adopts nothing, so the process above this run that adopts orphans takes
    # it and its parent chain never reaches us.
    sp = s.sp
    stray_room = Path(tempfile.mkdtemp(prefix=f"{TOOL}-stray-"))
    orphan, life = start_stray(stray_room / "pid", "--agent-id", "stray@session-corpus-alpha")
    # A fixture id spelled inside another argument is not an id anything wears.
    # This one is started as this run's own child on purpose, so lineage is not
    # what excludes it: the machine-wide question below has to refuse it too.
    decoy = sp.Popen([FAKE_AGENT_BIN, "-c",
                      "import time; 'stray@session-corpus-alpha'; time.sleep(30)"],
                     executable=sys.executable)
    # Outside this run's lineage by design, so nothing under this run reaches
    # it: its pid and life line are kept here and it is ended by them below,
    # which a SIGTERM to this run also reaches. Under the verifier the suite's
    # supervisor adopted it, and ends it should this run be killed first.
    try:
        # Until the decoy's exec has set its command line, a table leaves the
        # decoy out, so the table is read once it is set.
        wait_for_command_line(decoy.pid)
        table = RESOLVER._process_table(refresh=True)
        rows = {pid: cmd for pid, _ppid, cmd in table}
        # The tier's own question, not a copy of it: a narrowing removed from
        # started_here has to show up here, or this check is asserting its own
        # arithmetic rather than the code the tier runs.
        counted = started_here()
        wearing = {str(pid) for pid, cmd in rows.items() if fixture_worn(cmd)}
        told = {
            "the stray is running and wears a fixture identity":
                fixture_worn(rows.get(orphan, ())) == "stray@session-corpus-alpha",
            # The flag and its value are read as a pair, so an id written into
            # some other argument is not one this run started.
            "an id inside another argument counts as nobody's":
                decoy.pid in rows and str(decoy.pid) not in wearing
                and str(decoy.pid) not in counted,
            "it is not in this run's lineage":
                orphan not in RESOLVER._descendants_of(os.getpid(), table),
            "so what this run started does not count it":
                str(orphan) not in counted,
            # Without the narrowing there is nothing to prove: the machine-wide
            # question is the one that would have counted it.
            "though the machine-wide question would have":
                str(orphan) in wearing,
        }
    finally:
        decoy.kill()
        decoy.wait()
        # Nothing under this run reaches it, by design.
        end_stray(orphan, life)
        shutil.rmtree(stray_room, ignore_errors=True)
    wrong = sorted(k for k, ok in told.items() if not ok)
    check("smoke-counts-only-what-it-started",
          "the smoke tier counts processes it started, not the machine's",
          not wrong, ", ".join(wrong))
    return checked


def stamped_team(path):
    """The team the window-start record of one transcript names."""
    for raw in path.read_text().splitlines():
        try:
            rec = json.loads(raw)
        except ValueError:
            continue
        if rec.get("parentUuid") is None and "teamName" in rec:
            return rec["teamName"]
    return None


def restamp_receipts(path):
