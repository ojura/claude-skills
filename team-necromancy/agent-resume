          "runtime questions use the process table supplied to the caller",
          not wrong, ", ".join(wrong))

    rereads = []
    ast = s.ast
    suite_names = {name for name, _ids, _run, _live in UNITS}
    suite_ranges = [(fn.lineno, fn.end_lineno or fn.lineno)
                    for fn in ast.walk(s.tree)
                    if isinstance(fn, ast.FunctionDef) and fn.name in suite_names]
    for fn in ast.walk(s.tree):
