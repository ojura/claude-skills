def own(name):
    """A fixture name this run alone answers to.

    Sockets and agent ids are machine-global. Two live tiers at once used to
    stand up the same server and wear the same id, so each run's --stop found
    the other's fixture and ended it: measured as "aborted 2 of 2" against a
    check that wants one. The pid makes a name this run owns.
    """
    return f"{name}-{os.getpid()}"


def ended(socket):
    """End a fixture's tmux server, and remove the file it leaves behind.

    kill-server stops the server and leaves its socket file in the socket
    directory. A fixture's name belongs to one run, so no later run reuses that
    name or writes over the file, and every run that stood a server up added
    one more that nobody would remove. --cleanup does not reach them: it reaps
    swarm sockets by their own prefix, and teaching it the suite's names would
    put the suite's litter in the tool's hands. A test clears up after itself.

    In a finally, so a kill-server that fails still takes the file with it.
    """
    try:
        tmux(socket, "kill-server")
    finally:
        # Where tmux keeps its sockets is the engine's answer; unlinking one is
        # not a question, so it happens here rather than there.
        with contextlib.suppress(OSError):
            (RESOLVER.socket_dir() / socket).unlink(missing_ok=True)


