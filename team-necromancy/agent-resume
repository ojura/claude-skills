        died, msg = _dies(check_passthrough, [flag, "x"], _Renamed())
        return msg.split("flags for the resumed session")[0] if died else "was not refused"

    prefixed, shared = _suggested("--as"), _suggested("--into")
    ours_typo, both_near = _suggested("--tmux-sessionn"), _suggested("--team-nam")
    claude_typo, resembles_nothing = _suggested("--modle"), _suggested("--frobnicate")
    sourced = {
        "the old name of a renamed flag is answered with the new one":
            "--as-agent?" in prefixed,
        "and not with the claude flag that scores higher on it":
            "--betas" not in prefixed,
