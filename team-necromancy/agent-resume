@unit(('scaffolding-named-once', "the sweep and the reap work from one list of this tool's own files"))
def _check_scaffolding_named_once(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    tree = s.tree

    listed = [node.lineno for node in ast.walk(tree)
              if isinstance(node, (ast.Set, ast.List, ast.Tuple))
              and any(isinstance(part, ast.Constant) and part.value == "config.json.lock"
                      for part in node.elts)]
    defined = [node for node in tree.body if isinstance(node, ast.Assign)
               and any(isinstance(target, ast.Name) and target.id == "SCAFFOLDING"
                       for target in node.targets)]
    forked = []
    if len(defined) != 1:
        forked.append(f"SCAFFOLDING is assigned {len(defined)} time(s), not once")
    else:
        span = range(defined[0].lineno, (defined[0].end_lineno or defined[0].lineno) + 1)
        elsewhere = [line for line in listed if line not in span]
        if elsewhere:
            forked.append("the names are listed again at line "
                          + ", ".join(str(line) for line in elsewhere))
    scanner = s.resolver_methods.get("_scaffolding_and_strays")
    reapers = (s.resolver_methods.get("_reap_plan"),
               s.resolver_methods.get("revalidate_reap"))
    if not scanner:
        forked.append("the Resolver has no scaffolding scanner")
    elif "SCAFFOLDING" not in {sub.id for sub in ast.walk(scanner)
                                if isinstance(sub, ast.Name)}:
        forked.append("the scaffolding scanner does not read SCAFFOLDING")
    for node in reapers:
        calls = [sub for sub in ast.walk(node) if isinstance(sub, ast.Call)
                 and isinstance(sub.func, ast.Attribute)
                 and sub.func.attr == "_scaffolding_and_strays"] if node else []
        if len(calls) != 1:
            forked.append("each reaper selection reads the one scaffolding scanner")
    check("scaffolding-named-once",
          "the sweep and the reap work from one list of this tool's own files",
          not forked, "; ".join(forked))
    return checked


