# The units a copy of this tool runs in place of its own, put in front of its
# main guard by the check below. Two read-only units around one that changes
# the shared context and raises, and four live ones placed so that a run split
# two ways gives the raising unit and the unit after it to one share and the
# other two to the other share. Each unit marks a file when it runs, in the
# directory FAULT_FIXTURE_MARKS names, so whether a unit ran is read off disk
# rather than off a report the runner under test wrote. The raise is chained,
# so the traceback has a middle, the cause, and an end, the error, each with
# text found nowhere else.
FAULT_FIXTURE_UNITS = r'''


FIXTURE_MARKS = Path(os.environ["FAULT_FIXTURE_MARKS"])


def _fixture_mark(name):
    (FIXTURE_MARKS / name).write_text(str(os.getpid()))


def _fixture_raise(s, tier):
    _fixture_mark(tier + "-raises")
    s.changed_by_the_raising_unit = True
    try:
        raise KeyError("the " + tier + " cause, in the middle of the traceback")
    except KeyError as cause:
        raise LookupError("the " + tier + " unit's own message, at its end") from cause


def _fixture_passing(mark, cid):
    def run(s):
        _fixture_mark(mark)
        return [(cid, "", True, "")]
    return run


def _fixture_noisy(s):
    _fixture_mark("live-noisy")
    print("a live fixture talking between the verdicts, at a length that a first-line cut loses")
    print("and a second line that only a whole copy carries")
    return [("fixture-live-noisy", "", True, "")]


UNITS[:] = [
    ("_fixture_ro_first", (("fixture-ro-first", "a read-only unit before the raise"),),
     _fixture_passing("ro-first", "fixture-ro-first"), False),
    ("_fixture_ro_raises", (("fixture-ro-raises", "a read-only unit that raises"),),
     lambda s: _fixture_raise(s, "read-only"), False),
    ("_fixture_ro_after", (("fixture-ro-after", "a read-only unit after the raise"),),
     _fixture_passing("ro-after", "fixture-ro-after"), False),
    ("_fixture_live_noisy", (("fixture-live-noisy", "a live unit that prints"),),
     _fixture_noisy, True),
    ("_fixture_live_raises", (("fixture-live-raises", "a live unit that raises"),),
     lambda s: _fixture_raise(s, "live"), True),
    ("_fixture_live_other", (("fixture-live-other", "a live unit in the other share"),),
     _fixture_passing("live-other", "fixture-live-other"), True),
    ("_fixture_live_after", (("fixture-live-after", "a live unit after the raise"),),
     _fixture_passing("live-after", "fixture-live-after"), True),
]
'''


@unit(("traceback-reaches-the-operator-whole",
       "a raising unit's whole traceback reaches the operator from the read-only child, a "
       "serial live tier and a live share"),
      ("mid-run-output-reaches-the-operator-whole",
       "what a live tier printed between its verdicts reaches the operator whole, serial or split, "
       "and a raising unit's traceback is not counted with it"),
      ("raising-share-stops-alone",
       "a share stops at a unit that raised, while the other shares finish and report"),
      live=True, rooms=True)
def _check_runner_paths_on_a_fault_fixture(s):
    """The runner's own paths, end to end, on a copy of this tool with fixture units.

    The copy runs --selftest --live serially and split two ways, so every
    path a diagnostic travels is the real one: the read-only child that
    _live_context starts, the serial tier inside run_selftest's capture, and a
    share, with its stderr read by the merge. A traceback written into a row's
    detail, or a parser fed text by hand, would prove none of them. What is
    asked is what an operator gets: the run's stderr and its report, with the
    cause and the error of each raise in them whole, and the files the units
    marked as they ran.

    Its own session and a bound, so a copy that hangs is ended along with
    everything it started rather than holding the tier.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    guard = '\n\nif __name__ == "__main__":'
    text = Path(__file__).resolve().read_text()
    runs = {}
    # Without its fixture units the copy would run this tool's real live tier,
    # so it is not started at all unless the units have one place to go.
    room = (Path(tempfile.mkdtemp(prefix=own(f"{TOOL}-selftest-faultfixture")))
            if text.count(guard) == 1 else None)
    try:
        if room is None:
            raise FileNotFoundError("the main guard is not in this file exactly once")
        copied = room / TOOL
        copied.write_text(text.replace(guard, FAULT_FIXTURE_UNITS + guard, 1))
        copied.chmod(0o755)
        # The corpus preflight refuses without one beside the copy; the
        # fixture units read nothing from it.
        (room / "test" / "corpus").mkdir(parents=True)
        for jobs in (1, 2):
            marks = room / f"marks-jobs-{jobs}"
            marks.mkdir()
            run = start_copy_run(
                [sys.executable, str(copied), "--selftest", "--live", "--jobs", str(jobs)],
                dict(os.environ, FAULT_FIXTURE_MARKS=str(marks), NO_COLOR="1"))
            # Ended with what it started when this block is left; should this
            # run end first, the copy is still under it.
            with owned_group(run) as stop:
                finished = collected(run, 120, stop)
            out, err, code = finished.stdout, finished.stderr, finished.returncode
            timed_out = code is None
            runs[jobs] = types.SimpleNamespace(
                out=out, err=err, code=code, timed_out=timed_out,
                marked=sorted(path.name for path in marks.iterdir()))
    except FileNotFoundError:
        pass
    finally:
        if room is not None:
            shutil.rmtree(room, ignore_errors=True)

    # A run that crashed exits 1 as a failing one does, so what is asked is
    # whether its report is whole and its status the one its verdicts call for.
    serial, split = runs.get(1), runs.get(2)
    finished = {
        "the serial run reported whole, with the status its verdicts call for":
            serial is not None and not report_of(serial.out, serial.code, 120).problems,
        "the split run reported whole, with the status its verdicts call for":
            split is not None and not report_of(split.out, split.code, 120).problems,
    }
    serial = serial or types.SimpleNamespace(out="", err="", marked=[])
    split = split or types.SimpleNamespace(out="", err="", marked=[])

    def raised(tier):
        return (f"the {tier} cause, in the middle of the traceback",
                f"LookupError: the {tier} unit's own message, at its end")

    def carries(said, texts):
        return all(piece in said for piece in texts)

    tracebacks = {
        **finished,
        "the read-only child's traceback reaches a serial run's stderr whole":
            carries(serial.err, ("the read-only child wrote to stderr:", *raised("read-only"))),
        "the serial live tier's traceback reaches its stderr whole":
            carries(serial.err, raised("live")),
        "the read-only child's traceback reaches a split run's stderr whole":
            carries(split.err, ("the read-only child wrote to stderr:", *raised("read-only"))),
        "a share's traceback reaches the split run's report whole":
            carries(split.out, ("share 1/2 stderr:", *raised("live"))),
        "the ended rows keep the exception's type and message":
            carries(serial.out, ("_fixture_ro_raises ended the run with LookupError: the "
                                 "read-only unit's own message, at its end",
                                 "_fixture_live_raises ended the run with LookupError: the "
                                 "live unit's own message, at its end")),
    }
    wrong = sorted(claim for claim, ok in tracebacks.items() if not ok)
    check("traceback-reaches-the-operator-whole",
          "a raising unit's whole traceback reaches the operator from the read-only child, a "
          "serial live tier and a live share",
          not wrong, ", ".join(wrong) + (f"; serial stderr {serial.err[-300:]!r}, split report "
                                         f"{split.out[-300:]!r}" if wrong else ""))

    talk = ("at a length that a first-line cut loses",
            "and a second line that only a whole copy carries")
    noise = {
        **finished,
        "the serial tier's mid-run row fails and counts both lines":
            "live-checks-say-nothing-mid-run" in serial.out and "2 line(s)" in serial.out,
        "what it printed reaches the serial run's stderr whole":
            carries(serial.err, ("the live tier wrote between its verdicts:", *talk)),
        "what a share printed reaches the split run's report whole":
            carries(split.out, ("share 0/2 stderr:", *talk)),
    }
    wrong = sorted(claim for claim, ok in noise.items() if not ok)
    check("mid-run-output-reaches-the-operator-whole",
          "what a live tier printed between its verdicts reaches the operator whole, serial or "
          "split, and a raising unit's traceback is not counted with it",
          not wrong, ", ".join(wrong))

    alone = {
        **finished,
        "in one context nothing after the raise ran":
            serial.marked == ["live-noisy", "live-raises", "read-only-raises", "ro-first"],
        "split two ways, the other share ran everything it was given":
            split.marked == ["live-noisy", "live-other", "live-raises", "read-only-raises",
                             "ro-first"],
        "and reported it": carries(split.out, ("PASS  fixture-live-noisy",
                                               "PASS  fixture-live-other")),
        "the unit after the raise in its share has no verdict": "fixture-live-after  " not in
            "\n".join(line.strip()[6:] for line in split.out.splitlines()
                      if line.strip().startswith(("PASS  ", "FAIL  "))),
        "the folded ended row names the share and the ids it left without a verdict":
            "share 1/2: _fixture_live_raises ended the run with LookupError" in split.out
            and ("its own 1 id(s) have no verdict: fixture-live-raises; 1 id(s) after it did "
                 "not run: fixture-live-after") in split.out,
    }
    wrong = sorted(claim for claim, ok in alone.items() if not ok)
    check("raising-share-stops-alone",
          "a share stops at a unit that raised, while the other shares finish and report",
          not wrong, ", ".join(wrong) + (f"; marked {serial.marked} and {split.marked}"
                                         if wrong else ""))
    return checked


@unit(('raw-keypress-terminal', 'a raw keypress is read from a real terminal'), live=True)
def _check_raw_keypress_terminal(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    pty = s.pty
    sp = s.sp

    keys = {}
    for label, byte in (("Ctrl-C", b"\x03"), ("Ctrl-X", b"\x18"), ("a plain key", b"a")):
        master, slave = pty.openpty()
        probe = sp.Popen([sys.executable, "-c",
                          "import sys,termios,tty,os\n"
                          "fd=sys.stdin.fileno(); saved=termios.tcgetattr(fd)\n"
                          "tty.setraw(fd)\n"
                          "sys.stderr.write(str(os.read(fd,1)[0]))\n"
                          "termios.tcsetattr(fd, termios.TCSADRAIN, saved)"],
                         stdin=slave, stdout=sp.DEVNULL, stderr=sp.PIPE)
        os.close(slave)
        time.sleep(0.4)          # tty.setraw flushes, so write only once it is raw
        os.write(master, byte)
        try:
            got = probe.communicate(timeout=10)[1].decode().strip()
        except sp.TimeoutExpired:
            probe.kill()
            got = "hung"
        os.close(master)
        keys[label] = got == str(byte[0])
    wrong = sorted(k for k, good in keys.items() if not good)
    check("raw-keypress-terminal", "a raw keypress is read from a real terminal", not wrong, ", ".join(wrong))
    return checked


