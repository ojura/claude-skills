                             "delivered, queued, pending, or unexplained")
    parser.add_argument("--cleanup", "--cleanup-sockets", dest="cleanup", action="store_true",
                        help="clean up dead swarm tmux sockets and team dirs with nothing "
                             "left to resume; the installed Claude Code startup hook runs this")
    parser.add_argument("--complete", metavar="TOPIC", help=argparse.SUPPRESS)
    parser.add_argument("--poison", action="store_true",
                        help="point the swarm server's ANTHROPIC_BASE_URL at a dead port, "
                             "so placeholder spawns die at connect instead of reaching the API")
    parser.add_argument("--unpoison", action="store_true",
                        help="remove the dead-port override from the swarm server")
    parser.add_argument("--socket",
                        help="use this swarm tmux socket instead of detecting or creating one")
    parser.add_argument("--tmux-session", metavar="NAME",
                        help=f"use this tmux session name instead of the default {TMUX_SESSION}")
    parser.add_argument("--tmux-window", metavar="NAME",
                        help=f"use this tmux window name instead of the default {TMUX_WINDOW}")
    parser.add_argument("--claude-bin",
                        help="launch this claude binary instead of the one on PATH")
    parser.add_argument("--force", action="store_true",
                        help="override the running-copy and identity guards; with --to-team, "
                             "also take the rewrite route when the old team cannot be retired")
    parser.add_argument("--stop", "--terminate", action="store_true", dest="stop",
                        help="stop the agent, session or team instead of resuming it")
    parser.add_argument("--yes", "-y", action="store_true",
                        help="do not ask before stopping")
    parser.add_argument("--dry-run", action="store_true",
                        help="preview without launching")
    parser.add_argument("--explain", action="store_true",
                        help="say where each launch fact came from before launching")
    parser.add_argument("--no-update-config", action="store_true",
                        help="do not write resumed agents into the team roster")
    parser.add_argument("--attach", action="store_true",
                        help="attach to the swarm tmux session even when another client "
                             "is already attached")
    parser.add_argument("--no-attach", action="store_true",
                        help="never attach to the swarm tmux session; just report")
    parser.add_argument("-h", "--help", action="store_true")
    # Only a *leading* bare word is the selector; later bare words belong to
    # forwarded flags (argparse can't know that --model takes a value).
    argv = sys.argv[1:]
    args, passthrough = parser.parse_known_args(argv)
    # For every surface, not only completion: an abort listing under
    # --no-color must be as plain as the candidates are. The NO_COLOR
    # convention (any value set in the environment) asks the same thing.
    global NO_COLOR
    NO_COLOR = args.no_color or bool(os.environ.get("NO_COLOR"))
    check_passthrough(passthrough, parser)
    selector, passthrough = classify_passthrough(passthrough)
    check_identity_flags(args, passthrough)
    # The one place compute is declared: the engine is constructed knowing
    # what this verb may ask, and the end of the run refuses declarations a
    # smaller set would have satisfied.
    global RESOLVER
    RESOLVER = Resolver(needs=verb_needs(args, selector))
    if args.team and (args.agent_id or args.resume):
        die(f"--team names every member of {args.team}, and "
            f"{'--agent-id' if args.agent_id else '--resume'} names one agent; pick one")

    if args.selftest:
        return run_selftest(live=args.live, failed_only=args.failed, list_only=args.list)
    if args.live:
        die("--live extends --selftest; it does nothing on its own")

    if args.doctor:
        # Before the help gate, because a sweep needs no selector, and resolving
        # its own target because there is no args.team yet: a named team must not
        # be silently swept into the whole machine.
        return run_doctor(args, selector)

    if args.census:
        return run_census()

    if args.sides:
        # Like the doctor: before the help gate because a bare sweep needs no
        # selector, and resolving its own target because args.team is not set
        # yet; a named session must not be silently swept into the machine.
        return run_sides(selector)

    if args.promote and args.demote:
        die("--promote and --demote are opposite verbs; pick one")
    if args.promote:
        return run_promote(args)
    if args.demote:
        return run_demote(args)

    if args.mail_ledger:
        # Before the help gate, resolving its own target: the --sides pattern.
        return run_mail_ledger(selector)

    if args.cleanup:
        return run_cleanup(args.dry_run)

    if args.dry_run and (args.install or args.poison or args.unpoison):
        die("--dry-run does not cover --install/--poison/--unpoison; they mutate on purpose")

    if args.install:
        return run_install()

    if args.complete:
        return run_complete(args.complete)

    if args.poison and args.unpoison:
        die("--poison and --unpoison are mutually exclusive")
    if args.poison or args.unpoison:
        if selector or args.agent_id or args.resume or args.team:
            die("--poison/--unpoison stand alone; they act on the server, not an agent")
        return run_poison(args)

    if args.help or not (selector or args.agent_id or args.resume or args.team):
        parser.print_help()
        print(__doc__)
        return 0 if args.help else 2

    if args.tmux_session or args.tmux_window:
        # One constant, set once: everything downstream reads these.
        set_tmux_target(args.tmux_session, args.tmux_window)

    check_substrate()
    table = RESOLVER.ps_table()
    if selector:
        apply_selector(selector, args, table)

    if args.standing:
        # After the selector, so a bare name@team resolves the way it does for
        # every other mode rather than through a second reading of argv.
        return run_standing(args)

    if args.stop:
        # After apply_selector, so a selector in either position has already
        # become args.agent_id, args.resume or args.team. Deriving it here a
        # second time is what made every selector shape fail.
        named = sorted(set(forwarded_flags(passthrough)))
        if named:
            die(f"{', '.join(named)} {'configures' if len(named) == 1 else 'configure'} "
                f"a process being started, and --stop starts nothing")
        return 0 if abort_agents(stop_targets(args, table), assume_yes=args.yes) else 1

    if args.team:
        return run_team(args, passthrough, table)

    return run_agents(args, passthrough, table, [(None, args)])


def interruptible(entry):
    """Run `entry`, and answer Ctrl-C with a sentence instead of a traceback.

    An interrupt lands wherever the run happens to be, most often the wait
    that watches a launched agent for its first transcript write. A stack
    dump there reads as a crash, and the run is anything but: whatever was
    launched is still running, and saying so is the whole message.
    """
    try:
        return entry()
    except KeyboardInterrupt:
        print()
        warn("interrupted; anything already launched is still running "
             "(--doctor <team> shows what)")
        return 130


if __name__ == "__main__":
    sys.exit(interruptible(lambda: audited(main)))
