        command = build_command(ctx, emit, [])
        flags = dict(zip(command, command[1:]))
        with capturing("err"):
            record = eng.roster_record(ctx)
        with capturing("out") as explained:
            explain(ctx)
        told = explained.getvalue()
        effective = ctx["target"]["identity"]

        persisted, inboxes = [], []
        real_register, real_inbox = globals()["register_member"], globals()["ensure_inbox"]
        globals()["register_member"] = lambda item, pane, dry, alive=True: persisted.append(item)
        globals()["ensure_inbox"] = lambda team, name, dry: inboxes.append((team, name))
        try:
            with capturing("out"), capturing("err"):
                record_membership(ctx, emit, "%9")
        finally:
            globals()["register_member"], globals()["ensure_inbox"] = real_register, real_inbox

        matches = {
