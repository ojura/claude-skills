# Window read from each end of a transcript when indexing stamps.
INDEX_CHUNK = 8 * 1024
STAMP_RE = re.compile(rb'"(agentName|teamName)":"([^"]*)"')
LABEL_LINE = b'"type":"agent-name"'


def _stamps_in(chunk):
    """{field: value} from a window, ignoring the harness's display-label lines.

    A `type: "agent-name"` record holds a label, not an identity, and the label is
    whatever the session was called: a task sentence, "resume agent dev old". Read
    as a stamp it overrides hundreds of real ones, because the index takes the last
    match in the window and a label often sits at the end.
    """
    stamps = {}
    for line in chunk.split(b"\n"):
        if LABEL_LINE in line.replace(b'"type": "agent-name"', LABEL_LINE):
            continue
        stamps.update(STAMP_RE.findall(line))
    return stamps


