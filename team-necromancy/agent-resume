def base_url_is_poison(value):
    """Whether ANTHROPIC_BASE_URL matches Recipe 1's connection-failure port.

    Launch cleanup removes this exact value and preserves user-configured API
    endpoints. That keeps the resumed agent on the endpoint used by its lead.
