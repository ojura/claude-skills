        "placed", "team_entry", "source_team_entry", "to_team", "to_lead",
        "auto_redirect", "lead_moving", "member_moving", "stale_team_warned",
    }
    parallel = sorted(removed & set(ctx))
    consumers = {"already_running", "build_command", "enforce_restore",
                 "note_identity", "record_membership", "report_launch", "run_one"}
    stale_reads = []
    for name in sorted(consumers):
        node = s.funcs[name]
        for part in s.ast.walk(node):
            if not (isinstance(part, s.ast.Subscript)
                    and isinstance(part.value, s.ast.Name)
                    and part.value.id == "ctx"
                    and isinstance(part.slice, s.ast.Constant)):
                continue
            if part.slice.value in removed:
                stale_reads.append(f"{name}:{part.slice.value}")
        called = {
            part.func.attr for part in s.ast.walk(node)
            if isinstance(part, s.ast.Call)
            and isinstance(part.func, s.ast.Attribute)
            and isinstance(part.func.value, s.ast.Name)
            and part.func.value.id == "RESOLVER"
        }
        fresh = called & {"process_table", "runtime", "agent_runtime"}
        stale_reads.extend(f"{name}:{call}" for call in sorted(fresh))
    command_calls = {
        part.func.attr for part in s.ast.walk(s.funcs["build_command"])
        if isinstance(part, s.ast.Call)
        and isinstance(part.func, s.ast.Attribute)
        and isinstance(part.func.value, s.ast.Name)
        and part.func.value.id == "RESOLVER"
    }
    if "transcript_path" in command_calls:
        stale_reads.append("build_command reconstructs the conversation")
    check("resume-target-has-no-parallel-projections",
          "launch consumers cannot combine fields from removed context projections",
          not parallel and not stale_reads,
          ", ".join(parallel + stale_reads))

    duplicate_fixtures = []
    for name in s.suite_fns:
        node = s.funcs.get(name)
        if not node:
            continue
        for part in s.ast.walk(node):
            if not isinstance(part, s.ast.Dict):
                continue
            for key, value in zip(part.keys, part.values):
                if not (isinstance(key, s.ast.Constant) and key.value == "target"):
                    continue
                if not (isinstance(value, s.ast.Call)
                        and isinstance(value.func, s.ast.Name)
                        and value.func.id == "fixture_target"):
                    duplicate_fixtures.append(name)
    check("resume-target-fixture-one-constructor",
          "synthetic tests construct resume targets in one fixture",
          not duplicate_fixtures, ", ".join(sorted(set(duplicate_fixtures))))
    return checked


