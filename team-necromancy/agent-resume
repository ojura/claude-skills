@unit(('lock-verdict-one-place', 'whether a roster lock may be taken away is decided in one place'))
def _check_lock_verdict_one_place(s):
    """Three places act on this lockfile and they must never disagree.

    A roster write takes the lock over when the run that left it is gone, the
    startup sweep clears the same leftover when nothing ever wants that team's
    lock again, and the sweep's keep-check asks whether anything is inside the
    lock before removing the directory it sits in. A private second answer in
    any of them is how the sweep ends up removing a lock a live run is inside,
    so the question is the engine's and the removal is one actor both removers
    call. lock_objection asks the question and never reaches that actor, because
    it removes nothing.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    tree = s.tree
    funcs = s.funcs
    callers_of = s.callers_of

    forked = []
    # The engine's methods live in a class, so top-level functions are exactly
    # what is outside it. SCAFFOLDING sits at module level and is not one.
    spelled = sorted(f"{node.name} at line {sub.lineno}"
                     for node in tree.body if isinstance(node, ast.FunctionDef)
                     and node.name not in s.suite_fns
                     for sub in ast.walk(node)
                     if isinstance(sub, ast.Constant) and sub.value == "config.json.lock")
    if spelled:
        forked.append("the lockfile is named outside the engine at " + ", ".join(spelled))
    for question, want in (("_lock_holder", {"_lock_objection", "cleanup_plan",
                                               "revalidate_membership"}),
                           ("_lock_objection", {"_scaffolding_objection"}),
                           ("drop_lock", {"team_lock", "sweep_dead_lock"})):
        asked = callers_of(question) - s.suite_fns
        if asked != want:
            forked.append(f"{question} is reached from {sorted(asked)}, not from "
                          f"{sorted(want)}")
    for named, node in (
            ("team_lock", funcs.get("team_lock")),
            ("sweep_dead_lock", funcs.get("sweep_dead_lock")),
            ("drop_lock", funcs.get("drop_lock")),
            ("_lock_holder", s.resolver_methods.get("_lock_holder")),
            ("_lock_objection", s.resolver_methods.get("_lock_objection"))):
        if node is None:
            forked.append(f"{named} is gone, so the set this holds together is not there")
        elif "pid_alive" in {getattr(sub.func, "attr", None) for sub in ast.walk(node)
                             if isinstance(sub, ast.Call)} and named != "_lock_holder":
            forked.append(f"{named} tests the owner's liveness itself")
    check("lock-verdict-one-place",
          "whether a roster lock may be taken away is decided in one place",
          not forked, "; ".join(forked))
    return checked


@unit(('team-dir-read-engine-only', 'a team directory is read only inside the engine'))
def _check_team_dir_read_engine_only(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    tree = s.tree

    team_reads = {"exists", "is_file", "is_dir", "is_symlink", "stat", "open",
                  "read_text", "read_bytes", "iterdir", "glob", "rglob"}

    def in_a_team_dir(node, tainted):
        """Does this expression name something inside a team directory?"""
        if isinstance(node, ast.Name):
            return node.id in tainted or node.id == "TEAMS_DIR"
        if isinstance(node, ast.Call):
            return (isinstance(node.func, ast.Attribute)
                    and node.func.attr in {"team_dir", "roster_path", "roster_in",
                                           "inbox_path", "inboxes_in"})
        if isinstance(node, ast.Attribute):
            return node.attr == "teams_dir" or in_a_team_dir(node.value, tainted)
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
            if (isinstance(node.left, ast.Name) and node.left.id == "CLAUDE_DIR"
                    and isinstance(node.right, ast.Constant) and node.right.value == "teams"):
                return True
            return in_a_team_dir(node.left, tainted)
        if isinstance(node, ast.Subscript):
            return in_a_team_dir(node.value, tainted)
        return False

    def team_dir_reads(node):
        """The reads this function performs on a team directory, by line."""
        tainted, grew = set(), True
        while grew:   # a name can be bound from another name bound earlier
            grew = False
            for sub in ast.walk(node):
                if not isinstance(sub, ast.Assign) or not in_a_team_dir(sub.value, tainted):
                    continue
                for target in sub.targets:
                    if isinstance(target, ast.Name) and target.id not in tainted:
                        tainted.add(target.id)
                        grew = True
        return sorted({
            f"{node.name} reads a team dir at line {sub.lineno}"
            for sub in ast.walk(node)
            if isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
            and sub.func.attr in team_reads and in_a_team_dir(sub.func.value, tainted)})

    team_peekers = sorted(
        hit
        for node in tree.body if isinstance(node, ast.FunctionDef)
        # The reap and the demote read through the engine's receipt_contents,
        # which hands back the bytes and the stat facts they were read under. run_selftest stages team dirs as
        # fixtures and holds this check's own text.
        and node.name not in s.suite_fns
