def main():
    # A tool run a selftest unit started reads processes by that unit's rule
    # from its first read on, so its fence goes in before anything else.
    adopt_inherited_fence()
    parser = build_parser()
    # Only a *leading* bare word is the selector; later bare words belong to
    # forwarded flags (argparse can't know that --model takes a value).
    argv = sys.argv[1:]
    args, passthrough = parser.parse_known_args(argv)
    # For every surface, not only completion: an abort listing under
    # --no-color must be as plain as the candidates are. The NO_COLOR
    # convention (any value set in the environment) asks the same thing.
    global NO_COLOR
    NO_COLOR = args.no_color or bool(os.environ.get("NO_COLOR"))
    check_passthrough(passthrough, parser)
    selector, passthrough = classify_passthrough(passthrough)
    check_identity_flags(args, passthrough)
    # Answered first, and beside anything else typed: a person reaching for
    # --help while composing a command wants the flags, not a refusal to
    # choose between it and the verb they were half way through writing.
    if args.help:
        say_help(parser)
        return 0
    # Before anything is resolved or run: which verb this is decides everything
    # below, and the ladder cannot ask the question once it has started down it.
    check_one_verb(args, argv)
    if args.unwrap and not args.promote:
        die("--unwrap modifies --promote; pass both flags")
    # The one place compute is declared: the engine is constructed knowing
    # what this verb may ask, and the end of the run refuses declarations a
    # smaller set would have satisfied.
    global RESOLVER
    RESOLVER = Resolver(needs=verb_needs(args, selector))
    check_selection_conflicts(args)

    if args.selftest:
        share = None
        if args.share:
            which, _, out_of = args.share.partition("/")
            share = (int(which), int(out_of))
        return run_selftest(live=args.live, failed_only=args.failed, list_only=args.list,
                            jobs=args.jobs, share=share,
                            child=handed_down(args.inherit) if args.inherit else None)
    if args.live:
        die("--live extends --selftest; it does nothing on its own")

    if args.doctor:
        # Before empty-hand help handling because a sweep needs no selector.
        # A named run uses the main selector interpreter before the doctor reads
        # the resolved agent, session, or team fields.
        if selector:
            apply_selector(selector, args)
        check_selection_conflicts(args)
        return run_doctor(args)

    if args.census:
        return run_census()

    if args.sides:
        # Like the doctor: before the help gate because a bare sweep needs no
        # selector, and resolving its own target because args.team is not set
        # yet; a named session must not be silently swept into the machine.
        return run_sides(selector)

    if args.promote:
        return run_promote(args)
    if args.demote:
        return run_demote(args)

    if args.mail_ledger:
        # Before the help gate, resolving its own target: the --sides pattern.
        return run_mail_ledger(selector)

    if args.cleanup:
        return run_cleanup(args.dry_run)

    if args.install:
        return run_install(args.dry_run)

    if args.complete:
        return run_complete(args.complete)

    if args.poison or args.unpoison:
        if selector or args.agent_id or args.resume or args.team:
            die("--poison/--unpoison stand alone; they act on the server, not an agent")
        return run_poison(args)

    if not (selector or args.agent_id or args.resume or args.team):
        say_help(parser)
        return 2

    if args.tmux_session or args.tmux_window:
        # One constant, set once: everything downstream reads these.
        set_tmux_target(args.tmux_session, args.tmux_window)

    check_teammate_mode()
    if selector:
        apply_selector(selector, args)
    check_selection_conflicts(args)

    if args.stop:
        # After apply_selector, so a selector in either position has already
        # become args.agent_id, args.resume or args.team. Deriving it here a
        # second time is what made every selector shape fail.
        named = sorted(set(forwarded_flags(passthrough)))
        if named:
            die(f"{', '.join(named)} {'configures' if len(named) == 1 else 'configure'} "
                f"a process being started, and --stop starts nothing")
        stopped = abort_agents(stop_targets(args), assume_yes=args.yes,
                               dry=args.dry_run)
        # A preview did the whole of what it was asked for, so it exits 0. Only
        # a real stop that ended nothing exits 1, which is what it did before.
        return 0 if stopped or args.dry_run else 1

    if args.team:
        return run_team(args, passthrough)

    return run_agents(args, passthrough, None, [(None, args)])


def answered(entry):
    """Run `entry`, and answer what ended it with a code instead of a traceback.

    Two things end a run without a return. An interrupt lands wherever the run
    happens to be, most often the wait that watches a launched agent for its
    first transcript write. A stack dump there reads as a crash, and the run is
    anything but: whatever was launched is still running, and saying so is the
    whole message.

    A refusal is the other, and this is the only place one is turned into an
    exit code. It sits outside audited() on purpose: the refusal passes through
    that on its way here, so the needs audit never runs on a verb that stopped
    part way and never refuses a declaration the run had no chance to exercise.
    Nothing is printed for it here, because die() already said it where it
    happened.
    """
    try:
        return entry()
    except KeyboardInterrupt:
        print()
        warn("interrupted; anything already launched is still running "
             "(--doctor <team> shows what)")
        return 130
    except Refusal as refused:
        return refused.code


if __name__ == "__main__":
    sys.exit(answered(lambda: audited(main)))
