                             "(moves it; the receipt holds the way back)")
    parser.add_argument("--demote", metavar="SESSION",
                        help="convert a teammate transcript back into a side "
                             "transcript under its parent's subagents/")
    parser.add_argument("--as", dest="as_", metavar="NAME@TEAM",
                        help="the identity a promoted teammate joins as; the team "
                             "half must be typed")
    parser.add_argument("--into", metavar="SESSION",
                        help="the parent session a demoted transcript embeds under")
    parser.add_argument("--no-launch", action="store_true",
