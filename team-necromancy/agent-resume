@unit(
    ('compute-declared-and-audited',
     'compute is declared at construction and audited at the end'),
    ('action-evidence-declares-conversion-census',
     'stamp and spawn evidence declare copied-action ownership at the same strength'),
)
def _check_compute_declared_and_audited(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    engine_node = s.engine_node
    main_src = s.main_src
    src_of = s.src_of
    tempfile = s.tempfile
    tree = s.tree

    with tempfile.TemporaryDirectory() as td:
        mute = Resolver()
        mute.projects_dir = Path(td)
        refused = ""
        try:
            mute.stamp_index()
        except RuntimeError as err:
            refused = str(err)
        allowed = Resolver(needs=Needs(hard={NEED.STAMPS, NEED.CONVERSION_CENSUS}))
        allowed.projects_dir = Path(td)
        answered = allowed.stamp_index() == {}
        try:
            allowed.audit_needs()
            lean_ok = True
        except RuntimeError:
            lean_ok = False
        fat = Resolver(needs=Needs(hard={NEED.STAMPS, NEED.CONVERSION_CENSUS,
                                         NEED.PROCS}))
        fat.projects_dir = Path(td)
        fat.stamp_index()
        fat_refused = ""
        try:
            fat.audit_needs()
        except RuntimeError as err:
            fat_refused = str(err)
        excused = Resolver(needs=Needs(
            hard={NEED.STAMPS, NEED.CONVERSION_CENSUS}, maybe={NEED.PROCS}))
        excused.projects_dir = Path(td)
        excused.stamp_index()
        try:
            excused.audit_needs()
            maybe_ok = True
        except RuntimeError:
            maybe_ok = False
        demote_args = types.SimpleNamespace(
            selftest=False, complete=False, cleanup=False, doctor=False,
            census=False, sides=False, promote=None, demote="session")
        demote_declared = verb_needs(demote_args, None)
        demote_run = Resolver(needs=demote_declared)
        demote_run._exercise(NEED.PROCS)
        try:
            demote_run.audit_needs()
            demote_lean = True
        except RuntimeError:
            demote_lean = False
    side_refused = ""
    try:
        Resolver()._stamped_candidates("nobody")
    except RuntimeError as err:
        side_refused = str(err)
    contract = {
        "an undeclared compute refuses by name":
            "transcript identity stamps" in refused and "NEED.STAMPS" in refused,
        "a side path refuses like the front door":
            "transcript identity stamps" in side_refused,
        "a declared one answers, and a lean run audits clean": answered and lean_ok,
        "a fat declaration is refused at the end":
            fat_refused.startswith("declared and never computed: PROCS;"),
        # The refusal is read by whoever edits the verb next. It names what the
        # run did compute, because the difference between that and the
        # declaration is the evidence they start from, and it sends them to the
        # verb's paths rather than offering the conditional bucket as one of two
        # ready answers - which is how a declaration stops describing the code.
        "and says what this run did compute":
            "CONVERSION_CENSUS" in fat_refused and "STAMPS" in fat_refused,
        "and sets a task rather than offering a bucket":
            "Read this verb's paths" in fat_refused and "maybe bucket" not in fat_refused,
        "a conditional declaration is excused unexercised": maybe_ok,
        "a receipt-driven demote declares stamps conditional":
            demote_declared[NEED.STAMPS] is DECLARED.MAYBE,
        "and audits after computing only its fixed process-table need": demote_lean,
        "the verbs declare before anything computes":
            "RESOLVER = Resolver(needs=verb_needs(args, selector))" in main_src
            and main_src.index("Resolver(needs=verb_needs")
                < main_src.index("RESOLVER.process_table()"),
    }
    # One reader. A declaration's buckets are the engine's business; anything
    # else asks needs[X] and gets one of three answers. Two readers of one
    # shape is the fault this file has already had with holder questions and
    # identity rungs, so it is refused rather than remembered.
    readers = set()
    for fn in ast.walk(tree):
        if not isinstance(fn, ast.FunctionDef) or fn.name in s.suite_fns:
            continue
        body = src_of(fn) or ""
        if ".hard" in body or ".reachable" in body:
            readers.add(fn.name)
    engine_methods = {m.name for m in engine_node.body
                      if isinstance(m, ast.FunctionDef)} | {"hard", "reachable"}
    stray_readers = sorted(readers - engine_methods)
    contract["only the engine reads a declaration's buckets"] = not stray_readers

    wrong = sorted(k for k, ok in contract.items() if not ok)
    check("compute-declared-and-audited", "compute is declared at construction and audited at the end",
          not wrong, ", ".join(wrong))

    base = dict(complete=None, selftest=False, cleanup=False, doctor=False,
                census=False, sides=False, promote=None, demote=None,
                mail_ledger=False, install=False, poison=False, unpoison=False,
                agent_id=None, resume=None, team=None, stop=False)
    declarations = []
    for field in ("doctor", "census", "mail_ledger"):
        declarations.append((field, verb_needs(
            types.SimpleNamespace(**{**base, field: True}), None)))
    declarations.append(("doctor-agent", verb_needs(
        types.SimpleNamespace(**{**base, "doctor": True}), "name@team")))
    declarations.extend((
        ("promote", verb_needs(
            types.SimpleNamespace(**{**base, "promote": "side"}), None)),
        ("demote", verb_needs(
            types.SimpleNamespace(**{**base, "demote": "main"}), None)),
        ("stop", verb_needs(
            types.SimpleNamespace(**{**base, "stop": True, "agent_id": "a@t"}), None)),
        ("agent-id", verb_needs(
            types.SimpleNamespace(**{**base, "agent_id": "a@t"}), None)),
        ("uuid", verb_needs(
            types.SimpleNamespace(**{**base, "resume": "u"}), None)),
        ("selector", verb_needs(types.SimpleNamespace(**base), "name")),
    ))
    mismatched = []
    for label, needs in declarations:
        strongest = (DECLARED.HARD if any(
            needs[need] is DECLARED.HARD for need in (NEED.STAMPS, NEED.SPAWNS))
            else DECLARED.MAYBE if any(
                needs[need] is DECLARED.MAYBE for need in (NEED.STAMPS, NEED.SPAWNS))
            else DECLARED.ABSENT)
        if strongest is not DECLARED.ABSENT and needs[NEED.CONVERSION_CENSUS] is not strongest:
            mismatched.append(f"{label}:{strongest.name}->{needs[NEED.CONVERSION_CENSUS].name}")
    check("action-evidence-declares-conversion-census",
          "stamp and spawn evidence declare copied-action ownership at the same strength",
          not mismatched, ", ".join(mismatched))
    return checked


@unit(('refusal-ends-the-run', 'a refused run ends in its refusal, not in the audit'))
def _check_refusal_ends_the_run(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    class _RefusalJob:
        dry_run, no_attach, attach, agent_id, socket = True, False, False, None, None

        def __init__(self, label):
            self.label = label

    took_part, real_one_fn = [], globals()["run_one"]
    # Built out here rather than inside the stub: a noop outcome has one
    # construction site in this file and a check that says so, and a stub is
    # not a second one.
    went_quietly = Outcome("noop", None, False, None)

    def _one_or_refuse(a, p, t, prefix="", pending=()):
        took_part.append(a.label)
        if a.label.startswith("miss"):
            die(f"no transcript found for {a.label}")
        return went_quietly

    def batch(*labels):
        """(code, did it end in a refusal, who was run) for one run_agents."""
        took_part.clear()
        jobs = [(label, _RefusalJob(label)) for label in labels]
        with capturing("out"), capturing("err"):
            try:
                return run_agents(jobs[0][1], [], {}, jobs), False, list(took_part)
            except Refusal as exc:
                return exc.code, True, list(took_part)

    try:
        globals()["run_one"] = _one_or_refuse
        alone = batch("miss")
        whole = batch("found-1")
        partly = batch("miss", "found-2")
    finally:
        globals()["run_one"] = real_one_fn

    # And the seam the refusal has to pass through on its way out. A fat
    # declaration on a run that returned must still die here, as loudly as it
    # does today; a run that raised must reach the raise instead.
    real_engine = globals()["RESOLVER"]
    try:
        globals()["RESOLVER"] = Resolver(needs=Needs(hard={NEED.SPAWNS}))
        try:
            audited(lambda: 0)
            judged = "nothing was refused"
        except RuntimeError as err:
            judged = str(err)
        try:
            with capturing("err"):
                audited(lambda: die("nothing to resume"))
            refused_as = "returned a code"
        except Refusal as exc:
            refused_as = f"exit {exc.code}"
        except RuntimeError:
            refused_as = "the audit"
    finally:
        globals()["RESOLVER"] = real_engine

    ending = {
        "a lone job's refusal ends the run in that refusal": alone == (1, True, ["miss"]),
        "a batch that refused nothing still returns a code": whole == (0, False, ["found-1"]),
        "one member's refusal does not take the rest of the team down":
            partly[2] == ["miss", "found-2"],
        "and the run still ends in it": partly[0] == 1 and partly[1],
        "a verb that did its work is still audited": "SPAWNS" in judged,
        "a verb that refused ends in its refusal, not in the audit": refused_as == "exit 1",
    }
    wrong = sorted(k for k, ok in ending.items() if not ok)
    check("refusal-ends-the-run", "a refused run ends in its refusal, not in the audit",
          not wrong, ", ".join(wrong))
    return checked


@unit(('title-skips-the-harness', 'a title says what the work was, not what command wrapped it'),
      ('title-one-transcript-fact',
       'title parsing has one owner and every resolved title belongs to a transcript fact'))
def _check_title_skips_the_harness(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # A conversation opened with a slash command carries the caveat the harness
    # wraps around it, and the harness titles the file from that, so the title
    # named the tool rather than the work. Both paths to a title are driven
    # here: the title record, which is the one that usually wins, and the first
    # user message, which is what a file with no usable record falls back to.
    caveat = ("<local-command-caveat>Caveat: The messages below were generated "
              "by the user while running local commands.</local-command-caveat>")
    said = "Can you teleport a session into here?"

    def transcript(into, name, records):
        path = into / f"{name}.jsonl"
        path.write_text("\n".join(fixture_line(r)
                                  for r in records) + "\n")
        return path

    def titled(text):
        return {"type": "custom-title", "customTitle": text}

    def spoken(text):
        return {"type": "user", "message": {"role": "user", "content": text}}

    with tempfile.TemporaryDirectory() as td:
        into = Path(td) / "project"
        into.mkdir()
        # The specimen: the harness titled the file from its own caveat, and
        # the person's first sentence is further down.
        wrapped = transcript(into, "wrapped", [spoken(caveat), spoken(said),
                                               titled(caveat)])
        # A title a person typed still wins, or this check would pass just as
        # well against a version that threw every title away.
        chosen = transcript(into, "chosen", [spoken(caveat), titled("Rewrite the parser")])
        # Nothing but machinery: the honest answer is no title, not the caveat.
        only_machinery = transcript(into, "only", [spoken(caveat), titled(caveat)])

        eng = Resolver(needs=Needs(hard={NEED.TITLES}))
        eng.projects_dir = Path(td)

        def title(path):
            return (eng.transcript_fact(path=path) or {}).get("title")

        runtime = eng.runtime([
            (4242, 1, f"{FAKE_AGENT_BIN} --resume {chosen.stem} --agent-id title@fixture")])
        resolution = eng.resolve_transcript(session_uuid=chosen.stem)
        runtime_fact = runtime["by_pid"][4242]["transcript"]
        got = {
            "the caveat does not become the title": title(wrapped) == said,
            "a title a person typed still wins": title(chosen) == "Rewrite the parser",
            "machinery alone yields no title": title(only_machinery) is None,
        }
    wrong = sorted(k for k, ok in got.items() if not ok)
    check("title-skips-the-harness",
          "a title says what the work was, not what command wrapped it",
          not wrong, ", ".join(wrong))
    title_owners = s.callers_of("_session_title")
    fact_immutable = False
    try:
        runtime_fact["title"] = "changed"
    except TypeError:
        fact_immutable = True
    check("title-one-transcript-fact",
          "title parsing has one owner and every resolved title belongs to a transcript fact",
          title_owners == {"transcript_fact"}
          and "transcript_title" not in s.funcs and "session_title" not in s.funcs
          and bool(resolution) and runtime_fact is resolution.transcript
          and fact_immutable,
          ", ".join(sorted(title_owners)))
    return checked


