    parent = s.resolver_methods["_demotion_parent"]
    objection = s.resolver_methods["_demotion_parent_objection"]

    def method_calls(node, owner=None):
        found = []
        for call in ast.walk(node):
            if not isinstance(call, ast.Call) or not isinstance(call.func, ast.Attribute):
                continue
            if owner is None or (isinstance(call.func.value, ast.Name)
                                 and call.func.value.id == owner):
                found.append(call.func.attr)
        return found

    planner_calls = method_calls(planner, "self")
    parent_calls = method_calls(parent, "self")
    objection_calls = method_calls(objection, "self")
    run_calls = s.resolver_calls.get("demotion_plan", set())
    ownership = (
        planner_calls.count("_demotion_parent") == 1
        and parent_calls.count("_demotion_parent_objection") == 1
        and parent_calls.count("_team_description") == 1
        and {"_stamp_index", "_spawn_parent_of"} <= set(objection_calls)
        and run_calls == {"run_demote"}
        and not ({"demotion_parent", "_demotion_parent_objection"}
                 & s.resolver_public_methods)
    )
    check("demote-planner-consumes-parent-resolution",
          "run_demote asks one complete demotion answer, and its private parent selection feeds conversion",
          ownership,
          f"planner={planner_calls}, parent={parent_calls}, run={sorted(run_calls)}")
    return checked


