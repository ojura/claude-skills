     "a team run that retires its team rebuilds it in no member's step and leaves a "
     'member already running as the destination where it is, so every member it '
     'starts comes back as the destination'),
)
def _check_team_run_decides_once(s):
    checked = []

    def check(cid, ok, detail=""):
        checked.append(_check_verdict(cid, bool(ok), detail))

    start = int(time.time() * 1000) - 3_600_000

    def team_run(f, team, reply="y"):
        """Run the team verb as a dry run.

        Returns (code, output, prompts, plans, events): `events` lists, in the
        order they happened, the run's decision ("decide"), each question
        ("ask"), each retirement ("retire") and each member's launch step
        ("member").
        """
        eng, plans, prompts, events = f.engine, [], [], []
        real_plan, real_reap, real_step = eng.team_run_plan, rebind_reap, run_one

        def observed(*args, **kwargs):
            events.append("decide")
            plans.append(real_plan(*args, **kwargs))
            return plans[-1]

        def retiring(*args, **kwargs):
            events.append("retire")
            return real_reap(*args, **kwargs)

        def member_step(*args, **kwargs):
            events.append("member")
            return real_step(*args, **kwargs)

        eng.team_run_plan = observed
        real_stdin, real_input = sys.stdin, globals().get("input")
        sys.stdin = types.SimpleNamespace(isatty=lambda: True)
        globals()["input"] = lambda prompt="": (
            events.append("ask"), prompts.append(prompt), reply)[2]
        globals().update(rebind_reap=retiring, run_one=member_step)
        said, code = io.StringIO(), None
        try:
            with capturing("out", into=said), capturing("err", into=said):
                code = run_team(build_parser().parse_args([
                    "--team", team, "--no-lead", "--all", "--dry-run", "--no-attach"]), [])
        except Refusal as exc:
            code = f"refused: {exc}"
        finally:
            sys.stdin = real_stdin
            globals().update(rebind_reap=real_reap, run_one=real_step)
            if real_input is not None:
                globals()["input"] = real_input
            else:
                globals().pop("input", None)
        return (code, " ".join(without_wrap_arrows(said.getvalue()).split()), prompts,
                plans, events)

    def decided_first(events):
        """The decision, its question and any retirement came before any member."""
        first = events.index("member") if "member" in events else len(events)
        return ("decide" in events[:first]
                and all(kind == "member" for kind in events[first:]))

    # The lead started within TEAM_MINT_WINDOW_MS after session-1ead2222 was
    # created, the fresh team its conversation named at boot, so where the crew
    # goes is inferred and asked.
    lead_conv, dest, source = ("1ead2222-0000-4000-8000-000000000002",
                               "session-1ead2222", "CREWTEAM")
