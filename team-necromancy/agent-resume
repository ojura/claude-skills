        def counted_snapshot(path, include_mail=False):
            snapshot_reads.append(Path(path))
            return real_snapshot_read(path, include_mail)

        shared._stable_transcript_snapshot = counted_snapshot
        shared_rows = shared._mail_ledger("TML")
        reads_after_mail = len(snapshot_reads)
        team_paths = [path for path, (name, stamped) in shared._stamp_index().items()
                      if stamped == "TML" and name]
        for path in team_paths:
            shared._window_start(path)
        mail_src = s.src_of(s.resolver_methods["_mail_ledger"]) or ""
        window_src = s.src_of(s.resolver_methods["_window_start"]) or ""
        shared_once = (shared_rows == full_rows
                       and reads_after_mail == len(team_paths)
                       and len(snapshot_reads) == reads_after_mail
                       and mail_src.count("self._transcript_snapshot(") == 1
                       and window_src.count("self._transcript_snapshot(") == 1
                       and ".open(" not in window_src)
        check("mail-and-window-share-transcript-snapshot",
              "mail and restored-window reads share one full parse per unchanged transcript",
              shared_once,
              f"paths={len(team_paths)}, mail reads={reads_after_mail}, "
              f"final reads={len(snapshot_reads)}")

        # A declared recipient gets the same rows the full join would give it,
        # and buys less: a sender's chatter is not parsed on its behalf. Each
        # measurement uses a cold resolver, so snapshot reuse cannot make the
        # second call appear cheaper merely because the first already read it.
        real_loads = json.loads

        def measured(recipient):
            measured_engine = new_engine()
            parses = []

            def counting_loads(raw, *a, **kw):
                parses.append(1)
                return real_loads(raw, *a, **kw)

            json.loads = counting_loads
            try:
                rows = measured_engine._mail_ledger("TML", to=recipient)
            finally:
                json.loads = real_loads
            return rows, len(parses)

        narrowed, to_bob = measured("bob")
        everything_rows, to_all = measured(None)
        nobody, _to_alice = measured("alice")
        declared = {
            "same rows, same states": narrowed == reference_narrow ==
                tuple(r for r in everything_rows if r["to"] == "bob"),
            "nobody addressed means no rows": nobody == (),
            "a sender's chatter is not parsed": to_bob < to_all,
        }
        wrong = sorted(k for k, ok in declared.items() if not ok)
        check("ledger-recipient-narrows-only", "a declared recipient narrows the ledger without changing it",
              not wrong, ", ".join(wrong) or f"{to_bob} parses vs {to_all}")
        # A torn inbox answers as itself; six real messages in a half-written
        # file must not read as no mail waiting.
        (boxdir / "carol.json").write_text('[{"text": "hal')
        got = eng5._inbox_state("TML").get("carol")
        check("torn-inbox-reported", "a torn inbox is reported, not skipped",
              bool(got) and got[0] is None and "torn" in got[1],
              str(got))
    return checked


@unit(('ledger-detail-once-per-addressee', 'the ledger says a repeated explanation once per addressee'), ('ledger-rows-read-as-a-table', "the ledger's rows are headed and cut at a word"))
def _check_ledger_detail_once_per_addressee(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    with tempfile.TemporaryDirectory() as td:
        proj = Path(td) / "proj"
        proj.mkdir(parents=True)

        fx_team = "session-ledgerfx"
        wordy = ("a summary long enough to run off the end of the column the "
                 "ledger leaves for it")

        def fx_send(to, summary, n):
            return fixture_line({"type": "assistant", "agentName": "alice",
                            "teamName": fx_team, "uuid": f"fx-{n}",
                            "timestamp": f"2026-01-01T00:00:{n:02d}Z",
                            "parentUuid": None, "message": {"content": [
                                {"type": "tool_use", "name": "SendMessage",
                                 "input": {"to": to, "summary": summary,
                                           "message": f"body-{n}"}}]}})
        (proj / "alice.jsonl").write_text("\n".join([
            fx_send("nowhere", wordy, 1),
            fx_send("nowhere", wordy, 2),
            fx_send("nowhere", "a third send to the same name", 3),
            fx_send("elsewhere", "one send to a different unknown name", 4),
        ]) + "\n")
        eng6 = Resolver(needs=Needs(maybe=set(NEED)))
        eng6._projects_dir, eng6._teams_dir = Path(td), Path(td) / "teams"
        fx_rows = eng6._mail_ledger(fx_team)
        # The design width, pinned: the summary column is what the terminal
        # leaves, so a suite run in some other terminal would measure a
        # different table. Restored the way the launch report's check does.
        real_resolver, real_columns = globals()["RESOLVER"], os.environ.get("COLUMNS")
        globals()["RESOLVER"], os.environ["COLUMNS"] = eng6, "100"
        try:
            with capturing("out") as ledger_out:
                run_mail_ledger(fx_team)
        finally:
            globals()["RESOLVER"] = real_resolver
            if real_columns is None:
                os.environ.pop("COLUMNS", None)
            else:
                os.environ["COLUMNS"] = real_columns
        told = ledger_out.getvalue()
        said = " ".join(told.split())
        sent_lines = [each for each in told.splitlines() if each.startswith("2026-")]
        repeated = [r for r in fx_rows if r["to"] == "nowhere"]
        alone = next((r for r in fx_rows if r["to"] == "elsewhere"), None)
        # Defaulted rather than indexed, so a fixture that stops producing
        # these rows fails this check instead of dying inside it.
        repeat_said = " ".join((repeated[0]["detail"] if repeated else "").split())
        alone_said = " ".join((alone["detail"] if alone else "").split())
        grouped = {
            # Without this the rule passes over a fixture that repeats
            # nothing, which is the one case it is not about.
            "the fixture repeats one addressee's explanation":
                len(repeated) > 1 and len({r["detail"] for r in repeated}) == 1,
            "a repeated explanation is said once":
                bool(repeat_said) and said.count(repeat_said) == 1,
            "a second addressee still gets its own":
                bool(alone_said) and said.count(alone_said) == 1,
            # The grouping is the renderer's; the states are per-send facts and
            # every send keeps its own row saying one.
            "every send still shows its state":
                len(sent_lines) == len(fx_rows)
                and all("unknown recipient" in each for each in sent_lines),
        }
        wrong = sorted(k for k, ok in grouped.items() if not ok)
        check("ledger-detail-once-per-addressee",
              "the ledger says a repeated explanation once per addressee",
              not wrong, ", ".join(wrong))

        cut = clip(wordy, 30)
        table = {
            "the rows carry a header": told.splitlines()[0].split() ==
                ["sent", "from", "->", "to", "state", "summary"],
            "an overlong summary is cut with ...":
                cut.endswith("...") and len(cut) <= 30,
            "and cut at a word, not inside one": wordy.startswith(cut[:-3])
                and wordy[len(cut) - 3:len(cut) - 2] in (" ", ""),
            "a summary that fits is left alone": clip("a short one", 30) == "a short one",
            "the printed rows are cut the same way":
                any(each.rstrip().endswith("...") for each in sent_lines),
            # The summary's column is whatever the fixed columns leave, so a
            # miscounted layout shows up as rows past the width. Names are not
            # cut, so this holds for names that fit their column, as these do.
            "the rows fit the design width":
                all(len(each) <= 100 for each in told.splitlines()),
        }
        wrong = sorted(k for k, ok in table.items() if not ok)
        check("ledger-rows-read-as-a-table",
              "the ledger's rows are headed and cut at a word", not wrong,
              ", ".join(wrong))
    return checked


