@dataclasses.dataclass(frozen=True)
class MemberRedirectRequest:
    """One legal member redirect request, before confirmation policy.

    `team` is the redirect decision a team run made once, before its first
    member (Resolver team_redirect), and `team_answer` what the run's one
    question about it settled: follow the decision, stay on the source team,
    or declined, which starts members on the source team although their lead
    reads elsewhere. A member's plan given them carries the decision out.
    """

    kind: str
    destination: object = None
    force: bool = False
    archive_mail: bool = False
    keep_team: bool = False
    team: object = None
    team_answer: object = None

    def __post_init__(self):
        if self.kind not in {"explicit", "live", "automatic"}:
            raise ValueError(f"unknown member redirect kind {self.kind!r}")
        if self.kind == "explicit" and not self.destination:
            raise ValueError("an explicit member redirect requires a destination")
        if self.kind != "explicit" and self.destination is not None:
            raise ValueError(f"{self.kind} redirect selects its destination from evidence")
        if self.keep_team and self.kind != "automatic":
            raise ValueError("keep_team applies only to automatic redirect")
        if (self.team is None) != (self.team_answer is None):
            raise ValueError("a team decision and the run's answer to it come together")
        if self.team_answer not in (None, "follow", "stay", "declined"):
            raise ValueError(f"unknown team answer {self.team_answer!r}")


