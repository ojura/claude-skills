            if took is not False:
                stray.append("a blocked redirect claimed the move")
            for owed in ("--with-mail", "--force instead rewrites"):
                if owed not in " ".join(told.getvalue().split()):
                    stray.append(f"a blocker went unremedied: {owed}")
            RESOLVER._reap_objections = lambda *a, **k: [
                {"pid": PID_CEILING + 9, "kinds": frozenset({"wears"}),
                 "said": f"pid {PID_CEILING + 9} wears it"}]
            force_plan = RESOLVER._rebind_plan(
                "OLD", "NEW", target, (), census=(), force=True)
            if force_plan["action"] != "restamp" or not force_plan["restamp"]:
                stray.append("--force did not select the proved restamp")
            RESOLVER._reap_objections = lambda *a, **k: [
                {"pid": PID_CEILING + 9, "kinds": frozenset({"wears"}),
                 "said": f"pid {PID_CEILING + 9} wears it"}]
            held_plan = RESOLVER._rebind_plan(
