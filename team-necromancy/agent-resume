@unit(('smoke-typed-commands', 'the commands a person types end in a message, not a traceback'), live=True)
def _check_smoke_typed_commands(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sp = s.sp

    here_uuid = "22222222-2222-4222-8222-222222222222"
    gone_uuid = "00000000-0000-4000-8000-000000000000"
    shapes = [
        # a name, spelled the ways people spell one
        ("runs", ["willow", "--dry-run"]),
        ("refuses", ["nosuchname", "--dry-run"]),
        ("runs", ["willow@session-corpus-alpha", "--dry-run"]),
        ("refuses", ["nosuchagent@session-corpus-alpha", "--dry-run"]),
        ("refuses", ["nosuch@nosuchteam", "--dry-run"]),
        ("refuses", ["@session-corpus-alpha", "--dry-run"]),       # nothing before the @
        ("refuses", ["WILLOW@session-corpus-alpha", "--dry-run"]),  # a case the roster does not carry
        ("runs", ["willow@", "--dry-run"]),                        # a trailing @ is a bare name
        ("runs", ["willow@team@extra", "--dry-run"]),              # two @, warned about
        # a session uuid, held and not held
        ("runs", [here_uuid, "--dry-run"]),
        ("refuses", [gone_uuid, "--dry-run"]),
        # a team, bare and behind the flag. Either way round: whether a team
        # comes up depends on its lead being live, which is this machine's
        # business rather than the fixture's.
        ("either", ["session-corpus-alpha", "--dry-run"]),
        ("refuses", ["nosuchteam", "--dry-run"]),
        ("either", ["--team", "session-corpus-alpha", "--dry-run"]),
        ("refuses", ["--team", "nosuchteam", "--dry-run"]),
        # --doctor uses those same selectors rather than classifying them again.
        ("runs", ["willow", "--doctor"]),
        ("refuses", ["nosuchname", "--doctor"]),
        ("runs", ["willow@session-corpus-alpha", "--doctor"]),
        ("refuses", ["nosuchagent@session-corpus-alpha", "--doctor"]),
        ("runs", [here_uuid, "--doctor"]),
        ("refuses", [gone_uuid, "--doctor"]),
        ("runs", ["session-corpus-alpha", "--doctor"]),
        ("refuses", ["nosuchteam", "--doctor"]),
        ("refuses", ["willow", "--standing"]),
        # the other verbs, pointed at what they cannot find.
        ("refuses", ["--doctor", "nosuchteam"]),
        ("refuses", ["--demote", gone_uuid]),
        ("refuses", ["--promote", "nosuchside"]),
        # nothing wears this id, so the stop finds nothing and asks nobody
        ("refuses", ["--agent-id", "ghost@session-corpus-alpha", "--stop"]),
        ("refuses", ["--frobnicate", "willow"]),
    ]

    # A copy of the fixture, so a shape that writes writes here and the corpus
    # every other check reads stays as it is.
    smoke_home = Path(tempfile.mkdtemp(prefix=f"{TOOL}-smoke-"))
    smoke_cfg = smoke_home / "claude"
    shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", smoke_cfg)
    smoke_env = dict(os.environ, CLAUDE_CONFIG_DIR=str(smoke_cfg), NO_COLOR="1")
    crashed, misbehaved, codes = [], [], set()
    was_up = started_here()
    try:
        for expect, argv in shapes:
            typed = f"{TOOL} {' '.join(argv)}"
            try:
                # stdin closed: a prompt nobody can answer must not hang the
                # suite, and no shape here is meant to reach one.
                run = sp.run([sys.executable, str(Path(__file__).resolve()), *argv],
                             capture_output=True, text=True, env=smoke_env,
                             stdin=sp.DEVNULL, timeout=60)
            except sp.TimeoutExpired:
                crashed.append(f"{typed}: still running after 60s")
                continue
            codes.add(run.returncode)
            if "Traceback (most recent call last)" in run.stderr:
                died_of = next((line for line in reversed(run.stderr.splitlines())
                                if re.match(r"[A-Za-z_.]+(Error|Exception):", line)),
                               "no exception line")
                crashed.append(f"{typed}: {died_of.strip()[:110]}")
            elif expect == "runs" and run.returncode != 0:
                misbehaved.append(f"{typed}: exit {run.returncode}, expected it to go through")
            elif expect == "refuses" and run.returncode == 0:
                misbehaved.append(f"{typed}: exit 0, expected a refusal")
            elif expect == "refuses" and not run.stderr.strip():
                misbehaved.append(f"{typed}: exit {run.returncode} and said nothing")
    finally:
        shutil.rmtree(smoke_home, ignore_errors=True)
    left_behind = sorted(started_here() - was_up)
    if left_behind:
        misbehaved.append(f"started something and left it: {', '.join(left_behind)}")
    if 0 not in codes or not codes - {0}:
        misbehaved.append(f"a run and a refusal must both be covered, "
                          f"and the exit codes seen were {sorted(codes)}")
    told = crashed + misbehaved
    # Three whole entries and then a count, rather than a run of them cut off
    # mid-command: the detail is one line, and half a command name is no lead.
    shown = told[:3] + ([f"and {len(told) - 3} more"] if len(told) > 3 else [])
    check("smoke-typed-commands", "the commands a person types end in a message, not a traceback",
          not told, "; ".join(shown))
    return checked


@unit(('stop-preview-ends-nothing', 'a --stop preview ends nothing and says what it would end'), live=True)
def _check_stop_preview_ends_nothing(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sp = s.sp

    stop_home = Path(tempfile.mkdtemp())
    (stop_home / "projects").mkdir()
    (stop_home / "teams").mkdir()
    ident = own("preview@selftest-stop")

    def stop_arm(*flags):
        """(what a --stop printed, its exit code, whether the fixture survived)."""
        # argv[0] is what decides whether a process is a claude, and the
        # binary that actually runs is python; the id in argv is what --stop
        # matches on. No --resume, so it holds no transcript to resolve.
        victim = sp.Popen([FAKE_AGENT_BIN, "-c", '__import__("time").sleep(60)',
                           "--agent-id", ident], executable=sys.executable)
        try:
            time.sleep(0.3)          # let it reach the process table
            run = sp.run([sys.executable, str(Path(__file__).resolve()),
                          "--agent-id", ident, "--stop", *flags],
                         capture_output=True, text=True, timeout=300,
                         stdin=sp.DEVNULL,   # no terminal, so no prompt can be answered
                         env=dict(os.environ, CLAUDE_CONFIG_DIR=str(stop_home),
                                  NO_COLOR="1"))
            time.sleep(0.3)
            return run.stdout, run.returncode, victim.poll() is None
        finally:
            victim.kill()
            victim.wait()

    try:
        said, code, survived = stop_arm("--dry-run")
        yes_said, yes_code, yes_survived = stop_arm("--dry-run", "--yes")
        real_said, real_code, real_survived = stop_arm("--yes")
    finally:
        shutil.rmtree(stop_home, ignore_errors=True)
    preview = {
        "the preview leaves it running": survived,
        "the preview says what it would end":
            "would abort" in said and ident in said,
        # On a pipe the prompt reads EOF and spares the process anyway, so
        # survival alone proves nothing here; asking at all is the fault.
        "the preview asks nothing": "abort these?" not in said,
        "the preview exits 0": code == 0,
        # The arm that matters: --yes skips the question, so a preview here
        # stays a preview with nothing asked.
        "--yes leaves the preview a preview": yes_survived and "would abort" in yes_said,
        "--dry-run --yes exits 0": yes_code == 0,
        # Without --dry-run the same command line still ends it, so a preview
        # that ends nothing is not a --stop that ends nothing.
        "a real stop still ends it": not real_survived
            and "aborted 1 of 1" in real_said and real_code == 0,
    }
    wrong = sorted(k for k, ok in preview.items() if not ok)
    check("stop-preview-ends-nothing", "a --stop preview ends nothing and says what it would end",
          not wrong, ", ".join(wrong))
    return checked


@unit(('process-table-width-independent', 'the process table is the same at a narrow and a wide terminal'), ('liveness-width-independent', 'an agent that is running is seen as running at either terminal width'), live=True)
def _check_process_table_width_independent(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    sp = s.sp

    width_id = own("widths@selftest-columns")
    padded = sp.Popen([FAKE_AGENT_BIN, "-c", '__import__("time").sleep(60)',
                       "--pad", "p" * 400, "--agent-id", width_id],
                      executable=sys.executable)

    def engine_at(columns):
        """A fresh engine whose snapshot was taken at this terminal width.

        The engine caches its table, so the width is restored before anything
        is asked of it: what is under test is the snapshot the width produced,
        not the width the question is asked at.
        """
        was = os.environ.get("COLUMNS")
        os.environ["COLUMNS"] = columns
        try:
            eng = Resolver(needs=Needs(maybe=set(NEED)))
            eng.process_table(refresh=True)
            return eng
        finally:
            if was is None:
                os.environ.pop("COLUMNS", None)
            else:
                os.environ["COLUMNS"] = was

    try:
        time.sleep(0.3)          # let it reach the process table
        narrow, wide = engine_at("100"), engine_at("1000")
        narrow_rows = {pid: (ppid, args) for pid, ppid, args in narrow.process_table()}
        wide_rows = {pid: (ppid, args) for pid, ppid, args in wide.process_table()}
        # Only the pids both snapshots hold. This machine starts and ends
        # processes while the suite runs, and a pid that came or went between
        # two reads is churn, not width. A pid in both that says two different
        # things is the fault.
        moved = sorted(str(pid) for pid in set(narrow_rows) & set(wide_rows)
                       if narrow_rows[pid] != wide_rows[pid])
        full = f"--agent-id {width_id}"
        widths = {
            "the fixture is in both snapshots":
                padded.pid in narrow_rows and padded.pid in wide_rows,
            "with its whole command line in both":
                full in narrow_rows.get(padded.pid, (0, ""))[1]
                and full in wide_rows.get(padded.pid, (0, ""))[1],
            "and no shared row says two different things": not moved,
        }
        wrong = sorted(k for k, ok in widths.items() if not ok)
        check("process-table-width-independent",
              "the process table is the same at a narrow and a wide terminal",
              not wrong, "; ".join(wrong) + (f"; rows that moved: {', '.join(moved[:3])}" if moved else ""))

        # The half that decides anything. A table nobody could tell apart is
        # worth having only because the answers built on it come out the same,
        # so this asks the engine's own liveness question rather than reading
        # the table again, and it wants a yes at both widths: two snapshots
        # that agree that nothing is running would satisfy a check that only
        # compared them.
        narrow_runtime = narrow.agent_runtime(width_id)
        wide_runtime = wide.agent_runtime(width_id)
        narrow_seen = [pid for pid, _ in narrow_runtime["others"]]
        wide_seen = [pid for pid, _ in wide_runtime["others"]]
        narrow_ours, wide_ours = narrow_runtime["ours"], wide_runtime["ours"]
        check("liveness-width-independent",
              "an agent that is running is seen as running at either terminal width",
              narrow_seen == wide_seen == [padded.pid]
              # A process we spawned is a child, never an ancestor, so it is a
              # stranger to us and both widths must say so. A fixture that
              # landed in our own lineage would be excluded from the strangers
              # half for a reason that has nothing to do with width.
              and not narrow_ours and not wide_ours,
              f"pid {padded.pid} is running; at 100 columns the engine saw "
              f"{narrow_seen or 'nothing'}, at 1000 it saw {wide_seen or 'nothing'}"
              + (f"; and it read as our own lineage: {narrow_ours or wide_ours}"
                 if narrow_ours or wide_ours else ""))
    finally:
        padded.kill()
        padded.wait()
    return checked


