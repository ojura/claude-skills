@unit(
    ('promoted-member-root-is-stamped',
     'a promoted member root carries the assigned name and team for ordinary resume'),
    ('promoted-member-root-stamps-reverse-exactly',
     'demotion restores the exact member root and repeated cycles stay byte-identical'),
    ('promoted-lead-root-is-not-member-stamped',
     'lead promotion does not apply the member-root identity method'),
    ('promoted-root-stamps-one-conversion-edit',
     'root stamping and restoration are owned by the conversion receipt'),
)
def _check_promoted_member_root_stamps(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    with s.tempfile.TemporaryDirectory() as td:
        root = Path(td) / "corpus"
        shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", root)
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir, eng.teams_dir = root / "projects", root / "teams"
        side = next(eng.projects_dir.glob(
            "*/bbbbbbbb-cccc-4ccc-8ccc-cccccccccccc/subagents/agent-fork1.jsonl"))
        ref = json.loads(side.read_text().splitlines()[0])
        parent_file = side.parent.parent.parent / f"{ref['parentSessionId']}.jsonl"
        parent_file.write_text(
            fixture_line({"parentUuid": None, "isSidechain": False,
                          "sessionId": ref["parentSessionId"], "type": "user",
                          "uuid": "root-stamp-parent", "message": {"role": "user",
                          "content": "inherited root-stamp turn"}}) + "\n" +
            fixture_line({"parentUuid": "root-stamp-parent", "isSidechain": False,
                          "sessionId": ref["parentSessionId"], "type": "assistant",
                          "uuid": ref["parentLastUuid"]}) + "\n")
        original = side.read_bytes()
        identity = ("rooted-member", "session-rooted-member")
        member = eng.rewriter.conversion_plan(side, "promote", identity=identity)
        if not member.get("lines"):
            detail = repr(member.get("objections"))
            return [(cid, name, False, detail) for cid, name in (
                ("promoted-member-root-is-stamped",
                 "a promoted member root carries the assigned name and team for ordinary resume"),
                ("promoted-member-root-stamps-reverse-exactly",
                 "demotion restores the exact member root and repeated cycles stay byte-identical"),
                ("promoted-lead-root-is-not-member-stamped",
                 "lead promotion does not apply the member-root identity method"),
                ("promoted-root-stamps-one-conversion-edit",
                 "root stamping and restoration are owned by the conversion receipt"))]
        receipt = TranscriptRewriter.carried_receipt(member["lines"]) or {}
        root_uuid = receipt.get("root")
        promoted_rows = [json.loads(line) for line in member["lines"]]
        promoted_root = next((row for row in promoted_rows
                              if row.get("uuid") == root_uuid), {})
        promoted_bytes = "\n".join(member["lines"]).encode() + b"\n"

        member["dest_path"].write_bytes(promoted_bytes)
        demoted = eng.rewriter.conversion_plan(member["dest_path"], "demote")
        demoted_bytes = "\n".join(demoted["lines"]).encode() + b"\n"
        demoted["dest_path"].parent.mkdir(parents=True, exist_ok=True)
        demoted["dest_path"].write_bytes(demoted_bytes)
        repeated = eng.rewriter.conversion_plan(
            demoted["dest_path"], "promote", identity=identity)
        repeated_bytes = "\n".join(repeated["lines"]).encode() + b"\n"

        lead = eng.rewriter.conversion_plan(
            side, "promote", identity=("team-lead", "session-rooted-lead"))
        lead_receipt = TranscriptRewriter.carried_receipt(lead["lines"]) or {}
        source_rows = [json.loads(line) for line in original.decode().splitlines()]
        source_root = next((row for row in source_rows
                            if row.get("uuid") == lead_receipt.get("root")), {})
        lead_root = next((json.loads(line) for line in lead["lines"]
                          if json.loads(line).get("uuid") == lead_receipt.get("root")), {})

    stamped = (not member["objections"] and member["proved"]
               and promoted_root.get("agentName") == identity[0]
               and promoted_root.get("teamName") == identity[1]
               and set((receipt.get("root_stamps") or {})) == {"agentName", "teamName"})
    exact = (not demoted["objections"] and demoted["proved"]
             and demoted_bytes == original
             and not repeated["objections"] and repeated["proved"]
             and repeated_bytes == promoted_bytes)
    lead_unchanged = (not lead["objections"] and lead["proved"]
                      and "root_stamps" not in lead_receipt
                      and lead_root.get("agentName") == source_root.get("agentName")
                      and lead_root.get("teamName") == source_root.get("teamName"))
    check("promoted-member-root-is-stamped",
          "a promoted member root carries the assigned name and team for ordinary resume",
          stamped)
    check("promoted-member-root-stamps-reverse-exactly",
          "demotion restores the exact member root and repeated cycles stay byte-identical",
          exact)
    check("promoted-lead-root-is-not-member-stamped",
          "lead promotion does not apply the member-root identity method",
          lead_unchanged)
    convert_src = s.src_of(s.funcs["_convert"]) or ""
    root_stamp_readers = s.callers_of("_convert") - s.suite_fns
    check("promoted-root-stamps-one-conversion-edit",
          "root stamping and restoration are owned by the conversion receipt",
          'receipt["root_stamps"] = root_stamps' in convert_src
          and root_stamp_readers == {"conversion_plan"},
          repr(sorted(root_stamp_readers)))
    return checked


@unit(
    ('promoted-member-resolves-by-its-receipt',
     'a promoted member that never launched is found by its own receipt'),
    ('uuid-resume-declares-runtime-stamps',
     'a promoted lead resumed by UUID declares the stamp search used by live runtime mapping'),
    ('transcript-with-no-identity-refused',
     'a transcript nothing on disk names still gets the honest refusal'),
)
def _check_promoted_member_resolves_by_its_receipt(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    _Run = s._Run
    tempfile = s.tempfile

    PROMOTED = ("dropped", "session-corpus-alpha")

    class _Promote:
        """The flags run_promote reads, set the way the owner's specimen was
        made: --as-agent name@team and --no-launch. --force because the corpus
        file's mtime is whenever this tree was checked out, and a fresh checkout
        would otherwise be refused as still running."""

        def __init__(self, **kw):
            self.__dict__.update({"promote": "fork1", "as_": None, "dry_run": False,
                                  "force": True, "no_launch": True})
            self.__dict__.update(kw)

    def promote_the_fork(root, into=PROMOTED):
        """Run the promote verb against this tree. Returns the stem it made.

        The verb rather than the plan and the writer under it, so what these
        checks resume is what the command produces, receipt line included.
        """
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir, eng.teams_dir = root / "projects", root / "teams"
        side = next(eng.projects_dir.glob("*/bbbbbbbb-cccc-4ccc-8ccc-cccccccccccc/"
                                         "subagents/agent-fork1.jsonl"))
        ref = json.loads(side.read_text().splitlines()[0])
        parent_file = side.parent.parent.parent / f"{ref['parentSessionId']}.jsonl"
        if not parent_file.exists():
            parent_file.write_text(
                fixture_line({"parentUuid": None, "isSidechain": False,
                              "sessionId": ref["parentSessionId"], "type": "user",
                              "uuid": "pf-parent-root", "message": {"role": "user",
                              "content": "inherited corpus turn"}}) + "\n" +
                fixture_line({"parentUuid": "pf-parent-root", "isSidechain": False,
                              "sessionId": ref["parentSessionId"], "type": "assistant",
                              "uuid": ref["parentLastUuid"]}) + "\n")
        real_resolver, real_receipts = globals()["RESOLVER"], globals()["RECEIPTS_DIR"]
        globals().update(RESOLVER=eng, RECEIPTS_DIR=root / "receipts")
        try:
            with capturing("out"):
                run_promote(_Promote(as_=f"{into[0]}@{into[1]}"))
        finally:
            globals().update(RESOLVER=real_resolver, RECEIPTS_DIR=real_receipts)
        # The transcript is the thing being asked about, and its last conversion
        # record names both the destination and the identity.
        made = [(path, eng.rewriter.receipt_in_file(path))
                for path in eng.projects_dir.glob("*/*.jsonl")]
        path, _receipt = next((item for item in made
                              if (item[1] or {}).get("name") == into[0]) )
        return path.stem

    # Resolution and the socket, off a tree of their own so the assertions can
    # read what the run decided rather than what the fixture forced on it.
    with tempfile.TemporaryDirectory() as td:
        root = Path(td) / "corpus"
        shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", root)
        stem = promote_the_fork(root)
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir, eng.teams_dir = root / "projects", root / "teams"
        eng.process_table = lambda refresh=False: []
        eng._session_registry = lambda: []
        agent_id = f"{PROMOTED[0]}@{PROMOTED[1]}"
        by_id = by_uuid = None
        resolution_error = ""
        with capturing("err"):
            try:
                by_id = eng.identity(agent_id=agent_id)
                by_uuid = eng.identity(session_uuid=stem)
            except Refusal as err:
                resolution_error = str(err)
        real_resolver = globals()["RESOLVER"]
        globals()["RESOLVER"] = eng
        try:
            with capturing("err"):
                sock, _why = resolve_socket(by_id, _Run(), []) if by_id else (None, None)
        finally:
            globals()["RESOLVER"] = real_resolver
        found = {
            "the address resolves to the promoted file":
                bool(by_id and by_id["target"]["transcript"]["path"].stem == stem),
            "and to the agent the promote named":
                bool(by_id and eng.field(by_id, "agentId") == agent_id),
            "the uuid alone resolves the same agent":
                bool(by_uuid and eng.field(by_uuid, "agentId") == agent_id
                     and eng.field(by_uuid, "teamName") == PROMOTED[1]),
            "the receipt is named as the source":
                bool(by_uuid and eng.provenance(by_uuid, "teamName")[2] == "promote receipt"),
            "the receipt outranks ordinary dated sources":
                bool(by_uuid and eng.provenance(by_uuid, "teamName")[1] > 0
                     and eng.provenance(by_uuid, "teamName")[2] == "promote receipt"),
            "the socket is the team's":
                sock == f"{SOCKET_PREFIX}{PROMOTED[1]}",
        }
        wrong = sorted(k for k, ok in found.items() if not ok)
        check("promoted-member-resolves-by-its-receipt",
              "a promoted member that never launched is found by its own receipt",
              not wrong, ", ".join(wrong) + (f": {resolution_error}" if resolution_error else ""))

        # A promoted lead can reach live-runtime team mapping even when selected by
        # exact UUID. That mapping enumerates known teams, which conditionally reads
        # the transcript stamp index. Reproduce the branch with a live lead fixture
        # so removing the declaration fails here rather than in a real dry run.
        runtime_root = Path(td) / "runtime-corpus"
        shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", runtime_root)
        runtime_stem = promote_the_fork(
            runtime_root, into=("team-lead", "session-runtime-stamps"))
        dry_uuid = types.SimpleNamespace(
            complete=False, selftest=False, cleanup=False, doctor=False,
            census=False, sides=False, promote=False, demote=False,
            mail_ledger=False, install=False, poison=False, unpoison=False,
            stop=False, agent_id=None, resume=runtime_stem,
            team=None, to_team=None, dry_run=True,
        )
        rebind_uuid = copy.copy(dry_uuid)
        rebind_uuid.to_team = "session-runtime-destination"
        runtime_eng = Resolver(needs=verb_needs(dry_uuid, None))
        runtime_eng.projects_dir = runtime_root / "projects"
        runtime_eng.teams_dir = runtime_root / "teams"
        runtime_eng.process_table = lambda refresh=False: []
        runtime_eng._session_registry = lambda: []
        runtime_eng.runtime = lambda table=None: {
            "by_pid": {}, "by_agent": {}, "best_by_session": {},
            "transcripts": {}, "live_sessions": [{
                "pid": 4242, "alive": True, "session": None, "team": None,
                "agent_id": None, "started": 0}]}
        runtime_eng._lead_process = lambda snapshot, parent, team: {
            "pid": 4242, "alive": True, "how": "fixture live lead",
            "detail": "fixture live lead", "exact": True, "kind": "registry",
        }
        runtime_eng._boot_join = lambda snapshot: []
        runtime_error = ""
        with capturing("err"):
            try:
                runtime_eng.identity(session_uuid=runtime_stem)
            except Exception as err:
                runtime_error = f"{err.__class__.__name__}: {err}"
        declared_runtime_stamps = (
            runtime_eng.needs[NEED.STAMPS] is DECLARED.MAYBE
            and verb_needs(rebind_uuid, None)[NEED.STAMPS] is DECLARED.MAYBE
            and NEED.STAMPS in runtime_eng.exercised
        )
        check("uuid-resume-declares-runtime-stamps",
              "a promoted lead resumed by UUID declares the stamp search used by "
              "live runtime mapping",
              not runtime_error and declared_runtime_stamps,
              runtime_error or repr(runtime_eng.needs))

        # And the refusal it must not swallow. Same tree, a transcript with no
        # stamps, no receipt and no spawn payloads: nothing on disk says who it
        # is, and saying so is the right answer.
        blank = "0b1a0b1a-0b1a-4b1a-8b1a-0b1a0b1a0b1a"
        (root / "projects" / "corpus" / f"{blank}.jsonl").write_text(fixture_line(
            {"type": "user", "uuid": "bl-root", "parentUuid": None,
             "sessionId": blank, "timestamp": "2026-05-01T00:00:00Z",
             "message": {"role": "user", "content": "nobody"}}) + "\n")
        blank_eng = Resolver(needs=Needs(maybe=set(NEED)))
        blank_eng.projects_dir, blank_eng.teams_dir = root / "projects", root / "teams"
        blank_eng.process_table = lambda refresh=False: []
        blank_eng._session_registry = lambda: []
        with capturing("err") as refusal:
            try:
                blank_eng.identity(session_uuid=blank)
                refused = False
            except Refusal:
                refused = True
        said = " ".join(without_wrap_arrows(refusal.getvalue()).split())
        honest = {
            "plain session history is refused": refused,
            "the refusal names both empty identity sources":
                "complete agent stamps" in said and "teammate spawn records" in said
                and "both resolve empty" in said,
            "the refusal offers explicit identity assignment": "--agent-id" in said,
        }
        wrong = sorted(k for k, ok in honest.items() if not ok)
        check("transcript-with-no-identity-refused",
              "a transcript nothing on disk names still gets the honest refusal",
              not wrong, ", ".join(wrong))

    s.PROMOTED = PROMOTED
    s.eng = eng
    s.promote_the_fork = promote_the_fork
    s.real_resolver = real_resolver
    s.said = said
    s.sock = sock
    return checked


@unit(('refusal-names-a-case-near-match', 'a selector that differs only in case is told which one it missed'))
def _check_refusal_names_a_case_near_match(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    corpus_engine = s.corpus_engine

    eng_case = corpus_engine()
    roster_names = {e["member"].get("name") for e in eng_case.scan_teams()}
    typo = eng_case.resolve_transcript(name="WILLOW", team="session-corpus-alpha", quick=True)
    plain = eng_case.resolve_transcript(name="zzzznotreal", team="session-corpus-alpha", quick=True)
    # Driven through the caller too, because the flag is only worth setting if
    # the caller reads it: the message a person sees is the one built here.

    def cased_refusal(asked):
        """What identity() printed when it refused this name, as one line."""
        with capturing("err") as told:
            try:
                corpus_engine().identity(agent_id=f"{asked}@session-corpus-alpha")
            except Refusal:
                pass
        return " ".join(told.getvalue().split())

    typo_said, plain_said = cased_refusal("WILLOW"), cased_refusal("zzzznotreal")
    tail = "a truly in-process agent"
    cased = {
        "the corpus carries the name in the other case": "willow" in roster_names,
        "and not the way this asks for it": "WILLOW" not in roster_names,
        "the refusal names the near match":
            "willow@session-corpus-alpha" in (typo.reason or ""),
        "and says what is different about it": "only in case" in (typo.reason or ""),
        "it needs no further explaining": typo.answered,
        "a name nobody has claims no near match":
            "only in case" not in (plain.reason or ""),
        "and still leaves its caller to explain": not plain.answered,
        "the printed refusal names the near match too":
            "willow@session-corpus-alpha" in typo_said and "only in case" in typo_said,
        "and drops the explanation it does not need": tail not in typo_said,
        "which the refusal that needs it still carries": tail in plain_said,
    }
    wrong = sorted(k for k, ok in cased.items() if not ok)
    check("refusal-names-a-case-near-match",
          "a selector that differs only in case is told which one it missed",
          not wrong, ", ".join(wrong) or f"said {(typo.reason or '')[:60]!r}")

    s.plain = plain
    return checked


