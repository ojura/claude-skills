      live=True)
def _check_team_fits_window(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    geom_sock = own(f"{SOCKET_PREFIX}selftest-geometry")
    tmux(geom_sock, "kill-server")
    wanted = 7
    placed, refused = [], None
    agent_id = own("wrapped@session-live-seat")
    session = f"selftest-live-seat-{os.getpid()}"
    child = (f"exec -a {shlex.quote(FAKE_AGENT_BIN)} {shlex.quote(sys.executable)} "
             f"-c {shlex.quote('__import__(\"time\").sleep(60)')} "
             f"--resume {shlex.quote(session)} --agent-id {shlex.quote(agent_id)} & wait")
    try:
        for i in range(wanted):
            try:
                # The first pane uses the same launch fixture to put a wrapped
                # agent below its pane shell. The other six retain the geometry
                # load this check was built to exercise.
                command = ["bash", "-c", child] if i == 0 else ["sleep", "30"]
                with capturing("out"), capturing("err"):
                    pane, _action = launch(geom_sock, placed[0] if placed else None,
                                           "/tmp", command, False)
                placed.append(pane)
            except LaunchFailed as exc:
