def roster_pane_note(reference):
    """Render structured roster pane evidence without reading tmux."""
    if reference.state == "present":
        return reference.recorded
    if reference.state == "gone":
        return (f"(none: recorded {reference.recorded} is gone from "
                f"{reference.destination.socket})")
    return "(none recorded)"


def terminal_note(terminal):
    """Render one immutable TerminalContext without reading the environment."""
    if terminal.seat:
        return (f"in this terminal, tmux pane {terminal.seat.pane} "
                f"on {terminal.seat.socket}")
    if terminal.socket_without_pane:
        return (f"in this terminal, inside tmux on {terminal.socket_without_pane} "
                "(pane id unavailable)")
    return "in this terminal, outside tmux"


def maybe_attach(decision):
    """Apply one immutable decision about attaching to the launched swarm."""
    socket = decision["socket"]
    if decision["reason"] in ("disabled", "no socket"):
        return
    if decision["reason"] == "no server":
        print(f"nothing to attach to: no server on {socket}")
        return
    if decision["action"] == "skip":
        print(f"attach with: {shlex.join(decision['command'])}   "
              f"({decision['reason']})")
        return
    if decision["action"] == "refuse":
        warn(f"--attach requested but {decision['reason']}; attach by hand: "
             f"{shlex.join(decision['command'])}")
        return
    print(f"attaching to {socket}")
    os.execvp(decision["command"][0], list(decision["command"]))


