@unit(('asking-is-not-resuming', 'describing a team warns about nothing; rebuilding it does'))
def _check_asking_is_not_resuming(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    corpus_engine = s.corpus_engine
    funcs = s.funcs
    src_of = s.src_of

    eng = corpus_engine()
    said = io.StringIO()
    with capturing("err", into=said):
        uncorroborated = []
        for candidate in eng._known_teams():
            path, claim = eng._lead_transcript_for(candidate)
            if path and claim["basis"] is None:
                uncorroborated.append(candidate)
        completion = eng.completion_answer("teams")
        described = {team for team in uncorroborated
                     if any(row.startswith(f"{team}:") for row in completion["rows"])}
    acts = src_of(funcs["rebuild_roster"]) or ""
    quiet = []
    if not uncorroborated:
        quiet.append("the corpus has no uncorroborated team, so this compares nothing")
    elif described != set(uncorroborated):
        quiet.append("completion omitted " + ", ".join(sorted(set(uncorroborated) - described)))
    if said.getvalue().strip():
        quiet.append(f"describing one warned: {said.getvalue().strip().splitlines()[0][:60]}")
    if "nothing corroborates" not in acts:
        quiet.append("the run that rebuilds no longer says the claim is uncorroborated")
    check("asking-is-not-resuming", "describing a team warns about nothing; rebuilding it does",
          not quiet, "; ".join(quiet))
    return checked


@unit(("fixture-line-one-spelling", "a fixture transcript's records are written one way"))
def _check_fixture_line_one_spelling(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("fixture_line")
    if not owner:
        forked.append("fixture_line is gone, so nothing says how a fixture writes a record")
    else:
        # The record goes to fixture_line and comes back as the line a .jsonl
        # file holds: one record, no spaces, and nothing added.
        made = fixture_line({"type": "user", "uuid": "x"})
        if made != '{"type":"user","uuid":"x"}' or "\n" in made:
            forked.append(f"a record comes back as {made!r}")

    # A json.dumps carrying separators inside a unit is a unit spelling the
    # line itself. The product's three sites are outside the units and pass
    # ensure_ascii=False, which is a different call for a different job: a
    # conversion hands back the bytes it was given, and a fixture here has no
    # non-ASCII to hand back.
    units = [(node.lineno, node.end_lineno or node.lineno, node.name)
             for node in ast.walk(tree) if isinstance(node, ast.FunctionDef)
             and any(isinstance(dec, ast.Call) and getattr(dec.func, "id", None) == "unit"
                     for dec in node.decorator_list)]
    for node in ast.walk(tree):
        if not (isinstance(node, ast.Call) and getattr(node.func, "attr", None) == "dumps"
                and any(word.arg == "separators" for word in node.keywords)):
            continue
        inside = [name for first, last, name in units if first <= node.lineno <= last]
        if inside:
            forked.append(f"{inside[0]} spells a fixture line itself at line {node.lineno}")
    check("fixture-line-one-spelling", "a fixture transcript's records are written one way",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(("refusal-carries-its-reason", "a refusal is its own signal and says what it refused"))
def _check_refusal_carries_its_reason(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    if "Refusal" not in {node.name for node in ast.walk(tree)
                         if isinstance(node, ast.ClassDef)}:
        forked.append("Refusal is gone, so a refusal is somebody else's exception again")
    elif "die" not in funcs:
        forked.append("die is gone, so nothing raises one")
    else:
        # Put to die itself: what a refusal carries, and that it is not the
        # kind of exception a broad catch around a call is allowed to take.
        with capturing("err") as said:
            try:
                die("the reason", 3)
            except Refusal as refused:
                got = (refused.said, refused.code, said.getvalue().strip().endswith("the reason"))
            except BaseException as exc:
                got = f"{type(exc).__name__} instead"
        if got != ("the reason", 3, True):
            forked.append(f"die answers {got}, not its reason, its code and having said it")
        if issubclass(Refusal, Exception):
            forked.append("a refusal is an Exception, so a broad catch around a call swallows one")

        # A refusal is raised as one and caught as one. ran_unit is the
        # exception: it catches whatever ends a unit, and something that is not
        # a refusal is still worth naming there.
        for node in ast.walk(tree):
            if not (isinstance(node, ast.ExceptHandler) and node.type is not None):
                continue
            named = ([node.type.id] if isinstance(node.type, ast.Name)
                     else [getattr(part, "id", "") for part in node.type.elts]
                     if isinstance(node.type, ast.Tuple) else [])
            if "SystemExit" not in named:
                continue
            holder = sorted((fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                            for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)
                            and fn.lineno <= node.lineno <= (fn.end_lineno or fn.lineno))
            where = holder[-1][2] if holder else "<module>"
            if where != "ran_unit":
                forked.append(f"{where} catches SystemExit at line {node.lineno}, "
                              "where a refusal now arrives as a Refusal")

        # And the exit itself is one call, outside every function, so a refusal
        # cannot be turned into a code anywhere but at the end of the run.
        exits = [node.lineno for node in ast.walk(tree)
                 if isinstance(node, ast.Call)
                 and getattr(node.func, "attr", None) == "exit"
                 and getattr(node.func.value, "id", None) == "sys"]
        inside = [line for line in exits
                  if any(fn.lineno <= line <= (fn.end_lineno or fn.lineno)
                         for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef))]
        if len(exits) != 1 or inside:
            forked.append(f"sys.exit is called at {exits}, {len(inside)} of them inside a function")
    check("refusal-carries-its-reason", "a refusal is its own signal and says what it refused",
          not forked, "; ".join(sorted(set(forked))[:3]))
    return checked


@unit(
    ("output-taken-one-way", "this process's own output is taken in one place"),
    ("live-runner-takes-both-streams",
     "the live runner checks stdout and stderr for output between verdicts"),
    ("live-share-stderr-reported",
     "a split live run reports stderr from every worker"),
)
def _check_output_taken_one_way(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("capturing")
    # The redirects capturing reaches for, read off its own body, then looked
    # for everywhere else. A block that redirects a stream itself is a second
    # place deciding where this process's output goes.
    reaches = {node.attr for node in (ast.walk(owner) if owner else ())
               if isinstance(node, ast.Attribute) and node.attr.startswith("redirect_")}
    if not owner:
        forked.append("capturing is gone, so nothing owns where the output goes")
    elif not reaches:
        forked.append("capturing redirects nothing, so there is no spelling to hold")
    else:
        # Put to capturing itself: what it takes, what it hands back, what it
        # leaves alone, and that a stream it does not know is refused rather
        # than quietly captured nowhere.
        with capturing("out") as said:
            print("taken")
        with capturing("err") as grumbled:
            print("also taken", file=sys.stderr)
        kept = io.StringIO()
        with capturing("out", into=kept):
            print("into the caller's own")
        for asked, got, want in (("out", said.getvalue(), "taken\n"),
                                 ("err", grumbled.getvalue(), "also taken\n"),
                                 ("into", kept.getvalue(), "into the caller's own\n")):
            if got != want:
                forked.append(f"capturing {asked} gives {got!r}, not {want!r}")
        try:
            with capturing("stdout"):
                pass
        except ValueError:
            pass
        else:
            forked.append("a stream capturing does not know is taken anyway")

        spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                 for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
        for node in ast.walk(tree):
            if not (isinstance(node, ast.Attribute) and node.attr in reaches):
                continue
            if owner.lineno <= node.lineno <= (owner.end_lineno or owner.lineno):
                continue
            inside = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
            forked.append(f"{inside[-1][2] if inside else '<module>'} redirects a "
                          f"stream itself at line {node.lineno}")
    check("output-taken-one-way", "this process's own output is taken in one place",
          not forked, "; ".join(sorted(set(forked))[:3]))

    real_live_checks = globals()["live_checks"]

    def noisy_live_checks(_share=None, _child=None, _diagnostics=None):
        rows, register = check_rows()
        print("stdout between verdicts")
        print("stderr between verdicts", file=sys.stderr)
        return rows, register

    # The runner passes what it took on to the diagnostic stream, past every
    # capture; handed a buffer of its own here, so that text stays in this check.
    report, leaked, passed_on = io.StringIO(), io.StringIO(), io.StringIO()
    try:
        globals()["live_checks"] = noisy_live_checks
        with capturing("out", into=report), capturing("err", into=leaked):
            noise_code = run_selftest(live=True, failed_only=True, diagnostics=passed_on)
    finally:
        globals()["live_checks"] = real_live_checks
    runner_took_both = (noise_code == 1 and not leaked.getvalue()
                        and "live-checks-say-nothing-mid-run" in report.getvalue()
                        and "2 line(s)" in report.getvalue())
    check("live-runner-takes-both-streams",
          "the live runner checks stdout and stderr for output between verdicts",
          runner_took_both,
          f"exit={noise_code}, leaked={leaked.getvalue()!r}, report={report.getvalue()!r}")

    # fold_shares is where a split run reads what each share said.
    parallel = funcs.get("fold_shares")
    stderr_reported = bool(parallel and any(
        isinstance(call, ast.Call)
        and isinstance(call.func, ast.Attribute)
        and getattr(call.func.value, "id", None) == "short"
        and call.func.attr == "append"
        and any(isinstance(part, ast.Name) and part.id == "worker_err"
                and isinstance(part.ctx, ast.Load)
                for arg in call.args for part in ast.walk(arg))
        for call in ast.walk(parallel)))
    check("live-share-stderr-reported",
          "a split live run reports stderr from every worker",
          stderr_reported,
          "fold_shares does not put worker stderr in its failure detail"
          if not stderr_reported else "")
    return checked


@unit(("context-handover-is-taken", "every name a suite context hands over is read by something"))
def _check_context_handover_is_taken(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    tree = s.tree

    # Every name put on the shared namespace against every name read back off
    # it. A context computes what the units need and a unit publishes back what
    # a later one takes, so a name stored and never loaded is a handover nobody
    # takes: the value is computed, carried and dropped, and no linter says so
    # because the store is an attribute on a live object and the name is bound.
    stored, read = {}, set()
    for node in ast.walk(tree):
        if not (isinstance(node, ast.Attribute)
                and isinstance(node.value, ast.Name) and node.value.id == "s"):
            continue
        if isinstance(node.ctx, ast.Store):
            stored.setdefault(node.attr, node.lineno)
        else:
            read.add(node.attr)
    dropped = [f"s.{attr} is handed over at line {line} and nothing reads it"
               for attr, line in sorted(stored.items(), key=lambda pair: pair[1])
               if attr not in read]

    # What the sweep above cannot see, and the arm that keeps it from narrowing
    # in silence. It matches s.<name> as written, so it is right only while
    # every read of the namespace is spelled that way. getattr(s, name),
    # vars(s) and s.__dict__ each read a name without writing one, and a name
    # reached by any of the three would be called dead here while it was in
    # use. None of the three is in this file; if one arrives, this says so and
    # whoever added it decides what the sweep should do about it, rather than
    # the sweep quietly answering for less than it says.
    blind = []
    for node in ast.walk(tree):
        if (isinstance(node, ast.Call)
                and getattr(node.func, "id", None) in ("getattr", "vars")
                and node.args and isinstance(node.args[0], ast.Name)
                and node.args[0].id == "s"):
            blind.append(f"{node.func.id}(s, ...) at line {node.lineno}, "
                         "which the sweep cannot follow")
        if (isinstance(node, ast.Attribute) and node.attr == "__dict__"
                and isinstance(node.value, ast.Name) and node.value.id == "s"):
            blind.append(f"s.__dict__ at line {node.lineno}, "
                         "which the sweep cannot follow")

    forked = blind + dropped
    check("context-handover-is-taken",
          "every name a suite context hands over is read by something",
          not forked, "; ".join(forked[:3]))
    return checked


@unit(("check-registration-one-owner", "registering a check means one thing in every tier"))
def _check_check_registration_one_owner(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs
    tree = s.tree

    forked = []
    owner = funcs.get("check_rows")
    if not owner:
        forked.append("check_rows is gone, so nothing says what registering means")
    else:
        # check_rows is called here and given two rows, then the first id a
        # second time, then a third id with a verdict that is not a bool. What
        # comes back in its list, and what it records for the repeat and for the
        # verdict, is the answer. A repeat is recorded, not raised: raising would
        # end the tier inside the loop that builds rows, so the run would have no
        # rows to show and could not say which ids collided.
        rows, register = check_rows()
        register("one", "the first", True, "")
        register("two", "the second", False, "why")
        if rows != [("one", "the first", True, ""), ("two", "the second", False, "why")]:
            forked.append(f"a registered row comes back as {rows}")
        was = list(rows)
        register("one", "the first again", True, "")
        if rows != was:
            forked.append(f"a repeated id put a row in: {rows[len(was):]}")
        if getattr(register, "collisions", None) != ["one"]:
            forked.append("one id registers twice and nothing is recorded")
        register("three", "the third", None, "")
        if rows != was:
            forked.append(f"a None verdict made a row: {rows[len(was):]}")
        refused = getattr(register, "rejected", [])
        if len(refused) != 1 or "'three'" not in refused[0] or "NoneType" not in refused[0]:
            forked.append(f"a None verdict is not refused by its check's name: {refused}")

        # The uniqueness row is the one place a repeat is stated. Its phrase is
        # read off the function that registers that row; any other string
        # literal carrying it is a second place deciding what a repeat means.
        speaker = funcs.get("register_ids_unique_row")
        phrase = next((part.value for node in ast.walk(speaker) if isinstance(node, ast.JoinedStr)
                       for part in node.values
                       if isinstance(part, ast.Constant) and "more than once" in part.value),
                      None) if speaker else None
        if not phrase:
            forked.append("nothing states a repeated id, so there is no statement to hold")
        else:
            spans = [(fn.lineno, fn.end_lineno or fn.lineno, fn.name)
                     for fn in ast.walk(tree) if isinstance(fn, ast.FunctionDef)]
            for node in ast.walk(tree):
                if not (isinstance(node, ast.Constant) and isinstance(node.value, str)):
                    continue
                if phrase not in node.value:
                    continue
                if speaker.lineno <= node.lineno <= (speaker.end_lineno or speaker.lineno):
                    continue
                inside = sorted(span for span in spans if span[0] <= node.lineno <= span[1])
                forked.append(f"{inside[-1][2] if inside else '<module>'} states a "
                              f"repeated id itself at line {node.lineno}")

    # run_selftest, live_checks and _live_in_parallel each have to call
    # check_rows, and none of them may put a row into the list check_rows
    # handed back: a row put in that way was never registered and no id rule
    # ever saw it. run_selftest takes its rows from whichever of the other two
    # ran, so a call anywhere in the expression it assigns from counts. A
    # function any of them hands the list to, such as register_catalog_row,
    # which reads it to compare with the catalog, is held to the same rule,
    # and so is a function that one hands it on to.
    def puts_in(node, names):
        for sub in ast.walk(node):
            if (isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
                    and sub.func.attr in ("append", "extend", "insert")
                    and getattr(sub.func.value, "id", None) in names):
                yield sub.lineno
            targets = (sub.targets if isinstance(sub, ast.Assign)
                       else [sub.target] if isinstance(sub, ast.AugAssign) else [])
            for target in targets:
                if (isinstance(sub, ast.AugAssign) and getattr(target, "id", None) in names
                        or isinstance(target, ast.Subscript)
                        and getattr(target.value, "id", None) in names):
                    yield sub.lineno

    def handed(node, names):
        for sub in ast.walk(node):
            callee = funcs.get(getattr(sub.func, "id", None)) if isinstance(sub, ast.Call) else None
            if not callee:
                continue
            params = [arg.arg for arg in callee.args.args]
            given = {params[at] for at, arg in enumerate(sub.args)
                     if at < len(params) and getattr(arg, "id", None) in names}
            given |= {kw.arg for kw in sub.keywords if getattr(kw.value, "id", None) in names}
            if given:
                yield callee.name, frozenset(given)

    reaches = s.callers_of("check_rows")
    handers = ("check_rows", "live_checks", "_live_in_parallel")
    holders = []
    for named in ("run_selftest", "live_checks", "_live_in_parallel"):
        node = funcs.get(named)
        if not node:
            forked.append(f"{named} is gone, so a tier this holds together is not here")
            continue
        if named not in reaches:
            forked.append(f"{named} does not reach check_rows")
        held = {target.elts[0].id for sub in ast.walk(node)
                if isinstance(sub, ast.Assign)
                and any(isinstance(part, ast.Call)
                        and getattr(part.func, "id", None) in handers
                        for part in ast.walk(sub.value))
                for target in sub.targets
                if isinstance(target, ast.Tuple) and target.elts
                and isinstance(target.elts[0], ast.Name)}
        if not held:
            forked.append(f"{named} does not take a register back with its rows")
        holders.append((named, frozenset(held)))
    scanned, reached = set(), []
    while holders:
        named, held = holders.pop()
        if (named, held) in scanned:
            continue
        scanned.add((named, held))
        for line in puts_in(funcs[named], held):
            forked.append(f"{named} puts a row in without registering it, at line {line}")
        for callee, given in handed(funcs[named], held):
            reached.append(callee)
            holders.append((callee, given))
    if "register_catalog_row" not in reached:
        forked.append("register_catalog_row is not handed the rows by any tier, so the scan "
                      "that holds it to registering cannot reach it")
