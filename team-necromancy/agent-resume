def classify_passthrough(passthrough):
    """(selector, forwarded) for the tokens argparse did not consume.

    Position stops mattering. check_passthrough has already established that every
    dash token here is one the table knows, so the walk can ask the table which of
    them take a value; whatever is left over is a name. That makes
    `NAME --model x`, `--model x NAME` and `--stop NAME` the same command.

    An explicit `--` ends classification: everything after it reaches claude
    untouched, which is how a prompt, or a value that begins with a dash, gets
    through without being read as ours.
    """
    cut = passthrough.index("--") if "--" in passthrough else len(passthrough)
    head, tail = passthrough[:cut], passthrough[cut:]
    bare, forwarded, skip = [], [], False
    for token in head:
        if skip:
            forwarded.append(token)
            skip = False
        elif token.startswith("-"):
            forwarded.append(token)
            spec = PASSTHROUGH_FLAGS.get(token.split("=", 1)[0])
            skip = bool(spec and spec.valued and "=" not in token)
        else:
            bare.append(token)
    if len(bare) > 1:
        die(f"{bare[0]} and {bare[1]} both name an agent; name one, and put anything "
            f"meant for the resumed session after --")
    return (bare[0] if bare else None), forwarded + tail


def forwarded_flags(passthrough):
    """The flags in a passthrough, without their values."""
    return [token.split("=", 1)[0] for token in passthrough
            if token.startswith("-") and token != "--"]


def check_selection_conflicts(args):
    """Refuse a whole-team selection combined with one conversation."""
    if args.team and (args.agent_id or args.resume):
        die(f"--team names every member of {args.team}, and "
            f"{'--agent-id' if args.agent_id else '--resume'} names one agent; pick one")


def check_identity_flags(args, passthrough):
    """Refuse a user-supplied id and name that disagree.

    The harness builds agentId as name@team, so the two are one fact. A caller
    who supplies both and contradicts them is describing an agent that cannot
    exist, and the name is what routes mail: the mailbox is inboxes/<name>.json,
    so the wrong name reads an address nobody writes to.

    A team-less --agent-id is caught too, since name_and_team reads it as the
    name it is: "--agent-id mate --agent-name other" names two agents whichever
    way the id is spelled.
    """
    named = None
    tokens = list(passthrough)
    for index, token in enumerate(tokens):
        if token == "--agent-name" and index + 1 < len(tokens):
            named = tokens[index + 1]
        elif token.startswith("--agent-name="):
            named = token.split("=", 1)[1]
    wearing = name_and_team(args.agent_id)[0]
    if named and wearing and wearing != named:
        die(f"--agent-id says {wearing!r} and --agent-name says {named!r}; they are one "
            f"fact, and the name is what addresses the mailbox. Pass one, or matching ones")


# Every flag that is a whole run by itself, keyed by the attribute argparse
# files it under, valued with the spellings a person can type for it. main
# dispatches down a ladder and returns on the first of these it reaches, so two
# on one command line means one of them was never going to run.
#
# What is not here is a modifier: --dry-run, --explain, --force, --yes, --all,
# --no-lead, --failed/--live/--list, and everything that shapes where a resumed
# agent comes up. Those change how a verb runs. A selector is not here either:
# it says which agents a run is about, not what the run does, so a selector
# beside a verb is an ordinary command line.
VERBS = {
    "selftest": ("--selftest",),
    "doctor": ("--doctor",),
    "census": ("--census",),
    "sides": ("--sides",),
    "promote": ("--promote",),
    "demote": ("--demote",),
    "mail_ledger": ("--mail-ledger",),
    "stop": ("--stop", "--terminate"),
    "cleanup": ("--cleanup", "--cleanup-sockets"),
    "install": ("--install",),
    "complete": ("--complete",),
    "poison": ("--poison",),
    "unpoison": ("--unpoison",),
}
# --help is not among them. Asking what the flags are is a question about the
# command line rather than a verb competing to be the run, so it is answered
# beside whatever else was typed instead of refusing to choose between them.


def say_help(parser):
    """The flags, then the notes, with a blank line between them.

    One place says it, because two callers ask: --help, and a run that named
    nothing to work on. They differ in what they return, not in what they say.
    """
    parser.print_help()
    print("\n" + __doc__)


def check_one_verb(args, argv):
    """Refuse a command line naming two verbs, and name the ones it named.

    Only one of them can run: --doctor --census ran the doctor and dropped the
    census, and --census --doctor also ran the doctor, because the ladder's
    order decided and said nothing. A flag that silently does nothing reads as
    having worked, which is why --into-team on a lead was made to refuse rather
    than be ignored.

    Named as the person spelled them, in the order they typed them: --stop and
    --terminate are one attribute and two spellings, and a refusal about a
    command line has to quote the command line.
    """
    typed = [token.split("=", 1)[0] for token in argv]
    given = []
    for dest, spellings in VERBS.items():
        if not getattr(args, dest, None):
            continue
        # Not every set attribute was typed: argparse also fills defaults, and
        # a flag we cannot find in argv is still named, at the end, by its
        # first spelling.
        at = [typed.index(opt) for opt in spellings if opt in typed]
        given.append((min(at) if at else len(typed),
                      typed[min(at)] if at else spellings[0]))
    named = [name for _at, name in sorted(given)]
    if len(named) > 1:
        said = ", ".join(named[:-1]) + f" and {named[-1]}"
        die(f"{said} are separate verbs, and a run does one of them; pick one")


def check_flag_scope(passthrough, count):
    """Refuse a flag that names one agent when the run covers several.

    Every member would be launched wearing the same identity, which is the state
    the tool exists to prevent rather than one it should produce on request.
    """
    if count <= 1:
        return
    named = sorted({f for f in forwarded_flags(passthrough)
                    if getattr(PASSTHROUGH_FLAGS.get(f), "scope", None) == ONE})
    if named:
        verb = "names" if len(named) == 1 else "name"
        die(f"{', '.join(named)} {verb} a single agent, but this run covers {count} of them; "
            f"resume one by name to use {named[0]}")


def check_flags_took_effect(passthrough, results, args):
    """Refuse to let a forwarded flag look applied when nothing was started.

    These configure a process at exec, so an agent that was already up kept the
    settings it was started with. Silently dropping them is how you conclude a
    resume ran at a different effort than it did.
    """
    if args.dry_run:
        return
    named = sorted(set(forwarded_flags(passthrough)))
    if not named or any(status in ("launched", "manual") for _, status in results):
        return
    verb = "takes" if len(named) == 1 else "take"
    if any(status in ("failed", "skipped") for _, status in results):
        # The run has already said why nothing started. Adding "they were all
        # already running" would be false, and "--force to start a second copy"
        # is the wrong advice for something that failed.
        warn(f"{', '.join(named)} never applied: nothing was started")
        return
    die(f"{', '.join(named)} only {verb} effect on a process that is started, and nothing "
        f"was started: every agent named was already running. Stop it first (--stop), "
        f"or pass --force to start a second copy.")


def name_and_team(agent_id):
    """Return the name and team components of an agent ID.

    `mate` returns (`mate`, None), `@team` returns (None, `team`), and `mate@`
    returns (`mate`, None). None represents an unavailable component. Callers
    apply their own requirements: doctor needs both values, promotion can infer
    the team, and reports display the available identity.
    """
    name, _, team = (agent_id or "").partition("@")
    return name or None, team or None


def agent_id_of(name, team):
    """Return the canonical `name@team` agent ID.

    Launch arguments, roster entries, and reports all use this formatter. Callers
    validate the two components before requesting the combined ID.
    """
    return f"{name}@{team}"


def implicit_team_block(team):
    """Return the eight-hex session prefix from an implicit team name.

    Plain leads name lazy teams `session-` plus the first eight hex characters
    of the live internal session ID. `session-a52cb2af` returns `a52cb2af`;
    explicit names and extended strings return None. The prefix narrows a search
    and can match several sessions, so callers corroborate the result.
    """
    minted = re.fullmatch(r"session-([0-9a-f]{8})", team or "")
    return minted.group(1) if minted else None


def agent_colour(agent_id, member=None):
    """Return the roster color, falling back to the lead's spawn record.

    Completion and abort reports use this answer so an identity keeps one color.
    """
    colour = (member or {}).get("color") or RESOLVER.spawn_payload(agent_id).get("color")
    return colour or ""


def paint(text, colour):
    """`text` in the agent's colour, or unchanged when colour is off."""
    ansi = "" if NO_COLOR else COLOR_ANSI.get(colour or "", "")
    return f"\033[{ansi}m{text}\033[0m" if ansi else text


class RenderedLine(str):
    """A report line already aligned and wrapped by its row renderer."""


def render_agent_row(pid, agent_id, description, colour="", indent="  ",
                     agent_width=None, width=None):
    """One aligned process/agent/title row, wrapped through fill()."""
    process = f"{pid:<8} " if pid is not None else " " * 9
    agent_width = agent_width or len(agent_id)
    identity = f"{agent_id:<{agent_width}}"
    raw = f"{indent}{process}{identity}  {description}"
    rendered = fill(raw, width=width)
    return RenderedLine(rendered.replace(identity, paint(identity, colour), 1))


def render_agent_rows(rows, indent="  ", width=None):
    """Aligned process/agent/title rows. The one renderer for every report."""
    rows = list(rows)
    agent_width = max((len(agent_id) for _pid, agent_id, _desc, _colour in rows),
                      default=0)
    return [render_agent_row(pid, agent_id, description, colour, indent,
                             agent_width, width)
            for pid, agent_id, description, colour in rows]


def running_agents(targets, table):
    """[(pid, agent_id, description, colour)] for the agents named by `targets`.

    `targets` is a list of agent ids. The description says what the process is
    actually doing, taken from its own transcript rather than the roster, so the
    listing shown before a kill describes the conversation about to be ended.
    """
    found = []
    for agent_id in targets:
        runtime = RESOLVER.agent_runtime(agent_id, table)
        for process in runtime["other_processes"]:
            title = bounded_title(
                (process["transcript"] or {}).get("title"), ABORT_TITLE)
            found.append((process["pid"], agent_id, title or "(no title)",
                          agent_colour(agent_id)))
    return found


def some_of(names, most=6):
    """`names` for a sentence, bounded, saying how many it left out."""
    names = list(names)
    if len(names) <= most:
        return ", ".join(names)
    return ", ".join(names[:most]) + f", and {len(names) - most} more"


def stop_targets(args, table):
    """What --stop was pointed at, as [(pid, label, description, colour)].

    One resolution, three shapes of argument: a team stops every member, an agent
    stops that agent wherever it runs, and a session stops whoever holds that
    transcript. The last is not an agent question, so it is answered from the
    transcript rather than by inventing an id for it.

    A miss stops the run here rather than downstream, because this is where the
    difference between the misses is still known. "nothing running for that"
    covered a team that does not exist, a team that lists nobody and a team
    whose members are all dead, and a reader had no way to tell which they
    were looking at. Exit code is unchanged: die's 1 is what returning no
    targets already produced.
    """
    if args.team:
        if not RESOLVER.has_roster(args.team):
            die(f"no team config at {RESOLVER.roster_path(args.team)}")
        members = (RESOLVER.roster_of(args.team) or {}).get("members", [])
        listed = [m["agentId"] for m in members if m.get("agentId")]
        running = running_agents(listed, table)
        if not running:
            die(f"nothing running for {args.team}: its roster lists no members"
                if not listed else
                f"nothing running for {args.team}: none of its {len(listed)} listed "
                f"member(s) is running ({some_of(listed)})")
        return running
    if not (args.agent_id or args.resume):
        die("--stop needs an agent, a session or a team to stop")

    if args.agent_id:
        running = running_agents([args.agent_id], table)
        if not running:
            die(f"agent id {args.agent_id} has zero live processes")
        return running
    held = (RESOLVER.runtime(table)["transcripts"].get(args.resume, {}).get("others", [])
            if args.resume else [])
    if not held:
        die(f"nothing running for {args.resume}: no live process holds that transcript")
    title = bounded_title((held[0].get("transcript") or {}).get("title"),
                          ABORT_TITLE)
    return [(process["pid"], args.resume[:8], title or "(no title)", "")
            for process in held]


def abort_agents(running, assume_yes=False, dry=False):
    """Kill these processes, after showing what each one is working on.

    Ending a conversation cannot be undone, so the listing comes first and
    describes every process by its own transcript. Returns how many stopped.

    A dry run lists them and ends nothing. It asks nothing either: there is no
    consent to take when the answer changes nothing, and a prompt that killed
    on y would make --dry-run the flag that decides whether the question is
    real. kill_holder does the same for the holder a move takes over.
    """
    if not running:
        print("nothing running for that")
        return 0
    step(dry, f"would abort {len(running)} process(es):",
         f"about to abort {len(running)} process(es):", indent="")
    for line in render_agent_rows(running):
        print(line)
    if dry:
        print(fill(f"  a dry run ends nothing, so "
                   f"{'it is' if len(running) == 1 else 'they are'} still running"))
        return 0
    if not assume_yes:
        try:
            answer = input("abort these? [y/N] ").strip().lower()
        except EOFError:
            answer = ""
        if answer != "y":
            print("left alone")
            return 0
    killed = 0
    for pid, agent_id, _desc, _colour in running:
        gone, why = stopped(pid)
        if gone:
            killed += 1
            continue
        warn(f"pid {pid} ({agent_id}) did not stop: {why}")
    print(f"aborted {killed} of {len(running)}")
    return killed


def stopped(pid):
    """Send the default termination signal and report process exit.

    Poll up to ten times at 150 ms intervals so a healthy Claude process can
    complete graceful shutdown. All production callers use this wait and apply
    their own report wording. Test fixtures use immediate cleanup because they
    model temporary processes rather than user sessions.
    """
    sent = subprocess.run(["kill", str(pid)], capture_output=True)
    for _ in range(10):
        if not RESOLVER.pid_alive(pid):
            break
        time.sleep(0.15)
    if sent.returncode == 0 and not RESOLVER.pid_alive(pid):
        return True, ""
    return False, (sent.stderr or b"").decode().strip() or "still running"


def read_one_key():
    """One keypress, raw, or None when there is no terminal to read from."""
    if not sys.stdin.isatty():
        return None
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        # os.read returns the requested byte directly. sys.stdin.read uses a
        # buffered text wrapper whose fill behavior can block a one-key prompt.
        data = os.read(fd, 1)
        return data.decode("utf-8", "replace") if data else None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def confirm_attach(targets, table, socket):
    """Ask before opening the swarm. Returns True to attach.

    The run has just printed what it did, and attaching replaces that with a
    tmux client, so the summary is unreadable the moment it succeeds. Stopping
    here is what makes the output worth printing.
    """
    if not sys.stdin.isatty():
        # Downstream terminal checks decide attachment for a noninteractive run.
        return True
    # Several swarm servers can coexist, so the prompt names the target socket.
    print(f"Press any key to attach to {socket} ({TMUX_SESSION}), "
          f"Ctrl-C to skip attaching, Ctrl-X to abort the running process(es)")
    key = read_one_key()
    if key is None:
        return True
    if key == "\x03":          # Ctrl-C
        print("skipped attaching")
        return False
    if key == "\x18":          # Ctrl-X
        print()
        abort_agents(running_agents(targets, table))
        return False
    return True


def check_passthrough(passthrough, parser):
    """Report unknown flags with prefix or similarity suggestions.

    Strict prefixes are checked before similarity. For example, `--as` prefixes
    `--as-agent` even though the unrelated `--betas` can receive a higher string
    similarity score. Shared prefixes list every match: `--into` names both
    `--into-session` and `--into-team`.

    The similarity search combines tool flags and forwarded Claude flags so
    `--team-nam` resolves to `--team-name` instead of the shorter `--team`.
    """
    known = set(PASSTHROUGH_FLAGS)  # the table's keys are the allowlist
    ours = {opt for action in parser._actions for opt in action.option_strings}
    cut = passthrough.index("--") if "--" in passthrough else len(passthrough)
    for token in passthrough[:cut]:
        if not token.startswith("-") or token == "--":
            continue
        flag = token.split("=", 1)[0]
        if flag in known:
            continue
        starts = sorted(opt for opt in ours if opt.startswith(flag) and opt != flag)
        near = starts or difflib.get_close_matches(
            flag, sorted(known | ours), n=1, cutoff=0.7)
        hint = (f"; did you mean {near[0]}?" if len(near) == 1 else
                f"; did you mean one of {some_of(near)}?" if near else "")
        die(f"unknown flag {flag}{hint}\n"
            f"  flags for the resumed session must be one of: {', '.join(sorted(known))}")


def step(dry, would, did, indent="  "):
    """Report an action once, in whichever tense actually applies.

    Both strings sit at the call site, so a preview line always has a real
    counterpart and a real run prints the same set of steps a dry run promised.
    """
    print(fill(f"{indent}{would if dry else did}"))


REPORT_MAX_WIDTH = 140
REPORT_LABEL_WIDTH = 9
WRAP_ARROW = "↳ "


def without_wrap_arrows(text):
    """Rendered text with continuation markers removed, for semantic checks."""
    return "\n".join(re.sub(rf"^(\s*){re.escape(WRAP_ARROW)}", r"\1", line)
                     for line in str(text).splitlines())


def term_width():
    """Columns to wrap output to: the terminal's, at most 140, at least 40.

    140 uses substantially more of a wide terminal while keeping prose within
    an easy scan. A narrower terminal wraps sooner; below 40 a wrap would break
    more lines than it saves, so that is the floor.
    """
    return max(40, min(shutil.get_terminal_size((REPORT_MAX_WIDTH, 24)).columns,
                       REPORT_MAX_WIDTH))


def fill(text, width=None, offset=0, continuation_column=None,
         starts_as_continuation=False):
    """`text` wrapped at spaces for a terminal. Facts reflow, never shrink.

    Each input line wraps on its own, keeping its indent. A continuation
    starts with WRAP_ARROW under `continuation_column` when the caller declares
    one. Otherwise the existing report grammar is recognized: after a fixed
    label or aligned columns, after a `- ` bullet, or two spaces into plain
    prose. A token is never split, so an identifier stays whole and greppable;
    one wider than the terminal overflows rather than losing characters.
    `starts_as_continuation` puts the same marker on the first physical line,
    for a separate fact belonging to the row above. `offset` is room a prefix
    the caller prints (warn's tool name) takes out of the first line.
    """
    width = width or term_width()
    out = []
    for line in str(text).split("\n"):
        head = line[:len(line) - len(line.lstrip(" "))]
        columns = None if continuation_column is not None else re.match(
            r"^(.* {2,})(?=\S)", line)
        bullet = None if continuation_column is not None else re.match(r"^ *- ", line)
        if continuation_column is not None:
            if type(continuation_column) is not int or continuation_column < 0:
                raise ValueError("continuation_column must be a non-negative integer")
            lead = ""
            hang = " " * continuation_column
        elif columns and columns.group(1).strip():
            lead = columns.group(1)
            hang = " " * len(lead)
        elif bullet:
            lead = bullet.group(0)
            hang = " " * len(lead)
        else:
            lead = ""
            hang = " " * (len(head) + 2)
        continuation = hang + WRAP_ARROW
        pad = " " * offset if not out else ""
        initial = continuation if starts_as_continuation else head
        got = textwrap.wrap(line.lstrip(" "), width=width,
                            initial_indent=pad + initial,
                            subsequent_indent=continuation,
                            break_long_words=False, break_on_hyphens=False)
        if len(got) > 1 and lead.strip() and got[0].strip() == lead.strip():
            # A label on its own line looks like a missing value. Keep the label
            # and overflowing value together, and remove the continuation marker
            # that belonged to the discarded line break.
            following = got[1].lstrip(" ").removeprefix(WRAP_ARROW)
            got[:2] = [pad + lead + following]
        tail = got[-1].strip().removeprefix(WRAP_ARROW) if got else ""
        if len(got) > 1 and len(tail.split()) == 1:
            # A single word alone on the last line reads as an accident;
            # pull a companion down with it, when one can come and the line
            # above keeps more than its label.
            body, _, last = got[-2].rpartition(" ")
            widowed = f"{continuation}{last} {tail}"
            if last and len(body.split()) > 1 and len(widowed) <= width:
                got[-2:] = [body.rstrip(), widowed]
        out.extend([got[0][len(pad):], *got[1:]] if got else [""])
    return "\n".join(out)


def render_labeled_row(label, value, trailer=None, width=None,
                       label_width=REPORT_LABEL_WIDTH):
    """One explicit label/value row, with an optional trailing fact."""
    if len(label) > label_width:
        raise ValueError(f"label {label!r} is wider than its {label_width}-column field")
    width = width or term_width()
    prefix = f"{label:<{label_width}}"
    lines = fill(prefix + str(value), width=width,
                 continuation_column=len(prefix)).splitlines()
    if trailer is None:
        return RenderedLine("\n".join(lines))
    trailer = " ".join(str(trailer).split())
    suffix = " " + trailer
    if lines and len(lines[-1]) + len(suffix) <= width:
        lines[-1] += suffix
    else:
        lines.extend(fill(
            trailer, width=width, continuation_column=len(prefix),
            starts_as_continuation=True).splitlines())
    return RenderedLine("\n".join(lines))


class HelpLayout(argparse.RawDescriptionHelpFormatter):
    """--help laid out the way the rest of the tool prints.

    Two things the default does not. It wraps to the real terminal, so at a
    wide one every flag's help is one long line and the group headings stop
    standing out; this uses the same width everything else here does. And it
    reflows the description, which would fold the selector table into a
    paragraph; the raw base keeps the table's columns.

    The placement section is subordinate to selection, and the two conversion
    arguments are subordinate to the operation they modify. argparse has no
    nested groups or dependent options, so those two relationships are shown
    by indentation here rather than copied into hand-written help text.
    """

    SUBSECTION = "where and as what it comes up"
    DEPENDENT = {"--as-agent", "--unwrap", "--into-session"}

    def __init__(self, prog, **kw):
        super().__init__(prog, width=term_width(), **kw)

    def start_section(self, heading):
        super().start_section(f"  {heading}" if heading == self.SUBSECTION else heading)

    def _split_lines(self, text, width):
        """argparse help continuations use the report-wide wrap marker too."""
        text = self._whitespace_matcher.sub(" ", text).strip()
        return textwrap.wrap(text, width, subsequent_indent=WRAP_ARROW,
                             break_long_words=False, break_on_hyphens=False)

    def _format_action_invocation(self, action):
        rendered = super()._format_action_invocation(action)
        if any(option in self.DEPENDENT for option in action.option_strings):
            return "  " + rendered
        return rendered


def clip(text, width):
    """`text` cut to fit `width`, at a space, ending in ... when anything went.

    For a column that cannot reflow. A hard slice ends mid-word and reads as
    a damaged value rather than a shortened one, so the cut lands on a word
    boundary and the ... is what says more was written. A single token longer
    than the column has no boundary to land on and is cut where it must be;
    the ... says that too.
    """
    text = " ".join(str(text or "").split())
    if len(text) <= width:
        return text
    room = max(width - 3, 1)
    # One character past the cut, so a cut that already lands on a space keeps
    # the last whole word instead of dropping it.
    ahead = text[:room + 1]
    head = ahead.rsplit(" ", 1)[0] if " " in ahead[1:] else text[:room]
    return head.rstrip() + "..."


def wrap_command(command, label, hang, paste=False, width=None):
    """One command as physical lines: `label`, then arguments, broken only
    between them - or inside one at single spaces when it alone cannot fit
    and the line is a record rather than something to paste. A paste form
    takes the argv list, breaks only between arguments and ends each broken
    line in a backslash, so the block pastes back as the same command.
    Either way, replacing each newline and its indent with one space
    restores the exact string: reflowed, never reworded.
    """
    width = width or term_width()
    if isinstance(command, (list, tuple)):
        tokens = [shlex.quote(c) for c in command]
    else:
        tokens = command.split(" ")  # split(" ") keeps runs of spaces exact
    marker = " \\" if paste else ""
    lines, chunk, prefix = [], [], label
    for token in tokens:
        trial = " ".join(chunk + [token])
        if chunk and len(prefix) + len(trial) + len(marker) > width:
            lines.append(prefix + " ".join(chunk) + marker)
            prefix, chunk = hang, [token]
        else:
            chunk.append(token)
    lines.append(prefix + " ".join(chunk))
    return "\n".join(lines)


def tint(text, sgr):
    """`text` in an SGR colour when a person is looking, plain otherwise.

    Plain when stdout is not a terminal, when --no-color or the NO_COLOR
    convention asked for plain, and always for the words themselves: colour
    only ever restates what the text already says, so nothing is lost with
    it off.
    """
    if not sgr or NO_COLOR or not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{sgr}m{text}\033[0m"


def warn(msg):
    sys.stdout.flush()  # keep warnings in order with the report block when piped
    print(f"{TOOL}: {fill(msg, offset=len(TOOL) + 2)}", file=sys.stderr)
    sys.stderr.flush()


class Refusal(BaseException):
    """The run refused, and what it refused with.

    BaseException rather than Exception, which is the one property sys.exit had
    here and is worth keeping: a refusal is not a fault for an `except
    Exception` around some call to handle, and library code that catches
    broadly must not swallow one.

    The reason travels on the signal. It is still written to stderr at the
    point of refusal, so a run that refuses part way through a team still says
    so beside that member rather than at the end, but every caller that treats
    a refusal as an answer now reads `said` off the exception instead of
    capturing a stream and pairing the two up by hand.

    What may not catch this is as much the point as what may. audited() must
    not: a refusal has to pass through it so the needs audit never judges a
    verb that did not finish, which is why the entry point converts one and
    nothing between here and there does.
    """

    def __init__(self, said, code=1):
        super().__init__(said)
        self.said = said
        self.code = code


def die(msg, code=1):
    warn(msg)
    raise Refusal(msg, code)


def iso_ms(value):
    if not value:
        return 0
    try:
        return int(datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return 0


def ms_str(ts):
    if not ts:
        return "-"
    return datetime.fromtimestamp(ts / 1000).strftime("%Y-%m-%d %H:%M:%S")


def said_when(iso):
    """A stored ISO timestamp the way the ledger prints time, or itself unparsed.

    One clock for every report: the inbox files store 2026-08-06T13:33:30.168Z
    and the ledger prints local wall time, and a reader comparing the two
    should not need to convert timezones in their head.
    """
    return ms_str(iso_ms(iso)) if iso_ms(iso) else str(iso)


@contextlib.contextmanager
def capturing(stream, into=None):
    """Take what this process writes to one stream instead of letting it out.

    stream is "out" or "err". The buffer comes back whether or not the caller
    reads it: a caller that only wants quiet ignores it, and one that asserts
    on what was said reads getvalue(). `into` writes into a buffer the caller
    already holds, which is what the few places filling one across more than
    one block need.

    Both streams at once is two of these, so where each stream goes is written
    where it is chosen rather than folded into a mode, and two streams sharing
    one buffer says so by passing the same one to both.

    Nothing here catches anything. A call that refuses inside a capture exits
    through SystemExit with its reason in this buffer, and whether that was the
    answer or the fault is the caller's to say.
    """
    if stream not in ("out", "err"):
        raise ValueError(f"capturing takes 'out' or 'err', not {stream!r}")
    buffer = io.StringIO() if into is None else into
    redirect = (contextlib.redirect_stdout if stream == "out"
                else contextlib.redirect_stderr)
    with redirect(buffer):
        yield buffer


STAGING = ".reaping-"


def staged_path(path):
    """Where this process puts something while it is removing it.

    One convention for the whole file, the one remove_if_cruft has always
    used: the name it had, plus the pid doing the removing. A crash between
    the rename and the delete leaves the copy under a name the team sweep
    still walks as an ordinary directory, so it is kept while anything in it
    can be resurrected and removed once nothing can.
    """
    return path.with_name(f"{path.name}{STAGING}{os.getpid()}")


def unstaged(name):
    """The name a staged copy came from.

    A read taken before a cut and a read taken after it are compared entry
    for entry, so the entries have to answer under one name.
    """
    return re.sub(re.escape(STAGING) + r"\d+$", "", name)


