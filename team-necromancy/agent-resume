@unit(('conversion-proves-inverse', 'a conversion proves its inverse before it acts'))
def _check_conversion_proves_inverse(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "proj" / "PARENT" / "subagents"
        sub.mkdir(parents=True)

        rows = [
            {"parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
             "agentId": "t1", "type": "user", "uuid": "cv-root",
             "message": {"role": "user", "content": "do the thing"}},
            {"parentUuid": "cv-root", "isSidechain": True, "sessionId": "PARENT",
             "agentId": "t1", "type": "assistant", "uuid": "cv-2",
             "message": {"role": "assistant", "content": [{"type": "text", "text": "ok"}]}},
        ]
        regular = sub / "agent-t1.jsonl"
        regular_bytes = "".join(fixture_line(r) + "\n" for r in rows)
        regular.write_text(regular_bytes)
        (sub / "agent-t1.meta.json").write_text('{"agentType":"x","name":"t"}')
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir = Path(td)
        faults = []

        def convert(source, direction, **kwargs):
            """Give this private-parser fixture the Resolver inputs it needs."""
            source = Path(source)
            if direction == "promote" and "grammar" not in kwargs:
                grammar, detail, root = eng._side_grammar(source)
                if grammar == SIDE_CLASS_UNCLASSIFIABLE:
                    receipt = eng._receipt_carried_by(source)
                    if receipt:
                        grammar = receipt["grammar"]
                        detail = (json.loads(receipt["ref"])
                                  if receipt.get("ref") else root)
                        root = receipt["root"]
                kwargs["grammar"] = (grammar, detail, root)
            if direction == "demote":
                kwargs.setdefault("projects_dir", eng._projects_dir)
                if "parent_uuids" not in kwargs:
                    receipt = eng._receipt_carried_by(source)
                    ref = {}
                    if receipt and receipt.get("ref"):
                        with contextlib.suppress(ValueError):
                            ref = json.loads(receipt["ref"])
                    parent_path = (source.parent / f"{ref['parentSessionId']}.jsonl"
                                   if ref.get("parentSessionId") else None)
                    parent = (eng._transcript_snapshot(parent_path)
                              if parent_path else None)
                    kwargs["parent_uuids"] = parent["uuids"] if parent else None
            return eng._rewriter.conversion_plan(source, direction, **kwargs)

        unsupported = Path(td) / "proj" / "UNSUPPORTED.jsonl"
        unsupported.write_text(
            fixture_line({"parentUuid": None, "sessionId": "UNSUPPORTED",
                          "type": "user", "uuid": "unsupported-root"}) + "\n" +
            fixture_line({"type": RECEIPT_RECORD,
                          "receipt": fixture_receipt(grammar="obsolete",
                                                     dest_stem="UNSUPPORTED",
                                                     root="unsupported-root")}) + "\n")
        refused = convert(unsupported, "demote", into="PARENT")
        refusal = " ".join(refused["objections"])
        if refused["proved"] or "unsupported conversion grammar" not in refusal:
            faults.append("an unsupported receipt grammar was accepted")
        elif not all(repr(grammar) in refusal for grammar in SIDE_GRAMMARS):
            faults.append("the receipt grammar refusal omitted an accepted value")
        plan = convert(
            regular, "promote", identity=("t", "ORIGINAL-TEAM"))
        if plan["objections"] or not plan["proved"]:
            faults.append(f"regular: {plan['objections'] or 'unproved'}")
        else:
            body = "\n".join(plan["lines"])
            if '"isSidechain":true' in body or '"sessionId":"PARENT"' in body.rsplit("\n", 1)[0]:
                faults.append("regular promote left side fields")
            if not plan["lines"][-1].startswith('{"receipt":'):
                faults.append("regular promote carries no receipt as its last line")
            if not plan["lines"][-2].startswith('{"type":"last-prompt"'):
                faults.append("regular promote appended no trailer")
            if plan["dest_path"].stem != "cv-root":
                faults.append("the stem is not the chain root")
        # a born teammate: no isSidechain anywhere, harness trailers in place
        mate = Path(td) / "proj" / "MATE.jsonl"
        mate.write_text(
            fixture_line({"parentUuid": None, "sessionId": "MATE", "agentId": "m1",
                     "type": "user", "uuid": "mate-root"}) + "\n" +
            fixture_line({"type": "last-prompt", "lastPrompt": "hi",
                     "leafUuid": "mate-root", "sessionId": "MATE"}) + "\n" +
            fixture_line({"parentUuid": "mate-root", "sessionId": "MATE", "agentId": "m1",
                     "type": "assistant", "uuid": "mate-2"}) + "\n" +
            fixture_line({"type": "last-prompt", "lastPrompt": "hi again",
                     "leafUuid": "mate-2", "sessionId": "MATE"}) + "\n")
        dplan = convert(mate, "demote", into="PARENT", dest="m1")
        if dplan["objections"] or not dplan["proved"]:
            faults.append(f"demote: {dplan['objections'] or 'unproved'}")
        else:
            if any('"type":"last-prompt"' in line for line in dplan["lines"]):
                faults.append("demote left a trailer in the side file")
            if sum('"isSidechain":true' in line for line in dplan["lines"]) != 2:
                faults.append("demote did not sidechain every record")
            demote_receipt = TranscriptRewriter.carried_receipt(dplan["lines"])
            if (demote_receipt or {}).get("direction") != "demote":
                faults.append("a fresh demote wrote no demote receipt")
            else:
                demoted = dplan["dest_path"]
                demoted.parent.mkdir(parents=True, exist_ok=True)
                demoted.write_text("\n".join(dplan["lines"]) + "\n")
                promoted_back = convert(demoted, "promote")
                if promoted_back["objections"] or not promoted_back["proved"]:
                    faults.append(f"promote did not consume a demote receipt: "
                                  f"{promoted_back['objections'] or 'unproved'}")
                elif "\n".join(promoted_back["lines"]) + "\n" != mate.read_text():
                    faults.append("promote after demote did not restore the main transcript")
                elif TranscriptRewriter.carried_receipt(promoted_back["lines"]):
                    faults.append("promote left the consumed demote receipt behind")
        # The promoted file carries its own undo. Demoted with nothing stored
        # anywhere, it still knows where it came from, which is the whole point
        # of the record riding the bytes it describes.
        carried = Path(td) / "proj" / "cv-root.jsonl"
        carried.write_text("\n".join(plan["lines"]) + "\n")
        alone = convert(carried, "demote")
        if alone["objections"] or not alone["proved"]:
            faults.append(f"a carried receipt did not answer its own demote: "
                          f"{alone['objections'] or 'unproved'}")
        elif alone["dest_path"].name != "agent-t1.jsonl":
            faults.append(f"the carried receipt lost the task id: {alone['dest_path'].name}")
        elif "\n".join(alone["lines"]) + "\n" != regular_bytes:
            faults.append("a carried demote did not restore the original bytes")

        # --into-session names a parent other than the one it came from. That is
        # a new demote rather than an exact inverse: it consumes the promote
        # receipt and writes a demote receipt that can return to this main file.
        elsewhere = convert(carried, "demote", into="ELSEWHERE")
        if elsewhere["objections"] or not elsewhere["proved"]:
            faults.append(f"a demote into another parent refused: "
                          f"{elsewhere['objections'] or 'unproved'}")
        elif elsewhere["dest_path"].parent.parent.name != "ELSEWHERE":
            faults.append("a demote into another parent landed elsewhere")
        elif not any(RECEIPT_RECORD in line for line in elsewhere["lines"]):
            faults.append("a demote into another parent wrote no demote receipt")
        else:
            moved_side = elsewhere["dest_path"]
            moved_side.parent.mkdir(parents=True, exist_ok=True)
            moved_side.write_text("\n".join(elsewhere["lines"]) + "\n")
            returned = convert(moved_side, "promote")
            if returned["objections"] or not returned["proved"]:
                faults.append(f"promote did not consume the moved demote receipt: "
                              f"{returned['objections'] or 'unproved'}")
            elif "\n".join(returned["lines"]) + "\n" != carried.read_text():
                faults.append("the moved demote did not retain the prior promote receipt")
            retargeted = convert(
                moved_side, "promote", identity=("t", "CURRENT-TEAM"))
            if retargeted["objections"] or not retargeted["proved"]:
                faults.append(f"a promote onto the current parent team refused: "
                              f"{retargeted['objections'] or 'unproved'}")
            elif not retargeted["receipt"].get("_emitted"):
                faults.append("changing the promoted identity was mistaken for an exact undo")
            elif retargeted["receipt"].get("team") != "CURRENT-TEAM":
                faults.append("the new promote receipt kept the demote receipt's old team")

        # A fork's inherited prefix is resolved against the session its ref
        # names, not the directory it sits in, so a move is safe exactly when
        # the destination carries the referenced entry. Both answers, against
        # one specimen, or the refusal could pass by refusing everything.
        pref = sub / "agent-p2.jsonl"
        pref.write_text(fixture_line({"type": "fork-context-ref", "agentId": "p2",
                                 "parentSessionId": "PARENT",
                                 "parentLastUuid": "anchor-1",
                                 "contextLength": 3}) + "\n" +
                        fixture_line({"parentUuid": None, "isSidechain": True,
                                 "sessionId": "PARENT", "type": "user",
                                 "uuid": "p2-root",
                                 "message": {"role": "user", "content": "go"}}) + "\n")
        (sub / "agent-p2.meta.json").write_text('{"agentType":"fork","isFork":true}')
        (Path(td) / "proj" / "PARENT.jsonl").write_text(
            fixture_line({"parentUuid": None, "isSidechain": False,
                          "sessionId": "PARENT", "uuid": "parent-root",
                          "type": "user", "message": {"role": "user",
                          "content": "inherited user turn"}}) + "\n" +
            fixture_line({"parentUuid": "parent-root", "isSidechain": False,
                          "sessionId": "PARENT", "uuid": "anchor-1",
                          "type": "assistant", "message": {"role": "assistant",
                          "content": [{"type": "text", "text": "inherited reply"}]}}) + "\n")
        (Path(td) / "proj" / "HASIT.jsonl").write_text(
            fixture_line({"uuid": "anchor-1", "type": "assistant"}) + "\n")
        (Path(td) / "proj" / "LACKS.jsonl").write_text(
            fixture_line({"uuid": "not-it", "type": "assistant",
                          "message": {"role": "assistant", "content": [{
                              "type": "tool_use", "name": "fixture",
                              "input": {"uuid": "anchor-1"},
                          }]}}) + "\n")
        duplicate_path = Path(td) / "proj" / "DUPLICATE.jsonl"
        duplicate_path.write_text(
            fixture_line({"uuid": "anchor-1", "type": "user",
                          "parentUuid": None, "agentName": "first",
                          "teamName": "first-team", "timestamp": "2026-01-01T00:00:00Z"}) + "\n" +
            fixture_line({"uuid": "anchor-1", "type": "user",
                          "parentUuid": None, "agentName": "last",
                          "teamName": "last-team", "timestamp": "2026-01-02T00:00:00Z"}) + "\n" +
            fixture_line({"type": "last-prompt", "leafUuid": "anchor-1"}) + "\n")
        duplicate_snapshot = eng._transcript_snapshot(duplicate_path)
        if (not duplicate_snapshot or "anchor-1" not in duplicate_snapshot["uuids"]
                or "anchor-1" not in duplicate_snapshot["duplicate_uuids"]
                or duplicate_snapshot["start"] != ("last", "last-team", "anchor-1")):
            faults.append("top-level duplicate UUID semantics were not retained")
        if "transcript_carries_uuid" in s.funcs:
            faults.append("raw quoted UUID membership remains public")
        uuid_owners = s.callers_of("_record_uuid")
        if uuid_owners != {"_derive_transcript_snapshot", "_transcript_chain"}:
            faults.append(f"UUID classifier owners are {sorted(uuid_owners)}")
        pplan = convert(pref, "promote", identity=("p2", "T"))
        pdest = Path(td) / "proj" / "p2-root.jsonl"
        if pplan["objections"] or not pplan["proved"]:
            faults.append(f"fork-reference promote: {pplan['objections'] or 'unproved'}")
        else:
            pdest.write_text("\n".join(pplan["lines"]) + "\n")
            promoted = [json.loads(line) for line in pplan["lines"]]
            by_uuid = {rec.get("uuid"): rec for rec in promoted if rec.get("uuid")}
            if [rec.get("uuid") for rec in promoted[:2]] != ["parent-root", "anchor-1"]:
                faults.append("fork-reference promote did not copy the inherited parent chain first")
            if by_uuid.get("p2-root", {}).get("parentUuid") != "anchor-1":
                faults.append("fork-reference promote did not connect its root to the copied parent leaf")
            if any(rec.get("type") == "fork-context-ref" for rec in promoted):
                faults.append("fork-reference promote left the side-only context reference in a main file")
            back = convert(pdest, "demote", into="PARENT")
            if back["objections"] or not back["proved"] or \
                    "\n".join(back["lines"]) + "\n" != pref.read_text():
                faults.append("fork-reference demote did not remove the copied prefix and restore the ref")
        # The case the feature exists for: a genuinely new parent, which does
        # not hold the referenced entry and does not need to. The ref still
        # names PARENT and PARENT still holds it, so the prefix resolves and
        # the move proves.
        if pdest.exists() and not convert(
                pdest, "demote", into="LACKS")["proved"]:
            faults.append("a move to a genuinely new parent was refused")
        # The same session id in another project is not the file the fork loader
        # opens. Removing the local parent must therefore refuse even when a
        # global transcript search could find a convincing false match.
        local_parent = Path(td) / "proj" / "PARENT.jsonl"
        parent_bytes = local_parent.read_bytes()
        local_parent.unlink()
        other = Path(td) / "other"
        other.mkdir()
        (other / "PARENT.jsonl").write_text(
            fixture_line({"uuid": "anchor-1", "type": "assistant"}) + "\n")
        wrong_project = convert(pdest, "demote", into="HASIT")
        if wrong_project["proved"] or "no longer carries" not in "".join(
                wrong_project["objections"]):
            faults.append("a parent anchor from another project satisfied the fork ref")
        local_parent.write_bytes(parent_bytes)
        # A UUID quoted inside structured tool input is content, not a parent
        # record. The old raw membership test accepted this exact specimen.
        local_parent.write_bytes((Path(td) / "proj" / "LACKS.jsonl").read_bytes())
        nested_anchor = convert(pdest, "demote", into="HASIT")
        if nested_anchor["proved"] or "no longer carries" not in "".join(
                nested_anchor["objections"]):
            faults.append("a UUID nested in content satisfied the fork ref")
        local_parent.write_bytes(parent_bytes)
        # And the case that is really broken: the session the ref names has
        # lost the entry, so the prefix resolves nowhere wherever it is moved.
        orphan = sub / "agent-p3.jsonl"
        orphan.write_text(fixture_line({"type": "fork-context-ref", "agentId": "p3",
                                   "parentSessionId": "LACKS",
                                   "parentLastUuid": "anchor-1",
                                   "contextLength": 3}) + "\n" +
                          fixture_line({"parentUuid": None, "isSidechain": True,
                                   "sessionId": "PARENT", "type": "user",
                                   "uuid": "p3-root",
                                   "message": {"role": "user", "content": "go"}}) + "\n")
        (sub / "agent-p3.meta.json").write_text('{"agentType":"fork","isFork":true}')
        oplan = convert(orphan, "promote", identity=("p3", "T"))
        if oplan["proved"] or "does not carry anchor-1" not in "".join(
                oplan["objections"]):
            faults.append("a fork was promoted though the prefix it references is gone")

        # Claude Code can append any harness record after the promote. The
        # receipt remains active: demote finds it by scanning backward, consumes
        # it from the middle, and its inverse restores every later byte.
        grown = Path(td) / "proj" / "cv-grown.jsonl"
        grown_lines = list(plan["lines"]) + [
            fixture_line({"type": "mode", "mode": "acceptEdits",
                          "sessionId": "cv-root"}),
            fixture_line({"type": "permission-mode",
                          "permissionMode": "default", "sessionId": "cv-root"}),
            fixture_line({"parentUuid": "cv-2", "sessionId": "cv-root",
                          "type": "user", "uuid": "cv-3",
                          "message": {"role": "user", "content": "follow-up"}}),
            fixture_line({"type": "last-prompt", "lastPrompt": "follow-up",
                          "leafUuid": "cv-3", "sessionId": "cv-root"}),
            fixture_line({"parentUuid": "cv-3", "sessionId": "cv-root",
                          "type": "assistant", "uuid": "cv-4",
                          "message": {"role": "assistant", "content": [{
                              "type": "tool_use", "id": "toolu-grown",
                              "name": "Read", "input": {"file_path": "/tmp/x"}}]}}),
            fixture_line({"parentUuid": "cv-4", "sessionId": "cv-root",
                          "type": "progress", "uuid": "cv-progress",
                          "data": {"type": "tool_progress", "elapsedTimeSeconds": 1}}),
            fixture_line({"parentUuid": "cv-4", "sessionId": "cv-root",
                          "type": "user", "uuid": "cv-5",
                          "message": {"role": "user", "content": [{
                              "type": "tool_result", "tool_use_id": "toolu-grown",
                              "content": "result"}]}}),
            fixture_line({"parentUuid": "cv-5", "sessionId": "cv-root",
                          "type": "assistant", "uuid": "cv-6",
                          "message": {"role": "assistant", "content": [{
                              "type": "text", "text": "done"}]}}),
            fixture_line({"parentUuid": "cv-6", "sessionId": "cv-root",
                          "type": "system", "uuid": "cv-system",
                          "content": "runtime note"}),
            fixture_line({"parentUuid": "cv-system", "sessionId": "cv-root",
                          "type": "attachment", "uuid": "cv-attachment",
                          "attachment": {"type": "file", "filePath": "/tmp/x"}}),
            fixture_line({"type": "queue-operation", "operation": "enqueue",
                          "sessionId": "cv-root"}),
            fixture_line({"type": "file-history-snapshot", "snapshot": {},
                          "sessionId": "cv-root"}),
            fixture_line({"type": "ai-title", "title": "grown transcript",
                          "sessionId": "cv-root"}),
        ]
        grown.write_text("\n".join(grown_lines) + "\n")
        if eng._rewriter.terminal_receipt_in_file(grown) is not None:
            faults.append("a historical receipt was mistaken for the final action")
        if moved_side.exists() and eng._rewriter.terminal_receipt_in_file(moved_side) is None:
            faults.append("a receipt on the final line was not recognized as the final action")
        expected_carried = TranscriptRewriter.carried_receipt([
            eng._rewriter._receipt_line(plan["receipt"])])
        if eng._receipt_carried_by(grown) != immutable(expected_carried):
            faults.append("the file scanner did not find a receipt before appended records")
        after = convert(grown, "demote", into="PARENT", dest="t1")
        if after["objections"] or not after["proved"]:
            faults.append(f"a grown file did not demote through its middle receipt: "
                          f"{after['objections'] or 'unproved'}")
        elif any(RECEIPT_RECORD in line for line in after["lines"]):
            faults.append("the undo did not consume the last in-file receipt")

        # When several conversion records exist, only the last one controls the
        # demote. An older one is ordinary history and remains byte-exact.
        older = TranscriptRewriter.carried_receipt(plan["lines"])
        newest = dict(older)
        newest["parent"] = "SECOND"
        many_lines = list(plan["lines"]) + [
            fixture_line({"type": "mode", "mode": "plan"}),
            eng._rewriter._receipt_line(newest),
            fixture_line({"type": "permission-mode", "mode": "acceptEdits"}),
        ]
        many = Path(td) / "proj" / "cv-many.jsonl"
        many.write_text("\n".join(many_lines) + "\n")
        if eng._receipt_carried_by(many) != immutable(newest):
            faults.append("the file scanner did not select the last of several receipts")
        latest = convert(many, "demote")
        remaining = [TranscriptRewriter.carried_receipt(latest["lines"])] if latest.get("lines") else []
        if latest["objections"] or not latest["proved"]:
            faults.append(f"the last of several receipts did not prove its inverse: "
                          f"{latest['objections'] or 'unproved'}")
        elif latest["dest_path"].parent.parent.name != "SECOND":
            faults.append("a receipt before the last one chose the demote parent")
        elif remaining != [older]:
            faults.append("the demote consumed something other than the last receipt")

        # a line the codec cannot reproduce is a refusal, not a best effort
        wonky = sub / "agent-w1.jsonl"
        wonky.write_text('{"parentUuid": null, "isSidechain": true, '
                         '"uuid": "w-root", "n": 1.10}\n')
        wplan = convert(wonky, "promote")
        if wplan["proved"] or not any("reproduces" in o for o in wplan["objections"]):
            faults.append("an unstable line did not refuse")

        # A file the classifier refuses is refused, naming what was found
        # rather than guessing at a shape. There is no salvage path: the
        # transcripts that needed one are not produced any more.
        messy = sub / "agent-c1.jsonl"
        messy.write_text("".join(fixture_line(r) + "\n" for r in [
            {"parentUuid": "ghost-above", "isSidechain": True, "sessionId": "PARENT",
             "type": "user", "uuid": "mid-chain",
             "message": {"role": "user", "content": "no root in this file"}},
            {"parentUuid": "elsewhere", "isSidechain": True, "sessionId": "PARENT",
             "type": "assistant", "uuid": "stray-1"},
        ]))
        try:
            bare = convert(messy, "promote")
        except Exception as err:  # a crash is a failure, not a refusal
            bare = {"proved": True, "objections": [f"crashed: {err.__class__.__name__}"]}
        if bare["proved"] or not any("not convertible" in o for o in bare["objections"]):
            faults.append("an unclassifiable file did not refuse")
        check("conversion-proves-inverse", "a conversion proves its inverse before it acts", not faults,
              ", ".join(faults))

    s.eng = eng
    s.rows = rows
    return checked


@unit(
    ('promotion-shows-complete-human-wrappers',
     'promotion shows known human records while keeping their complete wrappers'),
    ('promotion-unwraps-human-wrappers',
     '--unwrap shows the inner human text instead of the persistence wrapper'),
    ('human-visibility-conversion-is-exact',
     'both visibility modes demote byte-exactly and remain stable across cycles'),
    ('human-visibility-recognition-is-strict',
     'visibility edits exclude unknown wrappers and non-human meta records'),
    ('promotion-last-prompt-is-human-text',
     'last-prompt uses the inner text of the latest known human wrapper'),
    ('unwrap-requires-promote', '--unwrap is refused without --promote'),
)
def _check_human_visibility_conversion(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    failures = collections.defaultdict(list)

    def convert(source, direction, **kwargs):
        """Give this private-parser fixture the Resolver inputs it needs."""
        source = Path(source)
        if direction == "promote" and "grammar" not in kwargs:
            grammar, detail, root = eng._side_grammar(source)
            if grammar == SIDE_CLASS_UNCLASSIFIABLE:
                receipt = eng._receipt_carried_by(source)
                if receipt:
                    grammar = receipt["grammar"]
                    detail = (json.loads(receipt["ref"])
                              if receipt.get("ref") else root)
                    root = receipt["root"]
            kwargs["grammar"] = (grammar, detail, root)
        if direction == "demote":
            kwargs.setdefault("projects_dir", eng._projects_dir)
            if "parent_uuids" not in kwargs:
                receipt = eng._receipt_carried_by(source)
                ref = {}
                if receipt and receipt.get("ref"):
                    with contextlib.suppress(ValueError):
                        ref = json.loads(receipt["ref"])
                parent_path = (source.parent / f"{ref['parentSessionId']}.jsonl"
                               if ref.get("parentSessionId") else None)
                parent = (eng._transcript_snapshot(parent_path)
                          if parent_path else None)
                kwargs["parent_uuids"] = parent["uuids"] if parent else None
        return eng._rewriter.conversion_plan(source, direction, **kwargs)

    def wrap(version, inner):
        prefix, suffix = HUMAN_MESSAGE_WRAPPERS[version]
        return f"{prefix}{inner}{suffix}"

    modern_inner = "modern human text\nwith a second line"
    legacy_inner = "older human text"
    modern = wrap("current", modern_inner)
    legacy = wrap("legacy", legacy_inner)
    unknown = f"{HUMAN_MESSAGE_PREFIX}unknown text\n\nAn unknown ending."
    untouched = {
        "unknown-wrapper", "coordinator", "peer", "task-notification", "hook",
        "image", "tool-result", "assistant-meta",
    }

    for label, unwrap_arg in (("complete", None), ("unwrapped", True)):
        with tempfile.TemporaryDirectory() as td:
            sub = Path(td) / label / "PARENT" / "subagents"
            sub.mkdir(parents=True)
            contents = [
                ("vh-modern", "user", modern, "human"),
                ("assistant-meta", "assistant", "assistant text", "human"),
                ("vh-legacy", "user", legacy, "human"),
                ("unknown-wrapper", "user", unknown, "human"),
                ("coordinator", "user", modern, "coordinator"),
                ("peer", "user", modern, "peer"),
                ("task-notification", "user", modern, "task-notification"),
                ("hook", "user", modern, "hook"),
                ("image", "user", [{"type": "image", "source": {"data": "AA=="}}],
                 "human"),
                ("tool-result", "user",
                 [{"type": "tool_result", "tool_use_id": "tool-1", "content": "ok"}],
                 "human"),
            ]
            rows, parent = [], None
            for uuid, record_type, content, origin in contents:
                role = "assistant" if record_type == "assistant" else "user"
                row = {
                    "parentUuid": parent, "isSidechain": True, "sessionId": "PARENT",
                    "agentId": "visibility-task", "type": record_type,
                    "message": {"role": role, "content": content}, "isMeta": True,
                    "uuid": uuid, "origin": {"kind": origin},
                }
                rows.append(row)
                parent = uuid
            side = sub / "agent-visibility-task.jsonl"
            original_lines = [fixture_line(row, spaced=index % 2 == 1)
                              for index, row in enumerate(rows)]
            original_bytes = "\n".join(original_lines) + "\n"
            side.write_text(original_bytes)
            (sub / "agent-visibility-task.meta.json").write_text(
                '{"agentType":"fork","name":"visibility"}')
            eng = Resolver(needs=Needs(maybe=set(NEED)))
            eng._projects_dir = Path(td)
            plan = convert(
                side, "promote", identity=("visibility", "TEAM"), unwrap=unwrap_arg)
            mode_id = ("promotion-unwraps-human-wrappers" if unwrap_arg
                       else "promotion-shows-complete-human-wrappers")
            if plan["objections"] or not plan["proved"]:
                failures[mode_id].append(str(plan["objections"] or "unproved"))
                failures["human-visibility-conversion-is-exact"].append(
                    f"{label} promotion did not prove")
                continue

            promoted = [json.loads(line) for line in plan["lines"]]
            by_uuid = {rec.get("uuid"): rec for rec in promoted if rec.get("uuid")}
            expected_contents = {
                "vh-modern": modern_inner if unwrap_arg else modern,
                "vh-legacy": legacy_inner if unwrap_arg else legacy,
            }
            for uuid, expected in expected_contents.items():
                got = by_uuid.get(uuid, {})
                if got.get("isMeta") is not False or (got.get("message") or {}).get(
                        "content") != expected:
                    failures[mode_id].append(f"{uuid} was not rendered in {label} mode")
            receipt = TranscriptRewriter.carried_receipt(plan["lines"]) or {}
            expected_edits = {
                "original_payloads": ([
                    ["current", modern_inner], ["legacy", legacy_inner]
                ] if unwrap_arg else []),
                "intervals": [
                    ["vh-modern", "vh-modern", [0] if unwrap_arg else []],
                    ["vh-legacy", "vh-legacy", [1] if unwrap_arg else []],
                ],
            }
            if (receipt.get("unwrapped") is not bool(unwrap_arg)
                    or receipt.get("visible_human_wrapper_edits") != expected_edits):
                failures[mode_id].append("the receipt does not describe both human edits")

            original_by_uuid = {row["uuid"]: row for row in rows}
            for uuid in untouched:
                got, before = by_uuid.get(uuid, {}), original_by_uuid[uuid]
                if (got.get("isMeta") != before.get("isMeta")
                        or got.get("message") != before.get("message")):
                    failures["human-visibility-recognition-is-strict"].append(
                        f"{label} changed {uuid}")

            trailers = [rec for rec in promoted if rec.get("type") == "last-prompt"]
            if len(trailers) != 1 or trailers[0].get("lastPrompt") != legacy_inner:
                failures["promotion-last-prompt-is-human-text"].append(
                    f"{label} stored {trailers!r}")

            promoted_bytes = "\n".join(plan["lines"]) + "\n"
            plan["dest_path"].write_text(promoted_bytes)
            back = convert(plan["dest_path"], "demote")
            if (back["objections"] or not back["proved"]
                    or "\n".join(back["lines"]) + "\n" != original_bytes):
                failures["human-visibility-conversion-is-exact"].append(
                    f"{label} did not restore the side bytes")

            again = convert(
                side, "promote", identity=("visibility", "TEAM"), unwrap=unwrap_arg)
            if (again["objections"] or not again["proved"]
                    or "\n".join(again["lines"]) + "\n" != promoted_bytes):
                failures["human-visibility-conversion-is-exact"].append(
                    f"{label} changed on a repeated promotion")

            moved = convert(
                plan["dest_path"], "demote", into="OTHER")
            if moved["objections"] or not moved["proved"]:
                failures["human-visibility-conversion-is-exact"].append(
                    f"{label} could not write a moved demote receipt")
            else:
                moved["dest_path"].parent.mkdir(parents=True, exist_ok=True)
                moved["dest_path"].write_text("\n".join(moved["lines"]) + "\n")
                returned = convert(moved["dest_path"], "promote")
                if (returned["objections"] or not returned["proved"]
                        or "\n".join(returned["lines"]) + "\n" != promoted_bytes):
                    failures["human-visibility-conversion-is-exact"].append(
                        f"{label} mode was not retained by the moved receipt")

    import subprocess as sp
    alone = sp.run([sys.executable, str(Path(__file__).resolve()), "--unwrap"],
                   capture_output=True, text=True, stdin=sp.DEVNULL, timeout=60)
    if alone.returncode != 1 or "--unwrap modifies --promote" not in alone.stderr:
        failures["unwrap-requires-promote"].append(
            f"exit {alone.returncode}, stderr {alone.stderr.strip()!r}")

    names = {
        'promotion_shows_complete_human_wrappers':
            'promotion shows known human records while keeping their complete wrappers',
        'promotion_unwraps_human_wrappers':
            '--unwrap shows the inner human text instead of the persistence wrapper',
        'human_visibility_conversion_is_exact':
            'both visibility modes demote byte-exactly and remain stable across cycles',
        'human_visibility_recognition_is_strict':
            'visibility edits exclude unknown wrappers and non-human meta records',
        'promotion_last_prompt_is_human_text':
            'last-prompt uses the inner text of the latest known human wrapper',
        'unwrap_requires_promote': '--unwrap is refused without --promote',
    }
    for underscored, name in names.items():
        cid = underscored.replace("_", "-")
        check(cid, name, not failures[cid], ", ".join(failures[cid]))
    return checked


@unit(
    ('nonexact-promotion-rescans-human-wrappers',
     'a new promotion merges carried human edits with newly eligible wrappers'),
    ('inherited-prefix-human-visibility',
     'both visibility modes include eligible records copied from inherited history'),
    ('last-prompt-rejects-nonhuman-origin',
     'last-prompt ignores coordinator and peer rows that use the user record type'),
    ('conversion-preserves-final-newline',
     'conversion writers preserve a transcript with no final newline byte-exactly'),
    ('inherited-only-last-prompt',
     'last-prompt can come from inherited human history when the side has none'),
    ('conversion-preserves-crlf',
     'promote and demote preserve CRLF separators and terminators byte-exactly'),
    ('malformed-newline-receipt-refused',
     'malformed or missing carried newline metadata is refused'),
    ('incomplete-receipt-schema-refused',
     'receipts missing current fields are rejected'),
    ('receipt-schema-version-required',
     'conversion receipts require the one supported schema version'),
    ('receipt-schema-has-no-field-defaults',
     'receipt fields are validated rather than inferred from omission'),
    ('complete-wrapper-edits-use-intervals',
     'complete-wrapper edits separated only by UUID-less records share one interval'),
    ('overlapping-wrapper-edit-intervals-refused',
     'wrapper edit intervals cannot claim one UUID twice'),
)
def _check_visibility_review_regressions(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    failures = collections.defaultdict(list)

    def convert(source, direction, **kwargs):
        """Give this private-parser fixture the Resolver inputs it needs."""
        source = Path(source)
        if direction == "promote" and "grammar" not in kwargs:
            grammar, detail, root = eng._side_grammar(source)
            if grammar == SIDE_CLASS_UNCLASSIFIABLE:
                receipt = eng._receipt_carried_by(source)
                if receipt:
                    grammar = receipt["grammar"]
                    detail = (json.loads(receipt["ref"])
                              if receipt.get("ref") else root)
                    root = receipt["root"]
            kwargs["grammar"] = (grammar, detail, root)
        if direction == "demote":
            kwargs.setdefault("projects_dir", eng._projects_dir)
            if "parent_uuids" not in kwargs:
                receipt = eng._receipt_carried_by(source)
                ref = {}
                if receipt and receipt.get("ref"):
                    with contextlib.suppress(ValueError):
                        ref = json.loads(receipt["ref"])
                parent_path = (source.parent / f"{ref['parentSessionId']}.jsonl"
                               if ref.get("parentSessionId") else None)
                parent = (eng._transcript_snapshot(parent_path)
                          if parent_path else None)
                kwargs["parent_uuids"] = parent["uuids"] if parent else None
        return eng._rewriter.conversion_plan(source, direction, **kwargs)

    def wrapper(inner):
        return _human_wrapper_content("current", inner)

    def records(plan):
        return [json.loads(line) for line in plan.get("lines") or []]

    def apply(operation, executor, cid):
        """Report an executor failure under its check and restore the selected Resolver."""
        current = globals()["RESOLVER"]
        globals()["RESOLVER"] = eng
        try:
            with capturing("out"), capturing("err"):
                executor(operation)
            return True
        except (Refusal, OSError, AssertionError, AttributeError, KeyError, TypeError, ValueError) as exc:
            failures[cid].append(f"{executor.__name__}: {type(exc).__name__}: {exc}")
            return False
        finally:
            globals()["RESOLVER"] = current

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "intervals" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        side = sub / "agent-intervals.jsonl"
        adjacent = []
        parent = None
        for at in range(3):
            if at == 1:
                adjacent.append(fixture_line({
                    "type": "permission-mode", "permissionMode": "default"}))
            uuid = f"interval-{at}"
            adjacent.append(fixture_line({
                "parentUuid": parent, "isSidechain": True, "sessionId": "PARENT",
                "type": "user", "uuid": uuid, "origin": {"kind": "human"},
                "isMeta": True, "message": {"role": "user",
                "content": wrapper(f"human {at}")},
            }))
            parent = uuid
        side.write_text("\n".join(adjacent) + "\n")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir = Path(td)
        plan = convert(
            side, "promote", identity=("intervals", "TEAM"))
        receipt = TranscriptRewriter.carried_receipt(plan.get("lines") or []) or {}
        expected = {
            "original_payloads": [],
            "intervals": [["interval-0", "interval-2", []]],
        }
        if (plan.get("objections") or not plan.get("proved")
                or receipt.get("visible_human_wrapper_edits") != expected
                or "visible_humans" in receipt or "visible_human_intervals" in receipt):
            failures["complete-wrapper-edits-use-intervals"].append(
                repr(receipt.get("visible_human_wrapper_edits")))
        overlapping = []
        for raw in plan.get("lines") or []:
            rec = json.loads(raw)
            if rec.get("type") == RECEIPT_RECORD:
                rec["receipt"]["visible_human_wrapper_edits"]["intervals"].append(
                    ["interval-1", "interval-2", []])
                raw = fixture_line(rec)
            overlapping.append(raw)
        plan["dest_path"].write_text("\n".join(overlapping) + "\n")
        overlap_plan = convert(plan["dest_path"], "demote")
        overlap_said = " ".join(overlap_plan.get("objections", []))
        if overlap_plan.get("proved") or "repeat uuid" not in overlap_said:
            failures["overlapping-wrapper-edit-intervals-refused"].append(
                repr(overlap_plan.get("objections")))

    # A carried receipt owns its old edits. A promotion that is not its exact
    # inverse also scans the current side and adds newly eligible records.
    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "project" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        old_inner, new_inner = "old human", "new human"
        side = sub / "agent-rescan.jsonl"
        side.write_text(fixture_line({
            "parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
            "type": "user", "uuid": "rescan-old", "origin": {"kind": "human"},
            "isMeta": True, "message": {"role": "user", "content": wrapper(old_inner)},
        }) + "\n")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir = Path(td)
        promoted = convert(
            side, "promote", identity=("owner", "TEAM"), unwrap=True)
        promoted["dest_path"].write_text(
            _jsonl_text(promoted["lines"], promoted["newline"]))
        moved = convert(
            promoted["dest_path"], "demote", into="OTHER")
        moved["dest_path"].parent.mkdir(parents=True, exist_ok=True)
        appended = fixture_line({
            "parentUuid": "rescan-old", "isSidechain": True, "sessionId": "OTHER",
            "type": "user", "uuid": "rescan-new", "origin": {"kind": "human"},
            "isMeta": True, "message": {"role": "user", "content": wrapper(new_inner)},
        })
        moved_lines = list(moved["lines"]) + [appended]
        moved["dest_path"].write_text(
            _jsonl_text(moved_lines, moved["newline"]))

        exact = convert(moved["dest_path"], "promote")
        exact_by_uuid = {rec.get("uuid"): rec for rec in records(exact)}
        if (exact["objections"] or not exact["proved"]
                or exact_by_uuid.get("rescan-old", {}).get("isMeta") is not False
                or exact_by_uuid.get("rescan-new", {}).get("isMeta") is not True):
            failures["nonexact-promotion-rescans-human-wrappers"].append(
                "an exact inverse did not limit itself to its recorded edit")

        renewed = convert(
            moved["dest_path"], "promote", identity=("new-owner", "TEAM"))
        renewed_by_uuid = {rec.get("uuid"): rec for rec in records(renewed)}
        renewed_receipt = TranscriptRewriter.carried_receipt(renewed.get("lines") or []) or {}
        expected_edits = {
            "original_payloads": [
                ["current", old_inner], ["current", new_inner]],
            "intervals": [["rescan-old", "rescan-new", [0, 1]]],
        }
        if (renewed["objections"] or not renewed["proved"]
                or renewed_receipt.get("unwrapped") is not True
                or renewed_receipt.get("visible_human_wrapper_edits") != expected_edits
                or (renewed_by_uuid.get("rescan-new", {}).get("message") or {}).get(
                    "content") != new_inner):
            failures["nonexact-promotion-rescans-human-wrappers"].append(
                f"a newer receipt did not merge the appended wrapper: "
                f"edits={renewed_receipt.get('visible_human_wrapper_edits')!r}, "
                f"objections={renewed.get('objections')!r}, proved={renewed.get('proved')!r}, "
                f"content={(renewed_by_uuid.get('rescan-new', {}).get('message') or {}).get('content')!r}")

        for field in ("direction", "grammar", "unwrapped",
                      "visible_human_wrapper_edits"):
            incomplete_lines = []
            for raw in moved_lines:
                rec = json.loads(raw)
                if rec.get("type") == RECEIPT_RECORD:
                    rec["receipt"].pop(field)
                    raw = fixture_line(rec)
                incomplete_lines.append(raw)
            incomplete = moved["dest_path"].with_name(f"agent-missing-{field}.jsonl")
            incomplete.write_text(_jsonl_text(
                incomplete_lines, {"line": "lf", "final": "lf"}))
            rejected = convert(
                incomplete, "promote", identity=("incomplete", "TEAM"))
            said = " ".join(rejected.get("objections", []))
            if rejected.get("proved") or f"missing {field}" not in said:
                failures["incomplete-receipt-schema-refused"].append(
                    f"accepted missing {field}: {rejected.get('objections')}")

        wrong_version_lines = []
        for raw in moved_lines:
            rec = json.loads(raw)
            if rec.get("type") == RECEIPT_RECORD:
                rec["receipt"]["schema_version"] = 0
                raw = fixture_line(rec)
            wrong_version_lines.append(raw)
        wrong_version = moved["dest_path"].with_name("agent-schema-zero.jsonl")
        wrong_version.write_text(_jsonl_text(
            wrong_version_lines, {"line": "lf", "final": "lf"}))
        rejected_version = convert(
            wrong_version, "promote", identity=("incomplete", "TEAM"))
        version_said = " ".join(rejected_version.get("objections", []))
        if rejected_version.get("proved") or "schema_version 0" not in version_said:
            failures["receipt-schema-version-required"].append(
                f"accepted schema 0: {rejected_version.get('objections')}")

    # A fork-reference promotion copies parent history before the side rows. The
    # visibility transform applies to both sets and demotion still restores only
    # the original side bytes.
    for label, unwrap_arg in (("complete", None), ("unwrapped", True)):
        with tempfile.TemporaryDirectory() as td:
            project = Path(td) / label
            sub = project / "PARENT" / "subagents"
            sub.mkdir(parents=True)
            inherited_inner = "inherited human"
            parent_rows = [
                {"parentUuid": None, "isSidechain": False, "sessionId": "PARENT",
                 "type": "user", "uuid": "prefix-human", "isMeta": True,
                 "origin": {"kind": "human"},
                 "message": {"role": "user", "content": wrapper(inherited_inner)}},
                {"parentUuid": "prefix-human", "isSidechain": False,
                 "sessionId": "PARENT", "type": "user", "uuid": "prefix-coordinator",
                 "isMeta": True, "origin": {"kind": "coordinator"},
                 "message": {"role": "user", "content": wrapper("coord")}},
                {"parentUuid": "prefix-coordinator", "isSidechain": False,
                 "sessionId": "PARENT", "type": "assistant", "uuid": "prefix-leaf"},
            ]
            (project / "PARENT.jsonl").write_text(
                "".join(fixture_line(row) + "\n" for row in parent_rows))
            side = sub / "agent-prefix.jsonl"
            original = (fixture_line({
                "type": "fork-context-ref", "agentId": "prefix",
                "parentSessionId": "PARENT", "parentLastUuid": "prefix-leaf",
                "contextLength": 3,
            }) + "\n" + fixture_line({
                "parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
                "agentId": "prefix", "type": "assistant", "uuid": "side-root",
                "message": {"role": "assistant", "content": "assistant-only side"},
            }) + "\n")
            side.write_text(original)
            (sub / "agent-prefix.meta.json").write_text(
                '{"agentType":"fork","isFork":true}')
            eng = Resolver(needs=Needs(maybe=set(NEED)))
            eng._projects_dir = Path(td)
            plan = convert(
                side, "promote", identity=("prefix", "TEAM"), unwrap=unwrap_arg)
            by_uuid = {rec.get("uuid"): rec for rec in records(plan)}
            human = by_uuid.get("prefix-human", {})
            coordinator = by_uuid.get("prefix-coordinator", {})
            expected = inherited_inner if unwrap_arg else wrapper(inherited_inner)
            receipt = TranscriptRewriter.carried_receipt(plan.get("lines") or []) or {}
            expected_edits = {
                "original_payloads": ([
                    ["current", inherited_inner]] if unwrap_arg else []),
                "intervals": [["prefix-human", "prefix-human",
                               [0] if unwrap_arg else []]],
            }
            trailers = [rec for rec in records(plan) if rec.get("type") == "last-prompt"]
            if len(trailers) != 1 or trailers[0].get("lastPrompt") != inherited_inner:
                failures["inherited-only-last-prompt"].append(
                    f"{label} stored {trailers!r}")
            if (plan["objections"] or not plan["proved"]
                    or human.get("isMeta") is not False
                    or (human.get("message") or {}).get("content") != expected
                    or coordinator.get("isMeta") is not True
                    or receipt.get("visible_human_wrapper_edits") != expected_edits):
                failures["inherited-prefix-human-visibility"].append(
                    f"{label} did not transform only the inherited human row")
                continue
            plan["dest_path"].write_text(
                _jsonl_text(plan["lines"], plan["newline"]))
            back = convert(plan["dest_path"], "demote")
            if (back["objections"] or not back["proved"]
                    or _jsonl_text(back["lines"], back["newline"]) != original):
                failures["inherited-prefix-human-visibility"].append(
                    f"{label} did not restore the fork-reference side bytes")

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "project" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        side = sub / "agent-picker.jsonl"
        side.write_text("".join(fixture_line(row) + "\n" for row in [
            {"parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
             "type": "user", "uuid": "typed", "message": {"role": "user",
             "content": "typed human prompt"}},
            {"parentUuid": "typed", "isSidechain": True, "sessionId": "PARENT",
             "type": "user", "uuid": "coordinator-row",
             "origin": {"kind": "coordinator"},
             "message": {"role": "user", "content": "coordinator text"}},
            {"parentUuid": "coordinator-row", "isSidechain": True,
             "sessionId": "PARENT", "type": "user", "uuid": "peer-row",
             "origin": {"kind": "peer"},
             "message": {"role": "user", "content": "peer text"}},
        ]))
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir = Path(td)
        plan = convert(side, "promote")
        trailers = [rec for rec in records(plan) if rec.get("type") == "last-prompt"]
        if (plan["objections"] or not plan["proved"] or len(trailers) != 1
                or trailers[0].get("lastPrompt") != "typed human prompt"):
            failures["last-prompt-rejects-nonhuman-origin"].append(str(trailers))

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "project" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        side = sub / "agent-no-newline.jsonl"
        original = fixture_line({
            "parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
            "type": "user", "uuid": "no-newline",
            "message": {"role": "user", "content": "no newline"},
        })
        side.write_text(original)
        (sub / "agent-no-newline.meta.json").write_text('{"agentType":"fork"}')
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir, eng._teams_dir = Path(td), Path(td) / "teams"
        eng._team_for_parent_session = lambda parent: ("TEAM", "fixture parent")
        promotion = eng.promotion_plan(
            "no-newline", as_agent="no-newline@TEAM", force=True)
        promote = promotion["conversion"]
        no_newline = {"line": "none", "final": "none"}
        promoted_no_final = {"line": "lf", "final": "none"}
        if (promotion["objections"] or not promote or promote["objections"] or not promote["proved"]
                or promote.get("newline") != promoted_no_final
                or promote.get("receipt", {}).get("source_newline") != no_newline):
            failures["conversion-preserves-final-newline"].append(
                f"promotion failed or lost newline state: {promotion['objections'] or (promote or {}).get('objections')}")
        elif apply(promotion, materialize, "conversion-preserves-final-newline"):
            if promote["dest_path"].read_text()[-1:] == "\n":
                failures["conversion-preserves-final-newline"].append(
                    "materialize added a final newline")
            demotion = eng.demotion_plan(
                "no-newline", into="PARENT", force=True, table=(), census=())
            demote = demotion["conversion"]
            if (demotion["objections"] or not demote or demote["objections"]
                    or not demote["proved"] or demote.get("newline") != no_newline):
                failures["conversion-preserves-final-newline"].append(
                    f"demotion failed or lost newline state: {demotion['objections']}")
            elif apply(demotion, embed, "conversion-preserves-final-newline"):
                if side.read_text() != original:
                    failures["conversion-preserves-final-newline"].append(
                        "embed did not restore the original final-newline state")

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "project" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        side = sub / "agent-crlf.jsonl"
        original_lines = [
            fixture_line({
                "parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
                "type": "user", "uuid": "crlf-root",
                "message": {"role": "user", "content": "CRLF prompt"},
            }),
            fixture_line({
                "parentUuid": "crlf-root", "isSidechain": True,
                "sessionId": "PARENT", "type": "assistant", "uuid": "crlf-leaf",
            }),
        ]
        original = ("\r\n".join(original_lines) + "\r\n").encode()
        side.write_bytes(original)
        (sub / "agent-crlf.meta.json").write_text('{"agentType":"fork"}')
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir, eng._teams_dir = Path(td), Path(td) / "teams"
        eng._team_for_parent_session = lambda parent: ("TEAM", "fixture parent")
        crlf = {"line": "crlf", "final": "crlf"}
        promotion = eng.promotion_plan("crlf", as_agent="crlf@TEAM", force=True)
        promote = promotion["conversion"]
        if (promotion["objections"] or not promote or promote["objections"] or not promote["proved"]
                or promote.get("newline") != crlf
                or promote.get("receipt", {}).get("source_newline") != crlf):
            failures["conversion-preserves-crlf"].append(
                f"promotion lost CRLF metadata: {promotion['objections'] or (promote or {}).get('objections')}")
        elif apply(promotion, materialize, "conversion-preserves-crlf"):
            promoted_bytes = promote["dest_path"].read_bytes()
            without_crlf = promoted_bytes.replace(b"\r\n", b"")
            if (not promoted_bytes.endswith(b"\r\n") or b"\r" in without_crlf
                    or b"\n" in without_crlf):
                failures["conversion-preserves-crlf"].append(
                    "materialize did not write uniform CRLF records")
            demotion = eng.demotion_plan(
                "crlf-root", into="PARENT", force=True, table=(), census=())
            demote = demotion["conversion"]
            if (demotion["objections"] or not demote or demote["objections"]
                    or not demote["proved"] or demote.get("newline") != crlf):
                failures["conversion-preserves-crlf"].append(
                    f"demotion lost CRLF metadata: {demotion['objections']}")
            elif apply(demotion, embed, "conversion-preserves-crlf"):
                if side.read_bytes() != original:
                    failures["conversion-preserves-crlf"].append(
                        "the CRLF promote/demote cycle changed the source bytes")

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "project" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir = Path(td)
        root = fixture_line({
            "parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
            "type": "user", "uuid": "newline-receipt",
            "message": {"role": "user", "content": "receipt validation"},
        })
        base_receipt = fixture_receipt(
            direction="demote", parent="PARENT", dest_stem="newline-main",
            root="newline-receipt", task_id="newline-receipt")
        for index, malformed in enumerate((
                True,
                {"line": "crlf", "final": "lf"},
                {"line": "bogus", "final": "none"},
        )):
            receipt = {**base_receipt, "source_newline": malformed}
            side = sub / f"agent-malformed-{index}.jsonl"
            side.write_text(root + "\n" + TranscriptRewriter._receipt_line(receipt) + "\n")
            plan = convert(side, "promote")
            if (plan.get("proved") or not any(
                    "invalid source_newline" in objection
                    for objection in plan.get("objections", []))):
                failures["malformed-newline-receipt-refused"].append(
                    f"accepted {malformed!r}")
        omitted = sub / "agent-omitted-newline.jsonl"
        missing_newline = dict(base_receipt)
        missing_newline.pop("source_newline")
        omitted.write_text(
            root + "\n" + fixture_line({"type": RECEIPT_RECORD,
                                        "receipt": missing_newline}) + "\n")
        omission_plan = convert(omitted, "promote")
        if (omission_plan.get("proved") or not any(
                "missing source_newline" in objection
                for objection in omission_plan.get("objections", []))):
            failures["malformed-newline-receipt-refused"].append(
                f"accepted missing source_newline: {omission_plan['objections']}")

    conversion_src = s.src_of(s.funcs["_convert"]) or ""
    planner_src = s.src_of(s.rewriter_methods["conversion_plan"]) or ""
    forbidden_defaults = (
        'get("direction",' in planner_src,
        'get("unwrapped",' in planner_src or 'get("unwrapped",' in conversion_src,
        'get("grammar", SIDE_GRAMMAR_REGULAR)' in planner_src,
        'not had_visible_humans' in conversion_src,
        'discover_visible = direction == "promote" and rescan_visible_humans'
            not in conversion_src,
    )
    if any(forbidden_defaults):
        failures["receipt-schema-has-no-field-defaults"].append(
            "a missing receipt field still selects compatibility behavior")

    names = {
        'nonexact-promotion-rescans-human-wrappers':
            'a new promotion merges carried human edits with newly eligible wrappers',
        'inherited-prefix-human-visibility':
            'both visibility modes include eligible records copied from inherited history',
        'last-prompt-rejects-nonhuman-origin':
            'last-prompt ignores coordinator and peer rows that use the user record type',
        'conversion-preserves-final-newline':
            'conversion writers preserve a transcript with no final newline byte-exactly',
        'inherited-only-last-prompt':
            'last-prompt can come from inherited human history when the side has none',
        'conversion-preserves-crlf':
            'promote and demote preserve CRLF separators and terminators byte-exactly',
        'malformed-newline-receipt-refused':
            'malformed or missing carried newline metadata is refused',
        'incomplete-receipt-schema-refused':
            'receipts missing current fields are rejected',
        'receipt-schema-version-required':
            'conversion receipts require the one supported schema version',
        'receipt-schema-has-no-field-defaults':
            'receipt fields are validated rather than inferred from omission',
        'complete-wrapper-edits-use-intervals':
            'complete-wrapper edits separated only by UUID-less records share one interval',
        'overlapping-wrapper-edit-intervals-refused':
            'wrapper edit intervals cannot claim one UUID twice',
    }
    for cid, name in names.items():
        check(cid, name, not failures[cid], ", ".join(failures[cid]))
    return checked


@unit(
    ('writers-move-receipt-back',
     'the writers move, and the in-file receipt is the way back'),
    ('conversion-restores-side-metadata-exactly',
     'demotion restores the exact side metadata bytes and mode'),
)
def _check_writers_move_receipt_back(s):
    checked = []

    def check(cid, ok, detail=""):
        checked.append(_check_verdict(cid, ok, detail))

    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "proj" / "PARENT" / "subagents"
        sub.mkdir(parents=True)

        body = "\n".join(fixture_line(r) for r in [
            {"type": "fork-context-ref", "agentId": "x1", "parentSessionId": "PARENT",
             "parentLastUuid": "pl-leaf", "contextLength": 9},
            {"parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
             "agentId": "x1", "type": "user", "uuid": "xr-root",
             "message": {"role": "user", "content": "fork off"}},
            {"parentUuid": "xr-root", "isSidechain": True, "sessionId": "PARENT",
             "agentId": "x1", "type": "assistant", "uuid": "xr-2"},
        ]) + "\n"
        side = sub / "agent-x1.jsonl"
        side.write_text(body)
        side.chmod(0o600)
        meta_body = b'{\r\n  "agentType": "fork",\r\n  "name": "xp"\r\n}\r\n'
        meta_path = sub / "agent-x1.meta.json"
        meta_path.write_bytes(meta_body)
        meta_path.chmod(0o640)
        (Path(td) / "proj" / "PARENT.jsonl").write_text(
            fixture_line({"parentUuid": None, "isSidechain": False,
                          "sessionId": "PARENT", "type": "user",
                          "uuid": "pl-root", "message": {"role": "user",
                          "content": "inherited"}}) + "\n" +
            fixture_line({"parentUuid": "pl-root", "isSidechain": False,
                          "sessionId": "PARENT", "type": "assistant",
                          "uuid": "pl-leaf"}) + "\n")
        eng4 = Resolver(needs=Needs(maybe=set(NEED)))
        eng4._projects_dir, eng4._teams_dir = Path(td), Path(td) / "teams"
        eng4._team_for_parent_session = lambda parent: ("TEAMX", "fixture parent")
        real_resolver, real_receipts = RESOLVER, RECEIPTS_DIR
        globals()["RESOLVER"] = eng4
        globals()["RECEIPTS_DIR"] = Path(td) / "receipts"
        moved = []
        side_meta_exact = False
        res = None
        try:
            promotion = eng4.promotion_plan("x1", as_agent="xp@TEAMX", force=True)
            plan = promotion["conversion"]
            if plan is None:
                raise ValueError(f"promotion returned no conversion: {promotion['objections']}")
            materialize(promotion)
            dest = plan["dest_path"]
            if not dest.exists():
                moved.append("no promoted transcript")
            else:
                promoted = [json.loads(line) for line in dest.read_text().splitlines()]
                by_uuid = {rec.get("uuid"): rec for rec in promoted if rec.get("uuid")}
                if [rec.get("uuid") for rec in promoted[:2]] != ["pl-root", "pl-leaf"]:
                    moved.append("the inherited parent prefix was not materialized first")
                if by_uuid.get("xr-root", {}).get("parentUuid") != "pl-leaf":
                    moved.append("the fork root was not connected to the materialized prefix")
                if dest.stat().st_mode & 0o777 != 0o600:
                    moved.append("the promoted transcript lost its mode")
            if side.exists() or (sub / "agent-x1.meta.json").exists():
                moved.append("the source did not leave subagents/")
            carried = eng4._receipt_carried_by(dest)
            if not carried or carried.get("root") != dest.stem:
                moved.append("the promoted transcript carries no usable receipt")
            if list(RECEIPTS_DIR.glob("xr-root*.json")):
                moved.append("the promote wrote a receipt outside the transcript")
            # Until launch, the in-file receipt is the membership: the population
            # carries the member as converted, the roster stays silent, and
            # the ladder resolves the name to the promoted transcript.
            pop = eng4._team_runtime("TEAMX")["population"]
            if pop.get("xp", ("",))[0] != "converted":
                moved.append("an unlaunched promote is missing from the population")
            if eng4._converted_members("TEAMX").get("xp", {}).get("root") != dest.stem:
                moved.append("the carried receipt does not name its own transcript")
            res = eng4._resolve_transcript(name="xp", team="TEAMX", quick=True)
            if not res or res.via != "conversion receipt" or res.path != dest:
                moved.append("the ladder does not reach an unlaunched promote")
            demotion = eng4.demotion_plan(
                "xr-root", into="PARENT", force=True, table=(), census=())
            dplan = demotion["conversion"]
            if (demotion["objections"] or not dplan or dplan["objections"]
                    or not dplan["proved"]):
                moved.append(f"the written promote cannot be demoted: "
                             f"{demotion['objections'] or 'unproved'}")
            else:
                embed(demotion)
                if eng4._converted_members("TEAMX"):
                    moved.append("a consumed receipt still counts as membership")
                if side.read_text() != body:
                    moved.append("the demoted bytes differ from the original")
                if side.stat().st_mode & 0o777 != 0o600:
                    moved.append("a private transcript came back wider than it left")
                restored_meta = sub / "agent-x1.meta.json"
                side_meta_exact = (restored_meta.read_bytes() == meta_body
                                   and restored_meta.stat().st_mode & 0o777 == 0o640)
                if dest.exists():
                    moved.append("the promoted transcript lingered")
                if eng4._receipt_carried_by(side):
                    moved.append("the undo left its conversion receipt in the side transcript")
                if list(RECEIPTS_DIR.glob("xr-root*.json")):
                    moved.append("the conversion wrote a receipt outside the transcript")
        except (Refusal, OSError, AttributeError, KeyError, TypeError, ValueError) as exc:
            moved.append(f"conversion round trip: {type(exc).__name__}: {exc}")
        finally:
            globals()["RESOLVER"] = real_resolver
            globals()["RECEIPTS_DIR"] = real_receipts
        check("writers-move-receipt-back", not moved, ", ".join(moved))
        check("conversion-restores-side-metadata-exactly", side_meta_exact, ", ".join(moved))

    s.res = res
    return checked


@unit(('demote-cannot-embed-self', 'a demote cannot embed the conversation it runs inside'), ('demote-refuses-a-live-holder', 'a demote refuses a transcript a live stranger holds, unless forced'))
def _check_demote_cannot_embed_self(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    with tempfile.TemporaryDirectory() as td:
        proj = Path(td) / "proj"
        proj.mkdir(parents=True)

        # A teammate that really does demote, so the arms where nothing stops
        # it show the demote going through rather than meeting some later
        # refusal that would make a broken gate look the same as a working one.
        (proj / "MATEHELD.jsonl").write_text(
            fixture_line({"parentUuid": None, "sessionId": "MATEHELD", "agentName": "heldy",
                     "teamName": "TEAMH", "type": "user", "uuid": "mh-root"}) + "\n" +
            fixture_line({"type": "last-prompt", "lastPrompt": "hi", "leafUuid": "mh-root",
                     "sessionId": "MATEHELD"}) + "\n" +
            fixture_line({"parentUuid": "mh-root", "sessionId": "MATEHELD", "agentName": "heldy",
                     "teamName": "TEAMH", "type": "assistant", "uuid": "mh-2"}) + "\n" +
            fixture_line({"type": "last-prompt", "lastPrompt": "again", "leafUuid": "mh-2",
                     "sessionId": "MATEHELD"}) + "\n")

        class _HeldArgs:
            demote, force, with_mail = "MATEHELD", False, False
            into, dry_run = "PARENT", True

        class _ForcedArgs(_HeldArgs):
            force = True

        me = os.getpid()
        holder = ("claude", "--resume", "MATEHELD", "--agent-id", "heldy@TEAMH")
        # One pid up from ours is a stranger by construction: the lineage walk
        # starts at our own pid and follows this table's parents, and this
        # table has no way to reach ours.
        ours, stranger = [(me, 0, holder)], [(PID_CEILING + 1, 1, holder)]

        def demoted(args, table):
            """Everything this demote said, refusal or plan, on one line.

            Both streams, because the two outcomes under test are told on
            different ones: a refusal is die() to stderr, and a demote that
            nothing stops names its destination on stdout. A demote that
            stopped refusing returns rather than exiting, so the arms read
            what it said instead of the suite ending on it. dry_run
            throughout: the arms that get past both gates plan and print,
            and nothing here writes.
            """
            real_table = RESOLVER._process_table
            RESOLVER._process_table = lambda: table
            said, printed = io.StringIO(), io.StringIO()
            try:
                with capturing("err", into=said), \
                        capturing("out", into=printed):
                    try:
                        run_demote(args)
                    except Refusal:
                        pass
            finally:
                RESOLVER._process_table = real_table
            return " ".join((said.getvalue() + " " + printed.getvalue()).split())

        real_projects, real_teams = RESOLVER._projects_dir, RESOLVER._teams_dir
        real_receipts = RECEIPTS_DIR
        RESOLVER._projects_dir, RESOLVER._teams_dir = Path(td), Path(td) / "teams"
        globals()["RECEIPTS_DIR"] = Path(td) / "receipts"
        try:
            inside = demoted(_HeldArgs, ours)
            inside_forced = demoted(_ForcedArgs, ours)
            outside = demoted(_HeldArgs, stranger)
            outside_forced = demoted(_ForcedArgs, stranger)
            unheld = demoted(_HeldArgs, [])
        finally:
            RESOLVER._projects_dir, RESOLVER._teams_dir = real_projects, real_teams
            globals()["RECEIPTS_DIR"] = real_receipts

        # What the same demote says when nothing holds the file: the control
        # both refusals need, since a refusal that fires whatever the process
        # table says is not answering the holder question.
        went_through = "demote MATEHELD ->"

        blind = []
        mine = f"you are demoting the transcript you are running (pid {me})"
        if mine not in inside:
            blind.append(f"a demote of our own conversation said: {inside or 'nothing'}")
        if mine not in inside_forced:
            blind.append(f"--force got past it: {inside_forced or 'nothing'}")
        if went_through not in unheld:
            blind.append(f"the same demote unheld did not go through: {unheld or 'nothing'}")
        # The half the drive cannot see: self-hold is answered first, so a
        # lineage that also counted as a stranger would still refuse here.
        # The reap reads that half, and nothing else asserts the exclusion.
        holders = RESOLVER._runtime(ours)["transcripts"].get("MATEHELD", {})
        if holders.get("others"):
            blind.append("the composed question counts our own lineage as a stranger")
        check("demote-cannot-embed-self", "a demote cannot embed the conversation it runs inside", not blind,
              ", ".join(blind))

        holding = []
        theirs = f"pid {PID_CEILING + 1} is running this conversation"
        if theirs not in outside:
            holding.append(f"a demote under a live holder said: {outside or 'nothing'}")
        if went_through not in outside_forced:
            holding.append(f"--force did not override the holder refusal: "
                           f"{outside_forced or 'nothing'}")
        if went_through not in unheld:
            holding.append(f"the same demote unheld did not go through: {unheld or 'nothing'}")
        check("demote-refuses-a-live-holder",
              "a demote refuses a transcript a live stranger holds, unless forced",
              not holding, ", ".join(holding))
    return checked


