def forge_team(ctx, dry, evidence=None):
    """Recreate a team dir the graceful lead exit rm -rf'd, from merged fields.

    The roster is scaffolding; the transcript is the identity. Everything the
    config needs is already in the merge, so a missing team is not fatal."""
    record = RESOLVER.roster_record(ctx)
    team, name = record["team"], record["name"]
    if not team or not (name or ctx.get("leads_team")):
        return
    if RESOLVER.has_roster(team):
        return
    cfg = RESOLVER.roster_path(team)
    now = int(time.time() * 1000)
    lead_sid = record["parentSession"]
    if name == "team-lead" or ctx.get("leads_team"):
        # Forging for the lead itself. Recording the resumed transcript as
        # leadSessionId is what lets rung 1 find this lead again next time.
        #
        # The members come back too, from the lead's own spawn payloads. Writing
        # a lead-only roster would unregister every teammate it ever created:
        # their transcripts survive, but nothing lists them, so reviving one by
        # name reports that no team config lists a member sitting right there.
        # The payloads carry the colour, type and model the roster held, which is
        # the same evidence RESOLVER.led_teams() uses to identify this lead at all.
        members = [{
            "agentId": f"team-lead@{team}",
            "name": "team-lead",
            "agentType": "team-lead",
            "joinedAt": now,
            "tmuxPaneId": "leader",
            **({"cwd": record["cwd"]} if record.get("cwd") else {}),
            "subscriptions": [],
            "backendType": "in-process",
        }]
        for payload in RESOLVER.members_spawned_into(ctx["session_uuid"], team):
            entry = {
                "agentId": payload.get("agent_id") or f"{payload['name']}@{team}",
                "name": payload["name"],
                "joinedAt": now,
                "tmuxPaneId": payload.get("tmux_pane_id") or "",
                "subscriptions": [],
                "agentType": payload.get("agent_type") or DEFAULT_AGENT_TYPE,
                "planModeRequired": bool(payload.get("plan_mode_required")),
                "backendType": "tmux",
                "isActive": False,
            }
            for key in ("color", "model"):
                if payload.get(key):
                    entry[key] = payload[key]
            members.append(entry)
        config = {
            "name": team,
            "createdAt": now,
            "leadAgentId": f"team-lead@{team}",
            # Written only at the strength the engine will later read it at. Rung 1
            # treats leadSessionId as EXACT and asks nothing further, so recording an
            # uncorroborated guess there would convert a one-off warning into a
            # permanent fact, and would then satisfy rung 4's "a roster names it"
            # corroboration with a roster we derived from that same guess.
            #
            # Left empty instead. The lead gate does not need it, so resolution falls
            # to the corroboration ladder and runs again on every resume: the warning
            # returns until the evidence genuinely improves, and improves by itself
            # once the lead has run once and is a live process wearing the identity.
            # `evidence` is the ladder's own verdict, passed through verbatim. It is
            # not ctx["via"]: a rebuild hands the engine a uuid, so via reports
            # "session uuid" and would launder the very judgement this consults.
            "leadSessionId": "" if "uncorroborated" in (evidence or "")
                             else ctx["session_uuid"],
            "members": members,
        }
        rebuilt = ", ".join(m["name"] for m in members[1:]) or "no members recovered"
        ctx["lead_agent_id"] = f"team-lead@{team}"
        if dry:
            step(True, f"would forge {cfg} (lead + {rebuilt}) and seed every inbox", "")
            # Returned in both modes so a dry run previews the same roster a real
            # run would proceed on. Enumerating it separately for the preview
            # would be a second implementation, free to drift from this one.
            return config
        (cfg.parent / "inboxes").mkdir(parents=True, exist_ok=True)
        edit_team_config(cfg, lambda _: config, f"forged for the lead being resumed ({rebuilt})",
                         create=config)
        for member in members:
            ensure_inbox(team, member["name"], dry)
        return config
    member = {
        "agentId": record["agentId"],
        "name": name,
        "joinedAt": now,
        "tmuxPaneId": "",
        "subscriptions": [],
        "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
        "planModeRequired": bool(record.get("planModeRequired")),
        **({"cwd": record["cwd"]} if record.get("cwd") else {}),
        "backendType": "tmux",
        "isActive": False,
    }
    member.update({k: record[k] for k in SYNCED_FIELDS if record.get(k)})
    config = {
        "name": team,
        "createdAt": now,
        "leadAgentId": f"team-lead@{team}",
        "leadSessionId": lead_sid,
        "members": [
            {
                "agentId": f"team-lead@{team}",
                "name": "team-lead",
                "agentType": "team-lead",
                "joinedAt": now,
                "tmuxPaneId": "leader",
                **({"cwd": record["cwd"]} if record.get("cwd") else {}),
                "subscriptions": [],
                "backendType": "in-process",
            },
            member,
        ],
    }
    if dry:
        step(True, f"would forge {cfg} (lead + {name}) and seed both inboxes", "")
        return
    (cfg.parent / "inboxes").mkdir(parents=True, exist_ok=True)
    edit_team_config(cfg, lambda _: config, "forged (a graceful lead exit had deleted)", create=config)
    for inbox in ("team-lead", name):
        ensure_inbox(team, inbox, dry)
    # re-resolve so the roster patch after launch has an entry to patch
    matches = [e for e in RESOLVER.scan_teams() if e["member"].get("agentId") == member["agentId"]]
    if matches:
        ctx["team_entry"] = matches[0]
        ctx["lead_agent_id"] = matches[0].get("leadAgentId")


@contextlib.contextmanager
def team_lock(cfg, timeout=5.0):
    """Hold the roster's config.json.lock, the same lockfile the harness's own
    locked write helper uses (architecture.md). Without it, patching the roster
    of a live lead races that lead's own spawn and shutdown writes, and one of
    the two updates is simply lost."""
    lock = cfg.with_name("config.json.lock")
    deadline = time.time() + timeout
    handle = None
    while handle is None:
        try:
            handle = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            if time.time() > deadline:
                warn(f"{lock.name} held by someone else for {timeout}s; writing anyway")
                break
            time.sleep(0.05)
        except OSError:
            break  # unwritable dir: the write below will report the real error
    try:
        yield
    finally:
        if handle is not None:
            os.close(handle)
            try:
                lock.unlink()
            except OSError:
                pass


_BACKED_UP = set()


def edit_team_config(cfg, mutate, note, create=None):
    """Read-modify-write a roster under the harness's lockfile.

    The read happens inside the lock as well, so a harness write landing
    between read and write cannot be overwritten. `mutate(data)` returns the
    new data, or None to make the write a no-op.
    """
    cfg.parent.mkdir(parents=True, exist_ok=True)
    with team_lock(cfg):
        if cfg.exists():
            try:
                data = json.loads(cfg.read_text())
            except ValueError as exc:
                warn(f"{cfg} is not valid JSON ({exc}); leaving it alone")
                return False
        elif create is None:
            warn(f"no roster at {cfg}")
            return False
        else:
            data = create

        data = mutate(data)
        if data is None:
            return False

        suffix = ""
        if cfg.exists():
            # One backup per run: the pre-run state, not a mid-run write.
            backup = cfg.with_suffix(f".json.bak-{TOOL}")
            if str(cfg) not in _BACKED_UP:
                backup.write_text(cfg.read_text())
                _BACKED_UP.add(str(cfg))
            suffix = f" (backup: {backup.name})"
        tmp = cfg.with_suffix(f".json.tmp-{TOOL}")
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        os.replace(tmp, cfg)
    print(f"  {note} {cfg}{suffix}")
    return True


def ensure_inbox(team, name, dry):
    """A zero-byte inbox is a parse error that wedges both reader and writer."""
    if not team or not name:
        return
    if RESOLVER.inbox_seeded(team, name):
        return
    path = RESOLVER.inbox_path(team, name)
    if dry:
        step(True, f"would seed {path} with []", "")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("[]")
    step(False, "", f"seeded {path} with []")


def register_member(record, pane, dry, alive=True):
    """Write this member into the roster, inserting it if absent (Recipe 1b).

    SendMessage's roster fallback reads this file at send time, so the entry is
    what makes the member addressable from the live lead.

    The record says both what to write and where: on a rebind the engine has
    already reprojected the id onto the destination team.
    """
    team = record.get("team")
    name = record.get("name")
    agent_id = record["agentId"]
    cfg = RESOLVER.roster_path(team)

    def mutate(data):
        if agent_id == data.get("leadAgentId"):
            warn(f"refusing to register the lead {agent_id} as a pane-backed member")
            return None
        member = next((m for m in data.get("members", []) if m.get("agentId") == agent_id), None)
        if member is None:
            member = {
                "agentId": agent_id,
                "name": name,
                "joinedAt": int(time.time() * 1000),
                "subscriptions": [],
                "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
                "planModeRequired": bool(record.get("planModeRequired")),
                **({"cwd": record["cwd"]} if record.get("cwd") else {}),
            }
            data.setdefault("members", []).append(member)
        member.update({k: record[k] for k in SYNCED_FIELDS if record.get(k)})
        member.update({"tmuxPaneId": pane or "", "backendType": "tmux", "isActive": alive})
        return data

    if dry:
        step(True, f"would register {agent_id} in {cfg}", "")
        return
    if edit_team_config(cfg, mutate, f"registered {agent_id} in"):
        ensure_inbox(team, name, dry)


def reserve_member(record, dry):
    """Claim this member's roster entry before its process starts.

    The harness spawns this way too, verified in the 2.1.220 bundle: a bare
    entry pushed under the roster lock, then a second locked write patching in
    the pane and backend once the seat exists. Its reason is atomic identity
    allocation, so two concurrent spawns cannot claim one name, with the
    reservation rolled back if the spawn dies. The reason here is different and
    also real: the harness looks a member up by name in the roster as it boots,
    and a boot that does not find itself listed initialises no idle hook, so
    the member runs and answers mail but never reports itself idle. Writing the
    entry only after the spawn leaves that lookup racing the launch.

    Bare means without the two facts that do not exist yet, the pane and the
    backend. Everything already known travels now.

    Returns True only when this run actually inserted the entry. That is what
    makes the rollback safe: an entry that was already there is not ours to
    remove.
    """
    agent_id = record["agentId"]
    cfg = RESOLVER.roster_path(record.get("team"))
    inserted = []

    def mutate(data):
        if agent_id == data.get("leadAgentId"):
            return None  # a lead is not a pane-backed member; the commit phase says so
        if any(m.get("agentId") == agent_id for m in data.get("members", [])):
            return None  # already listed: nothing to claim, and nothing to roll back
        data.setdefault("members", []).append({
            "agentId": agent_id,
            "name": record.get("name"),
            "joinedAt": int(time.time() * 1000),
            "subscriptions": [],
            "planModeRequired": bool(record.get("planModeRequired")),
            **({"cwd": record["cwd"]} if record.get("cwd") else {}),
            **{k: record[k] for k in SYNCED_FIELDS if record.get(k)},
            "agentType": record.get("agentType") or DEFAULT_AGENT_TYPE,
        })
        inserted.append(agent_id)
        return data

    if dry:
        # Stated even though most runs re-resume an already listed member and
        # write nothing here, because a preview that hides a write is worse
        # than one that mentions a write that turns out to be unnecessary.
        step(True, f"would claim {agent_id} in {cfg} before the launch, "
                   f"if it is not listed yet", "")
        return False
    edit_team_config(cfg, mutate, f"claimed {agent_id} in")
    return bool(inserted)


def release_member(record, dry):
    """Take back a reservation whose launch never happened.

    Only ever called for an entry this run inserted, so it removes rather than
    marking inactive: the member did not fail, it never existed. A launch that
    fails after the process is up keeps its entry instead and records what it
    found, which is the harness's rule too.
    """
    agent_id = record["agentId"]
    cfg = RESOLVER.roster_path(record.get("team"))

    def mutate(data):
        members = data.get("members", [])
        kept = [m for m in members if m.get("agentId") != agent_id]
        if len(kept) == len(members):
            return None
        data["members"] = kept
        return data

    if dry:
        step(True, f"would release the claim on {agent_id} in {cfg}", "")
        return
    edit_team_config(cfg, mutate, f"released the claim on {agent_id} in")


def retire_member(ctx, dry):
    """Mark the source-team entry inactive after a rebind, so the abandoned
    roster stops claiming a live member."""
    entry = ctx.get("team_entry")
    if not entry:
        return
    cfg = entry["cfg"]
    agent_id = entry["member"].get("agentId")

    def mutate(data):
        changed = False
        for member in data.get("members", []):
            if member.get("agentId") == agent_id and member.get("isActive"):
                member["isActive"] = False
                changed = True
        return data if changed else None

    if dry:
        step(True, f"would retire {agent_id} in {cfg}", "")
        return
    edit_team_config(cfg, mutate, f"retired {agent_id} in")


def update_team_config(ctx, record, pane, dry, alive=True):
    entry = ctx["team_entry"]
    if not entry:
        return
    cfg = entry["cfg"]
    agent_id = entry["member"].get("agentId")

    def mutate(data):
        if agent_id and agent_id == data.get("leadAgentId"):
            # A lead is never pane-backed. Writing tmux/%N onto its entry points
            # the harness's exit reaper (which kills members with a pane-type
            # backend) at a pane id that belongs to somebody else.
            warn(f"refusing to write pane-backed fields onto the lead entry {agent_id}")
            return None
        changed = False
        for member in data.get("members", []):
            if member.get("agentId") != agent_id:
                continue
            # Sync the roster to the launch we just performed, rather than only
            # filling blanks: a roster saying claude-opus-5 while the process
            # runs claude-opus-5[1m] describes something that does not exist.
            updates = [("tmuxPaneId", pane), ("backendType", "tmux"), ("isActive", alive)]
            updates += [(k, record[k]) for k in SYNCED_FIELDS if record.get(k)]
            for key, value in updates:
                if value is not None and member.get(key) != value:
                    member[key] = value
                    changed = True
        return data if changed else None

    if dry:
        step(True, f"would update {cfg}", "")
        return
    edit_team_config(cfg, mutate, "updated")


def claude_binary(args):
    """Always the `claude` on PATH, never the pinned version the transcript was
    written by, and never CLAUDE_CODE_EXECPATH, both of which can be stale."""
    if args.claude_bin:
        return args.claude_bin
    from shutil import which

    return which("claude") or "claude"


def build_command(ctx, args, passthrough):
    user_flags = {a.split("=", 1)[0] for a in passthrough if a.startswith("-")}
    cmd = [claude_binary(args), "--resume", ctx["session_uuid"]]

    # --bare stops here: the conversation and nothing the tool decided. Not only
    # the identity flags but the model, the effort and the permission mode too,
    # since a resume asked for bare should be what a person would type, and
    # inheriting a permission bypass nobody asked for is the worst of them to
    # add silently. Explicit passthrough still applies: that is typed, not
    # derived. What the harness does with a stamped conversation is its own
    # business and reported at the launch, not fought with here.
    if getattr(args, "bare", False):
        return cmd + passthrough

    dest = ctx.get("to_team")
    for flag, field in DERIVED_FLAGS.items():
        if flag in user_flags:
            continue
        value = RESOLVER.field(ctx, field, prefer_specific=(field == "model"))
        if dest:  # rebinding onto a live lead's implicit team
            if field == "teamName":
                value = dest
            elif field == "agentId":
                value = f"{RESOLVER.field(ctx, 'agentName')}@{dest}"
            elif field == "parentSessionId":
                value = ctx.get("to_lead") or value
        # The name and the team are the two halves of the id, not second opinions
        # about it.
        # Derived separately, a lead resolved as team-lead@<team> was launched
        # with whatever name its transcript last carried, often a session title.
        # The harness stamps every line with that name, so the tool corrupted the
        # identity it was asked to restore and then refused the session next time,
        # its stamps no longer matching the roster. Enforced here rather than in
        # the merge because a structural fact should not have to win a timestamp
        # race against a stamp.
        if flag in ("--agent-name", "--team-name"):
            emitted_id = next((cmd[i + 1] for i, token in enumerate(cmd)
                               if token == "--agent-id"), None)
            if emitted_id and "@" in emitted_id:
                name_half, _, team_half = emitted_id.partition("@")
                value = name_half if flag == "--agent-name" else team_half
        if not value:
            continue
        # The lead masquerade wears the teammate flags but not these two: there
        # is no "team-lead" agent type to resolve, and a lead is its own parent.
        if flag == "--agent-type" and value == "team-lead":
            continue
        if flag == "--parent-session-id" and value == ctx["session_uuid"]:
            continue
        cmd += [flag, str(value)]

    mode = RESOLVER.field(ctx, "permissionMode")
    if mode and not user_flags & {"--permission-mode", "--dangerously-skip-permissions"}:
        if mode == "bypassPermissions":
            cmd.append("--dangerously-skip-permissions")
        elif mode not in ("default", "normal"):
            cmd += ["--permission-mode", mode]

    return cmd + passthrough


def explain(ctx):
    merged = ctx["merged"]
    print("resolved fields (most recent source wins):")
    width = max((len(f) for f in merged.cands), default=8)
    for field in sorted(merged.cands):
        value, ts, source = RESOLVER.provenance(ctx, field)
        conflict = merged.conflicts(field)
        mark = "  <- conflict: " + ", ".join(sorted(str(c) for c in conflict)) if len(conflict) > 1 else ""
        print(f"  {field:<{width}}  {value}   [{source} @ {ms_str(ts)}]{mark}")
    for path, _, last_ts in ctx["other_transcripts"]:
        print(f"  (older transcript ignored: {path.name} @ {ms_str(last_ts)})")


def check_substrate():
    """SKILL.md says substrate choice is not ours to make, and this tool only
    implements the tmux one. Say so rather than silently imposing panes."""
    mode = RESOLVER.configured_teammate_mode()
    if mode and mode not in ("tmux", "auto"):
        warn(f"teammateMode is {mode!r}, but this tool only revives into tmux panes")


def build_command_agent_id(ctx):
    """The agent id the launch wears, which a rebind changes."""
    dest = ctx.get("to_team")
    return f"{RESOLVER.field(ctx, 'agentName')}@{dest}" if dest else RESOLVER.field(ctx, "agentId")


def confirm_redirect(agent_id, pid, dest, source, prefix=""):
    """Offer a redirect the evidence corroborates. True to take it.

    Corroborated means three facts agreeing: this team could only have been
    minted by a resumed life (from disk - a fresh boot's team names its own
    transcript), it is the only such team paired with this process's boot,
    and that process is the only one paired with it. That is why the offer
    defaults to yes; what it still cannot see is a team minted late, outside
    any window centred on boot, which is a gap in coverage rather than a
    choice between candidates. No terminal means no answer, and a launch
    that cannot ask stays on the team it names.
    """
    if RESOLVER.sole_mint_pairing(pid) != dest:
        return False
    if not sys.stdin.isatty():
        warn(f"pid {pid} is this agent's lead and only {dest} matches its boot; "
             f"nothing here can ask, so it stays on {source}")
        return False
    print(f"{prefix}pid {pid} is this agent's lead and runs as {dest}")
    try:
        answer = input(f"redirect {agent_id} onto {dest}? [Y/n] ").strip().lower()
    except EOFError:
        answer = ""
    if answer.startswith("n"):
        print(f"{prefix}staying on {source}")
        return False
    return True


def decline_unreachable(ctx, args, agent_id, source, dest, prefix=""):
    """The one decision left when a member cannot follow its lead.

    Its mail on the team it can start with is read by nobody, and being
    reachable is what a member's resume is for, so the safe answer is not to
    start it. --keep-team asks for the unreachable launch without the
    question; nothing to ask at means stopping, since silence is not consent.
    """
    ctx["stale_team_warned"] = True
    if getattr(args, "keep_team", False):
        return
    if not sys.stdin.isatty():
        die(f"so {agent_id} can only start on {source}, whose mail its lead "
            f"(running as {dest}) does not read, and nothing here can ask. "
            "Clear the blockers above, or pass --keep-team")
    try:
        answer = input(f"start {agent_id} on {source} anyway, where its lead "
                       "will not read its mail? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if not answer.startswith("y"):
        die("stopped; clear the blockers above, or pass --keep-team")


def auto_redirect(ctx, args, table, prefix=""):
    """Give a launch the identity of the team the lead actually runs as.

    Two different operations hide behind "rebind". REDIRECT chooses the flags
    for a launch that is happening anyway, and writes roster entries; it kills
    nothing. MIGRATE changes a LIVE member's team, which is necessarily kill
    and restart, because identity is frozen in argv at exec and two processes
    must never append to one transcript.

    The default may redirect. Only an explicit --to-team may migrate, so that
    every killed process traces back to something the user actually asked for.
    Redirect also requires exact evidence: the mint-window join is a heuristic,
    and acting on a heuristic unasked is how "pick the newest" comes back.
    """
    agent_id, source = RESOLVER.field(ctx, "agentId"), RESOLVER.field(ctx, "teamName")
    if args.keep_team or not (agent_id and source):
        return

    pid, alive, _, exact_lead = RESOLVER.lead_pid(RESOLVER.field(ctx, "parentSessionId"), source)
    if not (pid and alive and exact_lead):
        return
    dest, exact_team = RESOLVER.team_minted_by(pid)
    if not dest or dest == source:
        return

    # Setting to_team below suppresses the guards further down (they are for the
    # explicit path), so this must ask every liveness question they would have.
    # argv is not enough: a session resumed from the in-app picker runs as bare
    # `claude` and is visible only to the registry.
    owner = RESOLVER.lead_pid_for(ctx["session_uuid"])
    strangers, _ours = RESOLVER.transcript_holders(ctx["session_uuid"], table)
    holders = strangers + RESOLVER.live_agent_procs(agent_id, table)
    if holders or (owner and owner[2]):
        # Alive: leave it to the liveness guards. Say what the move would cost
        # rather than making it, since restarting throws away its current turn.
        who = f"pid {holders[0][0]}" if holders else f"pid {owner[0]} (registry)"
        standing = RESOLVER.standing(agent_id, RESOLVER.field(ctx, "parentSessionId"))
        fix = "".join(f"\n- {what}  ({cost})" for what, cost in standing["remedies"])
        warn(f"{agent_id} is running as {who}: {standing['reachable'][1]}{fix}")
        ctx["stale_team_warned"] = True
        return

    # A conversation that restores as its own team ignores these flags, so the
    # redirect has to make the move durable or not claim it. Both halves are
    # rebind_reap's: retiring a team nothing is using is cheap, and anything
    # that objects is reported with its own way out.
    path = getattr(ctx["resolution"], "path", None)
    stamped, state = RESOLVER.restored_identity(path) if path else (None, None)
    needs_durable = state == "restored" and stamped != dest
    # Read-only, and asked before anyone else is: a move that cannot happen
    # turns the whole exchange into one decision instead of a redirect
    # question, a wall of blockers, and a second question.
    blocked = reap_blockers(stamped, args, table) if needs_durable else []
    if blocked:
        warn(f"{agent_id} cannot follow its lead onto {dest}:\n"
             + "\n".join(blocked))
        return decline_unreachable(ctx, args, agent_id, source, dest, prefix)

    # Asked last, so a run that was going to decline anyway never puts a question
    # in front of anyone.
    if not exact_team and not confirm_redirect(agent_id, pid, dest, source, prefix):
        return

    if needs_durable and not rebind_reap(stamped, dest, args, prefix,
                                         path=path, fatal=False):
        # rebind_reap has named each blocker with its remedy. What is left is
        # the consequence: this member's lead runs as another team, so its
        # mail on the team it would launch with is read by nobody. Being
        # reachable is what a resume is for, so the run stops rather than
        # starting an agent whose reports go nowhere. --keep-team is the way
        # to ask for that state on purpose.
        return decline_unreachable(ctx, args, agent_id, source, dest, prefix)

    print(f"{prefix}redirect the lead now runs as {dest}, not {source}; "
          f"launching with that identity (--keep-team to stay)")
    ctx["to_team"], ctx["auto_redirect"] = dest, True
    ctx["to_lead"] = RESOLVER.team_lead_session(dest)


def record_membership(ctx, args, pane, alive=True):
    """Put this agent in its team's roster, whether or not this run launched it.

    Being listed is what makes a member addressable: a lead delivers mail from
    the members it knows about, so an unlisted one can write to the lead's inbox
    and never be read from it. That is true of an agent already running just as
    much as of one this run started, and a run that noops has still established
    that the agent is there.
    """
    # A bare resume joins no team, so writing it into a roster would record a
    # membership the launch does not carry. Its inbox is left alone for the
    # same reason: nothing is going to read it under that name.
    if getattr(args, "bare", False):
        return
    if ctx.get("to_team"):
        register_member(RESOLVER.roster_record(ctx, team=ctx["to_team"]), pane, args.dry_run, alive)
        if ctx["to_team"] != RESOLVER.field(ctx, "teamName"):
            retire_member(ctx, args.dry_run)
        return
    team = RESOLVER.field(ctx, "teamName")
    ensure_inbox(team, RESOLVER.field(ctx, "agentName"), args.dry_run)
    if args.no_update_config:
        return
    if ctx.get("team_entry"):
        update_team_config(ctx, RESOLVER.roster_record(ctx), pane, args.dry_run, alive)
    elif RESOLVER.has_roster(team):
        register_member(RESOLVER.roster_record(ctx, team=team), pane, args.dry_run, alive)


def reserve_membership(ctx, args):
    """The claim half of record_membership, taken before the spawn.

    Routed the same way as the commit, so the two phases cannot disagree about
    which roster this member belongs in. Returns the record that was claimed,
    or None when nothing was, which is exactly what a rollback needs to know.
    """
    if getattr(args, "bare", False):
        return None
    team = ctx.get("to_team")
    if not team:
        # Nothing to claim when the caller asked for no roster write, or when
        # the member is already listed and the commit will patch that entry.
        if args.no_update_config or ctx.get("team_entry"):
            return None
        team = RESOLVER.field(ctx, "teamName")
        if not RESOLVER.has_roster(team):
            return None
    record = RESOLVER.roster_record(ctx, team=team)
    return record if reserve_member(record, args.dry_run) else None


def release_membership(record, args):
    """Give back a claim whose launch never happened. No record, nothing to give."""
    if record:
        release_member(record, args.dry_run)


def report_launch(ctx, command, prefix="", role="agent", agent_id=None, extra=()):
    """The facts a launch reports, whichever way it launches.

    One block, because two kept by hand drift apart: a field living in only
    the member block leaves a lead to exec without ever printing its command.
    What genuinely differs between the paths is the
    mechanism - a pane and a socket, or taking over this terminal - so that
    is what `extra` carries, and everything common is answered here once.
    """
    if not prefix:
        # A single-agent run separates its report from whatever warned above
        # it; a team run's [name] headers already do this.
        print()
    print(f"{prefix}{role:<8} {agent_id or '(unknown)'}")
    print(fill(f"{prefix}session  {ctx['session_uuid']}  ({ctx['transcript'][0]})"))
    print(f"{prefix}via      {ctx['via']}")
    if ctx.get("placed"):
        print(fill(f"{prefix}team     {ctx['placed'][0]}  ({ctx['placed'][1]})"))
    title = session_title(ctx["transcript"][0], limit=100)
    if title:
        print(fill(f"{prefix}title    {title}"))
    for label, value in extra:
        print(fill(f"{prefix}{label:<8} {value}"))
    # Read off the command rather than a flag, so the row describes the launch
    # actually being reported. Passing no identity is not the same as having
    # none: a conversation whose window start carries stamps is adopted by the
    # harness on the way up, and a reader who typed --bare has every reason to
    # expect otherwise.
    if "--agent-id" not in command:
        said = "no team, name, model or effort is passed"
        path = ctx.get("transcript", (None,))[0]
        stamped, state = RESOLVER.restored_identity(path) if path else (None, None)
        if state == "restored":
            said += f"; the harness still brings it back as {stamped}, from its own stamps"
        print(fill(f"{prefix}identity {said}"))
    print(wrap_command(command, f"{prefix}command  ", f"{prefix}{'':11}", paste=True))
    # The facts end here and the doing starts. Without the gap the two run
    # together as one wall, and the report is long enough that a reader needs
    # to be told where to stop reading facts.
    print()


def run_one(args, passthrough, table, prefix="", pending=()):
    """Resume one agent. Returns Outcome(status, socket, is_lead), status being
    'noop' | 'launched' | 'manual' | 'failed'.

    The socket is whichever server this agent ended up on, or None when it never
    reached one. Only this function knows which, and an agent that noops still
    has a pane worth attaching to, so the caller is told rather than left to
    read it off a field set partway through.
    """
    try:
        ctx = build(args)
    except SystemExit:
        return Outcome("failed", None, False, None)
    agent_id = RESOLVER.field(ctx, "agentId")

    if args.explain:
        explain(ctx)

    # A lead belongs in your terminal, not a swarm pane: the masquerade is an
    # interactive session you drive, and a pane-backed lead would be reaped by
    # the next lead's exit anyway. No socket, no pane, no roster patch.
    if agent_id and agent_id == ctx.get("lead_agent_id"):
        if args.to_team:
            # This branch never reaches the rebind code, and a flag that
            # silently does nothing reads as having worked.
            die(f"--to-team moves a member between teams, and this agent is a "
                f"lead; to have this conversation lead another team, resume it "
                f"as that team's lead: {TOOL} team-lead@<team> --resume "
                f"{ctx['session_uuid']}")
        command = build_command(ctx, args, passthrough)
        # A lead is the socket's namesake - a swarm server is named after the
        # lead's pid, and members resolve theirs by asking who their lead is -
        # so where its crew already sits is a launch fact for the lead too.
        # Becoming the lead makes this process that pid, which is why the line
        # says which server the crew is on rather than which one it will own.
        lead_team = (ctx.get("placed") or (None,))[0] or RESOLVER.field(ctx, "teamName")
        crew_socket, crew_why = RESOLVER.crew_socket(lead_team, table)
        seat = [("cwd", RESOLVER.field(ctx, "cwd") or "(inherit)")]
        if crew_socket:
            seats = RESOLVER.crew_sockets(lead_team, table)
            # A lead can sit across several servers at once, because becoming
            # one gives this process a new pid and the next spawn creates a
            # server named after it. Naming one of them as the socket would be
            # a half-answer; the rest are named too, with what is on them.
            elsewhere = {s: who for s, who in seats.items() if s != crew_socket}
            seat.insert(0, ("socket", f"{crew_socket}  [{crew_why}] "
                                      f"({RESOLVER.socket_state(crew_socket)})"))
            for other, who in sorted(elsewhere.items()):
                seat.insert(1, ("also", f"{other} hosts {', '.join(who)} "
                                        f"({RESOLVER.socket_state(other)})"))
        report_launch(ctx, command, prefix, role="lead", agent_id=agent_id,
                      extra=seat)
        # A lead is not exec'd onto a conversation someone is already running,
        # for the same reason a member is not spawned onto one.
        running = already_running(ctx, args, is_lead=True)
        if running:
            return noop_outcome(ctx, args, prefix, is_lead=True, why=running[0])
        # This run is about to become the lead, so the identity gate applies from
        # here down.
        enforce_ctx(ctx, args)
        # Check what we are about to become before writing anything. Forging first
        # and discovering the binary is unusable second leaves a team dir behind for
        # a run that never launched, which is the same mutation-on-a-run-that-does-
        # not-happen the guard above prevents.
        if not args.dry_run and not shutil.which(command[0]):
            die(f"cannot exec {command[0]}: not found or not executable")
        # The masquerade reads the roster on boot, so the team dir has to exist
        # before the exec, and a lead whose team was reaped is the ordinary case
        # here rather than an edge one.
        forge_team(ctx, args.dry_run)
        # The lead runs last, after every member is already in its pane, so there is
        # nothing left for this process to stay alive for. A lead is an interactive
        # session you drive rather than a pane you watch, so the run ends by becoming
        # it. Starting it from the wrong directory would leave it unable to find its
        # own conversation, since --resume looks the transcript up under the project
        # dir of wherever it starts.
        if sys.stdout.isatty() and not args.dry_run:
            # Becoming the lead replaces this process, so anything the run was
            # still watching is never reported. Say what was outstanding rather
            # than let it vanish; waiting for it here would cost the terminal
            # forty-five seconds before the lead you asked for appears.
            if pending:
                names = ", ".join(label for label, _path, _since in pending)
                print(f"{prefix}loading  {len(pending)} member(s) had not written a transcript "
                      f"yet when this took over: {names}")
            enter_agent_cwd(ctx, prefix)
            print(f"{prefix}exec     taking over this terminal")
            try:
                os.execvp(command[0], command)
            except OSError as exc:
                # exec either replaces this process or does not happen, so reaching
                # here means the lead never started; say so rather than unwinding a
                # traceback through a tool that has already moved the cwd.
                die(f"cannot exec {command[0]}: {exc}")
        print(f"{prefix}run this in your terminal (leads are not spawned into tmux):")
        # still pastes as one command however it wrapped
        print(wrap_command(command, f"{prefix}  ", f"{prefix}    ", paste=True))
        return Outcome("manual", None, True, None)

    if args.to_team:
        dest = resolve_to_team(args, ctx)
        ctx["to_team"] = dest
        ctx["to_lead"] = RESOLVER.team_lead_session(dest)
        # A transcript that restores as another team un-does this rebind at
        # every restart; retiring that team (guards willing) makes the flags
        # win, the whole conversation intact.
        rebinding = getattr(ctx["resolution"], "path", None)
        stamped, state = (RESOLVER.restored_identity(rebinding)
                          if rebinding else (None, None))
        if state == "restored" and stamped != dest:
            rebind_reap(stamped, dest, args, prefix)
    else:
        forge_team(ctx, args.dry_run)
        auto_redirect(ctx, args, table, prefix)

    if args.here:
        # A member given this terminal takes the lead's route: exec, so the
        # process becomes the agent. No seat is resolved because none is used,
        # and nothing after this point in the run happens.
        command = build_command(ctx, args, passthrough)
        adopted = inherit_credentials(ctx)
        cwd = RESOLVER.agent_cwd(ctx)
        seat = [("runs", "in this terminal, not a tmux pane"),
                ("cwd", cwd or "(inherit)")]
        if adopted:
            seat.append(("creds", f"inherited {', '.join(adopted)} from the lead"))
        report_launch(ctx, command, prefix, role="agent", agent_id=agent_id, extra=seat)
        running = already_running(ctx, args, is_lead=False, agent_id=agent_id,
                                  table=table)
        if running:
            return noop_outcome(ctx, args, prefix, why=running[0], report=running[1])
        enforce_ctx(ctx, args)
        # Listed with no pane: a member that is running and reachable, which a
        # later team run places in a pane like any other.
        record_membership(ctx, args, None)
        # One line, both tenses, so the preview cannot drift from the act.
        print(f"{prefix}exec     this terminal "
              f"{'would become' if args.dry_run else 'becomes'} {agent_id}")
        if args.dry_run:
            return Outcome("manual", None, False, None)
        if not shutil.which(command[0]):
            die(f"cannot exec {command[0]}: not found or not executable")
        enter_agent_cwd(ctx, prefix)
        try:
            os.execvp(command[0], command)
        except OSError as exc:
            die(f"cannot exec {command[0]}: {exc}")

    socket, how = resolve_socket(ctx, args, table)
    if not socket:
        warn("could not determine a tmux socket; pass --socket claude-swarm-<lead-pid>")
        return Outcome("failed", None, False, None)

    cwd = RESOLVER.agent_cwd(ctx)
    want_pane = RESOLVER.field(ctx, "tmuxPaneId")
    if want_pane and not re.fullmatch(r"%\d+", str(want_pane)):
        want_pane = None  # e.g. the lead's "leader" placeholder
    want_pane, pane_said = RESOLVER.seat_note(want_pane, socket)

    command = build_command(ctx, args, passthrough)
    adopted = inherit_credentials(ctx)

    seat = [("socket", f"{socket}  [{how}] ({RESOLVER.socket_state(socket)})"),
            ("pane", pane_said),
            ("cwd", cwd or "(inherit)")]
    if adopted:
        seat.append(("creds", f"inherited {', '.join(adopted)} from the lead"))
    report_launch(ctx, command, prefix, role="agent", agent_id=agent_id, extra=seat)

    # Same agent already in that pane -> nothing to do. Anything else in it -> new pane.
    _, occupants = RESOLVER.pane_occupants(socket, want_pane, table) if want_pane else (False, [])
    worn = {pid for pid, _ in RESOLVER.wearers(agent_id, table)} if agent_id else set()
    here = [pid for pid, _cmd in occupants if pid in worn]
    others = [pid for pid, _ in occupants if pid not in here]

    strangers_hold, held_by_us = RESOLVER.transcript_holders(ctx["session_uuid"], table)
    if held_by_us and not args.force:
        die(f"you are running this transcript yourself (pid {held_by_us[0]}); "
            "nothing can replace a process from inside it. Exit first, or have "
            "the lead run this")

    replace_pane = None
    if ctx.get("to_team") and not ctx.get("auto_redirect"):
        # Explicit --to-team only: this is the migrate half, and it kills.
        # A redirected launch never reaches here, so the default cannot kill.
        # Never guess a pane here: pane ids are per-server, so a recorded id
        # from another socket names an unrelated pane on this one, and killing
        # it would take out a stranger while the old holder kept writing.
        for index, (pid, _) in enumerate(strangers_hold):
            holder_pane = RESOLVER.pane_of_pid(socket, pid, table)
            if index == 0 and holder_pane:
                replace_pane = holder_pane
                print(f"{prefix}rebind   replacing pid {pid} in pane {holder_pane}")
                continue
            where = f"in pane {holder_pane}" if holder_pane else f"outside {socket}"
            step(args.dry_run, f"would kill pid {pid}, which also holds this transcript {where}",
                 f"killing pid {pid}, which also holds this transcript {where}")
            if not args.dry_run:
                killed = subprocess.run(["kill", str(pid)], capture_output=True)
                # Two processes appending to one transcript is the state this
                # prevents, so a kill that did not work has to be said out loud
                # rather than reported as a clean rebind.
                if killed.returncode != 0 or RESOLVER.pid_alive(pid):
                    warn(f"pid {pid} did not die ({(killed.stderr or b'').decode().strip() or 'still running'}); "
                         "it is still appending to this transcript")
    # One step for every way this agent could already be alive: in this pane,
    # holding the transcript, or wearing this id elsewhere.
    running = already_running(ctx, args, is_lead=False, agent_id=agent_id,
                              table=table, here=here, pane=want_pane)
    if running:
        why, report = running
        if report and not args.no_tint:
            tint_pane(socket, want_pane, RESOLVER.field(ctx, "color"),
                      RESOLVER.field(ctx, "agentName"), args.dry_run)
        return noop_outcome(ctx, args, prefix, socket=socket, pane=want_pane,
                            report=report, why=why)
    if others and not replace_pane:
        warn(f"pane {want_pane} runs a different claude (pid {', '.join(map(str, others))}); using a new pane")

    # Every guard that could still turn this into a noop has passed, so the run
    # is about to act and the identity gate applies.
    enforce_ctx(ctx, args)

    # Already standing in the right place: run the agent in this pane instead of
    # splitting a new one and leaving the shell we were invoked from idle beside
    # it. Bookkeeping has to happen first, since exec never returns.
    in_socket, in_pane = RESOLVER.current_tmux()
    # Never when a tool is driving (its shell would be swallowed), never inside
    # --team (the loop would end), and never when a live holder has to be killed
    # first: exec cannot respawn the pane, so that case belongs to launch().
    if (in_socket == socket and in_pane and not replace_pane
            and not getattr(args, "in_team", False) and not os.environ.get("CLAUDECODE")):
        if in_pane == want_pane or not RESOLVER.pane_exists(socket, want_pane):
            print(f"{prefix}exec     you are in {in_pane} on {socket}; running here rather than splitting")
            if ctx.get("to_team"):
                register_member(RESOLVER.roster_record(ctx, team=ctx["to_team"]), in_pane, args.dry_run)
                if ctx["to_team"] != RESOLVER.field(ctx, "teamName"):
                    retire_member(ctx, args.dry_run)
            else:
                ensure_inbox(RESOLVER.field(ctx, "teamName"), RESOLVER.field(ctx, "agentName"), args.dry_run)
                if not args.no_update_config:
                    update_team_config(ctx, RESOLVER.roster_record(ctx), in_pane, args.dry_run)
            rendered = f"exec in {cwd or os.getcwd()}: {' '.join(shlex.quote(c) for c in command)}"
            step(args.dry_run, f"would {rendered}", rendered, indent=prefix)
            if args.dry_run:
                return Outcome("launched", socket, False, None)
            # The same environment and cwd launch() would have given it: the
            # team vars a flag-bound boot needs, the poison dropped if present, and
            # the project dir --resume looks the transcript up under.
            environ = dict(os.environ)
            if base_url_is_poison(environ.get("ANTHROPIC_BASE_URL")):
                warn("this shell carries the Recipe 1 poison; dropping it for the exec")
                environ.pop("ANTHROPIC_BASE_URL", None)
            environ.update(dict(pair.split("=", 1) for pair in TEAM_ENV))
            if not args.no_tint:
                tint_pane(socket, in_pane, RESOLVER.field(ctx, "color"), RESOLVER.field(ctx, "agentName"), False)
            enter_agent_cwd(ctx, prefix)
            try:
                os.execvpe(command[0], command, environ)
            except OSError as exc:
                # exec replaces this process or it does not happen at all, so
                # reaching here means the member the roster was just told about
                # does not exist. Take the claim back before failing.
                if ctx.get("to_team"):
                    retire_member(ctx, False)
                die(f"cannot exec {command[0]}: {exc}")

    try:
        launched_at = ctx["transcript"][0].stat().st_mtime
    except OSError:
        launched_at = 0.0
    # Claimed before the spawn, patched with its pane below. The boot looks
    # itself up in the roster on the way in, so an entry written only afterwards
    # is racing the launch it describes.
    claimed = reserve_membership(ctx, args)
    try:
        pane, action = launch(socket, want_pane, cwd, command, args.dry_run, replace_pane)
    except LaunchFailed as exc:
        # A member's pane is that member's problem. The run continues, so the
        # summary, the flag check and the write report still reach every agent
        # that did launch. The claim goes back first: nothing started, so the
        # roster must not be left describing a member that never existed.
        release_membership(claimed, args)
        warn(f"{prefix}{build_command_agent_id(ctx)} did not launch: {exc}")
        return Outcome("failed", socket, False, None)
    # At the steps' indent, not flush left: this is one of the things the launch
    # did, and a launch that alternates between two margins reads as two
    # interleaved reports rather than one sequence.
    print(fill(f"{prefix}  {'would run' if args.dry_run else 'running'} in pane "
               f"{pane or '<new>'} ({action})"))
    if not args.no_tint:
        tint_pane(socket, pane, RESOLVER.field(ctx, "color"), RESOLVER.field(ctx, "agentName"), args.dry_run)

    alive, wrote = True, True
    if not args.dry_run:
        alive, why = launch_survived(socket, pane, build_command_agent_id(ctx),
                                     ctx["transcript"][0], launched_at)
        wrote = alive and why == "wrote to its transcript"
        if alive:
            print(f"{prefix}alive    {why}")
        else:
            warn(f"the launch in pane {pane} is not running: {why}; recording it as inactive")

    record_membership(ctx, args, pane, alive)

    # A launch that has not written yet is not a verdict, only an unfinished
    # observation: the settle window is a second and a half and a healthy agent
    # takes tens of seconds to load a large session. Hand it back so the run can
    # answer it at the end rather than leaving "not yet" as the last word.
    unwritten = ((RESOLVER.field(ctx, "agentId") or ctx["session_uuid"][:8],
                  ctx["transcript"][0], launched_at) if alive and not wrote else None)
    return Outcome("launched" if alive else "failed", socket, False, unwritten)


def run_complete(topic):
    """Candidates on stdout, and nothing on stderr.

    This runs on every TAB. A warning here lands in the middle of whatever the
    user is typing, and the conditions that produce one (an uncorroborated
    claimant, a stale roster) are the ordinary state of the corpus rather than
    anything a completion should interrupt to report.
    """
    with contextlib.redirect_stderr(io.StringIO()):
        return _complete(topic)


def _complete(topic):
    """Emit completion candidates. `selector` prefixes each line with its group
    so one process serves all three, instead of paying interpreter startup thrice."""
    if topic == "selector":
        # A uuid is a valid selector, so the selector position offers them too;
        # they were previously reachable only behind --resume.
        for group in ("names", "teams", "leads"):
            buffer = io.StringIO()
            with contextlib.redirect_stdout(buffer):
                run_complete(group)
            for line in buffer.getvalue().splitlines():
                print(f"{group}\t{line}")
        return 0

    if topic == "sockets":
        for path in RESOLVER.swarm_sockets():
            state = "live" if RESOLVER.socket_alive(path) else "dead"
            print(f"{path.name}:{state}, {ms_str(int(path.stat().st_mtime * 1000))}")
        return 0

    if topic == "sessions":
        files = sorted(
            RESOLVER.transcripts_by_mtime()
        )
        for path in files:
            when = ms_str(int(path.stat().st_mtime * 1000))
            title = session_title(path, limit=COMPLETION_TITLE)
            desc = f"{title}  [{path.parent.name}, {when}]" if title else f"{path.parent.name}, {when}"
            print(f"{path.stem}:{desc}")
        return 0

    if topic == "sides":
        for e in RESOLVER.side_transcripts():
            name = e["name"] or e["task_id"]
            print(f"{e['parent'][:8]}/{name}:{e['grammar']}, {ms_str(e['mtime'])}")
        return 0

    entries = RESOLVER.scan_teams()
    entries.sort(key=lambda e: e["ts"], reverse=True)

    if topic == "agent-ids":
        for entry in entries:
            agent_id = entry["member"].get("agentId")
            if agent_id:
                ansi = "" if NO_COLOR else COLOR_ANSI.get(agent_colour(agent_id, entry["member"]), "")
                print(f"{agent_id}\tjoined {ms_str(entry['ts'])}\t{ansi}")
        return 0

    if topic == "teams":
        seen = set()
        for entry in entries:
            team = entry["team"]
            if team in seen:
                continue
            seen.add(team)
            count = sum(1 for e in entries if e["team"] == team)
            plural = "member" if count == 1 else "members"
            title = lead_title(entries, team, limit=COMPLETION_TITLE)
            when = ms_str(entry["ts"])
            if title:
                desc = f"{title}  [{count} {plural}, {when}]"
            elif not RESOLVER.team_souls(team):
                # Nothing in it resolves any more, which is also what the reaper
                # checks before removing the directory.
                desc = f"nothing left to resurrect, {count} {plural}, {when}"
            else:
                desc = f"{count} {plural}, {when}"
            print(f"{team}:{desc}")
        # A team outlives its directory, and the selector accepts and rebuilds
        # these, so listing only the tidy ones offers less than the tool takes.
        for team, evidence in sorted(RESOLVER.known_teams().items()):
            if team in seen:
                continue
            print(f"{team}:no roster, rebuildable from {evidence}")
        return 0

    if topic == "leads":
        seen = set()
        for entry in entries:
            agent_id = entry["member"].get("agentId")
            if not agent_id or agent_id in seen or agent_id != entry.get("leadAgentId"):
                continue
            seen.add(agent_id)
            # a bare "team-lead" names every team, so only full ids, titled
            title = lead_title(entries, entry["team"], limit=COMPLETION_TITLE)
            if not title and not RESOLVER.resolve_transcript(lead_session=entry.get("leadSessionId"),
                                                    team=entry.get("team"), is_lead=True, quick=True):
                title = "transcript gone, cannot be resumed"
            joined = f"joined {ms_str(entry['ts'])}"
            print(f"{agent_id}\t{title + ', ' + joined if title else joined}\t")
        for team, evidence in sorted(RESOLVER.known_teams().items()):
            if f"team-lead@{team}" in seen or RESOLVER.has_roster(team):
                continue
            path, why = RESOLVER.lead_transcript_for(team)
            if not path:
                continue
            title = session_title(path, limit=COMPLETION_TITLE)
            label = f"{title}, no roster" if title else f"no roster, found by {evidence}"
            print(f"team-lead@{team}\t{label}\t")
        return 0

    if topic == "names":
        # A roster is where an agent's colour and join time live, but not where
        # its existence is decided: the harness deletes a team dir when its lead
        # exits, leaving members that are still perfectly resurrectable. So the
        # candidates are every stamped transcript, enriched from the roster when
        # one survives.
        candidates = {}
        for path, (name, team) in RESOLVER.stamp_index().items():
            if not name or not team or name == "team-lead":
                continue
            agent_id = f"{name}@{team}"
            try:
                when = int(path.stat().st_mtime * 1000)
            except OSError:
                continue
            if agent_id not in candidates or when > candidates[agent_id][0]:
                candidates[agent_id] = (when, path, None)
        for entry in entries:
            member = entry["member"]
            agent_id, name = member.get("agentId"), member.get("name")
            if not agent_id or not name or agent_id == entry.get("leadAgentId"):
                continue
            known = candidates.get(agent_id)
            res = RESOLVER.resolve_transcript(team=entry["team"], name=name, quick=True)
            candidates[agent_id] = (
                max(entry["ts"], known[0] if known else 0),
                res.path if res else (known[1] if known else None),
                member,
            )
        # One row per agent. The same name is registered in several teams after
        # a rebind, and only one of those registrations is worth offering:
        # a live one, else one that resolves to a transcript, else the newest.
        # An entry that is neither live nor resolvable is a leftover claim.
        live_agents = {e["agent"] for e in RESOLVER.live_sessions() if e["alive"] and e["agent"]}
        best = {}
        for agent_id, (when, path, member) in candidates.items():
            name = agent_id.split("@", 1)[0]
            rank = (agent_id in live_agents, path is not None, when)
            if name not in best or rank > best[name][0]:
                best[name] = (rank, agent_id)
        candidates = {agent_id: candidates[agent_id] for _, agent_id in best.values()}

        # Grouped by the session they belong to, newest session first and newest
        # member first inside it. An agent whose roster is gone still names its
        # team in its transcript, so orphans sit with their own siblings rather
        # than scattered through one long list.
        by_team = collections.defaultdict(list)
        for agent_id, (when, path, member) in candidates.items():
            by_team[agent_id.split("@", 1)[-1]].append((when, agent_id, path, member))
        rosters = {e["team"] for e in RESOLVER.scan_teams()}
        for team in sorted(by_team, key=lambda t: max(w for w, *_ in by_team[t]), reverse=True):
            members = sorted(by_team[team], reverse=True)
            label = f"{team}  {ms_str(members[0][0])}"
            if team not in rosters:
                label += ", no roster"
            for when, agent_id, path, member in members:
                title = session_title(path, limit=COMPLETION_TITLE) if path else None
                stamp = f"joined {ms_str(when)}" if member else f"last active {ms_str(when)}"
                desc = f"{title}, {stamp}" if title else stamp
                ansi = "" if NO_COLOR else COLOR_ANSI.get(agent_colour(agent_id, member), "")
                print(f"{label}\t{agent_id}\t{desc}\t{ansi}")
        return 0

    die(f"unknown completion topic {topic!r}")


SOCKET_GRACE_S = 60  # never reap a socket younger than this; a server may be mid-bind


def cleanup_sockets(dry=False):
    """Remove the socket files the engine says have no server behind them.

    Which those are is the engine's answer (dead_sockets, a connect() per
    socket rather than a tmux spawn, because this runs from a SessionStart
    hook and has to be measured in milliseconds). What is left here is the
    unlinking and the line it prints.
    """
    removed = []
    for path in RESOLVER.dead_sockets():
        if dry:
            removed.append(path.name)
            continue
        try:
            path.unlink()
            removed.append(path.name)
        except OSError as exc:
            warn(f"cannot remove {path}: {exc}")
    if removed:
        print(f"{'would remove' if dry else 'removed'} {len(removed)} dead socket(s): {', '.join(removed)}")
    return 0


# A team dir is created before the things that prove its session is alive: the
# registry entry, the first spawn payload, the masquerade's argv. This covers
# that gap only. Age is not evidence of emptiness, so it stays small.
TEAM_GRACE_S = 300

# Descriptions in completion have a whole terminal row to themselves.
COMPLETION_TITLE = 400
# The abort listing is read under time pressure, with a finger on a key, so it
# gets a glance-sized title rather than the completion menu's paragraph.
ABORT_TITLE = 60
NO_COLOR = False  # zsh truncates to the real terminal width


def remove_if_cruft(path, dry, kind):
    """Delete a directory only after re-proving it holds nothing.

    Re-checked immediately before unlinking, and the loop refuses anything that
    appeared since, so a file landing mid-sweep stops the deletion instead of
    being swept up with it.
    """
    if not path.is_dir():
        return True
    if RESOLVER.roster_path(path.name).parent.parent not in path.parents \
            and (CLAUDE_DIR / "tasks") not in path.parents:
        warn(f"refusing to remove {path}: outside the directories this tool owns")
        return False
    if kind == "team":
        reason = RESOLVER.scaffolding_objection(path)
        if reason:
            warn(f"not removing {path.name}: {reason}")
            return False
    else:  # a task dir must be completely empty
        leftovers = list(path.iterdir())
        if leftovers:
            warn(f"not removing {path}: holds {', '.join(p.name for p in leftovers[:3])}")
            return False
    if dry:
        return True

    # Checking names is not enough: an inbox filename is in the verified set, so
    # mail arriving after the check would be deleted along with the directory.
    # Take the directory out of reach with an atomic rename, THEN re-prove it,
    # so a writer racing us either lands before the rename (and is seen) or
    # finds the path gone. Anything unexpected is put straight back.
    staged = path.with_name(f"{path.name}.reaping-{os.getpid()}")
    try:
        os.rename(path, staged)
    except OSError as exc:
        warn(f"cannot stage {path} for removal: {exc}")
        return False

    reason = RESOLVER.scaffolding_objection(staged) if kind == "team" else (
        f"holds {', '.join(p.name for p in list(staged.iterdir())[:3])}" if any(staged.iterdir()) else None
    )
    if reason:
        try:
            os.rename(staged, path)
            warn(f"not removing {path.name}: {reason} (appeared while removing; put back)")
        except OSError as exc:
            warn(f"{path.name}: {reason}, and restoring it failed: {exc}; it is at {staged}")
        return False

    try:
        # config.json last, so an interrupted deletion leaves something the
        # keep-checks still recognise as a team rather than a headless dir.
        for sub in sorted(staged.iterdir(), key=lambda p: p.name == "config.json"):
            if sub.is_dir():
                for inbox in sorted(sub.iterdir()):
                    inbox.unlink()
                sub.rmdir()
            else:
                sub.unlink()
        staged.rmdir()
    except OSError as exc:
        warn(f"cannot remove {staged}: {exc}")
        return False
    return True


def team_keep_reason(cfg, table):
    """Why this team must be kept, or None if nothing in it is resurrectable.

    Every fact here is an engine answer; what is left is the order they are
    asked in and the words the sweep prints.

    Empty means provably unresurrectable: no live process running as it, no
    lead transcript, and not one member with a transcript. Teams in that state
    are the residue of a Claude launch that registered a team at startup and
    exited before the first prompt, so nothing was ever written. Anything less
    certain is left alone; the cost of a stale directory is nothing, and the
    cost of deleting a resurrectable team is somebody's memory.
    """
    entries = [e for e in RESOLVER.scan_teams() if e["cfg"] == cfg]
    if not entries:
        return "unreadable or memberless roster"
    team, lead_session = entries[0]["team"], entries[0]["leadSessionId"]

    if RESOLVER.made_moments_ago(cfg.parent):
        return "created moments ago"
    pid, alive, _, _exact = RESOLVER.lead_pid(lead_session, team)
    if pid and alive:
        return f"pid {pid} is live for this team"
    # Both transcript questions go through the resolver, so "does a soul exist
    # here" is answered by the same engine that would resurrect it. Asking any
    # other way risks deleting something the tool could have brought back.
    souls = RESOLVER.team_souls(team, entries)
    if souls:
        return f"still resurrectable: {', '.join(sorted(souls))}"
    return RESOLVER.scaffolding_objection(cfg.parent)


def cleanup_teams(dry=False):
    """Remove team dirs that hold nothing resurrectable, and their task dirs."""
    removed = []
    table = RESOLVER.ps_table()
    for cfg in sorted(RESOLVER.roster_path(d.name) for d in RESOLVER.team_dirs()):
        keep = team_keep_reason(cfg, table)
        if keep:
            if dry:  # auditable, but not noise in the hook
                print(f"  keeping {cfg.parent.name}: {keep}")
            continue
        if not remove_if_cruft(cfg.parent, dry, "team"):
            continue
        remove_if_cruft(CLAUDE_DIR / "tasks" / cfg.parent.name, dry, "tasks")
        removed.append(cfg.parent.name)
    if removed:
        print(f"{'would remove' if dry else 'removed'} {len(removed)} empty team(s): {', '.join(removed)}")
    return removed


def run_standing(args):
    """Print where one agent stands with its lead. Reports, never acts."""
    agent_id = args.agent_id
    if not agent_id or "@" not in str(agent_id):
        die("--standing needs an agent, as name@team")
    s = RESOLVER.standing(agent_id)
    pid, alive, how, grade = s["lead"]
    print(f"agent    {s['agent_id']}")
    parent = RESOLVER.spawn_parent_of(agent_id)
    print(fill(f"parent   {parent[0] or '(none)'}  ({parent[1]})"))
    if pid:
        said_how = re.sub(rf"^pid {pid}, ", "", how) if how else None
        print(fill(f"lead     pid {pid}{'' if alive else ', not running'}"
                   + (f"  ({said_how})" if said_how else "") + f" [{grade}]"))
    else:
        print("lead     (none)")
    # A grade rates an answer. With no team to rate, the boot-timing grade would
    # describe a pairing that never happened, so an unknown says only that.
    said_team, said_grade = s["lead_team"]
    print(fill(f"runs as  {said_team}  [{said_grade}]" if said_team
               else "runs as  (unknown)"))
    said = {True: "yes", False: "no", None: "unknowable"}[s["polls"][0]]
    print(fill(f"polls    {said}  ({s['polls'][1]})"))
    print(f"listed   {'yes' if s['listed'] else 'no'}")
    reachable, why = s["reachable"]
    # "At its next turn boundary": delivery queues while a recipient's turn
    # runs, so the dossier must not imply an immediacy nothing guarantees.
    verdict = {True: "reaches its lead at its next turn boundary",
               False: "does not reach its lead",
               None: "may not reach its lead"}[reachable]
    print(fill(f"mail     {verdict}: {why}"))
    name, _, team = s["agent_id"].partition("@")
    res = RESOLVER.resolve_transcript(name=name, team=team, quick=True)
    held = res.path.stem if res and getattr(res, "path", None) else None
    fragile = RESOLVER.rebind_fragility(held, team)
    if fragile:
        print(fill(f"fragile  {fragile}"))
    addressed = RESOLVER.mail_ledger(team, to=name)
    held = sum(r["state"] == "in memory" for r in addressed)
    lost = sum(r["state"] == "unexplained" for r in addressed)
    if held or lost:
        print(fill(f"ledger   {held} in its memory, {lost} unexplained, of "
                   f"{len(addressed)} sends addressed to it"))
    for what, cost in s["remedies"]:
        print(fill(f"remedy   {what}  ({cost})"))
    return 0


# What each verdict claims, in the order of how much is wrong.
DOCTOR_LEGEND = (
    # Only what the verdict tests. Mail waiting in a mailbox does not demote a
    # team whose lead is live and reading it, and an unrecorded member is a note
    # rather than a fault, so claiming either here would describe a state this
    # verdict never asked about.
    ("CONNECTED", "a live lead runs this team and reads its mail, and nothing here needs a person"),
    ("DEGRADED", "nothing is lost yet, but a person must act: the team is dormant, "
                 "one agent is worn by two processes, or the crew sits on two servers"),
    ("UNKNOWABLE", "a plain lead reads the roster from its own memory, which cannot be "
                   "seen from outside"),
    ("SEVERED", "members are running or mail is waiting, and no live lead reads this team"),
)

# Colour restates a verdict for a glance; the word itself stays the carrier.
VERDICT_SGR = {"CONNECTED": "32", "DEGRADED": "33", "UNKNOWABLE": "36", "SEVERED": "31"}


def undelivered_mail_lines(rows):
    """Report lines for the ledger states a mailbox file cannot show.

    The inbox file is pruned the moment a busy recipient queues mail into
    memory, so the file's silence proves nothing; these lines carry the two
    states only the send-vs-delivery join can see. The counts are
    per-recipient facts and stay per-recipient; the physics is shared and
    is said once, however many recipients hold mail.
    """
    out = []
    held = collections.Counter(r["to"] for r in rows if r["state"] == "in memory")
    if held:
        out.append("mail     " + ", ".join(f"{count} in {to}'s memory"
                                           for to, count in held.most_common()))
        out.append(f"{'':9}delivery waits on each holder's next turn boundary "
                   "and dies with its process")
    for r in rows:
        if r["state"] == "unexplained":
            out.append(f"mail     unexplained: {r['sender']} -> {r['to']} at "
                       f"{ms_str(r['sent'])}  {(r['summary'] or '')[:40]}")
    return out


def diagnose_team(team, table=None, deep=False):
    """(verdict, lines, remedies) for one team. Asks the engine; reads nothing.

    Every fact here is an answer, so the doctor cannot reach a conclusion the
    tool would not reach when it acts. `deep` adds the send-vs-delivery join,
    which reads every member transcript in full and so runs only for a named
    team, never in the sweep.
    """
    table = RESOLVER.ps_table() if table is None else table
    pid, alive, how, _exact = RESOLVER.lead_pid(None, team)
    lead_team, exact_team = RESOLVER.team_minted_by(pid) if (pid and alive) else (None, False)
    worn = RESOLVER.worn_team(pid) if (pid and alive) else None
    population = RESOLVER.team_population(team)
    listed = [n for n, (state, _w) in population.items() if state == "listed"]
    unrecorded = [n for n, (state, _w) in population.items() if state == "unrecorded"]
    former = [n for n, (state, _w) in population.items() if state == "former"]
    converted = [n for n, (state, _w) in population.items() if state == "converted"]
    mail = RESOLVER.inbox_state(team)
    waiting = {n: v for n, v in mail.items() if v[0]}
    torn = {n: v[1] for n, v in mail.items() if v[0] is None}
    live = {n: RESOLVER.wearers(f"{n}@{team}") for n in population}
    live = {n: w for n, w in live.items() if w}
    doubled = sorted(n for n, w in live.items() if len({p for p, _t in w}) > 1)

    if pid:
        # The parenthetical is the evidence; it already led with the pid once,
        # and the line says a fact once.
        said_how = re.sub(rf"^pid {pid}, ", "", how) if how else None
        lines = [f"lead     pid {pid}{'' if alive else ', not running'}"
                 + (f"  ({said_how})" if said_how else "")]
    else:
        lines = ["lead     (none)"]
    # Through the helper that already answers this, so the engine still does the
    # picking. A team whose roster is gone has no recorded lead session and so no
    # title here, which is the honest gap rather than the doctor choosing a file.
    title = lead_title(RESOLVER.roster_entries(team=team), team, limit=64)
    if title:
        lines.append(f"title    {title}")
    if pid and alive:
        # Same rule as the dossier: no answer, no grade for it.
        grade = "exact" if exact_team else "inferred from boot timing"
        lines.append(f"runs as  {lead_team}  [{grade}]" if lead_team
                     else "runs as  (unknown)")
    lines.append(f"members  {len(listed)} listed, {len(unrecorded)} unrecorded, "
                 f"{len(former)} former, {len(live)} live"
                 + (f", {len(converted)} converted" if converted else ""))
    # A lead never sits in a pane, so it is not part of the seat count. Counting
    # it would call every team with a live masqueraded lead split.
    seats = {RESOLVER.socket_hosting([f"{n}@{team}"], table)[0]
             for n in live if n != "team-lead"}
    seats.discard(None)
    split = len(seats) > 1
    if split:
        lines.append(f"warning  its crew is seated on {len(seats)} servers: "
                     f"{', '.join(sorted(seats))}")
    # One note per state, however many members share it: eight members in one
    # state are one fact about eight names, not eight sentences.
    if unrecorded:
        one = len(unrecorded) == 1
        lines.append(f"note     {', '.join(sorted(unrecorded))} "
                     f"{'is' if one else 'are'} running and in no roster; "
                     f"resuming {'it' if one else 'each'} registers it")
    if converted:
        one = len(converted) == 1
        lines.append(f"note     {', '.join(sorted(converted))} "
                     f"{'was' if one else 'were'} promoted and "
                     f"{'has' if one else 'have'} not launched; "
                     f"{'its receipt is its' if one else 'their receipts are their'} "
                     "membership until then")
    for name, (count, oldest) in sorted(waiting.items()):
        lines.append(f"mail     {count} waiting for {name}, oldest {said_when(oldest)}")
    for name, why in sorted(torn.items()):
        lines.append(f"mail     {name}'s inbox is {why}; its contents are unknown")
    if deep:
        checked = set()
        for name, procs in sorted(live.items()):
            for _pid, held in procs:
                if not held or held in checked:
                    continue
                checked.add(held)
                fragile = RESOLVER.rebind_fragility(held, team)
                if fragile:
                    lines.append(f"note     {name} {fragile}")
        lines.extend(undelivered_mail_lines(RESOLVER.mail_ledger(team)))
    for name in doubled:
        lines.append(f"warning  {name} is worn by {len(live[name])} processes at once")

    reads = bool(pid and alive and lead_team == team)
    remedies = []
    if (waiting or live) and not reads:
        verdict = "SEVERED"
        remedies.append((f"{TOOL} {team}", "rebuilds the roster and places its members"))
        if pid and alive and lead_team and lead_team != team:
            remedies.append(("--to-team live on each member", "restarts them onto {lead_team}"
                             .format(lead_team=lead_team)))
    elif not reads:
        # Dormant, and the block so far has only said what is there. A reader of
        # one block cannot tell which of the three degraded states it is looking
        # at unless a line says, so this arm says it too.
        verdict = "DEGRADED"
        lines.append("warning  this team is dormant: no member of it is running, "
                     "no mail is waiting, and no live lead reads it")
        if listed:
            remedies.append((f"{TOOL} {team}", "starts the members its roster lists"))
        else:
            # A run of a team with nothing listed either forges a roster from the
            # transcript that spawned into it, or refuses naming what it could
            # not find. Which one happens is a transcript walk this sweep does
            # not pay for, so the remedy names both outcomes rather than
            # promising the one it cannot know it will get.
            remedies.append((f"{TOOL} {team}",
                             "rebuilds a roster from the transcripts and starts what "
                             "it recovers, or refuses saying what it could not find"))
    elif not worn:
        verdict = "UNKNOWABLE"
        # Both ways to make the lead read, cheap one first: it learns of
        # members only from its own spawns or a flag-bound boot, never from
        # a roster written from outside.
        remedies.append(("start any teammate from inside the lead",
                         "it starts reading mail immediately; costs nothing"))
        remedies.append((f"{TOOL} team-lead@{team}",
                         "restarts the lead with team flags; it reads this roster "
                         "on the way up and loses its current turn"))
    elif doubled or split:
        # A verdict names what an operator must act on. Former members are the
        # trace of work that finished; an unrecorded one is fixed by the next run
        # of it. What is left needs a person: two processes on one agent are a
        # turn from the two-writers state, and a split crew stays split.
        verdict = "DEGRADED"
        if split:
            remedies.append((f"{TOOL} {team}", "reseats the crew together"))
        for name in doubled:
            # Two steps, because --stop resolves an agent id to every process
            # wearing it and ends each one; the id names both wearers, so the
            # stop cannot be aimed at one of them and the resume is what leaves
            # exactly one behind.
            remedies.append((f"{TOOL} --stop {name}@{team}",
                             f"ends all {len(live[name])} processes wearing that id"))
            remedies.append((f"{TOOL} {name}@{team}", "starts one of them again"))
    else:
        verdict = "CONNECTED"
    return verdict, lines, remedies


def run_doctor(args, selector=None):
    """Say whether each team's lead is connected to it. Diagnoses, never treats."""
    named = args.team or (args.agent_id or "").partition("@")[2] or None
    if not named and selector:
        kind, value, _why = RESOLVER.classify(selector)
        named = value if kind == "team" else (value or "").partition("@")[2] or None
    target = named or None
    if target:
        # The named team is the declared need; a census of every team on the
        # machine answers a question this run never asks.
        teams, skipped = [target], 0
    else:
        everything = RESOLVER.known_teams()
        interesting = RESOLVER.teams_with_live_evidence()
        teams = sorted(interesting) if not args.all_members else sorted(everything)
        skipped = 0 if args.all_members else len(everything) - len(teams)
    worst, seen = 0, set()
    for team in teams:
        verdict, lines, remedies = diagnose_team(team, deep=bool(target))
        seen.add(verdict)
        print("\n" + f"{verdict:<11} {team}".replace(
            verdict, tint(verdict, VERDICT_SGR.get(verdict)), 1))
        for line in lines:
            print(fill(f"  {line}"))
        for what, cost in remedies:
            print(fill(f"  remedy   {what}  ({cost})"))
        if verdict == "SEVERED":
            worst = 1
    if skipped:
        print(fill(f"\n{skipped} team(s) with nothing live and no waiting mail "
                   f"were not examined; --all covers them"))
    if not target and teams:
        print(fill("\nmail beyond the inbox files is joined for a named team only; "
                   "--mail-ledger <team> shows it for any team"))
    for stem in RESOLVER.nameless_receipts():
        print(fill(f"\nnote     receipt {stem[:8]} is materialized without a recorded "
                   "identity, so no team can count it; re-promote to record one"))
    # The legend explains the verdicts on screen; a rulebook recited under a
    # single-team report says three things that did not happen.
    if seen:
        print("\nverdict" + ("s" if len(seen) > 1 else ""))
        for name, meaning in DOCTOR_LEGEND:
            if name in seen:
                print(fill(f"  {name:<11} {meaning}").replace(
                    name, tint(name, VERDICT_SGR.get(name)), 1))
    return worst


RECEIPTS_DIR = CLAUDE_DIR / TOOL / "receipts"


def load_receipt(stem):
    """The stored conversion receipt for this root uuid, or None."""
    try:
        return json.loads((RECEIPTS_DIR / f"{stem}.json").read_text())
    except (OSError, ValueError):
        return None


def materialize(plan):
    """Apply a proved promote. The only mover of a side transcript.

    Dest first, receipt second, and only then does the source leave: a crash
    between steps leaves two copies on disk, never zero. The receipt is
    load-bearing evidence and is never evicted; a re-conversion appends to
    its history rather than replacing its story.
    """
    if plan["objections"] or not plan["proved"]:
        raise ValueError("materialize was handed an unproved plan")
    dest, source = plan["dest_path"], plan["source"]
    try:
        keep_mode = source.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    replace_text(dest, "\n".join(plan["lines"]) + "\n", mode=keep_mode)
    receipt = dict(plan["receipt"])
    receipt.update({"source": str(source), "dest": str(dest),
                    "state": "materialized", "at": int(time.time() * 1000)})
    RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
    prior = load_receipt(receipt["root"] or dest.stem)
    if prior:
        receipt["history"] = prior.get("history", []) + [
            {k: prior.get(k) for k in ("state", "at")}]
    replace_json(RECEIPTS_DIR / f"{receipt['root'] or dest.stem}.json", receipt)
    source.unlink()
    meta = source.with_name(source.stem + ".meta.json")
    if meta.exists():
        meta.unlink()
    return receipt


def embed(plan):
    """Apply a proved demote. The only mover of a teammate into subagents/."""
    if plan["objections"] or not plan["proved"]:
        raise ValueError("embed was handed an unproved plan")
    dest, source = plan["dest_path"], plan["source"]
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        keep_mode = source.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    replace_text(dest, "\n".join(plan["lines"]) + "\n", mode=keep_mode)
    receipt = dict(plan["receipt"])
    meta_path = dest.with_name(dest.stem + ".meta.json")
    if receipt.get("meta"):
        replace_text(meta_path, receipt["meta"])
    else:
        # No stored meta means this teammate was born one; the synthesized
        # meta says so instead of pretending a fork history.
        replace_text(meta_path, json.dumps(
            {"isFork": False, "description": f"demoted from session {source.stem}"}))
    root = receipt.get("root") or source.stem
    receipt.update({"source": str(source), "dest": str(dest),
                    "state": "embedded", "at": int(time.time() * 1000)})
    RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
    prior = load_receipt(root)
    if prior:
        receipt["history"] = prior.get("history", []) + [
            {k: prior.get(k) for k in ("state", "at")}]
    replace_json(RECEIPTS_DIR / f"{root}.json", receipt)
    source.unlink()
    return receipt


def reap_team(team, archive_mail=False):
    """Retire a team so restore can no longer adopt it. The rebind's one act.

    Everything leaves through the receipt first: the roster verbatim, every
    inbox's bytes when archiving. Then the known files go, and the emptied
    directory is handed to remove_if_cruft, whose rename-then-reprove refuses
    anything that landed mid-reap. A refused directory still rebinds - the
    bail needs only the roster gone - and is said, not hidden.
    """
    team_dir = RESOLVER.teams_dir / team
    receipt = {"kind": "rebind-reap", "team": team, "at": int(time.time() * 1000),
               "config": None, "mail": {}}
    cfg = RESOLVER.roster_path(team)
    try:
        receipt["config"] = cfg.read_text()
    except OSError:
        pass
    boxes = sorted((team_dir / "inboxes").glob("*.json")) if (
        team_dir / "inboxes").is_dir() else []
    for box in boxes:
        try:
            receipt["mail"][box.name] = box.read_text()
        except OSError:
            receipt["mail"][box.name] = None
    RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
    replace_json(RECEIPTS_DIR / f"{team}.json", receipt)
    for path in [cfg, *cfg.parent.glob("config.json.bak*"), *boxes]:
        try:
            path.unlink()
        except OSError:
            pass
    if (team_dir / "inboxes").is_dir():
        try:
            (team_dir / "inboxes").rmdir()
        except OSError:
            pass
    if team_dir.is_dir() and not remove_if_cruft(team_dir, dry=False, kind="team"):
        warn(f"{team}'s directory would not empty; the roster is archived and "
             "gone, which is what the rebind needs")
    return RECEIPTS_DIR / f"{team}.json"


def apply_restamp(plan):
    """Apply a proved restamp. Receipt first, mandatorily: a restamp that
    cannot write its confession refuses before touching the file."""
    if plan["objections"] or not plan["proved"]:
        raise ValueError("apply_restamp was handed an unproved plan")
    path = plan["path"]
    RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)
    replace_json(RECEIPTS_DIR / f"{path.stem}.restamp.json", plan["receipt"])
    try:
        keep_mode = path.stat().st_mode & 0o777
    except OSError:
        keep_mode = 0o600
    replace_text(path, "\n".join(plan["lines"]) + "\n", mode=keep_mode)


def reap_blockers(stamped, args, table=None):
    """Why this team cannot be retired: one line per objection, each class
    closed by its way out. Read-only, so a caller can know it is blocked
    before it asks anyone anything - the reason a redirect presents one
    decision and not three.

    The lines are shaped for warn/die: bullets under the caller's opening
    sentence, so ten objections read as a list rather than a wall, and a
    bounded list says how much it left out.
    """
    table = RESOLVER.ps_table() if table is None else table
    objections = RESOLVER.reap_objections(stamped, table,
                                          archive_mail=args.with_mail)
    held = [o for o in objections if "holds" in o]
    alive = [o for o in objections if o not in held
             and ("wears" in o or "operates" in o)]
    mail = [o for o in objections if o not in held and o not in alive]
    lines = []

    def blocker(items, escape):
        lines.extend(f"- {item}" for item in items[:4])
        if len(items) > 4:
            lines.append(f"- and {len(items) - 4} more like these")
        lines.append(f"  ({escape})")

    if mail:
        blocker(mail, "--with-mail archives it into the receipt")
    if alive and not args.force:
        blocker(alive, "--force instead rewrites the team this conversation "
                       "comes back as: two fields, receipted, reversible")
    if held:
        blocker(held, "stop it first; nothing forces this one")
    return lines


def rebind_reap(stamped, dest, args, prefix="", path=None, fatal=True):
    """Retire the stamped team so a rebind onto dest holds - or, on --force
    against a living team, restamp the window-start instead.

    --force never buys a reap: it buys the OTHER trade, two fields of
    testimony rewritten in place with a receipt confessing the old values.
    Mail objections keep their own remedy (--with-mail); a live holder of
    the transcript itself is absolute either way - a whole-file replace
    under a live appender is the lost-update disease, self-inflicted.

    Invariant, not accident: the destination team's roster must be readable
    at boot or the session comes up identity-less. The tool meets it because
    registration precedes launch; if that order ever changes, this sentence
    is the tripwire. A reaped life also applies no teamAllowedPaths (hook
    init is structurally unreachable with the stamped team absent); a
    restamped life keeps its hooks, since the destination roster loads.
    """
    table = RESOLVER.ps_table()
    lines = reap_blockers(stamped, args, table)
    if lines:
        said = (f"a rebind onto {dest} needs {stamped} retired, and it "
                "refuses:\n" + "\n".join(lines))
        # A redirect is a courtesy the run offers, so it reports and leaves
        # the agent where it is; an explicit --to-team was asked for, so it
        # stops the run.
        if fatal:
            die(said)
        warn(said)
        return False
    # Nothing objects that --force does not answer: a live wearer is what the
    # restamp is for, and reap_blockers has already withheld it under --force.
    if args.force and RESOLVER.reap_objections(stamped, table,
                                               archive_mail=args.with_mail):
        strangers, ours = RESOLVER.transcript_holders(path.stem, table) if path else ([], [])
        if strangers or ours:
            pid = strangers[0][0] if strangers else ours[0]
            die(f"pid {pid} holds this transcript; a restamp under a live "
                "writer loses whatever it writes next. Stop it first, then "
                "retry with --force")
        plan = RESOLVER.restamp_plan(path, dest)
        if plan["objections"] or not plan["proved"]:
            die("; ".join(plan["objections"]) or "the rewrite could not be proved")
        step(args.dry_run,
             f"would rewrite the team this conversation comes back as: {stamped} "
             f"-> {dest}  (receipt: {RECEIPTS_DIR / (path.stem + '.restamp.json')})",
             f"rewrote the team this conversation comes back as: {stamped} "
             f"-> {dest}  (receipt: {RECEIPTS_DIR / (path.stem + '.restamp.json')})",
             indent=prefix)
        if not args.dry_run:
            apply_restamp(plan)
        print(f"{prefix}rebound  this transcript runs as {dest} from now on; "
              "nothing further is needed")
        return True
    receipt = RECEIPTS_DIR / f"{stamped}.json"
    print(f"{prefix}{'would reap' if args.dry_run else 'reaped'}   {stamped}  "
          f"(roster archived: {receipt})")
    if not args.dry_run:
        reap_team(stamped, archive_mail=args.with_mail)
    print(f"{prefix}rebound  this transcript now runs as {dest}")
    print(fill(f"{prefix}fragile  it goes back to {stamped} if that team is ever "
               f"recreated; run /compact in it to make {dest} permanent"))
    print(fill(f"{prefix}quiet    until then it sends no idle notifications; "
               "mail still works in both directions"))
    return True


def run_promote(args):
    """--promote <side> [--as name@team]: a side transcript becomes a teammate."""
    entry, why = RESOLVER.side_transcript(args.promote)
    if not entry:
        die(why)
    name, team = None, None
    if args.as_:
        name, _, team = args.as_.partition("@")
        name, team = name or None, team or None
    defaulted = not name
    name = name or entry["name"] or entry["task_id"]
    if not team:
        die("the destination team must be typed: --as name@team")
    # The spoken identity goes in before the plan is built, because until the
    # first launch registers this member the promoted transcript is the only
    # thing that says who it is, and it says so in the line it carries.
    plan = RESOLVER.conversion_plan(entry["path"], "promote",
                                    identity=(name, team))
    if plan["objections"] or not plan["proved"]:
        die("; ".join(plan["objections"]) or "the inverse could not be proved")
    dest = plan["dest_path"]
    if dest.exists():
        die(f"a transcript already exists at {dest}; refusing the collision")
    settled = int(time.time() * 1000) - 60_000
    if entry["mtime"] >= settled and not args.force:
        die("this side transcript was written within the last minute; its task "
            "may still be running. --force to convert it anyway")
    print(f"promote  {entry['parent'][:8]}/{entry['name'] or entry['task_id']}  "
          f"({entry['grammar']}, {len(plan['lines'])} lines)")
    if defaulted:
        print(f"name     {name}  (from the side transcript's meta)")
    print(f"as       {name}@{team}")
    print(f"into     {dest}")
    print(f"receipt  {RECEIPTS_DIR / (plan['receipt']['root'] or dest.stem)}.json")
    # One spelling of the launch line; the dry and real paths differ only in
    # their annotation, so the preview cannot drift from what a run prints.
    launch = [sys.argv[0], f"{name}@{team}", "--resume", dest.stem]
    launch_line = f"launch   {shlex.join(launch)}"
    if args.dry_run:
        print(f"{launch_line}  (dry run; nothing written)")
        return 0
    materialize(plan)
    if args.no_launch:
        print("member   recorded in the receipt; the population and the doctor "
              "see it, and the first launch registers it")
        print(f"{launch_line}")
        return 0
    os.execvp(launch[0], launch)


def run_demote(args):
    """--demote <session> [--into <parent>]: a teammate becomes a side transcript."""
    path, mate, mate_team = RESOLVER.demote_subject(args.demote)
    if not path:
        die(f"no transcript for {args.demote!r}; name the session uuid")
    stored = load_receipt(path.stem)
    table = RESOLVER.ps_table()
    # Both halves of the holder question, self first: the agent demoting the
    # very transcript it is running is the caller this gate most needs to
    # stop. No --force: embedding the file one's own harness will next flush
    # is never right.
    holders, selfhold = RESOLVER.transcript_holders(path.stem, table)
    if selfhold:
        die(f"you are demoting the transcript you are running (pid "
            f"{selfhold[0]}); nothing can embed a conversation from inside it")
    if holders and not args.force:
        die(f"pid {holders[0][0]} holds this transcript; demoting it would "
            "strand a live writer. --force overrides")
    beheads = RESOLVER.live_led(path.stem)
    if beheads and not args.force:
        die(f"this transcript leads {', '.join(beheads)} with members running; "
            "demoting it beheads them. --force overrides")
    if mate_team and mate:
        waiting = RESOLVER.inbox_state(mate_team).get(mate)
        if waiting and waiting[0] is None and not args.with_mail:
            die(f"{mate}'s inbox in {mate_team} is {waiting[1]}; it may hold "
                "mail this demote would orphan. Repair it, or pass --with-mail "
                "to archive its bytes into the receipt")
        if waiting and waiting[0] and not args.with_mail:
            die(f"{waiting[0]} message(s) wait in {mate_team}'s inbox for {mate}, "
                f"oldest {waiting[1]}; read them first or pass --with-mail "
                "to archive them into the receipt")
    plan = RESOLVER.conversion_plan(path, "demote", into=args.into, stored=stored)
    if plan["objections"] or not plan["proved"]:
        die("; ".join(plan["objections"]) or "the inverse could not be proved")
    if plan["dest_path"].exists():
        die(f"a side transcript already exists at {plan['dest_path']}; "
            "refusing the collision")
    print(f"demote   {path.stem[:8]}  ->  {plan['dest_path']}")
    if args.dry_run:
        return 0
    if mate_team and mate and args.with_mail:
        box = RESOLVER.teams_dir / mate_team / "inboxes" / f"{mate}.json"
        try:
            plan["receipt"]["mail"] = box.read_text()
            replace_json(box, [])
        except OSError:
            pass
    embed(plan)
    print(f"receipt  {RECEIPTS_DIR}/{plan['receipt'].get('root') or path.stem}.json")
    return 0


def run_mail_ledger(selector=None):
    """A team's mail, send side joined against delivery side. Read-only."""
    if not selector:
        die("--mail-ledger needs a team, as session-<id> or a prefix of it")
    team = selector if selector.startswith("session-") else f"session-{selector[:8]}"
    ledger = RESOLVER.mail_ledger(team)
    if not ledger:
        die(f"no authored mail found for {team} (no stamped transcripts, or "
            "nobody used SendMessage)")
    for entry in ledger:
        print(f"{ms_str(entry['sent'])}  {entry['sender']:>14} -> {entry['to'] or '?':<14} "
              f"{entry['state']:<12} {(entry['summary'] or '')[:44]}")
        if entry["state"] not in ("delivered", "protocol"):
            print(f"{'':22}{entry['detail']}")
    tallies = collections.Counter(e["state"] for e in ledger)
    print("\n" + ", ".join(f"{n} {state}" for state, n in tallies.most_common()))
    return 1 if tallies.get("unexplained") else 0


def run_sides(selector=None):
    """List side transcripts grouped under the sessions they hang from,
    newest first. Read-only; the engine classifies.

    The grammar column is the load-bearing one: conversion acts only on the
    two shapes it can prove an inverse for, so this listing is also the
    census of what a promote could and could not touch. A machine-wide
    sweep shows each parent's newest few and counts the rest by grammar,
    because nine hundred interleaved rows are a dump, not a report; naming
    a parent lists it in full.
    """
    sides = RESOLVER.side_transcripts()
    named = bool(selector)
    if selector:
        want = selector[len("session-"):] if selector.startswith("session-") else selector
        sides = [e for e in sides if e["parent"].startswith(want)]
        if not sides:
            die(f"no side transcripts under a session starting {selector!r}")
    sides.sort(key=lambda e: e["mtime"], reverse=True)
    counts = collections.Counter(e["grammar"] for e in sides)

    by_parent = {}
    for e in sides:
        by_parent.setdefault(e["parent"], []).append(e)
    shown_parents = list(by_parent) if named else list(by_parent)[:15]
    if not named:
        plural = "s" if len(by_parent) != 1 else ""
        print(fill(f"side transcripts under {len(by_parent)} session{plural}, "
                   "most recently active first; --sides <session> lists one in full"))
    cap = None if named else 3
    for parent in shown_parents:
        entries = by_parent[parent]
        breakdown = collections.Counter(e["grammar"] for e in entries)
        said = ", ".join(f"{n} {g}" for g, n in breakdown.most_common())
        print(f"\n{parent}  ({said})")
        title = RESOLVER.transcript_title(parent)
        if title:
            print(fill(f"  {title}"))
        for e in entries[:cap]:
            name = e["name"] or e["task_id"]
            kind = e["agent_type"] or "?"
            print(f"  {name:32} {e['grammar']:15} {kind:16} {ms_str(e['mtime'])}")
            if e["grammar"] == "unclassifiable":
                print(fill(f"    {e['detail']}"))
        left = len(entries) - len(entries[:cap])
        if left:
            print(f"  ...and {left} more  (--sides {parent[:8]} lists them)")
    folded_parents = len(by_parent) - len(shown_parents)
    if folded_parents:
        folded_count = sum(len(by_parent[p]) for p in list(by_parent)[15:])
        print(fill(f"\n...and {folded_parents} older "
                   f"session{'s' if folded_parents != 1 else ''} holding "
                   f"{folded_count} side transcript{'s' if folded_count != 1 else ''}; "
                   "--sides <session> lists any of them"))
    total = sum(counts.values())
    print(f"\n{total} side transcript{'s' if total != 1 else ''}: " +
          ", ".join(f"{n} {g}" for g, n in counts.most_common()))
    return 0


def run_census():
    """Count what this machine's ~/.claude actually contains. Read-only.

    Every number comes from the readers the tool itself resolves with, which is
    the point. A probe that re-implements a reader judges the behaviour by
    its own answer: a regex that cannot tell a label record from an identity
    stamp reports damage that does not exist, and a bounded window read as if
    it were the whole file reports a session title as an identity. A census built on the
    engine cannot disagree with the engine; if a reader is wrong, the census
    reports something implausible instead of accusing the tool.

    The shapes differ between machines, which is why the frequencies live in a
    command rather than in a docstring: run it on the box in question.

    What it counts is that box, not the harness. A ~/.claude is written by the
    harness, by this tool, and by anyone following the hand-forging recipes, and
    the last two leave rosters that look like the first. So a shape seen here is
    evidence that the shape occurs, never evidence that the harness produces it:
    check whether our own ecosystem could have written it before concluding
    anything about the harness from a count.
    """
    print(f"census of {CLAUDE_DIR}\n")

    rosters = RESOLVER.rosters()
    members = [(cfg, data, member) for cfg, data, _ in rosters
               for member in data.get("members", [])]
    id_agrees = sum(1 for _, _, m in members
                    if m.get("agentId") and m.get("name")
                    and m["agentId"].split("@", 1)[0] == m["name"])
    id_total = sum(1 for _, _, m in members if m.get("agentId") and m.get("name"))
    lead_agrees = sum(1 for _, data, _ in rosters_leads(rosters)
                      if data.get("leadAgentId") == f"team-lead@{data.get('name')}")
    print("identity")
    print(f"  roster members whose id is name@team   {id_agrees}/{id_total}")
    print(f"  rosters whose lead is team-lead@team   {lead_agrees}/{len(rosters)}")

    payload_pairs = [(p.get("agent_id"), p.get("name"), p.get("team_name"))
                     for p in RESOLVER.spawn_payloads()]
    payload_ok = sum(1 for aid, name, team in payload_pairs
                     if aid and name and team and aid == f"{name}@{team}")
    payload_total = sum(1 for aid, name, team in payload_pairs if aid and name and team)
    print(f"  spawn payloads whose id is name@team   {payload_ok}/{payload_total}")

    resolves = sum(1 for _, data, _ in rosters
                   if data.get("leadSessionId") and RESOLVER.transcript_path(data["leadSessionId"]))
    named = sum(1 for _, data, _ in rosters if data.get("leadSessionId"))
    print("\nleads")
    print(f"  rosters naming a lead session          {named}/{len(rosters)}")
    print(f"  ...whose session is a real transcript  {resolves}/{named}")
    print("  ...which is the shape resolved from the roster alone; the rest are")
    print("     found through the records of who spawned whom")

    known = RESOLVER.known_teams()
    by_evidence = collections.Counter(known.values())
    print("\nteams")
    for evidence, count in by_evidence.most_common():
        print(f"  {evidence:38} {count}")
    # Two columns, each labelled, because "contested" means two different things
    # and an unlabelled count of either invites a disagreement between people who
    # are both measuring correctly.
    claimed = {t: {path for _stamp, path in hits} for t, hits in RESOLVER.led_teams().items()}
    contested = {t: paths for t, paths in claimed.items() if len(paths) > 1}
    unresolved = [t for t in contested if not RESOLVER.lead_transcript_for(t)[0]]
    print(f"  teams claimed by several transcripts    {len(contested)}"
          + (f" (up to {max(len(v) for v in contested.values())} each)" if contested else ""))
    print(f"  ...still unresolved after corroboration {len(unresolved)}")
    print("  ...the rest are decided by the ladder; these are refused, not guessed")


    stamps = RESOLVER.stamp_index()
    both = sum(1 for name, team in stamps.values() if name and team)
    name_only = sum(1 for name, team in stamps.values() if name and not team)
    print("\ntranscripts")
    print(f"  stamped with a name and a team         {both}")
    print(f"  stamped with a name and no team        {name_only}")
    print("  ...either ran team-less or were launched with mismatched team flags")
    return 0


def rosters_leads(rosters):
    """The roster entries that name a lead, for counting."""
    return [(cfg, data, mtime) for cfg, data, mtime in rosters if data.get("leadAgentId")]


def run_cleanup(dry=False):
    """Everything the SessionStart hook does: reap what nothing can use.

    No record is kept of the id a boot is handed: it names the transcript,
    not the team the boot mints.
    """
    cleanup_sockets(dry)
    cleanup_teams(dry)
    return 0


HOOK_MARKER = "--cleanup"


def replace_json(path, data, indent=2, raw=False, mode=None):
    """One implementation of the atomic whole-file-write guarantee; every
    writer routes through it.

    `raw` writes the text as given; the default serialises JSON. A reader can
    only ever see a whole file, and the guarantee lives here and nowhere else.
    A replaced file keeps its mode rather than taking the umask; `mode` sets
    one explicitly - a private transcript must not come back group-readable.
    """
    if mode is None:
        try:
            mode = path.stat().st_mode & 0o777
        except OSError:
            mode = None
    if raw:
        tmp = path.with_suffix(path.suffix + f".tmp-{TOOL}")
        tmp.write_text(data)
    else:
        tmp = path.with_suffix(f".json.tmp-{TOOL}")
        tmp.write_text(json.dumps(data, indent=indent) + "\n")
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


def replace_text(path, text, mode=None):
    """Write text where a reader can only ever see a whole file."""
    replace_json(path, text, raw=True, mode=mode)


def write_settings(settings, data):
    if settings.exists():
        settings.with_suffix(f".json.bak-{TOOL}").write_text(settings.read_text())
    replace_json(settings, data)


def install_hook(command):
    """Add the SessionStart janitor hook, preserving everything else."""
    settings = CLAUDE_DIR / "settings.json"
    try:
        data = json.loads(settings.read_text()) if settings.exists() else {}
    except ValueError as exc:
        warn(f"{settings} is not valid JSON ({exc}); leaving hooks alone")
        return False
    if not isinstance(data, dict):
        warn(f"{settings} is not a JSON object; leaving hooks alone")
        return False

    entries = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    for entry in entries:
        for hook in entry.get("hooks", []):
            existing = hook.get("command") or ""
            if existing == command:
                print(f"ok        SessionStart cleanup hook already in {settings}")
                return True
            if TOOL in existing or "resume-agent --cleanup" in existing:
                # An older command for this same tool: update in place rather
                # than leave two hooks reaping the same things.
                hook["command"] = command
                write_settings(settings, data)
                print(f"rehooked  SessionStart in {settings} (was: {existing})")
                return True
    entries.append(
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command,
                    "async": True,  # a janitor must never delay session start
                    "timeout": 10,
                }
            ]
        }
    )
    write_settings(settings, data)
    print(f"hooked    SessionStart in {settings} (backup: settings.json.bak-{TOOL})")
    return True


def drop_stale_compdumps():
    """Delete completion caches that predate this install.

    zsh does not rescan fpath when a cached dump exists, and oh-my-zsh only
    refreshes it about daily, so a freshly linked completion silently does
    nothing in new shells. The dump is a cache and regenerates on next start,
    so removing it is cheap; leaving it means the install did not take.
    """
    stale = []
    for dump in sorted(Path.home().glob(".zcompdump*")):
        try:
            if dump.suffix == ".zwc" or TOOL not in dump.read_text(errors="replace"):
                dump.unlink()
                stale.append(dump.name)
        except OSError:
            continue
    if stale:
        print(f"  cleared stale completion cache: {', '.join(stale)}")


def run_install():
    """Symlink the script into ~/.local/bin and its zsh completion onto fpath."""
    src = Path(__file__).resolve()
    comp_src = src.parent / f"_{TOOL}"
    failed = False

    def link(target, dest):
        nonlocal failed
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.resolve() == target:
            print(f"ok        {dest} -> {target} (already)")
            return
        if dest.exists() or dest.is_symlink():
            warn(f"skipping {dest}: exists and points elsewhere ({dest.resolve()})")
            failed = True
            return
        rel = os.path.relpath(target, dest.parent)
        dest.symlink_to(rel)
        print(f"linked    {dest} -> {rel}")

    link(src, Path.home() / ".local/bin" / TOOL)

    bin_path = Path.home() / ".local/bin" / TOOL
    if not install_hook(f"{bin_path} {HOOK_MARKER} >/dev/null 2>&1"):
        failed = True

    if not comp_src.exists():
        warn(f"no completion file at {comp_src}; script link done, completion skipped")
        return 1

    # Prefer a dir already on fpath; oh-my-zsh puts custom/completions there.
    omz = Path(os.environ.get("ZSH") or Path.home() / ".oh-my-zsh")
    if omz.is_dir():
        link(comp_src, omz / "custom/completions" / f"_{TOOL}")
        drop_stale_compdumps()
        print("completion active in new shells; reload this one with: exec zsh")
    else:
        comp_dir = Path.home() / ".zsh/completions"
        link(comp_src, comp_dir / f"_{TOOL}")
        print(f"add to ~/.zshrc before compinit: fpath=({comp_dir} $fpath)")
    return 1 if failed else 0


def run_poison(args):
    """Recipe 1 steps 0 and 2: (un)set ANTHROPIC_BASE_URL on the swarm server.

    While poisoned, every NEW pane's claude dies at TCP connect: $0 billed, no
    5-hour window anchored. Processes already running keep the env they were
    born with, in both directions; env is fixed at exec.
    """
    sock = args.socket or RESOLVER.newest_live_socket()
    if not sock:
        die("no live swarm socket; pass --socket claude-swarm-<pid>")
    if not RESOLVER.socket_alive(sock):
        die(f"socket {sock} has no live tmux server; poison lives in server env, nothing to set")

    if args.poison:
        res = tmux(sock, "set-environment", "-g", "ANTHROPIC_BASE_URL", POISON_URL)
        if res.returncode != 0:
            die(f"set-environment failed on {sock}: {res.stderr.strip()}")
        print(f"poisoned {sock}: new panes get ANTHROPIC_BASE_URL={POISON_URL}")
        print(f"placeholders will sit in an API error; unpoison with: {TOOL} --unpoison --socket {sock}")
    else:
        res = tmux(sock, "set-environment", "-gu", "ANTHROPIC_BASE_URL")
        if res.returncode != 0:
            die(f"set-environment -gu failed on {sock}: {res.stderr.strip()}")
        print(f"unpoisoned {sock}: new panes get a working API again")
        print("live placeholders keep their poisoned env; the swap's env scrub handles the pane")

    cur = tmux(sock, "show-environment", "-g", "ANTHROPIC_BASE_URL")
    state = cur.stdout.strip() if cur.returncode == 0 else "-ANTHROPIC_BASE_URL (unset)"
    print(f"server env now: {state}")
    return 0


def team_socket(data, args, table):
    """(socket, why) for the whole team, so every member lands on the same server.

    Evidence strongest first, the same order resolve_socket uses per member:
    --socket, the server already hosting a live member, the live lead's pid, and
    a server named after the team.

    A live member outranks the lead's pid because it is where a process
    demonstrably is, while the pid only says where a server would be if the lead
    had made one. A lead never does: it runs in your terminal rather than a pane,
    so a socket named after its pid holds nothing unless a member happened to be
    launched while that lead was up. Members resurrected without a live lead land
    on the team's own server and never move, so the moment a lead appears the two
    names disagree and the pid names an empty server. Asking the members first is
    what keeps one team on one socket across those transitions.
    """
    if args.socket:
        return args.socket, "--socket"
    team = data.get("name")
    lead_id = data.get("leadAgentId")
    # The lead is skipped because it never runs in a pane, so it can never be
    # the process that answers where the team's server is.
    sock, why = RESOLVER.crew_socket(team, table)
    if not sock:
        # A team whose crew is not running yet still has a roster to go on.
        sock, why = RESOLVER.socket_hosting(
            [m.get("agentId") for m in data.get("members", []) if m.get("agentId") != lead_id],
            table,
        )
    if sock:
        return sock, why
    pid, alive, _, _exact = RESOLVER.lead_pid(data.get("leadSessionId"), team)
    if pid and alive:
        return f"{SOCKET_PREFIX}{pid}", f"lead pid {pid}"
    if pid:
        warn(f"the lead of {team} last ran as pid {pid}, which is gone; using the team's own server")
    # Same answer resolve_socket reaches per member, said once: with the lead
    # gone the team gets a server of its own, named after it.
    if team:
        warn(f"no live lead for {team}; standing up that team's own server, as if its lead were up")
        return f"{SOCKET_PREFIX}{team}", f"resurrected server for {team}"
    return None, "unresolved"


class Outcome(collections.namedtuple("Outcome", "status socket is_lead pending_write")):
    """What one agent's run produced: how it went, where it landed, and whether
    it was the lead. The role comes from resolution rather than from the entry
    point, so a single resume and a team resume answer it the same way."""


def report_transcript_writes(pending, args, grace=LAUNCH_WRITE_S):
    """Finish the observation a launch left open.

    launch_survived waits a second and a half for a resumed agent to write its
    own transcript, which is the proof it loaded the session rather than merely
    started a process. A large session takes tens of seconds to get there, so
    "no transcript write yet" is the ordinary result and saying only that leaves
    the run reporting a question instead of an answer. The rest of the run has
    already bought some of the wait; this spends what is left.
    """
    if args.dry_run or not pending:
        return
    print()
    deadline = time.monotonic() + grace
    waiting = list(pending)
    while waiting and time.monotonic() < deadline:
        for item in list(waiting):
            label, path, since = item
            try:
                if path.stat().st_mtime > since:
                    print(f"wrote    {label} loaded its session and wrote its transcript")
                    waiting.remove(item)
            except OSError:
                pass
        if waiting:
            time.sleep(0.5)
    for label, path, _since in waiting:
        warn(f"{label} is running but has not written its transcript in {grace:.0f}s; "
             f"it may still be loading, or it may be stuck before it got there")


def run_agents(args, passthrough, table, jobs, socket=None, prefix=""):
    """Run each prepared invocation, then finish the run once.

    A single agent is a team of one, and both entry points come through here so
    that stays true. Attaching is decided in one place: it depends on this run
    having left something in a pane, not on which entry point asked. A noop
    counts, since an agent already sitting in its pane is worth showing.

    `jobs` is (label, args) pairs; a None args is a member that was skipped.
    `socket` pins the whole run to one server when the caller already knows it,
    as a team does; otherwise the first agent to reach one decides.
    """
    check_flag_scope(passthrough, sum(1 for _, a in jobs if a is not None))
    seen = [label for label, _a in jobs]
    twice = sorted({label for label in seen if seen.count(label) > 1})
    if twice:
        # Two jobs for one agent is two launches of one conversation. The guards
        # that would catch the second read a process table snapshotted before the
        # first, so they see nothing and it proceeds. Refused here rather than in
        # each job-builder, so no future one can reintroduce it.
        die(f"{', '.join(twice)} appears twice in this run; that would start a "
            f"second process on one transcript")
    results, outcomes = [], []
    for label, sub_args in jobs:
        if label is not None:
            print(f"\n[{label}]")
        if sub_args is None:
            print(f"{prefix}skipped")
            results.append((label, "skipped"))
            continue
        outcome = run_one(sub_args, passthrough, table, prefix=prefix,
                          pending=[o.pending_write for o in outcomes if o.pending_write])
        results.append((label, outcome.status))
        outcomes.append(outcome)
        socket = socket or outcome.socket
    if len(jobs) > 1:
        print("\nsummary")
        for label, status in results:
            print(f"  {label:<24} {status}")
    report_transcript_writes([o.pending_write for o in outcomes if o.pending_write], args)
    check_flags_took_effect(passthrough, results, args)
    if any(o.is_lead and o.status == "manual" for o in outcomes):
        # The run ends by handing over the lead's command, and attaching would
        # bury it. Keyed on that handover rather than on the lead being in the
        # run: a lead that was already up leaves this shell with nothing to look
        # at, so the swarm is the only thing left to offer.
        return 1 if any(s == "failed" for _, s in results) else 0
    # Offered only where a server exists to attach to: after a launch one
    # does, and a noop on a dead socket must not promise a keypress whose
    # only outcome is "nothing to attach to".
    if (not args.dry_run and socket and RESOLVER.socket_alive(socket)
            and any(s in ("launched", "noop") for _, s in results)):
        print()
        targets = [a.agent_id for _, a in jobs if a is not None and getattr(a, "agent_id", None)]
        if confirm_attach(targets, table, socket):
            maybe_attach(args, socket)
    return 1 if any(s == "failed" for _, s in results) else 0


def rebuild_roster(team, args, passthrough, table):
    """Forge a reaped team's roster from its lead's transcript, or die saying why.

    Nothing here sends the reader off to forge a roster by hand, because
    everything needed is already here: the lead is found through
    the corroboration ladder, build adopts its identity from the payloads, and
    forge_team's lead branch rebuilds the members with the colours and models
    those payloads recorded.
    """
    path, why = RESOLVER.lead_transcript_for(team)
    if not path:
        die(f"no roster for {team} and none can be rebuilt: {why}")
    print(f"team     {team} has no roster; rebuilding from {path.stem[:8]} ({why})")
    lead = copy.copy(args)
    lead.team, lead.agent_id, lead.resume = None, None, path.stem
    lead.for_team = team
    ctx = build(lead)
    enforce_ctx(ctx, args)
    config = forge_team(ctx, args.dry_run, evidence=why)
    if not config:
        die(f"could not rebuild a roster for {team}")
    if not args.dry_run and not RESOLVER.has_roster(team):
        die(f"forged a roster for {team} but it is not on disk")
    return config


def select_jobs(members, population, live, lead_id, all_members, team):
    """(members to run, names left out) for one team run.

    Liveness is evidence about the world, a record is evidence about the past,
    and which agents to run is a question about the world. So the live members
    plus the lead, where live means wearing the team in argv whether or not any
    record has heard of it, and the record proposes nobody by itself while
    anyone is alive. Only when nothing is alive does the record become the
    world. This is the live-argv rung's logic at the level of a set: a process
    wearing the team is a member, its identity frozen at exec, for the same
    reason argv outranks stamps. --all is always everything.
    """
    def entry(name):
        # A live member the record lacks is not a former anything. It is running
        # now and merely unrecorded, and a section header calling it an ex-member
        # describes the record's gap as the agent's state.
        kind = "unrecorded" if name in live else "former"
        return {"agentId": f"{name}@{team}", "name": name, kind: True}

    listed = {m.get("name") for m in members if m.get("name")}
    if all_members:
        members = members + [entry(n) for n in sorted(population) if n not in listed]
        return members, []
    if live:
        kept = [m for m in members if m.get("name") in live or m.get("agentId") == lead_id]
        have = {m.get("name") for m in kept}
        # Every live member, not merely the live ones the record happens to
        # carry: a member running now is the team whether or not the roster ever
        # heard of it, and narrowing the record alone files a working agent
        # under former.
        members = kept + [entry(n) for n in sorted(live - have)]
        listed = {m.get("name") for m in members if m.get("name")}
    return members, [n for n in sorted(population) if n not in listed]


def former_members_note(former):
    """What a default team run is leaving out, or None when it leaves out nothing.

    A bounded sweep says what it dropped. The harness prunes a member from the
    roster when that member finishes, so reviving them all by default would
    restart work that already ended, and dropping them silently would report a
    team smaller than the one on disk as if it were the whole of it.
    """
    if not former:
        return None
    return (f"{len(former)} more belong to this team and are not running; "
            f"pass --all to resume them too")


def run_team(args, passthrough, table):
    data = RESOLVER.roster_of(args.team)
    if data is None:
        data = rebuild_roster(args.team, args, passthrough, table)

    members = data.get("members", [])
    if not members:
        die(f"team {args.team} has no members")
    lead_id = data.get("leadAgentId")
    socket, socket_why = team_socket(data, args, table)

    # Members first, lead last: the lead is not spawned into a pane, so its turn
    # only prints the command for you to run, and that reads better at the end.
    # Members boot fine without it: the mailbox is a directory, not a process.
    # Against the roster in hand, not the one on disk. A rebuilt team's roster is
    # a value this run just forged, and on a dry run it was never written, so
    # asking the disk calls every member of it a former and the union doubles.
    population = RESOLVER.team_population(args.team)
    live = {name for name in population if RESOLVER.wearers(f"{name}@{args.team}")}
    members, former = select_jobs(members, population, live, lead_id,
                                  getattr(args, "all_members", False), args.team)
    ordered = sorted(members, key=lambda m: 1 if m.get("agentId") == lead_id else 0)
    where = (f"socket {socket} ({socket_why}, {RESOLVER.socket_state(socket)})" if socket
             else "socket resolved per member")
    print(fill(f"team     {args.team}  ({len(ordered)} members, {where})"))
    note = former_members_note(former)
    if note:
        print(fill(f"         {note}"))

    jobs = []
    for member in ordered:
        agent_id = member.get("agentId")
        name = member.get("name") or "?"
        if member.get("unrecorded"):
            print(f"  [{name}] unrecorded member, running now, will re-register")
        elif member.get("former"):
            print(f"  [{name}] former member, will re-register")
        ensure_inbox(args.team, name, args.dry_run)  # every member, not just the launched ones
        if args.no_lead and agent_id == lead_id:
            jobs.append((name, None))
            continue
        one = copy.copy(args)
        one.agent_id, one.resume, one.team, one.socket = agent_id, None, None, socket
        one.socket_reason = "team socket" if not args.socket else "--socket"
        one.in_team = True  # never exec the lead mid-loop; the members need us alive
        jobs.append((name, one))
    return run_agents(args, passthrough, table, jobs, socket=socket, prefix="  ")


def set_tmux_target(session, window):
    global TMUX_SESSION, TMUX_WINDOW
    TMUX_SESSION = session or TMUX_SESSION
    TMUX_WINDOW = window or TMUX_WINDOW


def live_checks():
    """Checks that need a real process, a real terminal or a real directory.

    Kept apart from the read-only ones because they spawn, chdir and open a pty,
    and --selftest runs from a SessionStart hook where changing nothing is the
    contract. Everything here undoes itself: processes are killed, the cwd is
    restored, temporary trees are removed.

    They exist because the alternative is leaving these paths to one-off
    scripts, and a path only a one-off script ever tested is an untested path.
    """
    import pty
    import subprocess as sp
    out = []
    seen_ids = set()

    def check(cid, name, ok, detail=""):
        if cid in seen_ids:
            raise RuntimeError(f"duplicate check id: {cid!r}")
        seen_ids.add(cid)
        out.append((cid, name, ok, detail))

    # A warning printed while the suite runs is the tool talking to an operator
    # who is not there, and it lands in the middle of the results. The read-only
    # tier is run as a child rather than captured in this process, because
    # capturing our own stderr would swallow a traceback and let a crash read as
    # a clean run. The child is passed no --live, so this does not nest.
    quiet = sp.run([sys.executable, str(Path(__file__).resolve()), "--selftest", "--failed"],
                   capture_output=True, text=True, timeout=900)
    stray = [line for line in quiet.stderr.splitlines() if line.strip()]
    check("suite-prints-no-stray-warnings",
          "the suite says nothing to an operator who is not there", not stray,
          f"{len(stray)} line(s), first: {stray[0].strip()[:60]!r}" if stray else "")

    # read_one_key against a terminal, which is the only place it does anything.
    keys = {}
    for label, byte in (("Ctrl-C", b"\x03"), ("Ctrl-X", b"\x18"), ("a plain key", b"a")):
        master, slave = pty.openpty()
        probe = sp.Popen([sys.executable, "-c",
                          "import sys,termios,tty,os\n"
                          "fd=sys.stdin.fileno(); saved=termios.tcgetattr(fd)\n"
                          "tty.setraw(fd)\n"
                          "sys.stderr.write(str(os.read(fd,1)[0]))\n"
                          "termios.tcsetattr(fd, termios.TCSADRAIN, saved)"],
                         stdin=slave, stdout=sp.DEVNULL, stderr=sp.PIPE)
        os.close(slave)
        time.sleep(0.4)          # tty.setraw flushes, so write only once it is raw
        os.write(master, byte)
        try:
            got = probe.communicate(timeout=10)[1].decode().strip()
        except sp.TimeoutExpired:
            probe.kill()
            got = "hung"
        os.close(master)
        keys[label] = got == str(byte[0])
    wrong = sorted(k for k, good in keys.items() if not good)
    check("raw-keypress-terminal", "a raw keypress is read from a real terminal", not wrong, ", ".join(wrong))

    # enter_agent_cwd really moves the process, and refuses rather than exec from
    # the wrong place.
    here = os.getcwd()
    moved = Path(tempfile.mkdtemp())
    real_cwd = RESOLVER.agent_cwd
    try:
        RESOLVER.agent_cwd = lambda ctx: str(moved)
        with contextlib.redirect_stdout(io.StringIO()):
            enter_agent_cwd({})
        went = os.path.realpath(os.getcwd()) == os.path.realpath(moved)
        with contextlib.redirect_stdout(io.StringIO()) as quiet:
            enter_agent_cwd({})
        stayed = quiet.getvalue() == ""
        RESOLVER.agent_cwd = lambda ctx: "/no-such-dir-for-a-check"
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            try:
                enter_agent_cwd({})
                refused = False
            except SystemExit:
                refused = True
        RESOLVER.agent_cwd = lambda ctx: None
        stood = enter_agent_cwd({}) is None
    finally:
        RESOLVER.agent_cwd = real_cwd
        os.chdir(here)
        shutil.rmtree(moved, ignore_errors=True)
    entering = {"moves there": went, "says nothing when already there": stayed,
                "refuses a directory it cannot enter": refused,
                "stands still when none is recorded": stood}
    wrong = sorted(k for k, good in entering.items() if not good)
    check("launch-enters-agent-cwd", "a launch enters the agent's directory", not wrong, ", ".join(wrong))

    # Which carrier launch() consults. The predicate is pinned in the read-only
    # tier; this pins the decision, which is where it broke: asking only the
    # server misses a poison that a server about to be created will inherit.
    def scrubs(socket, shell_value):
        had = os.environ.get("ANTHROPIC_BASE_URL")
        real_panes = RESOLVER.list_panes
        try:
            RESOLVER.list_panes = lambda _sock: []
            os.environ.pop("ANTHROPIC_BASE_URL", None)
            if shell_value:
                os.environ["ANTHROPIC_BASE_URL"] = shell_value
            said = io.StringIO()
            with contextlib.redirect_stdout(said), contextlib.redirect_stderr(io.StringIO()):
                launch(socket, "%0", "/tmp", ["claude", "--resume", "x"], True)
            return "-u ANTHROPIC_BASE_URL" in said.getvalue()
        finally:
            RESOLVER.list_panes = real_panes
            os.environ.pop("ANTHROPIC_BASE_URL", None)
            if had is not None:
                os.environ["ANTHROPIC_BASE_URL"] = had

    probe_sock = f"{TOOL}-selftest-baseurl"
    tmux(probe_sock, "new-session", "-d", "-s", TMUX_SESSION, "sleep", "20")
    try:
        tmux(probe_sock, "set-environment", "-g", "ANTHROPIC_BASE_URL", "https://gateway.example")
        keeps_real = not scrubs(probe_sock, None)
        # Launched from inside a poisoned pane, against a live server holding a
        # real url: the pane will inherit the server's, so ours is not the
        # carrier and stripping would take the operator's gateway with it.
        keeps_real_from_poisoned_shell = not scrubs(probe_sock, POISON_URL)
        tmux(probe_sock, "set-environment", "-g", "ANTHROPIC_BASE_URL", POISON_URL)
        drops_server = scrubs(probe_sock, None)
        drops_inherited = scrubs(f"{TOOL}-selftest-absent", POISON_URL)
        keeps_inherited_real = not scrubs(f"{TOOL}-selftest-absent", "https://gateway.example")
    finally:
        tmux(probe_sock, "kill-server")
    carriers = {
        "a real url on the server is kept": keeps_real,
        "a live server's real url survives a poisoned shell": keeps_real_from_poisoned_shell,
        "a poisoned server is scrubbed": drops_server,
        "a poison we would pass down is scrubbed": drops_inherited,
        "a real url we would pass down is kept": keeps_inherited_real,
    }
    wrong = sorted(k for k, good in carriers.items() if not good)
    check("launch-baseurl-carriers", "a launch consults both carriers of a base url", not wrong, ", ".join(wrong))

    # A team is larger than the splits a window affords. Fixed at 80x24 so the
    # check measures tiling rather than the room a real launch asks for.
    geom_sock = f"{TOOL}-selftest-geometry"
    tmux(geom_sock, "kill-server")
    wanted = 7
    placed, refused = [], None
    try:
        for i in range(wanted):
            try:
                pane, _action = launch(geom_sock, placed[0] if placed else None,
                                       "/tmp", ["sleep", "30"], False)
                placed.append(pane)
            except LaunchFailed as exc:
                refused = f"member {i + 1}: {exc}"
                break
            if i == 0:
                tmux(geom_sock, "resize-window", "-t", TMUX_SESSION, "-x", "80", "-y", "24")
        alive = {p["pane"] for p in RESOLVER.list_panes(geom_sock)}
        check("team-fits-window", f"a team of {wanted} fits the window it is launched into",
              refused is None and len(placed) == wanted and set(placed) <= alive,
              refused or f"placed {len(placed)}/{wanted}, {len(alive)} alive")
    finally:
        tmux(geom_sock, "kill-server")

    # abort_agents against processes spawned for the purpose.
    victims = [sp.Popen(["sleep", "30"]) for _ in range(2)]
    running = [(v.pid, f"probe-{i}@check", "a sleep standing in for an agent", "")
               for i, v in enumerate(victims)]
    try:
        with contextlib.redirect_stdout(io.StringIO()) as said:
            killed = abort_agents(running, assume_yes=True)
        gone = all(not RESOLVER.pid_alive(v.pid) for v in victims)
        check("abort-stops-listed", "an abort stops what it listed", killed == 2 and gone,
              f"killed {killed}, all gone: {gone}")
        check("abort-listing-describes", "the abort listing says what each process is doing",
              "a sleep standing in for an agent" in said.getvalue()
              and "probe-0@check" in said.getvalue())
    finally:
        for v in victims:
            v.kill()
            v.wait()

    # a refusal at the prompt leaves them running
    spared = sp.Popen(["sleep", "30"])
    real_input = globals()["input"] if "input" in globals() else None
    try:
        globals()["input"] = lambda prompt="": "n"
        with contextlib.redirect_stdout(io.StringIO()):
            killed = abort_agents([(spared.pid, "spared@check", "still working", "")])
        check("abort-refusal-spares", "answering no leaves the process alone",
              killed == 0 and RESOLVER.pid_alive(spared.pid))
    finally:
        if real_input is None:
            globals().pop("input", None)
        else:
            globals()["input"] = real_input
        spared.kill()
        spared.wait()

    return out


def check_report(results, failed_only=False):
    """The suite's verdicts as lines.

    The failure list names one check per line and ends with a summary, so a
    reader can diff two runs instead of searching one, and a run that died
    has no summary to be mistaken for a clean one.
    """
    failed = sum(1 for _, _, ok, _ in results if not ok)
    if failed_only:
        lines = [f"{cid}  {name}{'  (' + detail + ')' if detail else ''}"
                 for cid, name, ok, detail in results if not ok]
        return lines + [f"checks: {len(results) - failed} ok, {failed} failed"]
    idwidth = max((len(cid) for cid, _, _, _ in results), default=0)
    width = max((len(name) for _, name, _, _ in results), default=0)
    lines = [f"  {'PASS' if ok else 'FAIL'}  {cid:<{idwidth}}  {name:<{width}}"
             + (f"  ({detail})" if detail else "")
             for cid, name, ok, detail in results]
    return lines + ["", f"{len(results) - failed}/{len(results)} checks passed"]


def run_selftest(live=False, failed_only=False, list_only=False):
    """Assert the invariants this tool keeps rediscovering. Read-only.

    Two kinds: structural ones read from this file's own syntax tree, because
    an invariant like "only the engine picks a transcript" is a property of the
    code rather than of a run; and behavioural ones exercised against the
    portable fixture corpus under test/, so the answer never depends on what
    happens to be on the machine running the suite (see corpus_engine()).
    """
    import ast
    import tempfile

    results = []
    seen_ids = set()

    def check(cid, name, ok, detail=""):
        if cid in seen_ids:
            raise RuntimeError(f"duplicate check id: {cid!r}")
        seen_ids.add(cid)
        results.append((cid, name, ok, detail))

    def corpus_engine():
        """A Resolver pointed at test/corpus/ instead of this machine.

        A fresh instance every call, never the shared RESOLVER: sharing one
        would let one check's cached stamps or spawn index leak into the
        next. The fixture is checked-in data, composed once, so every
        machine that runs this suite - a laptop with years of real teams or
        a bare CI checkout with none - exercises the same behaviour.
        """
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        corpus = Path(__file__).resolve().parent / "test" / "corpus"
        eng.projects_dir = corpus / "projects"
        eng.teams_dir = corpus / "teams"
        return eng

    source = Path(__file__).resolve().read_text()
    tree = ast.parse(source)
    def is_delegate(node):
        """A transitional forwarder: one return of RESOLVER.<same name>(*a, **k).

        Recognised by shape rather than by a name list, so the step-5 deletion
        cannot leave a stale exemption behind, and so a hand-written function
        cannot quietly acquire one.
        """
        if len(node.body) != 1 or not isinstance(node.body[0], ast.Return):
            return False
        call = node.body[0].value
        return (isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute)
                and getattr(call.func.value, "id", None) == "RESOLVER"
                and call.func.attr == node.name)

    funcs = {n.name: n for n in ast.walk(tree)
             if isinstance(n, ast.FunctionDef) and not is_delegate(n)}

    def callers_of(target):
        """Callers by either spelling: a module function calls `target(...)`, an
        engine method calls `self.target(...)`. Matching only the first lets
        every invariant below pass by vacuity for an engine that is a class,
        which is the opposite of what they are for."""
        out = set()
        for name, node in funcs.items():
            for sub in ast.walk(node):
                if not isinstance(sub, ast.Call):
                    continue
                if getattr(sub.func, "id", None) == target or (
                        isinstance(sub.func, ast.Attribute) and sub.func.attr == target):
                    out.add(name)
        return out

    # -- structural
    dupes = [n for n in ("resolve_transcript", "edit_team_config", "socket_alive", "lead_pid",
                         "stamp_index", "ps_table", "session_registry")
             if sum(1 for f in ast.walk(tree) if isinstance(f, ast.FunctionDef)
                    and f.name == n and not is_delegate(f)) != 1]
    check("engine-primitives-once", "engine primitives defined exactly once", not dupes, ", ".join(dupes))

    # the checker itself is not a caller of the thing it checks
    # The engine is a class, so membership of it is the exemption, not a list of
    # names. Enumerating names lets a caller add a picker without tripping
    # this, because a new engine method has to be remembered.
    engine_node = next(node for node in ast.walk(tree)
                       if isinstance(node, ast.ClassDef) and node.name == "Resolver")
    engine = {m.name for m in engine_node.body if isinstance(m, ast.FunctionDef)}
    # run_selftest and run_census observe the engine rather than resolve with it:
    # they ask what it answers in order to report on it, which is the opposite of
    # a caller picking a transcript for itself.
    pickers = (callers_of("transcript_path") - engine
               - {"team_keep_reason", "run_selftest", "run_census"})
    check("transcript-pick-engine-only", "only the engine picks a transcript", not pickers, ", ".join(sorted(pickers)))

    # The boundary. Naming the functions allowed to reach the tree fails: a
    # picker need only avoid the named entry point and glob directly.
    # Membership of the class is checkable and cannot be sidestepped by
    # choosing a different spelling.
    ambient = {"PROJECTS_DIR", "SESSIONS_DIR", "TEAMS_DIR",
               "_ps", "_stamps", "_spawns", "_spawn_log", "_by_agent", "_by_team"}
    engine_lines = set(range(engine_node.lineno, engine_node.end_lineno + 1))
    # Found from the tree, never written down: a recorded line range drifts as the
    # file grows, and a drifted exemption silently excuses whatever moved into it.
    selftest_node = next(n for n in ast.walk(tree)
                         if isinstance(n, ast.FunctionDef) and n.name == "run_selftest")
    selftest_lines = set(range(selftest_node.lineno, selftest_node.end_lineno + 1))
    # The evidence ban stops raw tree access. These stop the decisions: a roster
    # parsed by hand, an argv matched by hand, and the underscore convention going
    # quietly hollow. Every such regression shares one route: the raw form
    # stays reachable, so somebody reaches.
    # Narrowly: reading a roster file. Parsing a transcript line or a settings
    # file is a different question and stays where it is; the regression shape
    # is several functions each deciding for themselves what a roster is.
    def reads_a_roster(node):
        body = ast.get_source_segment(source, node) or ""
        return ("loads" in body
                and ("roster_path" in body or "config.json" in body)
                and "read_text" in body)

    roster_readers = sorted(
        node.name for node in tree.body
        if isinstance(node, ast.FunctionDef) and reads_a_roster(node)
        # edit_team_config is the writer and re-reads under its own lock.
        and node.name not in {"edit_team_config", "run_selftest"})
    check("roster-read-one-place", "a roster is read in one place", not roster_readers, ", ".join(roster_readers))

    # Which roster is believed when several claim one agent is a policy, not a
    # filter: it decides whose conversation gets resumed. run_complete sorts for
    # display, which is presentation and not that question.
    ts_sorters = sorted(
        node.name for node in tree.body
        if isinstance(node, ast.FunctionDef)
        and 'key=lambda e: e["ts"]' in (ast.get_source_segment(source, node) or "")
        # _complete sorts for display; run_selftest holds this check's own text.
        and node.name not in {"_complete", "run_selftest"})
    check("roster-claim-one-policy", "one policy decides which roster claims an agent", not ts_sorters, ", ".join(ts_sorters))

    # A member the roster does not list is launched, inboxed, and invisible to its
    # own lead: it can write to the lead's inbox and never be read from it. The
    # update path can only change an existing entry, so a missing one has to be
    # inserted instead of skipped.
    reg_base = Path(tempfile.mkdtemp())
    real_teams_dir = RESOLVER.teams_dir
    try:
        RESOLVER.teams_dir = reg_base
        team = "session-regcheck"
        (reg_base / team / "inboxes").mkdir(parents=True)
        RESOLVER.roster_path(team).write_text(json.dumps({
            "name": team, "leadAgentId": f"team-lead@{team}", "leadSessionId": "x",
            "members": [{"agentId": f"team-lead@{team}", "name": "team-lead"}]}))
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            register_member({"name": "newcomer", "team": team,
                             "agentId": f"newcomer@{team}"}, "%9", False, True)
        listed = [m.get("name") for m in
                  json.loads(RESOLVER.roster_path(team).read_text()).get("members", [])]
    finally:
        RESOLVER.teams_dir = real_teams_dir
        shutil.rmtree(reg_base, ignore_errors=True)
    check("roster-add-missing-member", "a member missing from its roster is added to it", "newcomer" in listed,
          f"roster lists {listed}")

    # The roster entry is written in two phases, the shape the harness itself
    # spawns with: claimed before the process starts, because a boot that cannot
    # find itself listed initialises no idle hook, then patched with the pane
    # once the seat exists.
    two_base = Path(tempfile.mkdtemp())
    real_teams_dir = RESOLVER.teams_dir
    try:
        RESOLVER.teams_dir = two_base
        pteam = "session-twophase"
        (two_base / pteam / "inboxes").mkdir(parents=True)
        RESOLVER.roster_path(pteam).write_text(json.dumps({
            "name": pteam, "leadAgentId": f"team-lead@{pteam}", "leadSessionId": "x",
            "members": [{"agentId": f"team-lead@{pteam}", "name": "team-lead"}]}))
        prec = {"name": "claimant", "team": pteam, "agentId": f"claimant@{pteam}",
                "color": "blue", "model": "claude-opus-5"}

        def claimant_entry():
            members = json.loads(RESOLVER.roster_path(pteam).read_text()).get("members", [])
            return next((m for m in members if m.get("agentId") == prec["agentId"]), None)

        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            claimed_new = reserve_member(prec, False)
            on_claim = claimant_entry()
            claimed_again = reserve_member(prec, False)
            register_member(prec, "%7", False, True)
            on_commit = claimant_entry()
            release_member(prec, False)
            after_release = claimant_entry()
    finally:
        RESOLVER.teams_dir = real_teams_dir
        shutil.rmtree(two_base, ignore_errors=True)

    check("claim-carries-identity-not-seat",
          "a claim writes what is known and leaves the seat to the commit",
          claimed_new and on_claim is not None and on_claim.get("color") == "blue"
          and "tmuxPaneId" not in on_claim and "backendType" not in on_claim
          and (on_commit or {}).get("tmuxPaneId") == "%7"
          and (on_commit or {}).get("backendType") == "tmux",
          f"on claim {on_claim}, on commit {on_commit}")

    # Whether the rollback is safe rests entirely on this: a claim that inserted
    # nothing must say so, or a failed launch would delete an entry that was
    # already there and belonged to somebody else's run.
    check("claim-on-a-listed-member-claims-nothing",
          "claiming an already listed member reports nothing claimed",
          claimed_new and not claimed_again,
          f"first claim {claimed_new}, second {claimed_again}")

    check("release-gives-the-claim-back",
          "releasing a claim removes the entry it inserted",
          after_release is None, f"after release {after_release}")

    # An entry written after the launch races the boot it describes, and one
    # left behind after a failed launch describes a member that never existed.
    one_src = ast.get_source_segment(source, funcs["run_one"]) or ""
    claim_at = one_src.find("reserve_membership(")
    spawn_at = one_src.find("pane, action = launch(")
    failed_at = one_src.find("except LaunchFailed")
    handler = one_src[failed_at:failed_at + 500] if failed_at >= 0 else ""
    check("claim-precedes-spawn-and-is-given-back",
          "the claim is taken before the spawn and released when the spawn fails",
          0 <= claim_at < spawn_at and "release_membership(" in handler,
          f"claim at {claim_at}, spawn at {spawn_at}, "
          f"released in handler: {'release_membership(' in handler}")

    # And the same thing driven rather than read: run_one against a writable
    # copy of the corpus, once with a spawn that fails and once with one that
    # works. The failing arm must leave the roster as it found it; the working
    # arm proves the fixture can tell the difference, without which the failing
    # arm would pass on a run that never claimed anything at all.
    class _Run:
        def __init__(self, **kw):
            self.__dict__.update({"resume": None, "agent_id": None, "to_team": None,
                                  "for_team": None, "no_tint": True})
            self.__dict__.update(kw)

        def __getattr__(self, _name):
            return False  # every other flag is off; explicit ones above win

    class _FakeTmux:
        """A tmux server kept in a dict, answering the command surface the tool
        uses. Faking here rather than at each caller is what makes this an
        integration fixture: resolve_socket, seat_note, socket_state,
        pane_occupants, tint_pane and launch all run unmodified against it.
        Commands whose output nobody parses answer success and say nothing,
        which is what the real server does.
        """

        def __init__(self, session_exists=True, panes=()):
            self.sessions = {TMUX_SESSION} if session_exists else set()
            self.panes = [dict(p) for p in panes]
            self.env, self.ran, self.fail = {}, [], set()
            self.next_pane = 1 + max([int(p["pane"][1:]) for p in self.panes] or [-1])

        def __call__(self, socket, *args):
            self.ran.append(tuple(args))
            argv, done = list(args), lambda out="", code=0: subprocess.CompletedProcess(
                ["tmux"], code, out, "" if code == 0 else "refused")
            cmd = argv[0] if argv else ""
            if cmd in self.fail:
                return done(code=1)
            if cmd == "has-session":
                return done(code=0 if TMUX_SESSION in self.sessions else 1)
            if cmd == "list-panes":
                return done("".join(f"{p['session']}\t{p['window']}\t{p['pane']}\t{p['pid']}\n"
                                    for p in self.panes))
            if cmd == "show-environment":
                key = argv[-1]
                return done(f"{key}={self.env[key]}") if key in self.env else done(code=1)
            if cmd == "set-environment":
                self.env[argv[-2]] = argv[-1]
                return done()
            if cmd in ("new-session", "split-window", "new-window"):
                pane = f"%{self.next_pane}"
                self.next_pane += 1
                self.sessions.add(TMUX_SESSION)
                self.panes.append({"session": TMUX_SESSION, "window": "@0",
                                   "pane": pane, "pid": 4242})
                return done(pane)
            return done()

    def resume_run(agent_id, *, listed=True, server=None, table=(), watch=None, **flags):
        """Run the real resume path against a writable copy of the corpus.

        Only the world outside the process is faked: one tmux server and the
        process table. Everything the tool decides for itself, which is the
        resolution, the guards, the placement, the roster writes and the
        report, executes. `watch` is called between the claim and the spawn,
        the one moment that shows whether a write landed before the process
        started or after it.

        Returns (outcome, roster entry afterwards, the fake server, printed
        output), or ("refused", ...) when the run died on a refusal.
        """
        base = Path(tempfile.mkdtemp())
        shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", base / "corpus")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir, eng.teams_dir = base / "corpus" / "projects", base / "corpus" / "teams"
        # The process table is the other half of the outside world, and it is
        # not static: a spawn that works makes a process appear. Keeping it
        # mutable is what lets launch_survived run for real instead of being
        # told the answer.
        live = list(table)
        eng.ps_table = lambda refresh=False: list(live)
        who, team = agent_id.partition("@")[0], agent_id.partition("@")[2]
        cfg = eng.roster_path(team)
        roster = json.loads(cfg.read_text())
        if not listed:
            roster["members"] = [m for m in roster["members"] if m.get("name") != who]
        cfg.write_text(json.dumps(roster))

        def entry():
            members = json.loads(cfg.read_text()).get("members", [])
            return next((m for m in members if m.get("name") == who), None)

        fake = server if server is not None else _FakeTmux()
        # A real listening socket under a temp TMUX_TMPDIR, so socket_alive
        # answers by connecting the way it does in the field rather than by
        # being told. It is the cheapest honest half of the fixture.
        sockdir = base / "tmux"
        sockdir.mkdir()
        listener = socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM)
        listener.bind(str(sockdir / "claude-swarm-test"))
        listener.listen(1)

        real_tmux, real_resolver = globals()["tmux"], globals()["RESOLVER"]
        real_env = {k: os.environ.get(k) for k in ("TMUX_TMPDIR", "TMUX", "TMUX_PANE")}
        os.environ["TMUX_TMPDIR"] = str(sockdir)
        os.environ.pop("TMUX", None)
        os.environ.pop("TMUX_PANE", None)

        spawning = ("split-window", "new-window", "new-session", "respawn-pane")

        def watched(socket, *args):
            if not (args and args[0] in spawning):
                return fake(socket, *args)
            if watch:
                watch(entry())
            res = fake(socket, *args)
            if res.returncode == 0:
                # What a spawn that worked produces: a process wearing the id,
                # in the pane, and a transcript that has just been written to.
                # Deliberately not a path ending in /claude. This row is
                # indistinguishable from a real agent if it ever escapes the
                # fixture, so it takes the matcher's other branch, a versioned
                # path, and names itself a selftest. It still exercises the real
                # is_claude rather than dodging it.
                live.append((4242, 1, f"{FAKE_AGENT_BIN} --resume x --agent-id {agent_id}"))
                for jsonl in eng.projects_dir.rglob("*.jsonl"):
                    jsonl.touch()
            return res

        globals().update(RESOLVER=eng, tmux=watched)
        said = io.StringIO()
        try:
            with contextlib.redirect_stdout(said), contextlib.redirect_stderr(said):
                try:
                    out = run_one(_Run(agent_id=agent_id, socket="claude-swarm-test",
                                       **flags), [], list(table))
                    status = out.status
                except SystemExit:
                    status = "refused"
            return status, entry(), fake, said.getvalue()
        finally:
            globals().update(RESOLVER=real_resolver, tmux=real_tmux)
            for key, value in real_env.items():
                os.environ[key] = value if value is not None else os.environ.pop(key, "")
                if value is None:
                    os.environ.pop(key, None)
            listener.close()
            shutil.rmtree(base, ignore_errors=True)

    seen_at_spawn = []
    started, started_entry, started_srv, _said = resume_run(
        "willow@session-corpus-alpha", listed=False, watch=seen_at_spawn.append)
    at_spawn = seen_at_spawn[0] if seen_at_spawn else None

    check("resume-places-a-member-in-a-pane",
          "a member resume reaches tmux and records the pane it got",
          started == "launched" and (started_entry or {}).get("tmuxPaneId") == "%0"
          and (started_entry or {}).get("backendType") == "tmux"
          and any(a[0] == "split-window" or a[0] == "new-window" or a[0] == "new-session"
                  for a in started_srv.ran),
          f"{started}, entry {started_entry}, ran {[a[0] for a in started_srv.ran]}")

    check("claim-is-listed-before-the-process-starts",
          "the member is in the roster, without a seat, by the time the spawn runs",
          at_spawn is not None and "tmuxPaneId" not in at_spawn,
          f"the spawn saw {at_spawn}")

    # The same path with the spawn refused by the server. tmux failing is how a
    # launch fails in the field, so the failure is produced rather than injected.
    broken = _FakeTmux()
    broken.fail = {"split-window", "new-window", "new-session"}
    failed, failed_entry, _srv, _out = resume_run(
        "willow@session-corpus-alpha", listed=False, server=broken)

    check("failed-spawn-leaves-no-claim-behind",
          "a spawn the server refuses leaves the roster as it found it",
          failed == "failed" and failed_entry is None,
          f"{failed}, entry {failed_entry}")

    bare_status, bare_entry, _srv, _out = resume_run(
        "willow@session-corpus-alpha", listed=False, bare=True)

    check("bare-resume-reaches-tmux-and-no-roster",
          "a bare resume starts the agent and joins no team",
          bare_status == "launched" and bare_entry is None,
          f"{bare_status}, entry {bare_entry}")

    lead_status, _entry, _srv, lead_said = resume_run(
        "team-lead@session-corpus-alpha", to_team="session-corpus-crew")

    check("lead-rebind-refuses-with-the-working-spelling",
          "--to-team on a lead refuses and names what does work",
          lead_status == "refused" and "resume it as that team's lead" in lead_said,
          f"{lead_status}: {lead_said.strip().splitlines()[-1][:70] if lead_said.strip() else ''}")

    # Reading the spawn log unfilled returns an empty list, which is also what a
    # transcript that spawned nobody returns, so a missed fill is a false negative
    # shaped like an answer. Only the ingester and the accessors may touch it.
    log_touchers = sorted(
        node.name for node in ast.walk(tree)
        if isinstance(node, ast.FunctionDef)
        and "_spawn_log" in (ast.get_source_segment(source, node) or "")
        and node.name not in {"__init__", "_ingest_spawn_lines", "_log", "_every_log",
                              "run_selftest"})
    check("spawn-log-fill-site", "the spawn log is filled where it is read", not log_touchers, ", ".join(log_touchers))

    # Attributes as well as calls: a cache read is a reach inside, same as a call.
    private_reach = sorted({
        f"{node.name} -> {m.group(1)}"
        for node in tree.body if isinstance(node, ast.FunctionDef)
        and node.name != "run_selftest"
        for m in re.finditer(r"RESOLVER\.(_\w+)", ast.get_source_segment(source, node) or "")})
    check("no-module-reaches-engine", "no module code reaches inside the engine", not private_reach,
          "; ".join(private_reach))

    trespass = sorted({
        f"{node.id} at line {node.lineno}"
        for node in ast.walk(tree)
        if isinstance(node, ast.Name) and node.id in ambient
        and isinstance(node.ctx, ast.Load)   # the declaration is a Store; only a use is a reach
        and node.lineno not in engine_lines
        and node.lineno not in selftest_lines})
    check("tree-reached-via-engine", "the tree is reached only through the engine", not trespass, "; ".join(trespass))

    # The same mechanism for a different realm, which is why it is a separate
    # check rather than another name in `ambient`: CLAUDE_PROC is not the
    # transcript tree, it is what decides whether a process on the table is a
    # claude at all. Every liveness answer this tool gives rests on it, so a
    # second reader would be a second definition of "a claude is running", and
    # the definitions would drift the way two mail readers already did. Choosing
    # which binary to launch is the other half of this realm and stays outside:
    # claude_binary acts, it concludes nothing about a process.
    #
    # Neither the suite nor live_checks is exempted, and neither needs to be:
    # the suite exercises the real matcher through RESOLVER.is_claude, and its
    # fake process rows wear FAKE_AGENT_BIN, which is a different name. An
    # exemption here would be a standing permission for the one place most
    # likely to want a shortcut.
    #
    # What this cannot see is a hand-rolled second matcher that never says
    # CLAUDE_PROC. The compiled pattern being the only one in the file is what
    # makes the name worth guarding: there is nothing else to reach for.
    claude_matchers = sorted({
        f"{node.id} at line {node.lineno}"
        for node in ast.walk(tree)
        if isinstance(node, ast.Name) and node.id == "CLAUDE_PROC"
        and isinstance(node.ctx, ast.Load)   # the declaration is a Store; only a use is a reach
        and node.lineno not in engine_lines})
    check("claude-pattern-engine-only", "what counts as a claude process is read only inside the engine",
          not claude_matchers, "; ".join(claude_matchers))

    writers = {n for n, node in funcs.items()
               if "os.replace" in ast.get_source_segment(source, node)}
    check("roster-one-writer", "one roster writer", writers <= {"edit_team_config", "replace_json", "run_selftest"},
          ", ".join(sorted(writers - {"run_selftest"})))

    run_one_src = ast.get_source_segment(source, funcs["run_one"])
    # team_minted_by and pid_running_team read payloads for team membership,
    # a different question; this guards the per-agent lookup only.
    payload_readers = (callers_of("_spawn_by_agent") | callers_of("_spawn_records")) - {
        "spawn_payload", "_spawn_by_agent", "team_minted_by", "_pid_running_team",
        "members_spawned_into", "_log", "run_selftest"}
    check("spawn-payload-one-lookup", "one lookup for an agent's spawn payload", not payload_readers, ", ".join(sorted(payload_readers)))

    # A preview must be printed through step(), which carries both tenses, or
    # inline as "would X if dry else did X". A bare print of a "would" line has
    # no real counterpart and silently makes a real run quieter than its preview.
    unpaired = [line.strip()[:60] for line in source.splitlines()
                if "print(" in line and "would " in line and " else " not in line]
    check("preview-line-counterpart", "every preview line has a real counterpart", not unpaired, "; ".join(unpaired))

    # A team directory is the engine's to read. Its roster and its mailboxes
    # are two of the eight realms, and both live inside one directory, so a
    # caller that opens either for itself becomes a second answer to a
    # question the engine already answers: is this team there, is this mailbox
    # empty, does this directory hold anything worth keeping.
    #
    # Every route into a team dir starts at one of the engine's path answers
    # (roster_path, inbox_path, teams_dir), at TEAMS_DIR, or at CLAUDE_DIR
    # joined to "teams". So the roots are followed through local variables and
    # attribute chains, and a filesystem read applied to one fails here. What
    # this does not see is a path handed to a helper as an argument and read
    # there, and a path spelled from a literal home directory; nothing in this
    # file does either, and TEAMS_DIR is barred outside the engine already.
    team_reads = {"exists", "is_file", "is_dir", "is_symlink", "stat", "open",
                  "read_text", "read_bytes", "iterdir", "glob", "rglob"}

    def in_a_team_dir(node, tainted):
        """Does this expression name something inside a team directory?"""
        if isinstance(node, ast.Name):
            return node.id in tainted or node.id == "TEAMS_DIR"
        if isinstance(node, ast.Call):
            return (isinstance(node.func, ast.Attribute)
                    and node.func.attr in {"roster_path", "inbox_path"})
        if isinstance(node, ast.Attribute):
            return node.attr == "teams_dir" or in_a_team_dir(node.value, tainted)
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
            if (isinstance(node.left, ast.Name) and node.left.id == "CLAUDE_DIR"
                    and isinstance(node.right, ast.Constant) and node.right.value == "teams"):
                return True
            return in_a_team_dir(node.left, tainted)
        if isinstance(node, ast.Subscript):
            return in_a_team_dir(node.value, tainted)
        return False

    def team_dir_reads(node):
        """The reads this function performs on a team directory, by line."""
        tainted, grew = set(), True
        while grew:   # a name can be bound from another name bound earlier
            grew = False
            for sub in ast.walk(node):
                if not isinstance(sub, ast.Assign) or not in_a_team_dir(sub.value, tainted):
                    continue
                for target in sub.targets:
                    if isinstance(target, ast.Name) and target.id not in tainted:
                        tainted.add(target.id)
                        grew = True
        return sorted({
            f"{node.name} reads a team dir at line {sub.lineno}"
            for sub in ast.walk(node)
            if isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
            and sub.func.attr in team_reads and in_a_team_dir(sub.func.value, tainted)})

    team_peekers = sorted(
        hit
        for node in tree.body if isinstance(node, ast.FunctionDef)
        # reap_team and run_demote copy the bytes of a roster or a mailbox into
        # a receipt and then delete what they copied. That is the archive half
        # of an act, not a reading of the realm: neither concludes anything
        # from what it read. run_selftest stages team dirs as fixtures and
        # holds this check's own text.
        and node.name not in {"reap_team", "run_demote", "run_selftest"}
        for hit in team_dir_reads(node))
    check("team-dir-read-engine-only", "a team directory is read only inside the engine",
          not team_peekers, "; ".join(team_peekers))

    # ~/.claude/settings.json says which teammate substrate the harness is
    # configured for, and this tool serves only one of them. The engine reads
    # it; a second reader would be a second opinion about what the operator
    # asked for. Barred by the file's name and by the key's, so a rogue reader
    # has to avoid saying either. install_hook is the installer's
    # read-modify-write, which adds a hook and puts the file back rather than
    # concluding anything from it, and hands the path it opened to
    # write_settings.
    settings_names = {"settings.json", "teammateMode"}
    settings_readers = sorted(
        f"{node.name} names {sub.value!r} at line {sub.lineno}"
        for node in tree.body if isinstance(node, ast.FunctionDef)
        and node.name not in {"install_hook", "run_selftest"}
        for sub in ast.walk(node)
        if isinstance(sub, ast.Constant) and sub.value in settings_names)
    check("settings-read-engine-only", "the settings file is read only inside the engine",
          not settings_readers, "; ".join(settings_readers))

    # Whether a tmux server is there has one implementation, the engine's
    # connect() probe, and two spellings that could ask it again: a second
    # AF_UNIX probe, and a tmux subcommand whose whole answer is whether a
    # server, a session or a client exists. Both are barred outside the
    # engine, by the module the probe needs and by the subcommands
    # themselves, so a raw subprocess is caught as surely as a call through
    # tmux(). Acting on tmux is untouched: a launch splits a window, a tint
    # sets options, a poison sets a variable, and none of those reads a
    # verdict. live_checks is not exempted and does not need to be: it drives
    # tmux hard, and never to ask whether a server is up.
    server_questions = {"has-session", "list-clients", "list-sessions"}
    asked_outside = set()
    for node in ast.walk(tree):
        line = getattr(node, "lineno", None)
        if line is None or line in engine_lines or line in selftest_lines:
            continue
        if isinstance(node, ast.Name) and node.id == "socketlib" and isinstance(node.ctx, ast.Load):
            asked_outside.add(f"an AF_UNIX probe at line {line}")
        elif isinstance(node, ast.Constant) and node.value in server_questions:
            asked_outside.add(f"tmux {node.value} at line {line}")
    check("server-liveness-engine-only", "whether a tmux server is up is asked only inside the engine",
          not asked_outside, "; ".join(sorted(asked_outside)))

    # Its sibling, one level down: which panes exist on a server, and which
    # pane this process is sitting in. Kept apart from the liveness check
    # rather than folded into it because they fail for different reasons: a
    # server nobody can find and a seat nobody confirmed are different bugs,
    # and a check that says which one bit is worth two that say "tmux".
    #
    # Barred by the subcommands that answer the pane question and by the two
    # environment variables that answer the seat one. Placing a pane is
    # untouched: split-window, new-window, respawn-pane and select-layout all
    # act, and launch decides among them from a pane list the engine handed
    # it. TMUX_TMPDIR is not here: where socket files live is a path question,
    # and the engine's socket_dir is the only caller of it either way.
    pane_questions = {"list-panes", "list-windows", "display-message", "TMUX", "TMUX_PANE"}
    pane_askers = sorted({
        f"{node.value} at line {node.lineno}"
        for node in ast.walk(tree)
        if isinstance(node, ast.Constant) and node.value in pane_questions
        and node.lineno not in engine_lines
        and node.lineno not in selftest_lines})
    check("pane-question-engine-only", "which panes exist and where we sit is asked only inside the engine",
          not pane_askers, "; ".join(pane_askers))

    # The process realm has two sources and both are the engine's: the ps
    # snapshot every run judges against, and /proc for the three questions ps
    # does not answer (is this the same process, is it suspended, what
    # environment is it running with). A second reader is how a pid comes back
    # alive in one place and dead in another.
    #
    # Two spellings, because a rogue liveness test does not need /proc: signal
    # 0 is the other idiom, and it disagrees with pid_alive in exactly the
    # cases pid_alive was written for, a zombie and a recycled pid. Killing
    # for real is untouched: it takes a signal that is not 0, and it verifies
    # afterwards by asking the engine.
    #
    # live_checks is not exempted and needs no exemption: it kills real
    # processes and asks RESOLVER.pid_alive whether they died, which is the
    # shape every actor in this file uses.
    proc_readers = set()
    for node in ast.walk(tree):
        line = getattr(node, "lineno", None)
        if line is None or line in engine_lines or line in selftest_lines:
            continue
        if isinstance(node, ast.Constant) and isinstance(node.value, str) and "/proc/" in node.value:
            proc_readers.add(f"a /proc path at line {line}")
        elif (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                and node.func.attr == "kill" and len(node.args) == 2
                and isinstance(node.args[1], ast.Constant) and node.args[1].value == 0):
            proc_readers.add(f"a signal-0 liveness test at line {line}")
    check("proc-read-engine-only", "a process is read only inside the engine",
          not proc_readers, "; ".join(sorted(proc_readers)))

    # Wrapping serves the reader; the reader is not owed less. Every physical
    # line fits the width, and the reflowed text says word for word what the
    # wall said: a lost fact must never be the fix for an unreadable one.
    tale = ("pid 4242 holds team-lead's transcript in pane %7 and refuses; " * 8).strip()
    filled = fill(tale, width=72)
    # A label whose value cannot fit beside it keeps the value anyway: the
    # pair overflows together rather than the label sitting orphaned above it.
    labelled = fill("cwd      /" + "x" * 90, width=72)
    # A sentence one word over the width does not strand that word alone: a
    # companion comes down with it, and no word is lost either way.
    widowy = " ".join(["a" * 8] * 8 + ["tail"])
    dewidowed = fill(widowy, width=72)
    check("wrap-width-lossless", "a long message wraps inside the width and loses nothing",
          all(len(l) <= 72 for l in filled.splitlines())
          and " ".join(filled.split()) == " ".join(tale.split())
          and labelled == "cwd      /" + "x" * 90
          and len(dewidowed.splitlines()[-1].split()) == 2
          and " ".join(dewidowed.split()) == widowy,
          f"widest line {max(map(len, filled.splitlines()))} of width 72; "
          f"widow line {dewidowed.splitlines()[-1]!r}")

    # A command line is a record and sometimes a paste form. Wrapped either
    # way, replacing newline+indent with one space must give back the exact
    # string, and the paste form must still parse as the same argv.
    argv_case = ["claude", "--resume", "0" * 36, "--agent-id", "one@session-two",
                 "--append-system-prompt", "two words  doubled", "--model", "m"]
    pasted = wrap_command(argv_case, "command  ", " " * 11, paste=True, width=64)
    lines = pasted.splitlines()
    rejoined = " ".join([lines[0][len("command  "):].rstrip("\\").rstrip()]
                        + [l[11:].rstrip("\\").rstrip() for l in lines[1:]])
    record_case = "tmux -L s split-window 'exec env A=1  B=2 claude --long-flag'"
    recorded = wrap_command(record_case, "  ran: ", "    ", width=24)
    rec_lines = recorded.splitlines()
    rec_joined = " ".join([rec_lines[0][len("  ran: "):]] + [l[4:] for l in rec_lines[1:]])
    check("wrap-command-rejoins", "a wrapped command rejoins to the exact command",
          shlex.split(rejoined) == argv_case and rec_joined == record_case
          and len(lines) > 1 and all(len(l) <= 64 for l in lines)
          # the paste form is only a paste form while every broken line
          # still announces its continuation
          and all(l.endswith(" \\") for l in lines[:-1]),
          f"paste ok {shlex.split(rejoined) == argv_case}, record ok {rec_joined == record_case}")

    # A refusal that blocks on several things says each on its own line under
    # the caller's sentence, each class closed by its way out, and a bounded
    # listing says how much it left out instead of dropping it silently.
    class _Blocked:
        with_mail, force = False, False
    real_reap_obj = RESOLVER.reap_objections
    RESOLVER.reap_objections = lambda team, table, archive_mail=False: (
        [f"{n} unread for member{n}, oldest 2026-08-06 15:33:30" for n in range(1, 7)]
        + ["pid 4242 wears it (someone@somewhere)",
           "pid 4243 holds team-lead's transcript"])
    try:
        blocked = reap_blockers("session-blocked", _Blocked(), table={})
    finally:
        RESOLVER.reap_objections = real_reap_obj
    bullets = [l for l in blocked if l.startswith("- ")]
    ways_out = [l for l in blocked if l.startswith("  (")]
    itemized = {
        "one objection per bullet": bullets and not any("; " in l for l in bullets),
        "every class keeps its way out": len(ways_out) == 3
            and any("--with-mail" in l for l in ways_out)
            and any("--force" in l for l in ways_out)
            and any("stop it first" in l for l in ways_out),
        "a bounded list says what it dropped": any("and 2 more" in l for l in bullets),
        "nothing else rode along": len(blocked) == len(bullets) + len(ways_out),
    }
    wrong = sorted(k for k, ok in itemized.items() if not ok)
    check("blockers-listed-with-remedy", "blockers arrive one per line, each class with its way out", not wrong,
          ", ".join(wrong))

    # The inbox files store ISO instants; every report and refusal prints the
    # ledger's local wall time, so a reader never converts timezones by eye.
    real_inboxes = RESOLVER.inbox_state
    real_live, real_stamps = RESOLVER.live_sessions, RESOLVER.stamp_index
    RESOLVER.inbox_state = lambda team: {"team-lead": (26, "2026-08-06T13:33:30.168Z")}
    RESOLVER.live_sessions = lambda: []
    RESOLVER.stamp_index = lambda: {}
    try:
        told = RESOLVER.reap_objections("session-clock", [], archive_mail=False)
    finally:
        RESOLVER.inbox_state = real_inboxes
        RESOLVER.live_sessions, RESOLVER.stamp_index = real_live, real_stamps
    want_when = ms_str(iso_ms("2026-08-06T13:33:30.168Z"))
    check("refusal-prints-ledger-time", "a refusal prints time the way the ledger does",
          told == [f"26 unread for team-lead, oldest {want_when}"],
          "; ".join(told) or "no objection composed")

    # The project's coinages live in docstrings and commit messages; a person
    # at a terminal gets plain words. Docstrings and the suite's own strings
    # are the exemption, and nothing else is.
    doc_strings = set()
    for node in ast.walk(tree):
        body = getattr(node, "body", None)
        if (body and isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef))
                and isinstance(body[0], ast.Expr)
                and isinstance(body[0].value, ast.Constant)
                and isinstance(body[0].value.value, str)):
            doc_strings.add(id(body[0].value))
    suite_lines = set()
    for suite_name in ("run_selftest", "live_checks"):
        suite_fn = funcs.get(suite_name)
        if suite_fn:
            suite_lines.update(range(suite_fn.lineno, suite_fn.end_lineno + 1))
    spoken = sorted({f"line {n.lineno}" for n in ast.walk(tree)
                     if isinstance(n, ast.Constant) and isinstance(n.value, str)
                     and id(n) not in doc_strings and n.lineno not in suite_lines
                     and "window-start" in n.value})
    check("no-coinages-in-output", "the project's own coinages stay out of printed strings", not spoken,
          "; ".join(spoken))

    # The doctor says a shared fact once: members in one state get one note
    # naming all of them, a missing lead is one fact rather than three
    # spellings of None, and a live pid is not echoed by its own evidence.
    real_bits = {}

    def _rewire(**kw):
        for attr, value in kw.items():
            real_bits.setdefault(attr, getattr(RESOLVER, attr))
            setattr(RESOLVER, attr, value)

    census_asked = []
    _rewire(ps_table=lambda refresh=False: [],
            lead_pid=lambda parent, team: (None, False, None, False),
            team_population=lambda team: {"alpha": ("unrecorded", None),
                                          "beta": ("unrecorded", None),
                                          "gamma": ("listed", None)},
            inbox_state=lambda team: {},
            wearers=lambda agent_id, table=None: [],
            roster_entries=lambda **kw: [],
            nameless_receipts=lambda: [],
            known_teams=lambda: (census_asked.append(1), {})[1])
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            _v, lines_none, _r = diagnose_team("session-probe")
            _rewire(lead_pid=lambda parent, team: (
                        7717, True, "pid 7717, whose session id names team session-probe", True),
                    team_minted_by=lambda pid: ("session-probe", True),
                    worn_team=lambda pid: None)
            verdict_live, lines_live, rem_live = diagnose_team("session-probe")
            log_walked = []
            _rewire(roster_of=lambda team: {"members": [
                        {"name": "team-lead", "agentId": f"team-lead@{team}"},
                        {"name": "gamma", "agentId": f"gamma@{team}"}]},
                    _every_log=lambda: (log_walked.append(1), {})[1])
            plain = RESOLVER.standing("gamma@session-probe")
            walked_by_standing = len(log_walked)
            parent_answer = RESOLVER.spawn_parent_of("gamma@session-probe")
            walked_by_parent = len(log_walked) - walked_by_standing
            _rewire(roster_of=lambda team: {"members": []})
            empty = RESOLVER.standing("gamma@session-probe")
            _rewire(team_minted_by=lambda pid: (None, False))
            unrecorded_team = RESOLVER.standing("gamma@session-probe")

            class _DocArgs:
                team, agent_id, all_members = "session-legend", None, False
            real_diag = globals()["diagnose_team"]
            globals()["diagnose_team"] = (
                lambda team, table=None, deep=False: ("CONNECTED", [], []))
            try:
                with contextlib.redirect_stdout(io.StringIO()) as told_doc:
                    run_doctor(_DocArgs())
            finally:
                globals()["diagnose_team"] = real_diag
    finally:
        for attr, value in real_bits.items():
            setattr(RESOLVER, attr, value)

    solo = {
        "a missing lead is one fact": lines_none[0] == "lead     (none)"
            and not any("(None)" in l for l in lines_none),
        "members in one state share one note":
            sum(1 for l in lines_none if l.startswith("note")) == 1
            and any("alpha, beta" in l for l in lines_none),
        "a live pid is said once": lines_live[0].count("pid 7717") == 1,
    }
    wrong = sorted(k for k, ok in solo.items() if not ok)
    check("doctor-shared-fact-once", "the doctor says a shared fact once", not wrong, ", ".join(wrong))

    # A lead whose reading is in doubt is offered both ways to make it read:
    # starting any teammate (immediate, costs nothing) and the flag-bound
    # restart (reads the roster on the way up, costs the lead its turn).
    # Registering from outside is named by neither, because it reaches no
    # lead's memory.
    def offers_both(remedies):
        return (any("start any teammate" in what for what, _c in remedies)
                and any("team flags" in cost or "own identity" in what
                        for what, cost in remedies)
                and all(cost for _w, cost in remedies))

    both = {
        "the doctor's unknowable verdict": verdict_live == "UNKNOWABLE"
            and offers_both(rem_live),
        "a plain lead in standing": plain["polls"][0] is None
            and offers_both(plain["remedies"]),
        "an empty roster in standing": offers_both(empty["remedies"])
            and any("resume this member" in what for what, _c in empty["remedies"]),
        "a lead with no recorded team": offers_both(unrecorded_team["remedies"]),
        # Parentage is its own engine question: the verdict never walks the
        # spawn corpus, only the question whose answer is the parent does,
        # and only the verb that prints it asks that question.
        "the verdict walks no spawn corpus": walked_by_standing == 0,
        "parentage is its own question": walked_by_parent == 1
            and parent_answer == (None, "no spawn payload names this agent"),
        "only the dossier verb asks it": "spawn_parent_of(" in
            (ast.get_source_segment(source, funcs["run_standing"]) or "")
            and "spawn_parent_of(" not in
            (ast.get_source_segment(source, funcs["auto_redirect"]) or ""),
    }
    wrong = sorted(k for k, ok in both.items() if not ok)
    check("doubtful-lead-both-remedies", "a lead whose reading is in doubt is offered both remedies", not wrong,
          ", ".join(wrong))

    # Counts are per-recipient facts; the physics they share is said once.
    grouped = undelivered_mail_lines([
        {"sender": "a", "to": "x", "summary": "", "sent": 1,
         "state": "in memory", "detail": ""},
        {"sender": "b", "to": "y", "summary": "", "sent": 2,
         "state": "in memory", "detail": ""}])
    check("mail-count-per-recipient", "held mail is counted per recipient, its physics said once",
          sum(1 for l in grouped if "memory" in l) == 1
          and sum(1 for l in grouped if "turn boundary" in l) == 1
          and any("x's memory" in l and "y's memory" in l for l in grouped),
          "; ".join(grouped))

    doc_out = told_doc.getvalue()
    legend = {
        "the shown verdict is explained":
            "a live lead runs this team" in " ".join(doc_out.split()),
        "an absent verdict is not": all(v not in doc_out for v in
                                        ("SEVERED", "DEGRADED", "UNKNOWABLE")),
        # the named team is the declared need; the machine-wide census is
        # the sweep's question and must not be resolved for one team
        "a named team asks for no team census": not census_asked,
    }
    wrong = sorted(k for k, ok in legend.items() if not ok)
    check("legend-matches-verdicts", "the legend explains only the verdicts on screen", not wrong,
          ", ".join(wrong))

    # The launch report at a narrow terminal: the block opens with its own
    # blank line, every prose line fits, and the command block strips back
    # to the exact argv it promises to run.
    report_argv = ["/usr/local/bin/claude", "--resume", "1" * 36,
                   "--agent-id", "someone@session-abcdef12",
                   "--agent-name", "someone", "--team-name", "session-abcdef12",
                   "--agent-color", "blue", "--model", "claude-opus-5",
                   "--effort", "max", "--dangerously-skip-permissions"]
    report_ctx = {"session_uuid": "1" * 36,
                  "transcript": (Path("/nonexistent/for-the-width-check.jsonl"),),
                  "via": "agentName+teamName stamps",
                  "placed": ("session-abcdef12", "typed")}
    real_columns = os.environ.get("COLUMNS")
    os.environ["COLUMNS"] = "80"
    try:
        with contextlib.redirect_stdout(io.StringIO()) as told_report:
            report_launch(report_ctx, report_argv, prefix="", role="agent",
                          agent_id="someone@session-abcdef12",
                          extra=[("socket", "claude-swarm-4242  [lead pid 4242] (live)")])
    finally:
        if real_columns is None:
            os.environ.pop("COLUMNS", None)
        else:
            os.environ["COLUMNS"] = real_columns
    report_lines = told_report.getvalue().splitlines()
    cmd_at = next((i for i, l in enumerate(report_lines) if l.startswith("command")), None)
    cmd_back = " ".join(l[9 if i == cmd_at else 11:].rstrip("\\").rstrip()
                        for i, l in enumerate(report_lines[cmd_at:], cmd_at)) \
        if cmd_at is not None else ""
    reported = {
        "the block opens with a blank line": report_lines and report_lines[0] == "",
        "every line fits the terminal": all(len(l) <= 80 for l in report_lines),
        "the command strips back to its argv":
            cmd_at is not None and shlex.split(cmd_back) == report_argv,
        # Facts above, doing below. Without the gap the two blocks read as one
        # wall of text, which is the whole complaint the shape answers.
        "the block closes with a blank line before the doing":
            len(report_lines) > 1 and report_lines[-1] == "",
    }
    wrong = sorted(k for k, ok in reported.items() if not ok)
    check("launch-report-fits-exact", "the launch report fits the terminal and keeps its command exact",
          not wrong, ", ".join(wrong))

    # The zsh completion file is kept by hand beside the tool, so the two can
    # drift apart by whole verbs. Every long flag the parser takes must be
    # offered (aliases and the hidden emitter excepted), and completion must
    # offer nothing the parser would refuse.
    comp_path = Path(__file__).resolve().parent / f"_{TOOL}"
    comp_text = comp_path.read_text() if comp_path.exists() else ""
    main_src = ast.get_source_segment(source, funcs["main"]) or ""
    parser_flags = set(re.findall(r'add_argument\(\s*"(--[a-z-]+)"', main_src))
    comp_flags = set(re.findall(r"'(--[a-z-]+)\[", comp_text))
    aliases = {"--no-colour", "--terminate", "--cleanup-sockets"}
    missing = sorted(parser_flags - comp_flags - {"--complete"})
    unknown = sorted(comp_flags - parser_flags - aliases)
    check("completion-flag-parity", "completion offers every flag the parser takes, and nothing else",
          comp_text and not missing and not unknown,
          f"missing from completion: {missing}; unknown to the parser: {unknown}"
          if (missing or unknown) else "no completion file found")

    # The sides sweep groups under each parent session and bounds itself,
    # saying what it folded and how to see it; a named parent lists in full.
    real_sides_fn = RESOLVER.side_transcripts
    real_title_fn = RESOLVER.transcript_title
    RESOLVER.side_transcripts = lambda parent=None, classify=True: (
        [{"parent": "aaaa1111-fixture", "name": f"side{n}", "task_id": f"t{n}",
          "agent_type": "fork", "grammar": "pointer", "mtime": 1000 - n,
          "detail": ""} for n in range(5)]
        + [{"parent": "bbbb2222-fixture", "name": "only-one", "task_id": "t9",
            "agent_type": "Explore", "grammar": "rooted", "mtime": 500,
            "detail": ""}])
    RESOLVER.transcript_title = lambda stem: (
        "Fixture Parent Title" if stem == "aaaa1111-fixture" else None)
    try:
        with contextlib.redirect_stdout(io.StringIO()) as swept:
            run_sides()
        with contextlib.redirect_stdout(io.StringIO()) as listed_out:
            run_sides("aaaa1111")
    finally:
        RESOLVER.side_transcripts = real_sides_fn
        RESOLVER.transcript_title = real_title_fn
    sweep_text, listed_text = swept.getvalue(), listed_out.getvalue()
    folded = {
        "one header per session": sweep_text.count("aaaa1111") == 2  # header + remedy
            and sweep_text.count("bbbb2222") == 1,
        "the header names the whole transcript":
            "aaaa1111-fixture  (5 pointer)" in sweep_text,
        "the parent wears its title": "Fixture Parent Title" in sweep_text
            and sweep_text.index("aaaa1111-fixture") < sweep_text.index("Fixture Parent Title"),
        "newest few shown, rest counted": "side2" in sweep_text
            and "side3" not in sweep_text
            and "...and 2 more  (--sides aaaa1111 lists them)" in sweep_text,
        "counts ride the header": "(5 pointer)" in sweep_text
            and "(1 rooted)" in sweep_text,
        "a named parent lists in full": all(f"side{n}" in listed_text
                                           for n in range(5))
            and "...and" not in listed_text,
    }
    wrong = sorted(k for k, ok in folded.items() if not ok)
    check("sides-sweep-folds", "the sides sweep folds each session and says what it folded",
          not wrong, ", ".join(wrong))

    # A typed side is one declared need: the task-id and parent/name
    # spellings classify the hit alone, and only the root spelling, whose
    # answer lives in the bytes, buys the corpus a read.
    with tempfile.TemporaryDirectory() as td:
        for parent_dir, task, side_name, root in (
                ("PARENT-A", "t1", "first-side", "root-1"),
                ("PARENT-A", "t2", "second-side", "root-2"),
                ("PARENT-B", "t3", "third-side", "root-3")):
            side_dir = Path(td) / "projx" / parent_dir / "subagents"
            side_dir.mkdir(parents=True, exist_ok=True)
            (side_dir / f"agent-{task}.jsonl").write_text(json.dumps(
                {"parentUuid": None, "isSidechain": True, "uuid": root,
                 "type": "user"}) + "\n")
            (side_dir / f"agent-{task}.meta.json").write_text(json.dumps(
                {"name": side_name, "agentType": "fork"}))
        eng11 = Resolver(needs=Needs(maybe=set(NEED)))
        eng11.projects_dir = Path(td)
        graded = []
        real_grammar = eng11._side_grammar
        eng11._side_grammar = lambda p: (graded.append(p), real_grammar(p))[1]
        by_task, _why = eng11.side_transcript("t1")
        task_cost = len(graded)
        graded.clear()
        by_pair, _why = eng11.side_transcript("PARENT-A/second-side")
        pair_cost = len(graded)
        graded.clear()
        by_root, _why = eng11.side_transcript("root-3")
        root_cost = len(graded)
    typed = {
        "a task id classifies one": task_cost == 1
            and by_task and by_task["grammar"] == "rooted" and by_task["root"] == "root-1",
        "a parent/name pair classifies one": pair_cost == 1
            and by_pair and by_pair["root"] == "root-2",
        "a root spelling still reads the corpus, and finds it": root_cost == 3
            and by_root and by_root["root"] == "root-3",
    }
    wrong = sorted(k for k, ok in typed.items() if not ok)
    check("typed-side-classifies-alone", "one typed side classifies the hit alone", not wrong,
          ", ".join(wrong) or f"costs {task_cost}/{pair_cost}/{root_cost}")

    # Compute is a constructor contract: declared as an enum set, nothing by
    # default, refused by name at use when undeclared and at end of run when
    # declared and never exercised, with the conditional bucket the honest
    # escape for a branchy path. (Python swallows a raise from __del__, so the
    # end-of-run audit is the destructor this contract can enforce.)
    with tempfile.TemporaryDirectory() as td:
        mute = Resolver()
        mute.projects_dir = Path(td)
        refused = ""
        try:
            mute.stamp_index()
        except RuntimeError as err:
            refused = str(err)
        allowed = Resolver(needs=Needs(hard={NEED.STAMPS}))
        allowed.projects_dir = Path(td)
        answered = allowed.stamp_index() == {}
        try:
            allowed.audit_needs()
            lean_ok = True
        except RuntimeError:
            lean_ok = False
        fat = Resolver(needs=Needs(hard={NEED.STAMPS, NEED.PROCS}))
        fat.projects_dir = Path(td)
        fat.stamp_index()
        fat_refused = ""
        try:
            fat.audit_needs()
        except RuntimeError as err:
            fat_refused = str(err)
        excused = Resolver(needs=Needs(hard={NEED.STAMPS}, maybe={NEED.PROCS}))
        excused.projects_dir = Path(td)
        excused.stamp_index()
        try:
            excused.audit_needs()
            maybe_ok = True
        except RuntimeError:
            maybe_ok = False
    side_refused = ""
    try:
        Resolver()._stamped_candidates("nobody")
    except RuntimeError as err:
        side_refused = str(err)
    contract = {
        "an undeclared compute refuses by name":
            "transcript identity stamps" in refused and "NEED.STAMPS" in refused,
        "a side path refuses like the front door":
            "transcript identity stamps" in side_refused,
        "a declared one answers, and a lean run audits clean": answered and lean_ok,
        "a fat declaration is refused at the end": "PROCS" in fat_refused
            and "STAMPS" not in fat_refused,
        "a conditional declaration is excused unexercised": maybe_ok,
        "the verbs declare before anything computes":
            "RESOLVER = Resolver(needs=verb_needs(args, selector))" in main_src
            and main_src.index("Resolver(needs=verb_needs")
                < main_src.index("RESOLVER.ps_table()"),
    }
    # One reader. A declaration's buckets are the engine's business; anything
    # else asks needs[X] and gets one of three answers. Two readers of one
    # shape is the fault this file has already had with holder questions and
    # identity rungs, so it is refused rather than remembered.
    readers = set()
    for fn in ast.walk(tree):
        if not isinstance(fn, ast.FunctionDef) or fn.name == "run_selftest":
            continue
        body = ast.get_source_segment(source, fn) or ""
        if ".hard" in body or ".reachable" in body:
            readers.add(fn.name)
    engine_methods = {m.name for m in engine_node.body
                      if isinstance(m, ast.FunctionDef)} | {"hard", "reachable"}
    stray_readers = sorted(readers - engine_methods)
    contract["only the engine reads a declaration's buckets"] = not stray_readers

    wrong = sorted(k for k, ok in contract.items() if not ok)
    check("compute-declared-and-audited", "compute is declared at construction and audited at the end",
          not wrong, ", ".join(wrong))

    # A pane id is per-server: a recorded one is a fact only while its server
    # runs and still carries it. Anything else must not be echoed as a seat
    # the agent has, nor aimed at by the launch.
    real_list_panes = RESOLVER.list_panes
    RESOLVER.list_panes = lambda sock: (
        [{"session": "s", "window": "@1", "pane": "%2", "pid": 1}]
        if sock == "sock-carrying" else [])
    try:
        kept = RESOLVER.seat_note("%2", "sock-carrying")
        gone = RESOLVER.seat_note("%2", "sock-dead")
        blank = RESOLVER.seat_note(None, "sock-carrying")
    finally:
        RESOLVER.list_panes = real_list_panes
    seats_said = {
        "a carried pane is aimed at and said": kept == ("%2", "%2"),
        "a gone pane is aimed at nothing and says what became of it":
            gone[0] is None and "%2" in gone[1] and "gone" in gone[1],
        "no record reads as no record": blank == (None, "(none recorded)"),
        "the member report asks it": "seat_note(" in run_one_src,
    }
    wrong = sorted(k for k, ok in seats_said.items() if not ok)
    check("pane-fact-needs-server", "a recorded pane is a fact only while its server carries it",
          not wrong, ", ".join(wrong))

    # The attach offer is made only where a server exists: a keypress whose
    # only outcome is "nothing to attach to" is not an offer.
    real_alive_fn = RESOLVER.socket_alive
    real_confirm_fn = globals()["confirm_attach"]
    real_one_fn = globals()["run_one"]
    offered_at = []
    try:
        RESOLVER.socket_alive = lambda s: s == "sock-live"
        globals()["confirm_attach"] = (
            lambda targets, table, sock: (offered_at.append(sock), False)[1])
        globals()["run_one"] = (
            lambda a, p, t, prefix="", pending=(): Outcome("noop", a.socket, False, None))

        class _AttachJob:
            dry_run, no_attach, attach, agent_id = False, False, False, None
        with contextlib.redirect_stdout(io.StringIO()):
            for sock in ("sock-dead", "sock-live"):
                job = _AttachJob()
                job.socket = sock
                run_agents(job, [], {}, [(None, job)], socket=sock)
    finally:
        RESOLVER.socket_alive = real_alive_fn
        globals()["confirm_attach"] = real_confirm_fn
        globals()["run_one"] = real_one_fn
    check("attach-only-if-server", "an attach is offered only where a server exists",
          offered_at == ["sock-live"], f"offered at {offered_at or 'nowhere'}")

    # A noop on a live process says where that process actually sits, asked
    # of the process (socket_hosting), never echoed from a roster.
    class _NoForceSeat:
        force = False
    real_owner_fn, real_hosting_fn = RESOLVER.lead_pid_for, RESOLVER.socket_hosting
    RESOLVER.lead_pid_for = lambda uuid: (777, "x", True)
    RESOLVER.socket_hosting = lambda ids, table: (None, None)
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            unseated = already_running({"session_uuid": "seat-uuid"}, _NoForceSeat,
                                       is_lead=False, agent_id="m@t", table=[])
            RESOLVER.socket_hosting = lambda ids, table: ("sock-z", "live pane of pid 9")
            seated = already_running({"session_uuid": "seat-uuid"}, _NoForceSeat,
                                     is_lead=False, agent_id="m@t", table=[])
    finally:
        RESOLVER.lead_pid_for = real_owner_fn
        RESOLVER.socket_hosting = real_hosting_fn
    seat_says = {
        "outside tmux is said": unseated and "outside any tmux pane" in unseated[0],
        "a real seat is named": seated and "sock-z" in seated[0],
    }
    wrong = sorted(k for k, ok in seat_says.items() if not ok)
    check("noop-says-live-location", "a noop says where the live process actually sits", not wrong,
          ", ".join(wrong))

    # Classification, not position, decides what a token is. Every entry must
    # carry both facts, or a future flag is added half-specified and the walk
    # silently treats its value as a name.
    shape = [f for f, spec in PASSTHROUGH_FLAGS.items()
             if not (isinstance(spec, Flag) and spec.scope in (ONE, MANY)
                     and isinstance(spec.valued, bool))]
    check("flag-declares-scope-arity", "every forwarded flag declares scope and arity", not shape, ", ".join(sorted(shape)))

    with contextlib.redirect_stderr(io.StringIO()):
        two_selectors = False
        try:
            classify_passthrough(["a@b", "c@d"])
        except SystemExit:
            two_selectors = True
    classified = {
        "bare alone": classify_passthrough(["a@b"]) == ("a@b", []),
        "before a valued flag": classify_passthrough(["a@b", "--model", "x"])
            == ("a@b", ["--model", "x"]),
        "after a valued flag": classify_passthrough(["--model", "x", "a@b"])
            == ("a@b", ["--model", "x"]),
        "between flags": classify_passthrough(["--verbose", "a@b", "--model", "x"])
            == ("a@b", ["--verbose", "--model", "x"]),
        "a value is not a name": classify_passthrough(["--model", "opus"]) == (None, ["--model", "opus"]),
        "equals spelling": classify_passthrough(["--model=x", "a@b"]) == ("a@b", ["--model=x"]),
        "after a boolean flag": classify_passthrough(["--verbose", "a@b"]) == ("a@b", ["--verbose"]),
        "two names refused": two_selectors,
        "-- forwards verbatim": classify_passthrough(["a@b", "--", "raw", "--x"])
            == ("a@b", ["--", "raw", "--x"]),
        "-- shields a bare word": classify_passthrough(["a@b", "--", "c@d"])[0] == "a@b",
    }
    wrong = sorted(k for k, good in classified.items() if not good)
    check("selector-found-anywhere", "a selector is found wherever it sits", not wrong, ", ".join(wrong))

    # --stop resolves a selector that has already become args; shapes each
    # derived separately from a mangled argv all break at once.
    stop_base = Path(tempfile.mkdtemp())
    stop_team = "session-selftest"
    (stop_base / stop_team / "inboxes").mkdir(parents=True)
    (stop_base / stop_team / "config.json").write_text(json.dumps({
        "name": stop_team, "leadAgentId": f"team-lead@{stop_team}", "leadSessionId": "x",
        "members": [{"agentId": f"team-lead@{stop_team}", "name": "team-lead"},
                    {"agentId": f"m1@{stop_team}", "name": "m1"}]}))
    real_teams_dir, real_running = RESOLVER.teams_dir, globals()["running_agents"]
    real_holders = RESOLVER.holders_of
    RESOLVER.teams_dir = stop_base
    globals()["running_agents"] = lambda targets, table: [(0, t, "", "") for t in targets]
    RESOLVER.holders_of = lambda uuid, table: [(0, None)]

    class _Sel:
        def __init__(self, **kw):
            self.team = self.agent_id = self.resume = None
            self.__dict__.update(kw)

    try:
        shapes = {
            "agent": len(stop_targets(_Sel(agent_id=f"m1@{stop_team}"), {})) == 1,
            "team": len(stop_targets(_Sel(team=stop_team), {})) == 2,
            "session": len(stop_targets(_Sel(resume="abcd-1234"), {})) == 1,
        }
        bad = sorted(k for k, good in shapes.items() if not good)
    finally:
        RESOLVER.teams_dir, RESOLVER.holders_of = real_teams_dir, real_holders
        globals()["running_agents"] = real_running
        shutil.rmtree(stop_base, ignore_errors=True)
    check("stop-resolves-selector-shapes", "--stop resolves every selector shape", not bad, ", ".join(bad))

    # --- forwarded flags: the allowlist, the scope rule, and whether a flag
    # could have applied at all. Each was a live defect before it was a check.
    class _Parser:
        _actions = [type("a", (), {"option_strings": ["--dry-run", "--force"]})()]

    def _dies(fn, *a, **kw):
        with contextlib.redirect_stderr(io.StringIO()) as err:
            try:
                fn(*a, **kw)
                return False, ""
            except SystemExit:
                return True, err.getvalue()

    typo_died, typo_msg = _dies(check_passthrough, ["--dry-ryn"], _Parser())
    junk_died, junk_msg = _dies(check_passthrough, ["--frobnicate"], _Parser())
    flags = {
        "a typo is refused": typo_died,
        "and names the flag meant": "--dry-run" in typo_msg,
        "an unknown flag is refused": junk_died,
        "with no invented suggestion": "did you mean" not in junk_msg,
        "a table flag passes": not _dies(check_passthrough, ["--effort", "low"], _Parser())[0],
        "past -- is not judged": not _dies(check_passthrough, ["--", "--anything"], _Parser())[0],
    }
    wrong = sorted(k for k, good in flags.items() if not good)
    check("forward-only-known-flags", "only flags the table knows are forwarded", not wrong, ", ".join(wrong))

    scope = {
        "one-agent flag refused for many": _dies(check_flag_scope, ["--agent-color", "red"], 4)[0],
        "one-agent flag fine for one": not _dies(check_flag_scope, ["--agent-color", "red"], 1)[0],
        "many-agent flag fine for many": not _dies(check_flag_scope, ["--effort", "low"], 4)[0],
    }
    wrong = sorted(k for k, good in scope.items() if not good)
    check("flag-single-agent-refused", "a flag naming one agent is refused for a run of several", not wrong, ", ".join(wrong))

    class _Args:
        def __init__(self, **kw):
            self.dry_run = False
            self.__dict__.update(kw)

    took = {
        "nothing started is refused": _dies(
            check_flags_took_effect, ["--effort", "low"], [("x", "noop")], _Args())[0],
        "a launch is accepted": not _dies(
            check_flags_took_effect, ["--effort", "low"], [("x", "launched")], _Args())[0],
        "a printed lead command counts": not _dies(
            check_flags_took_effect, ["--effort", "low"], [("x", "manual")], _Args())[0],
        "one of several starting is enough": not _dies(
            check_flags_took_effect, ["--effort", "low"],
            [("x", "noop"), ("y", "launched")], _Args())[0],
        "a failure is not called 'already running'": not _dies(
            check_flags_took_effect, ["--effort", "low"], [("x", "failed")], _Args())[0],
        "a dry run never complains": not _dies(
            check_flags_took_effect, ["--effort", "low"], [("x", "noop")], _Args(dry_run=True))[0],
    }
    wrong = sorted(k for k, good in took.items() if not good)
    check("flag-inapplicable-not-reported", "a flag that could not apply is not reported as applied", not wrong, ", ".join(wrong))

    # A lead execs away mid-loop, so anything the run was still watching would go
    # unreported unless it is handed to the lead before it takes over.
    real_one, real_report = run_one, report_transcript_writes
    handed = []
    try:
        def _fake_one(args_, passthrough_, table_, prefix="", pending=()):
            handed.append([label for label, *_ in pending])
            if len(handed) < 3:
                return Outcome("launched", "s", False, (f"member{len(handed)}", Path("p"), 1))
            return Outcome("manual", None, True, None)
        globals()["run_one"] = _fake_one
        globals()["report_transcript_writes"] = lambda *a, **kw: None
        with contextlib.redirect_stdout(io.StringIO()):
            job_args = _Args(no_attach=True, attach=False)
            run_agents(job_args, [], {},
                       [("m1", job_args), ("m2", job_args), ("lead", job_args)], socket="s")
    finally:
        globals()["run_one"], globals()["report_transcript_writes"] = real_one, real_report
    check("lead-told-loading-before-takeover", "a lead is told what is still loading before it takes over",
          handed == [[], ["member1"], ["member1", "member2"]], str(handed))

    # Only Recipe 1's dead port is stripped from a revived agent's environment.
    # Stripping every base url would silently send an agent to a different
    # endpoint than its lead talks to, which fails quietly where a poisoned
    # child fails loudly at connect.
    poison_calls = {
        "the dead port": base_url_is_poison(POISON_URL),
        "with a trailing slash": base_url_is_poison(POISON_URL + "/"),
        "a real endpoint": not base_url_is_poison("https://api.anthropic.com"),
        "a proxy": not base_url_is_poison("http://proxy.internal:8080"),
        "another local port": not base_url_is_poison("http://127.0.0.1:8080"),
        "unset": not base_url_is_poison(None),
    }
    wrong = sorted(k for k, good in poison_calls.items() if not good)
    check("launch-strips-only-poison", "only the poison is stripped from a launch", not wrong, ", ".join(wrong))

    # The merge is an engine internal: a caller reaching into it can assemble a
    # different answer than the engine did.
    reachers = sorted(
        node.name for node in tree.body
        if isinstance(node, ast.FunctionDef)
        and re.search(r"\.pick\(|_Merged\(", ast.get_source_segment(source, node) or ""))
    check("merge-reached-via-engine", "the merge is reached only through the engine", not reachers, ", ".join(reachers))

    # A roster writer takes the engine's description and reads no field itself.
    # The ban is total: no field read in a function that writes a roster.
    # Function-local: a helper handed ctx could read on a writer's behalf.
    def writes_roster(fn):
        return any(isinstance(c, ast.Call) and isinstance(c.func, ast.Name)
                   and c.func.id == "edit_team_config" for c in ast.walk(fn))

    def reads_a_field(fn):
        return any(isinstance(c, ast.Call) and isinstance(c.func, ast.Attribute)
                   and c.func.attr in ("field", "agent_cwd") for c in ast.walk(fn))

    assemblers = sorted(node.name for node in tree.body
                        if isinstance(node, ast.FunctionDef)
                        and writes_roster(node) and reads_a_field(node))
    check("roster-writer-no-own-read", "a roster writer reads no field of its own", not assemblers, ", ".join(assemblers))

    # The doctor composes answers and gathers nothing. A diagnosis assembled from
    # its own reads could reach a conclusion the tool would not reach when acting,
    # which is the whole fault it exists to report on.
    gathered = []
    for node in tree.body:
        if not (isinstance(node, ast.FunctionDef) and node.name in ("diagnose_team", "run_doctor")):
            continue
        for call in ast.walk(node):
            if not isinstance(call, ast.Call):
                continue
            fn = call.func
            if isinstance(fn, ast.Name) and fn.id in ("open", "Path"):
                gathered.append(f"{node.name} calls {fn.id}")
            if isinstance(fn, ast.Attribute) and isinstance(fn.value, ast.Name):
                if fn.value.id in ("json", "os", "sp", "subprocess", "shutil", "time"):
                    gathered.append(f"{node.name} calls {fn.value.id}.{fn.attr}")
                if fn.value.id == "RESOLVER" and fn.attr.startswith("_"):
                    gathered.append(f"{node.name} reaches {fn.attr}")
    check("doctor-invents-no-evidence", "the doctor invents no evidence", not gathered, ", ".join(sorted(set(gathered))))

    # Assembly is exercised, not just its parts: a structural battery can pass
    # over a NameError in identity() while every real invocation dies, when
    # nothing in the suite calls the function that answers who an agent is.
    eng = corpus_engine()
    name, team = "willow", "session-corpus-alpha"
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            assembled = eng.identity(agent_id=f"{name}@{team}")
        got = eng.field(assembled, "agentId")
        why = assembled.get("via")
    except (Exception, SystemExit) as exc:         # the point is that it runs
        got, why = None, f"{type(exc).__name__}: {exc}"
    check("identity-can-assemble", "an identity can actually be assembled", bool(got and why),
          f"{name}@{team} -> {got or why}")

    # Supplying an id and a name that contradict describes an agent that cannot
    # exist, and the name is the routing key, so the wrong one reads a mailbox
    # nobody writes to.
    class _Flags:
        def __init__(self, agent_id):
            self.agent_id = agent_id

    with contextlib.redirect_stderr(io.StringIO()):
        try:
            check_identity_flags(_Flags("auth@session-x"), ["--agent-name", "katalog"])
            refused_mismatch = False
        except SystemExit:
            refused_mismatch = True
        try:
            check_identity_flags(_Flags("auth@session-x"), ["--agent-name", "auth"])
            allowed_match = True
        except SystemExit:
            allowed_match = False
    check("id-name-mismatch-refused", "an id and a name that disagree are refused", refused_mismatch and allowed_match,
          f"mismatch refused: {refused_mismatch}, match allowed: {allowed_match}")

    # A launch must never wear two identities. --agent-id and --agent-name were
    # derived independently, so a lead resolved as team-lead@<team> went out with
    # whatever name its transcript last carried; the harness stamped every line
    # with that name, and the next resume refused the session because its stamps
    # no longer matched its roster. The tool corrupted what it was restoring.
    class _Emit:
        def __init__(self, agent_id):
            self.resume = self.team = self.to_team = None
            self.agent_id, self.force, self.dry_run = agent_id, False, True
            self.claude_bin, self.no_color = None, True

    mismatched = []
    with contextlib.redirect_stderr(io.StringIO()):
        for entry in RESOLVER.scan_teams():
            agent_id = entry["member"].get("agentId")
            if not agent_id:
                continue
            try:
                command = build_command(RESOLVER.identity(agent_id=agent_id),
                                        _Emit(agent_id), [])
            except SystemExit:
                continue
            flags = dict(zip(command, command[1:]))
            wore = flags.get("--agent-id") or ""
            name_half, _, team_half = wore.partition("@")
            called, on_team = flags.get("--agent-name"), flags.get("--team-name")
            if wore and called and called != name_half:
                mismatched.append(f"{wore} as {called}")
            if wore and on_team and on_team != team_half:
                mismatched.append(f"{wore} on team {on_team}")
    check("launch-wears-one-identity", "a launch wears one identity", not mismatched, "; ".join(mismatched[:2]))

    # --bare is the conversation and nothing the tool chose. Measured against
    # the same launch without it, so a bare command cannot pass by being short
    # for some other reason: the dressed one has to carry the identity that the
    # bare one drops, or neither half of this proves anything.
    real_resolver = globals()["RESOLVER"]
    globals()["RESOLVER"] = corpus_engine()
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            who = "willow@session-corpus-alpha"
            dressed = build_command(RESOLVER.identity(agent_id=who), _Emit(who), [])
            stripped_args = _Emit(who)
            stripped_args.bare = True
            stripped = build_command(RESOLVER.identity(agent_id=who), stripped_args, [])
            carried = build_command(RESOLVER.identity(agent_id=who), stripped_args,
                                    ["--verbose"])
    finally:
        globals()["RESOLVER"] = real_resolver
    dressed_flags = [t for t in dressed if t.startswith("--")]
    check("bare-passes-only-the-conversation",
          "--bare passes the conversation and nothing the tool chose",
          "--agent-id" in dressed_flags and len(dressed_flags) > 1
          and [t for t in stripped if t.startswith("--")] == ["--resume"]
          and carried[-1] == "--verbose",
          f"dressed {dressed_flags}, bare {[t for t in stripped if t.startswith('--')]}")

    # And it joins nothing: a roster entry would record a membership the command
    # does not carry. The writers are stubbed rather than trusted to a dry run,
    # so the check sees the attempt itself. Its probe is what proves this is not
    # vacuous: with the guard gone, the same call writes.
    wrote = []
    real_reg, real_inbox = globals()["register_member"], globals()["ensure_inbox"]
    real_update = globals()["update_team_config"]
    globals()["register_member"] = lambda *a, **k: wrote.append("roster")
    globals()["ensure_inbox"] = lambda *a, **k: wrote.append("inbox")
    globals()["update_team_config"] = lambda *a, **k: wrote.append("config")
    globals()["RESOLVER"] = corpus_engine()
    try:
        joining = _Emit(who)
        joining.bare, joining.no_update_config = True, False
        with contextlib.redirect_stderr(io.StringIO()):
            record_membership(RESOLVER.identity(agent_id=who), joining, None)
    finally:
        globals()["register_member"], globals()["ensure_inbox"] = real_reg, real_inbox
        globals()["update_team_config"] = real_update
        globals()["RESOLVER"] = real_resolver
    check("bare-joins-no-team", "a bare resume writes into no roster", not wrote,
          f"wrote {wrote}")

    # A stamp contradicting the roster is reported, never tolerated: it is
    # what catches a lead launched under a wrong name. The refusal
    # carries the remedy when the roster and the payloads agree on the identity
    # being asked for, so a corrupted stamp is recoverable without being ignored.
    eng = corpus_engine()
    team = "session-corpus-contradicted"
    path, _why = eng.lead_transcript_for(team)
    with contextlib.redirect_stderr(io.StringIO()):
        found = eng.resolve_transcript(lead_session=path.stem, team=team, is_lead=True)
    contradicted = eng.objections(found, "team-lead", team)
    raised = [o for o in contradicted if o[0] == "name_mismatch"]
    spoken = ""
    if raised:
        with contextlib.redirect_stderr(io.StringIO()) as said:
            try:
                enforce_identity(found, raised, allow_team_change=False, force=False)
            except SystemExit:
                pass
        spoken = said.getvalue()
    check("contradicted-stamp-refused", "a contradicted stamp is refused, with a way forward",
          bool(raised) and "--force resumes it" in spoken,
          f"raised={bool(raised)}, remedy={'--force resumes it' in spoken}")

    # The reaper bets deletions on the soul count, and that count now consults
    # stamps as well as the roster. Too permissive and a dead directory is kept
    # forever; too strict and somebody's memory is deleted. Both fixtures are
    # backdated past the age grace, or they are kept for being new and the check
    # proves nothing.
    reap_base = Path(tempfile.mkdtemp())
    real_teams_dir, aged = RESOLVER.teams_dir, time.time() - 86400
    try:
        RESOLVER.teams_dir = reap_base

        def stage(name, members):
            directory = reap_base / name
            (directory / "inboxes").mkdir(parents=True)
            (directory / "inboxes" / "team-lead.json").write_text("[]")
            cfg = directory / "config.json"
            cfg.write_text(json.dumps({"name": name, "leadAgentId": f"team-lead@{name}",
                                       "leadSessionId": "no-such-session-uuid",
                                       "members": members}))
            for path in (cfg, directory / "inboxes" / "team-lead.json",
                         directory / "inboxes", directory):
                os.utime(path, (aged, aged))
            return cfg

        gone = stage("session-selftest-gone",
                     [{"agentId": "team-lead@session-selftest-gone", "name": "team-lead"},
                      {"agentId": "nobody@session-selftest-gone", "name": "nobody-here-at-all"}])
        survivor = next((n for n, t in RESOLVER.stamp_index().values() if n and t), None)
        held = stage("session-selftest-held",
                     [{"agentId": "team-lead@session-selftest-held", "name": "team-lead"},
                      {"agentId": f"{survivor}@session-selftest-held", "name": survivor}]) \
            if survivor else None
        with contextlib.redirect_stderr(io.StringIO()):
            table = RESOLVER.ps_table()
            reapable = team_keep_reason(gone, table) is None
            kept = team_keep_reason(held, table) is not None if held else True
    finally:
        RESOLVER.teams_dir = real_teams_dir
        shutil.rmtree(reap_base, ignore_errors=True)
    check("reaper-spares-resurrectable", "the reaper spares what can still be resurrected", reapable and kept,
          f"dead reapable: {reapable}, live kept: {kept}")

    # Enumeration and the single-token question must not diverge: a team the
    # selector accepts and rebuilds was missing from the list of teams, which is
    # revivable-but-undiscoverable, the mirror of advertised-then-deleted.
    known = RESOLVER.known_teams()
    disagreed = sorted(t for t in known if RESOLVER.team_evidence(t) != known[t])
    check("team-evidence-one-answer", "what is a team is one answer", not disagreed, ", ".join(disagreed[:3]))

    offered = io.StringIO()
    with contextlib.redirect_stdout(offered):
        run_complete("teams")
    listed = {line.split(":", 1)[0] for line in offered.getvalue().splitlines() if line}
    unlisted = sorted(set(known) - listed)
    check("completion-lists-every-team", "every team the engine knows is offered", not unlisted, ", ".join(unlisted[:3]))

    # A lead may carry a name of its own. An agent that ran with --agent-name and
    # no --team-name, then spawned teammates, is that team's lead while being
    # stamped with its own name; keying lead-ness on "no stamps at all" left it
    # between the branches and its team could not be rebuilt at all.
    eng = corpus_engine()
    team, uuid = "session-corpus-orphan", "44444444-4444-4444-8444-444444444444"
    with contextlib.redirect_stderr(io.StringIO()):
        assembled = eng.identity(session_uuid=uuid, for_team=team)
    check("named-lead-still-leads", "a lead with a name of its own still leads its team",
          assembled.get("leads_team") == team
          and assembled.get("lead_agent_id") == f"team-lead@{team}",
          f"{uuid[:8]} -> {assembled.get('leads_team')}")

    # The same lead one life later: stamped with a team it used to run as, asked
    # about a team it led afterwards. The stamps answer an older question, so the
    # named team has to win in the stamped branch too, or a reaped team whose lead
    # went on to lead another cannot be rebuilt at all.
    eng = corpus_engine()
    other, uuid = "session-corpus-new", "55555555-5555-4555-8555-555555555555"
    with contextlib.redirect_stderr(io.StringIO()):
        stamped = eng.stamp_index().get(eng.lead_transcript_for(other)[0], (None, None))[1]
    with contextlib.redirect_stderr(io.StringIO()):
        assembled = eng.identity(session_uuid=uuid, for_team=other)
    check("named-team-outranks-stamps", "a named team outranks the stamps of an earlier life",
          assembled.get("lead_agent_id") == f"team-lead@{other}",
          f"{uuid[:8]} stamped {stamped}, asked {other}, "
          f"got {assembled.get('lead_agent_id')}")

    # A lead that ran several teams must rebuild the one that was named, not
    # whichever it ran as last. The fault has two spellings: a forge proposing
    # the newest team's name over the right members, and an agent id resolving
    # the right transcript under the wrong team.
    eng = corpus_engine()
    stem = "59e91a1e-5e91-4a1e-859e-91a1e59e91a1"
    teams = eng.teams_led_by(stem)
    # Every payload handed back for a team must belong to that team. The
    # fault shape is a lead's newest team answering for an older one, which
    # shows up here as a payload stamped with a team nobody asked about.
    strays = {t: [p["name"] for p in eng.members_spawned_into(stem, t)
                  if p.get("team_name") != t]
              for t in teams}
    wrong = sorted(t for t, names in strays.items() if names)
    check("named-team-not-newest", "a named team is rebuilt, not the lead's newest",
          len(teams) > 1 and not wrong,
          f"{len(teams)} teams from one lead; strays in {', '.join(wrong)}" if wrong
          else f"{len(teams)} teams from one lead, none crossed")

    # A dry run must promise what a real run does. They share one code path, so
    # the check is that the path really is shared: the forge hands back the same
    # roster in both modes rather than the preview enumerating separately.
    forge_src = ast.get_source_segment(source, funcs["forge_team"])
    returns_both = forge_src.count("return config") >= 2
    check("forge-preview-matches-real", "a preview and a real forge return the same roster", returns_both,
          f"{forge_src.count('return config')} return sites")

    # A guess must not be written where it will later be read as a fact. Rung 1
    # reads leadSessionId as EXACT and asks nothing more, so an uncorroborated
    # rebuild leaves it empty and the ladder re-derives, and re-warns, every run.
    # A roster with no leadSessionId also cannot corroborate a claim about the
    # lead, or the roster we derived from these payloads would vouch for them.
    forged = {"name": "session-forgecheck", "createdAt": 1,
              "leadAgentId": "team-lead@session-forgecheck", "leadSessionId": "",
              "members": [{"agentId": "team-lead@session-forgecheck", "name": "team-lead"},
                          {"agentId": "m1@session-forgecheck", "name": "m1"}]}
    real_rosters = RESOLVER.rosters
    try:
        RESOLVER.rosters = lambda: [(Path("/nowhere/config.json"), forged, 0)]
        vouched = [e for e in RESOLVER.roster_entries(team="session-forgecheck")
                   if e.get("leadSessionId")]
    finally:
        RESOLVER.rosters = real_rosters
    check("roster-without-lead-refuses", "a roster with no lead cannot corroborate one", not vouched,
          f"{len(vouched)} entries vouched")

    # One classifier decides what a token names; a selector running its own
    # roster-name scan and several-rosters refusal beside the engine's is one
    # rule in two implementations, answering in two voices.
    kinds = {
        "a uuid": RESOLVER.classify("2a38de2d-bd34-4c7f-8f9a-000000000000")[0] == "uuid",
        "an agent id": RESOLVER.classify("someone@session-abcdef12")[0] == "agent_id",
        # A team's roster is portable-corpus data (see corpus_engine()), not
        # whatever this machine happens to have: classify() only takes one
        # engine, so the corpus is asked directly rather than through RESOLVER.
        "a team with a roster": corpus_engine().classify("session-corpus-alpha")[0] == "team",
        "an unknown team shape": RESOLVER.classify("session-deadbeef")[0] == "unknown",
        "an unknown name": RESOLVER.classify("no-such-agent-anywhere")[0] == "unknown",
    }
    wrong = sorted(k for k, good in kinds.items() if not good)
    check("classifier-one-answer", "one classifier says what a selector names", not wrong, ", ".join(wrong))

    # A team outlives its directory: a graceful lead exit removes the roster, so
    # existence alone reports a cleaned-up team as one that never existed.
    real_by_team = RESOLVER._by_team
    try:
        RESOLVER._by_team = dict(real_by_team or {})
        RESOLVER._by_team["session-ghostteam"] = [(1, Path("/nowhere/x.jsonl"))]
        evidence = {
            "known only by payloads": RESOLVER.team_evidence("session-ghostteam")
                == "spawn payloads naming it",
            "unknown is not a team": RESOLVER.team_evidence("session-deadbeef") is None,
        }
    finally:
        RESOLVER._by_team = real_by_team
    wrong = sorted(k for k, good in evidence.items() if not good)
    check("team-recognised-without-directory", "a team is recognised without its directory", not wrong, ", ".join(wrong))

    with contextlib.redirect_stderr(io.StringIO()) as diag:
        try:
            apply_selector("session-deadbeef", _Args(resume=None, agent_id=None, team=None), {})
        except SystemExit:
            pass
    # Normalised before matching: the refusal wraps for the terminal, and this
    # asserts what it says, not where its line breaks fall.
    said = " ".join(diag.getvalue().split())
    named = all(kind in said for kind in ("roster on disk", "spawn payloads", "stamped"))
    check("unknown-team-names-lacking-evidence", "an unknown team-shaped token names every evidence it lacks", named, said.strip()[:70])

    # --- the attach prompt: which key does what, and when it is offered at all
    real_key, real_abort, real_stdin = read_one_key, abort_agents, sys.stdin
    aborted = []
    globals()["abort_agents"] = lambda running, assume_yes=False: aborted.append(1) or 0
    globals()["running_agents"] = globals()["running_agents"]
    keys = {}
    try:
        # confirm_attach asks whether anyone can answer before it asks anything,
        # so a check for what the keys do has to look like a terminal.
        sys.stdin = types.SimpleNamespace(isatty=lambda: True)
        for name, key, want_attach, want_abort in (
                ("a plain key attaches", "\r", True, False),
                ("Ctrl-C skips", "\x03", False, False),
                ("Ctrl-X aborts", "\x18", False, True)):
            globals()["read_one_key"] = (lambda k: (lambda: k))(key)
            aborted.clear()
            with contextlib.redirect_stdout(io.StringIO()):
                got = confirm_attach([], {}, "sock")
            keys[name] = got == want_attach and bool(aborted) == want_abort
        sys.stdin = types.SimpleNamespace(isatty=lambda: False)
        with contextlib.redirect_stdout(io.StringIO()) as out:
            keys["no terminal does not prompt"] = confirm_attach([], {}, "sock") and not out.getvalue()
    finally:
        globals()["read_one_key"], globals()["abort_agents"] = real_key, real_abort
        sys.stdin = real_stdin
    wrong = sorted(k for k, good in keys.items() if not good)
    check("attach-prompt-keys", "the attach prompt does what each key says", not wrong, ", ".join(wrong))

    # --- the observation a launch leaves open is finished, per agent
    watch = Path(tempfile.mkdtemp())
    try:
        wrote_path, silent_path = watch / "w.jsonl", watch / "s.jsonl"
        for path in (wrote_path, silent_path):
            path.write_text("x")
            os.utime(path, (1000, 1000))
        os.utime(wrote_path, None)
        with contextlib.redirect_stdout(io.StringIO()) as out, \
                contextlib.redirect_stderr(io.StringIO()) as err:
            report_transcript_writes([("wrote-one", wrote_path, 1000),
                                      ("silent-one", silent_path, 1000)], _Args(), grace=0.5)
        told = [line for line in out.getvalue().splitlines() if line.startswith("wrote")]
        writes = {
            "the one that wrote is named": len(told) == 1 and "wrote-one" in told[0],
            "the silent one is warned about": "silent-one" in err.getvalue(),
            "and is not claimed as written": "silent-one" not in out.getvalue(),
        }
        with contextlib.redirect_stdout(io.StringIO()) as quiet:
            report_transcript_writes([], _Args(), grace=0.1)
            report_transcript_writes([("x", wrote_path, 1000)], _Args(dry_run=True), grace=0.1)
        writes["nothing to say stays silent"] = quiet.getvalue() == ""
    finally:
        shutil.rmtree(watch, ignore_errors=True)
    wrong = sorted(k for k, good in writes.items() if not good)
    check("launch-followup-per-agent", "a launch is followed up per agent", not wrong, ", ".join(wrong))

    # --- the swarm is offered unless the run already handed the user somewhere
    # The fixture's server counts as existing: whether a dead one gates the
    # offer is its own check, and this one asks only who took the terminal.
    real_one, real_confirm = globals()["run_one"], globals()["confirm_attach"]
    real_alive_gate = RESOLVER.socket_alive
    asked = []
    try:
        RESOLVER.socket_alive = lambda s: s == "sock" or real_alive_gate(s)
        globals()["confirm_attach"] = lambda targets, table, sock: asked.append(sock) and False
        offers = {}
        for label, status in (("a lead already up", "noop"), ("a lead handed over", "manual")):
            # A launched member rides along in both runs, so the attach path is
            # reachable either way and only the lead's outcome decides. Without
            # it the manual case would pass because a lone manual run never
            # reaches the offer at all, which tests nothing.
            def stub(*a, _s=status, _seen=[], **k):
                _seen.append(1)
                return (Outcome(_s, "sock", True, None) if len(_seen) == 1
                        else Outcome("launched", "sock", False, None))
            globals()["run_one"] = stub
            asked.clear()
            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                run_agents(_Args(), [], {}, [("lead", _Args()), ("member", _Args())], None)
            offers[label] = bool(asked) == (status == "noop")
    finally:
        globals()["run_one"], globals()["confirm_attach"] = real_one, real_confirm
        RESOLVER.socket_alive = real_alive_gate
    wrong = sorted(k for k, good in offers.items() if not good)
    check("swarm-offer-fallback", "the swarm is offered when nothing else took over", not wrong, ", ".join(wrong))

    # --- a pairing timing alone suggests is offered, never taken
    real_input, real_stdin = globals().get("input"), sys.stdin
    real_sole = RESOLVER.sole_mint_pairing
    try:
        asks = {}
        RESOLVER.sole_mint_pairing = lambda pid: "session-dest"
        sys.stdin = types.SimpleNamespace(isatty=lambda: True)
        # Corroborated, so the offer defaults to yes: only an explicit no
        # keeps a launch on a team its own evidence contradicts.
        for label, reply, want in (("yes redirects", "y", True),
                                   ("no stays put", "n", False),
                                   ("a bare return takes the offer", "", True)):
            globals()["input"] = lambda prompt="", _r=reply: _r
            with contextlib.redirect_stdout(io.StringIO()):
                asks[label] = confirm_redirect("a@src", 1, "session-dest", "src") is want
        globals()["input"] = lambda prompt="": "y"
        RESOLVER.sole_mint_pairing = lambda pid: "session-other"
        with contextlib.redirect_stdout(io.StringIO()) as quiet:
            asks["an ambiguous pairing is not offered"] = (
                confirm_redirect("a@src", 1, "session-dest", "src") is False
                and quiet.getvalue() == "")
        RESOLVER.sole_mint_pairing = lambda pid: "session-dest"
        sys.stdin = types.SimpleNamespace(isatty=lambda: False)
        with contextlib.redirect_stdout(io.StringIO()) as quiet, \
                contextlib.redirect_stderr(io.StringIO()):
            asks["no terminal does not ask"] = (
                confirm_redirect("a@src", 1, "session-dest", "src") is False
                and quiet.getvalue() == "")
    finally:
        RESOLVER.sole_mint_pairing = real_sole
        sys.stdin = real_stdin
        if real_input is not None:
            globals()["input"] = real_input
        else:
            globals().pop("input", None)
    wrong = sorted(k for k, good in asks.items() if not good)
    check("redirect-offered-not-silent", "a corroborated redirect is offered, not taken silently", not wrong,
          ", ".join(wrong))

    # --- Ctrl-C is answered with a sentence, not a stack dump
    with contextlib.redirect_stdout(io.StringIO()), \
            contextlib.redirect_stderr(io.StringIO()) as said:
        def _interrupted():
            raise KeyboardInterrupt
        code = interruptible(_interrupted)
    check("interrupt-answered-not-dumped", "an interrupt is answered, not dumped",
          code == 130 and "still running" in said.getvalue(),
          f"exit {code}, said {said.getvalue().strip()[:50]!r}")

    # --- a redirect that a restart would undo is not offered
    redirect_src = ast.get_source_segment(source, funcs["auto_redirect"]) or ""
    asked_at = redirect_src.find("confirm_redirect(")
    restore_at = redirect_src.find("restored_identity(")
    futile = []
    if not (0 <= restore_at < asked_at):
        futile.append("the restore question is asked after the operator is")
    # It performs the durable move rather than advertising one: a remedy an
    # operator has to retype is a prescription where an action belongs.
    if "rebind_reap(" not in redirect_src:
        futile.append("the redirect does not make the move durable")
    if "fatal=False" not in redirect_src:
        futile.append("a declined redirect stops the run instead of reporting")
    # One decision: a move known to be impossible must not be preceded by a
    # question about making it.
    blocked_at = redirect_src.find("reap_blockers(")
    if not (0 <= blocked_at < redirect_src.find("confirm_redirect(", blocked_at)):
        futile.append("the redirect asks before it knows the move is blocked")
    if redirect_src.count("input(") or "decline_unreachable(" not in redirect_src:
        futile.append("the redirect asks its own second question")
    blockers_src = ast.get_source_segment(source, funcs["reap_blockers"]) or ""
    for cls in ("--with-mail archives", "--force instead rewrites", "stop it first"):
        if cls not in blockers_src:
            futile.append(f"a blocker class has no remedy: {cls}")
    check("redirect-not-futile", "a redirect a restart would undo is not offered", not futile,
          ", ".join(futile))

    # --- a blocked move does not become a launch nobody can reach
    orphan = []
    real_reap = globals()["rebind_reap"]
    real_lead, real_holders = RESOLVER.lead_pid, RESOLVER.transcript_holders
    real_minted, real_restored = RESOLVER.team_minted_by, RESOLVER.restored_identity
    real_owner2, real_live_procs = RESOLVER.lead_pid_for, RESOLVER.live_agent_procs
    real_field = RESOLVER.field
    try:
        globals()["rebind_reap"] = lambda *a, **k: False   # every blocker refused
        RESOLVER.lead_pid = lambda parent, team: (7, True, "pid 7", True)
        RESOLVER.team_minted_by = lambda pid: ("session-new", True)
        RESOLVER.restored_identity = lambda path: ("session-old", "restored")
        RESOLVER.transcript_holders = lambda uuid, table: ([], [])
        RESOLVER.live_agent_procs = lambda aid, table: []
        RESOLVER.lead_pid_for = lambda uuid: None
        RESOLVER.field = lambda ctx, name, **k: {
            "agentId": "m@session-old", "teamName": "session-old",
            "parentSessionId": "p"}.get(name)

        class _RedirArgs:
            keep_team = False
            force = with_mail = dry_run = False

        ctx = {"session_uuid": "u", "resolution": types.SimpleNamespace(path=Path("/x"))}
        real_stdin2, real_input2 = sys.stdin, globals().get("input")
        sys.stdin = types.SimpleNamespace(isatty=lambda: True)

        def asked(reply, **over):
            globals()["input"] = lambda prompt="", _r=reply: _r
            for k, v in over.items():
                setattr(_RedirArgs, k, v)
            said = io.StringIO()
            with contextlib.redirect_stderr(said), contextlib.redirect_stdout(io.StringIO()):
                try:
                    auto_redirect(dict(ctx), _RedirArgs, [], "")
                    return "launched", said.getvalue()
                except SystemExit:
                    return "stopped", said.getvalue()
                except Exception as err:
                    return f"crashed: {err.__class__.__name__}", said.getvalue()

        try:
            verdict, said = asked("")
            if verdict != "stopped" or "keep-team" not in said:
                orphan.append(f"a bare return did not stop it ({verdict})")
            if asked("n")[0] != "stopped":
                orphan.append("no did not stop it")
            if asked("y")[0] != "launched":
                orphan.append("yes could not ask for the unreachable launch")
            if asked("", keep_team=True)[0] != "launched":
                orphan.append("--keep-team could not ask for it either")
            _RedirArgs.keep_team = False
            sys.stdin = types.SimpleNamespace(isatty=lambda: False)
            if asked("y")[0] != "stopped":
                orphan.append("with no terminal to ask at, it launched anyway")
        finally:
            sys.stdin = real_stdin2
            if real_input2 is not None:
                globals()["input"] = real_input2
            else:
                globals().pop("input", None)
    finally:
        globals()["rebind_reap"] = real_reap
        RESOLVER.lead_pid, RESOLVER.transcript_holders = real_lead, real_holders
        RESOLVER.team_minted_by, RESOLVER.restored_identity = real_minted, real_restored
        RESOLVER.lead_pid_for, RESOLVER.live_agent_procs = real_owner2, real_live_procs
        RESOLVER.field = real_field
    # --- a failure list is a list, and a summary says the suite finished
    sample = [("passing-check", "a passing check", True, ""),
              ("failing-check", "a failing check", False, "why")]
    brief, full = check_report(sample, failed_only=True), check_report(sample)
    reporting = []
    if [line for line in brief if line.startswith("checks: ")] != ["checks: 1 ok, 1 failed"]:
        reporting.append("a run without exactly one summary cannot be told from one that died")
    if any("passing-check" in line for line in brief):
        reporting.append("the failure list carries passes")
    if not any(line.startswith("failing-check") for line in brief):
        reporting.append("the failure list drops the failure")
    if not any("PASS" in line for line in full):
        reporting.append("the full report lost its passes")
    check("report-list-and-summary", "a failure list is a list, and a summary says the suite finished",
          not reporting, ", ".join(reporting))

    # --- this terminal goes to one agent, and a resume by uuid needs no stamps
    terminal = []

    class _Here:
        here = True
        team = resume = agent_id = None
        selftest = complete = cleanup = doctor = census = sides = False
        promote = demote = mail_ledger = install = poison = unpoison = False
        help = standing = stop = False

    real_classify = RESOLVER.classify
    try:
        RESOLVER.classify = lambda token: ("team", token, "a roster on disk")
        told = io.StringIO()
        with contextlib.redirect_stderr(told), contextlib.redirect_stdout(io.StringIO()):
            try:
                apply_selector("session-many", _Here, [])
                terminal.append("a team selector took this terminal")
            except SystemExit:
                if "one agent" not in told.getvalue():
                    terminal.append("the refusal does not say what it wants instead")
        _Here.here = False
        with contextlib.redirect_stdout(io.StringIO()):
            apply_selector("session-many", _Here, [])
        if _Here.team != "session-many":
            terminal.append("a team selector stopped setting the team")
    finally:
        RESOLVER.classify = real_classify

    class _ByName:
        resume = None
        here = team = agent_id = None
        selftest = complete = cleanup = doctor = census = sides = False
        promote = demote = mail_ledger = install = poison = unpoison = False
        help = standing = stop = False

    class _ByUuid:
        resume = "u"
        here = team = agent_id = None
        selftest = complete = cleanup = doctor = census = sides = False
        promote = demote = mail_ledger = install = poison = unpoison = False
        help = standing = stop = False

    # The end-of-run audit refuses a declaration nobody used, so each input
    # shape declares what that shape can reach: a uuid resolves from the
    # filename, a bare name and a team are found through the stamps and
    # nothing else, and an agent id reaches them only when nothing live wears
    # it, which no input can say.
    shapes = {
        "a uuid declares stamps it can never read":
            verb_needs(_ByUuid, None)[NEED.STAMPS] is not DECLARED.ABSENT,
        "a bare name does not declare the stamps that find it":
            verb_needs(_ByName, "unslop-docs")[NEED.STAMPS] is not DECLARED.HARD,
        "a team does not declare the stamps that find its members":
            verb_needs(_ByName, "session-abc12345")[NEED.STAMPS]
            is not DECLARED.HARD,
        "an agent id does not leave its stamps conditional":
            verb_needs(_ByName, "a@session-abc12345")[NEED.STAMPS]
            is not DECLARED.MAYBE,
    }
    terminal.extend(k for k, wrong in shapes.items() if wrong)
    check("terminal-declares-reach", "this terminal goes to one agent, and each input declares what it "
          "can reach", not terminal, ", ".join(terminal))

    check("blocked-move-not-unreachable", "a blocked move does not become an unreachable launch", not orphan,
          ", ".join(orphan))

    # --- shape, not timing, bounds which team a process could have minted
    with tempfile.TemporaryDirectory() as td:
        eng9 = Resolver(needs=Needs(maybe=set(NEED)))
        eng9.projects_dir, eng9.teams_dir = Path(td) / "proj", Path(td) / "teams"
        (eng9.projects_dir / "p").mkdir(parents=True)
        (eng9.projects_dir / "p" / "aaaaaaaa-1111.jsonl").write_text("{}\n")
        for name, lead in (("session-aaaaaaaa", "aaaaaaaa-1111"),
                           ("session-bbbbbbbb", "bbbbbbbb-2222")):
            (eng9.teams_dir / name).mkdir(parents=True)
            eng9.roster_path(name).write_text(json.dumps(
                {"name": name, "leadSessionId": lead, "members": []}))
        shapes = {
            "a team whose lead session names a transcript is a fresh boot's":
                eng9.minted_by_a_resumed_life("session-aaaaaaaa") is False,
            "a team whose lead session names nothing is a resumed life's":
                eng9.minted_by_a_resumed_life("session-bbbbbbbb") is True,
        }
        me = os.getpid()
        eng9.live_sessions = lambda: [{"pid": me, "alive": True, "team": None,
                                       "session": "aaaaaaaa-1111", "started": 0,
                                       "agent": None}]
        pool, why = eng9.mint_candidates(me)
        shapes["a fresh boot needs no window at all"] = (
            pool == ["session-aaaaaaaa"] and why.startswith("its own"))
        shapes["and it answers exact"] = eng9.team_minted_by(me) == (
            "session-aaaaaaaa", True)
        eng9.live_sessions = lambda: [{"pid": me, "alive": True, "team": None,
                                       "session": "cccccccc-3333", "started": 0,
                                       "agent": None}]
        pool, _why = eng9.mint_candidates(me)
        # The fresh-boot team is provably somebody else's, so it cannot be
        # paired with a resumed life however the timing falls.
        shapes["a resumed life's pool holds only resumed-shape teams"] = (
            pool == ["session-bbbbbbbb"])
        eng9._boot_join = lambda: [("session-aaaaaaaa", me, 0)]
        shapes["a stranger's fresh-boot team is not the answer"] = (
            eng9.team_minted_by(me) == (None, False))
        wrong = sorted(k for k, good in shapes.items() if not good)
        check("mint-shape-bounds", "shape bounds which team a process could have minted", not wrong,
              ", ".join(wrong))

    # --- the boot-timing rung says why it picked a pid, not what that pid runs as
    # The rung is the one answer graded inexact, and its evidence is printed one
    # line above the runs-as line, which answers the same question from the
    # stamps and argv. So the evidence may name no team at all: naming one made
    # the doctor contradict itself on adjacent lines of the same block.
    # The fixture is built so only that rung can answer. The team name is
    # session-shaped, so a wording that leaked it would be caught by shape as
    # well as by the literal, and the pid is asserted too, so a rung that never
    # fired fails here rather than passing on an empty string.
    with tempfile.TemporaryDirectory() as td:
        eng10 = Resolver(needs=Needs(maybe=set(NEED)))
        eng10.projects_dir, eng10.teams_dir = Path(td) / "proj", Path(td) / "teams"
        eng10.projects_dir.mkdir(parents=True)
        paired = "session-deadbee1"
        (eng10.teams_dir / paired).mkdir(parents=True)
        eng10.roster_path(paired).write_text(json.dumps(
            # leadSessionId names no transcript, and no registry sessionId opens
            # with deadbee1, so the exact join above has nothing to join on.
            {"name": paired, "leadSessionId": "9d9d9d9d-9d9d-49d9-89d9-9d9d9d9d9d9d",
             "createdAt": 1000,
             "members": [{"name": "team-lead", "agentId": f"team-lead@{paired}"}]}))
        me = os.getpid()
        # Our own pid, because the rung asks the kernel whether the process is
        # alive and a made-up number would drop out of the pairing.
        eng10.session_registry = lambda: [
            {"pid": me, "sessionId": "fedcba98-fedc-4ba9-8fed-cba98fedcba9",
             "startedAt": 1000 + TEAM_MINT_WINDOW_MS - 1, "updatedAt": 0}]
        eng10.ps_table = lambda refresh=False: []      # no masquerade to find in argv
        got_pid, got_alive, got_how, got_exact = eng10.lead_pid(None, paired)
        picked = {
            "the timing pairing is what answered": got_pid == me and got_alive,
            "and it is graded inexact": got_exact is False,
            "the evidence names no team of this shape":
                bool(got_how) and not re.search(r"session-[0-9a-f]{8}", got_how),
            "nor this team by name": bool(got_how) and paired not in got_how,
            "and it still leads with the pid its readers strip":
                bool(got_how) and got_how.startswith(f"pid {me}, "),
        }
        wrong = sorted(k for k, good in picked.items() if not good)
        check("pick-evidence-names-no-team",
              "the boot-timing pick says why it picked, not what the pid runs as",
              not wrong, ", ".join(wrong) or f"said {got_how!r}")

    # --- a team is larger than its roster, and a run that takes the roster says so
    pop_wrong, with_former = [], None
    for team in list(RESOLVER.known_teams())[:40]:
        population = RESOLVER.team_population(team)
        listed = {m.get("name") for m in (RESOLVER.roster_of(team) or {}).get("members", [])
                  if m.get("name")}
        if not listed <= set(population):
            pop_wrong.append(f"{team} loses {sorted(listed - set(population))[:2]}")
        if any(not in_roster for in_roster, _why in population.values()):
            with_former = with_former or team
    if with_former:
        extras = [n for n, (in_roster, _w) in RESOLVER.team_population(with_former).items()
                  if not in_roster]
        listed = {m.get("name") for m in (RESOLVER.roster_of(with_former) or {}).get("members", [])}
        if set(extras) & listed:
            pop_wrong.append(f"{with_former} calls a listed member former")
    check("population-contains-roster", "a team population contains its roster", not pop_wrong, "; ".join(pop_wrong[:2])
          or f"{len(RESOLVER.known_teams())} teams, unrostered members on {with_former}")

    notes = {
        "silent when the run covers everyone": former_members_note([]) is None,
        "names the count and the flag": (lambda n: n and "3 more" in n and "--all" in n)(
            former_members_note(["a", "b", "c"])),
    }
    wrong = sorted(k for k, good in notes.items() if not good)
    check("former-members-noted", "a team run says what it left out", not wrong, ", ".join(wrong))

    # --- a lead and a member report the same launch facts
    # Two hand-maintained report blocks in one function let a field exist in
    # the member block and nowhere else, and a lead then execs without ever
    # printing its command. Whatever else the two paths differ in, they
    # answer these questions alike.
    run_one_src = ast.get_source_segment(source, funcs["run_one"]) or ""
    # The anchor is the member path's own top-level branch (4-space indent);
    # the lead branch also mentions the flag, one level deeper, to refuse it.
    lead_block, _, member_block = run_one_src.partition("\n    if args.to_team:")
    reporters = sorted(callers_of("report_launch"))
    # Both halves report through the one function, so a field cannot exist in
    # one report and not the other: what differs is the seat, not the facts.
    split = [where for where, block in (("the lead path", lead_block),
                                        ("the member path", member_block))
             if "report_launch(" not in block]
    # A flag the lead path cannot honour refuses before the report, instead
    # of riding along silently and reading as having worked.
    if not (0 <= lead_block.find("args.to_team") < lead_block.find("report_launch(")):
        split.append("--to-team on a lead is not refused before the report")
    if set(reporters) - {"run_one", "run_selftest"}:
        split.append("reported from " + ", ".join(
            sorted(set(reporters) - {"run_one", "run_selftest"})))
    printed = io.StringIO()
    fake = {"session_uuid": "s-1", "transcript": [Path("/nonexistent/t.jsonl")],
            "via": "test", "placed": None}
    with contextlib.redirect_stdout(printed):
        report_launch(fake, ["claude", "--resume", "s-1"], role="lead",
                      agent_id="team-lead@t")
    if "command  claude --resume s-1" not in printed.getvalue():
        split.append("a lead report omits its command")
    check("lead-member-report-parity", "a lead and a member report the same launch facts", not split,
          ", ".join(split))

    # --- a crew on two servers is reported as two, not as one
    # A revived lead has a new pid, and a server is named after it, so the
    # next spawn lands somewhere its old crew is not. Naming one seat while
    # the crew sits on two is the half-answer this file keeps deleting.
    eng10 = Resolver(needs=Needs(maybe=set(NEED)))
    eng10.live_sessions = lambda: [
        {"pid": 1, "alive": True, "team": "t", "agent": "old@t", "session": None},
        {"pid": 2, "alive": True, "team": "t", "agent": "new@t", "session": None},
        {"pid": 3, "alive": True, "team": "other", "agent": "x@other", "session": None}]
    eng10.socket_hosting = lambda ids, table: (
        ("sock-old", "live pane of pid 1") if ids == ["old@t"] else
        ("sock-new", "live pane of pid 2") if ids == ["new@t"] else (None, None))
    seats = eng10.crew_sockets("t", [])
    check("crew-split-across-servers", "a crew on two servers is reported as two",
          seats == {"sock-old": ["old@t"], "sock-new": ["new@t"]},
          f"{ {k: v for k, v in seats.items()} }")

    # --- live members define the team; the record only stands in for them
    roster = [{"agentId": "team-lead@t", "name": "team-lead"},
              {"agentId": "a@t", "name": "a"}, {"agentId": "b@t", "name": "b"}]
    pop = {"team-lead": (True, ""), "a": (True, ""), "b": (True, ""),
           "c": (False, ""), "d": (False, "")}
    picks = {}
    got, left = select_jobs(list(roster), pop, {"a"}, "team-lead@t", False, "t")
    names = {m["name"] for m in got}
    picks["a live member and the lead run"] = names == {"a", "team-lead"}
    picks["the rest are reported"] = left == ["b", "c", "d"]
    got, left = select_jobs(list(roster), pop, {"a", "d"}, "team-lead@t", False, "t")
    picks["a live member the record lacks still runs"] = (
        {m["name"] for m in got} == {"a", "d", "team-lead"} and "d" not in left)
    # It is running, so it is unrecorded rather than former. Calling it former
    # would describe the record's gap as the agent's state.
    picks["and is not called a former member"] = any(
        m["name"] == "d" and m.get("unrecorded") and not m.get("former") for m in got)
    got, left = select_jobs(list(roster), pop, set(), "team-lead@t", False, "t")
    picks["with none live the record is the team"] = (
        {m["name"] for m in got} == {"team-lead", "a", "b"} and left == ["c", "d"])
    got, left = select_jobs(list(roster), pop, {"a"}, "team-lead@t", True, "t")
    picks["--all takes everything once"] = (
        sorted(m["name"] for m in got) == ["a", "b", "c", "d", "team-lead"] and not left)
    wrong = sorted(k for k, good in picks.items() if not good)
    check("select-jobs-live-or-record", "a run takes the live team, or the record when none is live",
          not wrong, ", ".join(wrong))

    # --- a payload is a record the harness wrote, not JSON someone printed
    payload = {"status": SPAWN_MARKER, "name": "ghost", "team_name": "t",
               "agent_id": "ghost@t"}
    quoted = json.dumps(payload)
    quotations = {
        "a command's stdout": {"toolUseResult": {"stdout": quoted}},
        "a file that was read": {"toolUseResult": {"file": {"content": quoted}}},
        "an assistant's prose": {"message": {"content": [{"type": "text", "text": quoted}]}},
        "a pasted message": {"message": {"role": "user", "content": quoted}},
    }
    admitted = sorted(k for k, rec in quotations.items()
                      if list(RESOLVER._walk_spawn_payloads(rec)))
    genuine = list(RESOLVER._walk_spawn_payloads({"toolUseResult": payload}))
    # Once per occurrence, whatever it is wrapped in. Depth must not multiply a
    # payload, and a line that genuinely carries two spawns must still yield two.
    buried = list(RESOLVER._walk_spawn_payloads({"toolUseResult": {"a": {"b": payload}}}))
    twin = list(RESOLVER._walk_spawn_payloads({"toolUseResult": [payload, dict(payload)]}))
    check("quoted-payload-not-evidence", "a quoted payload is not evidence",
          not admitted and len(genuine) == 1 and len(buried) == 1 and len(twin) == 2,
          ", ".join(admitted) or f"genuine={len(genuine)} buried={len(buried)} twin={len(twin)}")

    # --- a sidechain line is not evidence, whatever container it sits in.
    # Present tense, not only future demotes: the 2.1.220 sidechain writer
    # stamps teamName/agentName on sidechain lines when team context exists.
    side = {"isSidechain": True, "agentName": "ghost", "teamName": "t",
            "timestamp": "2026-01-01T00:00:00.000Z", "toolUseResult": dict(payload)}
    leaks = []
    with tempfile.TemporaryDirectory() as td:
        planted = Path(td) / "side.jsonl"
        planted.write_text(json.dumps(side, separators=(",", ":")) + "\n" +
                           json.dumps(side) + "\n")
        fields, _ = RESOLVER._scan_transcript(planted)
        if "agentName" in fields or "teamName" in fields:
            leaks.append("the stamp scanner")
        if _stamps_in(planted.read_bytes()):
            leaks.append("the index window")
        RESOLVER._ingest_spawn_lines([planted])
        if RESOLVER._spawns.get(planted.stem):
            leaks.append("the payload walker")
        deep = Path(td) / "proj" / "subagents"
        deep.mkdir(parents=True)
        (deep / "agent-x.jsonl").write_text(json.dumps(side) + "\n")
        hits = RESOLVER._grep_files(SPAWN_MARKER, [Path(td)], True) or []
        if any("subagents" in p.parts for p in hits):
            leaks.append("the recursive searcher")
    check("sidechain-not-evidence", "a sidechain line is not evidence", not leaks, ", ".join(leaks))

    # --- side transcripts: the file classifies itself; the meta only decorates
    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "proj" / "PARENT-UUID" / "subagents"
        sub.mkdir(parents=True)
        ref = {"type": "fork-context-ref", "agentId": "p1", "parentSessionId":
               "PARENT-UUID", "parentLastUuid": "leaf-1", "contextLength": 5}
        proot = {"type": "user", "parentUuid": None, "isSidechain": True, "uuid": "proot-1"}
        (sub / "agent-p1.jsonl").write_text(json.dumps(ref) + "\n" + json.dumps(proot) + "\n")
        root = {"type": "user", "parentUuid": None, "isSidechain": True, "uuid": "root-1"}
        (sub / "agent-r1.jsonl").write_text(json.dumps(root) + "\n")
        (sub / "agent-r1.meta.json").write_text(
            json.dumps({"isFork": True, "agentType": "fork", "name": "liar"}))
        mid = {"type": "assistant", "parentUuid": "elsewhere", "isSidechain": True, "uuid": "m"}
        (sub / "agent-m1.jsonl").write_text(json.dumps(mid) + "\n")
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir = Path(td)
        got = {e["task_id"]: e for e in eng.side_transcripts()}
        wrong = []
        if got.get("p1", {}).get("grammar") != "pointer":
            wrong.append("the ref file is not pointer")
        if got.get("r1", {}).get("grammar") != "rooted":
            wrong.append("a lying meta out-voted the bytes")
        if got.get("r1", {}).get("name") != "liar":
            wrong.append("the meta name was not carried as display")
        if got.get("m1", {}).get("grammar") != "unclassifiable":
            wrong.append("a mid-chain start was classified")
        for sel, want in (("p1", "p1"), ("PARENT-UUID/liar", "r1"), ("root-1", "r1"),
                          ("proot-1", "p1")):
            hit, _why = eng.side_transcript(sel)
            if not hit or hit["task_id"] != want:
                wrong.append(f"selector {sel!r} missed")
        hit, why = eng.side_transcript("nobody")
        if hit or "no side transcript" not in why:
            wrong.append("an absent selector did not refuse")
        for twin in ("d1", "d2"):
            (sub / f"agent-{twin}.jsonl").write_text(json.dumps(
                {"type": "user", "parentUuid": None, "isSidechain": True,
                 "uuid": f"{twin}-root"}) + "\n")
            (sub / f"agent-{twin}.meta.json").write_text(json.dumps({"name": "twin"}))
        hit, why = eng.side_transcript("twin")
        if hit or not ("d1" in why and "d2" in why):
            wrong.append("a colliding refusal did not name typeable spellings")
        check("side-classified-by-bytes", "a side transcript is classified by its own bytes",
              not wrong, ", ".join(wrong))

    # Every side transcript on this machine classifies without a crash, and the
    # ones that are neither grammar are counted, not guessed at.
    corpus = RESOLVER.side_transcripts()
    tallies = collections.Counter(e["grammar"] for e in corpus)
    stray = tallies.get("unclassifiable", 0)
    ok = sum(tallies.values()) == len(corpus) and \
        set(tallies) <= {"pointer", "rooted", "unclassifiable"}
    check("side-census-covers-every-file", "the side-transcript census answers for every file", ok,
          ", ".join(f"{n} {g}" for g, n in tallies.most_common()) or "none on this machine")

    # --- a conversion proves its inverse before anything may act on it
    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "proj" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        compact = lambda d: json.dumps(d, separators=(",", ":"))
        rows = [
            {"parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
             "agentId": "t1", "type": "user", "uuid": "cv-root",
             "message": {"role": "user", "content": "do the thing"}},
            {"parentUuid": "cv-root", "isSidechain": True, "sessionId": "PARENT",
             "agentId": "t1", "type": "assistant", "uuid": "cv-2",
             "message": {"role": "assistant", "content": [{"type": "text", "text": "ok"}]}},
        ]
        rooted = sub / "agent-t1.jsonl"
        rooted_bytes = "".join(compact(r) + "\n" for r in rows)
        rooted.write_text(rooted_bytes)
        (sub / "agent-t1.meta.json").write_text('{"agentType":"x","name":"t"}')
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng.projects_dir = Path(td)
        faults = []
        plan = eng.conversion_plan(rooted, "promote")
        if plan["objections"] or not plan["proved"]:
            faults.append(f"rooted: {plan['objections'] or 'unproved'}")
        else:
            body = "\n".join(plan["lines"])
            if '"isSidechain":true' in body or '"sessionId":"PARENT"' in body.rsplit("\n", 1)[0]:
                faults.append("rooted promote left side fields")
            if not plan["lines"][-1].startswith('{"receipt":'):
                faults.append("rooted promote carries no receipt as its last line")
            if not plan["lines"][-2].startswith('{"type":"last-prompt"'):
                faults.append("rooted promote appended no trailer")
            if plan["dest_path"].stem != "cv-root":
                faults.append("the stem is not the chain root")
        # a born teammate: no isSidechain anywhere, harness trailers in place
        mate = Path(td) / "proj" / "MATE.jsonl"
        mate.write_text(
            compact({"parentUuid": None, "sessionId": "MATE", "agentId": "m1",
                     "type": "user", "uuid": "mate-root"}) + "\n" +
            compact({"type": "last-prompt", "lastPrompt": "hi",
                     "leafUuid": "mate-root", "sessionId": "MATE"}) + "\n" +
            compact({"parentUuid": "mate-root", "sessionId": "MATE", "agentId": "m1",
                     "type": "assistant", "uuid": "mate-2"}) + "\n" +
            compact({"type": "last-prompt", "lastPrompt": "hi again",
                     "leafUuid": "mate-2", "sessionId": "MATE"}) + "\n")
        dplan = eng.conversion_plan(mate, "demote", into="PARENT", dest="m1")
        if dplan["objections"] or not dplan["proved"]:
            faults.append(f"demote: {dplan['objections'] or 'unproved'}")
        else:
            if any('"type":"last-prompt"' in line for line in dplan["lines"]):
                faults.append("demote left a trailer in the side file")
            if sum('"isSidechain":true' in line for line in dplan["lines"]) != 2:
                faults.append("demote did not sidechain every record")
        # The promoted file carries its own undo. Demoted with nothing stored
        # anywhere, it still knows where it came from, which is the whole point
        # of the record riding the bytes it describes.
        carried = Path(td) / "proj" / "cv-root.jsonl"
        carried.write_text("\n".join(plan["lines"]) + "\n")
        alone = eng.conversion_plan(carried, "demote")
        if alone["objections"] or not alone["proved"]:
            faults.append(f"a carried receipt did not answer its own demote: "
                          f"{alone['objections'] or 'unproved'}")
        elif alone["dest_path"].name != "agent-t1.jsonl":
            faults.append(f"the carried receipt lost the task id: {alone['dest_path'].name}")
        elif "\n".join(alone["lines"]) + "\n" != rooted_bytes:
            faults.append("a carried demote did not restore the original bytes")

        # --into names a parent other than the one it came from, which is the
        # only reason the flag exists. The carried record is consumed either
        # way and goes back verbatim, because rebuilding it from fields this
        # demote deliberately changed would refuse the operation it is for.
        elsewhere = eng.conversion_plan(carried, "demote", into="ELSEWHERE")
        if elsewhere["objections"] or not elsewhere["proved"]:
            faults.append(f"a demote into another parent refused: "
                          f"{elsewhere['objections'] or 'unproved'}")
        elif elsewhere["dest_path"].parent.parent.name != "ELSEWHERE":
            faults.append("a demote into another parent landed elsewhere")
        elif not any(RECEIPT_RECORD in line for line in elsewhere["lines"]):
            faults.append("a demote into another parent ate the receipt")

        # A fork's inherited prefix is resolved against the session its ref
        # names, not the directory it sits in, so a move is safe exactly when
        # the destination carries the referenced entry. Both answers, against
        # one specimen, or the refusal could pass by refusing everything.
        pref = sub / "agent-p2.jsonl"
        pref.write_text(compact({"type": "fork-context-ref", "agentId": "p2",
                                 "parentSessionId": "PARENT",
                                 "parentLastUuid": "anchor-1",
                                 "contextLength": 3}) + "\n" +
                        compact({"parentUuid": None, "isSidechain": True,
                                 "sessionId": "PARENT", "type": "user",
                                 "uuid": "p2-root",
                                 "message": {"role": "user", "content": "go"}}) + "\n")
        (sub / "agent-p2.meta.json").write_text('{"agentType":"fork","isFork":true}')
        (Path(td) / "proj" / "PARENT.jsonl").write_text(
            compact({"uuid": "anchor-1", "type": "assistant"}) + "\n")
        (Path(td) / "proj" / "HASIT.jsonl").write_text(
            compact({"uuid": "anchor-1", "type": "assistant"}) + "\n")
        (Path(td) / "proj" / "LACKS.jsonl").write_text(
            compact({"uuid": "not-it", "type": "assistant"}) + "\n")
        pplan = eng.conversion_plan(pref, "promote", identity=("p2", "T"))
        pdest = Path(td) / "proj" / "p2-root.jsonl"
        pdest.write_text("\n".join(pplan["lines"]) + "\n")
        # The case the feature exists for: a genuinely new parent, which does
        # not hold the referenced entry and does not need to. The ref still
        # names PARENT and PARENT still holds it, so the prefix resolves and
        # the move proves.
        if not eng.conversion_plan(pdest, "demote", into="LACKS")["proved"]:
            faults.append("a move to a genuinely new parent was refused")
        # And the case that is really broken: the session the ref names has
        # lost the entry, so the prefix resolves nowhere wherever it is moved.
        orphan = sub / "agent-p3.jsonl"
        orphan.write_text(compact({"type": "fork-context-ref", "agentId": "p3",
                                   "parentSessionId": "LACKS",
                                   "parentLastUuid": "anchor-1",
                                   "contextLength": 3}) + "\n" +
                          compact({"parentUuid": None, "isSidechain": True,
                                   "sessionId": "PARENT", "type": "user",
                                   "uuid": "p3-root",
                                   "message": {"role": "user", "content": "go"}}) + "\n")
        (sub / "agent-p3.meta.json").write_text('{"agentType":"fork","isFork":true}')
        oplan = eng.conversion_plan(orphan, "promote", identity=("p3", "T"))
        odest = Path(td) / "proj" / "p3-root.jsonl"
        odest.write_text("\n".join(oplan["lines"]) + "\n")
        lost = eng.conversion_plan(odest, "demote", into="HASIT")
        if lost["proved"] or "no longer carries" not in "".join(lost["objections"]):
            faults.append("a fork whose referenced prefix is gone was moved anyway")

        # Last means last. With a turn written past it the record is history,
        # so the demote leaves it where it sits instead of eating it.
        grown = Path(td) / "proj" / "cv-grown.jsonl"
        grown.write_text("\n".join(plan["lines"]) + "\n" + compact(
            {"parentUuid": "cv-2", "sessionId": "cv-root", "type": "assistant",
             "uuid": "cv-3"}) + "\n")
        after = eng.conversion_plan(grown, "demote", into="PARENT", dest="t1")
        if after["objections"] or not after["proved"]:
            faults.append(f"a grown file did not demote: "
                          f"{after['objections'] or 'unproved'}")
        elif sum(RECEIPT_RECORD in line for line in after["lines"]) != 1:
            faults.append("a receipt with a turn after it was not kept as growth")

        # a line the codec cannot reproduce is a refusal, not a best effort
        wonky = sub / "agent-w1.jsonl"
        wonky.write_text('{"parentUuid": null, "isSidechain": true, '
                         '"uuid": "w-root", "n": 1.10}\n')
        wplan = eng.conversion_plan(wonky, "promote")
        if wplan["proved"] or not any("reproduces" in o for o in wplan["objections"]):
            faults.append("an unstable line did not refuse")

        # A file the classifier refuses is refused, naming what was found
        # rather than guessing at a shape. There is no salvage path: the
        # transcripts that needed one are not produced any more.
        messy = sub / "agent-c1.jsonl"
        messy.write_text("".join(compact(r) + "\n" for r in [
            {"parentUuid": "ghost-above", "isSidechain": True, "sessionId": "PARENT",
             "type": "user", "uuid": "mid-chain",
             "message": {"role": "user", "content": "no root in this file"}},
            {"parentUuid": "elsewhere", "isSidechain": True, "sessionId": "PARENT",
             "type": "assistant", "uuid": "stray-1"},
        ]))
        try:
            bare = eng.conversion_plan(messy, "promote")
        except Exception as err:  # a crash is a failure, not a refusal
            bare = {"proved": True, "objections": [f"crashed: {err.__class__.__name__}"]}
        if bare["proved"] or not any("not convertible" in o for o in bare["objections"]):
            faults.append("an unclassifiable file did not refuse")
        check("conversion-proves-inverse", "a conversion proves its inverse before it acts", not faults,
              ", ".join(faults))

    # --- the writers move, and the receipt is the way back
    with tempfile.TemporaryDirectory() as td:
        sub = Path(td) / "proj" / "PARENT" / "subagents"
        sub.mkdir(parents=True)
        compact = lambda d: json.dumps(d, separators=(",", ":"))
        body = "\n".join(compact(r) for r in [
            {"type": "fork-context-ref", "agentId": "x1", "parentSessionId": "PARENT",
             "parentLastUuid": "pl-leaf", "contextLength": 9},
            {"parentUuid": None, "isSidechain": True, "sessionId": "PARENT",
             "agentId": "x1", "type": "user", "uuid": "xr-root",
             "message": {"role": "user", "content": "fork off"}},
            {"parentUuid": "xr-root", "isSidechain": True, "sessionId": "PARENT",
             "agentId": "x1", "type": "assistant", "uuid": "xr-2"},
        ]) + "\n"
        side = sub / "agent-x1.jsonl"
        side.write_text(body)
        side.chmod(0o600)
        meta_body = '{"agentType":"fork","name":"xp"}'
        (sub / "agent-x1.meta.json").write_text(meta_body)
        eng4 = Resolver(needs=Needs(maybe=set(NEED)))
        eng4.projects_dir = Path(td)
        real_receipts = RECEIPTS_DIR
        globals()["RECEIPTS_DIR"] = Path(td) / "receipts"
        moved = []
        try:
            plan = eng4.conversion_plan(side, "promote", identity=("xp", "TEAMX"))
            materialize(plan)
            dest = plan["dest_path"]
            if not dest.exists():
                moved.append("no promoted transcript")
            elif dest.stat().st_mode & 0o777 != 0o600:
                moved.append("the promoted transcript lost its mode")
            if side.exists() or (sub / "agent-x1.meta.json").exists():
                moved.append("the source did not leave subagents/")
            stored = load_receipt(dest.stem)
            if not stored or stored.get("state") != "materialized":
                moved.append("no receipt, or the wrong state")
            # Until launch, the receipt is the membership: the population
            # carries the member as converted, the roster stays silent, and
            # the ladder resolves the name to the promoted transcript.
            pop = eng4.team_population("TEAMX")
            if pop.get("xp", ("",))[0] != "converted":
                moved.append("an unlaunched promote is missing from the population")
            if eng4.converted_members("TEAMX").get("xp", {}).get("root") != dest.stem:
                moved.append("the carried receipt does not name its own transcript")
            res = eng4.resolve_transcript(name="xp", team="TEAMX", quick=True)
            if not res or res.via != "conversion receipt" or res.path != dest:
                moved.append("the ladder does not reach an unlaunched promote")
            dplan = eng4.conversion_plan(dest, "demote", stored=stored)
            embed(dplan)
            if eng4.converted_members("TEAMX"):
                moved.append("an embedded receipt still counts as membership")
            if side.read_text() != body:
                moved.append("the demoted bytes differ from the original")
            if side.stat().st_mode & 0o777 != 0o600:
                moved.append("a private transcript came back wider than it left")
            if (sub / "agent-x1.meta.json").read_text() != meta_body:
                moved.append("the meta did not come back verbatim")
            if dest.exists():
                moved.append("the promoted transcript lingered")
            after = load_receipt(dest.stem)
            if not after or after.get("state") != "embedded" or not after.get("history"):
                moved.append("the receipt did not carry its history")
        finally:
            globals()["RECEIPTS_DIR"] = real_receipts
        check("writers-move-receipt-back", "the writers move, and the receipt is the way back", not moved,
              ", ".join(moved))

    # --- a demote cannot embed the conversation it runs inside. The holder
    # gate excludes our own lineage by design, so the invoking agent is the
    # one holder it cannot see; self-hold is asked first for exactly that.
    me = os.getpid()
    fake_table = [(me, 0, "claude --resume FAKE-LINEAGE-UUID --agent-id x@t")]
    blind = []
    strangers, ours = RESOLVER.transcript_holders("FAKE-LINEAGE-UUID", fake_table)
    if ours != [me]:
        blind.append("the composed question does not see the invoking lineage")
    if strangers:
        blind.append("the composed question counts our own lineage as a stranger")
    demote_src = ast.get_source_segment(source, funcs["run_demote"]) or ""
    if "RESOLVER.transcript_holders(" not in demote_src:
        blind.append("the demote gate does not ask the composed question")
    check("demote-cannot-embed-self", "a demote cannot embed the conversation it runs inside", not blind,
          ", ".join(blind))

    # Who holds a transcript is ONE question. Two consumers in one day
    # consulted half of it, the second within hours of the first fix, so the
    # halves stopped being separately consultable at all.
    half_askers = sorted(
        (callers_of("procs_on_transcript") | callers_of("self_holds_transcript"))
        - {"transcript_holders"})
    check("holder-one-question", "who holds a transcript is one question", not half_askers,
          ", ".join(half_askers))

    # --- the mail ledger joins sends against deliveries, four honest states
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td) / "proj"
        proj.mkdir(parents=True)
        compact = lambda d: json.dumps(d, separators=(",", ":"))

        def send_rec(body, ts):
            return compact({"type": "assistant", "agentName": "alice",
                            "teamName": "TML", "timestamp": ts, "uuid": f"s-{body}",
                            "parentUuid": None, "message": {"content": [
                                {"type": "tool_use", "name": "SendMessage",
                                 "input": {"to": "bob", "summary": body,
                                           "message": body}}]}})
        chatter = [compact({"type": "assistant", "agentName": "alice",
                            "teamName": "TML", "timestamp": f"2026-01-01T00:01:{n:02d}Z",
                            "uuid": f"c-{n}", "parentUuid": None,
                            "message": {"content": []}}) for n in range(20)]
        (proj / "ALICE.jsonl").write_text("\n".join([
            send_rec("one", "2026-01-01T00:00:01Z"),
            send_rec("two", "2026-01-01T00:00:02Z"),
            send_rec("three", "2026-01-01T00:00:03Z"),
            send_rec("four", "2026-01-01T00:00:09Z"),
        ] + chatter) + "\n")
        (proj / "BOB.jsonl").write_text("\n".join([
            compact({"type": "user", "agentName": "bob", "teamName": "TML",
                     "timestamp": "2026-01-01T00:00:04Z", "uuid": "b-1",
                     "parentUuid": None, "message": {"content":
                     '<teammate-message teammate_id="alice">\none\n</teammate-message>'}}),
            compact({"type": "assistant", "agentName": "bob", "teamName": "TML",
                     "timestamp": "2026-01-01T00:00:05Z", "uuid": "b-2",
                     "parentUuid": "b-1", "message": {"content": []}}),
        ]) + "\n")
        boxdir = Path(td) / "teams" / "TML" / "inboxes"
        boxdir.mkdir(parents=True)
        (boxdir / "bob.json").write_text(json.dumps([{"text": "two"}]))
        eng5 = Resolver(needs=Needs(maybe=set(NEED)))
        eng5.projects_dir, eng5.teams_dir = Path(td), Path(td) / "teams"
        full_rows = eng5.mail_ledger("TML")
        states = {e["summary"]: e["state"] for e in full_rows}
        want = {"one": "delivered", "two": "queued",
                "three": "unexplained", "four": "pending"}
        off = [f"{k}: {states.get(k)} (wanted {v})" for k, v in want.items()
               if states.get(k) != v]
        check("mail-ledger-joins-deliveries", "the mail ledger joins sends against deliveries", not off,
              ", ".join(off) or ", ".join(f"{k}={v}" for k, v in want.items()))

        # A declared recipient gets the same rows the full join would give it,
        # and buys less: a sender's chatter is not parsed on its behalf.
        real_loads, parses = json.loads, []

        def counting_loads(raw, *a, **kw):
            parses.append(1)
            return real_loads(raw, *a, **kw)

        json.loads = counting_loads
        try:
            narrowed = eng5.mail_ledger("TML", to="bob")
            to_bob = len(parses)
            parses.clear()
            everything_rows = eng5.mail_ledger("TML")
            to_all = len(parses)
        finally:
            json.loads = real_loads
        declared = {
            "same rows, same states": narrowed ==
                [r for r in everything_rows if r["to"] == "bob"],
            "nobody addressed means no rows": eng5.mail_ledger("TML", to="alice") == [],
            "a sender's chatter is not parsed": to_bob < to_all,
        }
        wrong = sorted(k for k, ok in declared.items() if not ok)
        check("ledger-recipient-narrows-only", "a declared recipient narrows the ledger without changing it",
              not wrong, ", ".join(wrong) or f"{to_bob} parses vs {to_all}")
        # A torn inbox answers as itself; six real messages in a half-written
        # file must not read as no mail waiting.
        (boxdir / "carol.json").write_text('[{"text": "hal')
        got = eng5.inbox_state("TML").get("carol")
        check("torn-inbox-reported", "a torn inbox is reported, not skipped",
              bool(got) and got[0] is None and "torn" in got[1],
              str(got))

    # --- the reports carry what the mailbox file cannot show
    sample = [
        {"sender": "a", "to": "lead", "summary": "s1", "sent": 1,
         "state": "delivered", "detail": ""},
        {"sender": "a", "to": "lead", "summary": "s2", "sent": 2,
         "state": "in memory", "detail": ""},
        {"sender": "b", "to": "lead", "summary": "s3", "sent": 3,
         "state": "in memory", "detail": ""},
        {"sender": "a", "to": "lead", "summary": "s4", "sent": 4,
         "state": "unexplained", "detail": ""},
    ]
    told = undelivered_mail_lines(sample)
    quiet = []
    if not any("2 in lead's memory" in line for line in told):
        quiet.append("in-memory rows are not grouped and counted")
    if not any("unexplained: a -> lead" in line for line in told):
        quiet.append("an unexplained row is not named")
    if any("delivered" in line for line in told):
        quiet.append("a delivered row leaked into the undelivered lines")
    doctor_src = ast.get_source_segment(source, funcs["diagnose_team"]) or ""
    if "mail_ledger(" not in doctor_src:
        quiet.append("the doctor does not consult the ledger")
    runner_src = ast.get_source_segment(source, funcs["run_doctor"]) or ""
    if "deep=bool(target)" not in runner_src:
        quiet.append("the sweep and the named team share a depth")
    standing_src = ast.get_source_segment(source, funcs["run_standing"]) or ""
    if "mail_ledger(" not in standing_src:
        quiet.append("standing does not consult the ledger")
    if "rebind_fragility(" not in standing_src:
        quiet.append("standing does not warn a rebound agent")
    if "rebind_fragility(" not in doctor_src:
        quiet.append("the doctor does not warn a rebound team member")
    check("reports-carry-mailbox-gaps", "the reports carry what the mailbox file cannot show", not quiet,
          ", ".join(quiet))

    # --- --force restamps the window-start instead of reaping a living team
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td) / "proj"
        proj.mkdir()
        compact = lambda d: json.dumps(d, separators=(",", ":"))
        rows = [
            {"parentUuid": None, "agentName": "mate", "teamName": "OLD",
             "type": "user", "uuid": "rs-root",
             "timestamp": "2026-01-01T00:00:01Z",
             "message": {"role": "user", "content": "hi"}},
            {"parentUuid": "rs-root", "agentName": "mate", "teamName": "OLD",
             "type": "assistant", "uuid": "rs-tail",
             "timestamp": "2026-01-01T00:00:02Z"},
        ]
        rows.append({"type": "last-prompt", "leafUuid": "rs-tail",
                     "sessionId": "RS"})
        target = proj / "RS.jsonl"
        target.write_text("".join(compact(r) + "\n" for r in rows))
        target.chmod(0o600)
        eng7 = Resolver(needs=Needs(maybe=set(NEED)))
        eng7.projects_dir = Path(td)
        real_receipts = RECEIPTS_DIR
        globals()["RECEIPTS_DIR"] = Path(td) / "receipts"
        stray = []
        try:
            # locate + two-field closure, name-optional
            plan = eng7.restamp_plan(target, "NEW")
            if plan["objections"] or not plan["proved"]:
                stray.append(f"no-rename plan: {plan['objections'] or 'unproved'}")
            else:
                loaded = json.loads(plan["lines"][0])
                if loaded.get("teamName") != "NEW":
                    stray.append("a no-rename restamp did not set teamName")
                if loaded.get("agentName") != "mate":
                    stray.append("a no-rename restamp touched agentName")
                if plan["lines"][1] != compact(rows[1]):
                    stray.append("the tail line changed under a window-start edit")
            # renaming touches both fields
            rplan = eng7.restamp_plan(target, "NEW", name="newmate")
            if not rplan.get("proved"):
                stray.append(f"rename plan: {rplan['objections']}")
            else:
                r0 = json.loads(rplan["lines"][0])
                if r0.get("teamName") != "NEW" or r0.get("agentName") != "newmate":
                    stray.append("a rename restamp did not touch both fields")
            # already-agreeing is a no-op refusal
            noop = eng7.restamp_plan(target, "OLD")
            if noop["proved"] or not noop["objections"]:
                stray.append("an already-agreeing restamp did not refuse")
            # receipt is mandatory: apply, then verify, then verify the cycle
            apply_restamp(plan)
            stored = json.loads(
                (Path(td) / "receipts" / f"{target.stem}.restamp.json").read_text())
            if stored.get("old", {}).get("teamName") != "OLD":
                stray.append("the receipt did not confess the old value")
            if target.stat().st_mode & 0o777 != 0o600:
                stray.append("the restamp did not preserve file mode")
            back = eng7.restamp_plan(target, "OLD")
            if not back["proved"]:
                stray.append("the restamped file does not restamp back")
            else:
                apply_restamp(back)
                # The trace records the net change from where the conversation
                # started, so coming back to the origin leaves nothing to
                # record and the bytes are the ones it had before any of it.
                was = "".join(compact(r) + "\n" for r in rows)
                if target.read_text() != was:
                    stray.append("the round trip did not restore the original bytes")
                # And three moves leave one record of the net change, not two
                # records of two hops, and not a hop that forgot the origin.
                apply_restamp(eng7.restamp_plan(target, "MID"))
                apply_restamp(eng7.restamp_plan(target, "FAR"))
                lines = target.read_text().splitlines()
                traces = [json.loads(l)["restamp"] for l in lines
                          if RESTAMP_RECORD in l]
                if len(traces) != 1:
                    stray.append(f"three moves left {len(traces)} traces")
                elif (traces[0]["old"]["teamName"], traces[0]["new"]["teamName"]) != ("OLD", "FAR"):
                    stray.append(f"the trace forgot the origin: {traces[0]['old']} "
                                 f"-> {traces[0]['new']}")
        finally:
            globals()["RECEIPTS_DIR"] = real_receipts
        # The live-holder guard: the composed question sees a lineage pid,
        # and the writer is unreachable without it being asked first.
        me = os.getpid()
        alive_table = [(me, 0, f"claude --resume {target.stem} --agent-id mate@OLD")]
        if not RESOLVER.transcript_holders(target.stem, alive_table)[1]:
            stray.append("the holder question misses a live restamp target")
        reap_src = ast.get_source_segment(source, funcs["rebind_reap"]) or ""
        holder_at = reap_src.find("transcript_holders(")
        if not (0 <= holder_at < reap_src.find("restamp_plan(", holder_at)):
            stray.append("the restamp does not check holders first")
        if "args.force" not in reap_src.split("restamp_plan(")[0]:
            stray.append("the restamp is reachable without --force")
        # A redirect makes its own move durable: nothing objecting means the
        # team is retired without asking, and anything objecting is reported
        # with its remedy while the agent stays where its conversation says.
        quiet_dir = Path(td) / "quiet"
        (quiet_dir / "OLD").mkdir(parents=True)
        eng7.roster_path = lambda t: quiet_dir / t / "config.json"
        (quiet_dir / "OLD" / "config.json").write_text('{"name": "OLD", "members": []}')
        real_teams2, real_objs = RESOLVER.teams_dir, RESOLVER.reap_objections
        RESOLVER.teams_dir = quiet_dir
        try:
            class _Quiet:
                force, dry_run, with_mail = False, True, False
            RESOLVER.reap_objections = lambda *a, **k: []
            with contextlib.redirect_stdout(io.StringIO()) as out:
                took = rebind_reap("OLD", "NEW", _Quiet, path=target, fatal=False)
            if not (took and "reap" in out.getvalue()):
                stray.append("an unobjected team was not reaped for the redirect")
            RESOLVER.reap_objections = lambda *a, **k: [
                "3 unread for m, oldest x", "pid 9 wears it"]
            told = io.StringIO()
            with contextlib.redirect_stderr(told), contextlib.redirect_stdout(io.StringIO()):
                took = rebind_reap("OLD", "NEW", _Quiet, path=target, fatal=False)
            if took is not False:
                stray.append("a blocked redirect claimed the move")
            for owed in ("--with-mail", "--force instead rewrites"):
                if owed not in " ".join(told.getvalue().split()):
                    stray.append(f"a blocker went unremedied: {owed}")
        finally:
            RESOLVER.teams_dir, RESOLVER.reap_objections = real_teams2, real_objs
        check("restamp-window-start", "--force restamps a living team's window-start, receipted, "
              "reversible, mode-preserved", not stray, ", ".join(stray))

    # --- a rebind retires the stamped team only when nothing would notice
    with tempfile.TemporaryDirectory() as td:
        eng6 = Resolver(needs=Needs(maybe=set(NEED)))
        eng6.projects_dir, eng6.teams_dir = Path(td), Path(td) / "teams"
        adir = eng6.teams_dir / "TEAMA"
        (adir / "inboxes").mkdir(parents=True)
        eng6.roster_path("TEAMA").write_text('{"name": "TEAMA", "members": []}')
        (adir / "inboxes" / "mate.json").write_text(
            json.dumps([{"text": "hi", "timestamp": "2026-01-01T00:00:00Z"}]))
        compact = lambda d: json.dumps(d, separators=(",", ":"))
        proj = Path(td) / "proj"
        proj.mkdir()
        (proj / "MATE-A.jsonl").write_text(compact(
            {"parentUuid": None, "agentName": "mate", "teamName": "TEAMA",
             "type": "user", "uuid": "ra-root",
             "timestamp": "2026-01-01T00:00:01Z"}) + "\n")
        me = os.getpid()
        alive_table = [(me, 0, "claude --resume MATE-A --agent-id mate@TEAMA")]
        gates = []
        said = eng6.reap_objections("TEAMA", alive_table)
        if not any("holds mate's transcript" in o for o in said):
            gates.append("a live holder of a stamped transcript did not object")
        said = eng6.reap_objections("TEAMA", [])
        if not any("unread for mate" in o for o in said):
            gates.append("unread mail did not object")
        if eng6.reap_objections("TEAMA", [], archive_mail=True):
            gates.append("archiving did not clear the mail objection")
        real_receipts = RECEIPTS_DIR
        globals()["RECEIPTS_DIR"] = Path(td) / "receipts"
        real_teams = RESOLVER.teams_dir
        RESOLVER.teams_dir = eng6.teams_dir
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                reap_team("TEAMA", archive_mail=True)
            stored = load_receipt("TEAMA")
            if not stored or stored.get("config") != '{"name": "TEAMA", "members": []}':
                gates.append("the roster did not ride the receipt verbatim")
            if (stored or {}).get("mail", {}).get("mate.json") is None:
                gates.append("the mail bytes did not ride the receipt")
            if eng6.roster_path("TEAMA").exists():
                gates.append("the roster survived the reap")
        finally:
            globals()["RECEIPTS_DIR"] = real_receipts
            RESOLVER.teams_dir = real_teams
        # run_one holds two act boundaries (lead first); the reap must precede
        # the MEMBER one, so the comparison starts searching from the reap.
        run_src = ast.get_source_segment(source, funcs["run_one"]) or ""
        reap_at = run_src.find("rebind_reap(")
        if not (0 <= reap_at < run_src.find("enforce_ctx(", reap_at)):
            gates.append("the reap does not precede the act boundary")
        check("rebind-retires-if-unnoticed", "a rebind retires the stamped team only when nothing would notice",
              not gates, ", ".join(gates))

    # --- the unread-mail refusal refuses instead of crashing (its first
    # spelling raised NameError at exactly the moment it was needed)
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td) / "proj"
        proj.mkdir(parents=True)
        compact = lambda d: json.dumps(d, separators=(",", ":"))
        (proj / "MATEDEMO.jsonl").write_text(
            compact({"parentUuid": None, "sessionId": "MATEDEMO", "agentName": "maily",
                     "teamName": "TEAMM", "type": "user", "uuid": "md-root"}) + "\n")
        boxdir = Path(td) / "teams" / "TEAMM" / "inboxes"
        boxdir.mkdir(parents=True)
        (boxdir / "maily.json").write_text(json.dumps(
            [{"from": "team-lead", "timestamp": "2026-01-01T00:00:00Z", "text": "hi"}]))

        class _DemoteArgs:
            demote, force, with_mail, into, dry_run = "MATEDEMO", False, False, "PARENT", False

        real_projects, real_teams = RESOLVER.projects_dir, RESOLVER.teams_dir
        RESOLVER.projects_dir, RESOLVER.teams_dir = Path(td), Path(td) / "teams"
        told, outcome = io.StringIO(), None
        try:
            with contextlib.redirect_stderr(told):
                try:
                    run_demote(_DemoteArgs)
                    outcome = "returned without refusing"
                except SystemExit:
                    outcome = None if "wait in TEAMM's inbox for maily" \
                        in told.getvalue() else f"refused oddly: {told.getvalue()[-80:]}"
                except Exception as err:
                    outcome = f"crashed: {err.__class__.__name__}"
        finally:
            RESOLVER.projects_dir, RESOLVER.teams_dir = real_projects, real_teams
        check("unread-mail-refusal-no-crash", "the unread-mail refusal refuses instead of crashing",
              outcome is None, outcome or "")

    # A run that stops without launching says why, registers what is running,
    # and states its objections. The sequence is not optional and a missing
    # piece is invisible, so it has one spelling and one construction site.
    noops = []
    for fn in ast.walk(tree):
        if not isinstance(fn, ast.FunctionDef) or fn.name in (
                "noop_outcome", "run_selftest"):
            continue
        body = ast.get_source_segment(source, fn) or ""
        if 'Outcome("noop"' in body:
            noops.append(fn.name)
    # Registration is the piece whose absence is invisible: a member running
    # in its pane, unlisted, while the run reports success. Probed by removal.
    noop_src = ast.get_source_segment(source, funcs["noop_outcome"]) or ""
    for needed, missing in (("record_membership(", "does not register what is running"),
                            ("note_identity(", "does not state its objections")):
        if needed not in noop_src:
            noops.append(f"the noop path {missing}")
    check("noop-one-function", "a noop is reported through one function", not noops, ", ".join(noops))

    # The acts differ (exec into your terminal, spawn into a pane); the
    # precondition does not. Neither path may ask the liveness question for
    # itself, or the two answers drift as they did when the lead's forgot to
    # name the session it was refusing to take over.
    asks_own = sorted(callers_of("lead_pid_for")
                      - {"already_running", "auto_redirect", "lead_pid", "run_selftest"})
    # And the guarantee itself, not merely its address: the same live
    # conversation stops both acts, --force releases both, and only a
    # member's rebind is exempt (its own kill path owns that).
    real_owner = RESOLVER.lead_pid_for
    live_ctx = {"session_uuid": "live-uuid"}

    class _NoForce:
        force = False

    class _Forced:
        force = True

    try:
        RESOLVER.lead_pid_for = lambda uuid: (4242, "x", True)
        def why_of(ctx_, args_, **kw):
            answer = already_running(ctx_, args_, **kw)
            return answer[0] if answer else ""

        stops = {
            "a live conversation stops an exec":
                bool(already_running(live_ctx, _NoForce, is_lead=True)),
            "a live conversation stops a spawn":
                bool(already_running(live_ctx, _NoForce, is_lead=False)),
            "and both name the session and the pid":
                all("live-uuid" in why_of(live_ctx, _NoForce, is_lead=k)
                    and "4242" in why_of(live_ctx, _NoForce, is_lead=k)
                    for k in (True, False)),
            "--force releases the exec":
                already_running(live_ctx, _Forced, is_lead=True) is None,
            "--force releases the spawn":
                already_running(live_ctx, _Forced, is_lead=False) is None,
            "a member's rebind is exempt":
                already_running({**live_ctx, "to_team": "t"}, _NoForce,
                                is_lead=False) is None,
            "a lead's is not":
                bool(already_running({**live_ctx, "to_team": "t"}, _NoForce,
                                     is_lead=True)),
            # The member-only extension: the seat questions live in the same
            # step, and the pane one is said in the report's grammar.
            "a member already in the pane stops the spawn":
                already_running({"session_uuid": "u"}, _NoForce, is_lead=False,
                                agent_id="a@t", here=[77], pane="%3")
                == ("a@t is already running in pane %3 (pid 77)", True),
            "an explicit rebind may take that pane":
                already_running({"session_uuid": "u", "to_team": "t"}, _NoForce,
                                is_lead=False, agent_id="a@t", here=[77],
                                pane="%3") is None,
            "a redirect chosen by the tool may not":
                already_running({"session_uuid": "u", "to_team": "t",
                                 "auto_redirect": True}, _NoForce, is_lead=False,
                                agent_id="a@t", here=[77], pane="%3") is not None,
            # A lead has no seat, so the pane never enters its answer: with
            # the owner live it stops for that reason and no other.
            "a lead asks no seat question":
                "pane" not in why_of(live_ctx, _NoForce, is_lead=True,
                                     agent_id="a@t", here=[77], pane="%3"),
        }
        real_procs = RESOLVER.live_agent_procs
        RESOLVER.live_agent_procs = lambda aid, tbl=None: [(99, "x")]
        RESOLVER.lead_pid_for = lambda uuid: None
        try:
            # With no owner, the elsewhere question is the one left to answer.
            stops["the same id running elsewhere stops the spawn"] = (
                "outside pane %3" in why_of({"session_uuid": "u"}, _NoForce,
                                            is_lead=False, agent_id="a@t", pane="%3"))
            stops["and a lead never asks it"] = already_running(
                {"session_uuid": "u"}, _NoForce, is_lead=True, agent_id="a@t",
                pane="%3") is None
            # Guarded: a missing answer must fail this line, not crash it.
            stops["its own pane is not elsewhere"] = (already_running(
                {"session_uuid": "u"}, _NoForce, is_lead=False, agent_id="a@t",
                here=[99], pane="%3") or (None, None))[1] is True
        finally:
            RESOLVER.live_agent_procs = real_procs
        RESOLVER.lead_pid_for = lambda uuid: (4242, "x", False)
        stops["a dead owner stops nothing"] = all(
            already_running(live_ctx, _NoForce, is_lead=k) is None for k in (True, False))
        RESOLVER.lead_pid_for = lambda uuid: None
        stops["and neither does no owner at all"] = all(
            already_running(live_ctx, _NoForce, is_lead=k) is None for k in (True, False))
    finally:
        RESOLVER.lead_pid_for = real_owner
    asks_own += sorted(k for k, good in stops.items() if not good)
    check("no-launch-onto-live-conversation", "a lead is not exec'd, nor a member spawned, onto a live conversation",
          not asks_own, ", ".join(asks_own))

    # Only the conversion writers apply a plan, and only the engine converts.
    applied = {}
    for fn in ast.walk(tree):
        if isinstance(fn, ast.FunctionDef):
            for node in ast.walk(fn):
                if isinstance(node, ast.Call):
                    called = getattr(node.func, "id", None) or getattr(node.func, "attr", None)
                    if called in ("_convert", "materialize", "embed"):
                        applied.setdefault(called, set()).add(fn.name)
    stray_writers = sorted(
        (applied.get("_convert", set()) - {"conversion_plan"}) |
        ((applied.get("materialize", set()) | applied.get("embed", set()))
         - {"run_promote", "run_demote", "run_selftest"}))
    check("conversion-writers-only", "only the conversion writers apply a plan", not stray_writers,
          ", ".join(stray_writers))

    # Arbitrary-text whole-file writing stays with the writers of
    # transcript-shaped files; everything JSON-shaped uses the json spelling.
    texters = sorted(callers_of("replace_text")
                     - {"materialize", "embed", "apply_restamp", "run_selftest"})
    check("raw-writes-stay-with-conversion", "raw whole-file writes stay with the conversion writers", not texters,
          ", ".join(texters))

    # One spelling of the launch line: the dry and real paths render the same
    # template, so the word-grep parity check above is belt, not the property.
    promote_src = ast.get_source_segment(source, funcs["run_promote"]) or ""
    templates = promote_src.count('f"launch   ')
    check("launch-line-one-spelling", "the launch line has one spelling",
          templates == 1 and promote_src.count("launch_line") >= 3,
          f"{templates} template(s)")

    # --- restore reads the window start: set-latest leaf, walk to null
    with tempfile.TemporaryDirectory() as td:
        (Path(td) / "proj").mkdir()
        wt = Path(td) / "proj" / "w.jsonl"
        rows = [
            {"parentUuid": None, "agentName": "lead", "teamName": "teamA",
             "type": "user", "uuid": "wa-root", "timestamp": "2026-01-01T00:00:01Z"},
            {"parentUuid": "wa-root", "agentName": "lead", "teamName": "teamB",
             "type": "assistant", "uuid": "wa-leaf", "timestamp": "2026-01-01T00:00:02Z"},
            {"parentUuid": None, "agentName": "lead", "teamName": "teamC",
             "type": "user", "uuid": "wc-root", "timestamp": "2026-01-01T00:00:03Z"},
            {"parentUuid": "wc-root", "agentName": "lead", "teamName": "teamB",
             "type": "assistant", "uuid": "wc-leaf", "timestamp": "2026-01-01T00:00:04Z"},
            # the FINAL trailer names the older chain; the set-latest rule
            # picks wc-leaf, so tail-first answers teamB, final-wins answers
            # teamA, and only the harness's own walk answers teamC
            {"type": "last-prompt", "leafUuid": "wc-leaf", "sessionId": "w"},
            {"type": "last-prompt", "leafUuid": "wa-leaf", "sessionId": "w"},
        ]
        wt.write_text("".join(json.dumps(r) + "\n" for r in rows))
        stray = []
        got = RESOLVER.window_start(wt)
        if not got or got[1] != "teamC":
            stray.append(f"walked to {got and got[1]}, not teamC")
        un = Path(td) / "proj" / "u.jsonl"
        un.write_text(json.dumps({"parentUuid": None, "type": "user", "uuid": "u-root",
                                  "timestamp": "2026-01-01T00:00:01Z"}) + "\n" +
                      json.dumps({"type": "last-prompt", "leafUuid": "u-root"}) + "\n")
        if RESOLVER.window_start(un) is not None:
            stray.append("an unstamped window start restored")
        eng3 = Resolver(needs=Needs(maybe=set(NEED)))
        eng3.teams_dir = Path(td) / "teams"
        (eng3.teams_dir / "teamC").mkdir(parents=True)
        (eng3.teams_dir / "teamC" / "config.json").write_text("{}")
        if eng3.restored_identity(wt) != ("teamC", "restored"):
            stray.append("a loadable stamped team did not read as restored")
        # The five measured arms, driven as one unit: stamped-and-loadable
        # overrides the worn team; stamped-for-absent falls back to the worn
        # team or to nobody; unstamped leaves the flags standing.
        if eng3.operative_team(wt, "teamZ")[:2] != ("teamC", True):
            stray.append("a worn team out-ranked a loadable window start")
        if eng3.operative_team(un, "teamZ")[0] != "teamZ":
            stray.append("an unstamped window start did not leave argv standing")
        # The rebind guard fires against the DESTINATION, not against the
        # merge (which echoes the stamps and made the guard compare the
        # stamps to themselves - a dead branch behind a green suite).
        class _RebindRes:
            def __init__(self, path):
                self.path = path

        class _RebindArgs:
            to_team, force = "teamZ", False

        real_teams = RESOLVER.teams_dir
        RESOLVER.teams_dir = eng3.teams_dir
        try:
            said = io.StringIO()
            fired = False
            with contextlib.redirect_stderr(said):
                try:
                    enforce_restore({"resolution": _RebindRes(wt), "to_team": "teamZ"},
                                    _RebindArgs)
                except SystemExit:
                    fired = True
                except Exception as err:  # a guard that crashes is not a guard
                    stray.append(f"the rebind guard crashed: {err.__class__.__name__}")
            if not (fired and "comes back as teamC" in " ".join(said.getvalue().split())):
                stray.append("a rebind onto a restoring transcript was not refused")
            with contextlib.redirect_stderr(io.StringIO()):
                try:
                    enforce_restore({"resolution": _RebindRes(wt), "to_team": "teamC"},
                                    _RebindArgs)
                except SystemExit:
                    stray.append("a rebind onto the restored team itself was refused")
                except Exception as err:
                    stray.append(f"the matching-team path crashed: {err.__class__.__name__}")
        finally:
            RESOLVER.teams_dir = real_teams
        (eng3.teams_dir / "teamC" / "config.json").unlink()
        if eng3.restored_identity(wt) != ("teamC", "orphaned"):
            stray.append("an absent stamped team did not read as orphaned")
        if eng3.operative_team(wt, "teamZ")[0] != "teamZ":
            stray.append("argv did not survive the reaped-team bail")
        if eng3.operative_team(wt, None)[:2] != (None, False):
            stray.append("a flagless reaped-team resume was given an identity")
        # The fragile sentence: a rebound transcript warns with the remedy,
        # its own team does not, and a still-restoring one is not "fragile"
        # (it is the refusal's territory, not this note's).
        real_projects = RESOLVER.projects_dir
        RESOLVER.teams_dir = eng3.teams_dir
        RESOLVER.projects_dir = Path(td)
        try:
            frag = RESOLVER.rebind_fragility("w", "teamZ")
            if not (frag and "moved from teamC" in frag
                    and "/compact in it to make teamZ permanent" in frag):
                stray.append("a rebound transcript did not warn fragile")
            if RESOLVER.rebind_fragility("w", "teamC") is not None:
                stray.append("a same-team transcript warned fragile")
            (eng3.teams_dir / "teamC" / "config.json").write_text("{}")
            if RESOLVER.rebind_fragility("w", "teamZ") is not None:
                stray.append("a still-restoring transcript warned fragile")
        finally:
            RESOLVER.teams_dir = real_teams
            RESOLVER.projects_dir = real_projects
        check("restore-reads-window-start", "restore reads the window start, not the tail", not stray,
              ", ".join(stray))

    # The live corpus agrees with itself: a process whose transcript restores
    # is reported as running the restored team. Faked live onto the process
    # table, wearing a transcript whose window-start is stamped with a team
    # that has a roster (session-corpus-alpha), so restored_identity reads
    # "restored" rather than "orphaned" and there is something to compare.
    eng = corpus_engine()
    eng.session_registry = lambda: []
    eng.ps_table = lambda refresh=False: [
        (424242, 0, "claude --resume 1e5701ed-1fe5-4701-8ed1-e5701ed1fe57 "
                    "--agent-id team-lead@session-corpus-alpha")]
    torn, sighted, restored_n, incomplete = [], 0, 0, 0
    for e in eng.live_sessions():
        if not (e.get("alive") and e.get("session")):
            incomplete += 1
            continue
        sighted += 1
        lived = eng.transcript_path(e["session"])
        if not lived:
            continue
        team, state = eng.restored_identity(lived)
        if state == "restored":
            restored_n += 1
            got_team, exact = eng.team_minted_by(e["pid"])
            if got_team != team or not exact:
                torn.append(f"pid {e['pid']}: {got_team} != {team}")
    check("restored-life-window-start", "a restored life runs as its window start says",
          restored_n > 0 and not torn,
          ", ".join(torn) or f"{restored_n} restored of {sighted} registry-complete "
          f"live sessions, {incomplete} incomplete skipped")

    # The cautionary specimen: originally the transcript whose session-id rung
    # overclaim mis-aimed a redirect on 2026-08-05 (see window_start's own
    # docstring). Reconstructed here rather than read off that one real
    # machine's file: two segments, an early unstamped one closed by an early
    # last-prompt trailer, and a second parentUuid:null root - the
    # "pseudocompact boundary" - stamped session-corpus-boundary and closed by
    # the later trailer. The walk must pick the newer leaf by timestamp and
    # land on the boundary, never touching the first segment.
    eng = corpus_engine()
    got = eng.window_start(eng.transcript_path("bcbcbcbc-eeee-4eee-8eee-eeeeeeeeeeee"))
    check("cautionary-specimen-restores", "the cautionary specimen restores as its boundary says",
          got is not None and got[1] == "session-corpus-boundary",
          f"{got[0]}/{got[1]}" if got else "chain broken; strict walk declines")

    # And on real bytes: a pointer fork round-trips exactly, ref and graft and
    # trailer included.
    eng = corpus_engine()
    pick = next(e for e in eng.side_transcripts() if e["task_id"] == "fork1")
    rplan = eng.conversion_plan(pick["path"], "promote")
    check("fork-roundtrip-byte-exact", "a real fork round-trips byte-exactly",
          rplan["proved"] and not rplan["objections"],
          f"{pick['parent'][:8]}/{pick['name'] or pick['task_id']}, "
          f"{len(rplan['lines'] or [])} lines"
          if rplan["proved"] else "; ".join(rplan["objections"])[:80])

    # Two counts of "contested" that mean different things, so both are named.
    # session-corpus-contested has two lead transcripts, neither corroborated
    # by anything: a genuine tie, not an opportunistic one.
    eng = corpus_engine()
    claimed = {t: {path for _st, path in hits} for t, hits in eng.led_teams().items()}
    raw = {t for t, paths in claimed.items() if len(paths) > 1}
    with contextlib.redirect_stderr(io.StringIO()):
        unresolved = {t for t in raw if not eng.lead_transcript_for(t)[0]}
    check("unresolved-team-claimed", "an unresolved team is a claimed team",
          unresolved <= raw and "session-corpus-contested" in unresolved,
          f"raw {len(raw)}, unresolved {len(unresolved)}, "
          f"stray {sorted(t[-8:] for t in unresolved - raw)}")
    check("copies-of-history-refuse", "copies of one history still refuse",
          bool(unresolved) and all(not eng.lead_transcript_for(t)[0] for t in unresolved),
          f"{len(unresolved)} tie(s) held")

    # A claimant whose spawned members are running as the team is corroborated by
    # them; copies of one history share their children, so it never breaks a tie.
    # session-corpus-contested-b's one claimant is otherwise uncorroborated; its
    # spawned child "drift" is faked live on the process table, the way
    # live_checks fakes tmux state elsewhere, to exercise the upgrade for real.
    # The child's own --resume value must differ from the lead's uuid, or it
    # reads as the lead itself running live (a stronger, earlier-checked
    # reason) rather than as a spawned member corroborating it.
    eng = corpus_engine()
    eng.session_registry = lambda: []
    eng.ps_table = lambda refresh=False: [
        (424242, 0, "claude --resume d1d1d1d1-d1d1-4d1d-8d1d-d1d1d1d1d1d1 "
                    "--agent-id drift@session-corpus-contested-b")]
    claimed = {t: {path for _st, path in hits} for t, hits in eng.led_teams().items()}
    live_kids = {}
    for team, paths in claimed.items():
        with contextlib.redirect_stderr(io.StringIO()):
            found = eng.lead_transcript_for(team)
        why = (found[1] or "") if found else ""
        if "live members it spawned" not in why:
            continue
        spawned = {pay.get("name")
                   for path in paths
                   for pay in eng.members_spawned_into(path.stem, team)}
        live_kids[team] = any(eng.wearers(f"{n}@{team}") for n in spawned if n)
    wrong = sorted(t for t, ok in live_kids.items() if not ok)
    # And the upgrade must reach the write: an evidence string without the word
    # uncorroborated is what lets the forge record a real leadSessionId.
    launders = sorted(t for t, ok in live_kids.items() if ok and "uncorroborated" in
                      (eng.lead_transcript_for(t)[1] or ""))
    check("claimant-corroborated-by-children", "a claimant is corroborated only by children that are running",
          bool(live_kids) and not wrong and not launders,
          ", ".join(wrong + launders) or f"{len(live_kids)} team(s) upgraded")

    # Placement: an address locates, evidence places. The same agent, addressed
    # four ways, must come back to the team its members are running under.
    # MULTITEAM_LEAD led two teams; faked live as multiteam-b only, so
    # multiteam-a is the "stale" address and multiteam-b the "live" one.
    eng = corpus_engine()
    eng.session_registry = lambda: []
    eng.ps_table = lambda refresh=False: [
        (424242, 0, "claude --resume aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa "
                    "--agent-id team-lead@session-corpus-multiteam-b")]
    stem = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
    led = eng.teams_led_by(stem)
    live_led = [t for t in led if t in eng.live_teams()]
    serving, stale = "session-corpus-multiteam-b", "session-corpus-multiteam-a"
    res = eng.resolve_transcript(session_uuid=stem)
    placed = {}
    with contextlib.redirect_stderr(io.StringIO()):
        placed["as addressed with a stale team"] = eng.place(res, stale)[0] == serving
        placed["addressed with the live team"] = eng.place(res, serving)[0] == serving
        placed["--keep-team pins what was typed"] = (
            eng.place(res, stale, keep_team=True)[0] == stale)
        placed["a spoken destination wins"] = (
            eng.place(res, stale, for_team="session-elsewhere")[0] == "session-elsewhere")
    wrong = sorted(k for k, ok in placed.items() if not ok)
    check("address-locates-evidence-places", "an address locates an agent, evidence places it",
          live_led == [serving] and not wrong, ", ".join(wrong))

    # And it is decided in one function, so the two-sites fault cannot regrow.
    # The led-and-live evidence pair has one holder (live_led); place() is the
    # only decider consuming it, and a demote's beheading refusal only reads it.
    # This allowlist was changed once, under consult (2026-08-06, ruled
    # conform-with-amendment); the next edit to it needs the same second key.
    deciders = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef) or node.name in (
                "live_led", "run_selftest", "diagnose_team", "run_census"):
            continue
        body = ast.get_source_segment(source, node) or ""
        if "live_teams()" in body and "teams_led_by(" in body:
            deciders.append(node.name)
    spread = sorted(callers_of("live_led") - {"place", "run_demote", "run_selftest"})
    check("placement-one-function", "a team is placed in one function", not deciders and not spread,
          ", ".join(sorted(deciders) + spread))

    # The socket follows the crew: every agent wearing the team, not the roster's
    # list and not the resumed agent alone. A member that is not running has no
    # server of its own to be found on, and must still seat with its siblings.
    # socket_hosting ultimately asks a real tmux server, which a file corpus
    # cannot provide, so it is faked directly here - the same technique the
    # suite already uses elsewhere (eng10's "a crew on two servers" check) -
    # rather than a live pane. petrel and sparrow wear session-corpus-crew;
    # swift is listed but never live.
    eng = corpus_engine()
    eng.session_registry = lambda: []
    eng.ps_table = lambda refresh=False: [
        (424242, 0, "claude --agent-id petrel@session-corpus-crew"),
        (424243, 0, "claude --agent-id sparrow@session-corpus-crew")]
    live_wearers = {"petrel@session-corpus-crew", "sparrow@session-corpus-crew"}
    eng.socket_hosting = lambda ids, table: (
        ("sock-crew", "live pane of the crew") if any(i in live_wearers for i in ids)
        else (None, None))
    table = eng.ps_table()
    # The population comes from live argv, not from the thing under test: drawing
    # it from crew_socket let a neutered crew_socket skip the check instead of
    # failing it. Sorted, so the same team is examined on every run.
    crewed = next((t for t in sorted(eng.live_teams())
                   if eng.socket_hosting(
                       sorted(e.get("agent") for e in eng.live_sessions()
                              if e.get("team") == t and e.get("agent")), table)[0]), None)
    seat, _why = eng.crew_socket(crewed, table) if crewed else (None, None)
    wearers = {e.get("agent") for e in eng.live_sessions() if e.get("team") == crewed}
    listed = {m.get("agentId") for m in (eng.roster_of(crewed) or {}).get("members", [])} if crewed else set()
    absent = f"definitely-not-running@{crewed}"
    seats = {
        "a crew anchors the seat": bool(seat),
        "an agent that is not running still seats with them":
            eng.crew_socket(crewed, table)[0] == seat
            and not eng.socket_hosting([absent], table)[0],
        # The answer must come from a wearer, which is what makes it
        # independent of the roster: an unlisted wearer anchors it just the
        # same, and a listed member that is not running anchors nothing.
        "the seat is one a wearer is sitting on":
            eng.socket_hosting(sorted(w for w in wearers if w), table)[0] == seat,
        "a listed member that is not running anchors nothing":
            not eng.socket_hosting(sorted(listed - wearers) or [absent], table)[0],
    }
    wrong = sorted(k for k, ok in seats.items() if not ok)
    check("socket-follows-crew", "the socket follows the crew, not the roster",
          crewed == "session-corpus-crew" and not wrong,
          ", ".join(wrong) or f"{crewed} on {seat}")

    # A named target is examined, not swept past. The doctor runs before the
    # selector is applied, so it resolves its own target; taking it from
    # args.team gave a full machine sweep for a team the user had typed.
    # run_doctor reads the module's own RESOLVER rather than taking an
    # engine, so the corpus is swapped in for the duration and restored
    # after, the same way the rest of the suite swaps a single global.
    real_resolver = globals()["RESOLVER"]
    globals()["RESOLVER"] = corpus_engine()
    try:
        with contextlib.redirect_stdout(io.StringIO()) as out:
            run_doctor(_Args(team=None, agent_id=None, all_members=False),
                      selector="session-corpus-alpha")
    finally:
        globals()["RESOLVER"] = real_resolver
    verdicts = [ln for ln in out.getvalue().splitlines()
                if ln[:1].isalpha() and ln.split()[:1] and ln.split()[0].isupper()]
    check("doctor-target-honoured", "a named team is the only one examined", len(verdicts) == 1,
          f"{len(verdicts)} verdict(s) for session-corpus-alpha")

    # A verdict names what an operator must act on. Pruned members are the trace
    # of finished work and an unrecorded one is fixed by running it, so neither
    # degrades a team; and a lead sits in no pane by design, so it is not a seat.
    # diagnose_team also reads the module's own RESOLVER, so this swaps it for
    # a corpus engine with one live team (a masqueraded lead, faked onto the
    # process table the way live_checks fakes tmux state elsewhere).
    real_resolver = globals()["RESOLVER"]
    globals()["RESOLVER"] = eng = corpus_engine()
    eng.session_registry = lambda: []
    eng.ps_table = lambda refresh=False: [
        (424242, 0, "claude --resume aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa "
                    "--agent-id team-lead@session-corpus-multiteam-b")]
    try:
        table = eng.ps_table()
        verdicts = {}
        for team in sorted(eng.live_teams()):
            try:
                with contextlib.redirect_stderr(io.StringIO()):
                    verdict, lines, _rem = diagnose_team(team, table)
            except BaseException as exc:  # a diagnosis that crashes is a failed one
                verdicts[team] = f"diagnosis raised {type(exc).__name__}"
                continue
            pop = eng.team_population(team)
            said_split = any(ln.startswith("warning  its crew is seated") for ln in lines)
            # Computed here rather than read from the verdict: a lead runs in a
            # terminal, so it occupies no pane and cannot be a seat. Counting it calls
            # every team with a live masqueraded lead split.
            seats = {eng.socket_hosting([f"{n}@{team}"], table)[0]
                     for n, (state, _w) in pop.items()
                     if n != "team-lead" and eng.wearers(f"{n}@{team}")}
            seats.discard(None)
            if said_split != (len(seats) > 1):
                verdicts[team] = f"split said {said_split}, crew sits on {len(seats)} server(s)"
            if verdict == "DEGRADED" and not (said_split or any(
                    ln.startswith("warning  ") and "worn by" in ln for ln in lines)):
                verdicts[team] = "degraded with nothing to act on"
    finally:
        globals()["RESOLVER"] = real_resolver
    check("verdict-names-actionable", "a verdict names something to act on", not verdicts,
          "; ".join(f"{t}: {why}" for t, why in verdicts.items()))

    # DEGRADED is the verdict that means a person must act, and three different
    # states reach it. Each is driven here as its own fixture over one corpus
    # team, and the verdict is asserted as well as the block: a fixture that
    # drifts to SEVERED fails here rather than quietly testing nothing. The
    # process table is faked the way the scenarios above fake it, and the
    # seating is stubbed, because two servers cannot be stood up from a suite.
    real_resolver = globals()["RESOLVER"]
    globals()["RESOLVER"] = eng = corpus_engine()
    crew = "session-corpus-crew"
    lead_row = (771001, 1, f"{FAKE_AGENT_BIN} --resume "
                           f"11111111-1111-4111-8111-111111111111 --agent-id team-lead@{crew}")

    def _wearing(pid, name):
        return (pid, 1, f"{FAKE_AGENT_BIN} --resume "
                        f"22222222-2222-4222-8222-222222222222 --agent-id {name}@{crew}")

    eng.session_registry = lambda: []
    # A lead that reads this team, so the doubled and split fixtures differ from
    # the dormant one in the crew alone.
    eng.team_minted_by = lambda pid: (crew, True)
    fixtures = {
        # nothing running and nothing waiting, so no lead reads it either
        "dormant": ([], lambda ids, table: (None, None), "dormant"),
        # one name, two processes, one seat between them
        "doubled": ([lead_row, _wearing(771002, "petrel"), _wearing(771003, "petrel")],
                    lambda ids, table: ("sock-one", "the crew's seat"), "worn by"),
        # two names, a seat each
        "split": ([lead_row, _wearing(771002, "petrel"), _wearing(771004, "sparrow")],
                  lambda ids, table: (("sock-a" if any("petrel" in i for i in ids)
                                       else "sock-b"), "a seat"), "seated on"),
    }
    arms = {}
    try:
        for arm, (rows, hosting, said_word) in fixtures.items():
            eng.ps_table = lambda refresh=False, rows=rows: rows
            eng.socket_hosting = hosting
            try:
                with contextlib.redirect_stderr(io.StringIO()):
                    verdict, lines, rem = diagnose_team(crew, rows)
            except BaseException as exc:  # a diagnosis that crashes is a failed one
                arms[arm] = f"diagnosis raised {type(exc).__name__}"
                continue
            if verdict != "DEGRADED":
                arms[arm] = f"came out {verdict}, so this fixture no longer tests the arm"
            elif not any(ln.startswith("warning  ") and said_word in ln for ln in lines):
                arms[arm] = f"no line says {said_word!r}, so the block does not say which state it is"
            elif not rem or not all(what and cost for what, cost in rem):
                arms[arm] = f"{len(rem)} remedy(ies), so nothing here says what to do"
    finally:
        globals()["RESOLVER"] = real_resolver
    check("degraded-arms-named-and-remedied",
          "every degraded state says which one it is and how to leave it",
          not arms, "; ".join(f"{arm}: {why}" for arm, why in sorted(arms.items())))

    # Mail in a mailbox does not demote a team whose lead is live and reading
    # it: that mail arrives at the lead's next turn boundary and needs nobody.
    # The legend has to claim no more than the verdict tested, so this pins the
    # semantics and the sentence against one state. No corpus mailbox holds
    # mail, so the state is stubbed the way this scenario stubs the process
    # table; reading the mail line back is what keeps the legend clause from
    # passing on a run that never contradicted it.
    real_resolver = globals()["RESOLVER"]
    globals()["RESOLVER"] = eng = corpus_engine()
    eng.session_registry = lambda: []
    eng.ps_table = lambda refresh=False: [
        (424242, 0, "claude --resume aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa "
                    "--agent-id team-lead@session-corpus-multiteam-b")]
    eng.inbox_state = lambda team: {"team-lead": (3, "2026-01-01T00:00:00Z")}
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            verdict, lines, _rem = diagnose_team("session-corpus-multiteam-b")
    finally:
        globals()["RESOLVER"] = real_resolver
    legend_said = dict(DOCTOR_LEGEND)["CONNECTED"]
    mail_said = any(ln.startswith("mail     3 waiting for team-lead") for ln in lines)
    check("connected-legend-claims-what-it-tested",
          "the CONNECTED legend claims nothing the same screen denies",
          verdict == "CONNECTED" and mail_said and "no mail is waiting" not in legend_said,
          f"verdict {verdict}, mail line {mail_said}, legend {legend_said!r}")

    # A live pid whose team cannot be told: the line says unknown and stops.
    # A grade rates an answer, so printing one here would rate a pairing that
    # was never made.
    real_resolver = globals()["RESOLVER"]
    globals()["RESOLVER"] = eng = corpus_engine()
    eng.session_registry = lambda: []
    eng.ps_table = lambda refresh=False: [
        (424242, 0, "claude --resume aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa "
                    "--agent-id team-lead@session-corpus-multiteam-b")]
    eng.team_minted_by = lambda pid: (None, False)
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            _v, ungraded, _r = diagnose_team("session-corpus-multiteam-b")
    finally:
        globals()["RESOLVER"] = real_resolver
    runs_said = next((ln for ln in ungraded if ln.startswith("runs as")), "")
    check("no-grade-without-an-answer",
          "an unknown team is given no confidence grade",
          runs_said == "runs as  (unknown)", f"said {runs_said!r}")

    # --- one job per agent, whatever assembled the list
    said = ""
    try:
        with contextlib.redirect_stdout(io.StringIO()), \
                contextlib.redirect_stderr(io.StringIO()) as err:
            run_agents(_Args(), [], {}, [("twin", _Args()), ("twin", _Args())], None)
    except BaseException:  # a crash is not a refusal, and must not read as one
        said = err.getvalue()
    # The reason, not merely that it exited: a run that died of something else
    # would otherwise read as a refusal and this check would pass on any code.
    check("no-duplicate-launch-in-run", "one agent cannot be launched twice in a run", "appears twice" in said,
          f"exited saying {said.strip()[:60]!r}" if said else "the duplicate was accepted")

    # --- the composed answer agrees with the parts it is composed of
    eng = corpus_engine()
    seen = [(e["team"], e["member"].get("name")) for e in eng.scan_teams()
            if e["member"].get("name") and e["member"].get("name") != "team-lead"]
    agree = {}
    for team, name in seen[:20]:
        st = eng.standing(f"{name}@{team}")
        reachable, _why = st["reachable"]
        pid, alive, _how, _grade = st["lead"]
        lead_team, _grade2 = st["lead_team"]
        # Reachable is the conjunction of its own parts, so a verdict cannot
        # drift from the facts printed beside it.
        # polls is checked against argv rather than against itself: a lead
        # whose command line names its team read this roster at boot, and one
        # that does not cannot be known from outside. Deriving the expectation
        # from the answer would agree with any answer.
        worn = next((e.get("team") for e in eng.live_sessions()
                     if e["pid"] == pid), None) if pid and alive else None
        members = [m for m in (eng.roster_of(lead_team) or {}).get("members", [])
                   if m.get("name") != "team-lead"] if lead_team else []
        want_polls = False if not members else (True if worn else None)
        if st["polls"][0] is not want_polls:
            agree[f"{name}@{team} polls"] = False
        reaches = (pid and alive and lead_team == team and st["listed"])
        want = (st["polls"][0] if reaches else False)
        # True only when the lead is known to be reading, None when that
        # cannot be told from outside its process, False otherwise.
        agree[f"{name}@{team}"] = reachable is (want if want is None else bool(want))
        if reachable and not st["listed"]:
            agree[f"{name}@{team} unlisted yet reachable"] = False
    # Every agent above came out of a roster, so all of them are listed and
    # the unlisted branch is unreachable from that population alone. A name
    # no roster carries is the case that exercises it.
    team = seen[0][0]
    absent = eng.standing(f"definitely-not-a-member@{team}")
    agree["a name no roster carries is not reachable"] = (
        not absent["listed"] and absent["reachable"][0] is False
        and bool(absent["remedies"]))
    wrong = sorted(k for k, good in agree.items() if not good)
    check("standing-follows-own-evidence", "a standing verdict follows from its own evidence", not wrong,
          ", ".join(wrong[:3]))

    check("self-migrate-refused", "a self-migrate is refused",
          bool(RESOLVER.transcript_holders("selftest-uuid",
               [(os.getpid(), os.getppid(),
                 f"{FAKE_AGENT_BIN} --resume selftest-uuid --agent-id a@b")])[1]))

    check("default-path-cannot-kill", "default path cannot kill",
          'if ctx.get("to_team") and not ctx.get("auto_redirect"):' in run_one_src)

    body = source.split('"""', 2)[-1]
    check("tool-name-not-hardcoded", "tool name not hardcoded", TOOL not in body, f"{body.count(TOOL)} literal(s)")

    # -- behavioural, against the portable corpus (test/corpus/)
    eng = corpus_engine()
    name, team = "willow", "session-corpus-alpha"
    check("rung-session-uuid", "rung: session uuid",
          bool(eng.resolve_transcript(session_uuid="22222222-2222-4222-8222-222222222222", quick=True)))
    res = eng.resolve_transcript(team=team, name=name)
    check("rung-stamps", "rung: agentName+teamName stamps", bool(res) and res.via.startswith("agentName+teamName"))
    try:
        with contextlib.redirect_stderr(io.StringIO()):  # the refusal is the point, not its noise
            enforce_identity(res, eng.objections(res, "definitely-not-" + name, team),
                             allow_team_change=False, force=False)
        check("identity-gate-refuses-mismatch", "identity gate refuses a mismatch", False, "it allowed one")
    except SystemExit:
        check("identity-gate-refuses-mismatch", "identity gate refuses a mismatch", True)

    # Judgement and enforcement are separate stages. Assembling an identity
    # that contradicts its stamps must produce objections and nothing else:
    # the guards that turn a run into a noop sit between here and the act,
    # and a gate upstream of them refuses launches that never happen.
    judged, raised = None, None
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            judged = eng.identity(agent_id=f"{name}@definitely-not-{team}")
    except SystemExit as exc:
        raised = exc
    check("identity-judged-not-enforced", "an identity is judged without being enforced",
          raised is None and judged is not None and bool(judged.get("objections")),
          "assembly exited" if raised else f"objections={bool((judged or {}).get('objections'))}")

    # --- an override is told which way the evidence runs
    # Two corpus specimens, one per direction, rather than a search of
    # whatever ex-member leads happen to be on this machine: session-corpus-new
    # was claimed after REUSED_TEAMMATE_LEAD's stamp (newer), and
    # session-corpus-rebound-old was claimed before REBOUND_LEAD's stamp
    # (not newer). Both are exercised on every run instead of opportunistically.
    eng = corpus_engine()
    seen_dirs, wrong = set(), []
    for other, uuid in (("session-corpus-new", "55555555-5555-4555-8555-555555555555"),
                        ("session-corpus-rebound-old", "7ebc7ebc-7ebc-47bc-87bc-7ebc7ebc7ebc")):
        with contextlib.redirect_stderr(io.StringIO()):
            res = eng.resolve_transcript(session_uuid=uuid)
        steam = res.stamped("teamName") if res else None
        why = next((w for kind, _s, _w2, w in eng.objections(res, None, other)
                    if kind == "team_mismatch"), "")
        stamped_ts = res.fields.get("teamName", (None, 0))[1]
        claimed_ts = max((stamp for stamp, payload in eng._log(uuid)
                          if payload.get("team_name") == other), default=0)
        newer = bool(stamped_ts and claimed_ts > stamped_ts)
        seen_dirs.add(newer)
        if steam == other or not steam:
            wrong.append(f"{uuid[:8]} stamped {steam!r}, expected it to differ from {other!r}")
        if ("|newer" in why) != newer:
            wrong.append(f"{uuid[:8]} says {why!r} for newer={newer}")
    check("override-evidence-direction", "an override is told which way the evidence runs",
          seen_dirs == {True, False} and not wrong,
          "; ".join(wrong[:2]) or f"directions covered: {sorted(seen_dirs)}")

    eng = corpus_engine()
    res = eng.resolve_transcript(lead_session="11111111-1111-4111-8111-111111111111",
                                 team="session-corpus-alpha", is_lead=True, quick=True)
    check("rung-lead-session-id", "rung: roster leadSessionId", bool(res) and res.via == "roster leadSessionId")

    # "echo" is deliberately rostered on two corpus teams (session-corpus-alpha
    # and session-corpus-contrasting): every team has a "team-lead", so an
    # ambiguity check that could not tell a real name collision from that
    # would prove nothing.
    eng = corpus_engine()
    check("ambiguous-name-refused", "ambiguous name is refused",
          len(eng.name_rosters("echo")) > 1 and not eng.resolve_transcript(name="echo"))

    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        cases = {
            "pure": ({"team-lead.json": "[]"}, None, None),
            "mail": ({"team-lead.json": '[{"from":"x"}]'}, None, "undelivered"),
            "stray": ({"team-lead.json": "[]"}, "notes.txt", "unexpected"),
            "notjson": ({"team-lead.txt": "x"}, None, ".json"),
        }
        # a message landing in a name-verified file after the check
        race = base / "race"
        (race / "inboxes").mkdir(parents=True)
        (race / "config.json").write_text(json.dumps({"name": "race", "members": []}))
        (race / "inboxes" / "team-lead.json").write_text("[]")
        real_reason, fired = RESOLVER.scaffolding_objection, []

        def racing(target):
            reason = real_reason(target)
            if not fired:
                fired.append(True)
                (race / "inboxes" / "team-lead.json").write_text('[{"from":"x"}]')
            return reason

        real_teams = RESOLVER.teams_dir
        RESOLVER.scaffolding_objection, RESOLVER.teams_dir = racing, base
        with contextlib.redirect_stderr(io.StringIO()):  # the refusal is the point
            removed = remove_if_cruft(race, False, "team")
        RESOLVER.scaffolding_objection, RESOLVER.teams_dir = real_reason, real_teams
        check("mail-mid-removal-not-deleted", "mail arriving mid-removal is not deleted",
              not removed and race.exists() and (race / "inboxes" / "team-lead.json").read_text() != "[]")

        # one row per agent, even when several rosters claim the name
        buffer = io.StringIO()
        with contextlib.redirect_stdout(buffer):
            run_complete("names")
        names = [line.split("\t")[1].split("@", 1)[0] for line in buffer.getvalue().splitlines() if line]
        check("completion-agent-once", "completion offers each agent once", len(names) == len(set(names)),
              ", ".join(sorted({n for n in names if names.count(n) > 1})))

        for label, (inboxes, stray, expect) in cases.items():
            team = base / label
            (team / "inboxes").mkdir(parents=True)
            (team / "config.json").write_text(json.dumps({"name": label, "members": []}))
            for fname, content in inboxes.items():
                (team / "inboxes" / fname).write_text(content)
            if stray:
                (team / stray).write_text("x")
            reason = RESOLVER.scaffolding_objection(team)
            ok = (reason is None) if expect is None else (reason is not None and expect in reason)
            check(f"cruft-{label}", f"cruft check: {label}", ok, reason or "considered empty")

    for topic in ("names", "teams", "leads", "sockets", "sessions", "sides"):
        buffer = io.StringIO()
        with contextlib.redirect_stdout(buffer):
            run_complete(topic)
        lines = [line for line in buffer.getvalue().splitlines() if line]
        malformed = [line for line in lines if "\t" not in line and ":" not in line]
        check(f"completion-parses-{topic}", f"completion emits parseable {topic}", not malformed, f"{len(lines)} candidates")

    if live:
        results.extend(live_checks())

    if list_only:
        for cid, name, _ok, _detail in results:
            print(f"{cid}  {name}")
        return 0

    for line in check_report(results, failed_only):
        print(line)
    return 1 if any(not ok for _, _, ok, _ in results) else 0


def verb_needs(args, selector):
    """What each verb declares to the engine, mirroring main's dispatch.

    Hard where the verb's fixed path always computes it, conditional where
    a branch or the corpus decides. The end-of-run audit refuses a hard need
    nobody exercised, so nothing survives here just in case; the maps are
    tightened by running the verbs, not by guessing.
    """
    if args.selftest or args.complete or args.cleanup:
        # the suite and completion exercise by fixture and topic; cleanup
        # runs from the startup hook, where a refused compute would fail
        # silently behind its own output redirection
        return Needs(maybe=set(NEED))
    if args.doctor:
        # the mail join runs only for a named team
        return Needs(hard={NEED.PROCS, NEED.STAMPS, NEED.SPAWNS},
                     maybe={NEED.MAIL})
    if args.census:
        # the process table only where a count is about live agents
        return Needs(hard={NEED.STAMPS, NEED.SPAWNS}, maybe={NEED.PROCS})
    if args.sides:
        # titles only when a listing has a session to title
        return Needs(hard={NEED.SIDES}, maybe={NEED.TITLES})
    if args.promote:
        # a promote resolves an identity only once it has one to place
        return Needs(hard={NEED.SIDES},
                     maybe={NEED.PROCS, NEED.STAMPS, NEED.SPAWNS})
    if args.demote:
        # the side corpus only when a stored receipt names one
        return Needs(hard={NEED.PROCS, NEED.STAMPS},
                     maybe={NEED.SIDES, NEED.SPAWNS})
    if args.mail_ledger:
        # liveness only for the rows a live holder would explain
        return Needs(hard={NEED.STAMPS, NEED.MAIL},
                     maybe={NEED.PROCS, NEED.SPAWNS})
    if args.install or args.poison or args.unpoison or args.help:
        return Needs()
    if not (selector or args.agent_id or args.resume or args.team):
        return Needs()  # the help gate answers this run
    if args.standing:
        return Needs(hard={NEED.PROCS, NEED.STAMPS, NEED.SPAWNS, NEED.MAIL})
    if args.stop:
        # payloads only when a target has to be found by parentage
        return Needs(hard={NEED.PROCS, NEED.STAMPS}, maybe={NEED.SPAWNS})
    # The input decides which resolution rungs can run. A uuid resolves from
    # the filename and never reaches the stamps. A bare name or a team can be
    # found through the stamps and nothing else. An agent id reaches them only
    # when nothing live wears it, which is the run's own liveness rather than
    # anything the input says.
    by_uuid = bool(args.resume) or bool(selector and UUID_RE.match(selector))
    if args.agent_id or (selector and "@" in selector):
        # an agent id reaches the stamps only when nothing live wears it
        return Needs(hard={NEED.PROCS, NEED.SPAWNS}, maybe={NEED.STAMPS})
    if by_uuid and not args.team:
        return Needs(hard={NEED.PROCS, NEED.SPAWNS})
    return Needs(hard={NEED.PROCS, NEED.SPAWNS, NEED.STAMPS})


def audited(entry):
    """Run the verb, then let the engine refuse a fat declaration.

    Only a completed verb is audited: a refusal mid-run proves nothing
    about what the whole verb would have used, and an exec never returns.
    """
    code = entry()
    RESOLVER.audit_needs()
    return code


def main():
