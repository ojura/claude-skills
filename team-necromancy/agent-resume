                for label, changeset in changes.items():
                    inboxes = list(effects["inboxes"])
                    inboxes[at] = immutable({**effect, **changeset})
                    corruptions[f"inbox {at} {label}"] = changed_effect("inboxes", tuple(inboxes))
            for label, corrupted in corruptions.items():
                try:
                    answer = complete_without_reads(eng, plan["launch"], corrupted)
                    if not answer["objections"] or answer["written_roster"] is not None or answer["launch"] is not plan["launch"]:
                        faults.append(f"{invalid}: accepted {label}")
                except (Refusal, AssertionError, AttributeError, KeyError, TypeError, ValueError, RecursionError) as exc:
                    faults.append(f"{invalid}: {label} raised {type(exc).__name__}: {exc}")
            # The zero-mode evidence has all other facts unchanged and valid.
            zero_write = immutable({**write, "mode": 0})
            zero_plan = immutable({**plan, "write": zero_write})
            zero_effects = immutable({**effects, "written": {"selection": zero_write,
                "observation": dataclasses.replace(observed, mode=0), "data": zero_write["data"]}})
            zero_applied = dataclasses.replace(applied, plan=zero_plan, effects=zero_effects)
            zero_answer = complete_without_reads(eng, zero_plan["launch"], zero_applied)
            if zero_answer["objections"] or zero_answer["written_roster"].mode != 0:
                mode_faults.append("completion lost zero")
    check('rebuild-completion-checks-each-effect', not faults, '; '.join(faults))

    descriptor_faults, effect_faults = [], []
    for invalid in (False, True):
        with _roster_test_fixture() as f:
            plan = _rebuild_test_plan(f, invalid)
            if invalid:
                plan["cfg"].chmod(0o600)
                plan = f.engine.rebuild_plan(team=plan["team"], table=(), census=f.engine._roster_census())
            real_fsync, real_complete = os.fsync, f.engine.rebuild_plan
            seen, touched = {}, []

            def change_mode(descriptor):
                target = os.readlink(f"/proc/self/fd/{descriptor}")
                if target == str(plan["cfg"]) or target.endswith(f"config.json.tmp-{TOOL}"):
                    os.fchmod(descriptor, 0o640)
                    touched.append(target)
                return real_fsync(descriptor)

            def capture(launch, applied=None, **kwargs):
                seen["applied"] = applied
                return real_complete(launch, applied=applied, **kwargs)

            with mock.patch.object(os, "fsync", change_mode), mock.patch.object(f.engine, "rebuild_plan", capture):
                try:
                    with capturing("out"), capturing("err"):
                        apply_rebuild_plan(plan, False, assume_yes=True)
                    refused = False
                except Refusal:
                    refused = True
            applied = seen.get("applied")
            actual = applied.effects["written"]["observation"] if applied else None
            if not touched or actual is None or actual.mode != 0o640:
                descriptor_faults.append(f"invalid={invalid}, touched={touched}, observed={actual}")
            if not refused or not applied or not real_complete(plan["launch"], applied=applied)["objections"]:
                effect_faults.append(f"invalid={invalid}")
    check('writers-report-descriptor-mode', not descriptor_faults, '; '.join(descriptor_faults))
    check('rebuild-rejects-observed-mode-mismatch', not effect_faults, '; '.join(effect_faults))

    with _roster_test_fixture() as f:
        cfg = f.root / "zero.json"
        old = FileObservation(cfg, (1, 2, 2, 1000, b'{}'), 0)
        selected = f.engine._roster_write(Resolver.RosterSnapshot(old, {}), {"new": True})
        observed = write_new_bytes(cfg, selected["bytes"], selected["mode"])
        if selected["mode"] != 0 or observed.mode != 0 or cfg.stat().st_mode & 0o777:
            mode_faults.append("exclusive creation lost zero")
        observed = replace_bytes(cfg, b'{}', mode=0)
        if observed.mode != 0 or cfg.stat().st_mode & 0o777:
            mode_faults.append("replacement lost zero")
        cfg.chmod(0o600)
        retained = f.root / "retained.json"
        cfg.rename(retained)
        with retained.open('rb') as handle:
            retained.chmod(0)
            facts = os.fstat(handle.fileno())
            selection = FileObservation(retained, (facts.st_dev, facts.st_ino, facts.st_size,
                                                   facts.st_mtime_ns, b'{}'), 0)
            real_open = Path.open
            with mock.patch.object(Path, 'open', lambda path, *a, **kw:
                                   os.fdopen(os.dup(handle.fileno()), 'rb') if path == retained else real_open(path, *a, **kw)):
                restored = replace_retained_path(cfg, selection)
        if restored.mode != 0 or restored.path != cfg or restored.generation != selection.generation:
            mode_faults.append("retained replacement lost zero")
        cfg.chmod(0o600)
        if cfg.read_bytes() != b'{}':
            mode_faults.append("retained replacement lost bytes")
    check('roster-mode-zero-is-preserved', not mode_faults, '; '.join(mode_faults))
    return checked


@unit(
    ('rebuild-completion-validates-domains', 'completion validates both operands before comparing retained evidence'),
    ('rebuild-completion-checks-prerequisites', 'completion rejects aligned effects with invalid operation prerequisites'),
    ('rebuild-completion-keeps-selected-actions', 'completion rejects different supported actions with otherwise valid effects'),
    ('rebuild-completion-owns-published-values', 'completion publishes owned config and explicit results without retaining raw plans'),
    ('roster-write-owns-selected-config', 'roster selection owns object config and serializes it once while preserving mode zero'),
)
def _check_rebuild_completion_domains(s):
    from pathlib import PurePosixPath
    from unittest import mock

    domains = 'rebuild-completion-validates-domains'
    prerequisites = 'rebuild-completion-checks-prerequisites'
    actions = 'rebuild-completion-keeps-selected-actions'
    ownership = 'rebuild-completion-owns-published-values'
    selector = 'roster-write-owns-selected-config'
    faults = {cid: [] for cid in (domains, prerequisites, actions, ownership, selector)}
    errors = (Refusal, AssertionError, AttributeError, KeyError, TypeError, ValueError, RecursionError)

    class EqualityTrap:
        def __eq__(self, other):
            raise AssertionError('raw equality was evaluated')

        __ne__ = __eq__

    class MappingEqualityTrap(dict):
        __eq__ = EqualityTrap.__eq__
        __ne__ = EqualityTrap.__ne__

    class FormatTrap:
        def __format__(self, spec):
            raise AssertionError('raw diagnostic formatting was evaluated')

    def physical(path, raw, mode, inode=2):
        return FileObservation(path, (1, inode, len(raw), 1000000, raw), mode)

    def evidence(invalid, mode):
        eng = Resolver()
        cfg = Path('/synthetic/completion/config.json')
        original_observation = (physical(cfg, b'{invalid JSON\xff', mode) if invalid
                                else FileObservation(cfg, ('absent',), None))
        original = Resolver.RosterSnapshot(original_observation, {}, 'invalid JSON' if invalid else None)
        launch = immutable({'roster': {'destination': original, 'census': (original,) if invalid else ()}})
        write = immutable({**eng._roster_write(original, {'name': 'completion', 'members': []}), 'mode': mode})
        selected, reported = [], []
        for at, (action, raw) in enumerate((('create', None), ('replace-empty', b''), ('keep', b'[1]')), 10):
            path = cfg.parent / 'inboxes' / (action + '.json')
            before = FileObservation(path, ('absent',), None) if raw is None else physical(path, raw, mode, at)
            inbox = immutable({'action': action, 'observation': before,
                               **({'bytes': b'[]', 'mode': mode} if action != 'keep' else {})})
            after = physical(path, b'[]', mode, at + 10) if action != 'keep' else dataclasses.replace(before)
            selected.append(inbox)
            reported.append(immutable({'selection': inbox, 'action': action,
                                       'before': dataclasses.replace(before), 'after': after}))
        plan = {'launch': launch, 'original': original, 'write': write, 'config': write['data'],
                'action': 'replace-invalid' if invalid else 'create', 'inboxes': tuple(selected)}
        effects = {'original': original, 'written': {'selection': write, 'data': write['data'],
                   'observation': physical(cfg, write['bytes'], mode, 7)},
                   'backup': None, 'rollback': None, 'inboxes': tuple(reported)}
        if invalid:
            backup = immutable({'path': cfg.with_name('backup'), 'bytes': original.raw, 'mode': mode})
            retained = dataclasses.replace(original_observation, path=cfg.with_name('rollback'))
            plan.update(backup_write=backup, retained_original=retained)
            effects.update(backup={'selection': backup, 'observation': physical(backup['path'], backup['bytes'], mode, 30)},
                           rollback=dataclasses.replace(retained))
        applied = Applied('rebuild', immutable(plan), True, durable_action=plan['action'], effects=immutable(effects))
        return eng, launch, applied

    def inbox_evidence(applied, at, selected, **changes):
        chosen, reported = list(applied.plan['inboxes']), list(applied.effects['inboxes'])
        chosen[at] = selected
        reported[at] = {**reported[at], 'selection': selected, **changes}
        return dataclasses.replace(applied, plan={**applied.plan, 'inboxes': tuple(chosen)},
                                   effects={**applied.effects, 'inboxes': tuple(reported)})

    def config_evidence(applied, selected, reported, serialized=None):
        write = {**applied.plan['write'], 'data': selected}
        observed = applied.effects['written']['observation']
        if serialized is not None:
            write['bytes'] = serialized
            observed = physical(observed.path, serialized, observed.mode, 7)
        return dataclasses.replace(applied, plan={**applied.plan, 'write': write, 'config': selected},
                                   effects={**applied.effects, 'written': {
                                       'selection': write, 'observation': observed, 'data': reported}})

    def cyclic(kind):
        value = {} if kind == 'mapping' else []
        if kind == 'mapping':
            value['self'] = value
        else:
            value.append(value)
        return value

    def forbidden(*_args, **_kwargs):
        raise AssertionError('completion read or serialized selected evidence')

    def observe(cid, label, eng, launch, applied, accept=False):
        created = []
        real_init = Resolver.RosterSnapshot.__post_init__

        def constructed(snapshot):
            real_init(snapshot)
            created.append(snapshot)

        try:
            with contextlib.ExitStack() as patches:
                for owner, names in ((Path, ('open', 'stat', 'read_bytes', 'read_text', 'iterdir')),
                                     (os, ('open', 'stat', 'fstat')),
                                     (eng, ('_file_observation', '_roster_snapshot', '_runtime')),
                                     (json, ('dumps',))):
                    for name in names:
                        patches.enter_context(mock.patch.object(owner, name, forbidden))
                patches.enter_context(mock.patch.object(Resolver.RosterSnapshot, '__post_init__', constructed))
                answer = eng.rebuild_plan(launch, applied=applied)
            if accept:
                snapshot = answer['written_roster']
                okay = (set(answer) == {'launch', 'written_roster', 'original_generation',
                                        'replacement_generation', 'objections'}
                        and not answer['objections'] and type(snapshot) is Resolver.RosterSnapshot
                        and len(created) == 2 and snapshot is created[0]
                        and snapshot.observation is applied.effects['written']['observation']
                        and answer['launch']['roster']['destination'] is snapshot
                        and any(item is snapshot for item in answer['launch']['roster']['census'])
                        and answer['original_generation'] is applied.plan['original'].generation
                        and answer['replacement_generation'] is snapshot.generation
                        and not mutable_nodes(answer))
            else:
                okay = (set(answer) == {'launch', 'written_roster', 'objections'}
                        and answer['launch'] is launch and answer['written_roster'] is None
                        and type(answer['objections']) is tuple and bool(answer['objections'])
                        and all(type(item) is str for item in answer['objections']))
            if not okay:
                faults[cid].append(f'{label}: expected {"acceptance" if accept else "rejection"}, '
                                   f'objections={answer["objections"]}')
            return answer
        except errors as exc:
            faults[cid].append(f'{label}: raised {type(exc).__name__}: {exc}')
            return None

    for invalid in (False, True):
        for mode in (0, 0o640):
            title = f'invalid={invalid}, mode={oct(mode)}'
            try:
                eng, launch, applied = evidence(invalid, mode)
            except errors as exc:
                for cid in faults:
                    faults[cid].append(f'{title}: fixture raised {type(exc).__name__}: {exc}')
                continue
            plan, effects = applied.plan, applied.effects
            observe(ownership, title + ': complete positive', eng, launch, applied, True)
            observe(actions, title + ': different supported rebuild action', eng, launch,
                    dataclasses.replace(applied, durable_action='create' if invalid else 'replace-invalid'))
            for at, selected in enumerate(plan['inboxes']):
                other_action = 'keep' if selected['action'] != 'keep' else 'create'
                observe(actions, title + f': different supported inbox action {at}', eng, launch,
                        inbox_evidence(applied, at, selected, action=other_action))
            # Ordinary dictionaries must retain identity on early and later refusals.
            for original_launch in (launch, dict(launch)):
                aligned = dataclasses.replace(applied, plan={**plan, 'launch': original_launch})
                observe(domains, title + ': early launch identity', eng, original_launch,
                        dataclasses.replace(aligned, operation='wrong'))
                observe(domains, title + ': outer-record launch identity', eng, original_launch,
                        dataclasses.replace(aligned, effects=None))
                observe(domains, title + ': later launch identity', eng, original_launch,
                        dataclasses.replace(aligned, effects={**effects, 'inboxes': ()}))

            observe(domains, title + ': operation type', eng, launch,
                    dataclasses.replace(applied, operation=EqualityTrap()))
            raw_pairs = [(kind + ' same', value, value) for kind in ('mapping', 'list')
                         for value in (cyclic(kind),)]
            raw_pairs += [(kind + ' distinct', cyclic(kind), cyclic(kind)) for kind in ('mapping', 'list')]
            raw_pairs += [('both equality traps', EqualityTrap(), EqualityTrap()),
                          ('unsupported strings', 'unknown', 'unknown')]
            for label, selected, reported in raw_pairs:
                observe(domains, title + ': rebuild action ' + label, eng, launch,
                        dataclasses.replace(applied, plan={**plan, 'action': selected}, durable_action=reported))
                for at, inbox in enumerate(plan['inboxes']):
                    observe(domains, title + f': inbox action {at} ' + label, eng, launch,
                            inbox_evidence(applied, at, {**inbox, 'action': selected}, action=reported))
                if invalid:
                    observe(domains, title + ': rollback ' + label, eng, launch,
                            dataclasses.replace(applied, plan={**plan, 'retained_original': selected},
                                                effects={**effects, 'rollback': reported}))
            for side in ('selected', 'reported'):
                bad = EqualityTrap()
                observe(domains, title + ': rebuild action ' + side, eng, launch,
                        dataclasses.replace(applied, plan={**plan, 'action': bad} if side == 'selected' else plan,
                                            durable_action=bad if side == 'reported' else plan['action']))
                for at, inbox in enumerate(plan['inboxes']):
                    observe(domains, title + f': inbox action {at} ' + side, eng, launch,
                            inbox_evidence(applied, at, {**inbox, 'action': bad} if side == 'selected' else inbox,
                                           action=bad if side == 'reported' else inbox['action']))
                if invalid:
                    observe(domains, title + ': rollback ' + side, eng, launch,
                            dataclasses.replace(applied,
                                plan={**plan, 'retained_original': bad} if side == 'selected' else plan,
                                effects={**effects, 'rollback': bad} if side == 'reported' else effects))

            bad_configs = [('bytes leaf', {'members': [b'bad']}), ('non-string key', {1: 'bad'}),
                           ('top-level list', []), ('missing config', None), ('unsupported leaf', {'members': [EqualityTrap()]})]
            for kind in ('mapping', 'list'):
                selected, reported = cyclic(kind), cyclic(kind)
                if kind == 'list':
                    selected, reported = {'members': selected}, {'members': reported}
                bad_configs.append((kind + ' cycle', selected))
                observe(domains, title + ': config distinct ' + kind, eng, launch,
                        config_evidence(applied, selected, reported))
            for label, data in bad_configs:
                for side in ('both', 'selected', 'reported'):
                    selected = plan['write']['data'] if side == 'reported' else data
                    reported = plan['write']['data'] if side == 'selected' else data
                    observe(domains, title + ': config ' + label + ' ' + side, eng, launch,
                            config_evidence(applied, selected, reported))

            for target in ('write', 'backup') if invalid else ('write',):
                selection = plan['write' if target == 'write' else 'backup_write']
                replacements = [('path', PurePosixPath(selection['path'])),
                                ('bytes', bytearray(selection['bytes'])), ('bytes', memoryview(selection['bytes'])),
                                ('mode', float(mode))]
                replacements += [('mode', False)] if mode == 0 else []
                replacements += [(field, EqualityTrap()) for field in ('path', 'bytes', 'mode')]
                for field, value in replacements:
                    revised = {**selection, field: value}
                    altered = dataclasses.replace(applied,
                        plan={**plan, 'write' if target == 'write' else 'backup_write': revised},
                        effects={**effects, 'written' if target == 'write' else 'backup': {
                            **effects['written' if target == 'write' else 'backup'], 'selection': revised}})
                    observe(domains, title + f': {target} {field} {type(value).__name__}', eng, launch, altered)
            for at, inbox in enumerate(plan['inboxes']):
                for field in ('observation', 'before', 'after'):
                    selected = {**inbox, field: EqualityTrap()} if field == 'observation' else inbox
                    changes = {} if field == 'observation' else {field: EqualityTrap()}
                    observe(domains, title + f': inbox {at} {field} type', eng, launch,
                            inbox_evidence(applied, at, selected, **changes))
                if inbox['action'] != 'keep':
                    for field, value in (('bytes', bytearray(b'[]')), ('mode', float(mode)),
                                         ('bytes', EqualityTrap()), ('mode', EqualityTrap())):
                        observe(domains, title + f': inbox {at} intended {field}', eng, launch,
                                inbox_evidence(applied, at, {**inbox, field: value}))
                for diagnostic in (FormatTrap(), cyclic('mapping'), cyclic('list')):
                    selected = {**inbox, 'name': diagnostic}
                    observe(ownership, title + f': inbox {at} unused diagnostic', eng, launch,
                            inbox_evidence(applied, at, selected), True)
                    after = effects['inboxes'][at]['after']
                    observe(domains, title + f': inbox {at} invalid effect with diagnostic', eng, launch,
                            inbox_evidence(applied, at, selected,
                                           after=dataclasses.replace(after, generation=(*after.generation[:4], b'wrong'))))
            observe(prerequisites, title + ': missing both inbox collections', eng, launch,
                    dataclasses.replace(applied,
                        plan={key: value for key, value in plan.items() if key != 'inboxes'},
                        effects={key: value for key, value in effects.items() if key != 'inboxes'}))
            for at, raw in ((0, b'occupied'), (1, b'occupied'), (2, None), (2, b'')):
                inbox = plan['inboxes'][at]
                before = (FileObservation(inbox['observation'].path, ('absent',), None) if raw is None
                          else physical(inbox['observation'].path, raw, mode))
                changes = {'before': dataclasses.replace(before)}
                if at == 2:
                    changes['after'] = dataclasses.replace(before)
                observe(prerequisites, title + f': aligned inbox prerequisite {at}, raw={raw!r}', eng, launch,
                        inbox_evidence(applied, at, {**inbox, 'observation': before}, **changes))
            if invalid:
                retained = plan['retained_original']
                for observed in (FileObservation(retained.path, ('absent',), None),
                                 FileObservation(retained.path, ('changed-during-read', (1, 2, 3, 4),
                                                 (1, 2, 3, 5), b'raw'), mode)):
                    observe(prerequisites, title + ': nonphysical rollback', eng, launch,
                            dataclasses.replace(applied, plan={**plan, 'retained_original': observed},
                                                effects={**effects, 'rollback': dataclasses.replace(observed)}))
            observe(ownership, title + ': unused cyclic plan field', eng, launch,
                    dataclasses.replace(applied, plan={**plan, 'unused': cyclic('list')}), True)
            shared = [1, True, None, float('nan'), float('inf'), float('-inf')]
            supported = [('shared nonfinite', {'a': shared, 'b': shared}, None),
                         ('list and tuple', {'values': [1, {'nested': [2]}]}, {'values': (1, {'nested': (2,)})}),
                         ('raw mapping equality', MappingEqualityTrap(values=['kept']), MappingEqualityTrap(values=['kept']))]
            for label, selected, reported in supported:
                reported = selected if reported is None else reported
                try:
                    serialized = eng._roster_write(plan['original'], selected)['bytes']
                    observe(ownership, title + ': ' + label, eng, launch,
                            config_evidence(applied, selected, reported, serialized), True)
                except errors as exc:
                    faults[ownership].append(f'{title}: {label} setup raised {type(exc).__name__}: {exc}')
            selected, reported = {'values': ['kept']}, {'values': ['kept']}
            serialized = eng._roster_write(plan['original'], selected)['bytes']
            answer = observe(ownership, title + ': detached caller config', eng, launch,
                             config_evidence(applied, selected, reported, serialized), True)
            selected['values'].append('selected changed')
            reported['values'].append('reported changed')
            if answer is not None and answer['written_roster'] is not None:
                if answer['written_roster'].data['values'] != ('kept',):
                    faults[ownership].append(title + ': caller changed published config')

            for data in ([], (), None, 'text', 1, True, 1.5):
                try:
                    eng._roster_write(plan['original'], data)
                except (TypeError, ValueError):
                    pass
                except errors as exc:
                    faults[selector].append(f'{title}: selector raised {type(exc).__name__}: {exc}')
                else:
                    faults[selector].append(f'{title}: selector accepted {type(data).__name__}')
            nested = {'values': ['kept']}
            backing = {'name': 'owned', 'nested': types.MappingProxyType(nested)}
            try:
                original = Resolver.RosterSnapshot(physical(plan['original'].path, b'{}', mode), {})
                with mock.patch.object(json, 'dumps', wraps=json.dumps) as dumps:
                    selected = eng._roster_write(original, types.MappingProxyType(backing))
                backing['name'] = 'changed'
                nested['values'].append('changed')
                if (dumps.call_count != 1 or selected['mode'] != mode
                        or selected['data']['name'] != 'owned'
                        or selected['data']['nested']['values'] != ('kept',)
                        or mutable_nodes(selected)
                        or json.loads(selected['bytes']) != {'name': 'owned', 'nested': {'values': ['kept']}}):
                    faults[selector].append(title + ': selector ownership, mode, or serialization differs')
            except errors as exc:
                faults[selector].append(f'{title}: selector ownership raised {type(exc).__name__}: {exc}')
    return [_check_verdict(cid, not details, '; '.join(details)) for cid, details in faults.items()]


@unit(
    ('rebuild-revalidates-every-mode-phase', 'rebuild refuses mode-only changes to original, backup, rollback and written files'),
    ('rebuild-revalidates-every-byte-phase', 'rebuild refuses changed bytes at every retained file phase'),
    ('rebuild-rollback-restores-exact-observation', 'inbox failure restores the original bytes, inode and permissions'),
)
def _check_rebuild_observation_phases(s):
    from unittest import mock
    checked, mode_faults, byte_faults, rollback_faults = [], [], [], []
    cases = (("initial", 1, "cfg", False), ("backup", 2, "backup_path", False),
             ("rollback before cleanup", 4, "rollback_path", False),
             ("written before cleanup", 4, "cfg", False),
             ("written before rollback", 4, "cfg", True),
             ("rollback before restore", 4, "rollback_path", True),
             ("restored before verification", 5, "cfg", True))
    for mode_only in (True, False):
        faults = mode_faults if mode_only else byte_faults
        for label, trigger, key, failed_inbox in cases:
            with _roster_test_fixture() as f:
                plan = _rebuild_test_plan(f, True)
                actual_revalidate, actual_seed = f.engine.revalidate_rebuild, seed_selected_inbox
                calls, changed = [], []

                def revalidate(selected, **kwargs):
                    calls.append(kwargs)
                    if len(calls) == trigger:
                        target = selected[key]
                        before = f.engine._file_observation(target)
                        if mode_only:
                            target.chmod(0o600)
                        else:
                            target.write_bytes(target.read_bytes() + b'changed')
                        after = f.engine._file_observation(target)
                        changed.append((before, after))
                    return actual_revalidate(selected, **kwargs)

                def seed(inbox, **kwargs):
                    if failed_inbox:
                        raise OSError("synthetic inbox failure")
                    return actual_seed(inbox, **kwargs)

                with mock.patch.object(f.engine, "revalidate_rebuild", revalidate), \
                        mock.patch.dict(globals(), seed_selected_inbox=seed):
                    try:
                        with capturing("out"), capturing("err"):
                            apply_rebuild_plan(plan, False, assume_yes=True)
                        refused = False
                    except Refusal:
                        refused = True
                    except OSError:
                        refused = False
                okay = refused and len(changed) == 1
                if changed:
                    before, after = changed[0]
                    okay = okay and (before.generation == after.generation and before.mode != after.mode
                                     if mode_only else before.raw != after.raw)
                if not okay:
                    faults.append(f"{label}: refused={refused}, calls={len(calls)}")
    for invalid in (False, True):
        with _roster_test_fixture() as f:
            plan = _rebuild_test_plan(f, invalid)
            original = plan["original"].observation
            with mock.patch.dict(globals(), seed_selected_inbox=mock.Mock(side_effect=OSError("seed failure"))):
                try:
                    with capturing("out"), capturing("err"):
                        apply_rebuild_plan(plan, False, assume_yes=True)
                    raised = False
                except OSError as exc:
                    raised = str(exc) == "seed failure"
            restored = f.engine._file_observation(plan["cfg"])
            if not raised or restored != original or (plan["rollback_path"] and plan["rollback_path"].exists()):
