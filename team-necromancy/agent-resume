@unit(('no-coinages-in-output', "the project's own coinages stay out of printed strings"))
def _check_no_coinages_in_output(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    tree = s.tree

    coinages = ("window-start", "strand")
    doc_strings = set()
    for node in ast.walk(tree):
        body = getattr(node, "body", None)
        if (body and isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef))
                and isinstance(body[0], ast.Expr)
                and isinstance(body[0].value, ast.Constant)
                and isinstance(body[0].value.value, str)):
            doc_strings.add(id(body[0].value))
    suite_lines = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name in s.suite_fns:
            # From the decorator, not the def: a unit registers its ids there,
            # and an id may carry a word this rule keeps out of prose.
            opens = min([node.lineno] + [d.lineno for d in node.decorator_list])
            suite_lines.update(range(opens, node.end_lineno + 1))
    spoken = sorted({f"line {n.lineno}: {word!r}" for n in ast.walk(tree)
                     if isinstance(n, ast.Constant) and isinstance(n.value, str)
                     and id(n) not in doc_strings and n.lineno not in suite_lines
                     for word in coinages if word in n.value})
    check("no-coinages-in-output", "the project's own coinages stay out of printed strings", not spoken,
          "; ".join(spoken))
    return checked


