        plan = eng._rewriter.restamp_plan(path, 'B', start=('mover', 'A', 'moving-root'))
        events, forbidden_reads = [], []
        marker = OSError('lookup after installation and before refresh')
        real_replace, real_stat, real_refresh = os.replace, Path.stat, eng.refresh_transcript_evidence

        def replaced(source, dest):
            result = real_replace(source, dest)
            if Path(dest) == path:
                events.append('installed')
            return result

        def refreshed():
            result = real_refresh()
            events.append('refresh')
            return result

        def stat(selected, *args, **kwargs):
            if selected == path and events == ['installed']:
                forbidden_reads.append(selected)
                raise marker
            return real_stat(selected, *args, **kwargs)

        caught = None
        with mock.patch.object(os, 'replace', replaced), mock.patch.object(Path, 'stat', stat), \
                mock.patch.object(eng, 'refresh_transcript_evidence', refreshed):
            try:
                apply_restamp(plan)
