@unit(
    ('resolver-public-api-is-explicit',
     'every public Resolver method is a declared complete question with an external caller'),
    ('resolver-question-callers-are-exact',
     'every complete Resolver question has exactly its approved production callers'),
    ('resolver-components-stay-private',
     'module code does not reach Resolver internals, aliases, or components'),
)
def _check_resolver_public_api_is_explicit(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    questions = {name: set(callers)
                 for name, callers in PUBLIC_RESOLVER_QUESTIONS.items()}
    attributes = {name: set(callers)
                  for name, callers in PUBLIC_RESOLVER_ATTRIBUTES.items()}
    actual_questions = {
        name: set(callers) for name, callers in s.resolver_calls.items()
        if not name.startswith("_")
    }
    actual_attributes = {
        name: set(callers) for name, callers in s.resolver_attributes.items()
    }
    literal_faults = [name for name in
                      ("PUBLIC_RESOLVER_QUESTIONS", "PUBLIC_RESOLVER_ATTRIBUTES")
                      if not s.literal_map_shape(name)]
    missing_questions = sorted(set(questions) - s.resolver_public_methods)
    undeclared_methods = sorted(s.resolver_public_methods - set(questions))
    internal_only = sorted(
        method for method in s.resolver_public_methods
        if method not in actual_questions)
    api_faults = []
    if literal_faults:
        api_faults.append("nonliteral " + ", ".join(literal_faults))
    if missing_questions:
        api_faults.append("declared but missing " + ", ".join(missing_questions))
    if undeclared_methods:
        api_faults.append("undeclared public " + ", ".join(undeclared_methods))
    if internal_only:
        api_faults.append("public but internal-only " + ", ".join(internal_only))
    check("resolver-public-api-is-explicit",
          "every public Resolver method is a declared complete question with an external caller",
          not api_faults, "; ".join(api_faults))

    ownership_faults = []
    for question in sorted(set(questions) | set(actual_questions)):
        approved, actual = questions.get(question, set()), actual_questions.get(question, set())
        if actual != approved:
            ownership_faults.append(
                f"{question}: actual {sorted(actual)}, approved {sorted(approved)}")
    for attribute in sorted(set(attributes) | set(actual_attributes)):
        approved, actual = attributes.get(attribute, set()), actual_attributes.get(attribute, set())
        if actual != approved:
            ownership_faults.append(
                f"attribute {attribute}: actual {sorted(actual)}, approved {sorted(approved)}")
    check("resolver-question-callers-are-exact",
          "every complete Resolver question has exactly its approved production callers",
          not ownership_faults, "; ".join(ownership_faults))

    private_calls = sorted(
        f"{name}: {sorted(callers)}" for name, callers in s.resolver_calls.items()
        if name.startswith("_"))
    private_attributes = sorted(
        f"{name}: {sorted(callers)}" for name, callers in s.resolver_attributes.items()
        if name.startswith("_"))
    component_faults = (private_calls + private_attributes
                        + sorted(set(s.resolver_aliases))
                        + sorted(set(s.resolver_chains)))
    check("resolver-components-stay-private",
          "module code does not reach Resolver internals, aliases, or components",
          not component_faults, "; ".join(component_faults))
    return checked


