                            okay = okay and not meta.exists()
                        if kind == "promote":
                            okay = okay and after["dest_receipt"] is not None and after["dest_fact"] is not None
                    if not okay:
                        faults[key].append(f"{kind}/{mode}: caught={type(caught).__name__}: {caught}, refreshed={len(refreshed)}, current={current}, old={old_unchanged}, projected={projections}")
            except Exception as exc:
                faults[key].append(f"{kind}/{mode}: raised {type(exc).__name__}: {exc}")
    with _roster_test_fixture() as f:
        path = f.root / "writer.json"
