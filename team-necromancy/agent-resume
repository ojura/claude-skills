def seed_selected_inbox(inbox, dry=False):
    """Apply selected inbox bytes and retain the actual descriptor observation."""
    action, before = inbox["action"], inbox["observation"]
    path = before.path
    written = before
    if action != "keep" and dry:
        step(True, f"would seed {path} with []", "")
    elif action != "keep":
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            if action == "create":
                written = write_new_bytes(path, inbox["bytes"], inbox["mode"])
            elif action == "replace-empty":
                with path.open("r+b") as handle:
                    raw = handle.read()
                    facts = os.fstat(handle.fileno())
                    current = FileObservation(
                        path, (facts.st_dev, facts.st_ino, facts.st_size,
                               facts.st_mtime_ns, raw), facts.st_mode & 0o777)
                    if current != before:
                        die(f"{path} changed before it could be seeded; nothing was overwritten")
                    handle.seek(0)
                    handle.truncate()
                    written = _write_descriptor(
                        handle.fileno(), path, inbox["bytes"], inbox["mode"])
            else:
                raise AssertionError(f"unknown inbox seed action {action!r}")
        except OSError as exc:
            die(f"cannot seed {path}: {exc}")
        step(False, "", f"seeded {path} with []")
    return immutable({
        "selection": inbox, "action": action, "before": before, "after": written,
    })


def apply_selected_write(selection):
    """Execute the selected byte-write action without selecting its inputs again."""
    if selection["action"] == "create":
        return write_new_bytes(selection["path"], selection["bytes"], selection["mode"])
    if selection["action"] == "replace":
        return replace_bytes(selection["path"], selection["bytes"], mode=selection["mode"])
    raise ValueError(f"unknown selected write action {selection['action']!r}")


def _written_matches(path, raw, mode, observed):
    """Compare a descriptor result with the intended destination, bytes, and mode."""
    return (type(observed) is FileObservation and observed.physical
            and type(path) is type(observed.path)
            and type(raw) is type(observed.raw)
            and type(mode) is type(observed.mode)
            and observed.path == path and observed.raw == raw and observed.mode == mode)


def require_selected_write(selection, observed):
    """Refuse a descriptor result that did not install the selected bytes and mode."""
    if not _written_matches(selection["path"], selection["bytes"], selection["mode"], observed):
        die(f"written file {selection['path']} does not match its selected bytes and permissions")


def apply_rebuild_plan(plan, dry, assume_yes=False):
    """Apply a rebuild and retain each phase's complete descriptor observations."""
    if plan["objections"]:
        die("; ".join(plan["objections"]))
    if plan["action"] == "none":
        return plan["launch"], plan["config"]
    cfg = plan["cfg"]
    if dry:
        verb = "replace invalid" if plan["action"] == "replace-invalid" else "rebuild"
        step(True, f"would {verb} {cfg} ({plan['note']}) and seed every inbox", "")
        return plan["launch"], plan["config"]
    if (plan["action"] == "replace-invalid" and not assume_yes
            and not ask_default_yes(f"replace unreadable roster {cfg}")):
        die(f"left unreadable roster {cfg} unchanged")
    expected = {item.path: item for item in plan["observations"]}

    checked = RESOLVER.revalidate_rebuild(plan, observations=tuple(expected.values()))
    if not checked["matches"]:
        die("the selected rebuild observations changed ("
            + ", ".join(checked["changed"]) + "); nothing was written")
    backup_effect = rollback_effect = None
    if plan["action"] == "replace-invalid":
        backup = apply_selected_write(plan["backup_write"])
        require_selected_write(plan["backup_write"], backup)
        expected[backup.path] = backup
        backup_effect = immutable({"selection": plan["backup_write"], "observation": backup})
        checked = RESOLVER.revalidate_rebuild(plan, observations=tuple(expected.values()))
        if not checked["matches"]:
            die("the selected rebuild changed after its exact backup ("
                + ", ".join(checked["changed"]) + f"); the roster is unchanged and "
                f"the backup is at {plan['backup_path']}")
        try:
            os.link(cfg, plan["rollback_path"])
            with plan["rollback_path"].open("rb") as handle:
                raw = handle.read()
                os.fsync(handle.fileno())
                facts = os.fstat(handle.fileno())
            rollback_effect = FileObservation(
                plan["rollback_path"], (facts.st_dev, facts.st_ino, facts.st_size,
                                        facts.st_mtime_ns, raw), facts.st_mode & 0o777)
        except OSError as exc:
            die(f"cannot retain the selected invalid roster for rollback ({exc}); "
                f"the roster is unchanged and the backup is at {plan['backup_path']}")
        if rollback_effect != plan["retained_original"]:
            die("the retained rollback observation differs from the selected original")
        expected[rollback_effect.path] = rollback_effect
        checked = RESOLVER.revalidate_rebuild(plan, observations=tuple(expected.values()))
        if not checked["matches"]:
            die("the selected rebuild changed during rollback preparation ("
                + ", ".join(checked["changed"]) + f"); the roster is unchanged and "
                f"the backup is at {plan['backup_path']}")
    written = apply_selected_write(plan["write"])
    expected[written.path] = written
    written_effect = immutable({
        "selection": plan["write"], "observation": written, "data": plan["write"]["data"],
    })
    suffix = f" (invalid bytes backed up at {plan['backup_path']})" if backup_effect else ""
    print(f"  rebuilt {cfg} ({plan['note']}){suffix}")
    inbox_effects = []
    try:
        for inbox in plan["inboxes"]:
            inbox_effects.append(seed_selected_inbox(inbox))
    except BaseException:
        checked = RESOLVER.revalidate_rebuild(
            plan, observations=tuple(expected.values()), include_inboxes=False)
        if not checked["matches"]:
            die("inbox initialization failed and rebuild evidence changed before "
                "restoration (" + ", ".join(checked["changed"]) + ")")
        try:
            if rollback_effect is not None:
                restored = replace_retained_path(cfg, rollback_effect)
                expected[rollback_effect.path] = FileObservation(rollback_effect.path, ("absent",), None)
            else:
                cfg.unlink()
                restored = FileObservation(cfg, ("absent",), None)
            expected[cfg] = restored
        except OSError as exc:
            die(f"inbox initialization failed and restoring {cfg} failed ({exc})")
        checked = RESOLVER.revalidate_rebuild(
            plan, observations=tuple(expected.values()), include_inboxes=False)
        if not checked["matches"] or restored != plan["original"].observation:
            die("inbox initialization failed and the roster did not restore exactly ("
                + ", ".join(checked["changed"]) + ")")
        raise
    effects = immutable({
        "original": plan["original"], "backup": backup_effect, "rollback": rollback_effect,
        "written": written_effect, "inboxes": tuple(inbox_effects),
    })
    applied = Applied(operation="rebuild", plan=plan, confirmation=True,
                      durable_action=plan["action"], effects=effects, dry_run=False)
    completed = RESOLVER.rebuild_plan(plan["launch"], applied=applied)
    if completed["objections"]:
        die("; ".join(completed["objections"]))
    checked = RESOLVER.revalidate_rebuild(
        plan, observations=tuple(expected.values()), include_inboxes=False)
    if not checked["matches"]:
        die("the rebuild completed but its file observations changed ("
            + ", ".join(checked["changed"]) + ")")
    if plan["rollback_path"]:
        try:
            plan["rollback_path"].unlink()
        except OSError as exc:
            warn(f"cannot remove rebuild rollback file {plan['rollback_path']}: {exc}")
    return completed["launch"], completed["written_roster"].data


def rebuild_team(ctx, dry, assume_yes=False):
    """Build and apply the reconstruction answer for one launch."""
    return apply_rebuild_plan(
        RESOLVER.rebuild_plan(ctx), dry, assume_yes=assume_yes)


# Roster writes wait for proper-lockfile's 10-second stale interval. Claude Code
# performs synchronous read-modify-write operations under this lock and retries
# for about 0.65 seconds. The longer wait lets an active writer finish before this
# tool reports contention.
LOCK_WAIT_S = 10.0


def drop_lock(lock, seen):
    """Remove a lock only while its bytes still match the inspected record.

    A different process can replace the file between inspection and removal. The
    byte comparison detects that replacement and preserves the new lock. Device
    and inode identity are insufficient because immediate inode reuse occurs on
    this filesystem. The remaining read-to-unlink interval would require every
    remover to hold `flock` on the descriptor across both operations.

    A missing or replaced file returns a benign false result so the caller can
    inspect the current path again.
    """
    try:
        if lock.read_bytes() != seen:
            return False, ""
    except OSError:
        return False, ""
    try:
        lock.unlink()
    except FileNotFoundError:
        return False, ""
    except OSError as exc:
        return False, str(exc)
    return True, ""


@contextlib.contextmanager
def team_lock(plan, write, timeout=LOCK_WAIT_S):
    """Hold the selected roster lock while its exact generation is written."""
    lock = write["lock"]
    started = time.monotonic()
    handle, said_waiting = None, False
    while handle is None:
        try:
            handle = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            state = RESOLVER.revalidate_membership(
                plan, inspect_lock=True, only_team=write["team"],
                include_inboxes=False)
            lock_state = next((item for item in state["locks"]
                               if item["path"] == lock), None)
            owner = lock_state["owner"] if lock_state else None
            gone = lock_state["gone"] if lock_state else False
            seen = lock_state["seen"] if lock_state else None
            if gone:
                took, stuck = drop_lock(lock, seen)
                if took:
                    warn(f"{lock.name} belongs to exited pid {owner['pid']}; "
                         "removing the stale lock")
                    continue
                if not stuck:
                    continue
            else:
                stuck = ""
            if owner:
                situation = f"is held by pid {owner['pid']}"
            elif seen is None:
                situation = "is a directory owned by Claude Code's lock helper"
            else:
                situation = "has no readable owner record"
            if stuck:
                situation += f", and stale-lock removal failed ({stuck})"
            if time.monotonic() - started > timeout:
                die(f"{lock} {situation}; it remained held for {timeout:g}s. "
                    f"{write['path'].name} remains unchanged")
            if not said_waiting and time.monotonic() - started > 1.0:
                warn(f"waiting for {lock.name}, which {situation}")
                said_waiting = True
            time.sleep(0.05)
        except OSError as exc:
            die(f"lock acquisition failed for {lock} ({exc}); "
                f"{write['path'].name} remains unchanged")
    try:
        os.write(handle, json.dumps(json_value(write["lock_owner"])).encode())
        yield
    finally:
        try:
            mine, there = os.fstat(handle), os.stat(lock)
            still_ours = (mine.st_dev, mine.st_ino) == (there.st_dev, there.st_ino)
        except OSError:
            still_ours = False
        os.close(handle)
        if still_ours:
            try:
                lock.unlink()
            except OSError as exc:
                warn(f"cannot remove {lock}: {exc}")


_BACKED_UP = set()


def apply_membership(plan, dry=False):
    """Apply one exact membership plan and return its claim or rollback answer."""
    if plan["objections"]:
        die("; ".join(plan["objections"]))
    if plan["action"] in ("none", "blocked"):
        return plan["claim"] if plan["operation"] == "reserve" else plan["rollback"]
    verb = {
        "reserve": "claim", "record": "record",
        "release": "release", "restore": "restore",
    }[plan["operation"]]
    past = {
        "reserve": "claimed", "record": "recorded",
        "release": "released", "restore": "restored",
    }[plan["operation"]]
    if dry:
        for write in plan["writes"]:
            step(True, f"would {verb} {plan['record']['agentId']} in {write['path']}", "")
        for inbox in plan["inboxes"]:
            seed_selected_inbox(inbox, dry=True)
        return plan["claim"] if plan["operation"] == "reserve" else plan["rollback"]
    checked = RESOLVER.revalidate_membership(plan)
    if not checked["matches"]:
        die("the selected membership generations changed (" +
            ", ".join(checked["changed"]) + "); nothing was written")
    for inbox in plan["inboxes"]:
        seed_selected_inbox(inbox)
    for write in plan["writes"]:
        write["path"].parent.mkdir(parents=True, exist_ok=True)
        with team_lock(plan, write):
            checked = RESOLVER.revalidate_membership(
                plan, only_team=write["team"], include_inboxes=False)
            if not checked["matches"]:
                die("the selected roster changed while its lock was acquired (" +
                    ", ".join(checked["changed"]) + "); it remains unchanged")
            cfg = write["path"]
            suffix = ""
            if write["backup"] is not None:
                backup = write["backup"]
                observed_backup = apply_selected_write(backup)
                require_selected_write(backup, observed_backup)
                _BACKED_UP.add(cfg)
                suffix = f" (backup: {backup['path'].name})"
            observed = apply_selected_write(write)
            require_selected_write(write, observed)
        print(f"  {past} {plan['record']['agentId']} in {cfg}{suffix}")
    return plan["claim"] if plan["operation"] == "reserve" else plan["rollback"]


def restore_member(undo):
    """Restore only the exact member entry written by this launch."""
    if not undo:
        return
    plan = RESOLVER.membership_plan(
        undo["launch"], "restore", undo=undo, backed_up=frozenset(_BACKED_UP))
    apply_membership(plan)


def unwind_launch(undo, agent_id):
    """Roll back roster changes after cwd entry or exec failure.

    A rollback lock failure leaves the entry listed and emits a warning; the
    original launch failure remains the terminating error.
    """
    try:
        restore_member(undo)
    except Refusal:
        warn(f"the roster for {undo['team']} still lists {agent_id} as active, "
             "for a process that never started")


def exec_failed(undo, agent_id, command, exc):
    """Restore roster state and terminate with the exec error."""
    unwind_launch(undo, agent_id)
    die(f"cannot exec {command[0]}: {exc}")


def become_agent(ctx, command, prefix, undo=None):
    """Prepare environment and cwd, then replace this process with the agent.

    In-pane members, `--here` members, and foreground leads share this path.
    `TEAM_ENV` activates flag-bound identity independently of the invoking shell.
    Member routes pass a roster rollback snapshot; cwd or exec failure restores
    it before reporting the original error. Lead reconstruction remains available
    for retry.
    """
    agent_id = ctx["identity"]["agentId"]
    environ = dict(os.environ)
    if poison_said(environ.get("ANTHROPIC_BASE_URL"), "this shell"):
        environ.pop("ANTHROPIC_BASE_URL", None)
    environ.update(pair.split("=", 1) for pair in TEAM_ENV)
    try:
        enter_agent_cwd(ctx, prefix)
    except Refusal:
        unwind_launch(undo, agent_id)
        raise
    try:
        os.execvpe(command[0], command, environ)
    except OSError as exc:
        exec_failed(undo, agent_id, command, exc)


def env_prefixed(command):
    """Return a pasteable command with the environment used by `become_agent`.

    The prefix includes TEAM_ENV and conditionally removes the Recipe 1 poison.
    The printed `-u` records that removal directly.
    """
    scrub = (["-u", "ANTHROPIC_BASE_URL"]
             if base_url_is_poison(os.environ.get("ANTHROPIC_BASE_URL")) else [])
    return ["env", *scrub, *TEAM_ENV, *command]


def claude_binary(args):
    """Return `--claude-bin` or the current `claude` executable on PATH.

    Current PATH selection avoids stale transcript-version and
    CLAUDE_CODE_EXECPATH values.
    """
    if args.claude_bin:
        return args.claude_bin
    from shutil import which

    return which("claude") or "claude"


def build_command(ctx, args, passthrough):
    user_flags = {a.split("=", 1)[0] for a in passthrough if a.startswith("-")}
    cmd = [claude_binary(args), "--resume", ctx["session"]]

    # --bare emits the executable, --resume, and explicit passthrough flags. It
    # excludes derived identity, model, effort, and permission settings.
    if getattr(args, "bare", False):
        return cmd + passthrough

    identity_flags = {
        flag for flag, field in DERIVED_FLAGS.items()
        if field in IDENTITY_FIELDS
    }
    conflicting = sorted(user_flags & identity_flags)
    if conflicting:
        die("identity passthrough flags would bypass the resolved identity: "
            + ", ".join(conflicting)
            + "; use --agent-id or --into-team")

    for flag, field in DERIVED_FLAGS.items():
        if flag in user_flags:
            continue
        value = (ctx["identity"].get(field) if field in IDENTITY_FIELDS
                 else ctx["settings"].get(field))
        if not value:
            continue
        # A lead launched through teammate identity omits agent type and parent:
        # `team-lead` is the roster role, and the lead is its own session parent.
        if flag == "--agent-type" and value == "team-lead":
            continue
        if flag == "--parent-session-id" and value == ctx["session"]:
            continue
        cmd += [flag, str(value)]

    mode = ctx["settings"].get("permissionMode")
    if mode and not user_flags & {"--permission-mode", "--dangerously-skip-permissions"}:
        if mode == "bypassPermissions":
            cmd.append("--dangerously-skip-permissions")
        elif mode not in ("default", "normal"):
            cmd += ["--permission-mode", mode]

    return cmd + passthrough


# How wide the value column may grow before a long value is allowed to push
# the tag and time out of line on its own row. A cwd or a system prompt is
# longer than every other value put together, and padding to it would leave
# the table mostly blanks.
EXPLAIN_VALUE = 46


def explain(ctx):
    """Every assembled field, where it came from, and what disagreed.

    Sources are tagged rather than repeated. A few sources answer most fields, so a column
    carrying each source's full text is that text written down the page; the
    legend carries it once and the rows carry a letter.

    The legend prints whatever the merge called each source. What that is
    follows one rule, stated where the sources are added: the object, in the
    spelling the rest of this report uses for it.
    """
    print("resolved fields (most recent source wins):")
    tags, rows = {}, []

    def tag(source):
        source = str(source)
        if source not in tags:
            # Letters while there are letters. More than 26 distinct sources
            # has never happened; a numbered tag is what it would get.
            tags[source] = chr(ord("A") + len(tags)) if len(tags) < 26 else f"S{len(tags)}"
        return source

    # Effective identity may intentionally override every identity row. Its
    # evidence still belongs in the explanation, so the legend names every
    # candidate source even when no row selects it.
    explanation = ctx["explanation"]
    selected = explanation["selected"]
    fields = set(selected)
    title = ctx["transcript"].get("title")
    title_source = None
    if title:
        record = f", record {title.record_uuid}" if title.record_uuid else ""
        title_source = (f"{title.kind} event in transcript "
                        f"{title.source.stem}{record}")
        tag(title_source)
    for field in sorted(explanation["candidates"]):
        for _value, _ts, source in explanation["candidates"][field]:
            tag(source)
    for field in sorted(fields):
        _value, _ts, source = selected[field]
        tag(source)
    for field in sorted(fields):
        value, ts, source = selected[field]
        source = tag(source)
        conflict = explanation["conflicts"].get(field, frozenset())
        mark = "  <- conflict: " + ", ".join(sorted(str(c) for c in conflict)) if len(conflict) > 1 else ""
        rows.append((field, "-" if value is None else str(value), tags[source], ts, mark))
    if title:
        rows.append(("title", clip(title.value, EXPLAIN_VALUE),
                     tags[title_source], title.timestamp, ""))
    label = max((len(tag) for tag in tags.values()), default=1)
    for at, (source, tag) in enumerate(tags.items()):
        print(f"  {'sources' if not at else '':<7}  {tag:<{label}}  {source}")
    width = max((len(field) for field, *_ in rows), default=8)
    value_width = min(max((len(value) for _f, value, *_ in rows), default=8), EXPLAIN_VALUE)
    for field, value, tag, ts, mark in rows:
        print(f"  {field:<{width}}  {value:<{value_width}}  {tag:<{label}}  {ms_str(ts)}{mark}")
    for path, _, last_ts in explanation["other_transcripts"]:
        # Named the way a source is named, since it is a transcript that could
        # have been one: the session id, not the file it sits in.
        print(f"  (older transcript ignored: {path.stem} @ {ms_str(last_ts)})")


def check_teammate_mode():
    """Warn when settings select an execution mode outside tmux automation."""
    answer = RESOLVER.teammate_mode_answer()
    if not answer["available"]:
        warn(f"teammateMode is {answer['mode']!r}; this command launches tmux panes")


def redirect_subject(plan):
    """Who a redirect question is about: one member, or a team run's members."""
    if "moving" in plan:
        count = len(plan["moving"])
        return (f"the {count} {'member' if count == 1 else 'members'} of "
                f"{plan['source']} this run starts")
    ctx = plan["launch"]
    return ctx["identity"]["agentId"]


def confirm_redirect(plan, prefix=""):
    """Apply confirmation policy to one already-corroborated redirect plan.

    A team run asks this once for every member it starts, before the first.
    """
    who = redirect_subject(plan)
    pid = plan["lead"]["pid"]
    source, dest = plan["source"], plan["destination"]
    if plan["confirmation"] != "pending":
        return True
    basis = plan["lead"].get("runs_as_basis")
    if not sys.stdin.isatty():
        warn(f"pid {pid}, the lead of {source}, runs as {dest} only by inference; "
             f"nothing here can ask, so {who} stays on {source}")
        return False
    print(fill(f"{prefix}pid {pid}, the lead of {source}, runs as {dest}"
               + (f" ({basis})" if basis else "")))
    try:
        answer = input(f"redirect {who} onto {dest}? [Y/n] ").strip().lower()
    except EOFError:
        answer = ""
    if answer.startswith("n"):
        print(f"{prefix}staying on {source}")
        return False
    return True


def decline_unreachable(plan, args, prefix=""):
    """The one decision left when members cannot follow their lead.

    Their mail on the team they can start with is read by nobody, and being
    reachable is what a member's resume is for, so the safe answer is not to
    start them. --keep-team asks for the unreachable launch without the
    question; nothing to ask at means stopping, since silence is not consent.
    Returns only when the launch on the source team is agreed to. A team run
    asks this once, before its first member.
    """
    who = redirect_subject(plan)
    source, dest = plan["source"], plan["destination"]
    if getattr(args, "keep_team", False):
        return
    if not sys.stdin.isatty():
        die(f"so {who} can only start on {source}, and its lead (running as {dest}) "
            f"does not read {source}'s mail, and nothing here can ask. "
            "Clear the blockers above, or pass --keep-team")
    try:
        possessive = "their" if "moving" in plan else "its"
        answer = input(f"start {who} on {source} anyway, where its lead "
                       f"will not read {possessive} mail? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if not answer.startswith("y"):
        die("stopped; clear the blockers above, or pass --keep-team")


def redirect_blockers(plan):
    """The lines that say why a redirect is blocked, one per objection."""
    if plan["rebind"] and plan["rebind"]["action"] == "blocked":
        return reap_blockers(plan["rebind"])
    return tuple(f"- {said}" for said in (plan["objections"] or (plan["reason"],)))


def agree_to_end(said, args):
    """Whether ending the process `said` describes is agreed to.

    Ending a conversation cannot be undone, so it is asked for the way --stop
    asks: y/N, and --yes or a dry run agrees without a question, because a
    dry run ends nothing. Returns None when nothing here can ask, so the
    caller refuses rather than ending something nobody was told about.
    """
    if args.dry_run or getattr(args, "yes", False):
        return True
    if not sys.stdin.isatty():
        return None
    try:
        answer = input(f"kill {said}? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    return answer.startswith("y")


def end_holder(process, said, args, indent="  "):
    """End one agreed process generation; True when it is gone.

    Two processes appending to one transcript is the state a move prevents,
    so a kill that did not work is said out loud rather than reported as a
    clean move.
    """
    pid = process["pid"]
    # Said only once agreed, so the tense on screen is never ahead of the act.
    step(args.dry_run, f"would kill {said}", f"killing {said}", indent=indent)
    if args.dry_run:
        # Every answer below this point comes from a table this run did not
        # change, so the preview names the process it still counts as alive.
        print(fill(f"{indent}a dry run ends nothing, so what follows is measured "
                   f"with pid {pid} still running"))
        return False
    gone, why = stopped(immutable({
        "process": process, "label": process.get("agent_id") or "holder"}))
    if not gone:
        warn(f"pid {pid} did not die ({why}); "
             "it is still appending to this transcript")
        return False
    return True


def kill_holder(process, where, args, indent="  "):
    """End the selected process generation holding this conversation.
    True when it is gone.

    One spelling for every path. A member migrating to another team, a lead
    moving to one and a team run moving its members (settle_stops) do the
    same thing to the same obstacle: identity is frozen in argv at exec, so a
    move is kill and restart, and two processes must never append to one
    transcript. Written twice, the copies would drift, and the one that
    drifted would be the one nobody was watching.
    """
    pid = process["pid"]
    said = f"pid {pid}, which holds this transcript{where}"
    agreed = agree_to_end(said, args)
    if agreed is None:
        die(f"this move has to end {said}, and nothing here can ask; "
            "pass --yes, or stop it yourself first")
    if not agreed:
        die(f"left alone; stop pid {pid} yourself, or pass --yes")
    return end_holder(process, said, args, indent=indent)


def settle_stops(selection, args, prefix=""):
    """End every running member a team move restarts, before anything else.

    The order a single member's move keeps (apply_member_migration): every
    stop is agreed to first and every process is ended before the team is
    retired, so a stop that is declined, or that nothing here can ask about,
    refuses the whole move while nothing has changed yet. Returns the pids
    ended, none in a dry run.
    """
    stops = selection["stops"]
    if not stops:
        return ()

    def where(process):
        seat = process.get("seat")
        return f" in pane {seat.pane} on {seat.socket}" if seat else ""

    said = [(stop, f"pid {stop['process']['pid']}, which holds {stop['agent_id']}'s "
                   f"conversation{where(stop['process'])}")
            for stop in stops]
    answers = [(stop, agree_to_end(text, args)) for stop, text in said]

    def named(agreed):
        return some_of([f"pid {stop['process']['pid']} ({stop['agent_id']})"
                        for stop, answer in answers if answer is agreed])

    if any(answer is None for _stop, answer in answers):
        die(f"this move has to end {named(None)}, and nothing here can ask; nothing "
            "was stopped, retired or started. Pass --yes, or stop them yourself first")
    if not all(answer for _stop, answer in answers):
        die(f"left alone: {named(False)}; nothing was stopped, retired or started. "
            "Stop them yourself, or pass --yes")
    ended = []
    for stop, text in said:
        if end_holder(stop["process"], text, args, indent=prefix):
            ended.append(stop["process"]["pid"])
        elif not args.dry_run:
            die(f"{stop['agent_id']} is still running, so {selection['source']} was "
                "not retired and no member was started"
                + (f"; already ended: pid {', '.join(map(str, ended))}" if ended else ""))
    return tuple(ended)


def auto_redirect(ctx, args, prefix=""):
    """Apply Resolver's complete automatic member redirect answer.

    In a team run the redirect was decided and asked about once, before the
    first member (run_team), and this member's plan carries that decision out.
    """
    selection = getattr(args, "team_selection", None) or None
    plan = RESOLVER.member_redirect_plan(ctx, MemberRedirectRequest(
        kind="automatic", force=args.force, archive_mail=args.with_mail,
        keep_team=args.keep_team, team=selection,
        team_answer=getattr(args, "team_answer", None) if selection else None))
    if plan["objections"]:
        die("; ".join(plan["objections"]))
    if plan["action"] == "stay":
        if plan["arrived"]:
            return plan["arrived_launch"]
        if plan["declined"]:
            return plan["declined_launch"]
        if plan["reason"] == "the member is already running":
            process = plan["launch"]["process"]
            owner = process["snapshot"]["best_by_session"].get(
                plan["launch"]["session"])
            holders = list(plan["holder_processes"]) + list(
                process["runtime"]["external"])
            who = (f"pid {holders[0]['pid']}" if holders else
                   f"pid {owner['pid']} (registry)")
            diagnosis = process["diagnosis"]
            fix = "".join(
                f"\n- {what}  ({cost})" for what, cost in diagnosis["remedies"])
            warn(f"{plan['launch']['identity']['agentId']} is running as {who}: "
                 f"{diagnosis['reachable'][1]}{fix}")
            return plan["declined_launch"]
        return plan["launch"]
    if plan["action"] == "blocked":
        warn(f"{plan['launch']['identity']['agentId']} cannot follow its lead onto "
             f"{plan['proposed_destination']}:\n" + "\n".join(redirect_blockers(plan)))
        decline_unreachable(plan, args, prefix)
        return plan["declined_launch"]
    confirmed = confirm_redirect(plan, prefix)
    if not confirmed:
        return plan["launch"]
    print(f"{prefix}redirect the lead now runs as {plan['destination']}, not "
          f"{plan['source']}; launching with that identity (--keep-team to stay)")
    return apply_member_migration(
        plan, args, prefix=prefix, confirmation=confirmed)


def record_membership(ctx, args, pane, alive=True, claim=None):
    """Apply the complete persistence answer for one launched or live member."""
    if getattr(args, "bare", False):
        return None
    if args.no_update_config and not ctx["route"]["to_team"]:
        return None
    plan = RESOLVER.membership_plan(
        ctx, "record", pane=pane, alive=alive, claim=claim, backed_up=frozenset(_BACKED_UP))
    return apply_membership(plan, dry=args.dry_run)


def reserve_membership(ctx, args):
    """Apply the exact pre-launch claim selected from the launch answer."""
    if getattr(args, "bare", False):
        return None
    if args.no_update_config and not ctx["route"]["to_team"]:
        return None
    plan = RESOLVER.membership_plan(ctx, "reserve", backed_up=frozenset(_BACKED_UP))
    return apply_membership(plan, dry=args.dry_run)


def release_membership(claim, args):
    """Release only the unique persisted claim created by this launch."""
    if not claim:
        return
    try:
        plan = RESOLVER.membership_plan(
            claim["launch"], "release", claim=claim, backed_up=frozenset(_BACKED_UP))
        apply_membership(plan, dry=args.dry_run)
    except Refusal:
        warn(f"{claim['agent_id']} stays claimed in team {claim['team']} for a "
             "launch that did not happen; resuming that member again can inspect it")


def report_launch(ctx, command, prefix="", extra=(), restore=None):
    """The facts a launch reports, whichever way it launches.

    One block, because two kept by hand drift apart: a field living in only
    the member block leaves a lead to exec without ever printing its command.
    What genuinely differs between the paths is the
    mechanism - a pane and a socket, or taking over this terminal - so that
    is what `extra` carries, and everything common is answered here once.
    `restore` is Resolver's restore_answer for this launch, asked by the
    caller at the moment it reports.
    """
    identity = ctx["identity"]
    role = "lead" if identity["role"] == "lead" else "agent"
    agent_id = identity["agentId"]
    if not prefix:
        # A single-agent run separates its report from whatever warned above
        # it; a team run's [name] headers already do this.
        print()
    print(f"{prefix}{role:<8} {agent_id or '(unknown)'}")
    # The uuid alone, not the file it lives in. A transcript path is one token
    # fill() cannot break, so it stayed whole and ran far past every other row
    # here, and it only repeated the report: the file is named for the uuid on
    # this row, in a projects directory named for the cwd a few rows below.
    # --explain says which transcript each resolved field was read out of, and
    # names it by this same uuid.
    print(f"{prefix}session  {ctx['session']}")
    print(f"{prefix}via      {ctx['via']}")
    if ctx.get("placement"):
        print(fill(f"{prefix}team     {ctx['placement']['team']}  "
                   f"({ctx['placement']['why']})"))
    title = bounded_title(title_value(ctx["transcript"].get("title")), 100)
    if title:
        print(fill(f"{prefix}title    {title}"))
    for label, value in extra:
        print(fill(f"{prefix}{label:<8} {value}"))
    # Read off the command rather than a flag, so the row describes the launch
    # actually being reported. Passing no identity is not the same as having
    # none: when the first record of a conversation's restored window carries
    # stamps, the harness adopts them on the way up, and a reader who typed
    # --bare has every reason to expect otherwise.
    if "--agent-id" not in command:
        said = "no team, name, model or effort is passed"
        if restore and restore["state"] == "restored":
            said += (f"; the harness still brings it back as {restore['team']}, "
                     "from its own stamps")
        print(fill(f"{prefix}identity {said}"))
    print(wrap_command(command, f"{prefix}command  ", f"{prefix}{'':11}", paste=True))
    # The facts end here and the doing starts. Without the gap the two run
    # together as one wall, and the report is long enough that a reader needs
    # to be told where to stop reading facts.
    print()


def clear_lead_holder(migration, args, prefix=""):
    """Stop current holders before lead migration and return clearance status.

    Stopping the holder first preserves one transcript writer and removes that
    process from later team-retirement objections. Dry-run reports the stop and
    returns the expected cleared state.
    """
    holders = migration["holders"]
    others, ours = holders["others"], holders["ours"]
    if ours:
        die(f"you are running this transcript yourself (pid {ours[0]['pid']}); process "
            "replacement requires an external caller. Run this from another "
            "terminal, or exit that session first")
    cleared = True
    for process in others:
        # A dry run named the kill and did nothing, which is the preview of a
        # run that would have cleared it; a real kill that did not work has
        # already said so, and leaves the guard below to stop the run.
        cleared = (kill_holder(process, "", args, indent=prefix + "  ")
                   or args.dry_run) and cleared
    return cleared


def apply_member_migration(plan, args, prefix="", confirmation=True):
    """Apply only the holders and durable action selected by a redirect plan."""
    launch = plan["redirected_launch"]
    holders = plan["holders"]
    if holders["ours"]:
        pid = holders["ours"][0]["pid"]
        die(f"you are running this transcript yourself (pid {pid}); nothing can "
            "replace a process from inside it. Exit first, or have the lead run this")
    if plan["action"] == "blocked":
        rebind_reap(plan["rebind"], args, prefix)
    if not args.dry_run:
        checked = RESOLVER.revalidate_member_redirect(
            plan, confirmation=confirmation)
        if not checked["matches"]:
            die("the selected member redirect generations changed ("
                + ", ".join(checked["changed"])
                + "); no holder was stopped. Run the command again")
    cleared = True
    socket = (launch["destination"].socket if launch.get("destination") else None)
    for holder in holders["others"]:
        seat = holder["seat"]
        where = (f" in pane {seat.pane} on {seat.socket}" if seat else
                 f" outside {socket}" if socket else "")
        cleared = (kill_holder(holder, where, args, indent=prefix)
                   or args.dry_run) and cleared
    if holders["others"] and not cleared:
        die("a selected transcript holder is still running; nothing was retired "
            "or rewritten")
    if holders["others"] and not args.dry_run:
        checked = RESOLVER.revalidate_member_redirect(
            plan, confirmation=confirmation, after_clear=True)
        if not checked["matches"]:
            die("the member redirect changed after its selected holder was stopped ("
                + ", ".join(checked["changed"])
                + "); nothing was retired or rewritten")
    durable_result = (rebind_reap(
        plan["rebind"], args, prefix)
                      if plan["rebind"] else None)
    durable_action = {
        "reaped": "reap", "restamped": "restamp", None: None,
    }.get(durable_result, durable_result)
    applied = Applied(
        operation="member-redirect", plan=plan,
        confirmation=bool(confirmation),
        holders_cleared=tuple(row["pid"] for row in holders["others"]),
        durable_action=durable_action,
        dry_run=args.dry_run)
    completed = RESOLVER.complete_member_migration(applied)
    if not completed["matches"]:
        die("the selected member redirect effects do not match ("
            + ", ".join(completed["changed"]) + ")")
    return completed["launch"]


def lead_crew_lines(migration, prefix=""):
    """Render crew and inbox facts already retained by a migration plan."""
    said = []
    for member in migration["crew"]:
        state = member["membership"][0]
        live = member["runtime"]["records"]
        said.append(f"{member['name']} ({state}"
                    + (f", running as pid {live[0]['pid']}" if live else "") + ")")
    source, dest = migration["source"], migration["dest"]
    if said:
        lines = [f"crew     {len(said)} {'stays' if len(said) == 1 else 'stay'} "
                 f"on {source}: " + ", ".join(said)]
    else:
        lines = [f"crew     source team {source} has zero other members"]
    for name, (count, oldest) in sorted(migration["inbox"].items()):
        if count is None:
            lines.append(f"mail     {name}'s inbox is {oldest}; it stays where it is")
        elif count:
            lines.append(f"mail     {count} waiting for {name} on {source}, "
                         f"oldest {said_when(oldest)}; delivery remains on the source team")
    move = migration["crew_move"]
    if said and move is not None:
        # The planner's decision for moving the crew, so this offers the move
        # only as it would be made, with the flags it needs.
        if move["flags"] is not None:
            lines.append(f"remedy   {' '.join((TOOL, source, '--into-team', dest, '--all') + move['flags'])}"
                         f" moves them onto {dest} once this lead runs as it, asking "
                         "before it ends each running one")
        else:
            lines.append(f"note     {move['refusal']}")
        lines.append(f"remedy   --keep-team on each member starts it on {source}, "
                     "where this lead will not read its mail")
    return tuple(fill(f"{prefix}{line}") for line in lines)


def lead_rebind(migration, args, prefix=""):
    """Apply only the holder and durable actions selected for lead migration."""
    source = migration["source"]
    if migration["rebind"] and migration["rebind"]["action"] == "blocked":
        rebind_reap(migration["rebind"], args, prefix)
    if not args.dry_run:
        checked = RESOLVER.revalidate_lead_migration(migration)
        if not checked["matches"]:
            die("the selected lead migration generations changed ("
                + ", ".join(checked["changed"])
                + "); no holder was stopped. Run the command again")
    cleared = clear_lead_holder(migration, args, prefix)
    if migration["holders"]["others"] and not cleared:
        die("the selected transcript holder is still running; nothing was retired "
            "or rewritten")
    if migration["holders"]["others"] and not args.dry_run:
        checked = RESOLVER.revalidate_lead_migration(
            migration, after_clear=True)
        if not checked["matches"]:
            die("the lead migration changed after its selected holder was stopped ("
                + ", ".join(checked["changed"])
                + "); nothing was retired or rewritten")
    crew = lead_crew_lines(migration, prefix)
    durable_result = (rebind_reap(
        migration["rebind"], args, prefix)
                      if migration["rebind"] else None)
    for line in crew:
        print(line)
    if durable_result == "reaped":
        print(fill(f"{prefix}note     their conversations still restore with stamps "
                   f"naming {source}, which has no roster. Plain resume starts a "
                   f"plain session; {TOOL} reapplies member identity flags"))
    elif durable_result == "restamped":
        print(fill(f"{prefix}note     {source} keeps its roster, its mail and its "
                   "members; this conversation is the only thing that moved"))
    durable_action = {
        "reaped": "reap", "restamped": "restamp", None: None,
    }.get(durable_result, durable_result)
    applied = Applied(
        operation="lead-migration", plan=migration, confirmation=True,
        holders_cleared=tuple(
            row["pid"] for row in migration["holders"]["others"]),
        durable_action=durable_action, dry_run=args.dry_run)
    completed = RESOLVER.complete_lead_migration(applied)
    if not completed["matches"]:
        die("the selected lead migration effects do not match ("
            + ", ".join(completed["changed"]) + ")")
    return completed["launch"]


def in_team_run(args):
    """Whether this step belongs to a team run, which carries the run's decision.

    That decision is the only authority over which team directories exist
    while the run lasts: run_team rebuilds before the first step or retires
    once, and no step rebuilds or creates a team itself.
    """
    return getattr(args, "team_selection", None) is not None


def run_one(args, passthrough, table, prefix="", pending=(), terminal=None):
    """Resume one agent. Returns Outcome(status, socket, is_lead), status being
    'noop' | 'launched' | 'manual' | 'failed'.

    The socket is whichever server this agent ended up on, or None when it never
    reached one. Only this function knows which, and an agent that noops still
    has a pane worth attaching to, so the caller is told rather than left to
    read it off a field set partway through.

    A refusal is left to propagate. Whether one agent's refusal ends the run is
    a question about the batch, not about this agent, so run_agents answers it.
    """
    supplied_census = getattr(args, "roster_census", None)
    ctx = build(
        args, table, supplied_census if isinstance(supplied_census, tuple) else None,
        terminal=terminal)
    agent_id = ctx["identity"]["agentId"]

    # A requested member destination is selected as one complete redirect answer
    # before explanations, command construction, or persistence can read it.
    member_redirect = None
    if args.to_team and ctx["identity"]["role"] != "lead":
        # In a team run the team's decision was made once, before this member.
        selection = getattr(args, "team_selection", None) or None
        request = MemberRedirectRequest(
            kind="live" if args.to_team in ("live", "auto") else "explicit",
            destination=(None if args.to_team in ("live", "auto")
                         else args.to_team),
            force=args.force, archive_mail=args.with_mail, team=selection,
            team_answer=getattr(args, "team_answer", None) if selection else None)
        member_redirect = RESOLVER.member_redirect_plan(ctx, request)
        if member_redirect["objections"]:
            die("; ".join(member_redirect["objections"]))
        if member_redirect["arrived"]:
            ctx = member_redirect["arrived_launch"]
        else:
            if request.kind == "live":
                print(f"rebind   {member_redirect['reason']}, now running as team "
                      f"{member_redirect['destination']}")
            ctx = member_redirect["redirected_launch"]
        agent_id = ctx["identity"]["agentId"]

    note_cwd(ctx)

    # Lead recovery runs as the interactive foreground session. The next lead's
    # exit cleanup targets pane members, so this path emits no member pane or
    # roster patch.
    if agent_id and ctx["identity"]["role"] == "lead":
        # Only --into-team moves a lead. A team named inside an agent id says
        # which lead this is; when the stamps disagree, enforce_identity refuses
        # and names --into-team as the move. When one is asked for, Resolver
        # selects the destination identity, crew, holders, durable action, and
        # launch placement together before the command is rendered.
        migration, taking_over = None, False
        if args.to_team:
            migration = RESOLVER.lead_migration_plan(
                ctx, LeadMigrationRequest(
                    destination=args.to_team,
                    force=args.force, archive_mail=args.with_mail))
            if migration["objections"]:
                die("; ".join(migration["objections"]))
            ctx = migration["launch"]
            agent_id = ctx["identity"]["agentId"]
            taking_over = migration["taking_over"]
        if args.explain:
            explain(ctx)
        command = build_command(ctx, args, passthrough)
        # A lead is the socket's namesake - a swarm server is named after the
        # lead's pid, and members resolve theirs by asking who their lead is -
        # so where its crew already sits is a launch fact for the lead too.
        # Becoming the lead makes this process that pid, which is why the line
        # says which server the crew is on rather than which one it will own.
        crew = ctx["process"]["crew"]
        crew_socket = crew.destination.socket if crew.destination else None
        seat = [("cwd", ctx["cwd"] or "(inherit)")]
        if crew_socket:
            seats = crew.by_socket
            # A lead can sit across several servers at once, because becoming
            # one gives this process a new pid and the next spawn creates a
            # server named after it. Naming one of them as the socket would be
            # a half-answer; the rest are named too, with what is on them.
            elsewhere = {s: who for s, who in seats.items() if s != crew_socket}
            seat.insert(0, ("socket", f"{crew_socket}  [{crew.provenance}] "
                                      f"({ctx['socket_states'].get(crew_socket, 'unresolved')})"))
            for other, who in sorted(elsewhere.items()):
                seat.insert(1, ("also", f"{other} hosts {', '.join(who)} "
                                        f"({ctx['socket_states'].get(other, 'unresolved')})"))
        report_launch(ctx, command, prefix, extra=seat,
                      restore=RESOLVER.restore_answer(ctx))
        if taking_over:
            ctx = lead_rebind(migration, args, prefix)
        else:
            running = already_running(ctx, args)
            if running:
                return noop_outcome(ctx, args, prefix, why=running[0])
        # The remaining path launches the lead, so identity validation runs here.
        enforce_ctx(ctx, args)
        # Validate the executable before roster reconstruction so a missing binary
        # leaves team state unchanged.
        if not args.dry_run and not shutil.which(command[0]):
            die(f"cannot exec {command[0]}: not found or not executable")
        # Flag-bound lead startup reads the destination roster. Reconstruct that
        # roster before exec, using the explicit destination after migration;
        # in a team run the run already did, before its first step.
        if not in_team_run(args):
            ctx, _rebuilt = rebuild_team(ctx, args.dry_run, assume_yes=args.yes)
        # Members launch before the lead. The foreground process then becomes the
        # interactive lead from the resolved cwd so --resume finds its transcript.
        if sys.stdout.isatty() and not args.dry_run:
            # Exec ends transcript-wait reporting, so print pending members before
            # replacement. Waiting here could delay the foreground lead by 45 seconds.
            if pending:
                names = ", ".join(label for label, _path, _since in pending)
                print(f"{prefix}loading  {len(pending)} member transcript(s) remained pending "
                      f"at takeover: {names}")
            print(f"{prefix}exec     taking over this terminal")
            # Roster reconstruction writes inactive member entries needed for retry,
            # so lead exec failure preserves that directory and reports the exec error.
            become_agent(ctx, command, prefix)
        print(f"{prefix}run this in your terminal (lead launches are interactive):")
        # still pastes as one command however it wrapped; the env prefix is
        # part of the command, because the shell this lands in may not export
        # what the identity flags need to bind
        print(wrap_command(env_prefixed(command), f"{prefix}  ", f"{prefix}    ", paste=True))
        return Outcome("manual", None, True, None)

    if not args.to_team:
        ctx = auto_redirect(ctx, args, prefix)
    if ctx["route"]["arrived"]:
        # The run's decision found it already running as the team its lead
        # runs as: nothing is started, and it is registered where it runs.
        records = (ctx["process"]["runtime"] or {}).get("records", ())
        seat = next((row["seat"] for row in records if row["seat"]), None)
        pids = ", ".join(str(row["pid"]) for row in records)
        return noop_outcome(
            ctx, args, prefix, socket=seat.socket if seat else None,
            pane=seat.pane if seat else None, report=True,
            why=f"{ctx['identity']['agentName']} already runs as {ctx['identity']['agentId']}"
                + (f" (pid {pids})" if pids else "") + ", where its lead reads")
    # The redirect is decided before any roster is rebuilt: a member that
    # follows its lead elsewhere leaves its source team as it is, so a rebuild
    # here would only make the stamps restore it there again. A team run
    # decided which team directories exist before its first step, so no step
    # of it rebuilds one.
    if not (args.to_team or ctx["route"]["member_moving"] or in_team_run(args)):
        ctx, _rebuilt = rebuild_team(ctx, args.dry_run, assume_yes=args.yes)

    agent_id = ctx["identity"]["agentId"]
    if args.explain:
        explain(ctx)

    if args.here:
        # A member given this terminal takes the lead's route: exec, so the
        # process becomes the agent. No seat is resolved because none is used,
        # and nothing after this point in the run happens.
        command = build_command(ctx, args, passthrough)
        selected_credentials = credential_names(ctx)
        cwd = ctx["cwd"]
        seat = [("runs", terminal_note(ctx["terminal"])),
                ("cwd", cwd or "(inherit)")]
        if selected_credentials:
            seat.append(("creds", f"will inherit {', '.join(selected_credentials)} "
                         "from the selected lead"))
        report_launch(ctx, command, prefix, extra=seat,
                      restore=RESOLVER.restore_answer(ctx))
        if args.to_team and member_redirect["action"] != "stay":
            ctx = apply_member_migration(
                member_redirect, args, prefix=prefix, confirmation=True)
        running = already_running(ctx, args)
        if running:
            return noop_outcome(ctx, args, prefix, why=running[0], report=running[1])
        enforce_ctx(ctx, args)
        # Check what we are about to run before writing anything, the same order
        # the lead path takes: writing the roster first and finding the binary
        # unusable second lists a member for a launch that never happened, and
        # this exit is not one the rollback below can reach.
        if not args.dry_run and not shutil.which(command[0]):
            die(f"cannot exec {command[0]}: not found or not executable")
        # Listed with no pane: a member that is running and reachable, which a
        # later team run places in a pane like any other. What that write found
        # is kept, because nothing from here on is certain to start the agent.
        undo = record_membership(ctx, args, None)
        # One line, both tenses, so the preview cannot drift from the act.
        print(f"{prefix}exec     this terminal "
              f"{'would become' if args.dry_run else 'becomes'} {agent_id}")
        if args.dry_run:
            return Outcome("manual", None, False, None)
        inherit_credentials(ctx)
        become_agent(ctx, command, prefix, undo=undo)

    for warning in ctx["destination_warnings"]:
        warn(warning)
    destination = ctx["destination"]
    if not destination:
        warn("could not determine a tmux socket; pass --socket claude-swarm-<lead-pid>")
        return Outcome("failed", None, False, None)
    socket = destination.socket
    how = ctx["destination_provenance"]
    pane_reference = ctx["pane_reference"]
    want_pane, pane_said = destination.pane, roster_pane_note(pane_reference)
    cwd = ctx["cwd"]

    command = build_command(ctx, args, passthrough)
    selected_credentials = credential_names(ctx)

    seat = [("socket", f"{socket}  [{how}] "
                        f"({ctx['socket_states'].get(socket, 'unresolved')})"),
            ("pane", pane_said),
            ("cwd", cwd or "(inherit)")]
    if selected_credentials:
        seat.append(("creds", f"will inherit {', '.join(selected_credentials)} "
                     "from the selected lead"))
    report_launch(ctx, command, prefix, extra=seat,
                  restore=RESOLVER.restore_answer(ctx))
    if args.to_team and member_redirect["action"] != "stay":
        ctx = apply_member_migration(
            member_redirect, args, prefix=prefix, confirmation=True)

    # Same agent already in that pane -> nothing to do. Anything else in it -> new pane.
    pane_rows = (ctx["process"]["snapshot"]["by_seat"].get(
        Seat(socket, want_pane), ()) if want_pane else ())
    occupants = [(row["pid"], row["args"]) for row in pane_rows
                 if row["is_claude"]]
    # The strangers half only: this sorts the pane's occupants into "this agent"
    # and "somebody else" to decide whether to reuse the pane or take a new one,
    # and our own lineage is neither of those to a launch.
    agent_runtime = ctx["process"]["runtime"] if agent_id else None
    worn = {row["pid"] for row in (agent_runtime or {}).get(
        "external", ())}
    here = [pid for pid, _cmd in occupants if pid in worn]
    others = [pid for pid, _ in occupants if pid not in here]

    holder_runtime = ctx["process"]["holders"]
    held_by_us = holder_runtime["ours"]
    if held_by_us and not args.force:
        die(f"you are running this transcript yourself (pid {held_by_us[0]['pid']}); "
            "nothing can replace a process from inside it. Exit first, or have "
            "the lead run this")

    replace_pane = None
    # One step for every way this agent could already be alive: in this pane,
    # holding the transcript, or wearing this id elsewhere.
    running = already_running(ctx, args, here=here, pane=want_pane)
    if running:
        why, report = running
        if report and not args.no_tint:
            tint_pane(socket, want_pane, ctx["settings"].get("color"),
                      ctx["identity"]["agentName"], args.dry_run)
        return noop_outcome(ctx, args, prefix, socket=socket, pane=want_pane,
                            report=report, why=why)
    if others and not replace_pane:
        warn(f"pane {want_pane} runs a different claude (pid {', '.join(map(str, others))}); using a new pane")

    # Every guard that could still turn this into a noop has passed, so the run
    # is about to act and identity validation applies.
    enforce_ctx(ctx, args)

    # Already standing in the right place: run the agent in this pane instead of
    # splitting a new one and leaving the shell we were invoked from idle beside
    # it. Bookkeeping has to happen first, since exec never returns.
    current_seat = ctx["terminal"].seat
    in_socket = current_seat.socket if current_seat else None
    in_pane = current_seat.pane if current_seat else None
    # Never when a tool is driving (its shell would be swallowed), never inside
    # --team (the loop would end), and never when a live holder has to be killed
    # first: exec cannot respawn the pane, so that case belongs to launch().
    if (in_socket == socket and in_pane and not replace_pane
            and not getattr(args, "in_team", False) and not os.environ.get("CLAUDECODE")):
        if in_pane == want_pane or pane_reference.state != "present":
            print(f"{prefix}exec     you are in {in_pane} on {socket}; running here rather than splitting")
            # The same roster write every other launch makes, through the one
            # function that decides which roster a member belongs in. A second
            # copy of that routing lived here and had already drifted: it wrote
            # the destination on a rebind and rolled the source back, so a
            # failed exec left the destination claiming a live member.
            undo = record_membership(ctx, args, in_pane)
            rendered = f"exec in {cwd or os.getcwd()}: {' '.join(shlex.quote(c) for c in command)}"
            step(args.dry_run, f"would {rendered}", rendered, indent=prefix)
            if args.dry_run:
                return Outcome("launched", socket, False, None)
            if not args.no_tint:
                tint_pane(socket, in_pane, ctx["settings"].get("color"), ctx["identity"]["agentName"], False)
            inherit_credentials(ctx)
            become_agent(ctx, command, prefix, undo=undo)

    try:
        launched_at = ctx["transcript"]["path"].stat().st_mtime
    except OSError:
        launched_at = 0.0
    # Validate every retained launch fact before the roster claim and again
    # immediately before tmux. The report names exactly what changed.
    if not args.dry_run:
        checked = RESOLVER.revalidate_launch(ctx)
        if not checked["matches"]:
            die("the selected launch facts changed before the roster claim ("
                + ", ".join(checked["changed"])
                + "); nothing was written. Run the command again")
    claimed = reserve_membership(ctx, args)
    try:
        if not args.dry_run:
            checked = RESOLVER.revalidate_launch(ctx)
            if not checked["matches"]:
                release_membership(claimed, args)
                die("the selected launch facts changed before launch ("
                    + ", ".join(checked["changed"])
                    + "); the roster claim was released. Run the command again")
            inherit_credentials(ctx)
        launched_seat, action = launch(
            ctx["launch_action"], cwd, command, args.dry_run, replace_pane)
        pane = launched_seat.pane if launched_seat else None
    except LaunchFailed as exc:
        # A member's pane is that member's problem. The run continues, so the
        # summary, the flag check and the write report still reach every agent
        # that did launch. The claim goes back first: nothing started, so the
        # roster must not be left describing a member that never existed.
        release_membership(claimed, args)
        warn(f"{prefix}{ctx['identity']['agentId']} did not launch: {exc}")
        return Outcome("failed", socket, False, None)
    # At the steps' indent, not flush left: this is one of the things the launch
    # did, and a launch that alternates between two margins reads as two
    # interleaved reports rather than one sequence.
    print(fill(f"{prefix}  {'would run' if args.dry_run else 'running'} in pane "
               f"{pane or '<new>'} ({action})"))
    if not args.no_tint:
        tint_pane(socket, pane, ctx["settings"].get("color"), ctx["identity"]["agentName"], args.dry_run)

    alive, wrote = True, True
    if not args.dry_run:
        alive, why = launch_survived(
            launched_seat, ctx["identity"]["agentId"],
            ctx["transcript"]["path"], launched_at)
        wrote = alive and why == "wrote to its transcript"
        if alive:
            print(f"{prefix}alive    {why}")
        else:
            warn(f"the launch in pane {pane} is not running: {why}; recording it as inactive")

    record_membership(ctx, args, pane, alive, claim=claimed)

    # A launch that has not written yet is not a verdict, only an unfinished
    # observation: the settle window is a second and a half and a healthy agent
    # takes tens of seconds to load a large session. Hand it back so the run can
    # answer it at the end rather than leaving "not yet" as the last word.
    unwritten = ((ctx["identity"]["agentId"] or ctx["session"][:8],
                  ctx["transcript"]["path"], launched_at) if alive and not wrote else None)
    # Kept for a launch that looked dead too: it may only have been slow, and
    # whatever comes up in that pane later is still this run's process.
    return Outcome("launched" if alive else "failed", socket, False, unwritten,
                   started_in=launched_seat)


def render_transcript_row(stem, fact=None, note=None, completion=False, limit=None,
                          report_label=None, report_title_label=None, width=None):
    """One transcript row, shared by listings, completion, refusals, and reports."""
    if completion and report_label is not None:
        raise ValueError("a transcript row cannot be completion and report output")
    if report_title_label is not None and report_label is None:
        raise ValueError("a report title label needs a report stem label")
    report = report_label is not None
    if limit is None:
        limit = REPORT_TRANSCRIPT_TITLE if report else COMPLETION_TITLE
    where = None
    if fact:
        path = fact["path"]
        when = ms_str(fact["mtime"]) if fact.get("mtime") else "missing"
        raw_title = title_value(fact.get("title"))
        title = (clip(raw_title, limit) if report else bounded_title(raw_title, limit))
        where = f"{path.parent.name}, {when}"
        if report:
            desc = title or ""
        else:
            desc = f"{title}  [{where}]" if title else where
    else:
        desc = "transcript not found"
    if note:
        desc = f"{note}; {desc}" if desc else note
    if report:
        trailer = f"[{where}]" if where else None
        if report_title_label is not None:
            stem_row = render_labeled_row(report_label, stem, width=width)
            title_row = render_labeled_row(
                report_title_label, desc or "(no title)", trailer=trailer,
                width=width)
            return RenderedLine(f"{stem_row}\n{title_row}")
        value = f"{stem}: {desc}" if desc else f"{stem}:"
        return render_labeled_row(
            report_label, value, trailer=trailer, width=width)
    separator = ":" if completion else "  "
    return f"{stem}{separator}{desc}"


def completion_request(topic):
    """(kind, subject or None) for one completion request string."""
    kind, separator, subject = topic.partition(":")
    return kind, subject if separator else None


def run_complete(topic):
    """Candidates on stdout, and nothing on stderr.

    This runs on every TAB. A warning here lands in the middle of whatever the
    user is typing, and the conditions that produce one (an uncorroborated
    claimant, a stale roster) are the ordinary state of the corpus rather than
    anything a completion should interrupt to report.
    """
    with capturing("err"):
        return _complete(topic)


def render_completion_answer(answer):
    """Format semantic completion rows without reading or joining evidence."""
    topic = answer["topic"]
    lines = []
    if topic == "flags":
        return tuple(
            f"{entry['option']}\t{entry['description']}\t"
            f"{entry['completer']}\t{entry['value']}"
            for entry in answer["entries"])
    if topic == "as-agent-name":
        return tuple(entry["name"] for entry in answer["entries"])
    if topic == "as-agent":
        return tuple(f"{entry['agent_id']}:{entry['description']}"
                     for entry in answer["entries"])
    if topic == "into-session":
        return tuple(render_transcript_row(
            entry["stem"], entry["fact"], entry["note"], completion=True)
            for entry in answer["entries"])
    if topic == "selector":
        for grouped in answer["entries"]:
            rendered = render_completion_answer(grouped["answer"])
            if grouped["group"] == "names":
                lines.extend(rendered)
            else:
                lines.extend(f"{grouped['group']}\t{line}" for line in rendered)
        return tuple(lines)
    if topic == "sockets":
        return tuple(
            f"{entry['socket']}:{entry['state']}, {ms_str(entry['mtime'])}"
            for entry in answer["entries"])
    if topic == "sessions":
        return tuple(render_transcript_row(
            entry["stem"], entry["fact"], completion=True)
            for entry in answer["entries"])
    if topic == "sides":
        return tuple(
            f"{entry['parent'][:8]}/{entry['name']}:"
            f"{entry['grammar']}, {ms_str(entry['mtime'])}"
            for entry in answer["entries"])
    if topic == "agent-ids":
        return tuple(
            f"{entry['agent_id']}\tjoined {ms_str(entry['joined'])}\t"
            f"{'' if NO_COLOR else COLOR_ANSI.get(entry['colour'], '')}"
            for entry in answer["entries"])
    if topic == "teams":
        for entry in answer["entries"]:
            description = entry["description"]
            line = render_team_line(
                bounded_title(title_value(
                    (description["lead_fact"] or {}).get("title")),
                    COMPLETION_TITLE),
                description["count"], ms_str(description["activity"]),
                description["standing"])
            lines.append(f"{entry['team']}:{line}")
        return tuple(lines)
    if topic == "leads":
        for entry in answer["entries"]:
            description = entry["description"]
            title = bounded_title(title_value(
                (description["lead_fact"] or {}).get("title")),
                COMPLETION_TITLE)
            if entry["rostered"]:
                joined = f"joined {ms_str(entry['joined'])}"
                detail = title + ", " + joined if title else joined
            else:
                detail = (f"{title}, no roster" if title else
                          f"no roster, found by {entry['evidence']}")
            lines.append(f"{entry['agent_id']}\t{detail}\t")
        return tuple(lines)
    if topic == "names":
        for entry in answer["entries"]:
            group = entry["group"]
            label = f"{group['team']}  {ms_str(group['activity'])}"
            if group["standing"]:
                label += f", {group['standing']}"
            title = bounded_title(entry["title"], COMPLETION_TITLE)
            stamp = (f"joined {ms_str(entry['when'])}" if entry["listed"]
                     else f"last active {ms_str(entry['when'])}")
            detail = f"{title}, {stamp}" if title else stamp
            colour = ("" if NO_COLOR else
                      COLOR_ANSI.get(entry["colour"], ""))
            lines.append(
                f"names\t{group['team']}\t{label}\t{entry['agent_id']}\t"
                f"{detail}\t{colour}")
        return tuple(lines)
    return ()


def _complete(topic):
    """Print one complete Resolver completion answer."""
    answer = RESOLVER.completion_answer(topic)
    objection = answer.get("objection")
    if objection:
        die(objection)
    for line in answer["rows"]:
        print(line)
    return 0


SOCKET_GRACE_S = 60  # preserve new sockets while their server may still be binding


def cleanup_sockets(plan, dry=False):
    """Remove only the dead socket generations selected by cleanup_plan."""
    removed = []
    for record in plan["dead_sockets"]:
        path = record["path"]
        if dry:
            removed.append(path.name)
            continue
        try:
            path.unlink()
            removed.append(path.name)
        except OSError as exc:
            warn(f"cannot remove {path}: {exc}")
    return removed


# Team-directory creation precedes registry, spawn, and process evidence. This
# short grace period covers that publication interval.
TEAM_GRACE_S = 300

# Descriptions in completion have a whole terminal row to themselves.
COMPLETION_TITLE = 400
# A dossier carries several facts below one agent. Its transcript title identifies
# the work without taking over the report the way a completion-sized title can.
REPORT_TRANSCRIPT_TITLE = 160
# The abort listing is read under time pressure, with a finger on a key, so it
# gets a glance-sized title rather than the completion menu's paragraph.
ABORT_TITLE = 60
NO_COLOR = False  # zsh truncates to the real terminal width


def sweep_dead_lock(action, dry):
    """Remove the exact stale lock selected for one kept team."""
    lock = action["lock"]
    owner = lock["owner"]
    if not lock["gone"]:
        return None
    said = f"{action['team']} (pid {owner['pid']}, which is gone)"
    if dry:
        return said
    took, stuck = drop_lock(lock["path"], lock["seen"])
    if stuck:
        warn(f"cannot remove {lock['path']}: {stuck}")
    return said if took else None


def remove_cleanup_action(action, dry):
    """Remove one exact team-directory generation selected by cleanup_plan."""
    path = action["team_dir"]
    if dry:
        return True
    staged = staged_path(path)
    try:
        os.rename(path, staged)
    except OSError as exc:
        warn(f"cannot stage {path} for removal: {exc}")
        return False
    checked = RESOLVER.revalidate_cleanup_cut(action, staged)
    if not checked["matches"]:
        try:
            os.rename(staged, path)
            warn(f"not removing {path.name}: its contents changed after selection")
        except OSError as exc:
            warn(f"{path.name} changed and restoring it failed: {exc}; it is at {staged}")
        return False
    try:
        owned = [staged / relative for relative in action["owned"]]
        for item in sorted(owned, key=lambda value: value.name == "config.json"):
            item.unlink()
        inboxes = staged / "inboxes"
        if inboxes.is_dir():
            inboxes.rmdir()
        staged.rmdir()
    except OSError as exc:
        warn(f"cannot remove {staged}: {exc}")
        return False
    tasks = action["tasks_dir"]
    if tasks.is_dir():
        try:
            tasks.rmdir()
        except OSError:
            pass
    return True


def cleanup_teams(plan, dry=False):
    """Apply the selected keep, stale-lock, and removal actions."""
    removed, kept, locks = [], [], []
    for action in plan["team_actions"]:
        if action["action"] == "keep":
            kept.append((action["team"], action["reason"]))
            cleared = sweep_dead_lock(action, dry)
            if cleared:
                locks.append(cleared)
            continue
        if remove_cleanup_action(action, dry):
            removed.append(action["team"])
    return removed, kept, locks


def run_agent_dossier(member, shared=None):
    """Print one completed canonical member record without reading evidence."""
    agent_id = member["agent_id"]
    if not agent_id or "@" not in str(agent_id):
        die("an agent dossier needs name@team")
    print(render_doctor_identity("agent", member))
    resolution = member["resolution"]
    transcript = member["resolution"].transcript
    stem = transcript["session"] if transcript else "(none)"
    note = resolution.reason if resolution and not transcript else None
    print(render_transcript_row(
        stem, transcript, note=note, report_label="session",
        report_title_label="title"))
    parent = member["parent"]
    print(render_transcript_row(
        parent["stem"] or "(none)", parent["fact"], note=parent["note"],
        report_label="parent"))
    # Runtime resolves every process and Seat together. The roster's recorded pane
    # is not used here because a process may have moved or may run outside tmux.
    runtime = member["runtime"]
    rows = runtime["records"]
    if not rows:
        seat_text = "none"
    else:
        parts = []
        for row in rows:
            seat = row["seat"]
            place = (f"pane {seat.pane} on {seat.socket}"
                     if seat else "outside tmux")
            inside = ", which this command is running inside" if row["ours"] else ""
            parts.append(f"{place} (pid {row['pid']}{inside})")
        seat_text = "; ".join(parts)
    print(render_labeled_row("seat", seat_text))

    shared = shared or {}
    if member["polls"] != shared.get("polls"):
        said = {True: "yes", False: "no", None: "unknowable"}[member["polls"][0]]
        print(render_labeled_row("polls", f"{said}  ({member['polls'][1]})"))
    if member["reachable"] != shared.get("reachable"):
        reachable, why = member["reachable"]
        verdict = {True: "reaches its lead at its next turn boundary",
                   False: "does not reach its lead",
                   None: "may not reach its lead"}[reachable]
        print(render_labeled_row("mail", f"{verdict}: {why}"))

    if member["fragile"]:
        print(render_labeled_row("fragile", member["fragile"]))
    held_count = sum(row["state"] == "in memory" for row in member["ledger"])
    lost = sum(row["state"] == "unexplained" for row in member["ledger"])
    if held_count or lost:
        print(render_labeled_row(
            "ledger", f"{held_count} in its memory, {lost} unexplained, of "
            f"{len(member['ledger'])} sends addressed to it"))
    shared_remedies = set(shared.get("remedies", ()))
    for what, cost in member["remedies"]:
        if (what, cost) not in shared_remedies:
            print(render_labeled_row("remedy", f"{what}  ({cost})"))
    return 0


def doctor_member_labels(member):
    """Explicit membership and runtime labels from one canonical member."""
    processes = member["runtime"].get("records") or ()
    labels = (["requested"] if member["requested"] else [])
    labels.append(member["membership"][0])
    labels.append("running" if processes else "stopped")
    if len(processes) > 1:
        labels.append(f"{len(processes)} processes")
    return tuple(labels)


def render_doctor_identity(label, member, suffix=None, width=None):
    """One consistently ordered, coloured, and explicitly labelled agent."""
    labels = " ".join(f"[{value}]" for value in doctor_member_labels(member))
    detail = labels + (f"  {suffix}" if suffix else "")
    return render_identity_labeled_row(
        label, member["agent_id"], detail,
        colour=member["colour"], width=width)


# What each verdict claims, in the order of how much is wrong.
DOCTOR_LEGEND = (
    # Only what the verdict tests. Mail waiting in a mailbox does not demote a
    # team when its lead is live and reading it, and an unrecorded member is a
    # note rather than a fault, so claiming either here would describe a state
    # this verdict never asked about.
    ("CONNECTED", "a live lead runs this team and reads its mail, and nothing here needs a person"),
    ("DEGRADED", "nothing is lost yet, but a person must act: the team is dormant, "
                 "one agent is worn by two processes, or the crew sits on two servers"),
    ("UNKNOWABLE", "a plain lead reads the roster from its own memory, which cannot be "
                   "seen from outside"),
    ("SEVERED", "members are running or mail is waiting, and no live lead reads this team"),
)

# Colour restates a verdict for a glance; the word itself stays the carrier.
VERDICT_SGR = {"CONNECTED": "32", "DEGRADED": "33", "UNKNOWABLE": "36", "SEVERED": "31"}


def undelivered_mail_lines(rows):
    """Report lines for the ledger states a mailbox file cannot show.

    The inbox file is pruned the moment a busy recipient queues mail into
    memory, so the file's silence proves nothing; these lines carry the two
    states only the send-vs-delivery join can see. The counts are
    per-recipient facts and stay per-recipient; the delivery rule is shared
    and is said once, however many recipients hold mail.
    """
    out = []
    label_width = REPORT_LABEL_WIDTH + 2
    held = collections.Counter(r["to"] for r in rows if r["state"] == "in memory")
    if held:
        counts = ", ".join(f"{count} in {to}'s memory"
                           for to, count in held.most_common())
        out.append(render_labeled_row(
            "  mail", counts,
            trailer="delivery waits on each holder's next turn boundary and "
                    "dies with its process",
            label_width=label_width))
    for r in rows:
        if r["state"] == "unexplained":
            out.append(render_labeled_row(
                "  mail",
                f"unexplained: {r['sender']} -> {r['to']} at {ms_str(r['sent'])}",
                trailer=(r["summary"] or "")[:40] or None,
                label_width=label_width))
    return out


def doctor_member_lines(members):
    """Render canonical members once as aligned PID, identity, and title."""
    records = []
    for member in members:
        processes = member["runtime"].get("records") or ()
        pid_text = ", ".join(str(record["pid"]) for record in processes) or None
        transcript = member["resolution"].transcript
        title = (title_value((transcript or {}).get("title"))
                 or member["resolution"].reason
                 or "(no title)")
        records.append((
            pid_text, member["agent_id"], title, member["colour"],
        ))
    return render_agent_rows(records, clip_descriptions=True)


def diagnose_team(state):
    """Render verdict lines from one completed doctor team answer."""
    team = state["team"]
    members = state["members"]
    shared = state["shared"]
    conclusion = state["conclusion"]
    lead_member = conclusion["lead_member"]
    lead = lead_member["runtime"]
    pid, alive, detail = lead["pid"], lead["alive"], lead["detail"]
    lead_team, exact_team = lead["runs_as"], lead["runs_as_exact"]
    listed = conclusion["listed"]
    unrecorded = conclusion["unrecorded"]
    former = conclusion["former"]
    converted = conclusion["converted"]
    live = conclusion["live"]

    if pid:
        grade = shared.get("lead_grade")
        lead_grade = f" [{grade}]" if grade else ""
        lines = [f"lead     pid {pid}{'' if alive else ', not running'}"
                 + (f"  ({detail})" if detail else "") + lead_grade]
    else:
        lines = ["lead     (none)"]
    lead_transcript = lead_member["resolution"].transcript
    lead_title = title_value((lead_transcript or {}).get("title"))
    if lead_title:
        lines.append(f"title    {clip(lead_title, REPORT_TRANSCRIPT_TITLE)}")
    # An unknown answer has no grade; it names the teams the evidence left open.
    open_teams = lead.get("runs_as_open") or ()
    unknown = ("runs as  (unknown"
               + (f"; {some_of(open_teams)} still open" if open_teams else "") + ")")
    if "lead_team" in shared:
        said_team, said_grade = shared["lead_team"]
        lines.append(f"runs as  {said_team}  [{said_grade}]" if said_team else unknown)
    elif pid and alive:
        grade = "exact" if exact_team else f"inferred: {lead['runs_as_basis']}"
        lines.append(f"runs as  {lead_team}  [{grade}]" if lead_team else unknown)
    if "polls" in shared:
        said = {True: "yes", False: "no", None: "unknowable"}[shared["polls"][0]]
        lines.append(f"polls    {said}  ({shared['polls'][1]})")
    if "reachable" in shared:
        reachable, why = shared["reachable"]
        count = len(members)
        if count == 1:
            delivery = {
                True: "this member reaches its lead at its next turn boundary",
                False: "this member does not reach its lead",
                None: "this member may not reach its lead",
            }[reachable]
        else:
            delivery = {
                True: f"all {count} members reach their lead at their next turn boundary",
                False: f"all {count} members do not reach their lead",
                None: f"all {count} members may not reach their lead",
            }[reachable]
        lines.append(f"mail     {delivery}: {why}")
    lines.append(f"members  {len(listed)} listed, {len(unrecorded)} unrecorded, "
                 f"{len(former)} former, {len(live)} live"
                 + (f", {len(converted)} converted" if converted else ""))
    lines.extend(doctor_member_lines(members))

    sockets = conclusion["sockets"]
    if sockets:
        for record in sockets:
            count = len(record["members"])
            panes = ", ".join(seat.pane for seat in record["seats"])
            lines.append(
                f"socket   {record['socket']}: {count} seated "
                f"member{'' if count == 1 else 's'} "
                f"({', '.join(record['members'])}); panes {panes}")
    else:
        lines.append("socket   (none): 0 seated members")
    if conclusion["split"]:
        lines.append(f"warning  its crew is seated on {len(sockets)} servers: "
                     f"{', '.join(record['socket'] for record in sockets)}")
    unseated = conclusion["unseated"]
    if unseated:
        one = len(unseated) == 1
        it = "it" if one else "them"
        stop = agent_id_of(unseated[0], team) if one else "each of them"
        lines.append(f"warning  {', '.join(unseated)} {'is' if one else 'are'} live "
                     f"and in no tmux pane; a run of this team leaves {it} there, "
                     f"because a live member makes that run a noop rather than a "
                     f"relaunch, and nothing that looks for {it} in a pane finds "
                     f"{it}. To seat {it}: {TOOL} --stop {stop}, then run the team "
                     f"again, at the cost of {'its turn' if one else 'their turns'}")
    if unrecorded:
        one = len(unrecorded) == 1
        lines.append(f"note     {', '.join(unrecorded)} "
                     f"{'is' if one else 'are'} running and in no roster; "
                     f"resuming {'it' if one else 'each'} registers it")
    if converted:
        one = len(converted) == 1
        lines.append(f"note     {', '.join(converted)} "
                     f"{'was' if one else 'were'} promoted and "
                     f"{'has' if one else 'have'} not launched; "
                     f"{'its receipt is its' if one else 'their receipts are their'} "
                     "membership until then")
    for name, (count, oldest) in sorted(conclusion["waiting"].items()):
        lines.append(f"mail     {count} waiting for {name}, oldest {said_when(oldest)}")
    for name, why in sorted(conclusion["torn"].items()):
        lines.append(f"mail     {name}'s inbox is {why}; its contents are unknown")
    if state["deep"]:
        checked = set()
        for member in members:
            transcript = member["resolution"].transcript
            held = transcript["session"] if transcript else None
            if not member["runtime"]["records"] or not held or held in checked:
                continue
            checked.add(held)
            if member["fragile"]:
                lines.append(f"note     {member['name']} {member['fragile']}")
        lines.extend(undelivered_mail_lines(state["ledger"]))
    for name in conclusion["doubled"]:
        lines.append(f"warning  {name} is worn by {len(live[name])} processes at once")
    if conclusion["dormant"]:
        lines.append("warning  this team is dormant: no member of it is running, "
                     "no mail is waiting, and no live lead reads it")
    return conclusion["verdict"], lines, conclusion["remedies"]


def run_doctor(args):
    """Format Resolver's complete immutable doctor answer."""
    answer = RESOLVER.doctor_answer(DoctorRequest(
        team=getattr(args, "team", None),
        agent_id=getattr(args, "agent_id", None),
        session_uuid=getattr(args, "resume", None),
        include_dormant=bool(args.all_members),
    ))
    if answer["refusal"]:
        die(answer["refusal"], answer["exit_code"])
    shared = set(answer["shared_remedies"])
    tag = {pair: (chr(ord("A") + at) if at < 26 else f"S{at}")
           for at, pair in enumerate(answer["shared_remedies"])}
    for block in answer["blocks"]:
        team, verdict = block["team"], block["verdict"]
        print("\n" + f"{verdict:<11} {team}".replace(
            verdict, tint(verdict, VERDICT_SGR.get(verdict)), 1))
        for line in block["lines"]:
            print(line if isinstance(line, RenderedLine) else fill(f"  {line}"))
        for remedy in block["remedies"]:
            pair = (remedy["normalized_command"], remedy["cost"])
            print(fill(
                f"  remedy   {remedy['command']}  ({tag[pair]})" if pair in shared
                else f"  remedy   {remedy['command']}  ({remedy['cost']})"))
    if not answer["target"]:
        said = f"\n{answer['examined']} of {answer['total']} teams examined"
        if answer["skipped"]:
            said += (f"; the other {answer['skipped']} have nothing live and no mail "
                     "waiting, and --all covers them")
        print(fill(said))
    if answer["mail_ledger_note"]:
        print(fill("\nthese counts come from the inbox files; --mail-ledger <team> "
                   "joins sends against deliveries for one team"))
    for fact in answer["nameless_promotions"]:
        print(fill(f"\nnote     promoted transcript {fact['session'][:8]} has no "
                   "identity in its last conversion receipt, so no team can count it; "
                   "re-promote to record one"))
    if answer["verdicts"]:
        print("\nverdict" + ("s" if len(answer["verdicts"]) > 1 else ""))
        for name, meaning in DOCTOR_LEGEND:
            if name in answer["verdicts"]:
                print(fill(f"  {name:<11} {meaning}").replace(
                    name, tint(name, VERDICT_SGR.get(name)), 1))
    if shared:
        column = max(len(normalized_command)
                     for normalized_command, _cost in shared)
        print("\nremedies  (each block's remedy line ends with its letter)")
        for normalized_command, cost in answer["shared_remedies"]:
            pair = (normalized_command, cost)
            print(fill(f"  {tag[pair]}  {normalized_command:<{column}}  {cost}"))
    if answer["dossiers"]["show"]:
        for state in answer["diagnoses"]:
            print(f"\nagent dossiers  {state['team']}")
            for member in state["members"]:
                print()
                run_agent_dossier(member, shared=state["shared"])
    return answer["exit_code"]


