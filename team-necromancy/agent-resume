    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    pop_wrong, with_former = [], None
    for team in list(RESOLVER._known_teams())[:40]:
        population = RESOLVER._team_runtime(team)["population"]
        listed = {m.get("name") for m in (RESOLVER._roster_of(team) or {}).get("members", [])
                  if m.get("name")}
        if not listed <= set(population):
            pop_wrong.append(f"{team} loses {sorted(listed - set(population))[:2]}")
        if any(state != "listed" for state, _why in population.values()):
            with_former = with_former or team
    if with_former:
        extras = [n for n, (state, _w) in RESOLVER._team_runtime(with_former)["population"].items()
                  if state != "listed"]
        listed = {m.get("name") for m in (RESOLVER._roster_of(with_former) or {}).get("members", [])}
        if set(extras) & listed:
            pop_wrong.append(f"{with_former} calls a listed member former")

    # A team of this check's own with one listed member, which runs: a process
    # this run started, wearing the member's id. So a listed member that runs
    # is always there to be judged, whatever teams this machine holds, and the
    # process is under this run.
    base = Path(tempfile.mkdtemp(prefix=own("population")))
    crew = own("session-corpus-population")
    member = f"running@{crew}"
    (base / "projects").mkdir()
    (base / "teams" / crew / "inboxes").mkdir(parents=True)
    (base / "teams" / crew / "config.json").write_text(json.dumps({
        "name": crew, "leadAgentId": f"team-lead@{crew}",
        "leadSessionId": "0f6f6f6f-6f6f-46f6-8f6f-6f6f6f6f6f6f", "createdAt": 1,
        "members": [{"agentId": member, "name": "running"}]}))
    running = subprocess.Popen([FAKE_AGENT_BIN, "-c", '__import__("time").sleep(30)',
                                "--agent-id", member], executable=sys.executable,
                               stdin=subprocess.DEVNULL)
    eng = Resolver(needs=Needs(maybe=set(NEED)))
    eng._projects_dir, eng._teams_dir = base / "projects", base / "teams"
    real_table = eng._process_table
    try:
        wait_for_command_line(running.pid)
        with _FakeTmux(sockets=[]).installed(eng):
            eng._process_table = real_table
            crew_runtime = eng._team_runtime(crew)
    finally:
        running.kill()
        running.wait()
        shutil.rmtree(base, ignore_errors=True)
    seen_running = {name for name, facts in crew_runtime["runtimes"].items() if facts["external"]}
    crew_state = crew_runtime["population"].get("running", (None,))[0]
