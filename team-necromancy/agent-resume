NEWLINE_TEXT = {"none": "", "lf": "\n", "crlf": "\r\n"}


def _valid_newline(value):
    """Whether receipt newline metadata is exact and internally consistent."""
    if not isinstance(value, dict) or set(value) != {"line", "final"}:
        return False
    line, final = value.get("line"), value.get("final")
    if (not isinstance(line, str) or not isinstance(final, str)
            or line not in NEWLINE_TEXT or final not in NEWLINE_TEXT):
        return False
    return (line != "none" or final == "none") and final in ("none", line)


def _split_jsonl_text(text):
    """(record lines, newline metadata, objection) without newline conversion."""
    without_crlf = text.replace("\r\n", "")
    if "\r" in without_crlf:
        return None, None, "contains a bare carriage return"
    has_crlf = "\r\n" in text
    has_lf = "\n" in without_crlf
    if has_crlf and has_lf:
        return None, None, "mixes LF and CRLF record terminators"
    line = "crlf" if has_crlf else "lf" if has_lf else "none"
    separator = NEWLINE_TEXT[line]
    lines = text.split(separator) if separator else [text]
    final = line if separator and lines[-1] == "" else "none"
    if final != "none":
        lines.pop()
    return lines, {"line": line, "final": final}, None


def _jsonl_text(lines, newline):
    """Join JSONL records with their exact separator and final terminator."""
    if not _valid_newline(newline):
        raise ValueError(f"invalid newline metadata {newline!r}")
    separator = NEWLINE_TEXT[newline["line"]]
    if not separator and len(lines) > 1:
        raise ValueError("multiple JSONL records need a line separator")
    return separator.join(lines) + NEWLINE_TEXT[newline["final"]]


def _prompt_text(rec):
    """The user text of one transcript record, as a picker would show it."""
    content = (rec.get("message") or {}).get("content")
    if isinstance(content, str):
        return content.strip()
    if isinstance(content, list):
        return " ".join(part.get("text", "").strip() for part in content
                        if isinstance(part, dict) and part.get("type") == "text").strip()
    return ""


HUMAN_MESSAGE_PREFIX = "The user sent a new message while you were working:\n"
HUMAN_MESSAGE_WRAPPERS = {
    "current": (
        HUMAN_MESSAGE_PREFIX,
        "\n\nThis is how Claude Code surfaces messages the user sends mid-turn — "
        "within the running turn, often alongside the next tool result, rather than "
        "as a separate conversation turn. Address the message above as you continue "
        "this turn.",
    ),
    "legacy": (
        HUMAN_MESSAGE_PREFIX,
        "\n\nIMPORTANT: After completing your current task, you MUST address the "
        "user's message above. Do not ignore it.",
    ),
}


def _human_wrapper_text(content):
    """(wrapper version, inner text) for an exact known human wrapper."""
    if not isinstance(content, str):
        return None
    for version, (prefix, suffix) in HUMAN_MESSAGE_WRAPPERS.items():
        if content.startswith(prefix) and content.endswith(suffix):
            return version, content[len(prefix):-len(suffix)]
    return None


def _human_wrapper_content(version, inner):
    """Rebuild one exact known wrapper around its human text."""
    prefix, suffix = HUMAN_MESSAGE_WRAPPERS[version]
    return f"{prefix}{inner}{suffix}"


def _human_message_matches(rec, content, is_meta):
    """Whether one record is a human message in the requested stored state."""
    message = rec.get("message") or {}
    origin = rec.get("origin") or {}
    return (rec.get("type") == "user" and rec.get("isMeta") is is_meta
            and bool(rec.get("uuid")) and message.get("role") == "user"
            and isinstance(origin, dict) and origin.get("kind") == "human"
            and message.get("content") == content)


def _wrapped_human_message(rec):
    """A known persistent human wrapper, excluding other meta-message kinds."""
    content = (rec.get("message") or {}).get("content")
    wrapped = _human_wrapper_text(content)
    return wrapped if wrapped and _human_message_matches(rec, content, True) else None


def _picker_prompt_text(rec):
    """A human prompt for last-prompt, with known persistence wrappers removed."""
    wrapped = _wrapped_human_message(rec)
    if wrapped is not None:
        return wrapped[1].strip()
    if rec.get("type") != "user" or rec.get("isMeta") is True:
        return ""
    if "origin" in rec:
        origin = rec.get("origin")
        if not isinstance(origin, dict) or origin.get("kind") != "human":
            return ""
    return _prompt_text(rec)


def _stamps_in(chunk):
    """{field: value} from a window, ignoring the harness's display-label lines.

    A `type: "agent-name"` record holds a label, not an identity, and the label is
    whatever the session was called: a task sentence, "resume agent dev old". Read
    as a stamp it overrides hundreds of real ones, because the index takes the last
    match in the window and a label often sits at the end.
    """
    stamps = {}
    for line in chunk.split(b"\n"):
        if LABEL_LINE in line.replace(b'"type": "agent-name"', LABEL_LINE):
            continue
        # A sidechain line is a subagent's record, not this conversation's evidence.
        if b'"isSidechain":true' in line or b'"isSidechain": true' in line:
            continue
        stamps.update(STAMP_RE.findall(line))
    return stamps


