                                  "timestamp": "2026-01-01T00:00:01Z"}) + "\n" +
                      json.dumps({"type": "last-prompt", "leafUuid": "u-root"}) + "\n")
        if RESOLVER._window_start(un) is not None:
            stray.append("an unstamped window start restored")
        eng3 = Resolver(needs=Needs(maybe=set(NEED)))
        eng3._teams_dir = Path(td) / "teams"
        (eng3._teams_dir / "teamC").mkdir(parents=True)
        (eng3._teams_dir / "teamC" / "config.json").write_text("{}")
        snapshot_reads = []
        real_snapshot_read = eng3._stable_transcript_snapshot

        def counted_snapshot(path, include_mail=False):
            snapshot_reads.append(Path(path))
            return real_snapshot_read(path, include_mail)

        eng3._stable_transcript_snapshot = counted_snapshot
        first_start = eng3._window_start(wt)
        second_start = eng3._window_start(wt)
        check("window-start-reuses-unchanged-snapshot",
              "restored window identity is parsed once for one unchanged transcript snapshot",
              first_start is second_start and snapshot_reads == [wt],
              f"same={first_start is second_start}, reads={len(snapshot_reads)}")
        changed = [
            {"parentUuid": None, "agentName": "lead", "teamName": "teamC",
             "type": "user", "uuid": "wc-new-root",
             "timestamp": "2026-01-01T00:00:05Z"},
            {"parentUuid": "wc-new-root", "agentName": "lead", "teamName": "teamC",
             "type": "assistant", "uuid": "wc-new-leaf",
             "timestamp": "2026-01-01T00:00:06Z"},
            {"type": "last-prompt", "leafUuid": "wc-new-leaf", "sessionId": "w"},
        ]
        with wt.open("a") as handle:
            handle.write("".join(json.dumps(row) + "\n" for row in changed))
        changed_start = eng3._window_start(wt)
        before_replace = wt.stat()
        replacement = wt.with_suffix(".replacement")
        replacement.write_text(
            wt.read_text().replace("wc-new-root", "wd-new-root")
            .replace("wc-new-leaf", "wd-new-leaf"))
        os.utime(replacement, ns=(before_replace.st_atime_ns,
                                  before_replace.st_mtime_ns))
        os.replace(replacement, wt)
        after_replace = wt.stat()
        replaced_start = eng3._window_start(wt)
        invalidated = (
            changed_start == ("lead", "teamC", "wc-new-root")
            and replaced_start == ("lead", "teamC", "wd-new-root")
            and before_replace.st_size == after_replace.st_size
            and before_replace.st_mtime_ns == after_replace.st_mtime_ns
            and before_replace.st_ino != after_replace.st_ino
            and snapshot_reads == [wt, wt, wt]
        )
        check("window-start-invalidates-changed-snapshot",
              "restored window identity is reparsed when transcript identity or contents change",
              invalidated,
              f"changed={changed_start!r}, replaced={replaced_start!r}, "
              f"reads={len(snapshot_reads)}")
        restored = eng3._restore_fact(wt)
        if (restored["team"], restored["state"]) != ("teamC", "restored"):
            stray.append("a loadable stamped team did not read as restored")
        # The five measured arms, driven as one unit through the mount rule:
        # stamped-and-loadable overrides the argv team; stamped-for-absent falls
        # back to the argv team or to nobody; unstamped leaves the flags standing.
        (eng3._teams_dir / "teamZ").mkdir(parents=True)
        (eng3._teams_dir / "teamZ" / "config.json").write_text("{}")

        def mounted(stamped, argv_team):
            return eng3._mount_rule(stamped, argv_team, eng3._loads_now)[:2]

        if mounted("teamC", "teamZ") != ("teamC", "stamped"):
            stray.append("an argv team out-ranked a loadable window start")
        if mounted((eng3._window_start(un) or (None, None, None))[1],
                   "teamZ") != ("teamZ", "argv"):
            stray.append("an unstamped window start did not leave argv standing")
        # The rebind guard fires against the DESTINATION, not against the
        # merge (which echoes the stamps and made the guard compare the
        # stamps to themselves - a dead branch behind a green suite).

        class _RebindRes:
            def __init__(self, path):
                self.path = path

        class _RebindArgs:
            to_team, force = "teamZ", False

        def restoring_target(team):
            return fixture_target(
                wt.stem, wt, identity={"agentName": "lead", "teamName": team},
                roster={"census": eng3._roster_census()})

        real_teams = RESOLVER._teams_dir
        RESOLVER._teams_dir = eng3._teams_dir
        try:
            said = io.StringIO()
            fired = False
            with capturing("err", into=said):
                try:
                    enforce_restore(restoring_target("teamZ"), _RebindArgs)
                except Refusal:
                    fired = True
                except Exception as err:  # a guard that crashes is not a guard
                    stray.append(f"the rebind guard crashed: {err.__class__.__name__}")
            if not (fired and "teamC" in " ".join(said.getvalue().split())):
                stray.append("a rebind onto a restoring transcript was not refused")
            with capturing("err"):
                try:
                    enforce_restore(restoring_target("teamC"), _RebindArgs)
                except Refusal:
                    stray.append("a rebind onto the restored team itself was refused")
                except Exception as err:
                    stray.append(f"the matching-team path crashed: {err.__class__.__name__}")
        finally:
            RESOLVER._teams_dir = real_teams
        (eng3._teams_dir / "teamC" / "config.json").unlink()
        missing = eng3._restore_fact(wt)
        if (missing["team"], missing["state"]) != ("teamC", "stamped-team-missing"):
            stray.append("an absent stamped team did not report stamped-team-missing")
        if mounted("teamC", "teamZ") != ("teamZ", "argv"):
            stray.append("argv identity did not remain active after source roster removal")
        if mounted("teamC", None)[0] is not None:
            stray.append("a resume without argv identity acquired one")
        # A temporary argv-based rebind explains the compaction remedy. A resume
        # under the stamped team needs no warning, and a loadable stamped team is
        # handled by the refusal above instead.
        real_projects = RESOLVER._projects_dir
        RESOLVER._teams_dir = eng3._teams_dir
        RESOLVER._projects_dir = Path(td)
        try:
            frag = RESOLVER._rebind_fragility("w", "teamZ")
            if not (frag and "stamps naming teamC" in frag
                    and "Run /compact under teamZ" in frag):
                stray.append("a temporary rebind did not explain the compaction remedy")
            if RESOLVER._rebind_fragility("w", "teamC") is not None:
                stray.append("a same-team transcript warned fragile")
            (eng3._teams_dir / "teamC" / "config.json").write_text("{}")
            if RESOLVER._rebind_fragility("w", "teamZ") is not None:
                stray.append("a still-restoring transcript warned fragile")
        finally:
            RESOLVER._teams_dir = real_teams
            RESOLVER._projects_dir = real_projects
        check("restore-reads-window-start", "restore reads the window start, not the tail", not stray,
              ", ".join(stray))

    s.rows = rows
    return checked


@unit(('restored-life-window-start', 'a restored life runs as its window start says'))
def _check_restored_life_window_start(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    corpus_engine = s.corpus_engine

    eng = corpus_engine()
    eng._session_registry = lambda: []
    eng._process_table = lambda refresh=False: [
        (PID_CEILING + 424242, 0,
         ("claude", "--resume", "1e5701ed-1fe5-4701-8ed1-e5701ed1fe57",
          "--agent-id", "team-lead@session-corpus-alpha"))]
    # Started now, after every roster in the corpus was written, so each team
    # stamped on the first record of a restored window was there to load when
    # it mounted.
    eng._process_start_ms = lambda record: int(time.time() * 1000)
    torn, sighted, restored_n, incomplete = [], 0, 0, 0
    snapshot = eng._runtime()
    for e in snapshot["live_sessions"]:
        if not (e.get("alive") and e.get("session")):
            incomplete += 1
            continue
        sighted += 1
        lived = eng._transcript_path(e["session"])
        if not lived:
            continue
        restored = eng._restore_fact(lived)
        team = restored["team"]
        if restored["state"] == "restored":
            restored_n += 1
            got_team = eng._operating_team(e["pid"], snapshot)["team"]
            if got_team != team:
                torn.append(f"pid {e['pid']}: {got_team} != {team}")
    check("restored-life-window-start", "a restored life runs as its window start says",
          restored_n > 0 and not torn,
          ", ".join(torn) or f"{restored_n} restored of {sighted} registry-complete "
          f"live sessions, {incomplete} incomplete skipped")

    s.eng = eng
    s.team = team
    return checked


