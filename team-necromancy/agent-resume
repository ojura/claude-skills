        try:
            plan = eng4.rewriter.conversion_plan(side, "promote", identity=("xp", "TEAMX"))
            materialize(plan)
            dest = plan["dest_path"]
            if not dest.exists():
                moved.append("no promoted transcript")
            else:
                promoted = [json.loads(line) for line in dest.read_text().splitlines()]
                by_uuid = {rec.get("uuid"): rec for rec in promoted if rec.get("uuid")}
                if [rec.get("uuid") for rec in promoted[:2]] != ["pl-root", "pl-leaf"]:
                    moved.append("the inherited parent prefix was not materialized first")
                if by_uuid.get("xr-root", {}).get("parentUuid") != "pl-leaf":
                    moved.append("the fork root was not connected to the materialized prefix")
                if dest.stat().st_mode & 0o777 != 0o600:
                    moved.append("the promoted transcript lost its mode")
            if side.exists() or (sub / "agent-x1.meta.json").exists():
                moved.append("the source did not leave subagents/")
            carried = eng4.receipt_carried_by(dest)
            if not carried or carried.get("root") != dest.stem:
                moved.append("the promoted transcript carries no usable receipt")
            if list(RECEIPTS_DIR.glob("xr-root*.json")):
                moved.append("the promote wrote a receipt outside the transcript")
            # Until launch, the in-file receipt is the membership: the population
            # carries the member as converted, the roster stays silent, and
            # the ladder resolves the name to the promoted transcript.
            pop = eng4.team_runtime("TEAMX")["population"]
            if pop.get("xp", ("",))[0] != "converted":
                moved.append("an unlaunched promote is missing from the population")
            if eng4.converted_members("TEAMX").get("xp", {}).get("root") != dest.stem:
                moved.append("the carried receipt does not name its own transcript")
            res = eng4.resolve_transcript(name="xp", team="TEAMX", quick=True)
            if not res or res.via != "conversion receipt" or res.path != dest:
                moved.append("the ladder does not reach an unlaunched promote")
            dplan = eng4.rewriter.conversion_plan(dest, "demote")
            if dplan["objections"] or not dplan["proved"]:
                moved.append(f"the written promote cannot be demoted: "
                             f"{dplan['objections'] or 'unproved'}")
            else:
                embed(dplan)
                if eng4.converted_members("TEAMX"):
                    moved.append("a consumed receipt still counts as membership")
                if side.read_text() != body:
                    moved.append("the demoted bytes differ from the original")
                if side.stat().st_mode & 0o777 != 0o600:
                    moved.append("a private transcript came back wider than it left")
                restored_meta = sub / "agent-x1.meta.json"
                side_meta_exact = (restored_meta.read_bytes() == meta_body
                                   and restored_meta.stat().st_mode & 0o777 == 0o640)
                if dest.exists():
                    moved.append("the promoted transcript lingered")
                if eng4.receipt_carried_by(side):
                    moved.append("the undo left its conversion receipt in the side transcript")
                if list(RECEIPTS_DIR.glob("xr-root*.json")):
                    moved.append("the conversion wrote a receipt outside the transcript")
        finally:
            globals()["RECEIPTS_DIR"] = real_receipts
        check("writers-move-receipt-back", "the writers move, and the receipt is the way back", not moved,
              ", ".join(moved))
        check("conversion-restores-side-metadata-exactly",
              "demotion restores the exact side metadata bytes and mode",
              side_meta_exact)

    s.res = res
    return checked


@unit(('demote-cannot-embed-self', 'a demote cannot embed the conversation it runs inside'), ('demote-refuses-a-live-holder', 'a demote refuses a transcript a live stranger holds, unless forced'))
def _check_demote_cannot_embed_self(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    tempfile = s.tempfile

    with tempfile.TemporaryDirectory() as td:
        proj = Path(td) / "proj"
        proj.mkdir(parents=True)

        # A teammate that really does demote, so the arms where nothing stops
        # it show the demote going through rather than meeting some later
        # refusal that would make a broken gate look the same as a working one.
        (proj / "MATEHELD.jsonl").write_text(
            fixture_line({"parentUuid": None, "sessionId": "MATEHELD", "agentName": "heldy",
                     "teamName": "TEAMH", "type": "user", "uuid": "mh-root"}) + "\n" +
            fixture_line({"type": "last-prompt", "lastPrompt": "hi", "leafUuid": "mh-root",
                     "sessionId": "MATEHELD"}) + "\n" +
            fixture_line({"parentUuid": "mh-root", "sessionId": "MATEHELD", "agentName": "heldy",
                     "teamName": "TEAMH", "type": "assistant", "uuid": "mh-2"}) + "\n" +
            fixture_line({"type": "last-prompt", "lastPrompt": "again", "leafUuid": "mh-2",
                     "sessionId": "MATEHELD"}) + "\n")

        class _HeldArgs:
            demote, force, with_mail = "MATEHELD", False, False
            into, dry_run = "PARENT", True

        class _ForcedArgs(_HeldArgs):
            force = True

        me = os.getpid()
        holder = "claude --resume MATEHELD --agent-id heldy@TEAMH"
        # One pid up from ours is a stranger by construction: the lineage walk
        # starts at our own pid and follows this table's parents, and this
        # table has no way to reach ours.
        ours, stranger = [(me, 0, holder)], [(me + 1, 1, holder)]

        def demoted(args, table):
            """Everything this demote said, refusal or plan, on one line.

            Both streams, because the two outcomes under test are told on
            different ones: a refusal is die() to stderr, and a demote that
            nothing stops names its destination on stdout. A demote that
            stopped refusing returns rather than exiting, so the arms read
            what it said instead of the suite ending on it. dry_run
            throughout: the arms that get past both gates plan and print,
            and nothing here writes.
            """
            real_table = RESOLVER.process_table
            RESOLVER.process_table = lambda: table
            said, printed = io.StringIO(), io.StringIO()
            try:
                with capturing("err", into=said), \
                        capturing("out", into=printed):
                    try:
                        run_demote(args)
                    except Refusal:
                        pass
            finally:
                RESOLVER.process_table = real_table
            return " ".join((said.getvalue() + " " + printed.getvalue()).split())

        real_projects, real_teams = RESOLVER.projects_dir, RESOLVER.teams_dir
        real_receipts = RECEIPTS_DIR
        RESOLVER.projects_dir, RESOLVER.teams_dir = Path(td), Path(td) / "teams"
        globals()["RECEIPTS_DIR"] = Path(td) / "receipts"
        try:
            inside = demoted(_HeldArgs, ours)
            inside_forced = demoted(_ForcedArgs, ours)
            outside = demoted(_HeldArgs, stranger)
            outside_forced = demoted(_ForcedArgs, stranger)
            unheld = demoted(_HeldArgs, [])
        finally:
            RESOLVER.projects_dir, RESOLVER.teams_dir = real_projects, real_teams
            globals()["RECEIPTS_DIR"] = real_receipts

        # What the same demote says when nothing holds the file: the control
        # both refusals need, since a refusal that fires whatever the process
        # table says is not answering the holder question.
        went_through = "demote MATEHELD ->"

        blind = []
        mine = f"you are demoting the transcript you are running (pid {me})"
        if mine not in inside:
            blind.append(f"a demote of our own conversation said: {inside or 'nothing'}")
        if mine not in inside_forced:
            blind.append(f"--force got past it: {inside_forced or 'nothing'}")
        if went_through not in unheld:
            blind.append(f"the same demote unheld did not go through: {unheld or 'nothing'}")
        # The half the drive cannot see: self-hold is answered first, so a
        # lineage that also counted as a stranger would still refuse here.
        # The reap reads that half, and nothing else asserts the exclusion.
        holders = RESOLVER.runtime(ours)["transcripts"].get("MATEHELD", {})
        if holders.get("others"):
            blind.append("the composed question counts our own lineage as a stranger")
        check("demote-cannot-embed-self", "a demote cannot embed the conversation it runs inside", not blind,
              ", ".join(blind))

        holding = []
        theirs = f"pid {me + 1} is running this conversation"
        if theirs not in outside:
            holding.append(f"a demote under a live holder said: {outside or 'nothing'}")
        if went_through not in outside_forced:
            holding.append(f"--force did not override the holder refusal: "
                           f"{outside_forced or 'nothing'}")
        if went_through not in unheld:
            holding.append(f"the same demote unheld did not go through: {unheld or 'nothing'}")
        check("demote-refuses-a-live-holder",
              "a demote refuses a transcript a live stranger holds, unless forced",
              not holding, ", ".join(holding))
    return checked


