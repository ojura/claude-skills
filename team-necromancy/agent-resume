POISON_URL = "http://127.0.0.1:9"


def base_url_is_poison(value):
    """Whether this ANTHROPIC_BASE_URL is Recipe 1's dead port rather than a real one.

    Only the poison is stripped from a revived agent's environment. Stripping any
    base url would silently send an agent somewhere other than where its lead
    talks, which is a worse failure than the one being prevented: a poisoned
    child dies loudly at connect, a redirected one runs and answers from the
    wrong endpoint.
    """
    return bool(value) and value.strip().rstrip("/") == POISON_URL

