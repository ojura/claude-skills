@unit(('explain-value-is-what-the-launch-emits', '--explain prints the value the launch emits, on the field the merge prefers a fuller spelling of'))
def _check_explain_value_is_what_the_launch_emits(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    _Emit = s._Emit

    def explained_row(told, want):
        """(value, source, time, mark) for one field of a printed --explain.

        The source is the legend's full text rather than the row's letter: the
        letter is a tag for the page, and the text is what a reader compares.
        """
        lines = told.splitlines()
        legend = dict(re.split(r" {2,}", line.strip())[-2:] for line in lines
                      if re.match(r"  (sources)? +[A-Z]  \S", line))
        for line in lines:
            parts = re.split(r" {2,}", line.strip())
            if parts[0] == want and len(parts) > 3 and parts[2] in legend:
                return (parts[1], legend[parts[2]], parts[3],
                        parts[4] if len(parts) > 4 else "")
        return None, None, None, None

    with tempfile.TemporaryDirectory() as td:
        fx = Path(td)
        # The stamps are read off the bytes, and the pattern the reader uses has
        # no space after the colon, which is how the harness writes them.

        fx_team, fx_lead = "session-lossy", "dddddddd-dddd-4ddd-8ddd-dddddddddddd"
        fx_mates = {"tern": ("eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee", "claude-opus-5[1m]"),
                    "gull": ("ffffffff-ffff-4fff-8fff-ffffffffffff", "claude-opus-5-20260101")}
        (fx / "projects" / "lossy").mkdir(parents=True)
        (fx / "teams" / fx_team).mkdir(parents=True)
        (fx / "teams" / fx_team / "config.json").write_text(json.dumps({
            "name": fx_team,
            "leadAgentId": f"team-lead@{fx_team}",
            "leadSessionId": fx_lead,
            "createdAt": 1,
            # The roster is the newer source of a model here, and it is the one
            # holding the plain spelling. Dated past both transcripts so the
            # fixture does not depend on which of them a reader looks at first.
            "members": [{"agentId": f"team-lead@{fx_team}", "name": "team-lead"}]
            + [{"agentId": f"{mate}@{fx_team}", "name": mate, "model": "claude-opus-5",
                "agentType": "general-purpose", "joinedAt": 1_767_398_400_000}
               for mate in fx_mates]}))
        # The spawn records are merged at timestamp 0, so each is the older
        # candidate for its member whatever date the roster carries.
        spawns = [fixture_line({"type": "user", "uuid": "lossy-root", "parentUuid": None,
                         "timestamp": "2026-01-01T00:00:00Z", "sessionId": fx_lead,
                         "message": {"role": "user", "content": "spawn them"}})]
        for mate, (uuid, spawn_model) in fx_mates.items():
            spawns.append(fixture_line({
                "type": "user", "uuid": f"lossy-{mate}", "parentUuid": "lossy-root",
                "timestamp": "2026-01-01T00:00:05Z", "sessionId": fx_lead,
                "isSidechain": False, "message": {"role": "user", "content": []},
                "toolUseResult": {"status": "teammate_spawned", "name": mate,
                                  "team_name": fx_team, "agent_id": f"{mate}@{fx_team}",
                                  "agent_type": "general-purpose", "model": spawn_model}}))
            # Stamped, so the engine resolves it by name and team, and carrying
            # no model of its own, so the merge holds the two candidates the
            # check is about and no third one.
            (fx / "projects" / "lossy" / f"{uuid}.jsonl").write_text("\n".join([
                fixture_line({"type": "user", "uuid": f"{mate}-1", "parentUuid": None,
                       "timestamp": "2026-01-02T00:00:00Z", "sessionId": uuid,
                       "agentName": mate, "teamName": fx_team,
                       "message": {"role": "user", "content": "go"}}),
                fixture_line({"type": "assistant", "uuid": f"{mate}-2",
                       "parentUuid": f"{mate}-1",
                       "timestamp": "2026-01-02T00:00:05Z", "sessionId": uuid,
                       "agentName": mate, "teamName": fx_team}),
            ]) + "\n")
        (fx / "projects" / "lossy" / f"{fx_lead}.jsonl").write_text("\n".join(spawns) + "\n")
        lossy_eng = Resolver(needs=Needs(maybe=set(NEED)))
        lossy_eng._projects_dir, lossy_eng._teams_dir = fx / "projects", fx / "teams"
        real_resolver = globals()["RESOLVER"]
        globals()["RESOLVER"] = lossy_eng
        printed, launched = {}, {}
        try:
            with capturing("err"):
                for mate in fx_mates:
                    lossy_ctx = lossy_eng._identity(agent_id=f"{mate}@{fx_team}")
                    with capturing("out") as lossy_out:
                        explain(lossy_ctx)
                    printed[mate] = explained_row(lossy_out.getvalue(), "model")
                    emitted = build_command(lossy_ctx, _Emit(f"{mate}@{fx_team}"), [])
                    launched[mate] = dict(zip(emitted, emitted[1:])).get("--model")
        finally:
            globals()["RESOLVER"] = real_resolver
    tern_value, tern_source, tern_time, tern_mark = printed["tern"]
    gull_value, _gull_src, _gull_time, gull_mark = printed["gull"]
    agreed = {
        # The winning row prints no time because the spawn record is merged
        # undated, which is the same fact as "the roster was the newer one".
        "the older bracketed spelling wins the row":
            tern_value == "claude-opus-5[1m]" and tern_time == "-",
        "and the row names the newer plain spelling it beat":
            str(tern_source).endswith("(more specific than claude-opus-5)"),
        "both spellings are still marked as disagreeing":
            tern_mark == "<- conflict: claude-opus-5, claude-opus-5[1m]",
        "the launch emits a model at all": bool(launched["tern"]),
        "--explain prints the value the launch emits": tern_value == launched["tern"],
        "a longer candidate that is not bracketed loses":
            gull_value == "claude-opus-5" and launched["gull"] == "claude-opus-5",
        "and the fixture really offered one":
            "claude-opus-5-20260101" in gull_mark,
    }
    wrong = sorted(k for k, ok in agreed.items() if not ok)
    check("explain-value-is-what-the-launch-emits",
          "--explain prints the value the launch emits, on the field the merge "
          "prefers a fuller spelling of", not wrong,
          ", ".join(wrong + [f"model rows {printed}, launched {launched}"]))

    s.real_resolver = real_resolver
    return checked


