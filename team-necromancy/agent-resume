        wrapper_started = _ProcessFence.start_time(wrapper.pid)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not _ProcessFence._walk_down(wrapper.pid):
            time.sleep(0.02)
        inside = {wrapper.pid} | _ProcessFence._walk_down(wrapper.pid)
        fence = fence_of_own(root=wrapper.pid, root_start=wrapper_started)
        fence.enter("undeclared", False)
        rooted = {pid for pid, _ppid, _argv
                  in Resolver(needs=Needs(maybe=set(NEED)))._process_table()}
        asked_outside = fence.leave()
        fence = fence_of_own(root=wrapper.pid, root_start="1")
        fence.enter("undeclared", False)
        stale = {pid for pid, _ppid, _argv
                 in Resolver(needs=Needs(maybe=set(NEED)))._process_table()}
        fence.leave()
        globals()["PROCESS_FENCE"] = runner
        seen["a table under a fence rooted at another process lists it and what runs under "
             "it, and nothing else"] = len(inside) == 2 and rooted == inside
        seen["and asks that fence about no other pid"] = not asked_outside
        seen["a root with another start time leaves the table empty"] = stale == set()

        # Each reader, under a fence of this check's own, in an undeclared unit,
