                                and after["stamps"] is before["stamps"] and after["assignments"] is before["assignments"])
                    elif mode in ("changed-destination", "changed-meta"):
                        okay = (isinstance(caught, Refusal) and current and old_unchanged and projections
                                and source.read_bytes() == raw_before and dest.exists() and len(validations) == 2
                                and len(refreshed) == (1 if kind == "promote" else 2))
                    elif mode == "open-failure":
                        after_files = _fixture_tree_contents(f.root)
                        # A failed create may leave its parent directory, but no file bytes.
                        files_unchanged = ({p: value for p, value in after_files.items() if value[0] == 'file'}
                                           == {p: value for p, value in before_files.items() if value[0] == 'file'})
