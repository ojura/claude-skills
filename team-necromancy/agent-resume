@unit(('roster-read-one-place', 'a roster is read in one place'))
def _check_roster_read_one_place(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    engine_node = s.engine_node
    src_of = s.src_of
    tree = s.tree

    ambient = {"PROJECTS_DIR", "SESSIONS_DIR", "TEAMS_DIR"}
    engine_lines = set(range(engine_node.lineno, engine_node.end_lineno + 1))
    # Found from the tree, never written down: a recorded line range drifts as the
    # file grows, and a drifted exemption silently excuses whatever moved into it.
    # Every line the suite occupies: its units, their context and the runner.
    # The suite's support code counts as the suite too. _FakeTmux is the one
    # synthetic tmux fixture, and it answers the command surface by naming the
    # commands, so the bans on asking those questions outside the engine would
    # otherwise read it as a second place that asks them.
    suite_fns = s.suite_fns
    suite_classes = s.suite_classes = {"_FakeTmux", "_ProcessFence"}
    selftest_lines = set()
    for n in ast.walk(tree):
        if isinstance(n, ast.FunctionDef) and n.name in suite_fns:
            selftest_lines |= set(range(n.lineno, n.end_lineno + 1))
        elif isinstance(n, ast.ClassDef) and n.name in suite_classes:
            selftest_lines |= set(range(n.lineno, n.end_lineno + 1))
    # The evidence ban stops raw tree access. These stop the decisions: a roster
    # parsed by hand, an argv matched by hand, and the underscore convention going
    # quietly hollow. Every such regression shares one route: the raw form
    # stays reachable, so somebody reaches.
    # Narrowly: reading a roster file. Parsing a transcript line or a settings
    # file is a different question and stays where it is; the regression shape
    # is several functions each deciding for themselves what a roster is.

    def reads_a_roster(node):
        body = src_of(node) or ""
        return ("loads" in body
                and ("roster_path" in body or "config.json" in body)
                and "read_text" in body)

    roster_readers = sorted(
        node.name for node in tree.body
        if isinstance(node, ast.FunctionDef) and reads_a_roster(node)
        # edit_team_config is the writer and re-reads under its own lock.
        and node.name not in {"edit_team_config"} | s.suite_fns)
    check("roster-read-one-place", "a roster is read in one place", not roster_readers, ", ".join(roster_readers))

    s.ambient = ambient
    s.engine_lines = engine_lines
    s.selftest_lines = selftest_lines
    return checked


@unit(('process-reads-are-fenced',
       "a /proc reader refuses a pid outside its unit's processes, and a value that is not "
       "a whole number, without reading it, answers it as gone and writes the refusal down, "
       "in a unit or outside one, and the fence reads nothing of a refused pid but the start "
       "time its rules compare; it reads the run's own processes, a pid the run learned in "
       "this process or in a tool run of its units, in that unit or a later one, and a pid a "
       "declared unit's real table or registry named, each while its start time is the one "
       "recorded when the run learned of it or once no process holds its number"),
      ('undeclared-units-see-no-processes',
       "a unit not declared to read the machine sees the processes under the selftest "
       "process that runs it and no others, and no session registry, through RESOLVER and "
       "every engine it makes, each with all six of its own process inputs; a declared unit "
       "sees the machine's"),
      ('unit-runner-drops-process-caches',
       "the unit runner drops RESOLVER's process caches as a unit starts and again however "
       "it ends, a raise included, and puts back the fence's unit and the variable a tool "
       "run inherits"))
def _check_process_reads_are_fenced(s):
    """The process fence, its readers, and what ran_unit does as a unit starts and in its finally.

    Every refusal here is provoked on purpose, so each is provoked under a
    fence of this check's own, writing to a record of this check's own: the
    run's fence and its record see none of them, and the run's own row stays
    about the run. What the run's fence gives this unit, which is not
    declared, is read without provoking any.
    """
    room = Path(tempfile.mkdtemp(prefix=own("fence")))
    runner, made_fences = PROCESS_FENCE, []

    def fence_of_own(**given):
        fence = _ProcessFence(str(room / f"record-{len(made_fences)}.jsonl"), **given)
        made_fences.append(fence)
        globals()["PROCESS_FENCE"] = fence
        return fence

    seen, told, edges = {}, {}, {}
    child = subprocess.Popen(["sleep", "30"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    wrapper, wrapper_started = None, ""
    try:
        # The tables below are taken once the child's command line is set.
        wait_for_command_line(child.pid)
        # The world the run gives this unit, through RESOLVER and an engine
        # made here, each still holding the six process inputs it was built with.
        made = Resolver(needs=Needs(maybe=set(NEED)))
        for name, engine in (("RESOLVER", RESOLVER), ("an engine made in the unit", made)):
            seen[f"{name} keeps all six of its own process inputs"] = all(
                getattr(getattr(engine, attr), "__func__", None) is getattr(Resolver, attr)
                for attr in _FakeTmux.PROCESS_INPUTS)
            before = {os.getpid()} | _ProcessFence._walk_down(os.getpid())
            pids = {pid for pid, _ppid, _argv in engine._process_table(refresh=True)}
            after = {os.getpid()} | _ProcessFence._walk_down(os.getpid())
            seen[f"{name}'s table lists this run and the process it started"] = (
                {os.getpid(), child.pid} <= pids)
            seen[f"{name}'s table lists nothing outside this run"] = pids <= before | after

        # A registry with two sessions in it, which this unit does not see and a
        # declared unit, under a fence of this check's own, does: this run's,
        # and its parent's, a running process outside the run that only the
        # registry names to the fence.
        sessions = room / "sessions"
        sessions.mkdir()
        (sessions / "fence-check.json").write_text(json.dumps(
            {"pid": os.getpid(), "sessionId": "fence-check"}))
        (sessions / "fence-check-outside.json").write_text(json.dumps(
            {"pid": os.getppid(), "sessionId": "fence-check-outside"}))
        was_sessions = globals()["SESSIONS_DIR"]
        globals()["SESSIONS_DIR"] = sessions
        try:
            # Read through the runtime snapshot, the one reader of the registry.
            hidden = (RESOLVER._runtime(RESOLVER._process_table(refresh=True))["registry"],
                      made._runtime(made._process_table(refresh=True))["registry"])
            fence = fence_of_own()
            fence.enter("declared", True)
            declared = Resolver(needs=Needs(maybe=set(NEED)))
            shown = declared._runtime(((os.getpid(), os.getppid(), ("python3",)),))["registry"]
            outside = declared._proc_stat(os.getppid())
            registry_refused = fence.leave()
        finally:
            globals()["SESSIONS_DIR"] = was_sessions
            globals()["PROCESS_FENCE"] = runner
        seen["RESOLVER and the engine see no session registry, where a declared unit reads it"] = (
            hidden == ((), ())
            and sorted(entry["pid"] for entry in shown) == sorted([os.getpid(), os.getppid()]))
        told["a declared unit reads a running pid outside the run that only the registry "
             "named"] = outside[0] is not None and not registry_refused

        listed = [1, os.getppid(), os.getpid(), child.pid]
        fence = fence_of_own()
        undeclared_listing = fence.listing(listed)
        fence.enter("declared", True)
        declared_listing = fence.listing(listed)
        fence.leave()
        globals()["PROCESS_FENCE"] = runner
        seen["an undeclared table may read only this run's processes, a declared one the machine's"] = (
            undeclared_listing == [os.getpid(), child.pid] and declared_listing == listed)

        # RESOLVER's own per-process readers, asked about pid 1, which is
        # outside every run, under a fence of this check's own. Its environment
        # cannot be read by this user either, so a reader without its guard
        # reads nothing of it.
        fence = fence_of_own()
        fence.enter("undeclared", False)
        answers = (RESOLVER._proc_stat(1), RESOLVER._cmdline(1), RESOLVER._proc_env(1, ("PATH",)))
        start_ms = RESOLVER._process_start_ms({"pid": 1, "proc_start": "100"})
        refused = sorted((reader, pid) for _unit, reader, pid in fence.leave())
        globals()["PROCESS_FENCE"] = runner
        seen["RESOLVER's own readers refuse pid 1, a process outside this run"] = (
