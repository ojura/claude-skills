        f.config(team, b'{invalid', 0o640)
    extra = tuple({
        "type": "user", "uuid": f"spawn-{name}", "parentUuid": "lead-owned-root", "isSidechain": False,
        "sessionId": "lead-owned", "agentName": "team-lead", "teamName": team,
        "timestamp": "2026-01-01T00:00:01Z", "message": {"role": "user", "content": []},
