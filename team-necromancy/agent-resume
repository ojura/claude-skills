                team=team, agent_id=None, all_members=True, resume=None))
        said = " ".join(out.getvalue().split())
    finally:
        shutil.rmtree(base, ignore_errors=True)

    facts = {
        "it reads the team as connected": "CONNECTED" in said,
        "a healthy team exits zero": code in (0, None),
        "it names the team": team in said,
        "it names the lead": "team-lead" in said,
        "it names the member it was told about": "watcher" in said,
        "it says nothing about a severed team": "SEVERED" not in said,
    }
    wrong = sorted(name for name, ok in facts.items() if not ok)
    check("doctor-reports-a-connected-team",
          "doctor reports a team with its lead and a member both running",
          not wrong, "; ".join(wrong + [f"code {code!r}, said {said[:250]}"]) if wrong else "")
    return checked


SelftestReport = collections.namedtuple("SelftestReport", "rows summary problems")

# The tally a full report ends with.
SUMMARY_LINE = re.compile(r"(\d+)/(\d+) checks passed")


def report_of(said, returncode, bound):
    """What another selftest process reported, and why it cannot be taken whole.

    said is the process's stdout and returncode its exit status: None when it
    was stopped at bound seconds, negative when a signal ended it. rows are its
    (id, description, verdict, detail) rows in order, a detail that spans lines
    read whole. summary is its last non-empty line when that is the tally, as
    printed. problems names everything that keeps the report from standing for
    a finished run: no tally, a malformed one, one that disagrees with the
    rows, a verdict line without an id and description, a process stopped at
    its bound or ended by a signal, and an exit status other than the one its
    verdicts call for.

    A run that died mid-way leaves a short list and no tally, and taking its
    rows on trust would report the checks it never reached as absent rather
    than as unanswered; the tally and the exit status are what can contradict
    the rows, so they are compared rather than believed. Nothing in the text
    raises here: whatever a process printed comes back as rows and problems, so
    the parent reports a broken child instead of ending on a parser exception
    with nothing reported at all.
    """
    lines = said.splitlines()
    filled = [at for at, line in enumerate(lines) if line.strip()]
    summary, tally, problems, body = None, None, [], lines
    if filled and "checks passed" in lines[filled[-1]]:
        summary = lines[filled[-1]].strip()
        body = lines[:filled[-1]]
        match = SUMMARY_LINE.fullmatch(summary)
        if match:
            tally = (int(match.group(1)), int(match.group(2)))
        else:
            problems.append(f"malformed summary {summary!r}")
    else:
        problems.append("no summary line, so the report is incomplete")
    rows = []
    for line in body:
        verdict = line.strip()
        if not verdict:
            continue
        if verdict.startswith(("PASS  ", "FAIL  ")):
            cid, _, rest = verdict[6:].partition("  ")
            name, _, detail = rest.strip().partition("  (")
            if not cid.strip() or not name.strip():
                problems.append(f"a verdict line without an id and description: {verdict!r}")
                continue
            rows.append([cid.strip(), name.strip(), verdict.startswith("PASS"), detail])
        elif rows:
            # A detail that spans lines continues below its row as printed.
            rows[-1][3] = f"{rows[-1][3]}\n{line.rstrip()}"
    rows = [(cid, name, ok, detail[:-1] if detail.endswith(")") else detail)
            for cid, name, ok, detail in rows]
    passed = sum(1 for row in rows if row[2])
    if tally is not None and tally != (passed, len(rows)):
        problems.append(f"the summary counts {tally[0]}/{tally[1]} but {len(rows)} row(s) "
                        f"were read, {passed} passed")
    if returncode is None:
        problems.append(f"did not finish within {bound}s and was stopped")
    elif returncode < 0:
        problems.append(f"was ended by signal {-returncode}")
    elif tally is None:
        problems.append(f"exited {returncode}")
    elif returncode != (0 if passed == len(rows) else 1):
        problems.append(f"exited {returncode} where its verdicts call for "
                        f"{0 if passed == len(rows) else 1}")
    return SelftestReport(rows, summary, problems)


def collected(proc, bound, stop=None):
    """What a started selftest process printed, stopping it at bound seconds.

    A CompletedProcess either way, its returncode None when the bound was
    reached, so the caller reads a stopped run's partial output and reports
    the stop instead of losing both to an exception. Anything else that ends
    the wait, a Ctrl-C among them, takes the process down with it. stop, when
    given, is how the process is stopped, for one with children of its own
    that have to be ended with it; otherwise the process alone is killed.
    """
    stop = stop or proc.kill
    try:
        out, err = proc.communicate(timeout=bound)
    except subprocess.TimeoutExpired:
        stop()
        out, err = proc.communicate()
        return subprocess.CompletedProcess(proc.args, None, out, err)
    except BaseException:
        stop()
        proc.wait()
        raise
    return subprocess.CompletedProcess(proc.args, proc.returncode, out, err)


def tree_state(root):
    """Every path under root and what it holds.

    Nothing was written is measured over the whole tree rather than over the
    files somebody thought of, so a run that writes something nobody named
    still fails. Two checks ask it, a preview that must write nothing and a
    help that must do nothing, and one function keeps them asking the same
    question.
    """
    state = {}
    for path in sorted(root.rglob("*")):
        rel = str(path.relative_to(root))
        if path.is_symlink():
            state[rel] = "-> " + os.readlink(path)
        elif path.is_file():
            state[rel] = path.read_text(errors="replace")
        else:
            state[rel] = "<a directory>"
    return state


def end_left_behind(names):
    """End what started_here found a tool run left; returns the pids still running after.

    A leftover is under this run, which adopted it, so it would stay in view of
    every unit after this one until finish_run ends it when the whole run
    finishes. The unit that found it ends it instead, the way finish_run does,
    through end_processes: each process named here with what runs under it,
    signalled only through a pidfd opened while the start time it picked still
    held. A socket node is removed from the directory this run pointed tmux at,
    where started_here found it.
    """
    pids = {int(name) for name in names if str(name).isdigit()}
    found = set(pids)

    def chosen(processes):
        picked = {}
        for pid in list(found):
            if pid in processes:
                picked[pid] = processes[pid]
                picked.update({member: processes[member]
                               for member in _ProcessFence.subtree(pid, processes)})
        found.update(picked)
        return picked

    left = end_processes(chosen)[1] if pids else []
    for name in names:
        if not str(name).isdigit():
            with contextlib.suppress(OSError):
                (Path(os.environ["TMUX_TMPDIR"]) / name).unlink()
    return left


def started_here():
    """The processes under this run that wear a fixture identity, and the tmux sockets named for it.

    A tool run that exits leaves what it started to this run, which adopts it,
    so a process a tool run left running is among them while it runs; a
    process that wears no fixture identity, and a socket named otherwise, are
    not. Narrowed twice, because the question is what this run started and a
    declared unit's table answers about the whole machine: to processes
    wearing a fixture identity, since real agents run here too, and then to
    processes descending from this run. Another run's fixture is its own
    business, and counting it reports a leak nobody here made.

    The sockets are read straight out of the directory this run pointed tmux
    at, kept to nodes named for this pid and to nodes that really are sockets.
    Asking the engine for the swarm sockets would answer with the machine's
    directory, and would put a production discovery call inside a test's leak
    check. TMUX_TMPDIR is read without a default on purpose: the suite runner
    sets it for the length of a run, so a call from anywhere else raises
    rather than quietly reporting no leaks from the wrong directory.

    One function rather than one per caller, so the check that this narrowing
    holds asks the same question the tier asks rather than a copy of it.
    """
    table = RESOLVER._process_table(refresh=True)
    mine = RESOLVER._descendants_of(os.getpid(), table)
    return ({str(pid) for pid, _ppid, cmd in table
             if pid in mine and fixture_worn(cmd)}
            | {node.name for node in Path(os.environ["TMUX_TMPDIR"]).iterdir()
               if node.name.endswith(f"-{os.getpid()}") and node.is_socket()})


def hand_down(quiet, where):
    """Write a read-only child's output where a worker can read it back."""
    where.write_text(json.dumps({"args": quiet.args, "returncode": quiet.returncode,
                                 "stdout": quiet.stdout, "stderr": quiet.stderr}))
    return where


def handed_down(where):
    """The child a parent already ran, as the run of it this process skipped.

    A file rather than the worker's stdin: the read-only tier prints a line per
    check, and a pipe nobody is reading stops accepting them partway, which
    would hang the run rather than fail it.
    """
    got = json.loads(Path(where).read_text())
    return subprocess.CompletedProcess(got["args"], got["returncode"],
                                       got["stdout"], got["stderr"])


def in_share(count, share):
    """Which places in a list of that many units this share answers for.

    Taken by position rather than by name, so a unit added later moves at most
    one unit between shares. For any number of shares each place falls in
    exactly one of them, which is what lets the shares be merged into one
    tier's worth of verdicts. share=None is the whole tier.
    """
    return [at for at in range(count)
            if share is None or at % share[1] == share[0]]


def _live_in_parallel(jobs, diagnostics=None, settle=None):
    """The live units run in jobs processes at once, their verdicts merged.

    Each worker owns its fixtures, because a fixture is named for the run that
    made it and a run asks only about what it started, so two workers cannot
    see each other. The read-only tier is inherited once here rather than
    once per worker.

    A worker that dies leaves rows without the summary that counts them, and
    the gap is reported as a failure rather than passing as fewer checks.

    Returns the rows, the register that filled them and what the shares said
    about their own registrations. The first two are the pair live_checks
    hands back, so a caller adds a row of its own the one way; the third goes
    into the run's one uniqueness row beside this register's collisions.

    settle, when given, is called once the shares have finished and returns
    what this process found about itself, by summary row id, which the folded
    rows carry beside what the shares said: run_selftest hands in what its
    own finish_run ended and the reads its fence refused.
    """
    s = _live_context(diagnostics=diagnostics)
    out, register = check_rows()
    for row in s.inherited:
        register(*row)
    # The parent's room, named by one letter and mkdtemp's eight characters,
    # because every worker's socket root is made inside it, at the depth a
    # split inside a share reaches too, and a socket path has to stay under
    # 108 bytes. Which run made it is written inside it.
    room = owned_directory("w")
    try:
        inherit = hand_down(s.quiet, room / "read-only.json")
        finished = run_shares([[sys.executable, str(Path(__file__).resolve()),
                                "--selftest", "--live", "--share", f"{at}/{jobs}",
                                "--inherit", str(inherit)] for at in range(jobs)], room)
    except RoomRefused as refused:
        # Nothing started, so every share reads as one that never did, and
        # the reason goes to the operator whole.
        write_diagnostic(f"the split run started no worker: {refused}", diagnostics)
        finished = []
    finally:
        shutil.rmtree(room, ignore_errors=True)
    return out, register, fold_shares(finished, jobs, register, settle() if settle else None)


def run_shares(argvs, room, start=subprocess.Popen, bound=SELFTEST_CHILD_BOUND, inspect=None):
    """Run one worker per argv, each with a TMPDIR of its own in room, and clean up after all of them.

    room is a directory the caller owns. Worker at gets room/<at> as its
    TMPDIR, passed in its environment rather than worked out afterwards from a
    pid. Each started worker is kept before the next start is tried, so a
    start that fails leaves every worker started before it in the list the
    cleanup reads.

    Each worker starts in a process group of its own, and its identity is read
    as it starts. A worker still running at its bound is ended with
    everything under it and in its group, and so is one the cleanup finds
    running. A worker is a run of its own, so what it starts it ends itself;
    should it die first, what it left is adopted by this run, which ends it
    when it finishes.

    Whatever ends this, the cleanup ends and reaps every worker still running
    and removes every worker's TMPDIR, by the paths and identities read here.
    A worker that died before its own cleanup ran leaves its directories to
    this one. inspect, when given, is called with the worker roots once every
    worker has ended and before the cleanup, for a check that has to see what
    a worker left.

    Returns the finished processes in order, as collected returns them. Raises
    RoomRefused, starting nothing, when worker_room_faults finds the
    directories unusable.
    """
    refused = worker_room_faults(room, [Path(room) / str(at) for at in range(len(argvs))])
    if refused:
        raise RoomRefused("; ".join(refused))
    workers, roots, finished = [], [], []

    def ending(worker, started):
        """Stop worker with what it started, by identity, then the worker itself, which
        this run holds unreaped, so its pid cannot belong to anyone else yet."""
        def stop():
            left = end_process_tree(worker.pid, started)
            if worker.poll() is None:
                worker.kill()
            return left
        return stop

    try:
        for at, argv in enumerate(argvs):
            root = Path(room) / str(at)
            root.mkdir()
            roots.append(root)
            env = dict(os.environ, TMPDIR=str(root))
            worker = start(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           text=True, env=env, process_group=0)
            started = _ProcessFence.start_time(worker.pid)
            workers.append((worker, ending(worker, started)))
        # A worker that hangs would hold this run open with no way out, so each
        # is given a bound and stopped with its group by the code that started it.
        finished = [collected(worker, bound, stop) for worker, stop in workers]
    finally:
        for worker, stop in workers:
            if worker.poll() is None:
                stop()
            worker.wait()
        try:
            if inspect is not None:
                inspect(tuple(roots))
        finally:
            for root in roots:
                shutil.rmtree(root, ignore_errors=True)
    return finished


def fold_shares(finished, jobs, register, own=None):
    """Register what the shares of a split live run reported, as one run's rows.

    finished holds each share's finished process in share order, as collected
    returned it. A share's checks are registered as they came, so a check two
    shares both reported is a collision this register records. The rows every
    share states about its own run, SHARE_SUMMARY_ROWS, are held back and
    folded: each must come exactly once from every share, under its own
    description, and pass, and the folded row names every share that said
    otherwise. The share row says whether every share's report was whole and
    its exit status the one its verdicts call for, and it carries whatever a
    share wrote to stderr, whole.

    own maps a summary row's id to what the merging run found about itself,
    which that row carries beside what the shares said: the merging run's own
    refused reads, for one.

    Returns the folded faults of the shares' uniqueness rows instead of
    registering that row: the caller states it once, with this register's own
    collisions, so a collision between shares is not lost behind a row the
    fold already registered.
    """
    held = {cid: {} for cid, _said in SHARE_SUMMARY_ROWS}
    short = []
    for at in range(jobs):
        label = f"share {at}/{jobs}"
        if at >= len(finished):
            short.append(f"{label} never started")
            continue
        share = finished[at]
        report = report_of(share.stdout, share.returncode, SELFTEST_CHILD_BOUND)
        short += [f"{label}: {problem}" for problem in report.problems]
        worker_err = share.stderr
        if worker_err.strip():
            short.append(f"{label} stderr:\n{worker_err.strip()}")
        for row in report.rows:
            if row[0] in held:
                held[row[0]].setdefault(label, []).append(row)
            else:
                register(*row)
    # One verdict for the shares between them, reported whether or not any fell
    # short, so the run says the merge was whole rather than saying nothing.
    register(SHARED_CHECKS[0][0], SHARED_CHECKS[0][1], not short, "; ".join(short))
    # The units ran in the shares, so the shares are what watched them print,
    # what saw one of them end a share and what registered their rows. Counting
    # each share's rows keeps a share that never reached one from reading as a
    # share with nothing to report.
    unique_faults = []
    for cid, description in SHARE_SUMMARY_ROWS:
        faults = []
        for at in range(jobs):
            label = f"share {at}/{jobs}"
            rows = held[cid].get(label, [])
            if len(rows) != 1:
                faults.append(f"{label} reported it {len(rows)} time(s)")
            faults += [f"{label} reported it as {name!r}"
                       for _cid, name, _ok, _detail in rows if name != description]
            faults += [f"{label}: {detail}" for _cid, _name, ok, detail in rows if not ok]
        faults += list((own or {}).get(cid, ()))
        if cid == IDS_UNIQUE[True][0]:
            unique_faults = faults
        else:
            register(cid, description, not faults, "; ".join(faults))
    return unique_faults


@unit(("live-workers-share-one-removable-tempdir",
       "each worker of a split live run gets its own TMPDIR inside one room, left empty after "
       "the workers so that removing it removes everything, with room left for its socket "
       "paths, and a missing, shared, outside or overlong TMPDIR is refused before any worker "
       "starts"), rooms=True)
def _check_live_workers_share_one_removable_tempdir(s):
    """run_shares and worker_room_faults on worker processes that run nothing.

    What run_shares hands its workers is read off a start that records each
    worker's environment and starts nothing, so this asks about the directories
    and not about a share's work. The four ways a directory can be wrong are
    each put to worker_room_faults on their own, and the overlong one to
    run_shares as well, which has to refuse it before its first start.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast

    class Recorded:
        """A started worker as run_shares sees one, for a start that runs nothing."""

        def __init__(self, argv, **kwargs):
            self.args, self.env, self.returncode = argv, kwargs.get("env", {}), 0
            # No process: a pid from PID_CEILING up, which no process can hold,
            # so the cleanup finds nothing to record as a group or end as one.
            self.pid = PID_CEILING + 743001

        def communicate(self, timeout=None):
            return "", ""

        def poll(self):
            return 0

        def kill(self):
            pass

        def wait(self):
            return 0

    room = Path(tempfile.mkdtemp(prefix="w"))
    given, present = [], []
    try:
        def start(argv, **kwargs):
            given.append(kwargs.get("env", {}).get("TMPDIR"))
            return Recorded(argv, **kwargs)

        run_shares([["one"], ["two"], ["three"]], room, start=start,
                   inspect=lambda roots: present.extend(root.is_dir() for root in roots))
        left = sorted(entry.name for entry in room.iterdir())
    finally:
        shutil.rmtree(room, ignore_errors=True)
    long_room = Path("/" + "r" * 60)
    arms = {
        "missing": worker_room_faults(room, [room / "0", None]),
        "shared": worker_room_faults(room, [room / "0", room / "0"]),
        "outside": worker_room_faults(room, [room / "0", room.parent / "elsewhere"]),
        "overlong": worker_room_faults(long_room, [long_room / "0"]),
    }
    started = []
    try:
        run_shares([["one"]], long_room, start=lambda argv, **kwargs: started.append(argv))
        refused = False
    except RoomRefused:
        refused = True
    except OSError:
        # It went on to make the worker's directory, which does not exist.
        refused = False
    # Cleanup removes the directories run_shares recorded, by path, so no
    # glob in the code that starts and cleans up after workers reads a
    # worker's files.
    globbing = sorted(named for named in ("_live_in_parallel", "run_shares")
                      for node in ast.walk(s.funcs[named])
                      if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                      and node.func.attr in ("glob", "rglob"))
    given_roots = [Path(root) for root in given if root]
    claims = {
        "every worker is given a TMPDIR": len(given) == 3 and all(given),
        "each is inside the room": all(room in root.parents for root in given_roots),
        "no two workers share one": len(set(given_roots)) == len(given_roots),
        "each leaves room for its socket paths": not worker_room_faults(room, given_roots),
        "each existed while the workers ran": present == [True, True, True],
        "the room is empty after, so removing it removes everything": left == [],
        "a worker given none is refused": arms["missing"] == ["worker 1 has no TMPDIR"],
        "two workers given one are refused": arms["shared"] == [
            f"workers 0 and 1 share the TMPDIR {room / '0'}"],
        "a TMPDIR outside the room is refused": arms["outside"] == [
            f"worker 1's TMPDIR {room.parent / 'elsewhere'} is not inside the room {room}"],
        "a TMPDIR too long for a socket path is refused":
            len(arms["overlong"]) == 1 and "bytes for a socket name" in arms["overlong"][0],
        "run_shares refuses it before its first start": refused and not started,
        "no glob finds a worker's files": not globbing,
    }
    wrong = sorted(claim for claim, ok in claims.items() if not ok)
    check("live-workers-share-one-removable-tempdir",
          "each worker of a split live run gets its own TMPDIR inside one room, left empty "
          "after the workers so that removing it removes everything, with room left for its "
          "socket paths, and a missing, shared, outside or overlong TMPDIR is refused before "
          "any worker starts",
          not wrong, ", ".join(wrong) + (f"; given {given}, arms {arms}, glob in {globbing}"
                                         if wrong else ""))
    return checked


@unit(("run-refuses-a-tmpdir-too-long-for-its-sockets",
       "a run refuses before it makes anything when its TMPDIR leaves too little room for a "
       "socket name at the deepest socket root it makes"))
def _check_run_refuses_a_tmpdir_too_long_for_its_sockets(s):
    """deepest_socket_root's levels, where run_selftest asks it, and one real refusal.

    The levels are read from the function for each kind of run. That the
    question comes before anything is made is read from run_selftest's own
    order, and shown once on a run of this tool given a TMPDIR too long for
    any level: it has to refuse with status 2 and leave that TMPDIR empty.
    """
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast

    def makers(tree):
        """The registered units that call run_shares or build an argv list holding --jobs, found by reading their code as a syntax tree."""
        registered = {name for name, _ids, _run, _live in UNITS}
        return {node.name for node in tree.body
                if isinstance(node, ast.FunctionDef) and node.name in registered
                and any((isinstance(part, ast.Call)
                         and getattr(part.func, "id", None) == "run_shares")
                        or (isinstance(part, ast.List)
                            and any(isinstance(item, ast.Constant) and item.value == "--jobs"
                                    for item in part.elts))
                        for part in ast.walk(node))}

    one = Path("/r") / ("w" + "x" * 8) / "1" / WORKER_SOCKET_ROOT
    roomless = [entry for entry in UNITS if entry[0] not in ROOM_MAKING_UNITS]
    two = Path("/r") / ("w" + "x" * 8) / "1" / ("w" + "x" * 8) / "1" / WORKER_SOCKET_ROOT
    levels = {
        "a read-only run nests one level": deepest_socket_root("/r", False, 1) == one,
        "a live run that does not split nests one level": deepest_socket_root("/r", True, 1) == one,
        "a split live run nests two levels": deepest_socket_root("/r", True, 2) == two,
        "a split live run nests one level when its units make no rooms":
            deepest_socket_root("/r", True, 2, units=roomless) == one,
        "a share nests none when its units make no rooms":
            deepest_socket_root("/r", True, 2, share="0/2", units=roomless)
            == Path("/r") / WORKER_SOCKET_ROOT,
        "the units that run run_shares or split a copy with --jobs are the ones declared "
        "to make rooms": makers(s.tree) == ROOM_MAKING_UNITS,
        "a share of a split run nests one level":
            deepest_socket_root("/r", True, 2, share="0/2") == one,
        "a short TMPDIR fits": socket_room_fault(deepest_socket_root("/tmp", True, 4)) is None,
    }
    # In run_selftest the room question is asked before the socket root is made.
    order = sorted((node.lineno, getattr(node.func, "id", None))
                   for node in ast.walk(s.funcs["run_selftest"])
                   if isinstance(node, ast.Call)
                   and getattr(node.func, "id", None) in ("deepest_socket_root", "owned_directory"))
    asked_first = [name for _line, name in order][:2] == ["deepest_socket_root", "owned_directory"]
    base = Path(tempfile.mkdtemp(prefix="tl"))
    try:
        long_tmpdir = base / ("t" * max(1, SOCKET_PATH_LIMIT - len(str(base))))
        long_tmpdir.mkdir()
