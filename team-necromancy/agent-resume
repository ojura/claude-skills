@unit(('reap-cut-before-the-staged-read', 'the reap reads the staged copy after the cut and folds it into the receipt'))
def _check_reap_cut_before_the_staged_read(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    funcs = s.funcs

    reap_node = funcs["reap_team"]
    reap_reads = {}     # variable -> (line, the name it was read from)
    folds = []          # (line, the name the receipt was re-prepared from)
    for sub in ast.walk(reap_node):
        if not isinstance(sub, ast.Assign) or len(sub.targets) != 1:
            continue
        target, value = sub.targets[0], sub.value
        if not (isinstance(target, ast.Name) and isinstance(value, ast.Call)
                and value.args):
            continue
        if (isinstance(value.func, ast.Attribute)
                and value.func.attr == "receipt_contents"):
            reap_reads[target.id] = (sub.lineno, getattr(value.args[0], "id", None))
        elif target.id == "receipt" and getattr(value.func, "id", None) == "prepared":
            folds.append((sub.lineno, getattr(value.args[0], "id", None)))
    cuts = [sub.lineno for sub in ast.walk(reap_node)
            if isinstance(sub, ast.Call) and isinstance(sub.func, ast.Attribute)
            and sub.func.attr == "rename"
            and [getattr(a, "id", None) for a in sub.args] == ["team_dir", "staged"]]
    compares = sorted((sub for sub in ast.walk(reap_node)
                       if isinstance(sub, ast.Call)
                       and getattr(sub.func, "id", None) == "differing"),
                      key=lambda sub: sub.lineno)
    out_of_order = []
    if not cuts:
        out_of_order.append("nothing renames team_dir aside")
    elif not compares:
        out_of_order.append("nothing compares a read against a later one")
    else:
        cut = min(cuts)
        held, against = [getattr(a, "id", None) for a in compares[0].args][:2]
        before, after = reap_reads.get(held), reap_reads.get(against)
        if not before or before[1] != "team_dir" or before[0] > cut:
            out_of_order.append(
                f"the receipt is not prepared from a read of the live directory "
                f"before the cut ({held} = {before})")
        if not after or after[1] != "staged" or after[0] < cut:
            out_of_order.append(
                f"it is not compared against a read of the staged copy after the "
                f"cut ({against} = {after})")
        if after and not any(line > after[0] and name == against
                             for line, name in folds):
            out_of_order.append("nothing prepares the receipt again from the staged read")
    check("reap-cut-before-the-staged-read",
          "the reap reads the staged copy after the cut and folds it into the receipt",
          not out_of_order, "; ".join(out_of_order))
    return checked


