def doctor_against_planner(eng, source, census, table):
    """The doctor's move offers for `source` beside the planner's decisions.

    The doctor offers the run of SOURCE with --all and the run with
    --into-team live --all, each with whatever flags it names, in its team
    conclusion and in the remedies every member shares. team_run_plan is asked
    for each of those commands without and with --with-mail, and the planner's
    offer is the first under which it moves someone. `agree` says the doctor
    names exactly those flags, or no command, in both places, and --keep-team.
    """
    prefixes = {"automatic": f"{TOOL} {source} --all",
                "live": f"{TOOL} {source} --into-team live --all"}

    def flags_in(remedies, kind):
        for what, _cost in remedies:
            rest = what[len(prefixes[kind]):] if what.startswith(prefixes[kind]) else None
            if rest is not None and "--into-team" not in rest:
                return tuple(rest.split())
        return None

    lead = eng._agent_runtime(agent_id_of("team-lead", source), table, census=census)
    delivery = eng._team_delivery_facts(
        source, lead, eng._roster_snapshot(source, census).data, census=census, table=table)
    conclusion = eng._team_diagnosis(source, table=table, census=census)["conclusion"]
    planner, reasons = [], []
    for kind in ("automatic", "live"):
        offer = None
        for archive in (False, True):
            chosen = eng.team_run_plan(source, table, all_members=True, census=census,
                                       redirect=MemberRedirectRequest(
                                           kind=kind, archive_mail=archive))["redirect"]
            if not archive:
                reasons.append(chosen["reason"])
            if chosen["action"] == "redirect" and chosen["moving"]:
                offer = ("--with-mail",) if archive else ()
                break
        planner.append(offer)
    doctor = tuple(flags_in(conclusion["remedies"], kind) for kind in ("automatic", "live"))
    member = tuple(flags_in(delivery["common_remedies"], kind)
                   for kind in ("automatic", "live"))
    keep = (any(what == f"{TOOL} {source} --keep-team" for what, _c in conclusion["remedies"])
            and any(what == "--keep-team" for what, _c in delivery["common_remedies"]))
    return {"planner": tuple(planner), "doctor": doctor, "member": member, "keep": keep,
            "reasons": tuple(reasons), "agree": doctor == member == tuple(planner) and keep}


def doctor_cases(start):
    """The doctor against the planner where the lead runs as DSTTEAM by a spawn.

    One synthetic world per case. The lead spawned into DSTTEAM after it
    started, so it runs there exactly, and DSTTEAM's roster names its
    conversation; SRCTEAM keeps mover, stopped. Returns {case: (what
    doctor_against_planner saw, the planner offers the case should have)}.
    """
    source, dest = "SRCTEAM", "DSTTEAM"
    lead_conv = "1ead7777-0000-4000-8000-000000000007"
    lead_pid, runner_pid = 4309801, 4309802
    cases = {
        # A running member wears SRCTEAM: the automatic run leaves it there,
        # so it keeps the team from being retired, and the live run moves it.
        "a member runs on the team": (True, True, (None, ())),
        # SRCTEAM's roster does not name the lead's conversation and nothing
        # corroborates its old spawn, so the automatic run stays put.
        "the lead is known only by an uncorroborated claim": (False, False, (None, ())),
        "nothing is in the way": (False, True, ((), ())),
    }
    seen = {}
    for case, (running, named, expected) in cases.items():
        with _roster_test_fixture() as f:
            eng = f.engine
            names = ("team-lead", "mover") + (("runner",) if running else ())
            f.config(source, {"name": source, "createdAt": start - 7_200_000,
                              "leadAgentId": agent_id_of("team-lead", source),
                              "leadSessionId": lead_conv if named else "",
                              "members": [{"name": name, "agentId": agent_id_of(name, source)}
                                          for name in names]})
            f.config(dest, {"name": dest, "createdAt": start - 7_200_000,
                            "leadAgentId": agent_id_of("team-lead", dest),
                            "leadSessionId": lead_conv,
                            "members": [{"name": "team-lead",
                                         "agentId": agent_id_of("team-lead", dest)}]})
            operating_conversation(f, start, lead_conv,
                                   spawns=((source, -3_600_000), (dest, 5_000)))
            for name in names[1:]:
                operating_conversation(f, start, f"{name}-conv", name, source)
            f.fake.processes[:] = [(lead_pid, 1, (FAKE_AGENT_BIN, "--resume", lead_conv))]
            if running:
                f.fake.processes.append(
                    (runner_pid, 1, (FAKE_AGENT_BIN, "--resume", "runner-conv",
