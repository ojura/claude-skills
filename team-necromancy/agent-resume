def tint_pane(socket, pane, colour, name, dry):
    """Tint a pane the way the harness tints its own.

    A pane this tool creates gets no tint (only a real spawn applies one), so
    without this a revived agent is the one grey pane in a coloured swarm. It
    is three pane options plus the bold titled border, matching what the
    harness does, so revived and spawned members look alike.
    """
    if not (colour or name) or (not pane and not dry):
        return
    tint = TMUX_COLORS.get(colour, colour)
    actions = []
    if tint:
        actions += [
            ("set-option", "-p", "-t", pane, "window-style", f"bg=default,fg={tint}"),
            ("set-option", "-p", "-t", pane, "pane-border-style", f"fg={tint}"),
            ("set-option", "-p", "-t", pane, "pane-active-border-style", f"fg={tint}"),
        ]
    if name:
        actions.append(("select-pane", "-t", pane, "-T", name))
        actions.append(("set-option", "-p", "-t", pane, "pane-border-format",
                        f"#[fg={tint or 'default'},bold] #{{pane_title}} #[default]"))
    where = f"{pane or '<new pane>'} {tint or '(no colour)'}, titled {name}"
    if not dry:
        for action in actions:
            tmux(socket, *action)
    step(dry, f"would tint {where}", f"tinted {where}")


class LaunchFailed(Exception):
    """tmux refused to place this agent. One member's problem, not the run's."""


def launch(plan, cwd, command, dry, replace_pane=None):
    """Apply one preselected tmux launch action without choosing another one."""
    if not plan or not isinstance(plan.get("destination"), LaunchDestination):
        raise TypeError("launch needs an immutable tmux launch action")
    destination = plan["destination"]
    socket = destination.socket
    server = plan["server"]
    session_live = server["session_live"]
    value = (server["base_url"] if server["alive"]
             else os.environ.get("ANTHROPIC_BASE_URL", ""))
    carrier = socket if server["alive"] else "this shell"
    scrub = "-u ANTHROPIC_BASE_URL " if poison_said(value, carrier) else ""
    quoted = (
        "exec env " + scrub
        + " ".join(TEAM_ENV) + " "
        + " ".join(shlex.quote(c) for c in command)
    )

    if replace_pane and not session_live:
        raise LaunchFailed(
            f"cannot replace pane {replace_pane}: no live {TMUX_SESSION} session "
            f"on {socket}")
    if session_live and not dry:
        for key in INHERIT_ENV:
            if os.environ.get(key) and tmux(
                    socket, "show-environment", "-g", key).returncode != 0:
                tmux(socket, "set-environment", "-g", key, os.environ[key])

    action = "respawn" if replace_pane else plan["action"]
    if action == "respawn":
        argv = ["respawn-pane", "-k", "-t", replace_pane]
    elif action == "new-session":
        warn(f"socket {socket} is down, reestablishing" if not server["alive"]
             else f"session {TMUX_SESSION} missing on {socket}, recreating")
        argv = ["new-session", "-d", "-s", TMUX_SESSION, "-n", TMUX_WINDOW,
                "-x", str(SWARM_COLS), "-y", str(SWARM_ROWS),
                "-P", "-F", "#{pane_id}"]
    elif action == "split":
        argv = ["split-window", "-t", plan["target_pane"],
                "-P", "-F", "#{pane_id}"]
    elif action == "new-window":
        argv = ["new-window", "-t", TMUX_SESSION, "-n", TMUX_WINDOW,
                "-P", "-F", "#{pane_id}"]
    else:
        raise LaunchFailed(f"unknown selected tmux action {action!r}")
    if cwd:
        argv += ["-c", cwd]
    argv.append(quoted)

    rendered = f"tmux -L {socket} {' '.join(shlex.quote(a) for a in argv)}"
    if dry:
        step(True, wrap_command(rendered, "  would run: ", "    "), "", indent="")
        return None, action
    res = tmux(socket, *argv)
    if res.returncode != 0:
        raise LaunchFailed(f"tmux {argv[0]} failed: {res.stderr.strip()}")
    if action in ("split", "new-window"):
        tmux(socket, "select-layout", "-t", TMUX_SESSION, "tiled")
    step(False, "", wrap_command(rendered, "  ran: ", "    "), indent="")
    pane = replace_pane if action == "respawn" else res.stdout.strip()
    return Seat(socket, pane), action


