    from unittest import mock
    with _roster_test_fixture() as f:
        eng = f.engine
        path = f.transcript('moving', 'mover', 'A')
        f.config('A', {'name': 'A', 'members': [{'name': 'mover', 'agentId': 'mover@A', 'isActive': False}]})
