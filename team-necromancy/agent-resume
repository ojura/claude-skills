@unit(('explain-tags-its-sources', '--explain names each source once and tags its rows'))
def _check_explain_tags_its_sources(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    class _Cands:
        """Exactly what explain() consumes from a merge, and nothing else.

        A stand-in rather than the engine's own _Merged, because reaching into
        the merge is what merge-reached-via-engine bars, and this check is
        about how the table is printed.
        """

        def __init__(self):
            self.cands = defaultdict(list)

        def add(self, field, value, ts, source):
            self.cands[field].append((value, ts, source))

        def pick(self, field):
            return max(self.cands[field], key=lambda cand: cand[1])

        def conflicts(self, field):
            return {cand[0] for cand in self.cands.get(field, [])}

    merged_fake = _Cands()
    roster_source = "roster of session-explain"
    jsonl_source = "transcript 11111111-1111-4111-8111-111111111111"
    for field, value in (("agentId", "who@session-explain"),
                         ("agentType", "general-purpose"),
                         ("tmuxPaneId", "%0")):
        merged_fake.add(field, value, 1_700_000_000_000, roster_source)
    for field, value in (("agentName", "who"), ("model", "claude-fable-5"),
                         ("cwd", "/tmp")):
        merged_fake.add(field, value, 1_700_000_100_000, jsonl_source)
    merged_fake.add("model", "fable", 1_600_000_000_000, roster_source)  # a conflict
    with capturing("out") as explained:
        explain({"merged": merged_fake,
                 "other_transcripts": [(Path("/nowhere/older.jsonl"), None, 1_500_000_000_000)]})
    told = explained.getvalue()
    field_rows = [each for each in told.splitlines()
                  if each.startswith("  ") and each.split() and each.split()[0] in merged_fake.cands]

    def tag_of(line):
        """This row's source tag, or None when the row carries no tag column."""
        parts = re.split(r" {2,}", line.strip())
        return parts[2] if len(parts) > 3 else None

    def tag_column(line):
        """Where this row's source tag sits, or None when it carries no tag."""
        tag = tag_of(line)
        return line.rfind(f"  {tag}  ") if tag else None

    tagged = {
        "every field has a row": len(field_rows) == len(merged_fake.cands),
        "a source is spelled out once": told.count(roster_source) == 1
            and told.count(jsonl_source) == 1,
        "no row repeats a source": not any(
            roster_source in each or jsonl_source in each for each in field_rows),
        "the legend says which tag is which": any(
            each.strip().startswith("sources") and roster_source in each
            for each in told.splitlines()),
        "the tags line up": len({tag_column(each) for each in field_rows}) == 1
            and None not in {tag_column(each) for each in field_rows},
        "two sources get two tags": len({tag_of(each) for each in field_rows}) == 2
            and None not in {tag_of(each) for each in field_rows},
        "the conflict is still marked": "<- conflict: claude-fable-5, fable" in told,
        "the ignored transcript is still named": "older transcript ignored" in told,
    }
    wrong = sorted(k for k, ok in tagged.items() if not ok)
    check("explain-tags-its-sources", "--explain names each source once and tags its rows",
          not wrong, ", ".join(wrong))
    return checked


@unit(('demote-parent-refusal-says-why', 'a demote with no parent says why it could not find one'))
