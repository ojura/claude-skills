        checked.append((cid, name, ok, detail))

    corpus_engine = s.corpus_engine

    eng = corpus_engine()
    eng._session_registry = lambda: []
    eng._process_table = lambda refresh=False: [
        (PID_CEILING + 424242, 0, ("claude", "--agent-id", "petrel@session-corpus-crew")),
        (PID_CEILING + 424243, 0, ("claude", "--agent-id", "sparrow@session-corpus-crew"))]
    eng._seat_index = lambda rows: {
        PID_CEILING + 424242: Seat("sock-crew", "%1"),
        PID_CEILING + 424243: Seat("sock-crew", "%2"),
    }
    table = eng._process_table()
    runtime = eng._runtime(table)
    placements = {
        team: eng._crew_placement(team, table)
        for team in sorted({row["team"] for row in runtime["live_sessions"] if row["team"]})
    }
    crewed = next((team for team, placement in placements.items()
                   if placement.destination), None)
    placement = placements.get(crewed)
    seat = placement.destination.socket if placement and placement.destination else None
    wearers = {row["agent_id"] for row in runtime["live_sessions"]
               if row.get("team") == crewed and row.get("agent_id")}
    listed = ({member.get("agentId") for member in (eng._roster_of(crewed) or {}).get("members", [])}
              if crewed else set())
    absent = f"definitely-not-running@{crewed}"
    seated = set(sum((list(ids) for ids in placement.by_socket.values()), [])) if placement else set()
    seats = {
        "a crew anchors the seat": placement and placement.destination == LaunchDestination("sock-crew"),
        "the placement retains its selected live provenance":
            placement and placement.provenance == f"live pane %1 of pid {PID_CEILING + 424242}",
        "an agent that is not running does not change the selected crew seat": absent not in seated,
        "the seat is one a wearer is sitting on": placement and seated == wearers,
        "a listed member that is not running anchors nothing": placement and not (seated & (listed - wearers)),
    }
    wrong = sorted(k for k, ok in seats.items() if not ok)
    check("socket-follows-crew", "the socket follows the crew, not the roster",
          crewed == "session-corpus-crew" and not wrong,
          ", ".join(wrong) or f"{crewed} on {seat}")

    s.eng = eng
    return checked


