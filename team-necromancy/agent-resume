@unit(('synthetic-sockets-do-not-couple-engines',
       'two engines on two fixtures keep their own socket sets'),
      ('synthetic-sockets-never-delegate',
       'every fixture answers socket discovery, empty or not'))
def _check_synthetic_sockets_do_not_couple_engines(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    # Two fixtures, two engines, no shared state between them. The socket
    # answer is an engine input, so getting this wrong would not fail loudly:
    # one unit's sockets would simply start appearing in another's answers.
    ours, theirs = (_FakeTmux(sockets=["claude-swarm-ours"]),
                    _FakeTmux(sockets=["claude-swarm-theirs"]))
    mine, yours = (Resolver(needs=Needs(maybe=set(NEED))),
                   Resolver(needs=Needs(maybe=set(NEED))))
    ours.attach(mine)
    theirs.attach(yours)
    apart = {
        "each engine lists only its own socket":
            [p.name for p in mine._swarm_sockets()] == ["claude-swarm-ours"]
            and [p.name for p in yours._swarm_sockets()] == ["claude-swarm-theirs"],
        "each engine calls only its own socket live":
            mine._socket_alive("claude-swarm-ours")
            and not mine._socket_alive("claude-swarm-theirs")
            and yours._socket_alive("claude-swarm-theirs")
            and not yours._socket_alive("claude-swarm-ours"),
        # attach replaces an input on one engine. If it ever reached further,
        # the process-wide resolver would start answering with a fixture's
        # sockets and no unit here would be the one to fail.
        "the process-wide resolver still answers for itself":
            RESOLVER._swarm_sockets.__func__ is Resolver._swarm_sockets,
    }
    astray = sorted(name for name, ok in apart.items() if not ok)
    check("synthetic-sockets-do-not-couple-engines",
          "two engines on two fixtures keep their own socket sets",
          not astray, ", ".join(astray))

    # An empty fixture is the case that would go wrong quietly. A fixture with
    # sockets obviously answers; one with none could be read as having nothing
    # to say, fall through to the machine's socket directory, and make a unit's
    # result depend on whatever tmux servers happen to be running on the box.
    bare = Resolver(needs=Needs(maybe=set(NEED)))
    _FakeTmux().attach(bare)
    replaced = {
        "an empty fixture still lists the sockets": bare._swarm_sockets() == [],
        "an empty fixture still answers liveness":
            bare._socket_alive("claude-swarm-anything") is False,
        "neither answer is still the engine's own":
            getattr(bare._swarm_sockets, "__func__", None)
            is not Resolver._swarm_sockets
            and getattr(bare._socket_alive, "__func__", None)
            is not Resolver._socket_alive,
    }
    # Structural, because the runtime facts above only prove today's fixture.
    # A conditional reintroduced around either assignment would restore the
    # fall-through for every fixture that did not opt in.
    ast_, tree = s.ast, s.tree
    fixture = next((node for node in ast_.walk(tree)
                    if isinstance(node, ast_.ClassDef) and node.name == "_FakeTmux"), None)
    attaching = next((node for node in (fixture.body if fixture else [])
                      if isinstance(node, ast_.FunctionDef) and node.name == "attach"), None)
    # Assigned as plain statements of attach's body. Wrapped in an if, they
    # would no longer be here, which is exactly the shape being ruled out.
    # Both halves of each assignment are read, not just the name being
    # replaced: an assignment that kept the left side and took its value from
    # somewhere else, the engine's own method or another object's, would pass
    # a check that only looked at what was being assigned to.
    plainly = {(target.attr, node.value.attr)
               for node in (attaching.body if attaching else [])
               if isinstance(node, ast_.Assign)
               and isinstance(node.value, ast_.Attribute)
               and isinstance(node.value.value, ast_.Name)
               and node.value.value.id == "self"
               for target in node.targets
               if isinstance(target, ast_.Attribute)
               and isinstance(target.value, ast_.Name)
               and target.value.id == "engine"}
    replaced["both answers are assigned from this fixture, with no branch"] = (
        {("_swarm_sockets", "socket_paths"),
         ("_socket_alive", "socket_is_alive")} <= plainly)

    # Canaries where a delegation would land: an engine with socket answers of
    # its own that record being called and then refuse. attach replaces both,
    # so a composite socket question asked afterwards is answered out of the
    # fixture and reaches neither. This is the half the structural test cannot
    # give: that the engine's own discovery question consumes those two inputs
    # rather than finding sockets some other way.
    reached = []

    def refuse_listing():
        reached.append("_swarm_sockets")
        raise AssertionError("the engine's own socket listing was reached")

    def refuse_liveness(_socket):
        reached.append("_socket_alive")
        raise AssertionError("the engine's own liveness probe was reached")

    canary = Resolver(needs=Needs(maybe=set(NEED)))
    canary._swarm_sockets, canary._socket_alive = refuse_listing, refuse_liveness
    _FakeTmux(sockets=["claude-swarm-canary"]).attach(canary)
    try:
        newest = canary._newest_live_socket()
    except AssertionError as refused:
        newest = str(refused)
    replaced["the engine's own socket question reaches neither"] = (
        newest == "claude-swarm-canary" and not reached)
    missing = sorted(name for name, ok in replaced.items() if not ok)
    check("synthetic-sockets-never-delegate",
          "every fixture answers socket discovery, empty or not",
          not missing, ", ".join(missing) + f"; assigned {sorted(plainly)}")
    return checked


@unit(('seat-finds-wrapped-agent',
       'the seat resolver finds an agent wrapped inside the pane root process'))
def _check_seat_finds_wrapped_agent(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    socket = "claude-swarm-seat-fixture"
    # Concurrent suites must not match each other's fixture processes.
    team = f"session-corpus-seat-{os.getpid()}"
    session = f"0e5e5e5e-5e5e-45e5-8e5e-{os.getpid():012x}"
    agent_id = f"wrapped@{team}"
    argv = (FAKE_AGENT_BIN, "-c", "import time; time.sleep(90)",
            "--resume", session, "--agent-id", agent_id)
    # A parent that starts the agent and waits on it, start_wrapped, so the
    # agent is a real child of a real process. Whether the resolver walks from
    # a pane's root process down to an agent running inside it is the one
    # fact a synthetic table cannot honestly stand in for. The socket, the
    # pane and the pane root all come from the fixture.

    def is_the_agent(row):
        """The agent itself, not the parent that started it.

        Both wear the same four trailing arguments, because the parent was
        handed them to pass on. Only the child wears the agent binary, so
        waiting on the tail alone returns the moment the parent exists and the
        table gets read before the agent is in it.
        """
        return row[2][0] == FAKE_AGENT_BIN and tuple(row[2][-4:]) == argv[-4:]

    base = Path(tempfile.mkdtemp())
    started, made, started_pid, started_at = None, [], None, ""
    try:
        projects = base / "projects" / "corpus"
        projects.mkdir(parents=True)
        (base / "teams" / team / "inboxes").mkdir(parents=True)
        (base / "teams" / team / "config.json").write_text(json.dumps({
            "name": team, "leadAgentId": f"team-lead@{team}",
            "leadSessionId": "0f6f6f6f-6f6f-46f6-8f6f-6f6f6f6f6f6f",
            "createdAt": 1,
            "members": [{"agentId": agent_id, "name": "wrapped"}]}))
        (projects / f"{session}.jsonl").write_text(
            fixture_line({"parentUuid": None, "type": "user", "uuid": session,
                          "sessionId": session, "agentName": "wrapped",
                          "teamName": team,
                          "timestamp": "2026-01-01T00:00:00Z"}) + "\n")
        # Its own process group, read as it starts, so the cleanup ends
        # exactly what this started; should the run stop first, it is still
        # under the run.
        started = start_wrapped(argv)
        started_pid = started.pid
        started_at = _ProcessFence.start_time(started_pid)
        made.append(started_pid)

        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._projects_dir, eng._teams_dir = base / "projects", base / "teams"
        table, agent, holder = (), {}, None
        deadline = time.time() + 10
        while time.time() < deadline:
            table = eng._process_table(refresh=True)
            if any(is_the_agent(row) for row in table):
                break
            time.sleep(0.05)
        made.extend(row[0] for row in table if is_the_agent(row))

        fake = _FakeTmux(panes=[{"session": TMUX_SESSION, "window": "0",
                                 "pane": "%0", "pid": started.pid}],
                         processes=table, sockets=[socket])
        with fake.installed(eng):
            agent = eng._agent_runtime(agent_id, table)
            holders = eng._runtime(table)["transcripts"].get(
                session, {"others": [], "ours": []})
            holder = holders["others"][0] if holders["others"] else None
    finally:
        if started is not None:
            # The group and every descendant, asked and then made to stop. The
            # group and not the process: ending the parent alone leaves the
            # agent it started running, which is the leak asserted on below.
            end_process_tree(started.pid, started_at)
            if started.poll() is None:
                started.kill()
            started.wait()
        shutil.rmtree(base, ignore_errors=True)

    # Asked after the teardown: what a fixture that spawns leaves behind is
    # what the next unit trips over.
    left = sorted({row[0] for row in RESOLVER._process_table(refresh=True)} & set(made))
    # Ended here, so that what the teardown left is in no later unit's view.
    end_left_behind(left)
    records = agent.get("records") or ()
    # Found by its exact pid, not by argv shape. Shape would go ambiguous
    # between wrapper and child precisely when the argv[0] condition is the
    # thing removed, which is the condition this fact exists to test.
    wrapper_row = next((row for row in table if row[0] == started_pid), None)
    facts = {
        "the wrapped agent was observed": bool(records),
        "it keeps its exact argv tuple":
            bool(records) and tuple(records[0]["argv"][-4:]) == argv[-4:],
        "the fixture's pane and its real occupant form one seat":
            agent.get("seats") == (Seat(socket, "%0"),),
        "agent and transcript answers share one record":
            holder is not None and bool(records) and holder is records[0],
        # The wrapper was given the same four trailing flags to pass on, so it
        # wears them too. Ruling it out here tests the argv[0] half of
        # is_the_agent directly, rather than leaving it to whether the child
        # happened to have started by the time the table was read.
        "the wrapper wearing the same flags is not the agent":
            wrapper_row is not None and not is_the_agent(wrapper_row)
            and started_pid not in {record["pid"] for record in records},
        "nothing it started is still running": not left,
    }
    wrong = sorted(name for name, ok in facts.items() if not ok)
    check("seat-finds-wrapped-agent",
          "the seat resolver finds an agent wrapped inside the pane root process",
          not wrong,
          "; ".join(wrong + ([f"seats {agent.get('seats')!r}, left {left}"]
                             if wrong else [])))
    return checked


