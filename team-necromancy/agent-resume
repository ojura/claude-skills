    mismatched = []
    for label, needs in declarations:
        strongest = (DECLARED.HARD if any(
            needs[need] is DECLARED.HARD for need in (NEED.STAMPS, NEED.SPAWNS))
            else DECLARED.MAYBE if any(
                needs[need] is DECLARED.MAYBE for need in (NEED.STAMPS, NEED.SPAWNS))
            else DECLARED.ABSENT)
        if strongest is not DECLARED.ABSENT and needs[NEED.CONVERSION_CENSUS] is not strongest:
            mismatched.append(f"{label}:{strongest.name}->{needs[NEED.CONVERSION_CENSUS].name}")
