@unit(('lead-rebind-crew-report', 'a lead move names the crew it leaves behind'), ('lead-rebind-guards', "a live-membered team still blocks a lead's reap"), ('lead-rebind-kill-gate', 'a lead move ends the holder only after it is agreed to'), ('lead-address-spelling-moves-nothing', 'a team named inside an agent id addresses a lead without moving it'), ('lead-routing-one-operation', 'lead routing uses one complete operation instead of generic rebind helpers'), ('lead-move-crew-remedies-match-the-planner', "a lead move's crew report offers moving the crew only as the planner would make that move, with the flags it needs, and names --keep-team"))
def _check_lead_rebind_crew_report(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    corpus_engine = s.corpus_engine

    GHOST = 999999999
    STRANGER = "d00fd00f-d00f-4d0f-8d0f-d00fd00fd00f"
    LEAD_STAMPED = "1e5701ed-1fe5-4701-8ed1-e5701ed1fe57"

    def stamped_stranger(root):
        """A member of session-corpus-alpha the roster does not list, with mail
        waiting for it, so neither report line can be answered from the roster.
        Planted per run rather than in the shared corpus, which every other
        check counts."""
        (root / "projects" / "corpus" / f"{STRANGER}.jsonl").write_text("\n".join(
            fixture_line(rec) for rec in (
                {"type": "user", "uuid": "dr-root", "parentUuid": None,
                 "timestamp": "2026-04-01T00:00:00Z", "sessionId": STRANGER,
                 "agentName": "drift", "teamName": "session-corpus-alpha",
                 "message": {"role": "user", "content": "hi"}},
                {"type": "last-prompt", "leafUuid": "dr-root", "sessionId": STRANGER,
                 "lastPrompt": "hi"})) + "\n")
        (root / "teams" / "session-corpus-alpha" / "inboxes" / "drift.json").write_text(
            json.dumps([{"id": "m1", "from": "team-lead", "text": "still there?",
                         "timestamp": "2026-04-02T00:00:00Z"}]))

    def planner_offer(seen):
        """team_run_plan's decision for moving the crew, in the world the lead
        move left: the flags under which it moves someone, or None."""
        def look(_root):
            RESOLVER.refresh_transcript_evidence()
            for archive in (False, True):
                chosen = RESOLVER.team_run_plan(
                    "session-corpus-alpha", all_members=True,
                    redirect=MemberRedirectRequest(
                        kind="explicit", destination="session-corpus-crew",
                        archive_mail=archive))["redirect"]
                if chosen["action"] == "redirect" and chosen["moving"]:
                    seen.append(("--with-mail",) if archive else ())
                    return
            seen.append(None)
        return look

    def report_offer(said):
        """The flags the crew report names for moving the crew, or None."""
        found = re.search(rf"remedy {re.escape(TOOL)} session-corpus-alpha --into-team "
                          r"session-corpus-crew --all((?: --[a-z-]+)*) moves them",
                          " ".join(without_wrap_arrows(said).split()))
        return tuple(found.group(1).split()) if found else None

    real_receipts = RECEIPTS_DIR
    lead_receipts = Path(tempfile.mkdtemp())
    globals()["RECEIPTS_DIR"] = lead_receipts
    real_stdin, real_input = sys.stdin, globals().get("input")
    try:
        base_seen = []
        moved, _entry, _srv, moved_said = resume_run(
            "team-lead@session-corpus-alpha", to_team="session-corpus-crew",
            prepare=stamped_stranger, inspect=planner_offer(base_seen))
        # Everyone the engine says session-corpus-alpha has, plus the member
        # this run planted into the copy. The lead is the one that moves, so it
        # is the one name that must not be listed as staying.
        expected = (set(corpus_engine()._team_runtime("session-corpus-alpha")["population"])
                    | {"drift"}) - {"team-lead"}
        crew_line = next((each for each in moved_said.splitlines() if each.startswith("crew ")), "")
        missing = sorted(n for n in expected if n not in crew_line)
        told = " ".join(moved_said.split())
        if moved != "manual":
            missing.append(f"the move did not reach its launch ({moved})")
        if "team-lead" in crew_line:
            missing.append("the lead itself is listed as staying behind")
        if "1 waiting for drift" not in told:
            missing.append("the mail waiting on the old team is not named")
        if "--keep-team on each member" not in told:
            missing.append("the way to keep one where it is is not named")
        check("lead-rebind-crew-report", "a lead move names the crew it leaves behind",
              not missing, ", ".join(missing[:3]))

        # The corpus crew team names no lead session, so a member moved onto it
        # would have no parent, and the planner refuses that move. With a lead
        # session recorded the move can be made, and the report offers it.
        def crew_led(root):
            stamped_stranger(root)
            cfg = root / "teams" / "session-corpus-crew" / "config.json"
            data = json.loads(cfg.read_text())
            data["leadSessionId"] = LEAD_STAMPED
            cfg.write_text(json.dumps(data))

        led_seen = []
        led, _entry, _srv, led_said = resume_run(
            "team-lead@session-corpus-alpha", to_team="session-corpus-crew",
            prepare=crew_led, inspect=planner_offer(led_seen))
        led_told = " ".join(led_said.split())
        crew_remedies = {
            "without a lead session neither the report nor the planner moves them": (
                base_seen == [None] and report_offer(moved_said) is None
                and "moving them is refused: team session-corpus-crew has no selected "
                    "lead session" in " ".join(without_wrap_arrows(moved_said).split())),
            "with one the report names the flags the planner needs": led == "manual"
                and led_seen == [report_offer(led_said)] and led_seen != [None],
            "and --keep-team is named either way": "--keep-team on each member" in told
                and "--keep-team on each member" in led_told,
        }
        check("lead-move-crew-remedies-match-the-planner",
              "a lead move's crew report offers moving the crew only as the planner would "
              "make that move, with the flags it needs, and names --keep-team",
              all(crew_remedies.values()),
              ", ".join(sorted(k for k, ok in crew_remedies.items() if not ok))
              + f"; planner {base_seen} then {led_seen}, report {report_offer(moved_said)} "
                f"then {report_offer(led_said)}")

        # The guards, unchanged, reached through the lead path: one live member
        # of the team the stamps name, and the reap it would need refuses.
        alive_member = [(PID_CEILING + 4242, 1,
                         (FAKE_AGENT_BIN, "--agent-id", "willow@session-corpus-alpha"))]
        try:
            blocked, _e, _s, blocked_said = resume_run(
                "team-lead@session-corpus-alpha", resume=LEAD_STAMPED,
                to_team="session-corpus-crew", table=alive_member)
        except OSError as err:
            # A reap that happened anyway takes the roster the harness reads
            # back; say so as a failure rather than as a traceback.
            blocked, blocked_said = f"crashed: {err.__class__.__name__}", ""
        told = " ".join(blocked_said.split())
        held = []
        if blocked != "refused":
            held.append(f"a live-membered team did not block the move ({blocked})")
        for owed in (f"pid {PID_CEILING + 4242} runs as it", "--force instead rewrites"):
            if owed not in told:
                held.append(f"the refusal does not say {owed!r}")
        if (lead_receipts / "session-corpus-alpha.json").exists():
            held.append("the team was retired anyway")
        check("lead-rebind-guards", "a live-membered team still blocks a lead's reap",
              not held, ", ".join(held[:3]))

        # The kill gate: a live holder of the lead's own conversation, and the
        # three answers it can get. None of them kills.
        holder = [(GHOST, 1, (FAKE_AGENT_BIN, "--resume", LEAD_STAMPED))]

        def moved_onto_holder(**over):
            _st, _e, _s, out = resume_run(
                "team-lead@session-corpus-alpha", resume=LEAD_STAMPED,
                to_team="session-corpus-crew", table=holder, **over)
            return " ".join(out.split())

        gate = []
        sys.stdin = types.SimpleNamespace(isatty=lambda: True)
        globals()["input"] = lambda prompt="": "n"
        answered_no = moved_onto_holder()
        globals()["input"] = lambda prompt="": "y"
