@unit(('mail-mid-removal-not-deleted', 'mail arriving mid-removal is not deleted'), ('completion-agent-once', 'completion offers each agent once'), ('cruft-mail', 'cruft check: mail'), ('cruft-notjson', 'cruft check: notjson'), ('cruft-pure', 'cruft check: pure'), ('cruft-stray', 'cruft check: stray'))
def _check_mail_mid_removal_not_deleted(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        cases = {
            "pure": ({"team-lead.json": "[]"}, None, None),
            "mail": ({"team-lead.json": '[{"from":"x"}]'}, None, "undelivered"),
            "stray": ({"team-lead.json": "[]"}, "notes.txt", "unexpected"),
            "notjson": ({"team-lead.txt": "x"}, None, ".json"),
        }
        # The cleanup action selects its generation before the cut. A message
        # written into the staged copy must make that selected action refuse.
        race = base / "race"
        inbox = race / "inboxes" / "team-lead.json"
        inbox.parent.mkdir(parents=True)
        (race / "config.json").write_text(json.dumps({
            "name": "race", "leadSessionId": "missing", "members": [{
                "name": "team-lead", "agentId": "team-lead@race"}]}))
        inbox.write_text("[]")
        real_resolver = globals()["RESOLVER"]
        eng = Resolver(needs=Needs(maybe=set(NEED)))
        eng._teams_dir, eng._projects_dir = base, base / "projects"
        eng._projects_dir.mkdir()
        eng._process_table = lambda refresh=False: ()
        eng._dead_sockets = lambda: ()
        eng._made_moments_ago = lambda path: False
        real_cut = eng.revalidate_cleanup_cut

        def racing(action, staged):
            (staged / "inboxes" / "team-lead.json").write_text('[{"from":"x"}]')
            return real_cut(action, staged)

        globals()["RESOLVER"] = eng
        try:
            cleanup = eng.cleanup_plan()
            action = next(item for item in cleanup["team_actions"]
                          if item["team_dir"] == race)
            eng.revalidate_cleanup_cut = racing
            with capturing("err"):
                removed = remove_cleanup_action(action, False)
        finally:
            pass
        check("mail-mid-removal-not-deleted", "mail arriving mid-removal is not deleted",
              not removed and race.exists() and inbox.read_text() != "[]")

        # one row per agent, even when several rosters claim the name
        buffer = io.StringIO()
        with capturing("out", into=buffer):
            run_complete("names")
        names = [line.split("\t")[1].split("@", 1)[0] for line in buffer.getvalue().splitlines() if line]
        check("completion-agent-once", "completion offers each agent once", len(names) == len(set(names)),
              ", ".join(sorted({n for n in names if names.count(n) > 1})))

        for label, (inboxes, stray, expect) in cases.items():
            team = base / label
            (team / "inboxes").mkdir(parents=True)
            (team / "config.json").write_text(json.dumps({"name": label, "members": []}))
            for fname, content in inboxes.items():
                (team / "inboxes" / fname).write_text(content)
            if stray:
                (team / stray).write_text("x")
            reason = RESOLVER._scaffolding_objection(team)
            ok = (reason is None) if expect is None else (reason is not None and expect in reason)
            check(f"cruft-{label}", f"cruft check: {label}", ok, reason or "considered empty")
        globals()["RESOLVER"] = real_resolver
    return checked


