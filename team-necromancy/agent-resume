        (deep / "agent-x.jsonl").write_text(json.dumps(side) + "\n")
        hits = RESOLVER._grep_files(SPAWN_MARKER, [Path(td)], True) or []
        if any("subagents" in p.parts for p in hits):
            leaks.append("the recursive searcher")

        project = Path(td) / "project"
        project.mkdir()
        padding = {"type": "assistant", "isSidechain": False,
                   "message": {"role": "assistant", "content": "x" * 9000}}
        spaced = {"type": "assistant", "isSidechain": False,
                  "agentName": "spaced", "teamName": "session-spaced"}
        mid = project / "mid.jsonl"
        mid.write_text("\n".join((json.dumps(padding), json.dumps(spaced),
                                   json.dumps(padding))) + "\n")
        nested_candidate = project / "nested.jsonl"
        nested_candidate.write_text(json.dumps(nested_only) + "\n")
        engine = Resolver(needs=Needs(maybe=set(NEED)))
        engine._projects_dir = Path(td)
        spaced_hits = engine._stamped_candidates("spaced", "session-spaced")
        nested_hits = engine._stamped_candidates("spoof", "session-spoof")
        structured_fallback = ([path for path, _fields, _ts in spaced_hits] == [mid]
                               and not nested_hits)
    # _last_stamp reads the records a process wrote since it started,
    # backward from the end of its transcript, and takes their stamps through
    # the same rule.
    stamp_owners = s.callers_of("_identity_stamp")
    if stamp_owners != {"_stamps_in", "_scan_transcript",
                        "_derive_transcript_snapshot", "_last_stamp"}:
        leaks.append(f"identity stamp owners {sorted(stamp_owners)}")
    assigned_names = {
        target.id for node in s.ast.walk(s.tree) if isinstance(node, s.ast.Assign)
        for target in node.targets if isinstance(target, s.ast.Name)
    }
    if "STAMP" + "_RE" in assigned_names:
        leaks.append("the raw stamp-value regex remains")
    check("sidechain-not-evidence", "a sidechain line is not evidence", not leaks, ", ".join(leaks))
    check("structured-stamp-fallback",
          "a complete stamp scan ignores JSON spacing and nested lookalikes",
          structured_fallback,
          f"spaced={[path.name for path, _fields, _ts in spaced_hits]}, nested={nested_hits}")
    return checked


