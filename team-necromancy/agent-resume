def own(name):
    """A fixture agent id this run alone answers to.

    An agent id is machine-global, and a stop selects by matching one against
    every process on the box. Two live tiers running at once wear the same id,
    so each one's stop finds the other's processes as well as its own and ends
    them: measured as "aborted 2 of 2" against a check that spawned one. The
    pid makes an id this run owns.
    """
    return f"{name}-{os.getpid()}"


@contextlib.contextmanager
def stop_fixture(count):
    """Real processes a stop plan can select, near misses it must not, and the engine that selects.

    The stop checks need three things at once. Processes the kernel really
    has, because what is under test is stopping one. A corpus, because a
    target's title comes from the transcript its process named and a plan
    built without one has nothing to describe. And no tmux, because asking
    the engine which processes wear an id walks the swarm sockets looking for
    seats, which off a real machine reads every swarm server running on it.

    So the process table is the one input left real and the rest is a world
    with nothing in it. The id carries this run's pid, so a plan built from
    the process table selects these processes and not another run's.

    Two near misses run beside them, also this run's own: one wears the same
    name on another team, one another name on the same team. A plan that
    matched one half of the id selects one of them, and a stop that ended
    more than it listed ends one, whatever else runs on the machine.

    Yields (engine, the id they wear, the processes, the near misses), and
    ends them all itself.
    """
    base = Path(tempfile.mkdtemp(prefix=f"{TOOL}-stop-"))
    shutil.copytree(Path(__file__).resolve().parent / "test" / "corpus", base / "corpus")
    ident = own("probe@session-corpus-alpha")
    # argv[0] is what makes a process a claude, and the binary that runs is
    # python. --resume names a session in the copied corpus, which is what
    # gives the selected record a transcript and so a title.
    victims = [subprocess.Popen(
        [FAKE_AGENT_BIN, "-c", '__import__("time").sleep(30)',
         "--resume", "22222222-2222-4222-8222-222222222222", "--agent-id", ident],
        executable=sys.executable) for _ in range(count)]
    near = [subprocess.Popen(
        [FAKE_AGENT_BIN, "-c", '__import__("time").sleep(30)', "--agent-id", own(miss)],
        executable=sys.executable)
        for miss in ("probe@session-corpus-beta", "other@session-corpus-alpha")]
    engine = Resolver(needs=Needs(maybe=set(NEED)))
    engine._projects_dir = base / "corpus" / "projects"
    engine._teams_dir = base / "corpus" / "teams"
    real_table = engine._process_table
    try:
        for started in victims + near:
            wait_for_command_line(started.pid)
        with _FakeTmux(sockets=[]).installed(engine):
            engine._process_table = real_table
            yield engine, ident, victims, near
    finally:
        for victim in victims + near:
            with contextlib.suppress(OSError):
                victim.kill()
            victim.wait()
        shutil.rmtree(base, ignore_errors=True)


# The team component every fixture identity carries, and nothing real does.
FIXTURE_TEAM = "session-corpus-"


def fixture_worn(cmd):
    """The fixture agent id one process wears, from its exact argv.

    argv is a tuple of arguments, so `"session-corpus-" in cmd` asks whether
    one whole argument is that string, which none ever is. Reading the flag and
    the argument after it answers the question that was meant, and refuses an
    id that only appears inside a shell -c string or some other argument, which
    a substring test over a joined command line would have counted.
    """
    for at, part in enumerate(cmd):
        if part == "--agent-id" and at + 1 < len(cmd):
            worn = cmd[at + 1]
            _name, team = name_and_team(worn)
            if team and team.startswith(FIXTURE_TEAM):
                return worn
    return None


