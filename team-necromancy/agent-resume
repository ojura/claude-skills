        told["a value that is not a whole number is refused without a read"] = (
            answers == [(None, None, None)] * len(no_pids)
            and [pid for _unit, _reader, pid in fence.refused[before:]]
            == [repr(value) for value in no_pids])
        before = len(fence.refused)
        told["this run's own process is read"] = eng._proc_stat(os.getpid())[0] is not None
        told["and so is a process it started"] = (
            eng._proc_stat(child.pid)[0] is not None and "sleep" in eng._cmdline(child.pid))
        gone = subprocess.Popen(["true"], stdin=subprocess.DEVNULL)
        gone.wait()
        told["one it started that has gone reads as gone, with no command line or environment"] = (
            eng._proc_stat(gone.pid) == (None, None, None) and eng._cmdline(gone.pid) == ()
            and eng._proc_env(gone.pid, ("PATH",)) == {})
        told["and none of those was refused"] = len(fence.refused) == before
        # A pid the run knows is judged by the start time it learned: pid 1,
        # outside the run, is read while that is its own start, and refused
        # once the start the run learned is another process's.
        fence.known[stranger] = _ProcessFence._start_of(stranger)
        told["a pid the run knows is read while it is the process the run learned"] = (
            eng._proc_stat(stranger)[0] is not None and len(fence.refused) == before)
        fence.known[stranger] = "a start time it never had"
        eng._proc_stat(stranger)
        told["and refused once another process holds its number"] = (
            [(reader, pid) for _unit, reader, pid in fence.refused[before:]]
            == [("stat", stranger)])
        del fence.known[stranger]
        before = len(fence.refused)
        world = _FakeTmux(panes=[{"session": TMUX_SESSION, "window": "@0", "pane": "%0",
