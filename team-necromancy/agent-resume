            source_session, destination_session = "fixture-source-lead", "fixture-destination-lead"
            transcript("source", source_session, source)
            transcript("destination", destination_session, destination)
            roster(source, source_session)
            roster(destination, destination_session)
            versions = {}
            eng._pid_alive = lambda _pid, procstart=None: True
            eng._proc_start = lambda _pid: 1
            eng._own_lineage = lambda _table: set()
            eng._seat_index = lambda _table: {}
            eng._session_registry = lambda: []
            eng._tmux_server_fact = lambda socket: immutable({
                "socket": socket, "path": Path("/tmp") / socket,
                "socket_generation": versions.get(socket, ("fixture", socket)),
                "alive": False, "server": None, "session_live": False,
                "panes": (), "base_url": "", "clients": 0, "state": "no server",
            })
            table = ((PID_CEILING + 525252, 1, (FAKE_AGENT_BIN, "--resume", source_session,
                                  "--agent-id", lead_id)),)
            eng._process_table = lambda refresh=False: table
            launch = eng.launch_plan(
                agent_id=lead_id, table=table, terminal=TerminalContext())
            request = LeadMigrationRequest(destination=destination)
            plan = eng.lead_migration_plan(launch, request)
            before = eng.revalidate_lead_migration(plan)
            after = eng.revalidate_lead_migration(plan, after_clear=True)
            dry_completion = eng.complete_lead_migration(Applied(
                operation="lead-migration", plan=plan, confirmation=True, dry_run=True))
            live_completion = eng.complete_lead_migration(Applied(
                operation="lead-migration", plan=plan, confirmation=True))

            expected_callers = {
                "lead_migration_plan": ("run_one",),
                "revalidate_lead_migration": ("lead_rebind",),
                "complete_lead_migration": ("lead_rebind",),
            }
            observed = {question: tuple(sorted(s.resolver_calls.get(question, ())))
                        for question in expected_callers}
            registered = {question: PUBLIC_RESOLVER_QUESTIONS.get(question)
                          for question in expected_callers}
            forbidden = {
                name: tuple(sorted(s.resolver_calls.get(name, ())))
                for name in ("retarget_launch", "rebind_plan", "revalidate_rebind",
                             "roster_census", "lead_session_for", "roster_snapshot",
                             "sole_mint_pairing")}
            route_facts = (
                plan["request"] is request
                and plan["original_launch"] is launch
                and plan["taking_over"]
                and plan["source"] == source and plan["dest"] == destination
                and plan["launch"]["identity"] is plan["destination_identity"]
                and dry_completion["matches"]
                and observed == expected_callers and registered == expected_callers
                and not any(forbidden.values()))
            rebind = s.funcs["lead_rebind"]
            revalidations = [node for node in s.ast.walk(rebind)
                             if isinstance(node, s.ast.Call)
                             and isinstance(node.func, s.ast.Attribute)
                             and getattr(node.func.value, "id", None) == "RESOLVER"
                             and node.func.attr == "revalidate_lead_migration"]
            pre_post = (
                before["matches"]
                and not after["matches"]
                and any(item.startswith("selected holder pid ") for item in after["changed"])
                and len(revalidations) == 2
                and any(not any(keyword.arg == "after_clear" for keyword in node.keywords)
                        for node in revalidations)
                and any(any(keyword.arg == "after_clear"
                            and isinstance(keyword.value, s.ast.Constant)
                            and keyword.value.value is True
                            for keyword in node.keywords)
                        for node in revalidations)
                and sum(1 for node in s.ast.walk(rebind)
                        if isinstance(node, s.ast.Call)
                        and isinstance(node.func, s.ast.Attribute)
                        and getattr(node.func.value, "id", None) == "RESOLVER"
                        and node.func.attr == "complete_lead_migration") == 1)
            # A rewrite has to reproduce every other byte of the transcript, so
            # one with bytes that are not UTF-8 cannot be restamped, though the
            # first record of its restored window is still stamped with its
            # team. --force drops the live wearer as a blocker, so the rebind
            # reaches the rewrite and the rewrite is what refuses. That refusal
            # has to come before any holder is stopped, or a lead loses its
            # session to a move that was never going to happen.
            plain = "session-lead-fixture-plain"
            plain_session = "fixture-plain-lead"
            plain_id = agent_id_of("team-lead", plain)
            plain_path = transcript("plain", plain_session, plain)
            plain_path.write_bytes(plain_path.read_bytes() + fixture_line({
                "parentUuid": f"{plain_session}-root", "type": "user",
                "uuid": f"{plain_session}-tail", "sessionId": plain_session,
                "timestamp": "2026-01-01T00:00:01Z",
                "message": {"role": "user", "content": "tail"}}).encode()
                .replace(b"tail\"}", b"tail\xff\"}") + b"\n")
            roster(plain, plain_session)
            plain_table = (
                (PID_CEILING + 626262, 1, (FAKE_AGENT_BIN, "--resume", plain_session,
                             "--agent-id", plain_id)),
                (PID_CEILING + 626263, 1, (FAKE_AGENT_BIN, "--agent-id",
                             agent_id_of("observer", plain))),
            )
            eng._process_table = lambda refresh=False: plain_table
            plain_launch = eng.launch_plan(
                agent_id=plain_id, table=plain_table, terminal=TerminalContext())
            plain_plan = eng.lead_migration_plan(
                plain_launch, LeadMigrationRequest(
                    destination=destination, force=True, archive_mail=True))
            plain_rebind = plain_plan["rebind"]
            restamp = plain_rebind["restamp"] if plain_rebind else None
            blocked = bool(
                plain_rebind and plain_rebind["action"] == "blocked"
                and restamp is not None and not restamp["proved"]
                and restamp["objections"]
                and any("rewrite" in row["kinds"]
                        for row in plain_rebind["blockers"])
                and len(plain_rebind["alive"]) == 1
                and not plain_rebind["held"] and not plain_rebind["mail"])
            before_bytes = plain_path.read_bytes()
            before_generation = plain_plan["transcript_generation"]
            kills = []
            real_resolver, real_kill = globals()["RESOLVER"], globals()["kill_holder"]
            refused = ""
            try:
                globals()["RESOLVER"] = eng
                globals()["kill_holder"] = lambda *a, **k: kills.append(a)
                with capturing("err"):
                    lead_rebind(plain_plan, types.SimpleNamespace(dry_run=False))
            except Refusal as exc:
                refused = str(exc)
            finally:
                globals()["RESOLVER"] = real_resolver
                globals()["kill_holder"] = real_kill
            unstamped = bool(
                blocked and refused
                and plain_path.read_bytes() == before_bytes
                and eng._file_generation(plain_path) == before_generation
                and not kills)
            detail = (
                f"callers={observed}, registered={registered}, forbidden={forbidden}; "
                f"before={before['changed']}, after={after['changed']}, "
                f"dry={dry_completion['changed']}, live={live_completion['changed']}; "
                f"blocked={blocked}, refused={refused!r}, kills={len(kills)}, "
                f"restamp={dict(restamp) if restamp else None}")
    except BaseException as exc:
        route_facts = pre_post = unstamped = False
        detail = f"raised {type(exc).__name__}: {exc}"

    check("lead-migration-plan-reuses-selected-route-facts",
          "lead migration retains one selected route and only its approved callers",
          route_facts, detail)
    check("lead-migration-revalidates-before-stop-and-after-clear",
          "lead migration checks retained facts before stopping and after clearing holders",
          pre_post, detail)
    check("lead-migration-unstamped-refuses-before-any-stop",
          "an unrewritable lead transcript refuses before a holder is stopped",
          unstamped, detail)
    return checked


@unit(('transcript-pick-engine-only', 'only the engine picks a transcript'))
def _check_transcript_pick_engine_only(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    callers_of = s.callers_of
    tree = s.tree

    engine_node = next(node for node in ast.walk(tree)
                       if isinstance(node, ast.ClassDef) and node.name == "Resolver")
    engine = {m.name for m in engine_node.body if isinstance(m, ast.FunctionDef)}
    # run_selftest and run_census observe the engine rather than resolve with it:
    # they ask what it answers in order to report on it, which is the opposite of
    # a caller picking a transcript for itself.
    pickers = (callers_of("transcript_path") - engine
               - {"team_keep_reason", "run_census"} - s.suite_fns)
    check("transcript-pick-engine-only", "only the engine picks a transcript", not pickers, ", ".join(sorted(pickers)))

    s.engine_node = engine_node
