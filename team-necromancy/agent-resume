    declined_once = (
        code == 0 and len(plans) == 1 and decision["action"] == "blocked"
        and len(prompts) == 1 and "[y/N]" in prompts[0]
        and "would reap" not in told and "m6 launched" in told
        and decided_first(events) and "retire" not in events)
    check('team-run-decides-redirect-once', asked_once and declined_once,
          f"{detail}; blocked: code {code}, plans {len(plans)}, prompts {prompts}, "
          f"in order {events}, said {told[-700:]}")

    # The crew's team has no roster left, and its lead now runs as DESTTEAM by
    # a spawn it made after it started; the members follow without a rebuild.
    lead_conv, dest, source = ("1ead3333-0000-4000-8000-000000000003",
                               "DESTTEAM", "session-1ead3333")
    with _roster_test_fixture() as f:
        f.config(dest, {"name": dest, "createdAt": start - 7_200_000,
                        "leadSessionId": lead_conv,
                        "members": [{"name": "team-lead", "agentId": f"team-lead@{dest}"}]})
        operating_conversation(f, start, lead_conv,
                               spawns=((source, -3_600_000), (dest, 5_000)))
        for name in ("m3", "m4"):
            operating_conversation(f, start, f"{name}-conv", name, source)
        f.fake.processes[:] = [(4309302, 1, (FAKE_AGENT_BIN, "--resume", lead_conv))]
        f.fake.started[4309302] = start
        code, told, prompts, plans, _events = team_run(f, source)
        decision = plans[0]["redirect"] if plans else None
        rebuilt = f.engine._roster_snapshot(source).state
        # One of its members resumed on its own: the move is decided before
        # the member's team would be rebuilt for it.
        alone = io.StringIO()
        try:
            with capturing("out", into=alone), capturing("err", into=alone):
                single = run_one(_Run(agent_id=f"m3@{source}", dry_run=True,
                                      socket="claude-swarm-test"),
                                 [], tuple(f.fake.processes)).status
        except Refusal as exc:
            single = f"refused: {exc}"
        alone_said = " ".join(without_wrap_arrows(alone.getvalue()).split())
    check('member-follows-its-lead-without-rebuilding-its-team',
          single == "launched" and "would rebuild" not in alone_said
          and "would reap" not in alone_said and f"--team-name {dest}" in alone_said,
          f"status {single}, said {alone_said[-700:]}")
    check('team-move-into-team-decides-once', *explicit_move(start))
    check('team-move-settles-stops-before-retiring', *stops_settled_first(start))
    check('team-run-rebuilds-no-team-it-retires', *retired_team_stays_retired(start))
    check('team-run-leaves-a-team-it-moves-from-unrebuilt',
          code == 0 and len(plans) == 1 and decision["action"] == "redirect"
          and decision["destination"] == dest and not prompts
          and "rebuilding" not in told and "would reap" not in told
          and rebuilt == "absent" and told.count("launched") >= 2,
          f"code {code}, plans {len(plans)}, prompts {prompts}, said {told[-900:]}")
    return checked


