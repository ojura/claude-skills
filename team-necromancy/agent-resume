@unit(('member-redirect-updates-roster-inbox-and-stamp',
       'a member redirect moves the roster entry, carries the mail and '
       'restamps the transcript'))
def _check_member_redirect_through_cli(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    source, dest = "session-corpus-alpha", "session-corpus-redirect-destination"
    willow_session = "22222222-2222-4222-8222-222222222222"
    dest_lead = "0ddddddd-dddd-4ddd-8ddd-dddddddddddd"

    def prepare(corpus):
        """A destination team to move into, and mail worth carrying across."""
        home = corpus / "teams" / dest
        (home / "inboxes").mkdir(parents=True)
        (home / "config.json").write_text(json.dumps({
            "name": dest, "leadAgentId": f"team-lead@{dest}",
            "leadSessionId": dest_lead, "createdAt": 1,
            "members": [{"agentId": f"team-lead@{dest}", "name": "team-lead"}],
        }))
        (corpus / "projects" / "corpus" / f"{dest_lead}.jsonl").write_text(
            fixture_line({"type": "user", "uuid": dest_lead, "parentUuid": None,
                          "sessionId": dest_lead, "agentName": "team-lead",
                          "teamName": dest,
                          "timestamp": "2026-01-01T00:00:00Z"}) + "\n")
        (corpus / "teams" / source / "inboxes" / "willow.json").write_text(
            json.dumps([{"from": "echo", "text": "carry this across"}]))
        # The shared corpus row for willow carries only an id and a name. A row
        # the tool itself wrote carries isActive, and the redirect only marks a
        # source row inactive when it was active to begin with, so a row
        # without the key is never marked and the move looks lossier than it
        # is. Made realistic here rather than in the shared corpus, which other
        # units read for other reasons.
        roster_path = corpus / "teams" / source / "config.json"
        roster = json.loads(roster_path.read_text())
        for member in roster["members"]:
            if member["agentId"] == f"willow@{source}":
                member.update({"isActive": True, "joinedAt": 1,
                               "backendType": "tmux", "tmuxPaneId": "%3"})
        roster_path.write_text(json.dumps(roster))
        # The corpus transcript carries an identity but no cursor, and a
        # restamp rewrites the record the cursor points at. Without one the
        # redirect refuses the rewrite and the move only half lands. That
        # refusal is real behaviour and worth its own unit; it is not the
        # behaviour this one is about, so the cursor is added here rather than
        # given to every other reader of the shared corpus.
        moving = corpus / "projects" / "corpus" / f"{willow_session}.jsonl"
        with moving.open("a") as writing:
            writing.write(fixture_line({
                "type": "last-prompt", "leafUuid": "an-2",
                "sessionId": willow_session}) + "\n")

    after = {}

    def inspect(corpus):
        """Read the results that live in the tree, before resume_run deletes it."""
        for team in (source, dest):
            after[team] = json.loads(
                (corpus / "teams" / team / "config.json").read_text())
        moved = corpus / "projects" / "corpus" / f"{willow_session}.jsonl"
        after["stamp"] = stamped_team(moved)
        after["receipts"] = restamp_receipts(moved)
        after["mail"] = sorted(
            path.name for path in (corpus / "teams" / dest / "inboxes").iterdir())
        after["rows"] = {name: [dict(member) for member in
                                after[name].get("members", ())]
                         for name in (source, dest)}

    # One live wearer of the source lead, holding no transcript, so --force has
    # something real to set aside. A row is all it takes: the guard reads the
    # process table, and spawning a process to be read there costs a process
    # and proves nothing this does not.
    wearing_source = ((PID_CEILING + 909090, 1,
                       (FAKE_AGENT_BIN, "--agent-id", f"team-lead@{source}")),)

    status, _entry, _fake, said = resume_run(
        f"willow@{source}", table=wearing_source, prepare=prepare, inspect=inspect,
        to_team=dest, force=True, with_mail=True, yes=True, no_attach=True)

    def ids(team):
        return [member["agentId"] for member in after.get(team, {}).get("members", ())]

    receipts = after.get("receipts") or ()
    told = {
        "the redirect goes through": status == "launched",
        "the destination roster gains the member": f"willow@{dest}" in ids(dest),
        # Deliberately not "the source roster loses it". The redirect leaves the
        # old entry in place and one claim policy decides which roster owns an
        # agent, which roster-claim-one-policy is the check for. Asserting
        # removal here would pin a behaviour the design does not promise.
        "the transcript comes back as the destination team": after.get("stamp") == dest,
        "it says so in a receipt naming both teams":
            len(receipts) == 1
            and receipts[0]["old"]["teamName"] == source
            and receipts[0]["new"]["teamName"] == dest,
        "the mail comes with it": "willow.json" in after.get("mail", ()),
    }
    rows = after.get("rows", {})
    was = next((row for row in rows.get(source, ())
                if row.get("agentId") == f"willow@{source}"), None)
    now = next((row for row in rows.get(dest, ())
                if row.get("agentId") == f"willow@{dest}"), None)
    told.update({
        # The source row stays, marked no longer current, keeping what it knew.
        # That is what makes the move reversible: a deleted row would leave
        # nothing to go back to, and a row still claiming to be active would
