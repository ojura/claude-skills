@unit(('verb-table-matches-dispatch', 'the verb table holds what main dispatches on'))
def _check_verb_table_matches_dispatch(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    ast = s.ast
    declared = s.declared
    funcs = s.funcs

    # The help answer is not part of the ladder: it is answered before the
    # ladder starts, beside whatever else was typed, so it neither competes
    # with a verb nor has to wait for the question about which verb this is.
    dispatch = [node for node in funcs["main"].body
                if isinstance(node, ast.If)
                and any(isinstance(sub, ast.Return) for sub in ast.walk(node))
                and not any(getattr(n, "attr", None) == "help"
                            for n in ast.walk(node.test))]
    dispatched = {n.attr for node in dispatch for n in ast.walk(node.test)
                  if isinstance(n, ast.Attribute) and getattr(n.value, "id", None) == "args"}
    # The help gate's test names the selectors beside --help, and a selector
    # says which agents a run is about rather than what the run does.
    dispatched -= {"agent_id", "resume", "team"}
    by_first = {opts[0]: tuple(opts) for opts, _on in declared}
    asked = [node.lineno for node in ast.walk(funcs["main"])
             if isinstance(node, ast.Call) and getattr(node.func, "id", None) == "check_one_verb"]
    mirrors = {
        "the table holds the ladder's verbs": dispatched == set(VERBS),
        "the table spells them as the parser does": all(
            by_first.get(spellings[0]) == tuple(spellings) for spellings in VERBS.values()),
        # Asked before the ladder, because once the ladder has returned there
        # is nothing left to refuse.
        "main asks before it dispatches": bool(asked) and bool(dispatch)
            and min(asked) < min(node.lineno for node in dispatch),
    }
    wrong = sorted(k for k, ok in mirrors.items() if not ok)
    check("verb-table-matches-dispatch", "the verb table holds what main dispatches on",
          not wrong, ", ".join(wrong) + (
              f"; differing: {sorted(dispatched ^ set(VERBS))}"
              if dispatched != set(VERBS) else ""))
    return checked


@unit(('help-answers-beside-a-verb', 'asking for the flags is answered whatever else was typed'))
def _check_help_answers_beside_a_verb(s):
    """Driven as command lines, because the property is about argv.

    --help is not in VERBS, so check_one_verb cannot be asked about it; what
    has to hold is that main answers it before the ladder and beside anything
    else. A verb pair with no --help in it is here too, so a run that answered
    everything would fail rather than pass.
    """
    import subprocess as sp
    me = str(Path(__file__).resolve())
    quiet = dict(os.environ, NO_COLOR="1")

    def ran(*argv):
        """(exit code, whether it said the whole help)."""
        out = sp.run([sys.executable, me, *argv], capture_output=True, text=True,
                     env=quiet, stdin=sp.DEVNULL, timeout=60)
        # Both halves: the flags argparse prints, and the notes beside them.
        # Asserting only the usage line would pass a caller that printed the
        # flags and dropped the notes, which is half an answer.
        said = out.stdout
        return out.returncode, ("usage: " in said
                                and __doc__.strip().splitlines()[0] in said)

    beside_after = ran("--doctor", "--help")
    beside_first = ran("--help", "--census")
    short = ran("-h", "--sides", "x")
    alone = ran("--help")
    pair = ran("--doctor", "--census")
    answered = {
        "--help after a verb answers": beside_after == (0, True),
        "--help before a verb answers": beside_first == (0, True),
        "-h beside a verb that takes a value answers": short == (0, True),
        "--help alone still answers": alone == (0, True),
        # The control: without it, a main that answered every command line
        # with the flags would pass everything above.
        "two verbs are still refused": pair[0] == 1 and not pair[1],
        "help is not a verb": "help" not in VERBS,
    }
    wrong = sorted(k for k, ok in answered.items() if not ok)
    return [("help-answers-beside-a-verb",
             "asking for the flags is answered whatever else was typed",
             not wrong, ", ".join(wrong))]


@unit(('two-verbs-refused', 'naming two verbs is refused, naming the ones typed'))
def _check_two_verbs_refused(s):
    checked = []

    def check(cid, name, ok, detail=""):
        checked.append((cid, name, ok, detail))

    class _Verbs:
        """An args with each verb set by whether one of its spellings was typed."""
        def __init__(self, *typed):
            for dest, spellings in VERBS.items():
                setattr(self, dest, any(opt in typed for opt in spellings))

    def verbs_said(*typed):
        """What check_one_verb said about this command line, "" if it let it run."""
        with capturing("err") as told:
            try:
                check_one_verb(_Verbs(*typed), list(typed))
                return ""
            except Refusal:
                return " ".join(told.getvalue().split())

    both = verbs_said("--doctor", "--census")
    backwards = verbs_said("--census", "--doctor")
    aliased = verbs_said("--terminate", "--census")
    three = verbs_said("--doctor", "--census", "--sides")
    collisions = {
        "two verbs are refused": bool(both),
        "the refusal names both": "--doctor" in both and "--census" in both,
        "they are named in the order typed":
            0 <= backwards.find("--census") < backwards.find("--doctor"),
        "an alias is named as typed": "--terminate" in aliased and "--stop" not in aliased,
        "three verbs are all named": all(f in three for f in ("--doctor", "--census", "--sides")),
        # Two pairs that exclude each other for their own reasons.
        "--promote with --demote is refused": bool(verbs_said("--promote", "--demote")),
        "--poison with --unpoison is refused": bool(verbs_said("--poison", "--unpoison")),
        "a verb with its modifiers runs":
            not verbs_said("--selftest", "--failed", "--live", "--list"),
        "a stop with --yes and --dry-run runs": not verbs_said("--stop", "--yes", "--dry-run"),
        "a verb with a selector runs": not verbs_said("--doctor", "session-corpus-alpha"),
        "one verb alone runs": not verbs_said("--census"),
    }
    wrong = sorted(k for k, ok in collisions.items() if not ok)
    check("two-verbs-refused", "naming two verbs is refused, naming the ones typed",
          not wrong, ", ".join(wrong))
    return checked


