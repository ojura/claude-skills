#compdef agent-resume
# Completion for the tool named on the #compdef line above (team-necromancy
# skill). Everything below refers to it as $service, zsh's own name for the
# command being completed, so a rename touches only that line, the function
# name, and this file's name. Candidates come from the
# script itself via the hidden --complete emitter, so the two never drift.
# Emitter lines are either "cand:desc" or "cand<TAB>desc<TAB>ansi-color".
# Display strings are built here (compadd -d): names are padded so the @session
# columns align (globally, across groups sharing one listing), and list-colors
# patterns are generated from those exact displays so per-agent colors match.
#
# The flags are not written out here. They come from the tool, like every other
# candidate: `--complete flags` runs the real parser and prints one line per
# flag, and _agent_resume_flags turns those into _arguments specs. This file
# held a hand-kept copy of all forty-odd of them until it did not have to.
#
# The tool declares two registers of prose for a reason worth keeping: argparse
# help= is the help page, where a flag gets a sentence, and a row= beside it is
# the one line this menu gives it, where it gets a phrase. See offers() in the
# tool. Twenty-one flags differ between the two; the rest declare help= only and
# the menu falls back to it.

# A bare TAB used to offer everything on the machine, which here is 315 rows.
# zsh lists at most LISTMAX rows (100 by default) before it stops and asks "do
# you wish to see all 315 possibilities", then waits for a key, and waiting for
# a key with nothing on screen reads as a hang. A bare TAB now offers the newest
# rows instead. Type one character and the whole corpus is back in play: from
# there zsh is matching against what was typed, so the listing is small anyway.
_RA_BARE_ROWS=48    # most rows a bare TAB takes from one list
_RA_BARE_GROUP=16   # ... and from the selector's teams, and from its leads

# Reading the corpus takes about 0.7s on the machine this was measured on, and
# one TAB asks for it more than once: with three matcher-list specs (what
# oh-my-zsh sets) zsh reruns the whole completion under each until one produces
# matches, so a word matching nothing paid for three full reads. Keep the answer
# while the corpus still looks the same from outside, which is the mtime of the
# teams and projects directories and of their immediate children: 123 stats
# here, and it moves when a session or a team appears or goes. It does not move
# when a transcript that already exists grows, so a "last active" time in a
# description can be up to _RA_CACHE_TTL seconds behind. Titles, join times and
# the "nothing left to resurrect" markers do not drift on that scale.
_RA_CACHE_TTL=60
typeset -g _RA_CACHE_STAMP=
typeset -g _RA_CACHE_AT=0
typeset -gA _RA_CACHE

_ra_stamp() {  # -> stamp (caller's local), or nonzero when it cannot be taken
  local claude=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  local -a st
  zstat -A st +mtime $claude/teams(N) $claude/projects(N) \
        $claude/teams/*(N/) $claude/projects/*(N/) 2>/dev/null || return 1
  stamp="$#st ${(j: :)st}"
}

# A shell's own table dies with the shell, and the first TAB in a new terminal
# is the one being complained about. The same answer goes to a file under the
# same stamp, so a new shell reads that instead of the corpus. Where it goes is
# the cache-path style if the user set one (oh-my-zsh does), so this leaves no
# files anywhere the shell was not already keeping completion caches.
_ra_cache_dir() {  # -> dir (caller's local), or nonzero when there is nowhere to write
  zstyle -s ":completion:*:*:${service}:*" cache-path dir
  : ${dir:=${XDG_CACHE_HOME:-$HOME/.cache}/$service}
  [[ -d $dir ]] || mkdir -p $dir 2>/dev/null || return 1
}

_ra_emit() {  # topic -> its candidate lines in `lines` (caller's local)
  local topic=$1 stamp= dir= body
  # No stamp (no zsh/stat, or neither directory there) leaves stamp empty, and
  # then age is the only thing that can retire an entry: the file is not read or
  # written at all, and the shell's own table stands for _RA_CACHE_TTL seconds.
  _ra_stamp
  if [[ $stamp != $_RA_CACHE_STAMP ]] || (( SECONDS - _RA_CACHE_AT >= _RA_CACHE_TTL )); then
    _RA_CACHE=()
    _RA_CACHE_STAMP=$stamp
    _RA_CACHE_AT=$SECONDS
  fi
  if (( ! ${+_RA_CACHE[$topic]} )) && [[ -n $stamp ]] && _ra_cache_dir; then
    local -a fresh=($dir/${service}-$topic(N.ms-$_RA_CACHE_TTL))
    if (( $#fresh )); then
      body="$(<$fresh[1])"          # stamp on the first line, candidates after it
      [[ ${body%%$'\n'*} == $stamp ]] && _RA_CACHE[$topic]=${body#*$'\n'}
    fi
  fi
  if (( ! ${+_RA_CACHE[$topic]} )); then
    _RA_CACHE[$topic]="$($service --complete $topic 2>/dev/null)"
    # Written aside and renamed, so a second shell reading this at the same
    # moment sees either the old file whole or the new one, never half of one.
    # Nothing is written for an empty answer: a topic with no candidates costs
    # little to ask again, and an emitter that failed would otherwise have its
    # silence served to every shell for the next _RA_CACHE_TTL seconds.
    if [[ -n $dir && -n $_RA_CACHE[$topic] ]]; then
      print -r -- "$stamp"$'\n'"$_RA_CACHE[$topic]" >! $dir/${service}-$topic.$$ 2>/dev/null &&
        mv -f $dir/${service}-$topic.$$ $dir/${service}-$topic 2>/dev/null ||
        rm -f $dir/${service}-$topic.$$ 2>/dev/null
    fi
  fi
  lines=(${(f)_RA_CACHE[$topic]})
}

_agent_resume_flags() {  # -> spec (caller's array): one _arguments spec per flag
  local -a lines parts
  local line flag row completer value
  _ra_emit flags
  for line in $lines; do
    parts=("${(@ps:\t:)line}")
    flag=$parts[1] row=$parts[2] completer=$parts[3] value=$parts[4]
    # _arguments reads a description up to the matching ], so a ] or a
    # backslash inside the prose has to be escaped for it. Nothing else does:
    # each spec is an array element rather than a quoted shell word written out
    # in this file, so an apostrophe is just an apostrophe. The hand-kept list
    # had to break out of its own single quotes for the three flags whose prose
    # has one, and got that right three times out of three; there is now nothing
    # left to get right.
    row=${row//\\/\\\\}
    row=${row//\[/\\[}
    row=${row//\]/\\]}
    if [[ -z $value ]]; then
      spec+=("${flag}[${row}]")
      continue
    fi
    value=${value//:/\\:}   # a colon would end the spec's field early
    case $completer in
      '')  spec+=("${flag}[${row}]:${value}:") ;;
      _*)  spec+=("${flag}[${row}]:${value}:${completer}") ;;   # _files and friends
      *)   spec+=("${flag}[${row}]:${value}:{_agent_resume_topic ${completer} \"${value}\"}") ;;
    esac
  done
}

_ra_parse() {  # line -> cand desc color (caller's locals, via dynamic scope)
  # One split rather than a chain of strips. Reaching the second tab with
  # ${rest#*<tab>} costs a match attempt per character of the description, and
  # descriptions here run to 400 characters: that single expansion was most of
  # what a TAB spent in the shell. Descriptions cannot themselves hold a tab,
  # because session_title collapses every run of whitespace to one space.
  local -a parts
  if [[ $1 == *$'\t'* ]]; then
    parts=("${(@ps:\t:)1}")
    cand=$parts[1] desc=$parts[2] color=$parts[3]
  else
    cand=${1%%:*} desc=${1#*:} color=''
  fi
}

_ra_widths() {  # lines... -> maxname maxid (caller's locals)
  local line cand desc color name
  local -i idlen
  for line; do
    _ra_parse $line
    if [[ $cand == *@* ]]; then
      name=${cand%%@*}
      (( ${#name} > maxname )) && maxname=${#name}
    fi
  done
  # Only zsh knows the terminal width, so the columns are sized here. The name
  # cap has to land before the id width is measured, or one agentName that is
  # really a task description sizes the id column for everybody.
  local -i width=${COLUMNS:-80}
  local -i namecap=$(( width / 4 )) idcap=$(( width / 2 ))
  (( namecap > 24 )) && namecap=24
  (( maxname > namecap )) && maxname=$namecap
  for line; do
    _ra_parse $line
    if [[ $cand == *@* ]] && (( maxname )); then
      name=${cand%%@*}
      idlen=$(( maxname + ${#cand} - ${#name} ))
    else
      idlen=${#cand}
    fi
    (( idlen > maxid )) && maxid=idlen
  done
  (( maxid > idcap )) && maxid=$idcap
}

_ra_render() {  # topic descr session-colour lines...  (maxname/maxid from caller)
  local topic=$1 descr=$2 scolour=$3
  shift 3
  local -a cands disp zls expl
  local line cand desc color name id padded row nameseg sessseg
  local -i width=${COLUMNS:-80}
  for line; do
    _ra_parse $line
    if [[ $cand == *@* ]] && (( maxname )); then
      name=${cand%%@*}
      nameseg=${(r:maxname:)name}
      sessseg="@${cand#*@}"
      id="${nameseg}${sessseg}"
    else
      nameseg=$cand sessseg='' id=$cand
    fi
    padded=${(r:maxid:)id}
    cands+=($cand)
    row="${padded} -- ${desc}"
    (( ${#row} > width - 2 )) && row="${row[1,width-5]}..."
    disp+=($row)
    # Name in the agent's own colour, session column in the cluster's, so a
    # glance groups rows by session even when the headers scroll away.
    if [[ -n $sessseg && -n $scolour ]]; then
      zls+=("=(#b)(${(b)nameseg})(${(b)sessseg}[ ]#)( -- *)=0=${color:-39}=${scolour}=39")
    elif [[ -n $color ]]; then
      zls+=("=(#b)(${(b)padded})( -- *)=0=${color}=39")
    fi
  done
  (( $#zls )) && zstyle ":completion:*:*:${service}:*:$topic" list-colors $zls
  _wanted -V "$topic" expl "$descr" compadd -l -d disp -a cands
}

_agent_resume_topic() {  # single group, self-scoped widths
  local -a lines
  local -i maxname=0 maxid=0
  _ra_emit $1
  (( $#lines )) || return 1
  # Every topic the emitter has is newest first, so the head of the list is what
  # a bare TAB wants. --resume alone offered 791 session transcripts before this.
  [[ -z $PREFIX$SUFFIX ]] && lines=(${lines[1,_RA_BARE_ROWS]})
  _ra_widths $lines
  _ra_render "$1" "$2" "" $lines
}

_agent_resume_selector() {  # names/teams/leads in one call, widths shared
  local -a all n t l s lines
  local -i maxname=0 maxid=0 ret=1
  local line
  # names arrive as "names<TAB>group<TAB>cand<TAB>desc<TAB>colour", already
  # ordered newest session first; keep that order and one array per group.
  local -a groups
  local rest group
  typeset -A grouped
  _ra_emit selector
  all=($lines)
  for line in $all; do
    case $line in
      names$'\t'*)
        rest=${line#*$'\t'}
        group=${rest%%$'\t'*}
        (( ${+grouped[$group]} )) || groups+=($group)
        grouped[$group]+="${rest#*$'\t'}"$'\n'
        n+=(${rest#*$'\t'})
        ;;
      teams$'\t'*)    t+=(${line#*$'\t'}) ;;
      leads$'\t'*)    l+=(${line#*$'\t'}) ;;
    esac
  done
  # Transcripts are only worth listing once you are clearly typing a uuid:
  # hundreds of them would bury the names on a blank tab.
  if (( ${#PREFIX} >= 2 )) && [[ -z ${PREFIX//[0-9a-fA-F-]/} ]]; then
    _ra_emit sessions
    s=($lines)
  fi
  # A bare TAB takes the newest instead of all of it (see _RA_BARE_ROWS). Whole
  # session clusters, and the newest cluster entire however big it is: that is
  # the team this shell is most likely sitting in, and half of it offered is
  # worse than a shorter list that is whole.
  if [[ -z $PREFIX$SUFFIX ]]; then
    local -a kept members
    local -i taken=0
    n=()
    for group in $groups; do
      members=(${(f)${grouped[$group]%$'\n'}})
      (( taken && taken + $#members > _RA_BARE_ROWS )) && break
      kept+=($group)
      n+=($members)
      (( taken += $#members ))
    done
    groups=($kept)
    t=(${t[1,_RA_BARE_GROUP]})
    l=(${l[1,_RA_BARE_GROUP]})
  fi
  _ra_widths $n $t $l $s
  # one colour per session cluster, cycled
  local -a cluster_colours=(36 33 35 32 34 31 96 93)
  local -i i=0
  for group in $groups; do
    (( i++ ))
    _ra_render "names$i" "$group" ${cluster_colours[(( (i - 1) % $#cluster_colours + 1 ))]} \
      ${(f)${grouped[$group]%$'\n'}} && ret=0
  done
  (( $#t )) && _ra_render teams "whole team" "" $t && ret=0
  (( $#l )) && _ra_render leads "team lead" "" $l && ret=0
  (( $#s )) && _ra_render sessions "session transcript" "" $s && ret=0
  return ret
}

_agent-resume() {
  zmodload -i zsh/complist 2>/dev/null  # list-colors renders through complist
  zmodload -F zsh/stat b:zstat 2>/dev/null  # zstat takes the stamp _ra_emit keys on
  local -a spec
  _agent_resume_flags
  # An emitter that fails leaves spec empty, and the selector still completes:
  # fewer candidates is a worse TAB, a broken _arguments call is no TAB at all.
  _arguments -S $spec \
    '1:selector:_agent_resume_selector' \
    '*:forwarded to claude:'
}

_agent-resume "$@"
