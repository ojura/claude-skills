#compdef agent-resume
# Completion for the tool named on the #compdef line. Zsh supplies that name in
# $service, so a command rename changes the #compdef line, function name, and
# filename. The hidden --complete emitter supplies candidates in either
# "cand:desc" or "cand<TAB>desc<TAB>ansi-color" form. Names rows in the selector
# topic use exactly six TAB-delimited fields:
#   names<TAB>team-key<TAB>group-description<TAB>agent-id<TAB>member-description<TAB>colour
# Rows with fewer or more fields, a blank team-key, or an agent-id with a team
# component that does not match team-key are rejected. This file pads names for
# aligned @session columns and generates list-colors patterns from the rendered
# rows.
#
# `--complete flags` runs the command parser and prints one line per flag.
# _agent_resume_flags converts those lines into _arguments specifications. Each
# flag declares sentence-length argparse help and a shorter completion row;
# offers() in the tool requires both so menu prose cannot inherit help text.

# Reading the corpus takes about 0.7s on the measured machine. Oh-my-zsh's three
# matcher-list specifications can run one completion under each matcher, so a
# cache avoids repeated corpus reads. The stamp combines mtimes for teams,
# projects, and their immediate children: 123 stats in the measured corpus. A
# new or removed session or team changes the stamp. Transcript growth ages out
# through _RA_CACHE_TTL, which bounds staleness for last-active descriptions.
_RA_CACHE_TTL=60
_RA_NAMES_PROTOCOL=2  # bumped when the names row schema changes; invalidates selector caches
typeset -gA _RA_CACHE _RA_CACHE_KEY _RA_CACHE_AT

_ra_agent_team() {  # agent-id -> REPLY (team after first @), or nonzero if invalid
  # Mirrors Python's name_and_team which uses str.partition("@"): the name is
  # before the first @, the team is everything after it. Returns 1 for an id
  # without an @, with an empty name, or with an empty team.
  local id=$1
  [[ $id == *@* ]] || return 1
  local name=${id%%@*}
  local team=${id#*@}
  [[ -n $name && -n $team ]] || return 1
  REPLY=$team
}

_ra_stamp() {  # topic -> stamp (caller's local), or nonzero when unavailable
  local -a st
  if [[ $1 == flags ]]; then
    # Flags belong to the selected executable, so their stamp contains its path
    # and mtime. The path distinguishes executables that share an mtime. zstat
    # accepts one +field per call.
    local tool=${commands[$service]}
    [[ -n $tool ]] || return 1
    zstat -A st +mtime $tool 2>/dev/null || return 1
    stamp="tool $tool $st[1]"
    return 0
  fi
  local claude=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  zstat -A st +mtime $claude/teams(N) $claude/projects(N) \
        $claude/teams/*(N/) $claude/projects/*(N/) 2>/dev/null || return 1
  stamp="corpus p${_RA_NAMES_PROTOCOL} $#st ${(j: :)st}"
}

# The disk cache gives a new shell the candidate list from a previous shell. It
# uses the configured cache-path style when present and otherwise uses the
# service directory under XDG_CACHE_HOME.
_ra_cache_dir() {  # -> dir (caller's local), or nonzero when unavailable
  zstyle -s ":completion:*:*:${service}:*" cache-path dir
  : ${dir:=${XDG_CACHE_HOME:-$HOME/.cache}/$service}
  [[ -d $dir ]] || mkdir -p $dir 2>/dev/null || return 1
}

_ra_emit() {  # topic -> its candidate lines in `lines` (caller's local)
  local topic=$1 stamp= dir= body cache_style=
  local -i disk_cache=1 use_cache=1
  if zstyle -s ":completion:*:*:${service}:*" use-cache cache_style; then
    [[ ${(L)cache_style} == (false|no|off|0) ]] && use_cache=0
  fi
  if (( ! use_cache )); then
    lines=( ${(f)"$($service --complete $topic 2>/dev/null)"} )
    return
  fi
  # Context-bearing topics include a selected side or session after a colon.
  # Their exact keys stay in memory because selectors can contain slashes and
  # distinct selectors need distinct cache entries.
  [[ $topic == *:* ]] && disk_cache=0
  # Each topic has its own stamp. When stamp collection returns an empty value,
  # the in-memory entry expires after _RA_CACHE_TTL and disk caching stays idle.
  _ra_stamp $topic
  # Corpus entries also expire by age because directory mtimes stay stable while
  # an existing transcript grows. The executable mtime fully identifies flags.
  local -i stale=0
  [[ ${_RA_CACHE_KEY[$topic]} != $stamp ]] && stale=1
  [[ $topic != flags ]] && (( SECONDS - ${_RA_CACHE_AT[$topic]:-0} >= _RA_CACHE_TTL )) && stale=1
  if (( stale )); then
    unset "_RA_CACHE[$topic]"
    _RA_CACHE_KEY[$topic]=$stamp
    _RA_CACHE_AT[$topic]=$SECONDS
  fi
  if (( disk_cache && ! ${+_RA_CACHE[$topic]} )) && [[ -n $stamp ]] && _ra_cache_dir; then
    local -a fresh
    if [[ $topic == flags ]]; then
      fresh=($dir/${service}-$topic(N.))
    else
      fresh=($dir/${service}-$topic(N.ms-$_RA_CACHE_TTL))
    fi
    if (( $#fresh )); then
      body="$(<$fresh[1])"          # stamp on the first line, candidates after it
      [[ ${body%%$'\n'*} == $stamp ]] && _RA_CACHE[$topic]=${body#*$'\n'}
    fi
  fi
  if (( ! ${+_RA_CACHE[$topic]} )); then
    _RA_CACHE[$topic]="$($service --complete $topic 2>/dev/null)"
    # A temporary file and rename present a complete cache version to concurrent
    # readers. Disk entries store nonempty answers so an emitter failure is
    # retried on the next request.
    if (( disk_cache )) && [[ -n $dir && -n $_RA_CACHE[$topic] ]]; then
      print -r -- "$stamp"$'\n'"$_RA_CACHE[$topic]" >! $dir/${service}-$topic.$$ 2>/dev/null &&
        mv -f $dir/${service}-$topic.$$ $dir/${service}-$topic 2>/dev/null ||
        rm -f $dir/${service}-$topic.$$ 2>/dev/null
    fi
  fi
  lines=(${(f)_RA_CACHE[$topic]})
}

_agent_resume_flags() {  # -> spec (caller's array): one _arguments spec per flag
  local -a lines parts
  local line flag row completer value
  _ra_emit flags
  for line in $lines; do
    parts=("${(@ps:\t:)line}")
    flag=$parts[1] row=$parts[2] completer=$parts[3] value=$parts[4]
    # _arguments ends a description at the first unescaped ], so descriptions
    # escape backslashes and closing brackets. Each specification is an array
    # element, which lets apostrophes remain literal characters.
    row=${row//\\/\\\\}
    row=${row//\]/\\]}
    if [[ -z $value ]]; then
      spec+=("${flag}[${row}]")
      continue
    fi
    value=${value//:/\\:}   # a colon would end the spec's field early
    case $completer in
      '')  spec+=("${flag}[${row}]:${value}:") ;;
      _*)  spec+=("${flag}[${row}]:${value}:${completer}") ;;   # _files and friends
      *)   spec+=("${flag}[${row}]:${value}:{_agent_resume_topic ${completer} \"${value}\"}") ;;
    esac
  done
}

_ra_parse() {  # line -> cand desc color (caller's locals, via dynamic scope)
  # One split avoids a pattern match per description character. Descriptions can
  # reach 400 characters, and the title emitter collapses whitespace so tabs remain
  # available as field separators.
  local -a parts
  if [[ $1 == *$'\t'* ]]; then
    parts=("${(@ps:\t:)1}")
    cand=$parts[1] desc=$parts[2] color=$parts[3]
  else
    cand=${1%%:*} desc=${1#*:} color=''
  fi
}

_ra_widths() {  # lines... -> maxname maxid (caller's locals)
  local line cand desc color name
  local -i idlen
  for line; do
    _ra_parse $line
    if [[ $cand == *@* ]]; then
      name=${cand%%@*}
      (( ${#name} > maxname )) && maxname=${#name}
    fi
  done
  # Only zsh knows the terminal width, so the columns are sized here. The name
  # cap has to land before the id width is measured, or one agentName that is
  # really a task description sizes the id column for every row.
  local -i width=${COLUMNS:-80}
  local -i namecap=$(( width / 4 )) idcap=$(( width / 2 ))
  (( namecap > 24 )) && namecap=24
  (( maxname > namecap )) && maxname=$namecap
  for line; do
    _ra_parse $line
    if [[ $cand == *@* ]] && (( maxname )); then
      name=${cand%%@*}
      idlen=$(( maxname + ${#cand} - ${#name} ))
    else
      idlen=${#cand}
    fi
    (( idlen > maxid )) && maxid=idlen
  done
  (( maxid > idcap )) && maxid=$idcap
}

_ra_render() {  # topic descr session-colour lines...  (maxname/maxid from caller)
  local topic=$1 descr=$2 scolour=$3
  shift 3
  local -a cands disp zls expl
  local line cand desc color name id padded row nameseg sessseg
  local -i width=${COLUMNS:-80}
  for line; do
    _ra_parse $line
    if [[ $cand == *@* ]] && (( maxname )); then
      name=${cand%%@*}
      nameseg=${(r:maxname:)name}
      sessseg="@${cand#*@}"
      id="${nameseg}${sessseg}"
    else
      nameseg=$cand sessseg='' id=$cand
    fi
    padded=${(r:maxid:)id}
    cands+=($cand)
    row="${padded} -- ${desc}"
    (( ${#row} > width - 2 )) && row="${row[1,width-5]}..."
    disp+=($row)
    # Name in the agent's own colour, session column in the cluster's, so a
    # glance groups rows by session even when the headers scroll away.
    if [[ -n $sessseg && -n $scolour ]]; then
      zls+=("=(#b)(${(b)nameseg})(${(b)sessseg}[ ]#)( -- *)=0=${color:-39}=${scolour}=39")
    elif [[ -n $color ]]; then
      zls+=("=(#b)(${(b)padded})( -- *)=0=${color}=39")
    fi
  done
  (( $#zls )) && zstyle ":completion:*:*:${service}:*:$topic" list-colors $zls
  _wanted -V "$topic" expl "$descr" compadd -l -d disp -a cands
}

_agent_resume_topic() {  # single group, self-scoped widths
  local -a lines
  local -i maxname=0 maxid=0
  _ra_emit $1
  (( $#lines )) || return 1
  # Every topic the emitter has is newest first. A bare TAB offers that complete
  # ordered answer; zsh's own listing mode decides how it is displayed.
  _ra_widths $lines
  _ra_render "$1" "$2" "" $lines
}

_agent_resume_selector() {  # names/teams/leads in one call, widths shared
  # _arguments also calls this completer for option words. The option parser owns
  # a prefix beginning with -, so selector completion returns before reading the
  # corpus.
  [[ $PREFIX == -* ]] && return 1
  local -a all n t l s lines
  local -i maxname=0 maxid=0 ret=1
  local line
  # names rows are exactly six TAB-delimited fields:
  #   names<TAB>team-key<TAB>group-description<TAB>agent-id<TAB>member-description<TAB>colour
  # Group by the exact team-key; display group-description as the heading.
  # Reject rows with fewer or more fields, a blank team-key, an agent-id
  # without a valid name@team split, a team component that does not equal the
  # team-key, or a group-description that contradicts the first row for that key.
  local -a groups
  local -a parts
  local team_key group_desc agent_id member_desc colour
  typeset -A grouped group_descs
  _ra_emit selector
  all=($lines)
  for line in $all; do
    case $line in
      names$'\t'*)
        parts=("${(@ps:\t:)line}")
        # Require exactly 6 fields
        (( $#parts == 6 )) || continue
        team_key=$parts[2] group_desc=$parts[3]
        agent_id=$parts[4] member_desc=$parts[5] colour=$parts[6]
        # Reject blank team-key
        [[ -n $team_key ]] || continue
        # Validate agent-id has nonempty name and team, team matches team-key
        _ra_agent_team "$agent_id" || continue
        [[ $REPLY == $team_key ]] || continue
        # First group-description wins; reject a later row that contradicts it
        if (( ${+grouped[$team_key]} )); then
          [[ ${group_descs[$team_key]} == $group_desc ]] || continue
        else
          groups+=($team_key)
          group_descs[$team_key]=$group_desc
        fi
        grouped[$team_key]+="${agent_id}"$'\t'"${member_desc}"$'\t'"${colour}"$'\n'
        n+=("${agent_id}"$'\t'"${member_desc}"$'\t'"${colour}")
        ;;
      teams$'\t'*)    t+=(${line#*$'\t'}) ;;
      leads$'\t'*)    l+=(${line#*$'\t'}) ;;
    esac
  done
  # Session transcripts enter the list after the prefix resembles a UUID, which
  # keeps names prominent on a blank TAB. The prefix must include a hex digit so
  # an option marker such as "--" remains with the option parser.
  if (( ${#PREFIX} >= 2 )) && [[ -z ${PREFIX//[0-9a-fA-F-]/} && $PREFIX == *[0-9a-fA-F]* ]]; then
    _ra_emit sessions
    s=($lines)
  fi
  _ra_widths $n $t $l $s
  # one colour per session cluster, cycled
  local -a cluster_colours=(36 33 35 32 34 31 96 93)
  local -i i=0
  for team_key in $groups; do
    (( i++ ))
    _ra_render "names$i" "${group_descs[$team_key]}" \
      ${cluster_colours[(( (i - 1) % $#cluster_colours + 1 ))]} \
      ${(f)${grouped[$team_key]%$'\n'}} && ret=0
  done
  (( $#t )) && _ra_render teams "whole team" "" $t && ret=0
  (( $#l )) && _ra_render leads "team lead" "" $l && ret=0
  (( $#s )) && _ra_render sessions "session transcript" "" $s && ret=0
  return ret
}

_ra_option_value() {  # option -> REPLY, last spelling before the cursor wins
  local wanted=$1 token
  local -i i
  REPLY=
  for (( i = 1; i <= $#words; i++ )); do
    token=$words[i]
    if [[ $token == $wanted ]]; then
      (( i < $#words )) && REPLY=$words[i+1]
    elif [[ $token == ${wanted}=* ]]; then
      REPLY=${token#*=}
    fi
  done
}

_agent_resume_as_agent() {
  local side name
  local -a lines
  local -i maxname=0 maxid=0
  _ra_option_value --promote
  side=$REPLY
  [[ -n $side ]] || return 1
  if [[ $PREFIX != *@* ]]; then
    _ra_emit "as-agent-name:$side"
    (( $#lines )) || return 1
    name=$lines[1]
    _wanted -V as-agent-name expl 'promoted agent name' \
      compadd -S '' -- "${name}@"
    return
  fi
  _ra_emit "as-agent:$side"
  (( $#lines )) || return 1
  _ra_widths $lines
  _ra_render as-agent-teams 'team for promoted agent' '' $lines
}

_agent_resume_into_session() {
  local subject
  local -a lines
  local -i maxname=0 maxid=0
  _ra_option_value --demote
  subject=$REPLY
  [[ -n $subject ]] || return 1
  _ra_emit "into-session:$subject"
  (( $#lines )) || return 1
  _ra_widths $lines
  _ra_render into-session 'parent session for demote' '' $lines
}

_agent-resume() {
  zmodload -i zsh/complist 2>/dev/null  # list-colors renders through complist
  zmodload -F zsh/stat b:zstat 2>/dev/null  # zstat takes the stamp _ra_emit keys on
  local -a spec
  _agent_resume_flags
  # An emitter failure leaves the option specification empty. Selector
  # completion still runs, preserving the candidate list.
  _arguments -S $spec \
    '1:selector:_agent_resume_selector' \
    '*:forwarded to claude:'
}

_agent-resume "$@"
