# markdown-latex-report
# Builds a polished PDF from a single Markdown file via pandoc + lualatex,
# with a custom Lua filter (smart tables + code line-breaking), a typographic
# preamble, and locally bundled LaTeX packages. Charts are generated by a
# Python script once; a sentinel file records the run, so editing the Markdown
# alone does not redraw them.
#
# Override REPORT to point at your own Markdown file:
#   make REPORT=path/to/doc.md
# The default builds the fabricated test fixture under test/.
#
# `make check` builds the report with the LaTeX log kept, then
# runs tools/check_report.py on the log, the PDF and the Markdown: it names
# every page and source line with a stretched or overfull line, a wrong running
# head, a page that holds only a figure or ends early, a heading at a page foot,
# inline code broken inside a name, a quoted section title that differs from
# its heading, a cited path that is missing or untracked, and a missing figure.
# The report is CHECK_DIR/check.md and the pages are rendered into
# CHECK_DIR/render. The checker needs PyMuPDF (pip install pymupdf); PYTHON
# defaults to ~/.venvs/mlr/bin/python3 when that venv exists.
#
# docs/sample-report.pdf and docs/preview/*.png, the showcase the README links,
# are the fixture built at the committed pipeline. `make sample` rewrites them
# from a fresh build; `make check` on the fixture compares them with the PDF
# built in CHECK_DIR and fails while they differ.

REPORT      ?= test/REPORT.md
FIXTURE     := test/REPORT.md
SAMPLE_DIR  := docs
CHARTS_DIR  ?= test/charts
PLOT        ?= $(CHARTS_DIR)/plot_findings.py
PYTHON      ?= $(if $(wildcard $(HOME)/.venvs/mlr/bin/python3),$(HOME)/.venvs/mlr/bin/python3,python3)
BASE        := $(basename $(notdir $(REPORT)))
OUT         := $(BASE).pdf
CHECK_DIR   ?= /tmp/markdown-latex-report-check/$(BASE)
CHECK_ARGS  ?=

PANDOC_MAINFONT ?= TeX Gyre Pagella
PANDOC_SANSFONT ?= TeX Gyre Heros
PANDOC_MONOFONT ?= DejaVu Sans Mono
# The font for $...$ and $$...$$, which pandoc passes to unicode-math. Without it the
# formulas print in Latin Modern Math beside the Pagella text.
PANDOC_MATHFONT ?= TeX Gyre Pagella Math

# The pandoc options of the build; `check` uses the same ones to make the .tex.
PANDOC_FLAGS := --from markdown+raw_tex+raw_attribute-smart \
	--resource-path=.:$(dir $(REPORT)):$(CHARTS_DIR) \
	--lua-filter=filter.lua \
	--include-in-header=header.tex \
	--toc --toc-depth=2 \
	-V mainfont="$(PANDOC_MAINFONT)" \
	-V mainfontoptions:RawFeature=-tlig \
	-V sansfont="$(PANDOC_SANSFONT)" \
	-V sansfontoptions:RawFeature=-tlig \
	-V monofont="$(PANDOC_MONOFONT)" \
	-V mathfont="$(PANDOC_MATHFONT)" \
	-V documentclass=article \
	-V fontsize=10pt \
	-V linkcolor=accent

LOCAL_STYS := fvextra.sty upquote.sty widows-and-orphans.sty needspace.sty
CHARTS_STAMP := $(CHARTS_DIR)/.stamp

.PHONY: all charts clean rebuild check venv sample sample-check
all: $(OUT)
	@echo "==> built $(OUT)"

# ---- venv ----
# The Python the charts and the checker use: ~/.venvs/mlr with matplotlib,
# numpy and PyMuPDF. `make venv` creates it; PYTHON picks it up when it exists.
venv:
	python3 -m venv $(HOME)/.venvs/mlr
	$(HOME)/.venvs/mlr/bin/pip install --quiet --upgrade pip
	$(HOME)/.venvs/mlr/bin/pip install --quiet matplotlib numpy pymupdf
	@echo "==> $(HOME)/.venvs/mlr ready; make uses it as PYTHON"

# ---- charts ----
charts: $(CHARTS_STAMP)

# A report without charts does not need a plot script: when PLOT does not
# exist, the stamp is made without running anything.
$(CHARTS_STAMP): $(wildcard $(PLOT)) chartstyle.py
	$(if $(wildcard $(PLOT)),$(PYTHON) $(PLOT),@echo "no plot script $(PLOT); no charts drawn")
	@mkdir -p $(dir $@) && touch $@

# ---- PDF ----
# figures live next to the report (img/) and are promoted to .pdf siblings
# by filter.lua; regenerating a figure must trigger a re-embed
FIGS := $(wildcard $(dir $(REPORT))img/*)

$(OUT): Makefile $(REPORT) header.tex filter.lua bblopts.cfg hyph-en-gb.tex $(LOCAL_STYS) $(CHARTS_STAMP) $(FIGS)
	TEXINPUTS=.:$$TEXINPUTS pandoc $(REPORT) $(PANDOC_FLAGS) \
		--pdf-engine=lualatex \
		-o $(OUT)

# ---- check ----
# A fresh build with the log kept: pandoc writes the .tex, lualatex runs up to
# three times in CHECK_DIR (the skill directory is on TEXINPUTS for the
# preamble, the packages, the patterns and the figures), and the checker reads
# the log, the PDF, the .toc and the Markdown. For the fixture the showcase
# under docs/ is compared with the fresh build as well.
check: $(CHARTS_STAMP) $(FIGS)
	@rm -rf "$(CHECK_DIR)" && mkdir -p "$(CHECK_DIR)"
	@echo "==> building $(REPORT) with the log kept in $(CHECK_DIR)"
	@TEXINPUTS=.:$$TEXINPUTS pandoc $(REPORT) $(PANDOC_FLAGS) -s -t latex -o "$(CHECK_DIR)/$(BASE).tex"
	@cd "$(CHECK_DIR)" && for i in 1 2 3; do \
	  TEXINPUTS="$(abspath .):" lualatex -interaction=nonstopmode "$(BASE).tex" > "lualatex-$$i.out" 2>&1 || true; \
	  grep -q -E 'Rerun to get|Label\(s\) may have changed' "$(BASE).log" || break; \
	done
	@test -f "$(CHECK_DIR)/$(BASE).pdf" || { echo "lualatex produced no PDF; the end of $(CHECK_DIR)/$(BASE).log:"; tail -n 40 "$(CHECK_DIR)/$(BASE).log"; exit 1; }
	@$(PYTHON) tools/check_report.py --md $(REPORT) --tex "$(CHECK_DIR)/$(BASE).tex" \
		--log "$(CHECK_DIR)/$(BASE).log" --pdf "$(CHECK_DIR)/$(BASE).pdf" \
		--out "$(CHECK_DIR)" --charts $(CHARTS_DIR) $(CHECK_ARGS)
	@if [ "$(REPORT)" = "$(FIXTURE)" ]; then $(PYTHON) tools/sample.py compare --pdf "$(CHECK_DIR)/$(BASE).pdf" --docs "$(SAMPLE_DIR)"; fi

# ---- sample ----
# The showcase is a build product, never made by hand: the PDF is a copy of the
# fixture build and the previews are three of its pages (the title with the
# contents, the first code listing, the first page with a figure and a table)
# rendered at 220 dpi by tools/sample.py.
sample: $(OUT)
	@test "$(REPORT)" = "$(FIXTURE)" || { echo "make sample builds the showcase from the fixture only; run it without REPORT"; exit 1; }
	$(PYTHON) tools/sample.py write --pdf $(OUT) --docs $(SAMPLE_DIR)

sample-check: $(OUT)
	@test "$(REPORT)" = "$(FIXTURE)" || { echo "the showcase comparison applies to the fixture only; run it without REPORT"; exit 1; }
	@$(PYTHON) tools/sample.py compare --pdf $(OUT) --docs $(SAMPLE_DIR)

clean:
	rm -f $(OUT) *.aux *.log *.toc *.out $(CHARTS_STAMP)

rebuild:
	rm -f $(OUT) $(CHARTS_STAMP)
	$(MAKE) $(OUT)
